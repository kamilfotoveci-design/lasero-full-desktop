<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Lasero.Avalonia.ViewModels"
             xmlns:automation="using:Avalonia.Automation"
             x:Class="Lasero.Avalonia.Views.ProjectsView"
             x:DataType="vm:ProjectBrowserViewModel">
  <ScrollViewer>
    <StackPanel Margin="40,34" Spacing="22" MaxWidth="820">
      <StackPanel Spacing="6">
        <TextBlock Text="Projekty" FontSize="22" FontWeight="Bold" automation:AutomationProperties.AutomationId="ProjectsHeading" />
        <TextBlock Text="Otevření souboru už nepoužívá Microsoft.Win32 ani System.Windows."
                   Classes="muted" TextWrapping="Wrap" />
      </StackPanel>

      <Border Classes="card">
        <StackPanel Spacing="14">
          <TextBlock Text="Ověřit existující projekt" FontSize="18" FontWeight="SemiBold" />
          <TextBlock Text="Podporuje zabalené projekty .lasero i starší JSON formát."
                     Classes="muted" TextWrapping="Wrap" />
          <Button Content="Otevřít projekt…"
                  Command="{Binding OpenProject}"
                  automation:AutomationProperties.AutomationId="OpenProjectButton"
                  HorizontalAlignment="Left"
                  Padding="18,10" />
          <TextBlock Text="{Binding Status}" Classes="muted" TextWrapping="Wrap" automation:AutomationProperties.AutomationId="ProjectStatus" />
        </StackPanel>
      </Border>

      <Border Classes="card" IsVisible="{Binding HasProject}">
        <StackPanel Spacing="12">
          <TextBlock Text="Kompatibilní projekt" Foreground="{StaticResource Brush.Success}" FontWeight="SemiBold" />
          <TextBlock Text="{Binding Project.Name}" FontSize="25" FontWeight="Bold" automation:AutomationProperties.AutomationId="ProjectName" />
          <TextBlock Text="{Binding Project.Path}" Classes="muted" TextWrapping="Wrap" />
          <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
            <Border Classes="card" Background="{StaticResource Brush.PanelRaised}">
              <StackPanel>
                <TextBlock Text="Verze" Classes="muted" />
                <TextBlock Text="{Binding Project.Version}" FontSize="22" FontWeight="Bold" />
              </StackPanel>
            </Border>
            <Border Grid.Column="1" Classes="card" Background="{StaticResource Brush.PanelRaised}">
              <StackPanel>
                <TextBlock Text="Objekty" Classes="muted" />
                <TextBlock Text="{Binding Project.ObjectCount}" FontSize="22" FontWeight="Bold" />
              </StackPanel>
            </Border>
            <Border Grid.Column="2" Classes="card" Background="{StaticResource Brush.PanelRaised}">
              <StackPanel>
                <TextBlock Text="Vrstvy" Classes="muted" />
                <TextBlock Text="{Binding Project.LayerCount}" FontSize="22" FontWeight="Bold" />
              </StackPanel>
            </Border>
          </Grid>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
