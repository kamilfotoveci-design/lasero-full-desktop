<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Lasero.Avalonia.ViewModels"
             xmlns:conv="using:Lasero.Avalonia.Converters"
             xmlns:objconv="using:Avalonia.Data.Converters"
             xmlns:automation="using:Avalonia.Automation"
             x:Class="Lasero.Avalonia.Views.DeviceView"
             x:DataType="vm:ShellViewModel">
  <!--
      Port of Lasero.App's MachinePanelView (the reusable connection/jog/console surface) hosted the
      way DeviceView.xaml hosts it for the full "Zařízení" screen — same three tabs, same order,
      same section hierarchy: ZAŘÍZENÍ status/telemetry always on top, then Připojení/Pohyb/Konzola.
      Job/Framing controls (WPF's DeviceView.xaml, separate from MachinePanelView) are NOT here: they
      need GCodeViewModel + a generated G-code job, neither of which exists in Avalonia yet — see
      HANDOFF/report, not faked here.
  -->
  <UserControl.Resources>
    <conv:BoolToConnectionBrushConverter x:Key="BoolToConnectionBrush" />
    <conv:MachineModeToLabelConverter x:Key="MachineModeToLabel" />
  </UserControl.Resources>
  <UserControl.Styles>
    <Style Selector="RadioButton.paneltab">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="Height" Value="30" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
    </Style>
    <Style Selector="RadioButton.paneltab:checked">
      <Setter Property="Background" Value="{StaticResource Brush.Panel}" />
      <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.jogpad">
      <Setter Property="Width" Value="46" /><Setter Property="Height" Value="46" /><Setter Property="MinHeight" Value="46" />
      <Setter Property="Margin" Value="2" /><Setter Property="Padding" Value="10" />
    </Style>
    <Style Selector="Button.jogpad.home">
      <Setter Property="Background" Value="{StaticResource Brush.SelectedSurface}" />
      <Setter Property="BorderBrush" Value="{StaticResource Brush.SelectedBorder}" />
      <Setter Property="Foreground" Value="{StaticResource Brush.AccentText}" />
    </Style>
  </UserControl.Styles>

  <Grid MaxWidth="420" HorizontalAlignment="Left" Margin="24" RowDefinitions="Auto,Auto,Auto,*">

    <!-- Active alert banner -->
    <Border Grid.Row="0" Background="{StaticResource Brush.PanelRaised}" BorderBrush="{StaticResource Brush.Danger}"
            BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,0,0,8"
            IsVisible="{Binding MachineStatus.HasActiveAlert}">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="{Binding MachineStatus.ActiveAlert.Message}" TextWrapping="Wrap" Foreground="{StaticResource Brush.Danger}" />
        <Button Grid.Column="1" Width="24" Height="24" Padding="4" Background="Transparent" BorderBrush="Transparent"
                Command="{Binding MachineStatus.DismissAlert}" ToolTip.Tip="Zavřít upozornění">
          <Path Data="{StaticResource Glyph.Close}" Stretch="Uniform" Stroke="{StaticResource Brush.TextSecondary}" StrokeThickness="1.75" />
        </Button>
      </Grid>
    </Border>

    <!-- Status + telemetry -->
    <Border Grid.Row="1" Background="{StaticResource Brush.PanelRaised}" BorderBrush="{StaticResource Brush.PanelBorder}"
            BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,0,0,8">
      <StackPanel>
        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,7">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="7">
            <Ellipse Width="7" Height="7" Fill="{Binding Connection.IsConnected, Converter={StaticResource BoolToConnectionBrush}}" />
            <TextBlock Text="{Binding Connection.StatusText}" FontWeight="SemiBold" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="6">
            <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding Connection.IsConnected}">
              <Ellipse Width="7" Height="7" Fill="{StaticResource Brush.Accent}" />
              <TextBlock Text="{Binding MachineStatus.Mode, Converter={StaticResource MachineModeToLabel}}" Classes="muted" />
            </StackPanel>
            <Button Classes="secondary" Height="32" MinHeight="32" Padding="10,0" Command="{Binding Connection.Connect}"
                    IsVisible="{Binding !Connection.IsConnected}" ToolTip.Tip="Připojit vybrané zařízení">
              <StackPanel Orientation="Horizontal" Spacing="5">
                <Path Data="{StaticResource Glyph.Connect}" Width="14" Height="14" Stretch="Uniform" Stroke="{StaticResource Brush.TextPrimary}" StrokeThickness="1.75" />
                <TextBlock Text="Připojit" />
              </StackPanel>
            </Button>
          </StackPanel>
        </Grid>
        <Grid ColumnDefinitions="*,*,*,*,*">
          <StackPanel><TextBlock Text="X mm" Classes="muted" /><TextBlock Text="{Binding MachineStatus.WorkX, StringFormat={}{0:0.00}}" FontWeight="SemiBold" /></StackPanel>
          <StackPanel Grid.Column="1"><TextBlock Text="Y mm" Classes="muted" /><TextBlock Text="{Binding MachineStatus.WorkY, StringFormat={}{0:0.00}}" FontWeight="SemiBold" /></StackPanel>
          <StackPanel Grid.Column="2"><TextBlock Text="Z mm" Classes="muted" /><TextBlock Text="{Binding MachineStatus.WorkZ, StringFormat={}{0:0.00}}" FontWeight="SemiBold" /></StackPanel>
          <StackPanel Grid.Column="3"><TextBlock Text="F" Classes="muted" /><TextBlock Text="{Binding MachineStatus.FeedRate, StringFormat={}{0:0}}" FontWeight="SemiBold" /></StackPanel>
          <StackPanel Grid.Column="4"><TextBlock Text="S" Classes="muted" /><TextBlock Text="{Binding MachineStatus.SpindleSpeed, StringFormat={}{0:0}}" FontWeight="SemiBold" /></StackPanel>
        </Grid>
      </StackPanel>
    </Border>

    <!-- Tabs: Připojení / Pohyb / Konzola -->
    <Border Grid.Row="2" Background="{StaticResource Brush.PanelRaised}" CornerRadius="8" Padding="2" Margin="0,0,0,2">
      <Grid ColumnDefinitions="*,*,*">
        <RadioButton x:Name="ConnectionTab" Classes="paneltab" IsChecked="True" Content="Připojení" GroupName="MachinePanelTab" ToolTip.Tip="Připojení a pracovní plocha" />
        <RadioButton x:Name="JogTab" Grid.Column="1" Classes="paneltab" Content="Pohyb" GroupName="MachinePanelTab" ToolTip.Tip="Ruční posun os" />
        <RadioButton x:Name="ConsoleTab" Grid.Column="2" Classes="paneltab" Content="Konzola" GroupName="MachinePanelTab" ToolTip.Tip="Pokročilá konzola GRBL" />
      </Grid>
    </Border>

    <Grid Grid.Row="3">

      <!-- ============ Připojení ============ -->
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding #ConnectionTab.IsChecked}">
        <StackPanel Margin="0,10,0,8">
          <TextBlock Text="Zařízení" FontWeight="SemiBold" Margin="0,0,0,9" />

          <StackPanel IsVisible="{Binding !Connection.IsConnected}">
            <TextBlock Text="Sériový port" Classes="muted" Margin="0,0,0,6" />
            <Grid ColumnDefinitions="*,Auto">
              <ComboBox ItemsSource="{Binding Connection.AvailablePorts}" SelectedItem="{Binding Connection.SelectedPort, Mode=TwoWay}" HorizontalAlignment="Stretch" />
              <Button Grid.Column="1" Width="32" Height="32" Margin="8,0,0,0" Command="{Binding Connection.RefreshPorts}"
                      ToolTip.Tip="Znovu vyhledat porty" automation:AutomationProperties.Name="Znovu vyhledat porty">
                <Path Data="{StaticResource Glyph.Refresh}" Width="16" Height="16" Stretch="Uniform" Stroke="{StaticResource Brush.TextSecondary}" StrokeThickness="1.75" />
              </Button>
            </Grid>
            <TextBlock Text="Rychlost" Classes="muted" Margin="0,10,0,6" />
            <ComboBox ItemsSource="{Binding Connection.CommonBaudRates}" SelectedItem="{Binding Connection.BaudRate, Mode=TwoWay}" HorizontalAlignment="Left" MinWidth="132" />

            <Border Background="{StaticResource Brush.PanelRaised}" CornerRadius="8" Padding="9" Margin="0,8,0,0" IsVisible="{Binding Connection.IsVirtualMachineSelected}">
              <Grid ColumnDefinitions="Auto,*">
                <Path Data="{StaticResource Glyph.Info}" Width="16" Height="16" Stretch="Uniform" Stroke="{StaticResource Brush.Accent}" StrokeThickness="1.75" Margin="0,1,8,0" VerticalAlignment="Top" />
                <TextBlock Grid.Column="1" Text="Bezpečný simulátor — neotevře fyzický port ani laser." Classes="muted" TextWrapping="Wrap" />
              </Grid>
            </Border>

            <Button Classes="primary" HorizontalAlignment="Stretch" Command="{Binding Connection.Connect}" Margin="0,8,0,0">
              <StackPanel Orientation="Horizontal" Spacing="7" HorizontalAlignment="Center">
                <Path Data="{StaticResource Glyph.Connect}" Width="16" Height="16" Stretch="Uniform" Stroke="White" StrokeThickness="1.75" />
                <TextBlock Text="Připojit zařízení" Foreground="White" />
              </StackPanel>
            </Button>
          </StackPanel>

          <StackPanel IsVisible="{Binding Connection.IsConnected}">
            <Border Background="{StaticResource Brush.PanelRaised}" CornerRadius="8" Padding="10">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="Pracovní plocha" FontWeight="SemiBold" />
                <TextBlock Grid.Column="1" VerticalAlignment="Center">
                  <Run Text="{Binding Connection.WorkAreaWidthMm, Mode=OneWay, StringFormat={}{0:0.#}}" />
                  <Run Text=" × " />
                  <Run Text="{Binding Connection.WorkAreaHeightMm, Mode=OneWay, StringFormat={}{0:0.#}}" />
                  <Run Text=" mm" />
                </TextBlock>
              </Grid>
            </Border>

            <Border Background="{StaticResource Brush.PanelRaised}" CornerRadius="8" Padding="10" Margin="0,8,0,0">
              <StackPanel>
                <TextBlock Text="Polohovací paprsek" FontWeight="SemiBold" Margin="0,0,0,8" />
                <Grid ColumnDefinitions="*,88,Auto" Margin="0,0,0,7">
                  <TextBlock Text="Výkon" Classes="muted" VerticalAlignment="Center" />
                  <TextBox Grid.Column="1" Text="{Binding Jog.PositioningLaserPowerPercent, StringFormat=0.#}" TextAlignment="Right"
                           ToolTip.Tip="Povolený rozsah pro polohování je 0,1 až 5 %." />
                  <TextBlock Grid.Column="2" Text="%" Classes="muted" Margin="7,0,0,0" VerticalAlignment="Center" />
                </Grid>
                <TextBlock Text="Doporučeno 1 %. Paprsek svítí pouze po dobu držení tlačítka." Classes="muted" TextWrapping="Wrap" Margin="0,0,0,8" />
                <Button x:Name="PositioningLaserButton" Background="{StaticResource Brush.Danger}" BorderBrush="{StaticResource Brush.Danger}"
                        IsEnabled="{Binding Jog.CanUsePositioningLaser}"
                        PointerPressed="OnPositioningLaserPressed" PointerReleased="OnPositioningLaserReleased" PointerExited="OnPositioningLaserExited"
                        ToolTip.Tip="Vyžaduje připojený nečinný GRBL laser s potvrzeným režimem $32=1.">
                  <StackPanel Orientation="Horizontal" Spacing="7" HorizontalAlignment="Center">
                    <Path Data="{StaticResource Glyph.Zap}" Width="16" Height="16" Stretch="Uniform" Stroke="White" StrokeThickness="1.75" />
                    <TextBlock Text="Podržet pro paprsek" Foreground="White" />
                  </StackPanel>
                </Button>
                <TextBlock Text="{Binding Jog.LastActionMessage}" Classes="muted" TextWrapping="Wrap" Margin="0,7,0,0" IsVisible="{Binding Jog.LastActionMessage, Converter={x:Static objconv:StringConverters.IsNotNullOrEmpty}}" />
              </StackPanel>
            </Border>

            <Button Classes="secondary" HorizontalAlignment="Stretch" Command="{Binding Connection.Disconnect}" Margin="0,9,0,0">
              <StackPanel Orientation="Horizontal" Spacing="7" HorizontalAlignment="Center">
                <Path Data="{StaticResource Glyph.Disconnect}" Width="16" Height="16" Stretch="Uniform" Stroke="{StaticResource Brush.TextPrimary}" StrokeThickness="1.75" />
                <TextBlock Text="Odpojit zařízení" />
              </StackPanel>
            </Button>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>

      <!-- ============ Pohyb ============ -->
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding #JogTab.IsChecked}">
        <StackPanel Margin="0,10,0,8" IsEnabled="{Binding Connection.IsConnected}">
          <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,9">
            <TextBlock Text="Ruční posun" FontWeight="SemiBold" />
            <TextBlock Grid.Column="1" Text="XY / Z" Classes="muted" />
          </Grid>
          <Grid ColumnDefinitions="*,8,*" Margin="0,0,0,10">
            <StackPanel><TextBlock Text="XY krok (mm)" Classes="muted" Margin="0,0,0,6" /><ComboBox ItemsSource="{Binding Jog.StepSizePresets}" SelectedItem="{Binding Jog.StepSizeMm, Mode=TwoWay}" /></StackPanel>
            <StackPanel Grid.Column="2"><TextBlock Text="XY rychlost (mm/min)" Classes="muted" Margin="0,0,0,6" /><TextBox Text="{Binding Jog.JogFeedRate, StringFormat=0}" /></StackPanel>
          </Grid>

          <Grid HorizontalAlignment="Center" Margin="0,0,0,10" ColumnDefinitions="50,50,50,14,50" RowDefinitions="50,50,50">
            <Button Grid.Row="0" Grid.Column="0" Classes="jogpad" Command="{Binding Jog.JogXNegYPos}" ToolTip.Tip="Vlevo nahoru"><Path Data="{StaticResource Glyph.ArrowUpLeft}" Stretch="Uniform" Stroke="{StaticResource Brush.TextPrimary}" StrokeThickness="1.75" /></Button>
            <Button Grid.Row="0" Grid.Column="1" Classes="jogpad" Command="{Binding Jog.JogYPos}" ToolTip.Tip="Y plus"><Path Data="{StaticResource Glyph.ArrowUp}" Stretch="Uniform" Stroke="{StaticResource Brush.TextPrimary}" StrokeThickness="1.75" /></Button>
            <Button Grid.Row="0" Grid.Column="2" Classes="jogpad" Command="{Binding Jog.JogXPosYPos}" ToolTip.Tip="Vpravo nahoru"><Path Data="{StaticResource Glyph.ArrowUpRight}" Stretch="Uniform" Stroke="{StaticResource Brush.TextPrimary}" StrokeThickness="1.75" /></Button>
            <Button Grid.Row="1" Grid.Column="0" Classes="jogpad" Command="{Binding Jog.JogXNeg}" ToolTip.Tip="X minus"><Path Data="{StaticResource Glyph.ArrowLeft}" Stretch="Uniform" Stroke="{StaticResource Brush.TextPrimary}" StrokeThickness="1.75" /></Button>
            <Button Grid.Row="1" Grid.Column="1" Classes="jogpad home" Command="{Binding Jog.Home}" ToolTip.Tip="Najet do výchozí polohy"><Path Data="{StaticResource Glyph.MachineHome}" Stretch="Uniform" Stroke="{StaticResource Brush.AccentText}" StrokeThickness="1.75" /></Button>
            <Button Grid.Row="1" Grid.Column="2" Classes="jogpad" Command="{Binding Jog.JogXPos}" ToolTip.Tip="X plus"><Path Data="{StaticResource Glyph.ArrowRight}" Stretch="Uniform" Stroke="{StaticResource Brush.TextPrimary}" StrokeThickness="1.75" /></Button>
            <Button Grid.Row="2" Grid.Column="0" Classes="jogpad" Command="{Binding Jog.JogXNegYNeg}" ToolTip.Tip="Vlevo dolů"><Path Data="{StaticResource Glyph.ArrowDownLeft}" Stretch="Uniform" Stroke="{StaticResource Brush.TextPrimary}" StrokeThickness="1.75" /></Button>
            <Button Grid.Row="2" Grid.Column="1" Classes="jogpad" Command="{Binding Jog.JogYNeg}" ToolTip.Tip="Y minus"><Path Data="{StaticResource Glyph.ArrowDown}" Stretch="Uniform" Stroke="{StaticResource Brush.TextPrimary}" StrokeThickness="1.75" /></Button>
            <Button Grid.Row="2" Grid.Column="2" Classes="jogpad" Command="{Binding Jog.JogXPosYNeg}" ToolTip.Tip="Vpravo dolů"><Path Data="{StaticResource Glyph.ArrowDownRight}" Stretch="Uniform" Stroke="{StaticResource Brush.TextPrimary}" StrokeThickness="1.75" /></Button>
            <TextBlock Grid.Row="0" Grid.Column="4" Text="Z" Classes="muted" HorizontalAlignment="Center" VerticalAlignment="Bottom" />
            <Button Grid.Row="1" Grid.Column="4" Classes="jogpad" Command="{Binding Jog.JogZPos}" ToolTip.Tip="Zvednout osu Z"><Path Data="{StaticResource Glyph.ArrowUp}" Stretch="Uniform" Stroke="{StaticResource Brush.TextPrimary}" StrokeThickness="1.75" /></Button>
            <Button Grid.Row="2" Grid.Column="4" Classes="jogpad" Command="{Binding Jog.JogZNeg}" ToolTip.Tip="Spustit osu Z"><Path Data="{StaticResource Glyph.ArrowDown}" Stretch="Uniform" Stroke="{StaticResource Brush.TextPrimary}" StrokeThickness="1.75" /></Button>
          </Grid>

          <Grid ColumnDefinitions="*,8,*" Margin="0,0,0,9">
            <StackPanel><TextBlock Text="Z krok (mm)" Classes="muted" Margin="0,0,0,6" /><ComboBox ItemsSource="{Binding Jog.StepSizePresets}" SelectedItem="{Binding Jog.ZStepSizeMm, Mode=TwoWay}" /></StackPanel>
            <StackPanel Grid.Column="2"><TextBlock Text="Z rychlost (mm/min)" Classes="muted" Margin="0,0,0,6" /><TextBox Text="{Binding Jog.ZJogFeedRate, StringFormat=0}" /></StackPanel>
          </Grid>

          <Grid ColumnDefinitions="*,7,*" Margin="0,0,0,7">
            <Button Classes="secondary" HorizontalAlignment="Stretch" Command="{Binding Jog.SetOriginHere}">
              <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center"><Path Data="{StaticResource Glyph.Origin}" Width="14" Height="14" Stretch="Uniform" Stroke="{StaticResource Brush.TextPrimary}" StrokeThickness="1.75" /><TextBlock Text="Nula zde" /></StackPanel>
            </Button>
            <Button Grid.Column="2" Classes="secondary" HorizontalAlignment="Stretch" Command="{Binding Jog.GoToWorkZero}">
              <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center"><Path Data="{StaticResource Glyph.Origin}" Width="14" Height="14" Stretch="Uniform" Stroke="{StaticResource Brush.TextPrimary}" StrokeThickness="1.75" /><TextBlock Text="Na nulu XY" /></StackPanel>
            </Button>
          </Grid>
          <Button Classes="secondary" HorizontalAlignment="Stretch" Command="{Binding Jog.Unlock}" Margin="0,0,0,7">
            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center"><Path Data="{StaticResource Glyph.Unlock}" Width="14" Height="14" Stretch="Uniform" Stroke="{StaticResource Brush.TextPrimary}" StrokeThickness="1.75" /><TextBlock Text="Odemknout zařízení ($X)" /></StackPanel>
          </Button>
          <Button Background="{StaticResource Brush.Danger}" BorderBrush="{StaticResource Brush.Danger}" HorizontalAlignment="Stretch" Command="{Binding Jog.CancelJog}">
            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center"><Path Data="{StaticResource Glyph.Stop}" Width="14" Height="14" Stretch="Uniform" Stroke="White" StrokeThickness="1.75" /><TextBlock Text="Zastavit ruční pohyb" Foreground="White" /></StackPanel>
          </Button>
          <Expander Header="Pokročilé ovládání" Margin="0,8,0,0">
            <Button Background="{StaticResource Brush.Danger}" BorderBrush="{StaticResource Brush.Danger}" HorizontalAlignment="Stretch" Command="{Binding Jog.SoftReset}" Margin="0,8,0,0"
                    ToolTip.Tip="Resetuje řídicí jednotku. Použijte pouze při chybě nebo nereagujícím stroji.">
              <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center"><Path Data="{StaticResource Glyph.Refresh}" Width="14" Height="14" Stretch="Uniform" Stroke="White" StrokeThickness="1.75" /><TextBlock Text="Resetovat řídicí jednotku" Foreground="White" /></StackPanel>
            </Button>
          </Expander>
          <Border Background="{StaticResource Brush.SelectedSurface}" BorderBrush="{StaticResource Brush.SelectedBorder}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,10,0,0">
            <Grid ColumnDefinitions="Auto,*">
              <Path Data="{StaticResource Glyph.Info}" Width="18" Height="18" Stretch="Uniform" Stroke="{StaticResource Brush.Accent}" StrokeThickness="1.75" Margin="0,1,9,0" VerticalAlignment="Top" />
              <TextBlock Grid.Column="1" Text="Pro přesné polohování použijte menší krok. Návrat na pracovní nulu provede tlačítko Přejít na nulu XY." Classes="muted" TextWrapping="Wrap" />
            </Grid>
          </Border>
          <TextBlock Text="{Binding Jog.LastActionMessage}" Classes="muted" TextWrapping="Wrap" Margin="0,7,0,0" />
        </StackPanel>
      </ScrollViewer>

      <!-- ============ Konzola ============ -->
      <Grid IsVisible="{Binding #ConsoleTab.IsChecked}" Margin="0,10,0,8" RowDefinitions="Auto,*,Auto">
        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
          <TextBlock Text="Konzola GRBL" FontWeight="SemiBold" />
          <TextBlock Grid.Column="1" Text="Pokročilé" Classes="muted" />
        </Grid>
        <Border Grid.Row="1" Background="{StaticResource Brush.PanelRaised}" BorderBrush="{StaticResource Brush.PanelBorder}" BorderThickness="1" CornerRadius="8" MinHeight="160">
          <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
            <ItemsControl ItemsSource="{Binding Console.Lines}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <TextBlock Text="{Binding}" FontFamily="Cascadia Mono,Consolas,Menlo,monospace" FontSize="11" TextWrapping="Wrap" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Border>
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,8,0,0">
          <TextBox FontFamily="Cascadia Mono,Consolas,Menlo,monospace" Text="{Binding Console.CommandInput, Mode=TwoWay}" KeyDown="OnConsoleInputKeyDown" />
          <Button Grid.Column="1" Classes="secondary" Command="{Binding Console.Send}" Margin="8,0,0,0">
            <StackPanel Orientation="Horizontal" Spacing="6"><Path Data="{StaticResource Glyph.Send}" Width="14" Height="14" Stretch="Uniform" Stroke="{StaticResource Brush.TextPrimary}" StrokeThickness="1.75" /><TextBlock Text="Odeslat" /></StackPanel>
          </Button>
        </Grid>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
