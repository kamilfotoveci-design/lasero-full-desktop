<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Lasero.Avalonia.ViewModels"
             xmlns:materials="using:Lasero.Core.Materials"
             xmlns:layers="using:Lasero.Core.Layers"
             xmlns:conv="using:Lasero.Avalonia.Converters"
             xmlns:objconv="using:Avalonia.Data.Converters"
             xmlns:automation="using:Avalonia.Automation"
             x:Class="Lasero.Avalonia.Views.MaterialsView"
             x:DataType="vm:MaterialCatalogViewModel">
  <!--
      Port of Lasero.App/MaterialsWindow.xaml's actual swatch-grid interface — not the earlier
      simplified filter/list/detail browser. Same two tabs (Doporučené parametry / Moje recepty), same
      filter row, same 4x4 speed/power swatch cards per material, same "click a tile to select a
      recipe" interaction, same apply-to-layer workflow. "Moje recepty" (custom presets + Lasero
      account cloud sync) is flagged honestly below rather than faked — MaterialPresetStore/
      MaterialSyncClient are a separate, not-yet-ported subsystem.
  -->
  <UserControl.Resources>
    <conv:HexToBrushConverter x:Key="HexToBrush" />
  </UserControl.Resources>
  <UserControl.Styles>
    <Style Selector="RadioButton.materialtab">
      <Setter Property="Padding" Value="14,0" /><Setter Property="MinHeight" Value="36" />
      <Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="Transparent" /><Setter Property="CornerRadius" Value="8" />
      <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
      <Setter Property="FontWeight" Value="Medium" />
    </Style>
    <Style Selector="RadioButton.materialtab:checked">
      <Setter Property="Background" Value="{StaticResource Brush.SelectedSurface}" />
      <Setter Property="BorderBrush" Value="{StaticResource Brush.SelectedBorder}" />
      <Setter Property="Foreground" Value="{StaticResource Brush.AccentText}" />
    </Style>
    <Style Selector="Button.swatchcell">
      <Setter Property="MinHeight" Value="58" /><Setter Property="Margin" Value="2" /><Setter Property="Padding" Value="4" />
      <Setter Property="BorderThickness" Value="2" /><Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="CornerRadius" Value="8" /><Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.swatchcell:pointerover">
      <Setter Property="BorderBrush" Value="{StaticResource Brush.PanelBorderStrong}" />
    </Style>
    <Style Selector="Button.swatchcell.selected">
      <Setter Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,Auto,*" Margin="36,24">

    <!-- Header -->
    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,16">
      <StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="12">
          <Path Data="{StaticResource Glyph.Fill.Materials}" Width="26" Height="26" Stretch="Uniform" Fill="{StaticResource Brush.TextPrimary}" RenderTransformOrigin="0.5,0.5">
            <Path.RenderTransform><ScaleTransform ScaleX="-1" /></Path.RenderTransform>
          </Path>
          <TextBlock Text="Vzorník materiálů" FontFamily="{StaticResource Font.Display}" FontSize="22" FontWeight="SemiBold" automation:AutomationProperties.AutomationId="MaterialsHeading" />
        </StackPanel>
        <TextBlock Text="Bezpečné výchozí hodnoty jsou dostupné offline. Před ostrou úlohou je vždy ověřte na odřezku."
                   Classes="muted" TextWrapping="Wrap" Margin="38,5,0,0" />
      </StackPanel>
      <Border Grid.Column="1" Background="{StaticResource Brush.PanelRaised}" CornerRadius="999" Padding="10,5" VerticalAlignment="Top">
        <StackPanel Orientation="Horizontal" Spacing="7">
          <Ellipse Width="7" Height="7" Fill="{StaticResource Brush.Success}" />
          <TextBlock Text="Dostupné offline" FontWeight="SemiBold" />
        </StackPanel>
      </Border>
    </Grid>

    <!-- Tabs -->
    <Border Grid.Row="1" Background="{StaticResource Brush.PanelRaised}" CornerRadius="8" Padding="2" Margin="0,0,0,16" HorizontalAlignment="Left">
      <StackPanel Orientation="Horizontal" Spacing="2">
        <RadioButton x:Name="RecommendedTab" Classes="materialtab" IsChecked="True" Content="Doporučené parametry" GroupName="MaterialsTab" />
        <RadioButton x:Name="PersonalTab" Classes="materialtab" Content="Moje recepty" GroupName="MaterialsTab" />
      </StackPanel>
    </Border>

    <!-- ==================== Doporučené parametry ==================== -->
    <Grid Grid.Row="2" RowDefinitions="Auto,12,*" IsVisible="{Binding #RecommendedTab.IsChecked}">
      <Border Classes="card" Padding="14,10">
        <WrapPanel>
          <StackPanel Width="174" Margin="0,0,8,8">
            <TextBlock Text="Typ laseru" Classes="muted" Margin="0,0,0,6" />
            <ComboBox ItemsSource="{Binding Technologies}" SelectedItem="{Binding SelectedTechnology, Mode=TwoWay}"
                      automation:AutomationProperties.AutomationId="TechnologyFilter" HorizontalAlignment="Stretch" />
          </StackPanel>
          <StackPanel Width="126" Margin="0,0,8,8">
            <TextBlock Text="Výkon laseru" Classes="muted" Margin="0,0,0,6" />
            <ComboBox ItemsSource="{Binding PowerClasses}" SelectedItem="{Binding SelectedPowerWatts, Mode=TwoWay}"
                      automation:AutomationProperties.AutomationId="PowerFilter" HorizontalAlignment="Stretch" />
          </StackPanel>
          <StackPanel Width="174" Margin="0,0,8,8">
            <TextBlock Text="Operace" Classes="muted" Margin="0,0,0,6" />
            <ComboBox ItemsSource="{Binding Operations}" SelectedItem="{Binding SelectedOperation, Mode=TwoWay}"
                      automation:AutomationProperties.AutomationId="OperationFilter" HorizontalAlignment="Stretch" />
          </StackPanel>
          <StackPanel Width="220" Margin="0,0,8,8">
            <TextBlock Text="Hledat materiál" Classes="muted" Margin="0,0,0,6" />
            <Grid ColumnDefinitions="Auto,*">
              <Path Data="{StaticResource Glyph.Search}" Width="14" Height="14" Stretch="Uniform" Stroke="{StaticResource Brush.TextMuted}" StrokeThickness="1.75" VerticalAlignment="Center" Margin="0,0,8,0" />
              <TextBox Grid.Column="1" Text="{Binding SearchText, Mode=TwoWay}" BorderThickness="0" Background="Transparent" Padding="0"
                        automation:AutomationProperties.AutomationId="MaterialsSearch" automation:AutomationProperties.Name="Hledat materiál" />
            </Grid>
          </StackPanel>
          <StackPanel Width="220" Margin="0,0,8,8">
            <TextBlock Text="Text náhledu" Classes="muted" Margin="0,0,0,6" />
            <TextBox Text="{Binding PreviewText, Mode=TwoWay}" MaxLength="12" automation:AutomationProperties.Name="Text gravírovaného náhledu" />
          </StackPanel>
        </WrapPanel>
      </Border>

      <Grid Grid.Row="2" ColumnDefinitions="*,12,310">

        <Grid>
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !HasSwatchCards}">
            <Path Data="{StaticResource Glyph.Search}" Width="32" Height="32" Stretch="Uniform" Stroke="{StaticResource Brush.TextSecondary}" StrokeThickness="1.5" HorizontalAlignment="Center" />
            <TextBlock Text="Žádný materiál neodpovídá filtrům" FontWeight="SemiBold" Margin="0,10,0,0" />
            <TextBlock Text="Změňte typ laseru, výkon nebo hledaný výraz." Classes="muted" Margin="0,4,0,0" />
          </StackPanel>

          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding HasSwatchCards}">
            <ItemsControl ItemsSource="{Binding SwatchCards}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:MaterialSwatchCardViewModel">
                  <Border Width="360" Classes="card" Padding="0" Margin="0,0,12,12">
                    <Grid RowDefinitions="Auto,Auto,Auto">
                      <Border Padding="14,12" BorderBrush="{StaticResource Brush.PanelBorder}" BorderThickness="0,0,0,1">
                        <StackPanel>
                          <TextBlock Text="{Binding Material.Name}" FontWeight="SemiBold" />
                          <TextBlock Text="{Binding Material.Description}" Classes="muted" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                      </Border>
                      <Grid Grid.Row="1" Margin="10,12,12,8" ColumnDefinitions="46,*">
                        <ItemsControl ItemsSource="{Binding Speeds}" Margin="0,2,4,28">
                          <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="4" Columns="1" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:Double">
                              <TextBlock Text="{Binding StringFormat={}{0:0}}" Classes="muted" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Grid Grid.Column="1" RowDefinitions="Auto,Auto,Auto">
                          <ItemsControl ItemsSource="{Binding Cells}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="4" Columns="4" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="vm:MaterialSwatchCellViewModel">
                                <Button Classes="swatchcell" Classes.selected="{Binding IsSelected}"
                                        Background="{Binding SurfaceColor, Converter={StaticResource HexToBrush}}"
                                        Foreground="{Binding MarkColor, Converter={StaticResource HexToBrush}}"
                                        Command="{Binding $parent[UserControl].((vm:MaterialCatalogViewModel)DataContext).SelectSwatchCell, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        ToolTip.Tip="{Binding AccessibleName}" automation:AutomationProperties.Name="{Binding AccessibleName}">
                                  <TextBlock Text="{Binding $parent[UserControl].((vm:MaterialCatalogViewModel)DataContext).PreviewText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                             FontFamily="{StaticResource Font.Display}" FontSize="18" FontWeight="SemiBold"
                                             HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </Button>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                          <ItemsControl Grid.Row="1" ItemsSource="{Binding Powers}" Margin="2,2,2,0">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" Columns="4" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="x:Int32">
                                <TextBlock Text="{Binding StringFormat={}{0}%}" Classes="muted" HorizontalAlignment="Center" />
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                          <TextBlock Grid.Row="2" Text="Výkon" Classes="muted" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,2,0,0" />
                        </Grid>
                      </Grid>
                      <Border Grid.Row="2" Padding="14,10" Background="{StaticResource Brush.PanelRaised}" BorderBrush="{StaticResource Brush.PanelBorder}" BorderThickness="0,1,0,0">
                        <Grid>
                          <TextBlock Text="Klikněte na požadovaný odstín" Classes="muted" IsVisible="{Binding !HasSelection}" />
                          <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasSelection}">
                            <TextBlock Text="{Binding SelectedCell.Speed, StringFormat={}{0:0} mm/min}" FontWeight="SemiBold" />
                            <TextBlock Text="·" Classes="muted" />
                            <TextBlock Text="{Binding SelectedCell.Power, StringFormat={}{0} %}" FontWeight="SemiBold" />
                            <TextBlock Text="·" Classes="muted" />
                            <TextBlock Text="{Binding SelectedCell.Passes, StringFormat={}{0}×}" FontWeight="SemiBold" />
                          </StackPanel>
                        </Grid>
                      </Border>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>

        <Border Grid.Column="2" Classes="card" Padding="18">
          <Grid RowDefinitions="*,Auto">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !HasSelectedRecipe}">
              <Path Data="{StaticResource Glyph.Fill.Materials}" Width="32" Height="32" Stretch="Uniform" Fill="{StaticResource Brush.TextSecondary}" HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                <Path.RenderTransform><ScaleTransform ScaleX="-1" /></Path.RenderTransform>
              </Path>
              <TextBlock Text="Vyberte odstín" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,0" />
              <TextBlock Text="Klikněte na políčko ve vzorníku. Rychlost a výkon se nastaví automaticky."
                         Classes="muted" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="230" Margin="0,4,0,0" />
            </StackPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto" IsVisible="{Binding HasSelectedRecipe}">
              <StackPanel>
                <TextBlock Text="Vybrané nastavení" Classes="muted" FontWeight="SemiBold" />
                <TextBlock Text="{Binding SelectedRecipe.MaterialName}" FontFamily="{StaticResource Font.Display}" FontSize="20" FontWeight="SemiBold" Margin="0,7,0,0" />
                <TextBlock Margin="0,3,0,16" Classes="muted">
                  <Run Text="{Binding SelectedRecipe.TechnologyName, Mode=OneWay}" /><Run Text="  ·  " />
                  <Run Text="{Binding SelectedRecipe.PowerWatts, Mode=OneWay}" /><Run Text=" W  ·  " />
                  <Run Text="{Binding SelectedRecipe.OperationName, Mode=OneWay}" />
                </TextBlock>
                <Border Background="{StaticResource Brush.PanelRaised}" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                  <StackPanel>
                    <TextBlock Text="Rychlost" Classes="muted" />
                    <TextBlock Text="{Binding SelectedRecipe.SpeedMmPerMinute, StringFormat={}{0:0} mm/min}" FontSize="17" FontWeight="SemiBold" Margin="0,3,0,10" />
                    <TextBlock Text="Výkon" Classes="muted" />
                    <TextBlock Text="{Binding SelectedRecipe.PowerPercent, StringFormat={}{0:0} %}" FontSize="17" FontWeight="SemiBold" Margin="0,3,0,10" />
                    <TextBlock Text="Průchody" Classes="muted" />
                    <TextBlock Text="{Binding SelectedRecipe.Passes, StringFormat={}{0}×}" FontSize="17" FontWeight="SemiBold" Margin="0,3,0,0" />
                  </StackPanel>
                </Border>
                <Border Background="{StaticResource Brush.PanelRaised}" BorderBrush="{StaticResource Brush.Warning}" BorderThickness="1" CornerRadius="8" Padding="12"
                        IsVisible="{Binding SelectedRecipe.Warning, Converter={x:Static objconv:StringConverters.IsNotNullOrEmpty}}">
                  <TextBlock Text="{Binding SelectedRecipe.Warning}" Classes="muted" TextWrapping="Wrap" />
                </Border>
              </StackPanel>
            </ScrollViewer>
            <StackPanel Grid.Row="1" Margin="0,14,0,0" IsVisible="{Binding HasSelectedRecipe}">
              <TextBlock Text="Použít na vrstvu" Classes="muted" Margin="0,0,0,6" />
              <ComboBox x:Name="TargetLayerComboBox"
                        ItemsSource="{Binding $parent[UserControl].((vm:ShellViewModel)DataContext).Editor.Layers, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="layers:LayerSettings">
                    <TextBlock Text="{Binding Name}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <Button Classes="primary" Margin="0,10,0,0" HorizontalAlignment="Stretch" Click="OnApplySelectedRecipeClick"
                      IsEnabled="{Binding #TargetLayerComboBox.SelectedItem, Converter={x:Static objconv:ObjectConverters.IsNotNull}}">
                <StackPanel Orientation="Horizontal" Spacing="7" HorizontalAlignment="Center">
                  <Path Data="{StaticResource Glyph.Check}" Width="14" Height="14" Stretch="Uniform" Stroke="White" StrokeThickness="1.75" />
                  <TextBlock Text="Použít parametry" Foreground="White" />
                </StackPanel>
              </Button>
            </StackPanel>
          </Grid>
        </Border>
      </Grid>
    </Grid>

    <!-- ==================== Moje recepty ====================
         Custom presets + Lasero-account cloud sync (MaterialPresetStore/MaterialSyncClient) are not
         ported — a separate subsystem. Honest "not available yet" notice, not a fake CRUD list. -->
    <Border Grid.Row="2" Classes="card" Padding="24" IsVisible="{Binding #PersonalTab.IsChecked}" VerticalAlignment="Top">
      <StackPanel HorizontalAlignment="Center" Margin="12,22" MaxWidth="360">
        <Path Data="{StaticResource Glyph.CloudSync}" Width="32" Height="32" Stretch="Uniform" Stroke="{StaticResource Brush.TextSecondary}" StrokeThickness="1.5" HorizontalAlignment="Center" />
        <TextBlock Text="Vlastní recepty zatím nejsou dostupné" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,10,0,0" />
        <TextBlock Text="Ukládání vlastních parametrů a synchronizace s účtem Lasero vyžadují ještě neportovanou část aplikace."
                   Classes="muted" TextWrapping="Wrap" TextAlignment="Center" Margin="0,5,0,0" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
