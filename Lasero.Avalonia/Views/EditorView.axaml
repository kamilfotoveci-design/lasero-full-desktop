<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Lasero.Avalonia.ViewModels"
             xmlns:controls="using:Lasero.Avalonia.Controls"
             xmlns:conv="using:Lasero.Avalonia.Converters"
             xmlns:objconv="using:Avalonia.Data.Converters"
             xmlns:layers="using:Lasero.Core.Layers"
             xmlns:automation="using:Avalonia.Automation"
             x:Class="Lasero.Avalonia.Views.EditorView"
             x:DataType="vm:ShellViewModel">
  <UserControl.Resources>
    <conv:ShapeKindToIconConverter x:Key="ShapeKindToIcon" />
    <conv:ShapeKindToTooltipConverter x:Key="ShapeKindToTooltip" />
    <conv:RgbColorToBrushConverter x:Key="RgbColorToBrush" />
  </UserControl.Resources>
  <UserControl.Styles>
    <Style Selector="ToggleButton.railtool, Button.railtool">
      <Setter Property="Width" Value="36" /><Setter Property="Height" Value="36" /><Setter Property="MinHeight" Value="36" />
      <Setter Property="Padding" Value="8" /><Setter Property="Margin" Value="0,1" />
      <Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="CornerRadius" Value="6" /><Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
    </Style>
    <Style Selector="ToggleButton.railtool:checked, Button.railtool.checked">
      <Setter Property="Background" Value="{StaticResource Brush.SelectedSurface}" />
      <Setter Property="BorderBrush" Value="{StaticResource Brush.SelectedBorder}" />
      <Setter Property="Foreground" Value="{StaticResource Brush.Accent}" />
    </Style>
    <Style Selector="ToggleButton.shapepicker">
      <Setter Property="Width" Value="44" /><Setter Property="Height" Value="44" />
      <Setter Property="Margin" Value="2" /><Setter Property="Padding" Value="10" />
      <Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="CornerRadius" Value="6" /><Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
    </Style>
    <Style Selector="ToggleButton.shapepicker:checked">
      <Setter Property="Background" Value="{StaticResource Brush.SelectedSurface}" />
      <Setter Property="Foreground" Value="{StaticResource Brush.Accent}" />
    </Style>
    <Style Selector="TextBlock.inspector-heading"><Setter Property="FontSize" Value="15" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
    <Style Selector="TextBlock.inspector-label"><Setter Property="FontSize" Value="12" /><Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" /></Style>
  </UserControl.Styles>

  <Grid ColumnDefinitions="56,*,6,320" Background="{StaticResource Brush.Background}">
    <Border Grid.Column="0" Background="{StaticResource Brush.Panel}" BorderBrush="{StaticResource Brush.PanelBorder}" BorderThickness="0,0,1,0">
      <Grid RowDefinitions="Auto,Auto,Auto,*,Auto,Auto" Margin="0,10">
        <Button Classes="railtool" Command="{Binding GoHome}" ToolTip.Tip="Domů — přehled projektů, úloh a zařízení"
                automation:AutomationProperties.AutomationId="EditorHome" automation:AutomationProperties.Name="Domů">
          <Path Data="{StaticResource Glyph.Home}" Width="20" Height="20" Stretch="Uniform" Stroke="{StaticResource Brush.TextSecondary}" StrokeThickness="1.75" />
        </Button>
        <Border Grid.Row="1" Height="1" Margin="12,10" Background="{StaticResource Brush.PanelBorder}" />
        <StackPanel Grid.Row="2">
          <ToggleButton Classes="railtool" IsChecked="{Binding Editor.IsSelectTool, Mode=OneWay}" Command="{Binding Editor.SelectTool}" ToolTip.Tip="Vybrat a upravit objekty (V)" automation:AutomationProperties.AutomationId="ToolSelect" automation:AutomationProperties.Name="Vybrat"><Path Data="{StaticResource Glyph.Select}" Width="20" Height="20" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="1.75" /></ToggleButton>
          <ToggleButton Classes="railtool" IsChecked="{Binding Editor.IsTextTool, Mode=OneWay}" Command="{Binding Editor.TextTool}" ToolTip.Tip="Vložit text (T)" automation:AutomationProperties.AutomationId="ToolText" automation:AutomationProperties.Name="Text"><Path Data="{StaticResource Glyph.Text}" Width="20" Height="20" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="1.75" /></ToggleButton>
          <Grid HorizontalAlignment="Center">
            <Button x:Name="ShapeToolButton" Classes="railtool" Classes.checked="{Binding Editor.IsShapeTool}"
                    ToolTip.Tip="{Binding Editor.CurrentShapeTool, Converter={StaticResource ShapeKindToTooltip}}"
                    automation:AutomationProperties.AutomationId="ToolShape" automation:AutomationProperties.Name="Tvary"
                    PointerPressed="OnShapeButtonPointerPressed" PointerMoved="OnShapeButtonPointerMoved"
                    PointerReleased="OnShapeButtonPointerReleased" PointerExited="OnShapeButtonPointerExited">
              <Grid>
                <Path Data="{Binding Editor.CurrentShapeTool, Converter={StaticResource ShapeKindToIcon}}" Width="20" Height="20" Stretch="Uniform"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.75" />
                <!-- Quick-access hint: this button holds more shapes behind it. Matches WPF's tiny
                     low-contrast corner triangle exactly (same geometry/opacity/position). -->
                <Path Data="M0,6 L6,6 L6,0 Z" Fill="{StaticResource Brush.TextMuted}" Width="6" Height="6" Opacity="0.55"
                      IsHitTestVisible="False" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,2,2" />
              </Grid>
            </Button>
            <Popup x:Name="ShapePickerPopup" Placement="Right"
                   HorizontalOffset="6" IsLightDismissEnabled="True" Closed="OnShapePickerClosed">
              <Border Background="{StaticResource Brush.Panel}" BorderBrush="{StaticResource Brush.PanelBorder}"
                      BorderThickness="1" CornerRadius="8" Padding="8">
                <UniformGrid Columns="4" Rows="2">
                  <ToggleButton Classes="shapepicker" ToolTip.Tip="Obdélník (R)" Tag="{x:Static vm:ShapeKind.Rectangle}"
                                IsChecked="{Binding Editor.CurrentShapeTool, Converter={x:Static objconv:ObjectConverters.Equal}, ConverterParameter={x:Static vm:ShapeKind.Rectangle}, Mode=OneWay}"
                                automation:AutomationProperties.Name="Obdélník" Click="OnShapePickerItemClick">
                    <Path Data="{StaticResource Glyph.Rectangle}" Width="20" Height="20" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="1.75" />
                  </ToggleButton>
                  <ToggleButton Classes="shapepicker" ToolTip.Tip="Elipsa (E)" Tag="{x:Static vm:ShapeKind.Ellipse}"
                                IsChecked="{Binding Editor.CurrentShapeTool, Converter={x:Static objconv:ObjectConverters.Equal}, ConverterParameter={x:Static vm:ShapeKind.Ellipse}, Mode=OneWay}"
                                automation:AutomationProperties.Name="Elipsa" Click="OnShapePickerItemClick">
                    <Path Data="{StaticResource Glyph.Ellipse}" Width="20" Height="20" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="1.75" />
                  </ToggleButton>
                  <ToggleButton Classes="shapepicker" ToolTip.Tip="Trojúhelník" Tag="{x:Static vm:ShapeKind.Triangle}"
                                IsChecked="{Binding Editor.CurrentShapeTool, Converter={x:Static objconv:ObjectConverters.Equal}, ConverterParameter={x:Static vm:ShapeKind.Triangle}, Mode=OneWay}"
                                automation:AutomationProperties.Name="Trojúhelník" Click="OnShapePickerItemClick">
                    <Path Data="{StaticResource Glyph.Triangle}" Width="20" Height="20" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="1.75" />
                  </ToggleButton>
                  <ToggleButton Classes="shapepicker" ToolTip.Tip="Pětiúhelník" Tag="{x:Static vm:ShapeKind.Pentagon}"
                                IsChecked="{Binding Editor.CurrentShapeTool, Converter={x:Static objconv:ObjectConverters.Equal}, ConverterParameter={x:Static vm:ShapeKind.Pentagon}, Mode=OneWay}"
                                automation:AutomationProperties.Name="Pětiúhelník" Click="OnShapePickerItemClick">
                    <Path Data="{StaticResource Glyph.Pentagon}" Width="20" Height="20" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="1.75" />
                  </ToggleButton>
                  <ToggleButton Classes="shapepicker" ToolTip.Tip="Šestiúhelník" Tag="{x:Static vm:ShapeKind.Hexagon}"
                                IsChecked="{Binding Editor.CurrentShapeTool, Converter={x:Static objconv:ObjectConverters.Equal}, ConverterParameter={x:Static vm:ShapeKind.Hexagon}, Mode=OneWay}"
                                automation:AutomationProperties.Name="Šestiúhelník" Click="OnShapePickerItemClick">
                    <Path Data="{StaticResource Glyph.Hexagon}" Width="20" Height="20" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="1.75" />
                  </ToggleButton>
                  <ToggleButton Classes="shapepicker" ToolTip.Tip="Osmiúhelník" Tag="{x:Static vm:ShapeKind.Octagon}"
                                IsChecked="{Binding Editor.CurrentShapeTool, Converter={x:Static objconv:ObjectConverters.Equal}, ConverterParameter={x:Static vm:ShapeKind.Octagon}, Mode=OneWay}"
                                automation:AutomationProperties.Name="Osmiúhelník" Click="OnShapePickerItemClick">
                    <Path Data="{StaticResource Glyph.Octagon}" Width="20" Height="20" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="1.75" />
                  </ToggleButton>
                  <ToggleButton Classes="shapepicker" ToolTip.Tip="Hvězda" Tag="{x:Static vm:ShapeKind.Star}"
                                IsChecked="{Binding Editor.CurrentShapeTool, Converter={x:Static objconv:ObjectConverters.Equal}, ConverterParameter={x:Static vm:ShapeKind.Star}, Mode=OneWay}"
                                automation:AutomationProperties.Name="Hvězda" Click="OnShapePickerItemClick">
                    <Path Data="{StaticResource Glyph.Star}" Width="20" Height="20" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="1.75" />
                  </ToggleButton>
                  <ToggleButton Classes="shapepicker" ToolTip.Tip="Dvojitá hvězda" Tag="{x:Static vm:ShapeKind.DoubleStar}"
                                IsChecked="{Binding Editor.CurrentShapeTool, Converter={x:Static objconv:ObjectConverters.Equal}, ConverterParameter={x:Static vm:ShapeKind.DoubleStar}, Mode=OneWay}"
                                automation:AutomationProperties.Name="Dvojitá hvězda" Click="OnShapePickerItemClick">
                    <Path Data="{StaticResource Glyph.DoubleStar}" Width="20" Height="20" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="1.75" />
                  </ToggleButton>
                </UniformGrid>
              </Border>
            </Popup>
          </Grid>
          <ToggleButton Classes="railtool" IsChecked="{Binding Editor.IsLineTool, Mode=OneWay}" Command="{Binding Editor.LineTool}" ToolTip.Tip="Nakreslit čáru (L)" automation:AutomationProperties.AutomationId="ToolLine" automation:AutomationProperties.Name="Čára"><Path Data="{StaticResource Glyph.Line}" Width="20" Height="20" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="1.75" /></ToggleButton>
          <Button Classes="railtool" Click="OnImportGraphicsClick" ToolTip.Tip="Importovat grafiku (SVG, PNG, JPG, BMP)" automation:AutomationProperties.Name="Importovat grafiku"><Path Data="{StaticResource Glyph.Import}" Width="20" Height="20" Stretch="Uniform" Stroke="{StaticResource Brush.TextSecondary}" StrokeThickness="1.75" /></Button>
        </StackPanel>
        <Border Grid.Row="4" Height="1" Margin="12,10" Background="{StaticResource Brush.PanelBorder}" />
        <StackPanel Grid.Row="5">
          <Button Classes="railtool" Command="{Binding GoMaterials}" ToolTip.Tip="Materiály" automation:AutomationProperties.Name="Materiály">
            <Path Data="{StaticResource Glyph.Fill.Materials}" Width="20" Height="20" Stretch="Uniform" Fill="{StaticResource Brush.TextSecondary}" RenderTransformOrigin="0.5,0.5">
              <Path.RenderTransform><ScaleTransform ScaleX="-1" /></Path.RenderTransform>
            </Path>
          </Button>
          <Button Classes="railtool" Command="{Binding GoDevices}" ToolTip.Tip="Zařízení" automation:AutomationProperties.Name="Zařízení">
            <Path Data="{StaticResource Glyph.Fill.Device}" Width="20" Height="20" Stretch="Uniform" Fill="{StaticResource Brush.TextSecondary}" RenderTransformOrigin="0.5,0.5">
              <Path.RenderTransform><ScaleTransform ScaleX="-1" /></Path.RenderTransform>
            </Path>
          </Button>
          <Button Classes="railtool" Command="{Binding GoSettings}" ToolTip.Tip="Nastavení" automation:AutomationProperties.Name="Nastavení"><Path Data="{StaticResource Glyph.Settings}" Width="20" Height="20" Stretch="Uniform" Stroke="{StaticResource Brush.TextSecondary}" StrokeThickness="1.75" /></Button>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Column="1" ClipToBounds="True">
      <controls:DesignerCanvas Document="{Binding Editor.Document}" SelectedObject="{Binding Editor.SelectedObject, Mode=TwoWay}"
                               Editor="{Binding Editor}"
                               ActiveTool="{Binding Editor.ActiveTool}" Zoom="{Binding Editor.Zoom, Mode=TwoWay}"
                               PanX="{Binding Editor.PanX, Mode=TwoWay}" PanY="{Binding Editor.PanY, Mode=TwoWay}"
                               WorkAreaWidthMm="500" WorkAreaHeightMm="400"
                               automation:AutomationProperties.AutomationId="DesignerCanvas" automation:AutomationProperties.Name="Pracovní plátno" />
      <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,20,20" Background="{StaticResource Brush.Panel}"
              BorderBrush="{StaticResource Brush.PanelBorder}" BorderThickness="1" CornerRadius="8" Padding="4">
        <StackPanel Orientation="Horizontal" Spacing="2">
          <Button Width="32" MinHeight="32" Padding="6" Command="{Binding Editor.Undo}" ToolTip.Tip="Zpět · Ctrl+Z" automation:AutomationProperties.AutomationId="Undo" automation:AutomationProperties.Name="Zpět"><Path Data="{StaticResource Glyph.Undo}" Stretch="Uniform" Stroke="{StaticResource Brush.TextPrimary}" StrokeThickness="1.75" /></Button>
          <Button Width="32" MinHeight="32" Padding="6" Command="{Binding Editor.Redo}" ToolTip.Tip="Znovu · Ctrl+Y" automation:AutomationProperties.AutomationId="Redo" automation:AutomationProperties.Name="Znovu"><Path Data="{StaticResource Glyph.Redo}" Stretch="Uniform" Stroke="{StaticResource Brush.TextPrimary}" StrokeThickness="1.75" /></Button>
          <Border Width="1" Height="16" Margin="6,0" Background="{StaticResource Brush.PanelBorder}" />
          <Button Width="32" MinHeight="32" Padding="6" Command="{Binding Editor.CenterView}" ToolTip.Tip="Vycentrovat pracovní plochu — měřítko zůstane" automation:AutomationProperties.Name="Vycentrovat pracovní plochu"><Path Data="{StaticResource Glyph.Origin}" Stretch="Uniform" Stroke="{StaticResource Brush.TextPrimary}" StrokeThickness="1.75" /></Button>
          <Border Width="1" Height="16" Margin="6,0" Background="{StaticResource Brush.PanelBorder}" />
          <Button Width="32" MinHeight="32" Padding="6" Command="{Binding Editor.ZoomOut}" ToolTip.Tip="Oddálit" automation:AutomationProperties.AutomationId="ZoomOut"><Path Data="{StaticResource Glyph.ZoomOut}" Stretch="Uniform" Stroke="{StaticResource Brush.TextPrimary}" StrokeThickness="1.75" /></Button>
          <Button MinHeight="32" Padding="8,0" Content="{Binding Editor.ZoomPercent}" Command="{Binding Editor.ResetView}" ToolTip.Tip="Měřítko plátna" automation:AutomationProperties.AutomationId="ZoomReset" />
          <Button Width="32" MinHeight="32" Padding="6" Command="{Binding Editor.ZoomIn}" ToolTip.Tip="Přiblížit" automation:AutomationProperties.AutomationId="ZoomIn"><Path Data="{StaticResource Glyph.ZoomIn}" Stretch="Uniform" Stroke="{StaticResource Brush.TextPrimary}" StrokeThickness="1.75" /></Button>
          <Button Width="32" MinHeight="32" Padding="6" Command="{Binding Editor.ResetView}" ToolTip.Tip="Přizpůsobit oknu (F)" automation:AutomationProperties.Name="Přizpůsobit oknu"><Path Data="{StaticResource Glyph.Fit}" Stretch="Uniform" Stroke="{StaticResource Brush.TextPrimary}" StrokeThickness="1.75" /></Button>
        </StackPanel>
      </Border>
    </Grid>

    <GridSplitter Grid.Column="2" ResizeDirection="Columns" Background="Transparent" automation:AutomationProperties.Name="Změnit šířku panelu vlastností" />
    <Border Grid.Column="3" Background="{StaticResource Brush.Panel}" BorderBrush="{StaticResource Brush.PanelBorder}" BorderThickness="1,0,0,0">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>

          <!-- ==================== ZAŘÍZENÍ ====================
               A summary, not a control panel — matches Lasero.App's DesignerInspectorView. Device
               connection is not ported yet (MIGRATION.md step 6), so this honestly shows "no device"
               instead of inventing a connected state. Full manual controls stay on the Zařízení screen. -->
          <StackPanel Margin="16,14">
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,10">
              <Path Data="{StaticResource Glyph.Fill.Device}" Width="18" Height="18" Stretch="Uniform" Fill="{StaticResource Brush.TextSecondary}" RenderTransformOrigin="0.5,0.5">
                <Path.RenderTransform><ScaleTransform ScaleX="-1" /></Path.RenderTransform>
              </Path>
              <TextBlock Text="Žádné zařízení" Foreground="{StaticResource Brush.TextMuted}" FontWeight="SemiBold" />
            </StackPanel>
            <Border Background="{StaticResource Brush.PanelRaised}" CornerRadius="6" Padding="10,8">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="Nepřipojeno" Classes="inspector-label" />
                <TextBlock Grid.Column="1" Text="—" Classes="inspector-label" />
              </Grid>
            </Border>
            <Button Command="{Binding GoDevices}" HorizontalAlignment="Left" Background="Transparent" BorderBrush="Transparent"
                    Padding="0,8" Foreground="{StaticResource Brush.TextSecondary}" Margin="0,4,0,0"
                    ToolTip.Tip="Otevřít ruční ovládání gravírky" automation:AutomationProperties.Name="Ovládání stroje">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Text="Ovládání stroje" VerticalAlignment="Center" />
                <Path Data="{StaticResource Glyph.ChevronRight}" Width="14" Height="14" Stretch="Uniform" Stroke="{StaticResource Brush.TextSecondary}" StrokeThickness="1.75" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </StackPanel>

          <Border Height="1" Background="{StaticResource Brush.PanelBorder}" />

          <!-- ==================== OBRÁZEK ====================
               Shown only when exactly one bitmap (raster) object is selected — never for SVG paths,
               text or shapes. Matches Lasero.App's DesignerInspectorView OBRÁZEK section: same section
               chrome, "Odstranit pozadí" reads as an ordinary bitmap edit (spinner + inline status, no
               AI-branded dialog — the one-time model download is the only step with a confirm prompt).
               "Trasovat bitmapu" lives here rather than on a floating selection toolbar because Avalonia
               doesn't have Lasero.App's SelectionPropertiesBar yet (WPF puts it there instead) — a
               placement difference, not a missing feature. -->
          <StackPanel Margin="16,14" IsVisible="{Binding Editor.IsSelectedRaster}">
            <TextBlock Text="Obrázek" Classes="inspector-heading" Margin="0,0,0,10" />

            <Button Classes="secondary" HorizontalAlignment="Stretch" Height="36" Margin="0,0,0,8"
                    Command="{Binding Editor.TraceSelectedRaster}"
                    IsVisible="{Binding Editor.CanTraceSelectedRaster}"
                    ToolTip.Tip="Alt+T" automation:AutomationProperties.Name="Trasovat bitmapu">
              <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                <Path Data="{StaticResource Glyph.Rectangle}" Width="16" Height="16" Stretch="Uniform" Stroke="{StaticResource Brush.TextPrimary}" StrokeThickness="1.75" />
                <TextBlock Text="Trasovat bitmapu" VerticalAlignment="Center" />
              </StackPanel>
            </Button>

            <Button Classes="secondary" HorizontalAlignment="Stretch" Height="36"
                    Command="{Binding Editor.RemoveSelectedBackground}"
                    IsVisible="{Binding Editor.CanRemoveSelectedBackground}"
                    Content="Odstranit pozadí" automation:AutomationProperties.Name="Odstranit pozadí" />

            <Button Classes="secondary" HorizontalAlignment="Stretch" Height="36"
                    Command="{Binding Editor.RestoreSelectedBackground}"
                    IsVisible="{Binding Editor.CanRestoreSelectedBackground}"
                    Content="Obnovit pozadí" automation:AutomationProperties.Name="Obnovit pozadí" />

            <Border Margin="0,8,0,0" Background="{StaticResource Brush.PanelRaised}" CornerRadius="{StaticResource Radius.Sm}" Padding="10,8"
                    IsVisible="{Binding Editor.IsRemovingBackground}">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <ProgressBar Width="72" Height="4" Minimum="0" Maximum="1" Value="{Binding Editor.BackgroundRemovalProgress}" />
                <TextBlock Text="{Binding Editor.BackgroundRemovalStatus}" Classes="inspector-label" VerticalAlignment="Center" />
              </StackPanel>
            </Border>

            <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{StaticResource Brush.Danger}"
                       Text="{Binding Editor.BackgroundRemovalError}"
                       IsVisible="{Binding Editor.BackgroundRemovalError, Converter={x:Static objconv:StringConverters.IsNotNullOrEmpty}}" />
          </StackPanel>

          <Border Height="1" Background="{StaticResource Brush.PanelBorder}" IsVisible="{Binding Editor.IsSelectedRaster}" />

          <!-- ==================== OPERACE ====================
               The operation stack, top to bottom in the order the machine runs it — real data, the
               same Lasero.Core.Layers.LayerSettings collection Lasero.App reads (Editor.Layers /
               Editor.Document.Layers), not a mock. Per-row enable/visibility toggle, reordering,
               selection and delete are wired; the row's right-click context menu (isolate/duplicate/
               assign-selection) is not — it depends on Avalonia's Designer not yet having a
               multi-select model, so it is left for a later pass rather than faked. -->
          <StackPanel Margin="16,14">
            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,4">
              <TextBlock Text="Operace" Classes="inspector-heading" />
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" IsVisible="{Binding Editor.CanReorderLayers}">
                <Button Width="26" Height="26" MinHeight="26" Padding="5" Background="Transparent" BorderBrush="Transparent"
                        Command="{Binding Editor.MoveSelectedLayerUp}" ToolTip.Tip="Posunout operaci dřív v pořadí"
                        automation:AutomationProperties.Name="Posunout operaci nahoru">
                  <Path Data="{StaticResource Glyph.ArrowUp}" Stretch="Uniform" Stroke="{StaticResource Brush.TextSecondary}" StrokeThickness="1.75" />
                </Button>
                <Button Width="26" Height="26" MinHeight="26" Padding="5" Background="Transparent" BorderBrush="Transparent"
                        Command="{Binding Editor.MoveSelectedLayerDown}" ToolTip.Tip="Posunout operaci později v pořadí"
                        automation:AutomationProperties.Name="Posunout operaci dolů">
                  <Path Data="{StaticResource Glyph.ArrowDown}" Stretch="Uniform" Stroke="{StaticResource Brush.TextSecondary}" StrokeThickness="1.75" />
                </Button>
              </StackPanel>
            </Grid>

            <TextBlock Text="Pořadí shora dolů je pořadí, ve kterém stroj operace provede." Classes="muted"
                       TextWrapping="Wrap" Margin="0,0,0,8" IsVisible="{Binding Editor.CanReorderLayers}" />

            <ListBox x:Name="LayersList" ItemsSource="{Binding Editor.Layers}" SelectedItem="{Binding Editor.SelectedLayer, Mode=TwoWay}"
                     MaxHeight="280" BorderThickness="0" Background="Transparent" Padding="0"
                     IsVisible="{Binding Editor.HasLayers}"
                     ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     automation:AutomationProperties.Name="Seznam operací">
              <ListBox.Styles>
                <Style Selector="ListBoxItem"><Setter Property="Padding" Value="6,0" /><Setter Property="CornerRadius" Value="6" /><Setter Property="Margin" Value="0,1" /></Style>
                <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="{StaticResource Brush.PanelRaised}" /></Style>
                <Style Selector="ListBoxItem:selected /template/ ContentPresenter"><Setter Property="Background" Value="{StaticResource Brush.SelectedSurface}" /></Style>
              </ListBox.Styles>
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="layers:LayerSettings">
                  <Grid MinHeight="44" ColumnDefinitions="16,*,Auto" Margin="0,6">
                    <Border Grid.Column="0" Width="16" Height="16" CornerRadius="3" VerticalAlignment="Center" Margin="0,0,10,0"
                            Background="{Binding Color, Converter={StaticResource RgbColorToBrush}}"
                            BorderBrush="{StaticResource Brush.PanelBorderStrong}" BorderThickness="1" ToolTip.Tip="Barva operace" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Name}" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding ProcessingSummary}" Classes="muted" TextTrimming="CharacterEllipsis"
                                 ToolTip.Tip="{Binding ProcessingSummary}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="2">
                      <ToggleButton Width="26" Height="26" MinHeight="26" Padding="4" Background="Transparent" BorderBrush="Transparent"
                                    IsChecked="{Binding IsEnabled, Mode=TwoWay}" automation:AutomationProperties.Name="Zpracovat vrstvu">
                        <Path Data="{StaticResource Glyph.Zap}" Stretch="Uniform" Stroke="{StaticResource Brush.TextSecondary}" StrokeThickness="1.75" />
                      </ToggleButton>
                      <ToggleButton Width="26" Height="26" MinHeight="26" Padding="4" Background="Transparent" BorderBrush="Transparent"
                                    IsChecked="{Binding IsVisible, Mode=TwoWay}" automation:AutomationProperties.Name="Zobrazit vrstvu na plátně">
                        <Path Data="{StaticResource Glyph.Eye}" Stretch="Uniform" Stroke="{StaticResource Brush.TextSecondary}" StrokeThickness="1.75" />
                      </ToggleButton>
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel Margin="0,6,0,0" IsVisible="{Binding !Editor.HasLayers}">
              <TextBlock Text="Zatím žádné operace" FontWeight="Medium" />
              <TextBlock Text="Nakreslete tvar nebo importujte grafiku. Operace se vytvoří automaticky."
                         Classes="muted" TextWrapping="Wrap" Margin="0,3,0,0" />
            </StackPanel>
          </StackPanel>

          <!-- ==================== NASTAVENÍ OPERACE ==================== -->
          <Border Height="1" Background="{StaticResource Brush.PanelBorder}" IsVisible="{Binding Editor.SelectedLayer, Converter={x:Static objconv:ObjectConverters.IsNotNull}}" />

          <StackPanel Margin="16,14,16,20"
                      IsVisible="{Binding ((vm:ShellViewModel)DataContext).Editor.SelectedLayer, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={x:Static objconv:ObjectConverters.IsNotNull}}"
                      DataContext="{Binding Editor.SelectedLayer}">
            <TextBlock Text="Nastavení operace" Classes="inspector-heading" Margin="0,0,0,12" />

            <TextBox Text="{Binding Name, Mode=TwoWay}" Height="32" Padding="10,0" VerticalContentAlignment="Center"
                     MaxLength="60" Margin="0,0,0,14" ToolTip.Tip="Název operace" automation:AutomationProperties.Name="Název operace" />

            <StackPanel IsEnabled="{Binding IsEnabled}">

              <!-- Materiál: label is real (LayerSettings.MaterialDisplayLabel). "Změnit" now opens the
                   real inline grouped-recipe flyout (port of WPF's OnApplyMaterialClick), built from
                   the same ShellViewModel.Materials MaterialCatalogViewModel the Materiály screen
                   uses — not a second recipe list. -->
              <TextBlock Text="Materiál" Classes="inspector-label" Margin="0,0,0,6" />
              <Border Background="{StaticResource Brush.PanelRaised}" CornerRadius="6" Padding="10,8" Margin="0,0,0,16">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="{Binding MaterialDisplayLabel}" TextTrimming="CharacterEllipsis" />
                  <Button x:Name="ChangeMaterialButton" Grid.Column="1" Content="Změnit →" Background="Transparent" BorderBrush="Transparent"
                          Foreground="{StaticResource Brush.Accent}" Padding="0" MinHeight="0"
                          Click="OnApplyMaterialClick"
                          ToolTip.Tip="Vybrat ověřené parametry materiálu" automation:AutomationProperties.Name="Změnit materiál" />
                </Grid>
              </Border>

              <!-- Režim -->
              <StackPanel Margin="0,0,0,16" IsVisible="{Binding !IsRaster}">
                <TextBlock Text="Režim zpracování" Classes="inspector-label" Margin="0,0,0,6" />
                <Grid ColumnDefinitions="*,*,*">
                  <RadioButton Grid.Column="0" GroupName="LayerModeSegments" Content="Čára" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                               ToolTip.Tip="Laser projede po obrysu vektoru" automation:AutomationProperties.Name="Režim čára"
                               IsChecked="{Binding Mode, Converter={x:Static objconv:ObjectConverters.Equal}, ConverterParameter={x:Static layers:LayerMode.Cut}, Mode=TwoWay}" />
                  <RadioButton Grid.Column="1" GroupName="LayerModeSegments" Content="Výplň" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                               ToolTip.Tip="Laser vyplní uzavřenou plochu řádky" automation:AutomationProperties.Name="Režim výplň"
                               IsChecked="{Binding Mode, Converter={x:Static objconv:ObjectConverters.Equal}, ConverterParameter={x:Static layers:LayerMode.Fill}, Mode=TwoWay}" />
                  <RadioButton Grid.Column="2" GroupName="LayerModeSegments" Content="Obojí" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                               ToolTip.Tip="Laser nejdřív vyplní plochu a potom projede obrys" automation:AutomationProperties.Name="Režim výplň a čára"
                               IsChecked="{Binding Mode, Converter={x:Static objconv:ObjectConverters.Equal}, ConverterParameter={x:Static layers:LayerMode.FillAndCut}, Mode=TwoWay}" />
                </Grid>
              </StackPanel>

              <!-- A raster layer has no mode to choose. -->
              <Border Background="{StaticResource Brush.PanelRaised}" CornerRadius="6" Padding="10,8" Margin="0,0,0,16" IsVisible="{Binding IsRaster}">
                <StackPanel>
                  <TextBlock Text="Obrázek · řádkové gravírování" FontWeight="Medium" />
                  <TextBlock Text="Převedeno do černobílého rastru metodou Stucki." Classes="muted" TextWrapping="Wrap" Margin="0,2,0,0" />
                </StackPanel>
              </Border>

              <!-- Výkon -->
              <StackPanel Margin="0,0,0,18">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="Výkon" />
                  <TextBlock Grid.Column="1" Text="{Binding Power, StringFormat={}{0:0.#} %}" Classes="muted" />
                </Grid>
                <Slider Minimum="0" Maximum="100" TickFrequency="1" Value="{Binding Power, Mode=TwoWay}" Margin="0,4,0,0" />
              </StackPanel>

              <!-- Rychlost -->
              <StackPanel Margin="0,0,0,18">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="Rychlost" />
                  <TextBlock Grid.Column="1" Text="{Binding Speed, StringFormat={}{0:0} mm/min}" Classes="muted" />
                </Grid>
                <Slider Minimum="10" Maximum="12000" TickFrequency="10" Value="{Binding Speed, Mode=TwoWay}" Margin="0,4,0,0" />
              </StackPanel>

              <!-- Počet průchodů -->
              <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,4">
                <TextBlock Text="Počet průchodů" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                  <Button Width="26" Height="26" MinHeight="26" Padding="0" Background="Transparent" BorderBrush="Transparent"
                          Content="−" Click="OnPassesDecrementClick" ToolTip.Tip="O jeden průchod méně" automation:AutomationProperties.Name="Ubrat průchod" />
                  <TextBox Width="56" Height="26" Padding="6,0" TextAlignment="Center" Text="{Binding Passes, Mode=TwoWay}"
                           ToolTip.Tip="Kolikrát laser projede stejnou dráhu" automation:AutomationProperties.Name="Počet průchodů" />
                  <Button Width="26" Height="26" MinHeight="26" Padding="0" Background="Transparent" BorderBrush="Transparent"
                          Content="+" Click="OnPassesIncrementClick" ToolTip.Tip="O jeden průchod víc" automation:AutomationProperties.Name="Přidat průchod" />
                </StackPanel>
              </Grid>

              <!-- Interval řádků: only meaningful for Fill/FillAndCut/raster layers, same rule as
                   Lasero.App's FillOnlyRow (now LayerSettings.UsesFillInterval, a small shared Core
                   addition — a pure outline cut never scans lines). -->
              <Grid IsEnabled="{Binding UsesFillInterval}" Margin="0,14,0,0" ColumnDefinitions="*,Auto">
                <TextBlock Text="Interval řádků" VerticalAlignment="Center" />
                <TextBox Grid.Column="1" Width="100" Height="26" Padding="6,0" TextAlignment="Right"
                         Text="{Binding FillLineIntervalMm, Mode=TwoWay, StringFormat=0.###}"
                         ToolTip.Tip="Rozestup gravírovaných řádků v mm" automation:AutomationProperties.Name="Rozestup řádků v milimetrech" />
              </Grid>
            </StackPanel>

            <Button Margin="0,16,0,0" HorizontalAlignment="Left" Padding="0" Background="Transparent" BorderBrush="Transparent"
                    Foreground="{StaticResource Brush.Danger}" IsEnabled="{Binding ((vm:ShellViewModel)DataContext).Editor.CanDeleteSelectedLayer, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    Command="{Binding ((vm:ShellViewModel)DataContext).Editor.DeleteSelectedLayer, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    ToolTip.Tip="{Binding ((vm:ShellViewModel)DataContext).Editor.SelectedLayerUsageLabel, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    automation:AutomationProperties.Name="Odstranit operaci">
              <StackPanel Orientation="Horizontal" Spacing="7">
                <Path Data="{StaticResource Glyph.Delete}" Width="16" Height="16" Stretch="Uniform" Stroke="{StaticResource Brush.Danger}" StrokeThickness="1.75" />
                <TextBlock Text="Odstranit operaci" />
              </StackPanel>
            </Button>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Border>
  </Grid>
</UserControl>
