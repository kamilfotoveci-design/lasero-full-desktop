<Window x:Class="Lasero.App.BitmapTraceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:components="clr-namespace:Lasero.App.Components"
        xmlns:conv="clr-namespace:Lasero.App.Converters"
        xmlns:input="clr-namespace:Lasero.App.Input"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Trasovat obrázek" Width="1120" Height="800" MinWidth="960" MinHeight="680"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" WindowStyle="None"
        Background="{StaticResource Brush.Background}" Foreground="{StaticResource Brush.TextPrimary}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:DecimalTextConverter x:Key="DecimalText" />

        <!-- A typed number: right aligned tabular figures, comma or dot accepted, committed on Enter or on leaving the field. -->
        <Style x:Key="Trace.Number" TargetType="TextBox" BasedOn="{StaticResource SettingNumberInput}">
            <Setter Property="Width" Value="84" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Height" Value="{StaticResource Size.Control.Compact}" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Cursor" Value="SizeWE" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="SelectionBrush" Value="{StaticResource Brush.PanelBorderStrong}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Box" Background="{StaticResource Brush.Panel}" BorderBrush="{StaticResource Brush.PanelBorderStrong}" BorderThickness="1"
                                CornerRadius="{StaticResource Radius.Xs}" SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Brush.TextPrimary}" />
                                <Setter Property="Cursor" Value="IBeam" />
                            </Trigger>
                            <Trigger Property="Validation.HasError" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Brush.Danger}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Trace.Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource Size.Text.Body}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <!-- Flat rectangular option button: outline when off, soft grey fill and a graphite outline when on. No pill, no tint fill. -->
        <Style x:Key="Trace.OptionToggle" TargetType="ToggleButton">
            <Setter Property="Height" Value="{StaticResource Size.Control.Compact}" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="FontSize" Value="{StaticResource Size.Text.Body}" />
            <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Box" Background="Transparent" BorderBrush="{StaticResource Brush.PanelBorderStrong}"
                                BorderThickness="1" CornerRadius="{StaticResource Radius.Xs}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource Brush.HoverWash}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource Brush.PanelRaised}" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Brush.TextPrimary}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Brush.Signal}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource Brush.Background}" BorderBrush="{StaticResource Brush.PanelBorderStrong}" BorderThickness="1">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="44" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <components:WindowTitleBar Title="Trasovat obrázek" IconData="{StaticResource Glyph.Vector}"
                                    CloseButtonName="Zavřít trasování obrázku" />

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Preview: the traced vector over the source image. Wheel zooms, middle button pans, double click fits. -->
            <Border Margin="20,20,20,12" Background="{StaticResource Brush.Field}" BorderBrush="{StaticResource Brush.PanelBorder}"
                    BorderThickness="1" CornerRadius="{StaticResource Radius.Md}" Padding="20">
                <Grid x:Name="PreviewViewport" ClipToBounds="True" Background="Transparent"
                      MouseWheel="OnPreviewMouseWheel"
                      MouseDown="OnPreviewMouseDown"
                      MouseMove="OnPreviewMouseMove"
                      MouseUp="OnPreviewMouseUp">
                    <!-- Layout is in millimetres here: rounding it to whole device pixels (the app-wide default) would resize
                         the picture by up to half a millimetre while the traced path keeps its exact size. -->
                    <Viewbox x:Name="PreviewViewbox" Stretch="Uniform" SizeChanged="OnPreviewViewboxSizeChanged"
                             UseLayoutRounding="False" SnapsToDevicePixels="False"
                             RenderTransformOrigin="0,0">
                        <Grid Width="{Binding PreviewWidthMm, Mode=OneTime}" Height="{Binding PreviewHeightMm, Mode=OneTime}" Background="White">
                            <Image x:Name="SourcePreviewImage" Source="{Binding SourceImage}" Stretch="Fill"
                                   Opacity="{Binding SourceImageOpacity}" RenderOptions.BitmapScalingMode="HighQuality" />
                            <Grid IsHitTestVisible="False" Opacity="{Binding TraceOpacity}"
                                  Visibility="{Binding ShowTrace, Converter={StaticResource BoolToVisibility}}">
                                <Path x:Name="TracePreviewPath" Data="{Binding PreviewGeometry}" Stroke="{StaticResource Brush.Accent}"
                                      StrokeThickness="0.12" Fill="Transparent" StrokeLineJoin="Round" />
                                <Path x:Name="PointsPreviewPath" Data="{Binding PointsGeometry}" Stroke="{StaticResource Brush.TextPrimary}"
                                      StrokeThickness="0.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Visibility="{Binding ShowPoints, Converter={StaticResource BoolToVisibility}}" />
                            </Grid>
                        </Grid>
                    </Viewbox>
                    <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Background="{StaticResource Brush.Panel}"
                            BorderBrush="{StaticResource Brush.PanelBorder}" BorderThickness="1" CornerRadius="{StaticResource Radius.Md}"
                            Padding="12,6" Panel.ZIndex="1">
                        <TextBlock Text="{Binding StatusMessage}" FontSize="{StaticResource Size.Text.Meta}"
                                   Foreground="{StaticResource Brush.TextSecondary}" TextWrapping="Wrap" MaxWidth="560" />
                    </Border>
                    <Border HorizontalAlignment="Center" VerticalAlignment="Center" Background="{StaticResource Brush.Panel}" BorderBrush="{StaticResource Brush.PanelBorder}"
                            BorderThickness="1" CornerRadius="{StaticResource Radius.Md}" Padding="12,8"
                            Visibility="{Binding ShowBusyOverlay, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <ProgressBar Width="72" Height="4" IsIndeterminate="True" Margin="0,0,12,0" />
                            <TextBlock Text="Počítám obrysy…" VerticalAlignment="Center" FontSize="{StaticResource Size.Text.Meta}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Controls strip under the preview in the shared dialog footer: three rows of settings on the left, Zrušit and OK at the right. -->
            <components:DialogFooter Grid.Row="1">
                <StackPanel components:DialogFooter.IsLeading="True">
                        <!-- Row 1: Odříznout and Prahová hodnota, each number + slider. -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="32" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" MinWidth="88" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Odříznout" Style="{StaticResource Trace.Label}" input:NumericScrub.Target="{Binding ElementName=CutoffBox}" Background="Transparent" Margin="0,0,12,0" />
                                <TextBox x:Name="CutoffBox" Grid.Column="1" Style="{StaticResource Trace.Number}" input:NumericScrub.Step="1" input:NumericScrub.Minimum="0" input:NumericScrub.Maximum="255" Width="72"
                                         AutomationProperties.Name="Odříznout"
                                         ToolTip="Pixely světlejší než tato hodnota se ignorují. Nula odříznutí vypíná."
                                         Text="{Binding Cutoff, Mode=TwoWay, Converter={StaticResource DecimalText}, ConverterParameter=0, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}" />
                                <Slider Grid.Column="2" Minimum="0" Maximum="255" TickFrequency="1" IsSnapToTickEnabled="True"
                                        IsMoveToPointEnabled="True" VerticalAlignment="Center" Margin="12,0,0,0"
                                        AutomationProperties.Name="Odříznout"
                                        Value="{Binding Cutoff, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                            <Grid Grid.Column="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" MinWidth="120" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Prahová hodnota" Style="{StaticResource Trace.Label}" input:NumericScrub.Target="{Binding ElementName=ThresholdBox}" Background="Transparent" Margin="0,0,12,0" />
                                <TextBox x:Name="ThresholdBox" Grid.Column="1" Style="{StaticResource Trace.Number}" input:NumericScrub.Step="1" input:NumericScrub.Minimum="0" input:NumericScrub.Maximum="255" Width="72"
                                         AutomationProperties.Name="Prahová hodnota"
                                         ToolTip="Jas, při kterém se odděluje tmavá kresba od světlého pozadí."
                                         Text="{Binding Threshold, Mode=TwoWay, Converter={StaticResource DecimalText}, ConverterParameter=0, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}" />
                                <Slider Grid.Column="2" Minimum="0" Maximum="255" TickFrequency="1" IsSnapToTickEnabled="True"
                                        IsMoveToPointEnabled="True" VerticalAlignment="Center" Margin="12,0,0,0"
                                        AutomationProperties.Name="Prahová hodnota"
                                        Value="{Binding Threshold, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                        </Grid>

                        <!-- Row 2: Ignorovat, Vyhlazení, Optimalizovat; Průhlednost stopy with its switch. -->
                        <Grid Margin="0,0,0,8">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Ignorovat méně než" Style="{StaticResource Trace.Label}" input:NumericScrub.Target="{Binding ElementName=IgnoreBox}" Background="Transparent" Margin="0,0,8,0" />
                                <TextBox x:Name="IgnoreBox" Style="{StaticResource Trace.Number}" input:NumericScrub.Step="1" input:NumericScrub.Minimum="0" Width="64" Margin="0,0,20,0"
                                         AutomationProperties.Name="Ignorovat méně než"
                                         ToolTip="Tvary menší než tato plocha v pixelech se vynechají."
                                         Text="{Binding IgnoreLessThan, Mode=TwoWay, Converter={StaticResource DecimalText}, ConverterParameter=0.##, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}" />
                                <TextBlock Text="Vyhlazení" Style="{StaticResource Trace.Label}" input:NumericScrub.Target="{Binding ElementName=SmoothBox}" Background="Transparent" Margin="0,0,8,0" />
                                <TextBox x:Name="SmoothBox" Style="{StaticResource Trace.Number}" input:NumericScrub.Step="0.05" input:NumericScrub.Minimum="0" Width="72" Margin="0,0,20,0"
                                         AutomationProperties.Name="Vyhlazení"
                                         ToolTip="Síla vyhlazení obrysu. Ostré rohy zůstávají ostré."
                                         Text="{Binding Smoothness, Mode=TwoWay, Converter={StaticResource DecimalText}, ConverterParameter=0.000, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}" />
                                <TextBlock Text="Optimalizovat" Style="{StaticResource Trace.Label}" input:NumericScrub.Target="{Binding ElementName=OptimizeBox}" Background="Transparent" Margin="0,0,8,0" />
                                <TextBox x:Name="OptimizeBox" Style="{StaticResource Trace.Number}" input:NumericScrub.Step="0.05" input:NumericScrub.Minimum="0" Width="64"
                                         AutomationProperties.Name="Optimalizovat"
                                         ToolTip="Vyšší hodnota slučuje křivky a snižuje počet uzlů."
                                         Text="{Binding Optimize, Mode=TwoWay, Converter={StaticResource DecimalText}, ConverterParameter=0.0##, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,8,0,0">
                                <TextBlock Text="Průhlednost stopy" Style="{StaticResource Trace.Label}" Margin="0,0,8,0" />
                                <Slider Width="120" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True"
                                        IsMoveToPointEnabled="True" VerticalAlignment="Center" Margin="0,0,12,0"
                                        AutomationProperties.Name="Průhlednost stopy"
                                        Value="{Binding TraceOpacityPercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <CheckBox Style="{StaticResource Toggle.Switch}"
                                          AutomationProperties.Name="Zobrazit stopu"
                                          ToolTip="Zobrazí nebo skryje trasovaný vektor v náhledu."
                                          IsChecked="{Binding ShowTrace, Mode=TwoWay}" />
                            </StackPanel>
                        </Grid>

                        <!-- Row 3: flat option buttons and the delete-image switch. -->
                        <WrapPanel Orientation="Horizontal">
                            <ToggleButton Style="{StaticResource Trace.OptionToggle}" IsChecked="{Binding FadeImage, Mode=TwoWay}"
                                          ToolTip="Zesvětlí zdrojový obrázek, aby byl vektor lépe vidět."
                                          AutomationProperties.Name="Vyblednout obrázek" Content="Vyblednout obrázek" />
                            <ToggleButton Style="{StaticResource Trace.OptionToggle}" IsChecked="{Binding ShowPoints, Mode=TwoWay}"
                                          ToolTip="Zobrazí uzly trasované křivky."
                                          AutomationProperties.Name="Zobrazit body" Content="Zobrazit body" />
                            <ToggleButton Style="{StaticResource Trace.OptionToggle}" IsChecked="{Binding DeleteBoundary, Mode=TwoWay}"
                                          ToolTip="Vynechá obrys, který vede po okraji obrázku."
                                          AutomationProperties.Name="Vymazat ohraničení" Content="Vymazat ohraničení" />
                            <StackPanel Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                                <CheckBox Style="{StaticResource Toggle.Switch}" Margin="0,0,10,0"
                                          AutomationProperties.Name="Odstranit obrázek po trasování"
                                          IsChecked="{Binding DeleteImageAfterTracing, Mode=TwoWay}" />
                                <TextBlock Text="Odstranit obrázek po trasování" Style="{StaticResource Trace.Label}" />
                            </StackPanel>
                        </WrapPanel>
                </StackPanel>
                <Button IsCancel="True" Style="{StaticResource Button.Outline}" Click="OnCancelClick"
                        Height="{StaticResource Size.Control.Primary}" MinWidth="96" Content="Zrušit" />
                <Button IsDefault="True" Style="{StaticResource Button.Primary}" Click="OnApplyClick"
                        IsEnabled="{Binding HasResult}" Height="{StaticResource Size.Control.Primary}" MinWidth="96"
                        Content="OK" AutomationProperties.Name="OK" />
            </components:DialogFooter>
        </Grid>
    </Grid>
    </Border>
</Window>
