<Window x:Class="Lasero.App.BitmapTraceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:components="clr-namespace:Lasero.App.Components"
        xmlns:trace="clr-namespace:Lasero.Core.Trace;assembly=Lasero.Core"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Trasovat bitmapu" Width="1080" Height="720" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" WindowStyle="None"
        Background="{StaticResource Brush.Background}" Foreground="{StaticResource Brush.TextPrimary}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>

    <Border Background="{StaticResource Brush.Background}" BorderBrush="{StaticResource Brush.PanelBorderStrong}" BorderThickness="1">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="44" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <components:WindowTitleBar Title="Trasovat bitmapu" IconData="{StaticResource Glyph.Vector}"
                                    CloseButtonName="Zavřít trasování bitmapy" />
    <Grid Grid.Row="1">
        <Grid.RowDefinitions>
            <RowDefinition Height="72" />
            <RowDefinition Height="*" />
            <RowDefinition Height="64" />
        </Grid.RowDefinitions>

        <Border Background="{StaticResource Brush.Panel}" BorderBrush="{StaticResource Brush.PanelBorder}" BorderThickness="0,0,0,1" Padding="24,0">
            <Grid>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Trasovat bitmapu" FontFamily="{StaticResource Font.Display}" FontSize="{StaticResource Size.Text.Title}" FontWeight="SemiBold" />
                    <TextBlock Text="Zvolte typ obrázku, upravte rozpoznání a zkontrolujte výsledné křivky." Style="{StaticResource Text.Muted}" Margin="0,4,0,0" />
                </StackPanel>
                <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="{StaticResource Brush.InfoMuted}" CornerRadius="{StaticResource Radius.Md}" Padding="10,6">
                    <TextBlock Text="{Binding ResultSummary}" Foreground="{StaticResource Brush.AccentText}" FontWeight="SemiBold" FontSize="{StaticResource Size.Text.Meta}" />
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>

            <Border Margin="20" Background="{StaticResource Brush.Field}" BorderBrush="{StaticResource Brush.PanelBorder}" BorderThickness="1" CornerRadius="{StaticResource Radius.Md}" Padding="20">
                <Grid x:Name="PreviewViewport" ClipToBounds="True" Background="Transparent"
                      MouseWheel="OnPreviewMouseWheel"
                      MouseDown="OnPreviewMouseDown"
                      MouseMove="OnPreviewMouseMove"
                      MouseUp="OnPreviewMouseUp">
                    <Viewbox x:Name="PreviewViewbox" Stretch="Uniform" SizeChanged="OnPreviewViewboxSizeChanged"
                             RenderTransformOrigin="0,0">
                        <Grid Width="{Binding PreviewWidthMm, Mode=OneTime}" Height="{Binding PreviewHeightMm, Mode=OneTime}" Background="White">
                            <Image x:Name="SourcePreviewImage" Source="{Binding SourceImage}" Stretch="Fill" Opacity="0.45" RenderOptions.BitmapScalingMode="HighQuality" />
                            <Path x:Name="TracePreviewPath" Data="{Binding PreviewGeometry}" Stroke="{StaticResource Brush.Accent}" StrokeThickness="0.12" Fill="Transparent" />
                            <ItemsControl x:Name="ColoredTracePaths" ItemsSource="{Binding ColoredPreviewPaths}"
                                          Visibility="Collapsed" IsHitTestVisible="False"
                                          Width="{Binding PreviewWidthMm, Mode=OneTime}" Height="{Binding PreviewHeightMm, Mode=OneTime}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><Canvas /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Path Data="{Binding Geometry}" Fill="{Binding Stroke}" Stroke="{Binding Stroke}"
                                              Width="{Binding DataContext.PreviewWidthMm, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                              Height="{Binding DataContext.PreviewHeightMm, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                              StrokeThickness="{Binding DataContext.PreviewStrokeThicknessMm, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Viewbox>
                    <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8" Background="{StaticResource Brush.Panel}"
                            BorderBrush="{StaticResource Brush.PanelBorder}" BorderThickness="1" CornerRadius="{StaticResource Radius.Md}"
                            Padding="4" Panel.ZIndex="1">
                        <ComboBox x:Name="PreviewDisplayMode" Width="132" SelectedIndex="1"
                                  SelectionChanged="OnPreviewDisplayModeChanged" ToolTip="Zobrazení náhledu">
                            <ComboBoxItem Content="Originál" />
                            <ComboBoxItem Content="Překrytí" />
                            <ComboBoxItem Content="Jen vektor" />
                        </ComboBox>
                    </Border>
                    <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8" Background="{StaticResource Brush.Panel}"
                            BorderBrush="{StaticResource Brush.PanelBorder}" BorderThickness="1" CornerRadius="{StaticResource Radius.Md}"
                            Padding="4" Panel.ZIndex="1">
                        <StackPanel Orientation="Horizontal">
                            <Button Click="OnZoomOutClick" ToolTip="Oddálit" Padding="9,4" MinWidth="32">−</Button>
                            <TextBlock x:Name="ZoomLevelText" Text="100 %" VerticalAlignment="Center" MinWidth="54" TextAlignment="Center"
                                       FontFamily="{StaticResource Font.Numeric}" FontSize="{StaticResource Size.Text.Meta}" />
                            <Button Click="OnZoomInClick" ToolTip="Přiblížit" Padding="9,4" MinWidth="32">+</Button>
                            <Button Click="OnFitPreviewClick" Margin="4,0,0,0" Padding="9,4">Přizpůsobit</Button>
                        </StackPanel>
                    </Border>
                    <Border HorizontalAlignment="Center" VerticalAlignment="Center" Background="{StaticResource Brush.Panel}" BorderBrush="{StaticResource Brush.PanelBorder}"
                            BorderThickness="1" CornerRadius="{StaticResource Radius.Md}" Padding="12,8"
                            Visibility="{Binding IsComputing, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <ProgressBar Width="72" Height="4" IsIndeterminate="True" Margin="0,0,10,0" />
                            <TextBlock Text="Počítám obrysy…" VerticalAlignment="Center" FontSize="{StaticResource Size.Text.Meta}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="1" Background="{StaticResource Brush.Panel}" BorderBrush="{StaticResource Brush.PanelBorder}" BorderThickness="1,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18,20">
                    <StackPanel>
                        <TextBlock Text="Zdroj" Style="{StaticResource PanelTitle}" />
                        <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Margin="0,4,0,18" Foreground="{StaticResource Brush.TextSecondary}">
                            <Run Text="Výsledný rozměr: " /><Run Text="{Binding PreviewWidthMm, Mode=OneTime, StringFormat={}{0:0.##}}" /><Run Text=" × " />
                            <Run Text="{Binding PreviewHeightMm, Mode=OneTime, StringFormat={}{0:0.##}}" /><Run Text=" mm" />
                        </TextBlock>

                        <Border Style="{StaticResource InspectorSection}">
                            <StackPanel>
                                <TextBlock Text="Typ trasování" Style="{StaticResource PanelTitle}" />
                                <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding Mode, Mode=TwoWay}" Margin="0,0,0,5">
                                    <ComboBoxItem Content="Logo a černobílá grafika" Tag="{x:Static trace:TraceMode.FilledShapes}" />
                                    <ComboBoxItem Content="Fotografie a linkové obrysy" Tag="{x:Static trace:TraceMode.Outline}" />
                                    <ComboBoxItem Content="Barevné logo a ilustrace" Tag="{x:Static trace:TraceMode.Color}" />
                                </ComboBox>
                                <TextBlock Text="{Binding ModeDescription}" Style="{StaticResource Text.Muted}"
                                           TextWrapping="Wrap" Margin="0,0,0,15" />

                                <StackPanel Visibility="{Binding IsOutlineMode, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="Kvalita zpracování" Style="{StaticResource Text.Muted}" Margin="0,0,0,5" />
                                    <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding Quality, Mode=TwoWay}" Margin="0,0,0,14">
                                        <ComboBoxItem Content="Rychlá" Tag="{x:Static trace:TraceQuality.Fast}" />
                                        <ComboBoxItem Content="Vyvážená" Tag="{x:Static trace:TraceQuality.Balanced}" />
                                        <ComboBoxItem Content="Vysoká přesnost" Tag="{x:Static trace:TraceQuality.HighFidelity}" />
                                    </ComboBox>
                                </StackPanel>

                                <TextBlock Text="Barevné plochy se převedou na samostatné vektorové vrstvy."
                                           Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,0,0,5"
                                           Visibility="{Binding IsColorMode, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Text="Rozpoznání obrysu" Style="{StaticResource PanelTitle}" />
                                <StackPanel Visibility="{Binding IsFilledMode, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="Metoda určení prahu" Style="{StaticResource Text.Muted}" Margin="0,0,0,5" />
                                    <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding ThresholdMode, Mode=TwoWay}" Margin="0,0,0,12">
                                        <ComboBoxItem Content="Ruční" Tag="{x:Static trace:ThresholdMode.Manual}" />
                                        <ComboBoxItem Content="Automatická (Otsu)" Tag="{x:Static trace:ThresholdMode.Auto}" />
                                        <ComboBoxItem Content="Adaptivní (nerovnoměrné světlo)" Tag="{x:Static trace:ThresholdMode.Adaptive}" />
                                    </ComboBox>
                                    <StackPanel Visibility="{Binding IsManualThreshold, Converter={StaticResource BoolToVisibility}}">
                                        <DockPanel Margin="0,0,0,4">
                                            <TextBlock Text="Práh černé" Style="{StaticResource Text.Muted}" />
                                            <TextBlock Text="{Binding Threshold, StringFormat={}{0:0}}" HorizontalAlignment="Right" FontFamily="{StaticResource Font.Numeric}" />
                                        </DockPanel>
                                        <Slider Minimum="0" Maximum="255" Value="{Binding Threshold}" />
                                        <TextBlock Text="Vyšší hodnota zachytí i světlejší části obrázku." Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,5,0,12" />
                                    </StackPanel>
                                    <CheckBox Content="Invertovat světlé a tmavé plochy" IsChecked="{Binding Invert}" Margin="0,0,0,12" />
                                </StackPanel>

                                <DockPanel Margin="0,0,0,4">
                                    <TextBlock Text="Vyhlazení křivek" Style="{StaticResource Text.Muted}" />
                                    <TextBlock Text="{Binding SimplificationPixels, StringFormat={}{0:0.0} px}" HorizontalAlignment="Right" FontFamily="{StaticResource Font.Numeric}" />
                                </DockPanel>
                                <Slider Minimum="0" Maximum="5" TickFrequency="0.1" Value="{Binding SimplificationPixels}" />
                                <TextBlock Text="Vyšší hodnota používá méně uzlů; drobné tvary se mohou zjednodušit." Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,5,0,14" />

                                <DockPanel Margin="0,0,0,4">
                                    <TextBlock Text="Zachovat ostré rohy" Style="{StaticResource Text.Muted}" />
                                    <TextBlock Text="{Binding Detail, StringFormat={}{0:P0}}" HorizontalAlignment="Right" FontFamily="{StaticResource Font.Numeric}" />
                                </DockPanel>
                                <Slider Minimum="0" Maximum="1" TickFrequency="0.05" Value="{Binding Detail}" Margin="0,0,0,14" />

                                <DockPanel Margin="0,0,0,4">
                                    <TextBlock Text="Odstranit šum" Style="{StaticResource Text.Muted}" />
                                    <TextBlock Text="{Binding NoiseRemoval, StringFormat={}{0:P0}}" HorizontalAlignment="Right" FontFamily="{StaticResource Font.Numeric}" />
                                </DockPanel>
                                <Slider Minimum="0" Maximum="1" TickFrequency="0.05" Value="{Binding NoiseRemoval}" Margin="0,0,0,14" />

                                <StackPanel Visibility="{Binding IsOutlineMode, Converter={StaticResource BoolToVisibility}}">
                                    <DockPanel Margin="0,0,0,4">
                                        <TextBlock Text="Kontrast" Style="{StaticResource Text.Muted}" />
                                        <TextBlock Text="{Binding Contrast, StringFormat={}{0:+0.0;-0.0;0.0}}" HorizontalAlignment="Right" FontFamily="{StaticResource Font.Numeric}" />
                                    </DockPanel>
                                    <Slider Minimum="-1" Maximum="1" TickFrequency="0.1" Value="{Binding Contrast}" Margin="0,0,0,14" />
                                </StackPanel>

                                <TextBlock Text="Ignorovat plochy menší než (px²)" Style="{StaticResource Text.Muted}" />
                                <TextBox Text="{Binding MinimumFeaturePixels, UpdateSourceTrigger=LostFocus}" Margin="0,5,0,12" />
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource Brush.InfoMuted}" BorderBrush="{StaticResource Brush.InfoBorder}" BorderThickness="1" CornerRadius="{StaticResource Radius.Md}" Padding="12">
                            <!-- DockPanel, not a horizontal StackPanel: a StackPanel measures its children with
                             infinite width, so TextWrapping never engages and the sentence is cut off at
                             the panel edge. -->
<DockPanel>
                                <components:IconGlyph DockPanel.Dock="Left" VerticalAlignment="Top" IconData="{StaticResource Glyph.Info}" Width="{StaticResource Size.Icon.Sm}" Height="{StaticResource Size.Icon.Sm}" Foreground="{StaticResource Brush.AccentText}" Margin="0,1,9,0" />
                                <TextBlock Text="Bitmapa bude nahrazena jedním seskupeným vektorovým objektem. Původní stav lze obnovit pomocí Ctrl+Z."
                                           TextWrapping="Wrap" Foreground="{StaticResource Brush.TextSecondary}" FontSize="{StaticResource Size.Text.Meta}" />
                            </DockPanel>
                        </Border>

                        <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="2,12,2,0" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource Brush.Panel}" BorderBrush="{StaticResource Brush.PanelBorder}" BorderThickness="0,1,0,0" Padding="20,12">
            <Grid>
                <TextBlock Text="Kolečko: přiblížení · prostřední tlačítko: posun · Překrytí: porovnání s originálem" Style="{StaticResource Text.Muted}" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Click="OnCancelClick" Padding="16,0" Margin="0,0,8,0">Zrušit</Button>
                    <Button IsDefault="True" Style="{StaticResource PrimaryBlue}" Click="OnApplyClick" IsEnabled="{Binding HasResult}" Padding="18,0">
                        <components:IconLabel IconData="{StaticResource Glyph.Vector}" Text="Nahradit vektorem" Foreground="White" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
    </Grid>
    </Border>
</Window>
