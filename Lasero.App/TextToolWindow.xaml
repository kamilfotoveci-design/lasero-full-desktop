<Window x:Class="Lasero.App.TextToolWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:components="clr-namespace:Lasero.App.Components"
        Title="Přidat text" Width="500" Height="390"
        MinWidth="500" MinHeight="390" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Brush.Background}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="76" />
            <RowDefinition Height="*" />
            <RowDefinition Height="68" />
        </Grid.RowDefinitions>

        <Border Background="{StaticResource Brush.Panel}"
                BorderBrush="{StaticResource Brush.PanelBorder}" BorderThickness="0,0,0,1"
                Padding="26,0">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Přidat text do návrhu"
                           FontFamily="{StaticResource Font.Display}" FontSize="{StaticResource Size.Text.Title}" FontWeight="SemiBold" />
                <TextBlock Text="Text zůstane jako jeden objekt a můžete ho na plátně dál upravovat."
                           Style="{StaticResource Text.Muted}" Margin="0,5,0,0" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="1" Margin="26,24">
            <TextBlock Text="Text" FontWeight="SemiBold" Margin="0,0,0,6" />
            <TextBox x:Name="TextValueInput" Height="{StaticResource Size.Control.Base}" MaxLength="200"
                     AutomationProperties.Name="Text pro vložení" />

            <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Výška textu" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <Grid>
                        <TextBox x:Name="HeightInput" Text="12" Height="{StaticResource Size.Control.Base}" Padding="10,6,42,6"
                                 AutomationProperties.Name="Výška textu v milimetrech" />
                        <TextBlock Text="mm" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Margin="0,0,12,0" Foreground="{StaticResource Brush.TextSecondary}"
                                   IsHitTestVisible="False" />
                    </Grid>
                </StackPanel>
                <Border Grid.Column="2" Background="{StaticResource Brush.InfoMuted}"
                        BorderBrush="{StaticResource Brush.InfoBorder}" BorderThickness="1"
                        CornerRadius="{StaticResource Radius.Md}" Padding="12" VerticalAlignment="Bottom" MinHeight="{StaticResource Size.Control.Base}">
                    <StackPanel Orientation="Horizontal">
                        <components:IconGlyph IconData="{StaticResource Glyph.Info}" Width="{StaticResource Size.Icon.Sm}" Height="{StaticResource Size.Icon.Sm}"
                                              Margin="0,0,8,0" Foreground="{StaticResource Brush.Info}" />
                        <TextBlock Text="Rozměr je v milimetrech." Style="{StaticResource Text.Muted}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>

            <TextBlock x:Name="ErrorText" Foreground="{StaticResource Brush.Danger}"
                       TextWrapping="Wrap" Margin="2,12,0,0" Visibility="Collapsed"
                       AutomationProperties.LiveSetting="Assertive" />
        </StackPanel>

        <Border Grid.Row="2" Background="{StaticResource Brush.TitleBar}"
                BorderBrush="{StaticResource Brush.PanelBorder}" BorderThickness="0,1,0,0"
                Padding="26,13">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Zrušit" IsCancel="True" MinWidth="96" Height="{StaticResource Size.Control.Base}" Margin="0,0,8,0" />
                <Button Content="Přidat text" Style="{StaticResource PrimaryBlue}"
                        MinWidth="132" Height="{StaticResource Size.Control.Base}" Click="OnAddClick" IsDefault="True" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
