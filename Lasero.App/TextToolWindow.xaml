<Window x:Class="Lasero.App.TextToolWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:components="clr-namespace:Lasero.App.Components"
        Title="Přidat text" Width="560" Height="566"
        MinWidth="560" MinHeight="566" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Brush.Background}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="76" />
            <RowDefinition Height="*" />
            <RowDefinition Height="68" />
        </Grid.RowDefinitions>

        <Border Background="{StaticResource Brush.Panel}"
                BorderBrush="{StaticResource Brush.PanelBorder}" BorderThickness="0,0,0,1"
                Padding="26,0">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Přidat text do návrhu"
                           FontFamily="{StaticResource Font.Display}" FontSize="{StaticResource Size.Text.Title}" FontWeight="SemiBold" />
                <TextBlock Text="Text zůstane jako jeden objekt a můžete ho na plátně dál upravovat."
                           Style="{StaticResource Text.Muted}" Margin="0,5,0,0" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="1" Margin="26,22">
            <TextBlock Text="Text" FontWeight="SemiBold" Margin="0,0,0,6" />
            <TextBox x:Name="TextValueInput" Height="{StaticResource Size.Control.Base}" MaxLength="200"
                     TextChanged="OnPreviewInputChanged"
                     AutomationProperties.Name="Text pro vložení" />

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="132" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Písmo" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <!-- Each family renders in itself, so the list is browsable by eye rather than by
                         recognising names. -->
                    <ComboBox x:Name="FontFamilyInput"
                              ItemsSource="{Binding FontFamilies}"
                              SelectionChanged="OnPreviewInputChanged"
                              MaxDropDownHeight="280"
                              AutomationProperties.Name="Písmo">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontFamily="{Binding}" FontSize="{StaticResource Size.Text.Section}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Řez" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <StackPanel Orientation="Horizontal">
                        <ToggleButton x:Name="BoldToggle" Style="{StaticResource Toggle.Icon}"
                                      Click="OnPreviewInputChanged"
                                      ToolTip="Tučné" AutomationProperties.Name="Tučné písmo">
                            <TextBlock Text="B" FontWeight="Bold" FontSize="{StaticResource Size.Text.Section}" />
                        </ToggleButton>
                        <ToggleButton x:Name="ItalicToggle" Style="{StaticResource Toggle.Icon}"
                                      Click="OnPreviewInputChanged" Margin="6,0,0,0"
                                      ToolTip="Kurzíva" AutomationProperties.Name="Kurzíva">
                            <TextBlock Text="I" FontStyle="Italic" FontSize="{StaticResource Size.Text.Section}" FontFamily="Georgia, Times New Roman" />
                        </ToggleButton>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="4">
                    <TextBlock Text="Výška" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <!-- UnitField, not a TextBox with room padded out on the right for an overlaid
                         label. That hand-rolled version set Padding="10,6,42,6" inside a 36px control,
                         which left 24px for a line that needs more, so the field cut its own value in
                         half and the height could not be read. -->
                    <Border Style="{StaticResource UnitField.Shell}"
                            ToolTip="Výška písma v milimetrech">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="mm" Style="{StaticResource UnitField.Suffix}" />
                            <TextBox x:Name="HeightInput" Text="12" Style="{StaticResource UnitField.Input}"
                                     AutomationProperties.Name="Výška textu v milimetrech" />
                        </DockPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Set as capitals and weld. Both change the outlines rather than the wording, so they
                 belong with the type settings and not with the text field. Weld matters most on script
                 and display faces, where the letters overlap by design and the laser would otherwise
                 trace every buried edge inside the overlap. -->
            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                <CheckBox x:Name="UppercaseToggle" Content="Velká písmena"
                          Click="OnPreviewInputChanged"
                          ToolTip="Vysadí text kapitálkami, napsané znění zůstane zachované"
                          AutomationProperties.Name="Velká písmena" />
                <CheckBox x:Name="WeldToggle" Content="Svařeno" Margin="22,0,0,0"
                          ToolTip="Spojí přesahující obrysy písmen do jednoho obrysu, aby laser nevypálil šev uvnitř přesahu"
                          AutomationProperties.Name="Svařit obrysy písmen" />
            </StackPanel>

            <TextBlock Text="Náhled" FontWeight="SemiBold" Margin="0,16,0,6" />
            <Border Background="{StaticResource Brush.Panel}" BorderBrush="{StaticResource Brush.PanelBorder}"
                    BorderThickness="1" CornerRadius="{StaticResource Radius.Md}" Height="72" Padding="14,0">
                <TextBlock x:Name="PreviewText" Text="Náhled písma" FontSize="{StaticResource Size.Text.Preview}"
                           VerticalAlignment="Center" HorizontalAlignment="Left"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{StaticResource Brush.TextPrimary}" />
            </Border>

            <TextBlock x:Name="ErrorText" Foreground="{StaticResource Brush.Danger}"
                       TextWrapping="Wrap" Margin="2,10,0,0" Visibility="Collapsed"
                       AutomationProperties.LiveSetting="Assertive" />
        </StackPanel>

        <Border Grid.Row="2" Background="{StaticResource Brush.TitleBar}"
                BorderBrush="{StaticResource Brush.PanelBorder}" BorderThickness="0,1,0,0"
                Padding="26,13">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Zrušit" IsCancel="True" MinWidth="96" Height="{StaticResource Size.Control.Base}" Margin="0,0,8,0" />
                <Button Content="Přidat text" Style="{StaticResource PrimaryBlue}"
                        MinWidth="132" Height="{StaticResource Size.Control.Base}" Click="OnAddClick" IsDefault="True" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
