<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Lasero.Core\Lasero.Core.csproj" />
    <ProjectReference Include="..\Lasero.Persistence\Lasero.Persistence.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\Lasero.ico" />
    <Resource Include="Assets\Lasero.png" />
    <Resource Include="Assets\LaseroWordmark.png" />
    <Resource Include="Assets\LaseroWordmarkLight.png" />
    <Resource Include="Assets\KamilAvatar.png" />
    <!-- Inter ships with the app rather than being assumed present on the machine: it is not a
         Windows font, so referencing it by family name alone would silently fall back to Segoe on
         every customer install. SIL Open Font License 1.1 — see Assets\Fonts\Inter-LICENSE.txt. -->
    <Resource Include="Assets\Fonts\Inter-Regular.ttf" />
    <Resource Include="Assets\Fonts\Inter-Medium.ttf" />
    <Resource Include="Assets\Fonts\Inter-SemiBold.ttf" />
    <Resource Include="Assets\Fonts\Inter-Bold.ttf" />
    <None Include="Assets\Fonts\Inter-LICENSE.txt"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.10" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\THIRD_PARTY_NOTICES.md"
          Link="THIRD_PARTY_NOTICES.md"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Matches Lasero.Core.csproj's PlatformTarget — needed for Microsoft.AI.DirectML's own
         .targets file to actually copy DirectML.dll into this project's output directory (see the
         comment there); with the implicit AnyCPU default that copy is silently skipped. -->
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationIcon>Assets\Lasero.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>Lasero.App</AssemblyName>
    <RootNamespace>Lasero.App</RootNamespace>
    <Product>Lasero Desktop</Product>
    <Company>Lasero</Company>
    <Authors>Lasero</Authors>
    <Description>Návrh, příprava a bezpečné ovládání laserové gravírky.</Description>
    <Version>0.1.0</Version>
    <NeutralLanguage>cs-CZ</NeutralLanguage>
  </PropertyGroup>

</Project>
