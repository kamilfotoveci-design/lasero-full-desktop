<Window x:Class="Lasero.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Lasero.App.Controls"
        xmlns:components="clr-namespace:Lasero.App.Components"
        xmlns:conv="clr-namespace:Lasero.App.Converters"
        xmlns:views="clr-namespace:Lasero.App.Views"
        xmlns:kamil="clr-namespace:Lasero.App.Views.Kamil"
        xmlns:devicesetup="clr-namespace:Lasero.App.Views.DeviceSetup"
        xmlns:tour="clr-namespace:Lasero.App.Tour"
        xmlns:vm="clr-namespace:Lasero.App.ViewModels"
        xmlns:jobs="clr-namespace:Lasero.Core.Jobs;assembly=Lasero.Core"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Lasero Desktop" Height="900" Width="1480" MinWidth="1080" MinHeight="640"
        WindowStartupLocation="CenterScreen" WindowStyle="None" Background="{StaticResource Brush.Background}" Foreground="{StaticResource Brush.TextPrimary}">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="60" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <conv:EnumEqualsVisibilityConverter x:Key="EnumEqualsVisibility" />
        <conv:AssistantClearanceConverter x:Key="AssistantClearance" />
        <conv:EnumToBooleanConverter x:Key="EnumToBoolean" />
        <conv:BooleanToConnectionBrushConverter x:Key="ConnectedToBrush" />
        <conv:JobRunStateToLabelConverter x:Key="JobStateToLabel" />
        <conv:JobRunStateToStatePillKindConverter x:Key="JobStateToPillKind" />
        <conv:NotNullToVisibilityConverter x:Key="NotNullToVisibility" />
        <conv:RgbColorToBrushConverter x:Key="RgbColorToBrush" />
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
        <conv:RgbColorToNameConverter x:Key="RgbColorToName" />
        <conv:RgbColorMatchesConverter x:Key="RgbColorMatches" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <!--
            The project button in the title bar: project name, unsaved dot and chevron are ONE
            hit target, so the whole group answers the pointer like any other secondary text button
            (HoverWash 6 percent, pressed 8, keyboard ring, Radius.Sm). The chevron is only the
            affordance; it used to be the only clickable part. The open state keeps the pressed wash.
        -->
        <Style x:Key="ProjectNameButton" TargetType="ToggleButton">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Cursor" Value="Arrow" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Background="Transparent" SnapsToDevicePixels="True">
                            <Border x:Name="Surface" Background="Transparent"
                                    BorderBrush="Transparent" BorderThickness="1"
                                    CornerRadius="{StaticResource Radius.Sm}" />
                            <Border x:Name="Hover" Background="{StaticResource Brush.HoverWash}" Opacity="0"
                                    IsHitTestVisible="False" CornerRadius="{StaticResource Radius.Sm}" />
                            <Border x:Name="Press" Background="{StaticResource Brush.HoverWash}" Opacity="0"
                                    IsHitTestVisible="False" CornerRadius="{StaticResource Radius.Sm}" />
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Left" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hover" Property="Opacity" Value="0.06" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Press" Property="Opacity" Value="0.08" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Press" Property="Opacity" Value="0.08" />
                            </Trigger>
                            <Trigger Property="components:FocusVisual.IsVisible" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource Brush.FocusRing}" />
                                <Setter TargetName="Surface" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="{StaticResource Opacity.Disabled}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Nav buttons that highlight based on the current screen rather than being hardcoded active. -->
        <Style x:Key="NavButton.Home" TargetType="Button" BasedOn="{StaticResource NavButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding CurrentScreen}" Value="{x:Static vm:AppScreen.Home}">
                    <Setter Property="Tag" Value="Active" />
                    <Setter Property="Background" Value="{DynamicResource Brush.SelectedSurface}" />
                    <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="NavButton.Designer" TargetType="Button" BasedOn="{StaticResource NavButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding CurrentScreen}" Value="{x:Static vm:AppScreen.Designer}">
                    <Setter Property="Tag" Value="Active" />
                    <Setter Property="Background" Value="{DynamicResource Brush.SelectedSurface}" />
                    <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="NavButton.Device" TargetType="Button" BasedOn="{StaticResource NavButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding CurrentScreen}" Value="{x:Static vm:AppScreen.Device}">
                    <Setter Property="Tag" Value="Active" />
                    <Setter Property="Background" Value="{DynamicResource Brush.SelectedSurface}" />
                    <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="NavButton.Chat" TargetType="Button" BasedOn="{StaticResource NavButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding CurrentScreen}" Value="{x:Static vm:AppScreen.Chat}">
                    <Setter Property="Tag" Value="Active" />
                    <Setter Property="Background" Value="{DynamicResource Brush.SelectedSurface}" />
                    <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="Delete" Command="{Binding Scene.DeleteCommand}" />
        <KeyBinding Modifiers="Control" Key="D" Command="{Binding Scene.DuplicateCommand}" />
        <KeyBinding Modifiers="Control" Key="Z" Command="{Binding Scene.UndoCommand}" />
        <KeyBinding Modifiers="Control" Key="Y" Command="{Binding Scene.RedoCommand}" />
        <KeyBinding Modifiers="Control+Shift" Key="Z" Command="{Binding Scene.RedoCommand}" />
        <KeyBinding Modifiers="Control" Key="S" Command="{Binding SaveProjectCommand}" />
        <KeyBinding Modifiers="Control" Key="N" Command="{Binding NewProjectCommand}" />
        <KeyBinding Modifiers="Control" Key="O" Command="{Binding OpenProjectCommand}" />
        <KeyBinding Modifiers="Control" Key="C" Command="{Binding Scene.CopyCommand}" />
        <KeyBinding Modifiers="Control" Key="X" Command="{Binding Scene.CutCommand}" />
        <KeyBinding Modifiers="Control" Key="V" Command="{Binding Scene.PasteCommand}" />
        <KeyBinding Modifiers="Control" Key="A" Command="{Binding Scene.SelectAllCommand}" />
        <KeyBinding Modifiers="Alt" Key="T" Command="{Binding Scene.TraceSelectedRasterCommand}" />
        <KeyBinding Modifiers="Control+Shift" Key="U" Command="{Binding Scene.UniteSelectionCommand}" />
        <KeyBinding Modifiers="Control+Shift" Key="O" Command="{Binding Scene.OffsetSelectionCommand}" />
    </Window.InputBindings>
    <!-- "F" for fit-to-view is deliberately NOT a KeyBinding here — an unmodified single-letter
         binding fires even while a TextBox has focus. See OnPreviewKeyDown in the code-behind. -->

    <Grid>
        <!-- Chrome budget: at 1366x768 the header/toolbar/status strip used to eat 276px before the
             canvas got any. Every row here is sized to the smallest height that still gives its
             controls a full click target. -->
        <!--
            Three rows. The selection's properties used to own a fourth, full width and two lines
            tall; it is now a floating bar over the canvas, so it costs no layout at all and the
            workspace keeps those ~78px whether or not anything is selected.
        -->
        <Grid.RowDefinitions>
            <RowDefinition Height="60" />
            <RowDefinition Height="*" />
            <RowDefinition Height="48" />
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Border Background="{StaticResource Brush.TitleBar}" BorderBrush="{StaticResource Brush.PanelBorder}" BorderThickness="0,0,0,1">
            <Grid>
                <!-- The project-name column was a hard 160px, so a name longer than about twelve
                     characters was ellipsed regardless of how much empty header there was. Auto with
                     a MaxWidth lets it use the room it needs and gives it back when the window narrows. -->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" MaxWidth="280" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="138" />
                </Grid.ColumnDefinitions>

                <!-- Identity only: wordmark, project, unsaved state, window buttons. The sidebar
                     toggle lived here for one round and did not belong - it is a control, and putting
                     it beside the wordmark turned the identity block into a control cluster. It now
                     sits at the head of the rail it collapses. -->
                <Border BorderBrush="{StaticResource Brush.PanelBorder}" BorderThickness="0,0,1,0" Padding="16,0">
                    <Image Source="{StaticResource Image.BrandWordmark}"
                           Width="104" Height="34" Stretch="Uniform"
                           HorizontalAlignment="Left" VerticalAlignment="Center"
                           AutomationProperties.Name="Lasero" />
                </Border>

                <!-- Project identity on one line. "Pracovní návrh" was a constant second line that said
                     the same thing on every project and cost 18px of header height to say it. The
                     unsaved-changes dot carries the only state this area actually has. -->
                <!-- Margin left is 6, not 16: the button carries 10px of its own padding, so the
                     name text stays exactly where it was and the hover wash reaches 10px past it. -->
                <ToggleButton x:Name="ProjectNameButton" Grid.Column="1" Margin="8,0,4,0" VerticalAlignment="Center"
                              Style="{StaticResource ProjectNameButton}"
                              shell:WindowChrome.IsHitTestVisibleInChrome="True"
                              ContextMenuService.IsEnabled="False"
                              Click="OnProjectNameButtonClick" PreviewKeyDown="OnProjectNameButtonKeyDown"
                              AutomationProperties.Name="Projekt"
                              AutomationProperties.HelpText="Projekt - nový, otevřít, uložit">
                    <ToggleButton.ToolTip>
                        <StackPanel>
                            <TextBlock Text="{Binding ProjectName}" FontWeight="SemiBold" MaxWidth="360" TextWrapping="Wrap" />
                            <TextBlock Text="Projekt - nový, otevřít, uložit" />
                            <TextBlock Text="Projekt obsahuje neuložené změny"
                                       Visibility="{Binding IsDirty, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </ToggleButton.ToolTip>
                    <!--
                        The file commands. They used to sit in the wide command strip above the canvas,
                        which is gone; keyboard shortcuts alone would hide New/Open/Save from anyone
                        who has not learned them yet, so they get a visible home instead - attached to
                        the project name, which is the thing they act on. One button, four entries.
                        The menu is the button's own ContextMenu, opened under its left edge from code
                        (WPF flips it to stay on screen).
                    -->
                    <ToggleButton.ContextMenu>
                        <ContextMenu x:Name="ProjectMenu" Placement="Bottom"
                                     Opened="OnProjectMenuOpened" Closed="OnProjectMenuClosed">
                            <MenuItem Header="Nový projekt" InputGestureText="Ctrl+N" Command="{Binding NewProjectCommand}">
                                <MenuItem.Icon><components:IconGlyph IconData="{StaticResource Glyph.New}" Width="{StaticResource Size.Icon.Sm}" Height="{StaticResource Size.Icon.Sm}" /></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Otevřít projekt…" InputGestureText="Ctrl+O" Command="{Binding OpenProjectCommand}">
                                <MenuItem.Icon><components:IconGlyph IconData="{StaticResource Glyph.Open}" Width="{StaticResource Size.Icon.Sm}" Height="{StaticResource Size.Icon.Sm}" /></MenuItem.Icon>
                            </MenuItem>
                            <Separator />
                            <MenuItem Header="Uložit" InputGestureText="Ctrl+S" Command="{Binding SaveProjectCommand}">
                                <MenuItem.Icon><components:IconGlyph IconData="{StaticResource Glyph.Save}" Width="{StaticResource Size.Icon.Sm}" Height="{StaticResource Size.Icon.Sm}" /></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Uložit jako…" Command="{Binding SaveProjectAsCommand}" />
                        </ContextMenu>
                    </ToggleButton.ContextMenu>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding ProjectName}" FontFamily="{StaticResource Font.Display}" FontSize="{StaticResource Size.Text.Section}" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" MaxWidth="200" VerticalAlignment="Center" />
                        <Ellipse Width="6" Height="6" Fill="{StaticResource Brush.Accent}" Margin="8,0,0,0" VerticalAlignment="Center"
                                 Visibility="{Binding IsDirty, Converter={StaticResource BoolToVisibility}}" />
                        <components:IconGlyph IconData="{StaticResource Glyph.ChevronDown}" Margin="8,0,0,0" VerticalAlignment="Center"
                                              Foreground="{DynamicResource Brush.TextSecondary}"
                                              Width="{StaticResource Size.Icon.Sm}" Height="{StaticResource Size.Icon.Sm}" />
                    </StackPanel>
                </ToggleButton>
                <!-- File and history commands moved down to the one command row above the canvas.
                     The title bar is identity: wordmark, project, unsaved state, window buttons. -->

                <!-- The connection pill that used to live here has moved out. Connection state was
                     rendered in three places at once (here, the Device page header, the status strip);
                     the persistent bottom-left strip is now the single source of visual truth for it,
                     and the Device page keeps its own badge because there the machine is the subject. -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Margin="16,0,12,0" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource Button.Regular}" Click="OnDeviceSettingsClick" Padding="16,0"
                            Visibility="{Binding ShowDeviceSettingsShortcut, Converter={StaticResource BoolToVisibility}}"
                            ToolTip="Otevřít nastavení gravírky — pracovní plocha, osa Z, bezpečnost"
                            AutomationProperties.Name="Nastavení zařízení">
                        <components:IconLabel IconData="{StaticResource Glyph.Settings}" Text="Nastavení zařízení" IconSize="{StaticResource Size.Icon.Sm}" TextMargin="7,0,0,0" />
                    </Button>
                </StackPanel>

                <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="MinimizeButton" Style="{StaticResource Button.Chrome}" Click="OnMinimizeClick" AutomationProperties.Name="Minimalizovat">
                        <components:IconGlyph IconData="{StaticResource Glyph.Minimize}" Width="{StaticResource Size.Icon.Sm}" Height="{StaticResource Size.Icon.Sm}" />
                    </Button>
                    <Button x:Name="MaximizeButton" Style="{StaticResource Button.Chrome}" Click="OnMaximizeClick" AutomationProperties.Name="Maximalizovat">
                        <components:IconGlyph x:Name="MaximizeGlyph" IconData="{StaticResource Glyph.Maximize}" Width="{StaticResource Size.Icon.Chrome}" Height="{StaticResource Size.Icon.Chrome}" />
                    </Button>
                    <Button x:Name="CloseButton" Style="{StaticResource Button.ChromeClose}" Click="OnCloseClick" AutomationProperties.Name="Zavřít">
                        <components:IconGlyph IconData="{StaticResource Glyph.Close}" Width="{StaticResource Size.Icon.Chrome}" Height="{StaticResource Size.Icon.Chrome}" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main editor -->
        <Grid Grid.Row="1">
            <!--
                The inspector is a fixed pixel column so the canvas ("*") absorbs every other pixel
                the window has, and MinWidth on the canvas stops the inspector from being dragged
                wide enough to squeeze the workspace out. The nav width used to come from a converter
                that took CurrentScreen and returned a constant 176 regardless of it.

                The inspector's MinWidth must stay equal to DesignerInspectorView.MinWidth. A Grid
                will not shrink a child below its MinWidth, so a narrower column does not compress the
                panel — it lets the panel hang off the right edge of the window, half a value field at
                a time. WorkspacePreferences.MinInspectorWidth carries the same number for the
                persisted width.
            -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="NavColumn" Width="184" />
                <ColumnDefinition Width="*" MinWidth="420" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="InspectorColumn" Width="360" MinWidth="340" MaxWidth="560" />
            </Grid.ColumnDefinitions>

            <!--
                Two rails share this slot and exactly one is ever visible. The full sidebar serves
                Home, Device and Chat at a stable 164px width. Designer swaps in a 56px rail instead,
                because an editor wants the pixels and its tools belong beside the canvas rather than
                in a strip above it.

                Swapping controls rather than morphing one is what keeps the other three screens
                untouched — none of their behaviour runs through the Designer rail's code path.
            -->
            <views:DesignerToolRail x:Name="DesignerRail" Grid.Column="0" Panel.ZIndex="10"
                                    Visibility="{Binding CurrentScreen, Converter={StaticResource EnumEqualsVisibility}, ConverterParameter=Designer}" />

            <!-- Visibility is driven from ApplyWorkspaceMode rather than a binding, because the same
                 place has to set the column width — and a column and a binding disagreeing about who
                 owns the rail is how the canvas ends up 108px short of the window. -->
            <Grid x:Name="NavRailHost" Grid.Column="0" HorizontalAlignment="Left" Panel.ZIndex="10">
            <Border x:Name="NavRail" Width="184"
                    Background="{DynamicResource Brush.Sidebar}"
                    BorderBrush="{StaticResource Brush.PanelBorder}"
                    BorderThickness="0,0,1,0" CornerRadius="0"
                    Padding="16,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <Button Style="{StaticResource NavButton.Home}" Command="{Binding ShowHomeCommand}"
                                ToolTip="Přehled projektů, úloh a zařízení" AutomationProperties.Name="Domů">
                            <components:IconLabel IconData="{StaticResource Glyph.Home}" Text="Domů" IconSize="{StaticResource Size.Icon.Lg}" TextMargin="9,0,0,0" />
                        </Button>
                        <Button Style="{StaticResource NavButton.Designer}" Command="{Binding ShowDesignerCommand}"
                                ToolTip="Pracovní plocha pro přípravu grafiky" AutomationProperties.Name="Návrh">
                            <components:IconLabel IconData="{StaticResource Glyph.Design}" Text="Návrh" IconSize="{StaticResource Size.Icon.Lg}" TextMargin="9,0,0,0" />
                        </Button>
                        <Button Style="{StaticResource NavButton}" Click="OnMaterialsClick"
                                ToolTip="Materiály a doporučené parametry gravírování" AutomationProperties.Name="Materiály">
                            <components:IconLabel IconData="{StaticResource Glyph.Materials}" Text="Materiály" IconSize="{StaticResource Size.Icon.Lg}" TextMargin="9,0,0,0" />
                        </Button>
                        <Button Style="{StaticResource NavButton.Device}" Command="{Binding ShowDeviceCommand}"
                                ToolTip="Připojení, nastavení a kontrola gravírky" AutomationProperties.Name="Zařízení">
                            <components:IconLabel IconData="{StaticResource Glyph.Device}" Text="Zařízení" IconSize="{StaticResource Size.Icon.Lg}" TextMargin="9,0,0,0" />
                        </Button>
                        <Button Style="{StaticResource NavButton.Chat}" Command="{Binding ShowChatCommand}"
                                ToolTip="Konverzace s asistentem Kamil o návrhu, materiálech a gravírování" AutomationProperties.Name="Chat">
                            <components:IconLabel IconData="{StaticResource Glyph.Chat}" Text="Chat" IconSize="{StaticResource Size.Icon.Lg}" TextMargin="9,0,0,0" />
                        </Button>
                    </StackPanel>

                    <StackPanel Grid.Row="2">
                        <Border Height="1" Background="{StaticResource Brush.PanelBorder}" Margin="8,8,8,12" />
                        <Button Style="{StaticResource NavButton}" Click="OnSettingsClick"
                                ToolTip="Předvolby aplikace a pracovní plochy" AutomationProperties.Name="Nastavení">
                            <components:IconLabel IconData="{StaticResource Glyph.Settings}" Text="Nastavení" IconSize="{StaticResource Size.Icon.Lg}" TextMargin="9,0,0,0" />
                        </Button>

                        <!-- Whoever is signed in, at the foot of the sidebar. The e-mail is the only
                             name the account actually has, so that is what it shows — no invented
                             display name — and the second line states the real licence state. -->
                        <Button Style="{StaticResource NavButton}" Height="46" Margin="0,8,0,0"
                                Click="OnSettingsClick" AutomationProperties.Name="Účet"
                                Visibility="{Binding Account.IsSignedIn, Converter={StaticResource BoolToVisibility}}">
                            <DockPanel>
                                <Border DockPanel.Dock="Left" Width="26" Height="26" Margin="0,0,8,0"
                                        CornerRadius="{StaticResource Radius.Pill}"
                                        Background="{StaticResource Brush.SelectedSurface}">
                                    <components:IconGlyph IconData="{StaticResource Glyph.User}"
                                                          Width="{StaticResource Size.Icon.Sm}" Height="{StaticResource Size.Icon.Sm}"
                                                          Foreground="{StaticResource Brush.TextSecondary}" />
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Account.Email}" FontWeight="Medium"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Account.Email}" />
                                    <TextBlock Text="{Binding Account.LicenceLabel}" Style="{StaticResource Text.Muted}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DockPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
            </Grid>

            <!-- The three full screens (Home, Zařízení, Chat) share PageScaffold, which owns the page padding and the
                 header band, so none of them gets a margin here. -->
            <views:HomeView Grid.Column="1" Grid.ColumnSpan="3" Margin="0"
                             Visibility="{Binding CurrentScreen, Converter={StaticResource EnumEqualsVisibility}, ConverterParameter=Home}" />

            <!-- Device workspace -->
            <views:DeviceView Grid.Column="1" Grid.ColumnSpan="3" Margin="0"
                              Visibility="{Binding CurrentScreen, Converter={StaticResource EnumEqualsVisibility}, ConverterParameter=Device}" />

            <!-- Account-scoped assistant. History remains available without a network connection. -->
            <views:ChatView Grid.Column="1" Grid.ColumnSpan="3" Margin="0"
                            Visibility="{Binding CurrentScreen, Converter={StaticResource EnumEqualsVisibility}, ConverterParameter=Chat}" />

            <!-- Workspace -->
            <!--
                The design workspace. One layer of chrome, not four.

                What used to be here: an adaptive command ToolBar with fifteen tools and an overflow
                popup, a spacer row, and the canvas inside a padded rounded card. The tools moved to
                the 56px rail, the file commands to the project menu in the title bar, and zoom to the
                floating cluster — so the canvas now starts at the top of this column and the two
                floating panels sit over it instead of stacking above it.

                Overlays are siblings of the canvas in the same cell with a higher ZIndex. They are
                the only hit-testable things above it, and both are anchored away from the middle, so
                dragging artwork is unaffected.
            -->
            <Grid x:Name="WorkspaceArea" Grid.Column="1" Background="{StaticResource Brush.Background}"
                  Visibility="{Binding CurrentScreen, Converter={StaticResource EnumEqualsVisibility}, ConverterParameter=Designer}">

                <!--
                    No card around the canvas. A border plus a 12px inset plus a drop shadow framed
                    the drawing area as one more panel among several; the workspace is the subject of
                    this screen, so it simply fills the column. SceneCanvas draws its own bed, rulers
                    and grid, and none of that changed.
                -->
                <controls:SceneCanvas x:Name="DesignerCanvas"
                                      ViewModel="{Binding Scene}"
                                      WorkAreaWidthMm="{Binding Connection.WorkAreaWidthMm}"
                                      WorkAreaHeightMm="{Binding Connection.WorkAreaHeightMm}"
                                      ImportCommand="{Binding GCode.LoadFileCommand}" />

                <!--
                    The selection's contextual toolbar. Top-centre over the canvas, present only while
                    something is selected. Margin clears the canvas's own 20px top ruler.
                -->
                <!-- The wrapper is what bounds the bar. Binding the bar's MaxWidth to the workspace's
                     ActualWidth measured 0 on the first pass and the bar never appeared; a stretched
                     host gives the same limit through ordinary layout, with nothing to resolve.

                     NodeEditToolbar swaps in for SelectionPropertiesBar while node-edit is active —
                     editing individual nodes and editing the whole object's X/Y/W/H are different
                     concerns, and the edited object stays in SceneViewModel.SelectedObjects the whole
                     time (EnterNodeEditMode adds it), so without this the two bars would show at once. -->
                <Grid VerticalAlignment="Top" Margin="12,32,12,0" Panel.ZIndex="20">
                    <views:SelectionPropertiesBar HorizontalAlignment="Center" VerticalAlignment="Top"
                                                  TargetCanvas="{Binding ElementName=DesignerCanvas}"
                                                  Visibility="{Binding IsNodeEditActive, ElementName=DesignerCanvas, Converter={StaticResource InverseBoolToVisibility}}" />
                    <views:NodeEditToolbar HorizontalAlignment="Center" VerticalAlignment="Top"
                                           TargetCanvas="{Binding ElementName=DesignerCanvas}"
                                           Visibility="{Binding IsNodeEditActive, ElementName=DesignerCanvas, Converter={StaticResource BoolToVisibility}}" />
                </Grid>

                <!-- Undo, redo, pan and zoom. Always present, because none of them depend on a
                     selection. -->
                <!-- What to do next, only when it helps: an empty-canvas explanation, or one dismissible
                     hint for the state the operator is in. Never permanent instructional text. -->
                <views:CanvasHintOverlay Panel.ZIndex="15"
                                         TargetCanvas="{Binding ElementName=DesignerCanvas}" />

                <views:CanvasViewControls x:Name="CanvasViewControls" VerticalAlignment="Bottom" HorizontalAlignment="Right"
                                          Margin="0,0,20,20" Panel.ZIndex="20"
                                          TargetCanvas="{Binding ElementName=DesignerCanvas}" />
            <!--
                Kamil. One instance, shown only while the Designer (Návrh) screen is current: the
                operator's hands are already on the canvas when they need it, and Home, Materiály,
                Zařízení, Chat and the dialogs stay free of it. Collapsed rather than unloaded, so the
                conversation is exactly as they left it on return.

                It lives inside this row rather than over the whole window, so the machine strip below
                is out of its reach by construction: Rámovat, Spustit, Pauza and Zastavit cannot be
                covered because the assistant has no layout in that row at all.

                Declared inside the canvas column (WorkspaceArea), so its bounds ARE the canvas: the head can never
                reach the inspector, the splitter or the status strip, whatever the inspector measures.
            -->
            <kamil:KamilAssistantHost x:Name="KamilHost" Panel.ZIndex="30"
                                      Visibility="{Binding DataContext.CurrentScreen, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EnumEqualsVisibility}, ConverterParameter=Designer}"
                                      DataContext="{Binding Kamil}">
                <kamil:KamilAssistantHost.Margin>
                    <MultiBinding Converter="{StaticResource AssistantClearance}">
                        <Binding ElementName="CanvasViewControls" Path="ActualHeight" />
                    </MultiBinding>
                </kamil:KamilAssistantHost.Margin>
            </kamil:KamilAssistantHost>
            </Grid>

            <!--
                Inspector splitter. Only meaningful on the Designer screen — the other screens span
                the canvas, splitter and inspector columns, so there is nothing to resize there.
                A 6px grab strip is the usual desktop trade-off: wide enough to hit without aiming,
                narrow enough to read as an edge rather than a gutter.
            -->
            <GridSplitter x:Name="InspectorSplitter" Grid.Column="2"
                          Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          Background="Transparent"
                          ResizeBehavior="PreviousAndNext" ResizeDirection="Columns"
                          Cursor="SizeWE"
                          DragCompleted="OnInspectorSplitterDragCompleted"
                          Focusable="False"
                          AutomationProperties.Name="Změnit šířku panelu vlastností"
                          ToolTip="Přetažením změníte šířku panelu"
                          Visibility="{Binding CurrentScreen, Converter={StaticResource EnumEqualsVisibility}, ConverterParameter=Designer}">
                <GridSplitter.Template>
                    <ControlTemplate TargetType="GridSplitter">
                        <Grid Background="{TemplateBinding Background}">
                            <!-- The visible line stays a hairline in the panel border colour; only the
                                 invisible grab area is 6px. -->
                            <Border x:Name="Line" Width="1" HorizontalAlignment="Center"
                                    Background="{StaticResource Brush.PanelBorder}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Line" Property="Background" Value="{StaticResource Brush.Accent}" />
                                <Setter TargetName="Line" Property="Width" Value="2" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="Line" Property="Background" Value="{StaticResource Brush.Accent}" />
                                <Setter TargetName="Line" Property="Width" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </GridSplitter.Template>
            </GridSplitter>

            <!-- One integrated workbench: design, processing and machine operation remain beside the canvas. -->
            <views:DesignerInspectorView x:Name="DesignerInspector" Grid.Column="3"
                                         Visibility="{Binding CurrentScreen, Converter={StaticResource EnumEqualsVisibility}, ConverterParameter=Designer}" />

        </Grid>

        <!--
            Machine and job state on the left, job execution on the right. This is the app's one
            authoritative connection indicator, and the only place Start, Pause, Resume and Stop
            live — the four stay separate controls with separate availability, whatever the layout
            around them does.

            The layer palette used to sit between the two zones. Colour identifies an operation, so
            it moved into the operation inspector where the operation is; the bar is now only about
            the machine and the running job.
        -->
        <Border Grid.Row="2"
                Background="{StaticResource Brush.TitleBar}"
                BorderBrush="{StaticResource Brush.PanelBorder}"
                BorderThickness="0,1,0,0"
                Padding="16,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Margin="0,0,20,0" VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" AutomationProperties.AutomationId="StripMachineZone">
                            <!-- State is told by glyph, word and semantic colour — never colour alone. -->
                            <!-- The machine's resolved state (not merely "the port is open"): disconnected, connecting,
                                 ready, working, paused, door open, alarm, error. The tooltip carries the full
                                 sentence, including why a connection attempt failed and what to try. -->
                            <components:StatusBadge StatusText="{Binding MachineBadgeLabel}"
                                                    Kind="{Binding MachineBadgeKind}"
                                                    ToolTip="{Binding Connection.StatusDetail}"
                                                    MaxWidth="320">
                                <components:StatusBadge.Style>
                                    <Style TargetType="components:StatusBadge">
                                        <Setter Property="IconData" Value="{StaticResource Glyph.Disconnect}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Connection.IsConnecting}" Value="True">
                                                <Setter Property="IconData" Value="{StaticResource Glyph.Refresh}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Connection.IsConnected}" Value="True">
                                                <Setter Property="IconData" Value="{StaticResource Glyph.Connect}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding MachineBadgeKind}" Value="{x:Static components:StatePillKind.Error}">
                                                <Setter Property="IconData" Value="{StaticResource Glyph.Warning}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </components:StatusBadge.Style>
                            </components:StatusBadge>

                            <!-- Home and Zařízení carry their own connect call-to-action, so the strip repeats it only on
                                 Návrh and Chat (docs/screen-controls-matrix.md, Redundant entry points). -->
                            <StackPanel Orientation="Horizontal" Visibility="{Binding ShowStripConnect, Converter={StaticResource BoolToVisibility}}">
                            <Button Style="{StaticResource Button.Ghost}" Command="{Binding Connection.SmartConnectCommand}"
                                    Height="26" MinHeight="26" Padding="8,0" Margin="12,0,0,0" FontSize="{StaticResource Size.Text.Meta}"
                                    Foreground="{StaticResource Brush.AccentText}"
                                    Content="Připojit"
                                    ToolTip="Připojí naposledy použitý laser, jinak jej najde automaticky na portech COM"
                                    Visibility="{Binding Connection.IsConnected, Converter={StaticResource InverseBoolToVisibility}}" />

                            </StackPanel>
                            <!-- Job badge, file and message: on Návrh always, elsewhere only once a job has
                                 left Idle/Ready (see ScreenChrome.ShowJobDetails). -->
                            <StackPanel Orientation="Horizontal"
                                        Visibility="{Binding ShowStripJobDetails, Converter={StaticResource BoolToVisibility}}">
                            <components:StatusBadge Margin="12,0,0,0"
                                                    Visibility="{Binding ShowStripJobBadge, Converter={StaticResource BoolToVisibility}}"
                                                    StatusText="{Binding GCode.JobBadgeLabel}"
                                                    Kind="{Binding GCode.JobState, Converter={StaticResource JobStateToPillKind}}">
                                <components:StatusBadge.Style>
                                    <Style TargetType="components:StatusBadge">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding GCode.JobState}" Value="{x:Static jobs:JobRunState.Error}">
                                                <Setter Property="IconData" Value="{StaticResource Glyph.Warning}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding GCode.JobState}" Value="{x:Static jobs:JobRunState.Faulted}">
                                                <Setter Property="IconData" Value="{StaticResource Glyph.Warning}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding GCode.JobState}" Value="{x:Static jobs:JobRunState.Aborted}">
                                                <Setter Property="IconData" Value="{StaticResource Glyph.Warning}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </components:StatusBadge.Style>
                            </components:StatusBadge>

                            <Border Style="{StaticResource StatusItem}" Margin="4,0,0,0"
                                    Visibility="{Binding GCode.HasNamedJobFile, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <components:IconGlyph IconData="{StaticResource Glyph.Project}"
                                                          Width="{StaticResource Size.Icon.Sm}" Height="{StaticResource Size.Icon.Sm}"
                                                          Foreground="{StaticResource Brush.TextMuted}" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding GCode.FileLabel}"
                                               Foreground="{StaticResource Brush.TextSecondary}"
                                               FontSize="{StaticResource Size.Text.Meta}"
                                               MaxWidth="200" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding GCode.FileLabel}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <TextBlock Text="{Binding GCode.StatusStripMessage}"
                                       Margin="12,0,0,0"
                                       FontSize="{StaticResource Size.Text.Meta}"
                                       Foreground="{StaticResource Brush.TextSecondary}"
                                       MaxWidth="340"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding GCode.StatusStripMessage}" VerticalAlignment="Center"
                                       Visibility="{Binding GCode.StatusStripMessage, Converter={StaticResource NotNullToVisibility}}" />
                            </StackPanel>
                    </StackPanel>
                    <ProgressBar Grid.Row="1" Value="{Binding GCode.ProgressPercent, Mode=OneWay}" Height="3" Margin="0,8,0,0"
                                 Visibility="{Binding GCode.IsJobActive, Converter={StaticResource BoolToVisibility}}" />
                </Grid>

                <Border Grid.Column="1" Style="{StaticResource BarDivider}" HorizontalAlignment="Left"
                        Visibility="{Binding CurrentScreen, Converter={StaticResource EnumEqualsVisibility}, ConverterParameter=Designer}" />

                <!-- Outside Designer, column 1's palette (and its own dividers above/below) collapses
                     to zero width, leaving the device-status and job-action zones flush against each
                     other with no separator at all — the two dividers above/below only ever cover the
                     3-zone Designer layout, never this 2-zone one. Same shared BarDivider hairline,
                     just the inverse visibility. -->
                <Border Grid.Column="1" HorizontalAlignment="Center">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource BarDivider}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowStripJobActionZone}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding CurrentScreen}" Value="{x:Static vm:AppScreen.Designer}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>

                <!-- The layer palette. Kept in the status strip on the operator's call: assigning a
                     production colour is something you do while working on the canvas, and reaching
                     the inspector's operation settings for it was a detour. The swatch matching the
                     selected layer is ringed. -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,20,0"
                            Visibility="{Binding CurrentScreen, Converter={StaticResource EnumEqualsVisibility}, ConverterParameter=Designer}"
                            ToolTip="Barva určuje, jak laser objekt zpracuje. Vyberte objekt a kliknutím na barvu mu ji přiřaďte">
                    <ItemsControl ItemsSource="{Binding Scene.LayerPalette}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource QuickLayerButton}"
                                        Background="{Binding Converter={StaticResource RgbColorToBrush}}"
                                        Command="{Binding DataContext.Scene.ChangeSelectedLayerColorCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        ToolTip="{Binding Converter={StaticResource RgbColorToName}}"
                                        AutomationProperties.Name="{Binding Converter={StaticResource RgbColorToName}}">
                                    <Button.Tag>
                                        <MultiBinding Converter="{StaticResource RgbColorMatches}">
                                            <Binding />
                                            <Binding Path="DataContext.Scene.SelectedLayer.Color" RelativeSource="{RelativeSource AncestorType=Window}" />
                                        </MultiBinding>
                                    </Button.Tag>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <Border Grid.Column="2" Style="{StaticResource BarDivider}" HorizontalAlignment="Left"
                        Visibility="{Binding CurrentScreen, Converter={StaticResource EnumEqualsVisibility}, ConverterParameter=Designer}" />

                <!--
                    One authoritative job-control group for every screen, including Designer. Start
                    is danger-red because it begins a physical operation; Frame stays secondary.
                    Availability is still decided entirely by CanRun/CanFrame and JobPreflight.
                -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0"
                            AutomationProperties.AutomationId="StripJobActions"
                            Visibility="{Binding ShowStripJobActionZone, Converter={StaticResource BoolToVisibility}}">
                    <Button Style="{StaticResource JobIdleActionButton}" Command="{Binding GCode.RunFramingCommand}" AutomationProperties.Name="Rámovat"
                            Height="{StaticResource Size.Control.Base}" MinHeight="{StaticResource Size.Control.Base}"
                            Padding="16,0" Margin="0,0,12,0"
                            ToolTipService.ShowOnDisabled="True"
                            ToolTip="{Binding GCode.FrameActionTooltip}">
                        <components:IconLabel IconData="{StaticResource Glyph.Frame}" Text="Rámovat" IconSize="{StaticResource Size.Icon.Sm}" TextMargin="8,0,0,0" />
                    </Button>
                    <Button Style="{StaticResource JobRunningActionButton}" Command="{Binding GCode.PauseResumeCommand}" AutomationProperties.Name="Pozastavit"
                            Height="{StaticResource Size.Control.Base}" MinHeight="{StaticResource Size.Control.Base}"
                            Padding="16,0" Margin="0,0,12,0"
                            ToolTip="Pozastaví úlohu a zhasne laser. Pokračovat lze tlačítkem Pokračovat">
                        <components:IconLabel IconData="{StaticResource Glyph.Pause}" Text="Pozastavit" IconSize="{StaticResource Size.Icon.Sm}" TextMargin="8,0,0,0" />
                    </Button>
                    <Button Style="{StaticResource JobPausedActionButton}" Command="{Binding GCode.PauseResumeCommand}" AutomationProperties.Name="Pokračovat"
                            Height="{StaticResource Size.Control.Base}" MinHeight="{StaticResource Size.Control.Base}"
                            Padding="16,0" Margin="0,0,12,0"
                            ToolTip="Naváže od místa pozastavení. Nejprve zkontrolujte, že nic nebrání pohybu hlavy">
                        <components:IconLabel IconData="{StaticResource Glyph.Play}" Text="Pokračovat" IconSize="{StaticResource Size.Icon.Sm}" TextMargin="8,0,0,0" />
                    </Button>
                    <Button Style="{StaticResource JobActiveStopButton}"
                            Command="{Binding GCode.AbortCommand}" AutomationProperties.Name="Zastavit"
                            Height="{StaticResource Size.Control.Base}" MinHeight="{StaticResource Size.Control.Base}"
                            Padding="16,0" Margin="0,0,12,0"
                            ToolTipService.ShowOnDisabled="True"
                            ToolTip="Okamžitě zastaví pohyb a vypne laser. Úlohu pak lze jen spustit znovu od začátku">
                        <components:IconLabel IconData="{StaticResource Glyph.Stop}" Text="Zastavit" IconSize="{StaticResource Size.Icon.Sm}" TextMargin="8,0,0,0" />
                    </Button>
                    <Button Style="{StaticResource JobStartActionButton}"
                            Command="{Binding GCode.RunJobCommand}" AutomationProperties.Name="Spustit"
                            Height="{StaticResource Size.Control.Base}" MinHeight="{StaticResource Size.Control.Base}"
                            Padding="16,0"
                            ToolTipService.ShowOnDisabled="True"
                            ToolTip="{Binding GCode.StartActionTooltip}">
                        <components:IconLabel IconData="{StaticResource Glyph.Play}" Text="Spustit" IconSize="{StaticResource Size.Icon.Sm}" TextMargin="8,0,0,0" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!--
            Device connection flow. An in-window overlay over the whole shell (RowSpan="3") rather
            than scoped to one screen like Kamil, because it can be opened from Home, Zařízení or the
            status strip's own "Připojit" affordance — see MainWindow.OpenDeviceWizard. Declared once
            here and driven entirely by DeviceWizardOverlay.Show(), the same "one persistent surface,
            state animated in code-behind" pattern KamilAssistantHost uses, just without a minimized
            resting shape of its own.
        -->
        <devicesetup:DeviceWizardOverlay x:Name="DeviceWizardOverlayHost" Grid.Row="0" Grid.RowSpan="3"
                                         Panel.ZIndex="90" />

        <!--
            One dismissible Tip chip at a time, bottom centre of the workspace row. It sits above the
            canvas hint and below every overlay, and is not hit-testable outside its own card.
        -->
        <tour:TipChip x:Name="TipChipHost" Grid.Row="1" Panel.ZIndex="60"
                      HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,76" />

        <!-- First-run welcome and guided tour. Above the wizard, and the only layer that blocks the
             whole window while it is open; see TourOverlay. -->
        <tour:TourOverlay x:Name="TourHost" Grid.Row="0" Grid.RowSpan="3" Panel.ZIndex="95" />
    </Grid>
</Window>
