<Window x:Class="Lasero.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Lasero.App.Controls"
        xmlns:components="clr-namespace:Lasero.App.Components"
        xmlns:conv="clr-namespace:Lasero.App.Converters"
        xmlns:views="clr-namespace:Lasero.App.Views"
        xmlns:vm="clr-namespace:Lasero.App.ViewModels"
        xmlns:jobs="clr-namespace:Lasero.Core.Jobs;assembly=Lasero.Core"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Lasero Desktop" Height="900" Width="1480" MinWidth="1080" MinHeight="640"
        WindowStartupLocation="CenterScreen" WindowStyle="None" Background="{StaticResource Brush.Background}">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="60" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <conv:EnumEqualsVisibilityConverter x:Key="EnumEqualsVisibility" />
        <conv:EnumToBooleanConverter x:Key="EnumToBoolean" />
        <conv:BooleanToConnectionBrushConverter x:Key="ConnectedToBrush" />
        <conv:JobRunStateToLabelConverter x:Key="JobStateToLabel" />
        <conv:JobRunStateToStatePillKindConverter x:Key="JobStateToPillKind" />
        <conv:NotNullToVisibilityConverter x:Key="NotNullToVisibility" />
        <conv:RgbColorToBrushConverter x:Key="RgbColorToBrush" />
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
        <conv:IsBelowWidthConverter x:Key="IsBelowWidth" />
        <conv:RgbColorToNameConverter x:Key="RgbColorToName" />
        <conv:RgbColorMatchesConverter x:Key="RgbColorMatches" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- Shared application styles stay centralized in SharedUiStyles.xaml. -->
        <Style x:Key="ToolbarIconButton" TargetType="Button" BasedOn="{StaticResource Button.Icon}">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="7" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>

        <Style x:Key="ToolActionButton" TargetType="Button" BasedOn="{StaticResource NavButton}">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="9,0" />
            <Setter Property="Margin" Value="0,1" />
        </Style>

        <Style x:Key="ToolPaletteButton" TargetType="RadioButton">
            <Setter Property="Height" Value="42" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource Radius.Sm}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <!--
                                Three distinct states, in this order so a hovered or pressed active
                                tool still reads as the active one. Hover is neutral and shares no
                                colour with selected, so passing the pointer over a tool can never be
                                mistaken for having picked it. Pressed is a momentary darkening.
                            -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{StaticResource Brush.PanelRaised}" />
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource Brush.PanelBorder}" />
                                <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{StaticResource Brush.PanelBorderStrong}" />
                            </Trigger>
                            <!-- Selected: tinted surface, a full-strength accent border rather than
                                 the pale one, accent icon/text and a heavier weight. Four cues, so
                                 the active tool survives both colour-blindness and a quick glance. -->
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{StaticResource Brush.SelectedSurface}" />
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                                <Setter Property="Foreground" Value="{StaticResource Brush.Accent}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource Brush.FocusRing}" />
                                <Setter TargetName="Surface" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource Brush.TextDisabled}" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DesignerToolbarTool" TargetType="RadioButton" BasedOn="{StaticResource ToolPaletteButton}">
            <Setter Property="Width" Value="{StaticResource Size.Control.Compact}" />
            <Setter Property="Height" Value="{StaticResource Size.Control.Compact}" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="DesignerRailTool" TargetType="RadioButton" BasedOn="{StaticResource ToolPaletteButton}">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>

        <!--
            Palette swatch. The outer button is 28px for a comfortable pointer target while the
            colour chip itself stays 20px, and the active swatch gets a ring instead of leaving
            twelve identical squares with no indication of which one is in play. Hover changes the
            ring's colour rather than its thickness, so the chip no longer shifts by a pixel when
            the pointer crosses it.
        -->
        <Style x:Key="QuickLayerButton" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Ring" CornerRadius="{StaticResource Radius.Sm}" BorderBrush="Transparent" BorderThickness="2" />
                            <Border x:Name="LayerColor" Width="18" Height="18" CornerRadius="{StaticResource Radius.Sm}"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{StaticResource Brush.PanelBorderStrong}" BorderThickness="1"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="BorderBrush" Value="{StaticResource Brush.PanelBorderStrong}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="LayerColor" Property="Opacity" Value="0.68" />
                            </Trigger>
                            <!-- Tag carries the "is this the selected layer's colour" MultiBinding. -->
                            <Trigger Property="Tag" Value="True">
                                <Setter TargetName="Ring" Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Ring" Property="BorderBrush" Value="{StaticResource Brush.FocusRing}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 54px could not hold a mono-spaced "98.75", so dimension fields visually truncated their own
             value — the last thing a precision tool should do. 72px fits a signed four-significant-digit
             millimetre value with room to spare, and right alignment keeps the decimal points in a column. -->
        <Style x:Key="TransformField" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Width" Value="84" />
            <Setter Property="Height" Value="{StaticResource Size.Control.Base}" />
            <Setter Property="MinHeight" Value="{StaticResource Size.Control.Base}" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Right" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="FontFamily" Value="{StaticResource Font.Numeric}" />
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
        </Style>

        <Style x:Key="TransformUnit" TargetType="TextBlock" BasedOn="{StaticResource Text.Muted}">
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="{StaticResource Size.Text.Meta}" />
        </Style>

        <!-- One label + field + unit travels as a single unit. Previously each of the three was a
             separate WrapPanel child, so a narrow window could wrap a lone "°" onto its own line,
             orphaned from the number it belongs to. -->
        <Style x:Key="TransformGroup" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,3,14,3" />
        </Style>

        <Style x:Key="TransformLabel" TargetType="TextBlock" BasedOn="{StaticResource Text.Muted}">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="TransformActionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="32" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Margin" Value="3,0" />
            <Setter Property="FontSize" Value="{StaticResource Size.Text.Body}" />
        </Style>

        <Style x:Key="JobPrimaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryAction}">
            <!-- Disabled is inherited from the base Button template. Each job button used to describe
                 its own faded variant, which meant three slightly different disabled looks in one
                 row of controls. -->
        </Style>

        <Style x:Key="JobIdleActionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding GCode.JobState}" Value="{x:Static jobs:JobRunState.Preparing}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                <DataTrigger Binding="{Binding GCode.JobState}" Value="{x:Static jobs:JobRunState.Framing}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                <DataTrigger Binding="{Binding GCode.JobState}" Value="{x:Static jobs:JobRunState.Running}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                <DataTrigger Binding="{Binding GCode.JobState}" Value="{x:Static jobs:JobRunState.Paused}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="JobStartActionButton" TargetType="Button" BasedOn="{StaticResource JobPrimaryButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding GCode.JobState}" Value="{x:Static jobs:JobRunState.Preparing}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                <DataTrigger Binding="{Binding GCode.JobState}" Value="{x:Static jobs:JobRunState.Framing}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                <DataTrigger Binding="{Binding GCode.JobState}" Value="{x:Static jobs:JobRunState.Running}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                <DataTrigger Binding="{Binding GCode.JobState}" Value="{x:Static jobs:JobRunState.Paused}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="JobRunningActionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding GCode.JobState}" Value="{x:Static jobs:JobRunState.Running}"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="JobPausedActionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding GCode.JobState}" Value="{x:Static jobs:JobRunState.Paused}"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="JobDangerButton" TargetType="Button" BasedOn="{StaticResource Button.DangerSolid}">
            <!-- Disabled is inherited from the base Button template. Each job button used to describe
                 its own faded variant, which meant three slightly different disabled looks in one
                 row of controls. -->
        </Style>

        <Style x:Key="JobActiveStopButton" TargetType="Button" BasedOn="{StaticResource JobDangerButton}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding GCode.JobState}" Value="{x:Static jobs:JobRunState.Preparing}"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                <DataTrigger Binding="{Binding GCode.JobState}" Value="{x:Static jobs:JobRunState.Framing}"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                <DataTrigger Binding="{Binding GCode.JobState}" Value="{x:Static jobs:JobRunState.Running}"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                <DataTrigger Binding="{Binding GCode.JobState}" Value="{x:Static jobs:JobRunState.Paused}"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Nav buttons that highlight based on the current screen rather than being hardcoded active. -->
        <Style x:Key="NavButton.Home" TargetType="Button" BasedOn="{StaticResource NavButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding CurrentScreen}" Value="{x:Static vm:AppScreen.Home}">
                    <Setter Property="Tag" Value="Active" />
                    <Setter Property="Background" Value="{DynamicResource Brush.SelectedSurface}" />
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="NavButton.Designer" TargetType="Button" BasedOn="{StaticResource NavButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding CurrentScreen}" Value="{x:Static vm:AppScreen.Designer}">
                    <Setter Property="Tag" Value="Active" />
                    <Setter Property="Background" Value="{DynamicResource Brush.SelectedSurface}" />
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="NavButton.Device" TargetType="Button" BasedOn="{StaticResource NavButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding CurrentScreen}" Value="{x:Static vm:AppScreen.Device}">
                    <Setter Property="Tag" Value="Active" />
                    <Setter Property="Background" Value="{DynamicResource Brush.SelectedSurface}" />
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="NavButton.Chat" TargetType="Button" BasedOn="{StaticResource NavButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding CurrentScreen}" Value="{x:Static vm:AppScreen.Chat}">
                    <Setter Property="Tag" Value="Active" />
                    <Setter Property="Background" Value="{DynamicResource Brush.SelectedSurface}" />
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="Delete" Command="{Binding Scene.DeleteCommand}" />
        <KeyBinding Modifiers="Control" Key="D" Command="{Binding Scene.DuplicateCommand}" />
        <KeyBinding Modifiers="Control" Key="Z" Command="{Binding Scene.UndoCommand}" />
        <KeyBinding Modifiers="Control" Key="Y" Command="{Binding Scene.RedoCommand}" />
        <KeyBinding Modifiers="Control+Shift" Key="Z" Command="{Binding Scene.RedoCommand}" />
        <KeyBinding Modifiers="Control" Key="S" Command="{Binding SaveProjectCommand}" />
        <KeyBinding Modifiers="Control" Key="N" Command="{Binding NewProjectCommand}" />
        <KeyBinding Modifiers="Control" Key="O" Command="{Binding OpenProjectCommand}" />
        <KeyBinding Modifiers="Control" Key="C" Command="{Binding Scene.CopyCommand}" />
        <KeyBinding Modifiers="Control" Key="X" Command="{Binding Scene.CutCommand}" />
        <KeyBinding Modifiers="Control" Key="V" Command="{Binding Scene.PasteCommand}" />
        <KeyBinding Modifiers="Control" Key="A" Command="{Binding Scene.SelectAllCommand}" />
        <KeyBinding Modifiers="Alt" Key="T" Command="{Binding Scene.TraceSelectedRasterCommand}" />
        <KeyBinding Modifiers="Control+Shift" Key="U" Command="{Binding Scene.UniteSelectionCommand}" />
    </Window.InputBindings>
    <!-- "F" for fit-to-view is deliberately NOT a KeyBinding here — an unmodified single-letter
         binding fires even while a TextBox has focus. See OnPreviewKeyDown in the code-behind. -->

    <Grid>
        <!-- Chrome budget: at 1366x768 the header/toolbar/status strip used to eat 276px before the
             canvas got any. Every row here is sized to the smallest height that still gives its
             controls a full click target. -->
        <Grid.RowDefinitions>
            <RowDefinition Height="60" />
            <RowDefinition Height="*" />
            <RowDefinition Height="56" />
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Border Background="{StaticResource Brush.TitleBar}" BorderBrush="{StaticResource Brush.PanelBorder}" BorderThickness="0,0,0,1">
            <Grid>
                <!-- The project-name column was a hard 160px, so a name longer than about twelve
                     characters was ellipsed regardless of how much empty header there was. Auto with
                     a MaxWidth lets it use the room it needs and gives it back when the window narrows. -->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" MaxWidth="280" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="138" />
                </Grid.ColumnDefinitions>

                <Border BorderBrush="{StaticResource Brush.PanelBorder}" BorderThickness="0,0,1,0" Padding="16,0">
                    <Image Source="{StaticResource Image.BrandWordmark}"
                           Width="104" Height="34" Stretch="Uniform"
                           HorizontalAlignment="Left" VerticalAlignment="Center"
                           AutomationProperties.Name="Lasero" />
                </Border>

                <!-- Project identity on one line. "Pracovní návrh" was a constant second line that said
                     the same thing on every project and cost 18px of header height to say it. The
                     unsaved-changes dot carries the only state this area actually has. -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,12,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ProjectName}" FontFamily="{StaticResource Font.Display}" FontSize="{StaticResource Size.Text.Section}" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                               ToolTip="{Binding ProjectName}" />
                    <Ellipse Width="6" Height="6" Fill="{StaticResource Brush.Accent}" Margin="8,0,0,0" VerticalAlignment="Center"
                             Visibility="{Binding IsDirty, Converter={StaticResource BoolToVisibility}}" ToolTip="Projekt obsahuje neuložené změny" />
                </StackPanel>

                <!-- File and history commands moved down to the one command row above the canvas.
                     The title bar is identity: wordmark, project, unsaved state, window buttons. -->

                <!-- The connection pill that used to live here has moved out. Connection state was
                     rendered in three places at once (here, the Device page header, the status strip);
                     the persistent bottom-left strip is now the single source of visual truth for it,
                     and the Device page keeps its own badge because there the machine is the subject. -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Margin="16,0,12,0" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource Button.Regular}" Click="OnDeviceSettingsClick" Padding="14,0"
                            ToolTip="Otevřít nastavení gravírky — pracovní plocha, osa Z, bezpečnost"
                            AutomationProperties.Name="Nastavení zařízení">
                        <components:IconLabel IconData="{StaticResource Glyph.Settings}" Text="Nastavení zařízení" IconSize="{StaticResource Size.Icon.Sm}" TextMargin="7,0,0,0" />
                    </Button>
                </StackPanel>

                <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="MinimizeButton" Style="{StaticResource Button.Chrome}" Click="OnMinimizeClick" AutomationProperties.Name="Minimalizovat">
                        <components:IconGlyph IconData="{StaticResource Glyph.Minimize}" Width="{StaticResource Size.Icon.Sm}" Height="{StaticResource Size.Icon.Sm}" />
                    </Button>
                    <Button x:Name="MaximizeButton" Style="{StaticResource Button.Chrome}" Click="OnMaximizeClick" AutomationProperties.Name="Maximalizovat">
                        <components:IconGlyph x:Name="MaximizeGlyph" IconData="{StaticResource Glyph.Maximize}" Width="{StaticResource Size.Icon.Chrome}" Height="{StaticResource Size.Icon.Chrome}" />
                    </Button>
                    <Button x:Name="CloseButton" Style="{StaticResource Button.ChromeClose}" Click="OnCloseClick" AutomationProperties.Name="Zavřít">
                        <components:IconGlyph IconData="{StaticResource Glyph.Close}" Width="{StaticResource Size.Icon.Chrome}" Height="{StaticResource Size.Icon.Chrome}" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main editor -->
        <Grid Grid.Row="1">
            <!--
                The inspector is a fixed pixel column so the canvas ("*") absorbs every other pixel
                the window has, and MinWidth on the canvas stops the inspector from being dragged
                wide enough to squeeze the workspace out. The nav width used to come from a converter
                that took CurrentScreen and returned a constant 176 regardless of it.
            -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="164" />
                <ColumnDefinition Width="*" MinWidth="420" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="InspectorColumn" Width="336" MinWidth="280" MaxWidth="560" />
            </Grid.ColumnDefinitions>

            <!-- Stable application navigation. Design tools live beside the canvas so this rail
                 never changes meaning when the user switches screens. -->
            <Border Grid.Column="0" Padding="14,16"
                    Background="{DynamicResource Brush.Sidebar}"
                    BorderBrush="{StaticResource Brush.PanelBorder}"
                    BorderThickness="0,0,1,0" CornerRadius="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <Button Style="{StaticResource NavButton.Home}" Command="{Binding ShowHomeCommand}"
                                ToolTip="Přehled projektů, úloh a zařízení" AutomationProperties.Name="Domů">
                            <components:IconLabel IconData="{StaticResource Glyph.Home}" Text="Domů" IconSize="{StaticResource Size.Icon.Md}" TextMargin="9,0,0,0" />
                        </Button>
                        <Button Style="{StaticResource NavButton.Designer}" Command="{Binding ShowDesignerCommand}"
                                ToolTip="Pracovní plocha pro přípravu grafiky" AutomationProperties.Name="Návrh">
                            <components:IconLabel IconData="{StaticResource Glyph.Design}" Text="Návrh" IconSize="{StaticResource Size.Icon.Md}" TextMargin="9,0,0,0" />
                        </Button>
                        <Button Style="{StaticResource NavButton}" Click="OnMaterialsClick"
                                ToolTip="Materiály a doporučené parametry gravírování" AutomationProperties.Name="Materiály">
                            <components:IconLabel IconData="{StaticResource Glyph.Materials}" Text="Materiály" IconSize="{StaticResource Size.Icon.Md}" TextMargin="9,0,0,0" />
                        </Button>
                        <Button Style="{StaticResource NavButton.Device}" Command="{Binding ShowDeviceCommand}"
                                ToolTip="Připojení, nastavení a kontrola gravírky" AutomationProperties.Name="Zařízení">
                            <components:IconLabel IconData="{StaticResource Glyph.Device}" Text="Zařízení" IconSize="{StaticResource Size.Icon.Md}" TextMargin="9,0,0,0" />
                        </Button>
                        <Button Style="{StaticResource NavButton.Chat}" Command="{Binding ShowChatCommand}"
                                 ToolTip="Pomoc s návrhem, materiály a gravírováním" AutomationProperties.Name="Lasero Chat">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="22" Height="22" Margin="0,0,9,0">
                                    <Ellipse.Fill><ImageBrush ImageSource="{StaticResource Image.KamilAvatar}" Stretch="UniformToFill" AlignmentY="Center" /></Ellipse.Fill>
                                </Ellipse>
                                <TextBlock Text="Lasero Chat" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <StackPanel Grid.Row="2">
                        <Border Height="1" Background="{StaticResource Brush.PanelBorder}" Margin="8,8,8,12" />
                        <Button Style="{StaticResource NavButton}" Click="OnSettingsClick"
                                ToolTip="Předvolby aplikace a pracovní plochy" AutomationProperties.Name="Nastavení">
                            <components:IconLabel IconData="{StaticResource Glyph.Settings}" Text="Nastavení" IconSize="{StaticResource Size.Icon.Md}" TextMargin="9,0,0,0" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Home dashboard -->
            <views:HomeView Grid.Column="1" Grid.ColumnSpan="3" Margin="16"
                             Visibility="{Binding CurrentScreen, Converter={StaticResource EnumEqualsVisibility}, ConverterParameter=Home}" />

            <!-- Device workspace -->
            <views:DeviceView Grid.Column="1" Grid.ColumnSpan="3" Margin="16"
                              Visibility="{Binding CurrentScreen, Converter={StaticResource EnumEqualsVisibility}, ConverterParameter=Device}" />

            <!-- Account-scoped assistant. History remains available without a network connection. -->
            <views:ChatView Grid.Column="1" Grid.ColumnSpan="3" Margin="16"
                            Visibility="{Binding CurrentScreen, Converter={StaticResource EnumEqualsVisibility}, ConverterParameter=Chat}" />

            <!-- Workspace -->
            <Grid x:Name="WorkspaceArea" Grid.Column="1" Background="{StaticResource Brush.Background}"
                  Visibility="{Binding CurrentScreen, Converter={StaticResource EnumEqualsVisibility}, ConverterParameter=Designer}">
                <Grid.Resources>
                    <!--
                        Adaptive toolbar labels. Bound to the workspace column's own width, not the
                        window's: the operator can drag the inspector wider, which takes space from
                        the toolbar without the window changing size at all. The binding is not
                        circular — this column is sized "*", so its width does not depend on what the
                        toolbar decides to render.

                        740 is where this specific toolbar stops fitting on one row, measured, not a
                        generic breakpoint. The tools are icon-only at every width now, so Import is
                        the only label left to drop — below 740 it collapses to its icon, keeping its
                        tooltip and accessible name. Nothing is removed.
                    -->
                    <Style x:Key="AdaptiveToolLabel" TargetType="components:IconLabel">
                        <Style.Triggers>
                            <DataTrigger Value="True"
                                         Binding="{Binding ActualWidth, ElementName=WorkspaceArea, Converter={StaticResource IsBelowWidth}, ConverterParameter=740}">
                                <Setter Property="CompactMode" Value="True" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Resources>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <!-- Primary design tools stay directly above the canvas. When the column gets narrow
                     the labels collapse to icons before anything wraps or clips. -->
                <Border Grid.Row="0" Panel.ZIndex="6" VerticalAlignment="Top" Height="46"
                        Background="{StaticResource Brush.Panel}"
                        BorderBrush="{StaticResource Brush.PanelBorder}" BorderThickness="0,0,0,1"
                        Padding="8,0">
                    <DockPanel LastChildFill="False">
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                            <!--
                                One command row: file, history, tools, view. Tools are icon-only. The
                                labels that used to sit beside them read well on a wide window, but they
                                are also what pushed file, history and view commands onto other
                                surfaces, which is how one workspace ended up spread across the title
                                bar, this row and a floating overlay. Every button keeps its tooltip,
                                its shortcut and its accessible name.
                            -->
                            <Button Style="{StaticResource ToolbarIconButton}" Command="{Binding NewProjectCommand}"
                                    ToolTip="Nový projekt" AutomationProperties.Name="Nový projekt">
                                <components:IconGlyph IconData="{StaticResource Glyph.New}" Width="{StaticResource Size.Icon.Md}" Height="{StaticResource Size.Icon.Md}" />
                            </Button>
                            <Button Style="{StaticResource ToolbarIconButton}" Command="{Binding OpenProjectCommand}"
                                    ToolTip="Otevřít projekt" AutomationProperties.Name="Otevřít projekt">
                                <components:IconGlyph IconData="{StaticResource Glyph.Open}" Width="{StaticResource Size.Icon.Md}" Height="{StaticResource Size.Icon.Md}" />
                            </Button>
                            <Button Style="{StaticResource ToolbarIconButton}" Command="{Binding SaveProjectCommand}"
                                    ToolTip="Uložit projekt · Ctrl+S" AutomationProperties.Name="Uložit projekt">
                                <components:IconGlyph IconData="{StaticResource Glyph.Save}" Width="{StaticResource Size.Icon.Md}" Height="{StaticResource Size.Icon.Md}" />
                            </Button>
                            <Border Width="1" Height="22" Background="{StaticResource Brush.PanelBorder}" Margin="6,0" VerticalAlignment="Center" />
                            <Button Style="{StaticResource ToolbarIconButton}" Command="{Binding Scene.UndoCommand}"
                                    ToolTip="Zpět · Ctrl+Z" AutomationProperties.Name="Zpět">
                                <components:IconGlyph IconData="{StaticResource Glyph.Undo}" Width="{StaticResource Size.Icon.Md}" Height="{StaticResource Size.Icon.Md}" />
                            </Button>
                            <Button Style="{StaticResource ToolbarIconButton}" Command="{Binding Scene.RedoCommand}"
                                    ToolTip="Znovu · Ctrl+Y" AutomationProperties.Name="Znovu">
                                <components:IconGlyph IconData="{StaticResource Glyph.Redo}" Width="{StaticResource Size.Icon.Md}" Height="{StaticResource Size.Icon.Md}" />
                            </Button>
                            <Border Width="1" Height="22" Background="{StaticResource Brush.PanelBorder}" Margin="6,0" VerticalAlignment="Center" />
                            <RadioButton Style="{StaticResource DesignerToolbarTool}" GroupName="DesignerToolbarTools"
                                         IsChecked="{Binding Scene.ActiveTool, Converter={StaticResource EnumToBoolean}, ConverterParameter=Select, Mode=TwoWay}"
                                         ToolTip="Vybrat a upravit objekty (V)" AutomationProperties.Name="Výběr">
                                <components:IconGlyph IconData="{StaticResource Glyph.Select}" Width="{StaticResource Size.Icon.Md}" Height="{StaticResource Size.Icon.Md}" />
                            </RadioButton>
                            <!-- No Pan tool button. Panning is already always available on the middle
                                 mouse button and on space+drag, so a mode you had to switch into (and
                                 back out of) to do the same thing only added a state to get stuck in.
                                 DesignerTool.Pan itself still exists and still works. This is the one
                                 point where the design system's reference toolbar, which does draw a
                                 Pan tool, is deliberately not followed. -->
                            <RadioButton Style="{StaticResource DesignerToolbarTool}" GroupName="DesignerToolbarTools"
                                         IsChecked="{Binding Scene.ActiveTool, Converter={StaticResource EnumToBoolean}, ConverterParameter=Rectangle, Mode=TwoWay}"
                                         ToolTip="Nakreslit obdélník (R)" AutomationProperties.Name="Obdélník">
                                <components:IconGlyph IconData="{StaticResource Glyph.Rectangle}" Width="{StaticResource Size.Icon.Md}" Height="{StaticResource Size.Icon.Md}" />
                            </RadioButton>
                            <RadioButton Style="{StaticResource DesignerToolbarTool}" GroupName="DesignerToolbarTools"
                                         IsChecked="{Binding Scene.ActiveTool, Converter={StaticResource EnumToBoolean}, ConverterParameter=Ellipse, Mode=TwoWay}"
                                         ToolTip="Nakreslit elipsu (E)" AutomationProperties.Name="Elipsa">
                                <components:IconGlyph IconData="{StaticResource Glyph.Ellipse}" Width="{StaticResource Size.Icon.Md}" Height="{StaticResource Size.Icon.Md}" />
                            </RadioButton>
                            <RadioButton Style="{StaticResource DesignerToolbarTool}" GroupName="DesignerToolbarTools"
                                         IsChecked="{Binding Scene.ActiveTool, Converter={StaticResource EnumToBoolean}, ConverterParameter=Line, Mode=TwoWay}"
                                         ToolTip="Nakreslit čáru (L)" AutomationProperties.Name="Čára">
                                <components:IconGlyph IconData="{StaticResource Glyph.Line}" Width="{StaticResource Size.Icon.Md}" Height="{StaticResource Size.Icon.Md}" />
                            </RadioButton>
                            <RadioButton Style="{StaticResource DesignerToolbarTool}" GroupName="DesignerToolbarTools"
                                         IsChecked="{Binding Scene.ActiveTool, Converter={StaticResource EnumToBoolean}, ConverterParameter=Text, Mode=TwoWay}"
                                         ToolTip="Vložit text (T)" AutomationProperties.Name="Text">
                                <components:IconGlyph IconData="{StaticResource Glyph.Text}" Width="{StaticResource Size.Icon.Md}" Height="{StaticResource Size.Icon.Md}" />
                            </RadioButton>
                            <Menu Background="Transparent" VerticalAlignment="Center" Margin="0,0,6,0">
                                <MenuItem Padding="11,9" ToolTip="Trojúhelníky, mnohoúhelníky a hvězdy">
                                    <MenuItem.Header>
                                        <components:IconGlyph IconData="{StaticResource Glyph.Polygon}" Width="{StaticResource Size.Icon.Md}" Height="{StaticResource Size.Icon.Md}" />
                                    </MenuItem.Header>
                                    <MenuItem Header="Trojúhelník" Command="{Binding Scene.ActivateToolCommand}" CommandParameter="{x:Static vm:DesignerTool.Triangle}" />
                                    <MenuItem Header="Pětiúhelník" Command="{Binding Scene.ActivateToolCommand}" CommandParameter="{x:Static vm:DesignerTool.Pentagon}" />
                                    <MenuItem Header="Šestiúhelník" Command="{Binding Scene.ActivateToolCommand}" CommandParameter="{x:Static vm:DesignerTool.Hexagon}" />
                                    <MenuItem Header="Osmiúhelník" Command="{Binding Scene.ActivateToolCommand}" CommandParameter="{x:Static vm:DesignerTool.Octagon}" />
                                    <Separator />
                                    <MenuItem Header="Hvězda" Command="{Binding Scene.ActivateToolCommand}" CommandParameter="{x:Static vm:DesignerTool.Star}" />
                                    <MenuItem Header="Dvojitá hvězda" Command="{Binding Scene.ActivateToolCommand}" CommandParameter="{x:Static vm:DesignerTool.DoubleStar}" />
                                </MenuItem>
                            </Menu>
                            <Border Width="1" Height="22" Background="{StaticResource Brush.PanelBorder}" Margin="6,0" VerticalAlignment="Center" />
                            <Button Style="{StaticResource ToolbarIconButton}" Click="OnZoomOutClick"
                                    ToolTip="Oddálit" AutomationProperties.Name="Oddálit">
                                <components:IconGlyph IconData="{StaticResource Glyph.ZoomOut}" Width="{StaticResource Size.Icon.Md}" Height="{StaticResource Size.Icon.Md}" />
                            </Button>
                            <!-- The readout is the canvas's own scale, not a number the chrome keeps.
                                 SceneCanvas.ZoomPercent is read-only for exactly that reason. -->
                            <TextBlock Text="{Binding ZoomPercent, ElementName=DesignerCanvas, StringFormat={}{0} %}"
                                       MinWidth="54" TextAlignment="Center" VerticalAlignment="Center"
                                       FontFamily="{StaticResource Font.Numeric}" FontWeight="Medium"
                                       Typography.NumeralAlignment="Tabular"
                                       Foreground="{StaticResource Brush.TextSecondary}"
                                       ToolTip="Měřítko plátna" />
                            <Button Style="{StaticResource ToolbarIconButton}" Click="OnZoomInClick"
                                    ToolTip="Přiblížit" AutomationProperties.Name="Přiblížit">
                                <components:IconGlyph IconData="{StaticResource Glyph.ZoomIn}" Width="{StaticResource Size.Icon.Md}" Height="{StaticResource Size.Icon.Md}" />
                            </Button>
                            <Button Style="{StaticResource ToolbarIconButton}" Click="OnFitToViewClick"
                                    ToolTip="Přizpůsobit oknu (F)" AutomationProperties.Name="Přizpůsobit oknu">
                                <components:IconGlyph IconData="{StaticResource Glyph.Fit}" Width="{StaticResource Size.Icon.Md}" Height="{StaticResource Size.Icon.Md}" />
                            </Button>
                        </StackPanel>

                        <!-- Import keeps its label. It opens a file dialog rather than switching a
                             mode, and it is the one thing in this row a first-time owner has to find. -->
                        <Button DockPanel.Dock="Right" Style="{StaticResource Button.Ghost}" Height="32" Padding="10,0"
                                VerticalAlignment="Center" Command="{Binding GCode.LoadFileCommand}"
                                ToolTip="Načíst SVG, bitmapu nebo G-code" AutomationProperties.Name="Importovat grafiku">
                            <components:IconLabel Style="{StaticResource AdaptiveToolLabel}" IconData="{StaticResource Glyph.Import}" Text="Importovat" IconSize="{StaticResource Size.Icon.Sm}" TextMargin="7,0,0,0" />
                        </Button>
                    </DockPanel>
                </Border>

                <Border Grid.Row="2" Margin="12" Background="{StaticResource Brush.Panel}" BorderBrush="{StaticResource Brush.PanelBorder}" BorderThickness="1" CornerRadius="{StaticResource Radius.Lg}" Padding="0" ClipToBounds="True">
                    <Grid>
                        <controls:SceneCanvas x:Name="DesignerCanvas" ViewModel="{Binding Scene}" WorkAreaWidthMm="{Binding Connection.WorkAreaWidthMm}" WorkAreaHeightMm="{Binding Connection.WorkAreaHeightMm}" />
                    </Grid>
                </Border>

                <!--
                    One contextual bar, not three. Position/size/rotation, the selection readout and
                    the object actions used to occupy separate stacked rows; together with the header
                    and the tool bar that was four horizontal layers stacked above the artwork. They
                    are all properties of "the thing you have selected", so they belong on one line.

                    Values carry their unit inside the field (UnitField) instead of trailing a
                    detached grey "mm", which is what made the old bar read as a spreadsheet.
                -->
                <Border Grid.Row="1"
                        Background="{StaticResource Brush.Panel}" BorderBrush="{StaticResource Brush.PanelBorder}"
                        BorderThickness="0,0,0,1" Padding="14,7"
                        Visibility="{Binding Scene.HasSelection, Converter={StaticResource BoolToVisibility}}">
                    <DockPanel LastChildFill="False">

                        <!-- Object actions. Icon-only with tooltips and accessible names: spelled-out
                             labels for Lock/Duplicate/Delete cost roughly 200px that the property
                             fields need in order to stay on one row. -->
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource Button.GhostIcon}" Command="{Binding Scene.GroupSelectionCommand}"
                                    Visibility="{Binding Scene.CanGroupSelection, Converter={StaticResource BoolToVisibility}}"
                                    ToolTip="Seskupit výběr · Ctrl+G" AutomationProperties.Name="Seskupit výběr">
                                <components:IconGlyph IconData="{StaticResource Glyph.Group}" Width="{StaticResource Size.Icon.Sm}" Height="{StaticResource Size.Icon.Sm}" />
                            </Button>
                            <Button Style="{StaticResource Button.GhostIcon}" Command="{Binding Scene.UniteSelectionCommand}"
                                    Visibility="{Binding Scene.CanUniteSelection, Converter={StaticResource BoolToVisibility}}"
                                    ToolTip="Sjednotit uzavřené vektory do jednoho tvaru · Ctrl+Shift+U" AutomationProperties.Name="Sjednotit tvary">
                                <components:IconGlyph IconData="{StaticResource Glyph.Union}" Width="{StaticResource Size.Icon.Sm}" Height="{StaticResource Size.Icon.Sm}" />
                            </Button>
                            <Button Style="{StaticResource Button.GhostIcon}" Command="{Binding Scene.UngroupSelectionCommand}"
                                    Visibility="{Binding Scene.CanUngroupSelection, Converter={StaticResource BoolToVisibility}}"
                                    ToolTip="Rozdělit skupinu nebo text na části · Ctrl+Shift+G" AutomationProperties.Name="Rozdělit skupinu">
                                <components:IconGlyph IconData="{StaticResource Glyph.Ungroup}" Width="{StaticResource Size.Icon.Sm}" Height="{StaticResource Size.Icon.Sm}" />
                            </Button>
                            <Button Style="{StaticResource Button.GhostIcon}" Command="{Binding Scene.TraceSelectedRasterCommand}"
                                    Visibility="{Binding Scene.CanTraceSelectedRaster, Converter={StaticResource BoolToVisibility}}"
                                    ToolTip="Převést bitmapu na vektorové obrysy · Alt+T" AutomationProperties.Name="Trasovat bitmapu">
                                <components:IconGlyph IconData="{StaticResource Glyph.Vector}" Width="{StaticResource Size.Icon.Sm}" Height="{StaticResource Size.Icon.Sm}" />
                            </Button>

                            <Button Style="{StaticResource Button.GhostIcon}" Command="{Binding Scene.ToggleLockCommand}"
                                    AutomationProperties.Name="Zamknout nebo odemknout výběr">
                                <Button.ToolTip>
                                    <ToolTip>
                                        <TextBlock>
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="Zamknout výběr proti úpravám" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Scene.IsSelectedLocked}" Value="True">
                                                            <Setter Property="Text" Value="Odemknout výběr" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </ToolTip>
                                </Button.ToolTip>
                                <components:IconGlyph Width="{StaticResource Size.Icon.Sm}" Height="{StaticResource Size.Icon.Sm}">
                                    <components:IconGlyph.Style>
                                        <Style TargetType="components:IconGlyph">
                                            <Setter Property="IconData" Value="{StaticResource Glyph.Unlock}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Scene.IsSelectedLocked}" Value="True">
                                                    <Setter Property="IconData" Value="{StaticResource Glyph.Lock}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </components:IconGlyph.Style>
                                </components:IconGlyph>
                            </Button>
                            <Button Style="{StaticResource Button.GhostIcon}" Command="{Binding Scene.DuplicateCommand}"
                                    ToolTip="Duplikovat výběr · Ctrl+D" AutomationProperties.Name="Duplikovat výběr">
                                <components:IconGlyph IconData="{StaticResource Glyph.Duplicate}" Width="{StaticResource Size.Icon.Sm}" Height="{StaticResource Size.Icon.Sm}" />
                            </Button>
                            <Button Style="{StaticResource Button.GhostIcon}" Command="{Binding Scene.DeleteCommand}"
                                    Foreground="{StaticResource Brush.Danger}"
                                    ToolTip="Odstranit výběr · Delete" AutomationProperties.Name="Odstranit výběr">
                                <components:IconGlyph IconData="{StaticResource Glyph.Delete}" Width="{StaticResource Size.Icon.Sm}" Height="{StaticResource Size.Icon.Sm}" />
                            </Button>

                            <!-- Overflow. It used to be bare text with no border, background or
                                 chevron, so nothing signalled that it could be clicked. -->
                            <Menu Background="Transparent" VerticalAlignment="Center" Margin="2,0,0,0">
                                <MenuItem Padding="10,9" ToolTip="Další úpravy: otočení, zrcadlení, pořadí a zarovnání"
                                          AutomationProperties.Name="Další úpravy">
                                    <MenuItem.Header>
                                        <components:IconGlyph IconData="{StaticResource Glyph.More}" Width="{StaticResource Size.Icon.Sm}" Height="{StaticResource Size.Icon.Sm}" />
                                    </MenuItem.Header>
                                    <MenuItem Header="Otočit o 90° vlevo" Command="{Binding Scene.RotateLeftCommand}" />
                                    <MenuItem Header="Otočit o 90° vpravo" Command="{Binding Scene.RotateRightCommand}" />
                                    <MenuItem Header="Zrcadlit vodorovně" Command="{Binding Scene.FlipHorizontalCommand}" />
                                    <MenuItem Header="Zrcadlit svisle" Command="{Binding Scene.FlipVerticalCommand}" />
                                    <Separator />
                                    <MenuItem Header="Přenést dopředu" Command="{Binding Scene.BringToFrontCommand}" />
                                    <MenuItem Header="Přenést dozadu" Command="{Binding Scene.SendToBackCommand}" />
                                    <MenuItem Header="Zarovnat" Visibility="{Binding Scene.HasMultipleSelection, Converter={StaticResource BoolToVisibility}}">
                                        <MenuItem Header="Vlevo" Command="{Binding Scene.AlignLeftCommand}" />
                                        <MenuItem Header="Na střed vodorovně" Command="{Binding Scene.AlignCenterHorizontalCommand}" />
                                        <MenuItem Header="Vpravo" Command="{Binding Scene.AlignRightCommand}" />
                                        <Separator />
                                        <MenuItem Header="Nahoru" Command="{Binding Scene.AlignTopCommand}" />
                                        <MenuItem Header="Na střed svisle" Command="{Binding Scene.AlignMiddleCommand}" />
                                        <MenuItem Header="Dolů" Command="{Binding Scene.AlignBottomCommand}" />
                                    </MenuItem>
                                    <Separator />
                                    <MenuItem Header="Zobrazit na plátně" IsCheckable="True" IsChecked="{Binding Scene.Selected.IsVisible}" />
                                    <MenuItem Header="Zahrnout do úlohy" IsCheckable="True" IsChecked="{Binding Scene.Selected.IncludeInOutput}" />
                                </MenuItem>
                            </Menu>
                        </StackPanel>

                        <!-- Selection readout. Plain text: it is information, not an action, and the
                             blue pill it used to sit in made it look like the row's primary button. -->
                        <TextBlock DockPanel.Dock="Left" Text="{Binding Scene.SelectionSummary}"
                                   Foreground="{StaticResource Brush.TextSecondary}" FontWeight="Medium"
                                   MaxWidth="120" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Scene.SelectionSummary}"
                                   VerticalAlignment="Center" Margin="2,0,14,0" />

                        <WrapPanel DockPanel.Dock="Left" VerticalAlignment="Center"
                                   Visibility="{Binding Scene.Selected, Converter={StaticResource NotNullToVisibility}}">
                            <StackPanel Style="{StaticResource TransformGroup}">
                                <TextBlock Text="X" Style="{StaticResource TransformLabel}" />
                                <Border Style="{StaticResource UnitField.Shell}" Width="98" Margin="6,0,0,0"
                                        IsEnabled="{Binding Scene.CanEditSelectedPosition}"
                                        ToolTip="Poloha středu objektu na ose X">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="mm" Style="{StaticResource UnitField.Suffix}" />
                                        <TextBox Style="{StaticResource UnitField.Input}" KeyDown="OnTransformFieldKeyDown"
                                                 Text="{Binding Scene.SelectedX, StringFormat=0.##, UpdateSourceTrigger=LostFocus}" />
                                    </DockPanel>
                                </Border>
                            </StackPanel>
                            <StackPanel Style="{StaticResource TransformGroup}">
                                <TextBlock Text="Y" Style="{StaticResource TransformLabel}" />
                                <Border Style="{StaticResource UnitField.Shell}" Width="98" Margin="6,0,0,0"
                                        IsEnabled="{Binding Scene.CanEditSelectedPosition}"
                                        ToolTip="Poloha středu objektu na ose Y">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="mm" Style="{StaticResource UnitField.Suffix}" />
                                        <TextBox Style="{StaticResource UnitField.Input}" KeyDown="OnTransformFieldKeyDown"
                                                 Text="{Binding Scene.SelectedY, StringFormat=0.##, UpdateSourceTrigger=LostFocus}" />
                                    </DockPanel>
                                </Border>
                            </StackPanel>
                            <!-- Size travels as one unit: width, height and the aspect lock that ties
                                 them together. They used to be three independent items in the
                                 WrapPanel, so a narrow window could put the lock — or the rotation
                                 field — on its own line, away from the values it belongs to. -->
                            <StackPanel Style="{StaticResource TransformGroup}">
                                <TextBlock Text="Š" Style="{StaticResource TransformLabel}" ToolTip="Šířka" />
                                <Border Style="{StaticResource UnitField.Shell}" Width="98" Margin="6,0,0,0"
                                        IsEnabled="{Binding Scene.CanTransformSelectedObject}"
                                        ToolTip="Výsledná šířka objektu">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="mm" Style="{StaticResource UnitField.Suffix}" />
                                        <TextBox Style="{StaticResource UnitField.Input}" KeyDown="OnTransformFieldKeyDown"
                                                 Text="{Binding Scene.SelectedWidth, StringFormat=0.##, UpdateSourceTrigger=LostFocus}" />
                                    </DockPanel>
                                </Border>
                                <ToggleButton Style="{StaticResource Toggle.Icon}"
                                              IsChecked="{Binding Scene.LockAspectRatio}"
                                              IsEnabled="{Binding Scene.CanTransformSelectedObject}"
                                              Margin="4,0"
                                              ToolTip="Zachovat poměr stran při změně šířky nebo výšky"
                                              AutomationProperties.Name="Zachovat poměr stran">
                                    <components:IconGlyph IconData="{StaticResource Glyph.Link}" Width="{StaticResource Size.Icon.Sm}" Height="{StaticResource Size.Icon.Sm}" />
                                </ToggleButton>
                                <TextBlock Text="V" Style="{StaticResource TransformLabel}" ToolTip="Výška" />
                                <Border Style="{StaticResource UnitField.Shell}" Width="98" Margin="6,0,0,0"
                                        IsEnabled="{Binding Scene.CanTransformSelectedObject}"
                                        ToolTip="Výsledná výška objektu">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="mm" Style="{StaticResource UnitField.Suffix}" />
                                        <TextBox Style="{StaticResource UnitField.Input}" KeyDown="OnTransformFieldKeyDown"
                                                 Text="{Binding Scene.SelectedHeight, StringFormat=0.##, UpdateSourceTrigger=LostFocus}" />
                                    </DockPanel>
                                </Border>
                            </StackPanel>
                            <StackPanel Style="{StaticResource TransformGroup}">
                                <components:IconGlyph IconData="{StaticResource Glyph.RotateRight}" Width="{StaticResource Size.Icon.Sm}" Height="{StaticResource Size.Icon.Sm}"
                                                      Foreground="{StaticResource Brush.TextSecondary}" VerticalAlignment="Center"
                                                      ToolTip="Otočení" />
                                <Border Style="{StaticResource UnitField.Shell}" Width="72" Margin="6,0,0,0"
                                        IsEnabled="{Binding Scene.CanRotateSelectedObject}"
                                        ToolTip="Otočení objektu ve stupních">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="°" Style="{StaticResource UnitField.Suffix}" />
                                        <TextBox Style="{StaticResource UnitField.Input}" KeyDown="OnTransformFieldKeyDown"
                                                 Text="{Binding Scene.SelectedRotation, StringFormat=0.#, UpdateSourceTrigger=LostFocus}" />
                                    </DockPanel>
                                </Border>
                            </StackPanel>
                        </WrapPanel>
                    </DockPanel>
                </Border>


            </Grid>

            <!--
                Inspector splitter. Only meaningful on the Designer screen — the other screens span
                the canvas, splitter and inspector columns, so there is nothing to resize there.
                A 6px grab strip is the usual desktop trade-off: wide enough to hit without aiming,
                narrow enough to read as an edge rather than a gutter.
            -->
            <GridSplitter x:Name="InspectorSplitter" Grid.Column="2"
                          Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          Background="Transparent"
                          ResizeBehavior="PreviousAndNext" ResizeDirection="Columns"
                          Cursor="SizeWE"
                          DragCompleted="OnInspectorSplitterDragCompleted"
                          Focusable="False"
                          AutomationProperties.Name="Změnit šířku panelu vlastností"
                          ToolTip="Přetažením změníte šířku panelu"
                          Visibility="{Binding CurrentScreen, Converter={StaticResource EnumEqualsVisibility}, ConverterParameter=Designer}">
                <GridSplitter.Template>
                    <ControlTemplate TargetType="GridSplitter">
                        <Grid Background="{TemplateBinding Background}">
                            <!-- The visible line stays a hairline in the panel border colour; only the
                                 invisible grab area is 6px. -->
                            <Border x:Name="Line" Width="1" HorizontalAlignment="Center"
                                    Background="{StaticResource Brush.PanelBorder}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Line" Property="Background" Value="{StaticResource Brush.Accent}" />
                                <Setter TargetName="Line" Property="Width" Value="2" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="Line" Property="Background" Value="{StaticResource Brush.Accent}" />
                                <Setter TargetName="Line" Property="Width" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </GridSplitter.Template>
            </GridSplitter>

            <!-- One integrated workbench: design, processing and machine operation remain beside the canvas. -->
            <views:DesignerInspectorView x:Name="DesignerInspector" Grid.Column="3"
                                         Visibility="{Binding CurrentScreen, Converter={StaticResource EnumEqualsVisibility}, ConverterParameter=Designer}" />
        </Grid>

        <!--
            Three deliberate zones: machine/job state on the left, the layer palette in the middle,
            job execution on the right. This is the app's one authoritative connection indicator —
            the header pill and the duplicate badges that used to repeat it are gone.
        -->
        <Border Grid.Row="2"
                Background="{StaticResource Brush.TitleBar}"
                BorderBrush="{StaticResource Brush.PanelBorder}"
                BorderThickness="0,1,0,0"
                Padding="16,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Margin="0,0,20,0" VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <!-- State is told three ways at once: a shape (which glyph), a word, and a
                             semantic colour. Never colour alone. The shared state pill carries all
                             three, so the command bar, the Home device card and the machine panel
                             stopped each drawing their own indicator. -->
                        <components:StatusBadge StatusText="{Binding Connection.StatusText}"
                                                ToolTip="{Binding Connection.StatusText}"
                                                MaxWidth="320">
                            <components:StatusBadge.Style>
                                <Style TargetType="components:StatusBadge">
                                    <Setter Property="Kind" Value="Neutral" />
                                    <Setter Property="IconData" Value="{StaticResource Glyph.Disconnect}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Connection.IsConnecting}" Value="True">
                                            <Setter Property="Kind" Value="Warning" />
                                            <Setter Property="IconData" Value="{StaticResource Glyph.Refresh}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Connection.IsConnected}" Value="True">
                                            <Setter Property="Kind" Value="Ready" />
                                            <Setter Property="IconData" Value="{StaticResource Glyph.Connect}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </components:StatusBadge.Style>
                        </components:StatusBadge>

                        <!-- Contextual repair action. A disconnected machine is the single most common
                             reason Start is unavailable, so the fix sits next to the statement of the
                             problem instead of only in a tooltip. -->
                        <Button Style="{StaticResource Button.Ghost}" Command="{Binding ShowDeviceCommand}"
                                Height="26" MinHeight="26" Padding="8,0" Margin="10,0,0,0" FontSize="{StaticResource Size.Text.Meta}"
                                Foreground="{StaticResource Brush.Accent}"
                                Content="Připojit"
                                ToolTip="Otevřít obrazovku Zařízení a připojit gravírku"
                                Visibility="{Binding Connection.IsConnected, Converter={StaticResource InverseBoolToVisibility}}" />

                        <components:StatusBadge Margin="10,0,0,0"
                                                StatusText="{Binding GCode.JobState, Converter={StaticResource JobStateToLabel}}"
                                                Kind="{Binding GCode.JobState, Converter={StaticResource JobStateToPillKind}}">
                            <components:StatusBadge.Style>
                                <Style TargetType="components:StatusBadge">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding GCode.JobState}" Value="{x:Static jobs:JobRunState.Error}">
                                            <Setter Property="IconData" Value="{StaticResource Glyph.Warning}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding GCode.JobState}" Value="{x:Static jobs:JobRunState.Faulted}">
                                            <Setter Property="IconData" Value="{StaticResource Glyph.Warning}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding GCode.JobState}" Value="{x:Static jobs:JobRunState.Aborted}">
                                            <Setter Property="IconData" Value="{StaticResource Glyph.Warning}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </components:StatusBadge.Style>
                        </components:StatusBadge>

                        <Border Style="{StaticResource StatusItem}" Margin="4,0,0,0"
                                Visibility="{Binding GCode.Document, Converter={StaticResource NotNullToVisibility}}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <components:IconGlyph IconData="{StaticResource Glyph.Project}"
                                                      Width="{StaticResource Size.Icon.Sm}" Height="{StaticResource Size.Icon.Sm}"
                                                      Foreground="{StaticResource Brush.TextMuted}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding GCode.FileLabel}"
                                           Foreground="{StaticResource Brush.TextSecondary}"
                                           FontSize="{StaticResource Size.Text.Meta}"
                                           MaxWidth="200" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding GCode.FileLabel}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{Binding GCode.LastMessage}"
                                   Margin="10,0,0,0"
                                   FontSize="{StaticResource Size.Text.Meta}"
                                   Foreground="{StaticResource Brush.TextSecondary}"
                                   MaxWidth="260"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding GCode.LastMessage}" VerticalAlignment="Center"
                                   Visibility="{Binding GCode.LastMessage, Converter={StaticResource NotNullToVisibility}}" />
                    </StackPanel>
                    <ProgressBar Grid.Row="1" Value="{Binding GCode.ProgressPercent, Mode=OneWay}" Height="3" Margin="0,6,0,0"
                                 Visibility="{Binding GCode.IsJobActive, Converter={StaticResource BoolToVisibility}}" />
                </Grid>

                <!-- The swatches used to float unexplained in the middle of the window. The label says
                     what they are for, and the swatch matching the selected layer is marked. -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0"
                            Visibility="{Binding CurrentScreen, Converter={StaticResource EnumEqualsVisibility}, ConverterParameter=Designer}"
                            ToolTip="Vyberte objekt a kliknutím mu přiřaďte výrobní barvu">
                    <TextBlock Text="Barva vrstvy" Style="{StaticResource Text.Muted}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <ItemsControl ItemsSource="{Binding Scene.LayerPalette}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource QuickLayerButton}"
                                        Background="{Binding Converter={StaticResource RgbColorToBrush}}"
                                        Command="{Binding DataContext.Scene.ChangeSelectedLayerColorCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        ToolTip="{Binding Converter={StaticResource RgbColorToName}}"
                                        AutomationProperties.Name="{Binding Converter={StaticResource RgbColorToName}}">
                                    <Button.Tag>
                                        <MultiBinding Converter="{StaticResource RgbColorMatches}">
                                            <Binding />
                                            <Binding Path="DataContext.Scene.SelectedLayer.Color" RelativeSource="{RelativeSource AncestorType=Window}" />
                                        </MultiBinding>
                                    </Button.Tag>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!--
                    Job execution. Start is the one dominant control in the application: primary blue,
                    Large height, wider padding. Frame stays neutral and secondary — it is the check
                    you run before Start, not a competing action. Neither changes machine semantics;
                    availability is still decided entirely by CanRun/CanFrame and the preflight.
                -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!--
                        Time is reported on demand, not as a permanent readout. A number sitting in the
                        corner invites trust it has not earned: it is a model of the toolpath, and the
                        operator cannot tell what went into it. Behind this button the same estimate
                        arrives with the preview that produced it, broken into cutting versus
                        repositioning, so the figure is something you can check rather than just read.
                    -->
                    <Button Style="{StaticResource Button.Regular}" Command="{Binding GCode.PreviewSimulationCommand}"
                            Height="{StaticResource Size.Control.Large}" MinHeight="{StaticResource Size.Control.Large}"
                            Padding="18,0" Margin="0,0,10,0"
                            ToolTipService.ShowOnDisabled="True"
                            ToolTip="Zobrazit náhled dráhy a odhadovaný čas úlohy podle zapnutých vrstev"
                            Visibility="{Binding CurrentScreen, Converter={StaticResource EnumEqualsVisibility}, ConverterParameter=Designer}">
                        <components:IconLabel IconData="{StaticResource Glyph.Clock}" Text="Odhad času" IconSize="{StaticResource Size.Icon.Sm}" TextMargin="8,0,0,0" />
                    </Button>
                    <Button Style="{StaticResource JobIdleActionButton}" Command="{Binding GCode.RunFramingCommand}"
                            Height="{StaticResource Size.Control.Large}" MinHeight="{StaticResource Size.Control.Large}"
                            Padding="18,0" Margin="0,0,10,0"
                            ToolTipService.ShowOnDisabled="True"
                            ToolTip="{Binding GCode.FrameActionTooltip}">
                        <components:IconLabel IconData="{StaticResource Glyph.Frame}" Text="Rámovat" IconSize="{StaticResource Size.Icon.Sm}" TextMargin="8,0,0,0" />
                    </Button>
                    <Button Style="{StaticResource JobRunningActionButton}" Command="{Binding GCode.PauseResumeCommand}"
                            Height="{StaticResource Size.Control.Large}" MinHeight="{StaticResource Size.Control.Large}"
                            Padding="18,0" Margin="0,0,10,0"
                            ToolTip="Pozastavit úlohu">
                        <components:IconLabel IconData="{StaticResource Glyph.Pause}" Text="Pozastavit" IconSize="{StaticResource Size.Icon.Sm}" TextMargin="8,0,0,0" />
                    </Button>
                    <Button Style="{StaticResource JobPausedActionButton}" Command="{Binding GCode.PauseResumeCommand}"
                            Height="{StaticResource Size.Control.Large}" MinHeight="{StaticResource Size.Control.Large}"
                            Padding="18,0" Margin="0,0,10,0"
                            ToolTip="Pokračovat v pozastavené úloze">
                        <components:IconLabel IconData="{StaticResource Glyph.Play}" Text="Pokračovat" IconSize="{StaticResource Size.Icon.Sm}" TextMargin="8,0,0,0" />
                    </Button>
                    <Button Style="{StaticResource JobActiveStopButton}"
                            Command="{Binding GCode.AbortCommand}"
                            Height="{StaticResource Size.Control.Large}" MinHeight="{StaticResource Size.Control.Large}"
                            Padding="18,0" Margin="0,0,10,0"
                            ToolTipService.ShowOnDisabled="True"
                            ToolTip="Okamžitě zastavit pohyb i laser">
                        <components:IconLabel IconData="{StaticResource Glyph.Stop}" Text="Zastavit" IconSize="{StaticResource Size.Icon.Sm}" TextMargin="8,0,0,0" />
                    </Button>
                    <Button Style="{StaticResource JobStartActionButton}"
                            Command="{Binding GCode.RunJobCommand}"
                            Height="{StaticResource Size.Control.Large}" MinHeight="{StaticResource Size.Control.Large}"
                            Padding="18,0"
                            ToolTipService.ShowOnDisabled="True"
                            ToolTip="{Binding GCode.StartActionTooltip}">
                        <components:IconLabel IconData="{StaticResource Glyph.Play}" Text="Spustit" IconSize="{StaticResource Size.Icon.Sm}" TextMargin="8,0,0,0" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
