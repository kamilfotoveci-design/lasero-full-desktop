<Window x:Class="Lasero.App.RasterImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:Lasero.App.Converters"
        xmlns:components="clr-namespace:Lasero.App.Components"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Připravit obrázek" Width="1080" Height="720" MinWidth="920" MinHeight="620"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" WindowStyle="None" Background="{StaticResource Brush.Background}" Foreground="{StaticResource Brush.TextPrimary}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:EnumToBooleanConverter x:Key="EnumToBool" />
        <conv:EnumEqualsVisibilityConverter x:Key="EnumEqualsVisibility" />
        <conv:NotNullToVisibilityConverter x:Key="NotNullToVisibility" />
    </Window.Resources>
    <Border Background="{StaticResource Brush.Background}" BorderBrush="{StaticResource Brush.PanelBorderStrong}" BorderThickness="1">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="44" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <components:WindowTitleBar Title="Připravit obrázek" IconData="{StaticResource Glyph.Image}"
                                    CloseButtonName="Zavřít přípravu obrázku" />
    <Grid Grid.Row="1">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="390" /></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

        <Border Grid.ColumnSpan="2" Background="{StaticResource Brush.Panel}"
                BorderBrush="{StaticResource Brush.PanelBorder}" BorderThickness="0,0,0,1" Padding="24,16">
            <components:PageHeader Title="Připravit obrázek"
                                   Subtitle="Rozměr a vzhled gravírování. Obrázek se automaticky zpracuje v odstínech šedi.">
                <components:PageHeader.Actions>
                    <Border VerticalAlignment="Center" Style="{StaticResource Badge}" MaxWidth="280">
                        <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding FileName}" />
                    </Border>
                </components:PageHeader.Actions>
            </components:PageHeader>
        </Border>

        <!-- Live preview -->
        <Border Grid.Column="0" Grid.Row="1" Background="{StaticResource Brush.Panel}" BorderBrush="{StaticResource Brush.PanelBorder}" BorderThickness="0,0,1,0" Padding="24">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Border Background="{StaticResource Brush.Field}" BorderBrush="{StaticResource Brush.PanelBorder}" BorderThickness="1" CornerRadius="{StaticResource Radius.Lg}" Padding="12">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <TextBlock Text="PŮVODNÍ" Style="{StaticResource Text.Muted}" FontWeight="SemiBold" Margin="4,0,0,8" />
                        <TextBlock Grid.Column="2" Text="VÝSLEDEK" Style="{StaticResource Text.Muted}" FontWeight="SemiBold" Margin="4,0,0,8" />
                        <Border Grid.Row="1" Grid.Column="0" Background="{StaticResource Brush.Background}" CornerRadius="{StaticResource Radius.Md}" ClipToBounds="True">
                            <Viewbox Stretch="Uniform"><Image Source="{Binding OriginalImageSource}" Width="{Binding PreviewImageWidthDip}" Height="{Binding PreviewImageHeightDip}" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality" RenderTransformOrigin="0.5,0.5"><Image.RenderTransform><TransformGroup><ScaleTransform ScaleX="{Binding PreviewZoom}" ScaleY="{Binding PreviewZoom}" /><TranslateTransform X="{Binding PreviewPanX}" Y="{Binding PreviewPanY}" /></TransformGroup></Image.RenderTransform></Image></Viewbox>
                        </Border>
                        <Border Grid.Row="1" Grid.Column="2" Background="{StaticResource Brush.Background}" CornerRadius="{StaticResource Radius.Md}" ClipToBounds="True">
                            <Grid>
                                <Viewbox Stretch="Uniform"><Image Source="{Binding PreviewImageSource}" Width="{Binding PreviewImageWidthDip}" Height="{Binding PreviewImageHeightDip}" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor" RenderTransformOrigin="0.5,0.5"><Image.RenderTransform><TransformGroup><ScaleTransform ScaleX="{Binding PreviewZoom}" ScaleY="{Binding PreviewZoom}" /><TranslateTransform X="{Binding PreviewPanX}" Y="{Binding PreviewPanY}" /></TransformGroup></Image.RenderTransform></Image></Viewbox>
                                <TextBlock Text="Zpracovávám…" Style="{StaticResource Text.Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="{Binding IsPreviewComputing, Converter={StaticResource BoolToVisibility}}" />
                            </Grid>
                        </Border>
                        <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                            <Button Style="{StaticResource Button.GhostIcon}" Content="−" Click="OnZoomOutClick" ToolTip="Oddálit náhled" />
                            <Button Style="{StaticResource Button.Ghost}" Content="100 %" Click="OnResetZoomClick" ToolTip="Náhled v měřítku 1:1" />
                            <Button Style="{StaticResource Button.GhostIcon}" Content="+" Click="OnZoomInClick" ToolTip="Přiblížit náhled" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Grid Grid.Row="1" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="{Binding ProcessedDimensionsLabel}" Style="{StaticResource Text.Muted}" Margin="0,0,0,8" />
                        <TextBlock FontSize="{StaticResource Size.Text.Meta}" Foreground="{StaticResource Brush.TextSecondary}">
                            <Run Text="Rozměr úlohy: " /><Run Text="{Binding PlannedJob.Bounds.Width, StringFormat={}{0:0.0}, Mode=OneWay}" /><Run Text=" × " /><Run Text="{Binding PlannedJob.Bounds.Height, StringFormat={}{0:0.0}, Mode=OneWay}" /><Run Text=" mm" />
                        </TextBlock>
                        <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Visibility="{Binding StatusMessage, Converter={StaticResource NotNullToVisibility}}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- Settings -->
        <ScrollViewer Grid.Column="1" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,20,20,12">
            <StackPanel>
                <components:ElevatedBorder Style="{StaticResource InspectorSection}">
                    <StackPanel>
                        <TextBlock Text="Rozměr na pracovní ploše" Style="{StaticResource PanelTitle}" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Šířka (mm)" Style="{StaticResource Text.Muted}" />
                                <TextBox Text="{Binding TargetWidthMm, StringFormat={}{0:0.##}, ValidatesOnExceptions=True, UpdateSourceTrigger=LostFocus}" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Výška (mm)" Style="{StaticResource Text.Muted}" />
                                <TextBox Text="{Binding TargetHeightMm, StringFormat={}{0:0.##}, ValidatesOnExceptions=True, UpdateSourceTrigger=LostFocus}"
                                         IsEnabled="{Binding KeepAspectRatio, Converter={StaticResource InverseBoolConverter}}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>
                        <CheckBox Content="Zachovat poměr stran" IsChecked="{Binding KeepAspectRatio}" Margin="0,12,0,0" />
                    </StackPanel>
                </components:ElevatedBorder>

                <components:ElevatedBorder Style="{StaticResource InspectorSection}">
                    <StackPanel>
                        <TextBlock Text="Vzhled a převod" Style="{StaticResource PanelTitle}" />
                        <TextBlock Text="Předvolba" Style="{StaticResource Text.Muted}" Margin="0,4,0,4" />
                        <WrapPanel>
                            <Button Style="{StaticResource Button.Ghost}" Content="Fotografie" Tag="Fotografie" Click="OnBuiltInPresetClick" />
                            <Button Style="{StaticResource Button.Ghost}" Content="Dřevo" Tag="Dřevo" Click="OnBuiltInPresetClick" />
                            <Button Style="{StaticResource Button.Ghost}" Content="Kůže" Tag="Kůže" Click="OnBuiltInPresetClick" />
                            <Button Style="{StaticResource Button.Ghost}" Content="Logo" Tag="Logo" Click="OnBuiltInPresetClick" />
                        </WrapPanel>
                        <Grid Margin="0,8,0,4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <ComboBox x:Name="UserPresetCombo" ItemsSource="{Binding UserPresets}" DisplayMemberPath="Name"
                                      SelectionChanged="OnUserPresetSelectionChanged" ToolTip="Moje předvolby úprav obrazu" />
                            <Button Grid.Column="1" Margin="8,0,0,0" Style="{StaticResource Button.Ghost}" Content="Uložit" Click="OnSavePresetClick" />
                        </Grid>
                        <WrapPanel>
                            <Button Style="{StaticResource Button.Ghost}" Content="Importovat…" Click="OnImportPresetClick" />
                            <Button Style="{StaticResource Button.Ghost}" Content="Exportovat…" Click="OnExportPresetClick" />
                            <Button Style="{StaticResource Button.Ghost}" Content="Smazat" Click="OnDeletePresetClick" />
                        </WrapPanel>
                        <TextBlock Text="Způsob převodu" Style="{StaticResource Text.Muted}" Margin="0,8,0,4" />
                        <ComboBox ItemsSource="{Binding AvailableDitheringChoices}" SelectedItem="{Binding SelectedDithering}" DisplayMemberPath="Label" />
                        <TextBlock Text="{Binding SelectedDithering.Hint}" Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,8,0,0" />
                        <CheckBox Content="Obrátit světlé a tmavé plochy" IsChecked="{Binding Invert}" Margin="0,12,0,8" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Jas" Style="{StaticResource Text.Muted}" />
                            <TextBlock Grid.Column="1" Text="{Binding Brightness, StringFormat={}{0:0}}" Style="{StaticResource Text.Numeric}" />
                        </Grid>
                        <Slider Minimum="-100" Maximum="100" Value="{Binding Brightness, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,12" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Rozestup řádků (mm)" Style="{StaticResource Text.Muted}" />
                            <TextBlock Grid.Column="1" Text="{Binding LineIntervalMm, StringFormat={}{0:0.###}}" Style="{StaticResource Text.Numeric}" />
                        </Grid>
                        <TextBox Text="{Binding Dpi, StringFormat={}{0:0.##}, UpdateSourceTrigger=LostFocus}" Margin="0,4,0,12" ToolTip="Rozlišení v DPI" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Jas" Style="{StaticResource Text.Muted}" />
                            <TextBlock Grid.Column="1" Text="{Binding Brightness, StringFormat={}{0:0}}" Style="{StaticResource Text.Numeric}" />
                        </Grid>
                        <Slider Minimum="-100" Maximum="100" Value="{Binding Brightness, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,12" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Kontrast" Style="{StaticResource Text.Muted}" />
                            <TextBlock Grid.Column="1" Text="{Binding Contrast, StringFormat={}{0:0}}" Style="{StaticResource Text.Numeric}" />
                        </Grid>
                        <Slider Minimum="-100" Maximum="100" Value="{Binding Contrast, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,12" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Gamma" Style="{StaticResource Text.Muted}" />
                            <TextBlock Grid.Column="1" Text="{Binding Gamma, StringFormat={}{0:0.00}}" Style="{StaticResource Text.Numeric}" />
                        </Grid>
                        <Slider Minimum="0.1" Maximum="3" TickFrequency="0.01" Value="{Binding Gamma, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,12" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Doostření" Style="{StaticResource Text.Muted}" />
                            <TextBlock Grid.Column="1" Text="{Binding Sharpen, StringFormat={}{0:0}}" Style="{StaticResource Text.Numeric}" />
                        </Grid>
                        <Slider Minimum="0" Maximum="100" Value="{Binding Sharpen, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,12" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Poloměr doostření" Style="{StaticResource Text.Muted}" />
                            <TextBlock Grid.Column="1" Text="{Binding SharpenRadius}" Style="{StaticResource Text.Numeric}" />
                        </Grid>
                        <Slider Minimum="1" Maximum="4" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding SharpenRadius}" Margin="0,4,0,12" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Práh" Style="{StaticResource Text.Muted}" />
                            <TextBlock Grid.Column="1" Text="{Binding ThresholdValue}" Style="{StaticResource Text.Numeric}" />
                        </Grid>
                        <Slider Minimum="0" Maximum="255" Value="{Binding ThresholdValue, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,12" />

                        <Expander Header="Další úpravy">
                            <StackPanel Margin="0,12,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="Expozice" Style="{StaticResource Text.Muted}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Exposure, StringFormat={}{0:0}}" Style="{StaticResource Text.Numeric}" />
                                </Grid>
                                <Slider Minimum="-100" Maximum="100" Value="{Binding Exposure, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,12" />
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="Světla" Style="{StaticResource Text.Muted}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Highlights, StringFormat={}{0:0}}" Style="{StaticResource Text.Numeric}" />
                                </Grid>
                                <Slider Minimum="-100" Maximum="0" Value="{Binding Highlights, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,12" />
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="Stíny" Style="{StaticResource Text.Muted}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Shadows, StringFormat={}{0:0}}" Style="{StaticResource Text.Numeric}" />
                                </Grid>
                                <Slider Minimum="-100" Maximum="100" Value="{Binding Shadows, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,12" />
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="Černý bod" Style="{StaticResource Text.Muted}" />
                                    <TextBlock Grid.Column="1" Text="{Binding BlackPoint, StringFormat={}{0:0}}" Style="{StaticResource Text.Numeric}" />
                                </Grid>
                                <Slider Minimum="0" Maximum="128" Value="{Binding BlackPoint, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,12" />
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="Bílý bod" Style="{StaticResource Text.Muted}" />
                                    <TextBlock Grid.Column="1" Text="{Binding WhitePoint, StringFormat={}{0:0}}" Style="{StaticResource Text.Numeric}" />
                                </Grid>
                                <Slider Minimum="128" Maximum="255" Value="{Binding WhitePoint, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,12" />
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="Redukce šumu" Style="{StaticResource Text.Muted}" />
                                    <TextBlock Grid.Column="1" Text="{Binding NoiseReduction, StringFormat={}{0:0}}" Style="{StaticResource Text.Numeric}" />
                                </Grid>
                                <Slider Minimum="0" Maximum="100" Value="{Binding NoiseReduction, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,12" />
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="Zvýraznění hran" Style="{StaticResource Text.Muted}" />
                                    <TextBlock Grid.Column="1" Text="{Binding EdgeEnhance, StringFormat={}{0:0}}" Style="{StaticResource Text.Numeric}" />
                                </Grid>
                                <Slider Minimum="0" Maximum="100" Value="{Binding EdgeEnhance, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,12" />
                            </StackPanel>
                        </Expander>

                        <Button Style="{StaticResource Button.Ghost}" Content="Obnovit doporučené úpravy" Command="{Binding ResetAllCommand}" HorizontalAlignment="Left" />
                        <TextBlock Text="{Binding OriginalDimensionsLabel}" Style="{StaticResource Text.Muted}" Margin="0,8,0,0" />
                    </StackPanel>
                </components:ElevatedBorder>
            </StackPanel>
        </ScrollViewer>

        <!-- Actions -->
        <components:DialogFooter Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="2">
            <Button components:DialogFooter.IsLeading="True" Command="{Binding FrameThisCommand}" Height="{StaticResource Size.Control.Primary}" Padding="16,0">
                <components:IconLabel IconData="{StaticResource Glyph.Frame}" Text="Zkontrolovat oblast" />
            </Button>
            <Button Style="{StaticResource Button.Outline}" Click="OnCancelClick" Height="{StaticResource Size.Control.Primary}" MinWidth="96" Content="Zrušit" />
            <Button IsDefault="True" Style="{StaticResource Button.Primary}" Click="OnImportClick" IsEnabled="{Binding HasJob}" Height="{StaticResource Size.Control.Primary}" Padding="24,0">
                <components:IconLabel IconData="{StaticResource Glyph.Import}" Text="Přidat do návrhu" Foreground="{StaticResource Brush.OnAccent}" />
            </Button>
        </components:DialogFooter>
    </Grid>
    </Grid>
    </Border>
</Window>
