<Window x:Class="Lasero.App.RasterImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:Lasero.App.Converters"
        xmlns:components="clr-namespace:Lasero.App.Components"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Připravit obrázek" Width="1080" Height="720" MinWidth="920" MinHeight="620"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" WindowStyle="None" Background="{StaticResource Brush.Background}" Foreground="{StaticResource Brush.TextPrimary}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:EnumToBooleanConverter x:Key="EnumToBool" />
        <conv:EnumEqualsVisibilityConverter x:Key="EnumEqualsVisibility" />
        <conv:NotNullToVisibilityConverter x:Key="NotNullToVisibility" />
    </Window.Resources>
    <Border Background="{StaticResource Brush.Background}" BorderBrush="{StaticResource Brush.PanelBorderStrong}" BorderThickness="1">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="44" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <components:WindowTitleBar Title="Připravit obrázek" IconData="{StaticResource Glyph.Image}"
                                    CloseButtonName="Zavřít přípravu obrázku" />
    <Grid Grid.Row="1">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="390" /></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="72" /><RowDefinition Height="*" /><RowDefinition Height="64" /></Grid.RowDefinitions>

        <Border Grid.ColumnSpan="2" Background="{StaticResource Brush.Panel}"
                BorderBrush="{StaticResource Brush.PanelBorder}" BorderThickness="0,0,0,1" Padding="24,0">
            <Grid>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Připravit obrázek" FontFamily="{StaticResource Font.Display}" FontSize="{StaticResource Size.Text.Title}" FontWeight="SemiBold" />
                    <TextBlock Text="Nastavte rozměr a vzhled gravírování. Obrázek se automaticky zpracuje v odstínech šedi."
                               Style="{StaticResource Text.Muted}" Margin="0,4,0,0" />
                </StackPanel>
                <Border HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource Badge}" MaxWidth="280">
                    <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                </Border>
            </Grid>
        </Border>

        <!-- Live preview -->
        <Border Grid.Column="0" Grid.Row="1" Background="{StaticResource Brush.Panel}" BorderBrush="{StaticResource Brush.PanelBorder}" BorderThickness="0,0,1,0" Padding="22">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Border Background="{StaticResource Brush.Field}" BorderBrush="{StaticResource Brush.PanelBorder}" BorderThickness="1" CornerRadius="{StaticResource Radius.Lg}">
                    <Grid>
                        <Image Source="{Binding PreviewImageSource}" Stretch="Uniform" Margin="16" RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock Text="Připravuji náhled…" Style="{StaticResource Text.Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding IsPreviewComputing, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>
                </Border>
                <Grid Grid.Row="1" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock FontSize="{StaticResource Size.Text.Meta}" Foreground="{StaticResource Brush.TextSecondary}">
                            <Run Text="Rozměr úlohy: " /><Run Text="{Binding PlannedJob.Bounds.Width, StringFormat={}{0:0.0}, Mode=OneWay}" /><Run Text=" × " /><Run Text="{Binding PlannedJob.Bounds.Height, StringFormat={}{0:0.0}, Mode=OneWay}" /><Run Text=" mm" />
                        </TextBlock>
                        <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Visibility="{Binding StatusMessage, Converter={StaticResource NotNullToVisibility}}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- Settings -->
        <ScrollViewer Grid.Column="1" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,20,20,12">
            <StackPanel>
                <Border Style="{StaticResource InspectorSection}">
                    <StackPanel>
                        <TextBlock Text="Rozměr na pracovní ploše" Style="{StaticResource PanelTitle}" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Šířka (mm)" Style="{StaticResource Text.Muted}" />
                                <TextBox Text="{Binding TargetWidthMm, StringFormat={}{0:0.##}, ValidatesOnExceptions=True, UpdateSourceTrigger=LostFocus}" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Výška (mm)" Style="{StaticResource Text.Muted}" />
                                <TextBox Text="{Binding TargetHeightMm, StringFormat={}{0:0.##}, ValidatesOnExceptions=True, UpdateSourceTrigger=LostFocus}"
                                         IsEnabled="{Binding KeepAspectRatio, Converter={StaticResource InverseBoolConverter}}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>
                        <CheckBox Content="Zachovat poměr stran" IsChecked="{Binding KeepAspectRatio}" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>

                <!--
                    No engraving parameters here. Speed, power, passes and line spacing belong to the
                    layer, which is already the single source of truth for what is sent to GRBL - see
                    SceneObject.BuildRasterOutputOptions, which overrides whatever the import chose with
                    the layer's own values. Asking for them twice meant the operator set numbers that
                    the job then ignored.

                    No tone mode either. Grayscale and threshold were choices about how to turn photo
                    pixels into laser dots, which is not a decision an owner should have to research;
                    Stucki dithering is the right answer for a diode laser at every size, and it was
                    already the default.
                -->
                <Border Style="{StaticResource InspectorSection}">
                    <StackPanel>
                        <TextBlock Text="Vzhled obrázku" Style="{StaticResource PanelTitle}" />
                        <CheckBox Content="Obrátit světlé a tmavé plochy" IsChecked="{Binding Invert}" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource InspectorSection}">
                    <StackPanel>
                        <TextBlock Text="Doladění obrazu" Style="{StaticResource PanelTitle}" />
                        <Border Background="{StaticResource Brush.SelectedSurface}"
                                BorderBrush="{StaticResource Brush.SelectedBorder}"
                                BorderThickness="1" CornerRadius="{StaticResource Radius.Md}" Padding="12">
                            <StackPanel>
                                <TextBlock Text="Automaticky vyladěno" Foreground="{StaticResource Brush.AccentText}" FontWeight="SemiBold" />
                                <TextBlock Text="Fotografie byla lokálně analyzována a připravena pro čisté gravírování. Jas, kontrast, detaily i dithering nastavuje Lasero automaticky."
                                           Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                        <!-- Processing values remain observable and testable, but are intentionally
                             not customer-facing. The local photo analysis owns these decisions. -->
                        <StackPanel Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Jas" Style="{StaticResource Text.Muted}" />
                            <TextBlock Grid.Column="1" Text="{Binding Brightness, StringFormat={}{0:0}}" Style="{StaticResource Text.Numeric}" />
                        </Grid>
                        <Slider Minimum="-100" Maximum="100" Value="{Binding Brightness, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Kontrast" Style="{StaticResource Text.Muted}" />
                            <TextBlock Grid.Column="1" Text="{Binding Contrast, StringFormat={}{0:0}}" Style="{StaticResource Text.Numeric}" />
                        </Grid>
                        <Slider Minimum="-100" Maximum="100" Value="{Binding Contrast, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Doostření" Style="{StaticResource Text.Muted}" />
                            <TextBlock Grid.Column="1" Text="{Binding Sharpen, StringFormat={}{0:0}}" Style="{StaticResource Text.Numeric}" />
                        </Grid>
                        <Slider Minimum="0" Maximum="100" Value="{Binding Sharpen, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,12" />

                        <Expander Header="Pokročilé nastavení">
                            <StackPanel Margin="0,10,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="Gamma" Style="{StaticResource Text.Muted}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Gamma, StringFormat={}{0:0.00}}" Style="{StaticResource Text.Numeric}" />
                                </Grid>
                                <Slider Minimum="0.1" Maximum="3" TickFrequency="0.01" Value="{Binding Gamma, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10" />
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="Expozice" Style="{StaticResource Text.Muted}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Exposure, StringFormat={}{0:0}}" Style="{StaticResource Text.Numeric}" />
                                </Grid>
                                <Slider Minimum="-100" Maximum="100" Value="{Binding Exposure, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10" />
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="Světla" Style="{StaticResource Text.Muted}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Highlights, StringFormat={}{0:0}}" Style="{StaticResource Text.Numeric}" />
                                </Grid>
                                <Slider Minimum="-100" Maximum="0" Value="{Binding Highlights, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10" />
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="Stíny" Style="{StaticResource Text.Muted}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Shadows, StringFormat={}{0:0}}" Style="{StaticResource Text.Numeric}" />
                                </Grid>
                                <Slider Minimum="-100" Maximum="100" Value="{Binding Shadows, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10" />
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="Černý bod" Style="{StaticResource Text.Muted}" />
                                    <TextBlock Grid.Column="1" Text="{Binding BlackPoint, StringFormat={}{0:0}}" Style="{StaticResource Text.Numeric}" />
                                </Grid>
                                <Slider Minimum="0" Maximum="128" Value="{Binding BlackPoint, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10" />
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="Bílý bod" Style="{StaticResource Text.Muted}" />
                                    <TextBlock Grid.Column="1" Text="{Binding WhitePoint, StringFormat={}{0:0}}" Style="{StaticResource Text.Numeric}" />
                                </Grid>
                                <Slider Minimum="128" Maximum="255" Value="{Binding WhitePoint, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10" />
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="Redukce šumu" Style="{StaticResource Text.Muted}" />
                                    <TextBlock Grid.Column="1" Text="{Binding NoiseReduction, StringFormat={}{0:0}}" Style="{StaticResource Text.Numeric}" />
                                </Grid>
                                <Slider Minimum="0" Maximum="100" Value="{Binding NoiseReduction, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10" />
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="Zvýraznění hran" Style="{StaticResource Text.Muted}" />
                                    <TextBlock Grid.Column="1" Text="{Binding EdgeEnhance, StringFormat={}{0:0}}" Style="{StaticResource Text.Numeric}" />
                                </Grid>
                                <Slider Minimum="0" Maximum="100" Value="{Binding EdgeEnhance, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,12" />
                            </StackPanel>
                        </Expander>

                        <TextBlock Text="Dithering" Style="{StaticResource Text.Muted}" Margin="0,12,0,4" />
                        <ComboBox ItemsSource="{Binding DitheringChoices}"
                                  SelectedItem="{Binding SelectedDithering}"
                                  DisplayMemberPath="Label"
                                  ToolTip="{Binding SelectedDithering.Hint}" />
                        <TextBlock Text="{Binding SelectedDithering.Hint}" Style="{StaticResource Text.Muted}"
                                   TextWrapping="Wrap" Margin="0,6,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Actions -->
        <Border Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="2" Background="{StaticResource Brush.TitleBar}" BorderBrush="{StaticResource Brush.PanelBorder}" BorderThickness="0,1,0,0" Padding="22,12">
            <Grid>
                <Button Command="{Binding FrameThisCommand}" HorizontalAlignment="Left" Padding="14,0">
                    <components:IconLabel IconData="{StaticResource Glyph.Frame}" Text="Zkontrolovat oblast" />
                </Button>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Click="OnCancelClick" Margin="0,0,8,0" Padding="16,0">
                        <components:IconLabel IconData="{StaticResource Glyph.Close}" Text="Zrušit" />
                    </Button>
                    <Button IsDefault="True" Style="{StaticResource PrimaryBlue}" Click="OnImportClick" IsEnabled="{Binding HasJob}" Padding="18,0">
                        <components:IconLabel IconData="{StaticResource Glyph.Import}" Text="Přidat do návrhu" Foreground="{StaticResource Brush.OnAccent}" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
    </Grid>
    </Border>
</Window>
