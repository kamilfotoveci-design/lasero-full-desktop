<Window x:Class="Lasero.App.RasterImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:Lasero.App.Converters"
        xmlns:components="clr-namespace:Lasero.App.Components"
        Title="Připravit obrázek" Width="1080" Height="720" MinWidth="920" MinHeight="620"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" Background="{StaticResource Brush.Background}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:EnumToBooleanConverter x:Key="EnumToBool" />
        <conv:EnumEqualsVisibilityConverter x:Key="EnumEqualsVisibility" />
        <conv:NotNullToVisibilityConverter x:Key="NotNullToVisibility" />
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="390" /></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="72" /><RowDefinition Height="*" /><RowDefinition Height="64" /></Grid.RowDefinitions>

        <Border Grid.ColumnSpan="2" Background="{StaticResource Brush.Panel}"
                BorderBrush="{StaticResource Brush.PanelBorder}" BorderThickness="0,0,0,1" Padding="24,0">
            <Grid>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Připravit obrázek" FontFamily="{StaticResource Font.Display}" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock Text="Nastavte rozměr a vzhled gravírování. Obrázek se automaticky zpracuje v odstínech šedi."
                               Style="{StaticResource Text.Muted}" Margin="0,4,0,0" />
                </StackPanel>
                <Border HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource Badge}" MaxWidth="280">
                    <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                </Border>
            </Grid>
        </Border>

        <!-- Live preview -->
        <Border Grid.Column="0" Grid.Row="1" Background="{StaticResource Brush.Panel}" BorderBrush="{StaticResource Brush.PanelBorder}" BorderThickness="0,0,1,0" Padding="22">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Border Background="{StaticResource Brush.Field}" BorderBrush="{StaticResource Brush.PanelBorder}" BorderThickness="1" CornerRadius="12">
                    <Grid>
                        <Image Source="{Binding PreviewImageSource}" Stretch="Uniform" Margin="16" RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock Text="Připravuji náhled…" Style="{StaticResource Text.Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding IsComputing, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>
                </Border>
                <Grid Grid.Row="1" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock FontSize="12" Foreground="{StaticResource Brush.TextSecondary}">
                            <Run Text="Rozměr úlohy: " /><Run Text="{Binding PlannedJob.Bounds.Width, StringFormat={}{0:0.0}, Mode=OneWay}" /><Run Text=" × " /><Run Text="{Binding PlannedJob.Bounds.Height, StringFormat={}{0:0.0}, Mode=OneWay}" /><Run Text=" mm" />
                        </TextBlock>
                        <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Visibility="{Binding StatusMessage, Converter={StaticResource NotNullToVisibility}}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- Settings -->
        <ScrollViewer Grid.Column="1" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,20,20,12">
            <StackPanel>
                <Border Style="{StaticResource InspectorSection}">
                    <StackPanel>
                        <TextBlock Text="Rozměr na pracovní ploše" Style="{StaticResource PanelTitle}" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Šířka (mm)" Style="{StaticResource Text.Muted}" />
                                <TextBox Text="{Binding TargetWidthMm, StringFormat={}{0:0.##}, ValidatesOnExceptions=True, UpdateSourceTrigger=LostFocus}" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Výška (mm)" Style="{StaticResource Text.Muted}" />
                                <TextBox Text="{Binding TargetHeightMm, StringFormat={}{0:0.##}, ValidatesOnExceptions=True, UpdateSourceTrigger=LostFocus}"
                                         IsEnabled="{Binding KeepAspectRatio, Converter={StaticResource InverseBoolConverter}}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>
                        <CheckBox Content="Zachovat poměr stran" IsChecked="{Binding KeepAspectRatio}" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource InspectorSection}">
                    <StackPanel>
                        <TextBlock Text="Parametry gravírování" Style="{StaticResource PanelTitle}" />
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="82" /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Rychlost (mm/min)" Style="{StaticResource Text.Muted}" />
                                <TextBox Text="{Binding FeedRatePerMinute, StringFormat={}{0:0}, ValidatesOnExceptions=True, UpdateSourceTrigger=LostFocus}" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Max. výkon %" Style="{StaticResource Text.Muted}" />
                                <TextBox Text="{Binding MaxPower, StringFormat={}{0:0.#}, ValidatesOnExceptions=True, UpdateSourceTrigger=LostFocus}" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Průchody" Style="{StaticResource Text.Muted}" />
                                <TextBox Text="{Binding Passes, StringFormat={}{0:0}, ValidatesOnExceptions=True, UpdateSourceTrigger=LostFocus}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Rozestup řádků (mm)" Style="{StaticResource Text.Muted}" />
                                <TextBox Text="{Binding LineIntervalMm, StringFormat={}{0:0.###}, ValidatesOnExceptions=True, UpdateSourceTrigger=LostFocus}" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Min. výkon %" Style="{StaticResource Text.Muted}" />
                                <TextBox Text="{Binding MinPower, StringFormat={}{0:0.#}, ValidatesOnExceptions=True, UpdateSourceTrigger=LostFocus}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="Menší rozestup vytvoří hustší gravírování a prodlouží čas úlohy."
                                   Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource InspectorSection}">
                    <StackPanel>
                        <TextBlock Text="Vzhled obrázku" Style="{StaticResource PanelTitle}" />
                        <Border Style="{StaticResource SegmentedTrack}" Margin="0,0,0,12">
                            <UniformGrid Columns="3">
                                <RadioButton Content="Šedá" Style="{StaticResource Segment}" GroupName="Tone" IsChecked="{Binding ToneMode, Converter={StaticResource EnumToBool}, ConverterParameter=Grayscale}" />
                                <RadioButton Content="Černobílá" Style="{StaticResource Segment}" GroupName="Tone" IsChecked="{Binding ToneMode, Converter={StaticResource EnumToBool}, ConverterParameter=Threshold}" />
                                <RadioButton Content="Dithering" Style="{StaticResource Segment}" GroupName="Tone" IsChecked="{Binding ToneMode, Converter={StaticResource EnumToBool}, ConverterParameter=Dither}" />
                            </UniformGrid>
                        </Border>
                        <TextBlock Text="Prahová hodnota" Style="{StaticResource Text.Muted}" Visibility="{Binding ToneMode, Converter={StaticResource EnumEqualsVisibility}, ConverterParameter=Threshold}" />
                        <Slider Minimum="0" Maximum="255" Value="{Binding ThresholdValue}" Visibility="{Binding ToneMode, Converter={StaticResource EnumEqualsVisibility}, ConverterParameter=Threshold}" Margin="0,4,0,0" />
                        <CheckBox Content="Obrátit světlé a tmavé plochy" IsChecked="{Binding Invert}" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource InspectorSection}">
                    <StackPanel>
                        <TextBlock Text="Doladění obrazu" Style="{StaticResource PanelTitle}" />
                        <TextBlock Text="Jas" Style="{StaticResource Text.Muted}" />
                        <Slider Minimum="-255" Maximum="255" Value="{Binding Brightness}" Margin="0,4,0,10" />
                        <TextBlock Text="Kontrast" Style="{StaticResource Text.Muted}" />
                        <Slider Minimum="-255" Maximum="255" Value="{Binding Contrast}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Actions -->
        <Border Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="2" Background="{StaticResource Brush.TitleBar}" BorderBrush="{StaticResource Brush.PanelBorder}" BorderThickness="0,1,0,0" Padding="22,12">
            <Grid>
                <Button Command="{Binding FrameThisCommand}" HorizontalAlignment="Left" Padding="14,0">
                    <components:IconLabel IconData="{StaticResource Glyph.Frame}" Text="Zkontrolovat oblast" />
                </Button>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Click="OnCancelClick" Margin="0,0,8,0" Padding="16,0">
                        <components:IconLabel IconData="{StaticResource Glyph.Close}" Text="Zrušit" />
                    </Button>
                    <Button IsDefault="True" Style="{StaticResource PrimaryBlue}" Click="OnImportClick" IsEnabled="{Binding HasJob}" Padding="18,0">
                        <components:IconLabel IconData="{StaticResource Glyph.Import}" Text="Přidat do návrhu" Foreground="{StaticResource Brush.OnPrimaryAction}" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
