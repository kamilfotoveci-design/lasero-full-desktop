<Window x:Class="Lasero.App.LaseroDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:components="clr-namespace:Lasero.App.Components"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="LASERO" Width="440" SizeToContent="Height" MaxHeight="620"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" Background="{StaticResource Brush.Background}" Foreground="{StaticResource Brush.TextPrimary}">
    <Window.Resources>
        <DataTemplate x:Key="DialogButtonLabelTemplate">
            <TextBlock Text="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Content}"
                       Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                       TextTrimming="CharacterEllipsis" />
        </DataTemplate>
    </Window.Resources>
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="38" ResizeBorderThickness="0" CornerRadius="{StaticResource Radius.Lg}" GlassFrameThickness="0" />
    </shell:WindowChrome.WindowChrome>

    <Border x:Name="DialogSurface" Background="{StaticResource Brush.Panel}" BorderBrush="{StaticResource Brush.PanelBorder}"
            BorderThickness="1" CornerRadius="{StaticResource Radius.Lg}" Effect="{StaticResource Shadow.Modal}"
            RenderTransformOrigin="0.5,0.5" Opacity="0">
            <Border.RenderTransform>
                <!-- Motion.Dialog (160 ms) fade and 0.98 to 1 scale run from code behind, which also checks the Windows animation preference. -->
                <TransformGroup>
                    <ScaleTransform x:Name="DialogScale" ScaleX="0.98" ScaleY="0.98" />
                    <TranslateTransform x:Name="DialogOffset" Y="4" />
                </TransformGroup>
            </Border.RenderTransform>
        <!-- Clipped to the surface's rounded inner edge: the footer band used to carry a literal 0,0,8,8 radius to fake
             it, which never matched the 12px surface (a token composite cannot subtract the border). -->
        <Grid components:RoundedClip.ToParentBorder="True">
            <Grid.RowDefinitions><RowDefinition Height="38" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

            <Border BorderBrush="{StaticResource Brush.PanelBorder}" BorderThickness="0,0,0,1" Padding="16,0">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="LASERO" FontFamily="{StaticResource Font.Display}" FontSize="{StaticResource Size.Text.Meta}" FontWeight="SemiBold" />
                    </StackPanel>
                    <Button HorizontalAlignment="Right" Width="32" Height="32" Style="{StaticResource Button.ChromeClose}"
                            Click="OnCancelClick" shell:WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Zavřít">
                        <components:IconGlyph IconData="{StaticResource Glyph.Close}" Width="{StaticResource Size.Icon.Chrome}" Height="{StaticResource Size.Icon.Chrome}" />
                    </Button>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="24">
                <Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border x:Name="IconSurface" Width="36" Height="36" CornerRadius="{StaticResource Radius.Pill}" VerticalAlignment="Top"
                        Background="{StaticResource Brush.InfoMuted}">
                    <components:IconGlyph x:Name="DialogIcon" IconData="{StaticResource Glyph.Info}" Width="{StaticResource Size.Icon.Md}" Height="{StaticResource Size.Icon.Md}"
                                          Foreground="{StaticResource Brush.Info}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                    <TextBlock x:Name="TitleText" FontFamily="{StaticResource Font.Display}" FontSize="{StaticResource Size.Text.Section}" FontWeight="SemiBold"
                               Foreground="{StaticResource Brush.TextPrimary}" TextWrapping="Wrap" />
                    <TextBlock x:Name="MessageText" Margin="0,8,0,0" FontSize="{StaticResource Size.Text.Body}" LineHeight="20"
                               Foreground="{StaticResource Brush.TextSecondary}" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>

            <components:DialogFooter Grid.Row="2">
                <Button x:Name="CancelButton" Style="{StaticResource Button.Outline}" Click="OnCancelClick" MinWidth="88" Height="{StaticResource Size.Control.Primary}"
                        ContentTemplate="{StaticResource DialogButtonLabelTemplate}" />
                <Button x:Name="SecondaryButton" Style="{StaticResource Button.Outline}" Click="OnSecondaryClick" MinWidth="104" Height="{StaticResource Size.Control.Primary}"
                        ContentTemplate="{StaticResource DialogButtonLabelTemplate}" />
                <Button x:Name="PrimaryButton" Style="{StaticResource Button.Primary}" Click="OnPrimaryClick" MinWidth="120" Height="{StaticResource Size.Control.Primary}" IsDefault="True"
                        ContentTemplate="{StaticResource DialogButtonLabelTemplate}" />
            </components:DialogFooter>
        </Grid>
    </Border>
</Window>
