<UserControl x:Class="Lasero.App.Components.FormField"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root" Focusable="False">
    <!-- Label above (Meta, muted), 8 px, the control, then helper text below at 4 px. Fields in a form are 16 apart. -->
    <StackPanel>
        <TextBlock Text="{Binding Label, ElementName=Root}" Style="{StaticResource FieldLabel}" Margin="0,0,0,8" TextWrapping="Wrap" />
        <ContentPresenter Content="{Binding Field, ElementName=Root}" />
        <TextBlock x:Name="HelperText" Text="{Binding Helper, ElementName=Root}" Style="{StaticResource Text.Muted}"
                   FontSize="{StaticResource Size.Text.Meta}" Margin="0,4,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
    </StackPanel>
</UserControl>
