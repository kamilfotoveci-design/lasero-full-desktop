<UserControl x:Class="Lasero.App.Components.ProjectThumbCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Lasero.App.Converters"
             xmlns:components="clr-namespace:Lasero.App.Components"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             x:Name="Root">
    <!--
        Home's "pokračovat v práci" card: a 140px preview over a 66px caption, 220 tall in total.
        DataContext is a RecentProjectItemViewModel; OpenCommand/RemoveCommand are dependency
        properties because they belong to HomeViewModel, not to the row.

        The metadata line says only what the recent-projects log actually knows — when the file was
        last written and how big it is. Physical dimensions and material are not recorded per project,
        so this card does not claim them.
    -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
        <conv:ThumbnailPathToImageSourceConverter x:Key="ThumbnailToImage" />
    </UserControl.Resources>

    <Border x:Name="Surface" Height="220" Cursor="Hand"
            Background="{DynamicResource Brush.Panel}"
            BorderBrush="{DynamicResource Brush.PanelBorder}" BorderThickness="1"
            CornerRadius="{StaticResource Radius.Lg}" ClipToBounds="True"
            Tag="{Binding ElementName=Root}"
            ToolTip="{Binding Path}"
            automation:AutomationProperties.Name="{Binding Name}">
        <Border.Style>
            <Style TargetType="Border">
                <Style.Triggers>
                    <!-- The mockup marks hover with the accent border rather than a lift; the theme
                         forbids shadows for depth, so this is the whole hover state. -->
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Border.InputBindings>
            <MouseBinding MouseAction="LeftClick"
                          Command="{Binding OpenCommand, ElementName=Root}"
                          CommandParameter="{Binding Entry}" />
        </Border.InputBindings>

        <Border.ContextMenu>
            <ContextMenu>
                <MenuItem Header="Otevřít projekt"
                          Command="{Binding PlacementTarget.Tag.OpenCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                          CommandParameter="{Binding Entry}" />
                <MenuItem Header="Odebrat ze seznamu"
                          Command="{Binding PlacementTarget.Tag.RemoveCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                          CommandParameter="{Binding Entry}" />
            </ContextMenu>
        </Border.ContextMenu>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="140" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Preview well. The dotted wash is what the mockup puts behind a thumbnail-less card;
                 a rendered thumbnail covers it whenever there is one. -->
            <Grid Grid.Row="0" Background="{DynamicResource Brush.PanelRaised}">
                <!-- Tiled dot field, drawn over the flat well rather than as its background so the
                     two layers do not compete for the same property. -->
                <Rectangle Opacity="0.5">
                    <Rectangle.Fill>
                        <DrawingBrush TileMode="Tile" Viewport="0,0,10,10" ViewportUnits="Absolute"
                                      Stretch="None" AlignmentX="Left" AlignmentY="Top">
                            <DrawingBrush.Drawing>
                                <GeometryDrawing Brush="{DynamicResource Brush.PanelBorderStrong}">
                                    <GeometryDrawing.Geometry>
                                        <EllipseGeometry Center="1,1" RadiusX="1" RadiusY="1" />
                                    </GeometryDrawing.Geometry>
                                </GeometryDrawing>
                            </DrawingBrush.Drawing>
                        </DrawingBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <components:IconGlyph IconData="{StaticResource Glyph.Project}"
                                      Width="{StaticResource Size.Icon.Xxl}" Height="{StaticResource Size.Icon.Xxl}"
                                      Foreground="{DynamicResource Brush.PanelBorderStrong}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Visibility="{Binding HasThumbnail, Converter={StaticResource InverseBoolToVisibility}}" />

                <Border Background="{DynamicResource Brush.Panel}"
                        Visibility="{Binding HasThumbnail, Converter={StaticResource BoolToVisibility}}">
                    <Image Source="{Binding ThumbnailPath, Converter={StaticResource ThumbnailToImage}}"
                           Stretch="Uniform" Margin="10"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                </Border>
            </Grid>

            <Border Grid.Row="1" BorderBrush="{DynamicResource Brush.PanelBorder}" BorderThickness="0,1,0,0"
                    Background="{DynamicResource Brush.Panel}" Padding="12,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="{Binding Name}" FontWeight="Medium"
                               TextTrimming="CharacterEllipsis" />

                    <Grid Grid.Row="1" Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding ModifiedText}" Style="{StaticResource Text.Muted}"
                                   TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                        <TextBlock Grid.Column="1" Text="{Binding SizeText}" Style="{StaticResource Text.Muted}" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
