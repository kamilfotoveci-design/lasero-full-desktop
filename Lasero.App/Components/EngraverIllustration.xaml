<UserControl x:Class="Lasero.App.Components.EngraverIllustration"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False" IsHitTestVisible="False" SnapsToDevicePixels="False"
             Width="200" Height="140">
    <!--
        Large outline of a portal diode engraver: frame, gantry beam, laser head over the bed, and a
        sheet of material. One 2 px stroke, graphite for the machine and muted grey for the material
        and the beam guide. It illustrates the device card; it carries no state, so it never implies a
        connection. Red stays reserved for things that are on.
    -->
    <Viewbox Stretch="Uniform">
        <Canvas Width="200" Height="140">
            <Canvas.Resources>
                <Style TargetType="Path">
                    <Setter Property="Fill" Value="Transparent" />
                    <Setter Property="Stroke" Value="{DynamicResource Brush.TextPrimary}" />
                    <Setter Property="StrokeThickness" Value="2" />
                    <Setter Property="StrokeStartLineCap" Value="Round" />
                    <Setter Property="StrokeEndLineCap" Value="Round" />
                    <Setter Property="StrokeLineJoin" Value="Round" />
                </Style>
            </Canvas.Resources>

            <!-- Bed -->
            <Path Data="M25 104 H175 A5 5 0 0 1 180 109 V113 A5 5 0 0 1 175 118 H25 A5 5 0 0 1 20 113 V109 A5 5 0 0 1 25 104 Z" />
            <!-- Posts -->
            <Path Data="M28 104 V38.5 A4.5 4.5 0 0 1 37 38.5 V104" />
            <Path Data="M163 104 V38.5 A4.5 4.5 0 0 1 172 38.5 V104" />
            <!-- Gantry beam -->
            <Path Data="M33 34 H167 A5 5 0 0 1 167 44 H33 A5 5 0 0 1 33 34 Z" />
            <!-- Laser head and nozzle -->
            <Path Data="M87 44 V61 A5 5 0 0 0 92 66 H108 A5 5 0 0 0 113 61 V44" />
            <Path Data="M100 66 V74" />
            <!-- Beam guide and material: secondary, so they step back -->
            <Path Data="M100 81 V94" Stroke="{DynamicResource Brush.PanelBorderStrong}" StrokeDashArray="1.5 3" />
            <Path Data="M58 104 V99 A2 2 0 0 1 60 97 H140 A2 2 0 0 1 142 99 V104"
                  Stroke="{DynamicResource Brush.PanelBorderStrong}" />
        </Canvas>
    </Viewbox>
</UserControl>
