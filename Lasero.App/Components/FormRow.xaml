<UserControl x:Class="Lasero.App.Components.FormRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root" Focusable="False">
    <!--
        A read-only label and value pair on one row: the label is muted (Meta, left), the value is Body Medium, right aligned,
        and both are centred in one 32 px row so a list of them has an even rhythm. A hairline below is optional (ShowRule).
    -->
    <Border x:Name="Rule" BorderBrush="{StaticResource Brush.PanelBorder}" BorderThickness="0">
        <Grid MinHeight="32">
            <TextBlock Text="{Binding Label, ElementName=Root}" Style="{StaticResource FieldLabel}" Margin="0"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" HorizontalAlignment="Left" />
            <ContentPresenter Content="{Binding Value, ElementName=Root}" HorizontalAlignment="Right" VerticalAlignment="Center">
                <ContentPresenter.Resources>
                    <Style TargetType="TextBlock">
                        <Setter Property="FontSize" Value="{StaticResource Size.Text.Body}" />
                        <Setter Property="FontWeight" Value="Medium" />
                        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                    </Style>
                </ContentPresenter.Resources>
            </ContentPresenter>
        </Grid>
    </Border>
</UserControl>
