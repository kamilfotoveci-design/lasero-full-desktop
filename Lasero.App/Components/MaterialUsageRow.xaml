<UserControl x:Class="Lasero.App.Components.MaterialUsageRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:components="clr-namespace:Lasero.App.Components"
             x:Name="Root">
    <!-- One row of Home's material list: icon tile, name, and a chip carrying the usage fact. The
         chip deliberately holds "how often / how recently" and not speed/power — job history records
         the material a job ran on, never the parameters it ran with. -->
    <Border x:Name="Surface" Background="Transparent" Padding="12,10">
        <Border.Style>
            <Style TargetType="Border">
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource Brush.PanelRaised}" />
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Width="32" Height="32" CornerRadius="{StaticResource Radius.Sm}"
                    Background="{DynamicResource Brush.Field}" VerticalAlignment="Center">
                <components:IconGlyph IconData="{StaticResource Glyph.Materials}"
                                      Width="{StaticResource Size.Icon.Md}" Height="{StaticResource Size.Icon.Md}"
                                      Foreground="{DynamicResource Brush.TextSecondary}" />
            </Border>

            <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center"
                       Margin="12,0,12,0" TextTrimming="CharacterEllipsis" />

            <Border Grid.Column="2" Background="{DynamicResource Brush.Field}"
                    CornerRadius="{StaticResource Radius.Xs}" Padding="8,4" VerticalAlignment="Center">
                <TextBlock Text="{Binding UsageLabel}" Style="{StaticResource Text.Muted}" />
            </Border>
        </Grid>
    </Border>
</UserControl>
