<UserControl x:Class="Lasero.App.Components.SectionHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:components="clr-namespace:Lasero.App.Components"
             x:Name="Root" Focusable="False">
    <!--
        The one section heading. Level Page is a screen section ("Pokračovat v práci", Size.Text.Heading 21), Level Card
        is a card or panel title (Size.Text.Section 17). Both keep a 32 px row so a trailing link or an icon tile never
        changes the baseline, and both leave the same gap to the content below (16 for a page section, 12 for a card).
        Icon is optional and always a 28 px IconTile, never a bare glyph.
    -->
    <Grid x:Name="Row" MinHeight="32">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <components:IconTile x:Name="Tile" IconData="{Binding IconData, ElementName=Root}" Tone="{Binding Tone, ElementName=Root}"
                             VerticalAlignment="Center" Margin="0,0,12,0" Visibility="Collapsed" />
        <TextBlock x:Name="TitleText" Grid.Column="1" Text="{Binding Title, ElementName=Root}" VerticalAlignment="Center"
                   TextWrapping="Wrap" AutomationProperties.HeadingLevel="Level2" Margin="0" />
        <ContentPresenter Grid.Column="2" Content="{Binding Action, ElementName=Root}" VerticalAlignment="Center" Margin="8,0,0,0" />
    </Grid>
</UserControl>
