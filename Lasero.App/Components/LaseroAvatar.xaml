<UserControl x:Class="Lasero.App.Components.LaseroAvatar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             Width="{Binding Size, ElementName=Root}"
             Height="{Binding Size, ElementName=Root}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             Focusable="False">
    <!-- One canonical artwork and one rendering path for every avatar size in LASERO. The shared
         BitmapImage is decoded once and cached; WPF performs the final DPI-aware downsample here. -->
    <Image Source="{StaticResource Image.LaseroAvatarSource}"
           Width="{Binding Size, ElementName=Root}"
           Height="{Binding Size, ElementName=Root}"
           Stretch="Uniform"
           HorizontalAlignment="Center"
           VerticalAlignment="Center"
           SnapsToDevicePixels="True"
           RenderOptions.BitmapScalingMode="HighQuality" />
</UserControl>
