<UserControl x:Class="Lasero.App.Components.ProcessStatusCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:components="clr-namespace:Lasero.App.Components"
             xmlns:conv="clr-namespace:Lasero.App.Converters"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             x:Name="Root">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:NotNullToVisibilityConverter x:Key="NotNullToVisibility" />

        <!--
            Status drives four things and no more: the chip's tint, the chip's glyph colour, the
            default glyph, and the progress bar's fill. The card body stays a normal panel at every
            status — a whole card flooded with green or red is how a status surface stops being
            readable, and it is the one thing the palette rules out explicitly.
        -->
        <Style x:Key="StatusChip" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.Field}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status, ElementName=Root}" Value="{x:Static components:ProcessStatus.Progress}">
                    <Setter Property="Background" Value="{DynamicResource Brush.InfoMuted}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status, ElementName=Root}" Value="{x:Static components:ProcessStatus.Success}">
                    <Setter Property="Background" Value="{DynamicResource Brush.SuccessMuted}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status, ElementName=Root}" Value="{x:Static components:ProcessStatus.Warning}">
                    <Setter Property="Background" Value="{DynamicResource Brush.WarningMuted}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status, ElementName=Root}" Value="{x:Static components:ProcessStatus.Error}">
                    <Setter Property="Background" Value="{DynamicResource Brush.DangerMuted}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StatusGlyph" TargetType="components:IconGlyph">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
            <Setter Property="IconData" Value="{DynamicResource Glyph.Info}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status, ElementName=Root}" Value="{x:Static components:ProcessStatus.Waiting}">
                    <Setter Property="IconData" Value="{DynamicResource Glyph.Clock}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status, ElementName=Root}" Value="{x:Static components:ProcessStatus.Progress}">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.AccentText}" />
                    <Setter Property="IconData" Value="{DynamicResource Glyph.Refresh}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status, ElementName=Root}" Value="{x:Static components:ProcessStatus.Success}">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Success}" />
                    <Setter Property="IconData" Value="{DynamicResource Glyph.Check}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status, ElementName=Root}" Value="{x:Static components:ProcessStatus.Warning}">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Warning}" />
                    <Setter Property="IconData" Value="{DynamicResource Glyph.Warning}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status, ElementName=Root}" Value="{x:Static components:ProcessStatus.Error}">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                    <Setter Property="IconData" Value="{DynamicResource Glyph.Close}" />
                </DataTrigger>
                <!-- An explicitly supplied glyph always wins: it usually says something the status
                     alone cannot, like USB versus a machine versus a work area. -->
                <DataTrigger Binding="{Binding IconData, ElementName=Root, Converter={StaticResource NotNullToVisibility}}" Value="Visible">
                    <Setter Property="IconData" Value="{Binding IconData, ElementName=Root}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ProgressFill" TargetType="ProgressBar">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status, ElementName=Root}" Value="{x:Static components:ProcessStatus.Success}">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Success}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status, ElementName=Root}" Value="{x:Static components:ProcessStatus.Warning}">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Warning}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status, ElementName=Root}" Value="{x:Static components:ProcessStatus.Error}">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Compact drops the card's own frame and tightens the padding, for use inside a panel that
             already has a border. Same content, same states — nothing is hidden. -->
        <Style x:Key="CardSurface" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.Panel}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.PanelBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource Radius.Lg}" />
            <Setter Property="Padding" Value="16" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Compact, ElementName=Root}" Value="True">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Padding" Value="0" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Border Style="{StaticResource CardSurface}">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Width="34" Height="34" CornerRadius="{StaticResource Radius.Md}"
                        VerticalAlignment="Top" Margin="0,0,12,0"
                        Style="{StaticResource StatusChip}">
                    <components:IconGlyph Style="{StaticResource StatusGlyph}"
                                          Width="{StaticResource Size.Icon.Md}" Height="{StaticResource Size.Icon.Md}" />
                </Border>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Title, ElementName=Root}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Description, ElementName=Root}" Style="{StaticResource Text.Muted}"
                               TextWrapping="Wrap" Margin="0,3,0,0"
                               Visibility="{Binding Description, ElementName=Root, Converter={StaticResource NotNullToVisibility}}" />
                </StackPanel>

                <Button Grid.Column="2" Style="{StaticResource Button.GhostIcon}" VerticalAlignment="Top"
                        Command="{Binding DismissCommand, ElementName=Root}"
                        automation:AutomationProperties.Name="Skrýt"
                        Visibility="{Binding DismissCommand, ElementName=Root, Converter={StaticResource NotNullToVisibility}}">
                    <components:IconGlyph IconData="{StaticResource Glyph.Close}"
                                          Width="{StaticResource Size.Icon.Sm}" Height="{StaticResource Size.Icon.Sm}" />
                </Button>
            </Grid>

            <!-- Indeterminate when there is no percentage to report. Reporting a made-up number
                 would be worse than admitting the app cannot see how far along the machine is. -->
            <ProgressBar Height="4" Margin="0,12,0,0"
                         Style="{StaticResource ProgressFill}"
                         Minimum="0" Maximum="100"
                         Value="{Binding ProgressValue, ElementName=Root, Mode=OneWay}"
                         IsIndeterminate="{Binding IsProgressIndeterminate, ElementName=Root}"
                         Visibility="{Binding ShowsProgress, ElementName=Root, Converter={StaticResource BoolToVisibility}}" />

            <ContentPresenter Content="{Binding Meta, ElementName=Root}" Margin="0,12,0,0"
                              Visibility="{Binding Meta, ElementName=Root, Converter={StaticResource NotNullToVisibility}}" />

            <StackPanel Orientation="Horizontal" Margin="0,14,0,0"
                        Visibility="{Binding HasActions, ElementName=Root, Converter={StaticResource BoolToVisibility}}">
                <Button Command="{Binding PrimaryCommand, ElementName=Root}"
                        Content="{Binding PrimaryLabel, ElementName=Root}"
                        Margin="0,0,8,0"
                        Visibility="{Binding PrimaryLabel, ElementName=Root, Converter={StaticResource NotNullToVisibility}}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource Button.Primary}">
                            <Style.Triggers>
                                <!-- Stop, abort, disconnect: the one place red belongs on a status card. -->
                                <DataTrigger Binding="{Binding PrimaryIsDanger, ElementName=Root}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource Brush.Danger}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Danger}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Command="{Binding SecondaryCommand, ElementName=Root}"
                        Content="{Binding SecondaryLabel, ElementName=Root}"
                        Visibility="{Binding SecondaryLabel, ElementName=Root, Converter={StaticResource NotNullToVisibility}}" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
