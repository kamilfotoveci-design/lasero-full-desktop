<UserControl x:Class="Lasero.App.Components.ProjectCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Lasero.App.Converters"
             xmlns:components="clr-namespace:Lasero.App.Components"
             x:Name="Root">
    <!-- DataContext (set by the consumer's ItemsControl) is the RecentProjectEntry itself — Name/
         ThumbnailPath/LastOpenedUtc bind straight off it. OpenCommand/RemoveCommand are dependency
         properties because they belong to the owning view model (HomeViewModel), not the entry. -->
    <UserControl.Resources>
        <conv:ThumbnailPathToImageSourceConverter x:Key="ThumbnailToImage" />
        <conv:UtcToLocalConverter x:Key="UtcToLocal" />
    </UserControl.Resources>
    <components:ElevatedBorder Style="{StaticResource ThumbnailCard.Clickable}" Padding="10" Cursor="Hand" RenderTransformOrigin="0.5,0.5">
        <components:ElevatedBorder.RenderTransform><TranslateTransform x:Name="Lift" /></components:ElevatedBorder.RenderTransform>
        <components:ElevatedBorder.Triggers>
            <EventTrigger RoutedEvent="UIElement.MouseEnter">
                <BeginStoryboard><Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Lift" Storyboard.TargetProperty="Y" To="-1" Duration="{StaticResource Motion.Hover}" EasingFunction="{StaticResource Ease.Out}" />
                </Storyboard></BeginStoryboard>
            </EventTrigger>
            <EventTrigger RoutedEvent="UIElement.MouseLeave">
                <BeginStoryboard><Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Lift" Storyboard.TargetProperty="Y" To="0" Duration="{StaticResource Motion.Hover}" EasingFunction="{StaticResource Ease.Out}" />
                </Storyboard></BeginStoryboard>
            </EventTrigger>
        </components:ElevatedBorder.Triggers>
        <Border.InputBindings>
            <MouseBinding MouseAction="LeftClick" Command="{Binding OpenCommand, ElementName=Root}" CommandParameter="{Binding}" />
        </Border.InputBindings>
        <StackPanel>
            <Grid Height="100" Margin="0,0,0,10">
                <Border CornerRadius="{StaticResource Radius.Md}" Background="{DynamicResource Brush.Field}" BorderBrush="{DynamicResource Brush.PanelBorder}" BorderThickness="1">
                    <components:IconGlyph IconData="{StaticResource Glyph.Project}" Width="{StaticResource Size.Icon.Xl}" Height="{StaticResource Size.Icon.Xl}" Foreground="{DynamicResource Brush.TextSecondary}" />
                </Border>
                <Border CornerRadius="{StaticResource Radius.Md}" Background="White" BorderBrush="{DynamicResource Brush.PanelBorder}" BorderThickness="1">
                    <Image Source="{Binding ThumbnailPath, Converter={StaticResource ThumbnailToImage}}" Stretch="Uniform" Margin="6" />
                </Border>
                <Button Width="32" Height="32" Padding="8" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="4" Style="{StaticResource Button.Icon}"
                        Command="{Binding RemoveCommand, ElementName=Root}" CommandParameter="{Binding}"
                        ToolTip="Odebrat ze seznamu" AutomationProperties.Name="Odebrat ze seznamu">
                    <components:IconGlyph IconData="{StaticResource Glyph.Close}" Width="{StaticResource Size.Icon.Chrome}" Height="{StaticResource Size.Icon.Chrome}" />
                </Button>
            </Grid>
            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding LastOpenedUtc, Converter={StaticResource UtcToLocal}, StringFormat='dd.MM.yyyy HH:mm'}" Style="{StaticResource Text.Muted}" Margin="0,2,0,0" />
        </StackPanel>
    </components:ElevatedBorder>
</UserControl>
