<UserControl x:Class="Lasero.App.Components.EmptyState"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Lasero.App.Converters"
             xmlns:components="clr-namespace:Lasero.App.Components"
             x:Name="Root">
    <UserControl.Resources>
        <conv:NotNullToVisibilityConverter x:Key="NotNullToVisibility" />
    </UserControl.Resources>
    <StackPanel HorizontalAlignment="Left">
        <components:IconGlyph IconData="{Binding IconPrimaryData, ElementName=Root}" Width="{StaticResource Size.Icon.Xl}" Height="{StaticResource Size.Icon.Xl}" Margin="0,0,0,10" HorizontalAlignment="Left" Foreground="{DynamicResource Brush.TextSecondary}" />
        <TextBlock Text="{Binding Title, ElementName=Root}" FontWeight="SemiBold" Margin="0,0,0,4" />
        <TextBlock Text="{Binding Description, ElementName=Root}" Style="{StaticResource Text.Muted}" TextWrapping="Wrap" FontSize="{StaticResource Size.Text.Meta}" />
        <Button Content="{Binding CtaText, ElementName=Root}"
                Command="{Binding CtaCommand, ElementName=Root}"
                CommandParameter="{Binding CtaCommandParameter, ElementName=Root}"
                Visibility="{Binding CtaText, ElementName=Root, Converter={StaticResource NotNullToVisibility}}"
                HorizontalAlignment="Left" Margin="0,12,0,0" />
    </StackPanel>
</UserControl>
