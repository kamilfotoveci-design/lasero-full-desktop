<UserControl x:Class="Lasero.App.Components.StatusBadge"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Lasero.App.Converters"
             x:Name="Root">
    <UserControl.Resources>
        <conv:BooleanToConnectionBrushConverter x:Key="ConnectedToBrush" />
    </UserControl.Resources>
    <Border Background="{DynamicResource Brush.Field}" BorderBrush="{DynamicResource Brush.PanelBorder}" BorderThickness="1" CornerRadius="7" Padding="10,6">
        <StackPanel Orientation="Horizontal">
            <Ellipse Width="8" Height="8" Fill="{Binding IsConnected, ElementName=Root, Converter={StaticResource ConnectedToBrush}}" Margin="0,0,7,0" VerticalAlignment="Center" />
            <TextBlock Text="{Binding StatusText, ElementName=Root}" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="11" VerticalAlignment="Center" />
        </StackPanel>
    </Border>
</UserControl>
