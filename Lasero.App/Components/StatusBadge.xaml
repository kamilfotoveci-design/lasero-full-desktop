<UserControl x:Class="Lasero.App.Components.StatusBadge"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:components="clr-namespace:Lasero.App.Components"
             xmlns:conv="clr-namespace:Lasero.App.Converters"
             x:Name="Root">
    <UserControl.Resources>
        <conv:NotNullToVisibilityConverter x:Key="NotNullToVisibility" />
    </UserControl.Resources>
    <!--
        One state pill for the whole product: connection, job run state, device panels. Tinted
        surface plus a dot or a glyph plus a label, at pill geometry — no border, because a pill sitting on a
        panel that already has one reads as a control you can press.

        Kind is the only input for colour. Callers that hold a bool or a JobRunState convert to a
        Kind, so there is never a second way to say the same thing.

        IconData is optional and exists because colour alone is not a statement: where the caller has
        a glyph that distinguishes the state by shape — connected versus disconnected, a warning
        triangle — it replaces the dot, so state is told by shape, word and colour together.
    -->
    <Border x:Name="Surface"
            CornerRadius="{StaticResource Radius.Sm}"
            Padding="8,0,10,0"
            Height="26"
            VerticalAlignment="Center">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource Brush.Field}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Kind, ElementName=Root}" Value="{x:Static components:StatePillKind.Ready}">
                        <Setter Property="Background" Value="{DynamicResource Brush.SuccessMuted}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Kind, ElementName=Root}" Value="{x:Static components:StatePillKind.Busy}">
                        <Setter Property="Background" Value="{DynamicResource Brush.SelectedSurface}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Kind, ElementName=Root}" Value="{x:Static components:StatePillKind.Warning}">
                        <Setter Property="Background" Value="{DynamicResource Brush.WarningMuted}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Kind, ElementName=Root}" Value="{x:Static components:StatePillKind.Error}">
                        <Setter Property="Background" Value="{DynamicResource Brush.DangerMuted}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <components:IconGlyph IconData="{Binding IconData, ElementName=Root}"
                                  Width="{StaticResource Size.Icon.Sm}" Height="{StaticResource Size.Icon.Sm}"
                                  Margin="0,0,6,0" VerticalAlignment="Center"
                                  Visibility="{Binding IconData, ElementName=Root, Converter={StaticResource NotNullToVisibility}}">
                <components:IconGlyph.Style>
                    <Style TargetType="components:IconGlyph">
                        <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Kind, ElementName=Root}" Value="{x:Static components:StatePillKind.Ready}">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Success}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind, ElementName=Root}" Value="{x:Static components:StatePillKind.Busy}">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind, ElementName=Root}" Value="{x:Static components:StatePillKind.Warning}">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Warning}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind, ElementName=Root}" Value="{x:Static components:StatePillKind.Error}">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </components:IconGlyph.Style>
            </components:IconGlyph>

            <Ellipse Width="7" Height="7" Margin="0,0,7,0" VerticalAlignment="Center"
                     Visibility="{Binding IconData, ElementName=Root, Converter={StaticResource NotNullToVisibility}, ConverterParameter=Invert}">
                <Ellipse.Style>
                    <Style TargetType="Ellipse">
                        <Setter Property="Fill" Value="{DynamicResource Brush.PanelBorderStrong}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Kind, ElementName=Root}" Value="{x:Static components:StatePillKind.Ready}">
                                <Setter Property="Fill" Value="{DynamicResource Brush.Success}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind, ElementName=Root}" Value="{x:Static components:StatePillKind.Busy}">
                                <Setter Property="Fill" Value="{DynamicResource Brush.Accent}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind, ElementName=Root}" Value="{x:Static components:StatePillKind.Warning}">
                                <Setter Property="Fill" Value="{DynamicResource Brush.Warning}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind, ElementName=Root}" Value="{x:Static components:StatePillKind.Error}">
                                <Setter Property="Fill" Value="{DynamicResource Brush.Danger}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Ellipse.Style>
            </Ellipse>

            <TextBlock Text="{Binding StatusText, ElementName=Root}"
                       FontSize="{StaticResource Size.Text.Meta}"
                       FontWeight="Medium"
                       VerticalAlignment="Center">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Kind, ElementName=Root}" Value="{x:Static components:StatePillKind.Ready}">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Success}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind, ElementName=Root}" Value="{x:Static components:StatePillKind.Busy}">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind, ElementName=Root}" Value="{x:Static components:StatePillKind.Warning}">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Warning}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind, ElementName=Root}" Value="{x:Static components:StatePillKind.Error}">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>
    </Border>
</UserControl>
