<UserControl x:Class="Lasero.App.Components.IconGlyph"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root" Focusable="False" IsHitTestVisible="False"
             SnapsToDevicePixels="True">
    <!--
        The existing outline vocabulary and filled artwork share this renderer. The Fluent Regular
        resources attach size-specific 16/20/24 geometry metadata, which IconGlyph resolves without
        changing the semantic Glyph key at its call sites. Existing Phosphor and customer-supplied
        filled art continues to use explicit IsFilled/GridSize. Other icons keep the 24px stroke path.
    -->
    <Viewbox Stretch="Uniform">
        <Canvas Width="{Binding ResolvedGridSize, ElementName=Root}" Height="{Binding ResolvedGridSize, ElementName=Root}">
            <Path Data="{Binding ResolvedIconData, ElementName=Root}">
                <Path.Style>
                    <Style TargetType="Path">
                        <Setter Property="Fill" Value="Transparent" />
                        <Setter Property="Stroke" Value="{Binding Foreground, ElementName=Root}" />
                        <Setter Property="StrokeThickness" Value="{StaticResource Size.Icon.Stroke}" />
                        <Setter Property="StrokeStartLineCap" Value="Round" />
                        <Setter Property="StrokeEndLineCap" Value="Round" />
                        <Setter Property="StrokeLineJoin" Value="Round" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ResolvedIsFilled, ElementName=Root}" Value="True">
                                <Setter Property="Fill" Value="{Binding Foreground, ElementName=Root}" />
                                <Setter Property="Stroke" Value="{x:Null}" />
                                <Setter Property="StrokeThickness" Value="0" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Path.Style>
            </Path>
        </Canvas>
    </Viewbox>
</UserControl>
