<UserControl x:Class="Lasero.App.Components.IconGlyph"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root" Focusable="False" IsHitTestVisible="False"
             SnapsToDevicePixels="True">
    <Viewbox Stretch="Uniform">
        <Canvas Width="24" Height="24">
            <Path Data="{Binding IconData, ElementName=Root}"
                  Stroke="{Binding Foreground, ElementName=Root}"
                  StrokeThickness="{StaticResource Size.Icon.Stroke}"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round"
                  StrokeLineJoin="Round"
                  Fill="Transparent" />
        </Canvas>
    </Viewbox>
</UserControl>
