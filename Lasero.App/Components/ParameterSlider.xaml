<UserControl x:Class="Lasero.App.Components.ParameterSlider"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             x:Name="Root">
    <!--
        A process parameter: label, an always-editable numeric field with its unit, and a slider
        underneath. The slider is a convenience for finding a value quickly; the field is the source
        of truth, because a power or a feed rate is a number the operator has to be able to type
        exactly. Both drive the same bound property, so they can never disagree.
    -->
    <UserControl.Resources>
        <!-- The stock WPF slider draws Aero chrome that belongs to no part of this product. A quiet
             4px track and a small instrument-like thumb keep the control precise rather than web-like. -->
        <Style x:Key="ParameterValue.Input" TargetType="TextBox" BasedOn="{StaticResource UnitField.Input}">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
            <Setter Property="TextOptions.TextHintingMode" Value="Fixed" />
        </Style>

        <Style x:Key="Slider.Parameter" TargetType="Slider" BasedOn="{StaticResource {x:Type Slider}}">
            <Setter Property="Focusable" Value="True" />
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <Setter Property="Height" Value="18" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            </Style>
    </UserControl.Resources>

    <StackPanel>
        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Text="{Binding Label, ElementName=Root}" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />

            <Border x:Name="ValueShell" Grid.Column="1" Style="{StaticResource UnitField.Shell}"
                    Width="{Binding FieldWidth, ElementName=Root}"
                    Height="{StaticResource Size.Control.Compact}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Unit, ElementName=Root}"
                               Style="{StaticResource UnitField.Suffix}" />
                    <TextBox x:Name="ValueField" Style="{StaticResource UnitField.Input}"
                             automation:AutomationProperties.Name="{Binding Label, ElementName=Root}"
                             Text="{Binding Value, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}" />
                </DockPanel>
            </Border>
        </Grid>

        <!-- Snapped to the tick so dragging produces the kind of round number an operator would have
             typed. Without it the field behind the slider fills up with 63.7412 the moment anyone
             touches the thumb. -->
        <!-- Bound to the effective range, not the configured one: a value typed past the nominal
             maximum stretches the track instead of being clamped on its way back to the layer. -->
        <Slider Style="{StaticResource Slider.Parameter}"
                Minimum="{Binding EffectiveMinimum, ElementName=Root}"
                Maximum="{Binding EffectiveMaximum, ElementName=Root}"
                TickFrequency="{Binding TickFrequency, ElementName=Root}"
                IsSnapToTickEnabled="True"
                SmallChange="{Binding SmallChange, ElementName=Root}"
                LargeChange="{Binding LargeChange, ElementName=Root}"
                Value="{Binding Value, ElementName=Root, Mode=TwoWay}"
                automation:AutomationProperties.Name="{Binding Label, ElementName=Root}" />
    </StackPanel>
</UserControl>
