<UserControl x:Class="Lasero.App.Components.WindowTitleBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:components="clr-namespace:Lasero.App.Components"
             xmlns:conv="clr-namespace:Lasero.App.Converters"
             xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
             x:Name="Root" Height="44">
    <!-- Shared frameless title bar. System actions follow the host Window's ResizeMode. -->
    <UserControl.Resources>
        <conv:NotNullToVisibilityConverter x:Key="NotNullToVisibility" />
    </UserControl.Resources>
    <Border Background="{StaticResource Brush.TitleBar}"
            BorderBrush="{StaticResource Brush.PanelBorder}" BorderThickness="0,0,0,1"
            Padding="16,0">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <components:IconGlyph Grid.Column="0"
                                  IconData="{Binding IconData, ElementName=Root}"
                                  IsFilled="{Binding IsIconFilled, ElementName=Root}"
                                  GridSize="{Binding IconGridSize, ElementName=Root}"
                                  Width="{StaticResource Size.Icon.Md}" Height="{StaticResource Size.Icon.Md}"
                                  Foreground="{StaticResource Brush.TextSecondary}"
                                  VerticalAlignment="Center" Margin="0,0,8,0"
                                  Visibility="{Binding IconData, ElementName=Root, Converter={StaticResource NotNullToVisibility}}" />
            <TextBlock Grid.Column="1" Text="{Binding Title, ElementName=Root}" VerticalAlignment="Center"
                       FontFamily="{StaticResource Font.Display}"
                       FontSize="{StaticResource Size.Text.Section}" FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis" />
            <StackPanel x:Name="TitleBarCommands" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="MinimizeButton" Style="{StaticResource Button.Chrome}" Click="OnMinimizeClick"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        AutomationProperties.Name="Minimalizovat" ToolTip="Minimalizovat">
                    <components:IconGlyph IconData="{StaticResource Glyph.Minimize}"
                                          Width="{StaticResource Size.Icon.Chrome}" Height="{StaticResource Size.Icon.Chrome}" />
                </Button>
                <Button x:Name="MaximizeButton" Style="{StaticResource Button.Chrome}" Click="OnMaximizeClick"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        AutomationProperties.Name="Maximalizovat" ToolTip="Maximalizovat">
                    <components:IconGlyph x:Name="MaximizeGlyph" IconData="{StaticResource Glyph.Maximize}"
                                          Width="{StaticResource Size.Icon.Chrome}" Height="{StaticResource Size.Icon.Chrome}" />
                </Button>
                <Button Style="{StaticResource Button.ChromeClose}" Click="OnCloseClick"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        AutomationProperties.Name="{Binding CloseButtonName, ElementName=Root}">
                    <components:IconGlyph IconData="{StaticResource Glyph.Close}"
                                          Width="{StaticResource Size.Icon.Chrome}" Height="{StaticResource Size.Icon.Chrome}" />
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>