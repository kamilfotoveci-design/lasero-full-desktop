<UserControl x:Class="Lasero.App.Components.NumericField"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Lasero.App.Converters"
             x:Name="Root" Focusable="False" IsTabStop="False">
    <!--
        A typed number with its unit inside the field: "500 mm". Used where a value is an exact
        quantity the operator knows (a size, a feed rate, a percentage) and a slider would only be a
        way to miss it. Accepts "0,5" and "0.5"; anything that is not a number keeps the field
        outlined in the error colour and the previous value in the model.
    -->
    <UserControl.Resources>
        <conv:DecimalTextConverter x:Key="DecimalText" />
    </UserControl.Resources>
    <Border x:Name="Shell" Width="128" Height="{StaticResource Size.Control.Compact}">
        <Border.Style>
            <Style TargetType="Border" BasedOn="{StaticResource UnitField.Shell}">
                <Setter Property="Height" Value="{StaticResource Size.Control.Compact}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding (Validation.HasError), ElementName=Input}" Value="True">
                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Danger}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <DockPanel>
            <TextBlock DockPanel.Dock="Right" Style="{StaticResource UnitField.Suffix}"
                       Text="{Binding Unit, ElementName=Root}" />
            <TextBox x:Name="Input" Style="{StaticResource UnitField.Input}"
                     Validation.ErrorTemplate="{x:Null}"
                     AutomationProperties.Name="{Binding (AutomationProperties.Name), ElementName=Root}"
                     Text="{Binding Value, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=LostFocus,
                                    Converter={StaticResource DecimalText}, ValidatesOnExceptions=True}" />
        </DockPanel>
    </Border>
</UserControl>
