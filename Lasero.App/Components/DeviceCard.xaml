<UserControl x:Class="Lasero.App.Components.DeviceCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:components="clr-namespace:Lasero.App.Components"
             xmlns:conv="clr-namespace:Lasero.App.Converters"
             x:Name="Root">
    <UserControl.Resources>
        <conv:NotNullToVisibilityConverter x:Key="NotNullToVisibility" />
    </UserControl.Resources>
    <Border Style="{StaticResource Card}">
        <StackPanel>
            <Grid Margin="0,0,0,14">
                <StackPanel Orientation="Horizontal">
                    <components:IconGlyph IconData="{StaticResource Glyph.Device}" Width="18" Height="18" Margin="0,0,8,0" />
                    <TextBlock Text="Zařízení" Style="{StaticResource PanelTitle}" Margin="0" FontSize="16" />
                </StackPanel>
                <components:StatusBadge Grid.Column="1" HorizontalAlignment="Right"
                                        IsConnected="{Binding IsConnected, ElementName=Root}"
                                        StatusText="{Binding StatusText, ElementName=Root}" />
            </Grid>
            <TextBlock Text="{Binding FirmwareBanner, ElementName=Root}" Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,0,0,10"
                       Visibility="{Binding FirmwareBanner, ElementName=Root, Converter={StaticResource NotNullToVisibility}}" />
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="Pracovní plocha" Style="{StaticResource Text.Muted}" />
                <TextBlock Grid.Column="1">
                    <Run Text="{Binding WorkAreaWidthMm, ElementName=Root, Mode=OneWay, StringFormat={}{0:0.#}}" />
                    <Run Text=" × " />
                    <Run Text="{Binding WorkAreaHeightMm, ElementName=Root, Mode=OneWay, StringFormat={}{0:0.#}}" />
                    <Run Text=" mm" />
                </TextBlock>
            </Grid>
            <Button Style="{StaticResource Button.Primary}" Command="{Binding OpenDesignerCommand, ElementName=Root}" Margin="0,16,0,0" HorizontalAlignment="Stretch"><components:IconLabel IconData="{StaticResource Glyph.Design}" Text="Otevřít návrh" Foreground="White" /></Button>
        </StackPanel>
    </Border>
</UserControl>
