<UserControl x:Class="Lasero.App.Components.DeviceCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:components="clr-namespace:Lasero.App.Components"
             xmlns:conv="clr-namespace:Lasero.App.Converters"
             x:Name="Root">
    <UserControl.Resources>
        <conv:NotNullToVisibilityConverter x:Key="NotNullToVisibility" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
    </UserControl.Resources>
    <components:ElevatedBorder Style="{StaticResource Card}">
        <StackPanel>
            <Grid Margin="0,0,0,14">
                <StackPanel Orientation="Horizontal">
                    <components:IconTile IconData="{StaticResource Glyph.Device}" Tone="Blue" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock Text="Zařízení" Style="{StaticResource PanelTitle}" Margin="0" VerticalAlignment="Center" />
                </StackPanel>
                <components:StatusBadge Grid.Column="1" HorizontalAlignment="Right"
                                        StatusText="{Binding StatusText, ElementName=Root}">
                    <components:StatusBadge.Style>
                        <Style TargetType="components:StatusBadge">
                            <Setter Property="Kind" Value="Neutral" />
                            <Setter Property="IconData" Value="{StaticResource Glyph.Disconnect}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsConnected, ElementName=Root}" Value="True">
                                    <Setter Property="Kind" Value="Ready" />
                                    <Setter Property="IconData" Value="{StaticResource Glyph.Connect}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </components:StatusBadge.Style>
                </components:StatusBadge>
            </Grid>
            <TextBlock Text="{Binding FirmwareBanner, ElementName=Root}" Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,0,0,10"
                       Visibility="{Binding FirmwareBanner, ElementName=Root, Converter={StaticResource NotNullToVisibility}}" />
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="Pracovní plocha" Style="{StaticResource Text.Muted}" />
                <TextBlock Grid.Column="1">
                    <Run Text="{Binding WorkAreaWidthMm, ElementName=Root, Mode=OneWay, StringFormat={}{0:0.#}}" />
                    <Run Text=" × " />
                    <Run Text="{Binding WorkAreaHeightMm, ElementName=Root, Mode=OneWay, StringFormat={}{0:0.#}}" />
                    <Run Text=" mm" />
                </TextBlock>
            </Grid>
            <!-- Before a machine is set up, connecting it is the only thing worth doing from here.
                 Once it is connected, the design is. -->
            <Button Style="{StaticResource Button.Primary}" Margin="0,16,0,0" HorizontalAlignment="Stretch"
                    Command="{Binding ConnectDeviceCommand, ElementName=Root}"
                    Visibility="{Binding IsConnected, ElementName=Root, Converter={StaticResource InverseBoolToVisibility}}">
                <components:IconLabel IconData="{StaticResource Glyph.Connect}" Text="Připojit gravírku" Foreground="White" />
            </Button>
            <Button Style="{StaticResource Button.Primary}" Margin="0,16,0,0" HorizontalAlignment="Stretch"
                    Command="{Binding OpenDesignerCommand, ElementName=Root}"
                    Visibility="{Binding IsConnected, ElementName=Root, Converter={StaticResource BoolToVisibility}}">
                <components:IconLabel IconData="{StaticResource Glyph.Design}" Text="Otevřít návrh" Foreground="White" />
            </Button>
        </StackPanel>
    </components:ElevatedBorder>
</UserControl>
