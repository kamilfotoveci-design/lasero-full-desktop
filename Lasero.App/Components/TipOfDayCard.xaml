<UserControl x:Class="Lasero.App.Components.TipOfDayCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:components="clr-namespace:Lasero.App.Components"
             x:Name="Root" Focusable="False" KeyboardNavigation.TabNavigation="Local">
    <!--
        The Home "Tip dne": one quiet card, Apple News / Today in spirit, written for a complete beginner.
        A flat Brush.Canvas fill with no border and no shadow (it sits on the white page, so the fill alone
        separates it). Three things per row: an amber identification tile, a caption over the sentence,
        and the "3 z 12" hint with the quiet "Další tip" action. The sentence is 16 px on a 1.45 line
        height, at most two lines, trimmed with an ellipsis rather than growing the card. When the tip
        changes the old sentence fades out while the new one fades in and slides up 6 px (Opacity and
        RenderTransform only); with animations off it simply swaps.
    -->
    <Border x:Name="Card" Background="{DynamicResource Brush.Canvas}"
            CornerRadius="{StaticResource Radius.Xl}" Padding="24,20,12,20"
            UseLayoutRounding="True" SnapsToDevicePixels="True">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <components:IconTile Tone="Amber" Size="32" IconData="{StaticResource Glyph.Lightbulb}"
                                 VerticalAlignment="Center" Margin="0,0,16,0" />

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="TIP DNE" FontSize="{StaticResource Size.Text.Meta}" FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush.TextMuted}" />
                <Grid Margin="0,4,16,0" ClipToBounds="False">
                    <TextBlock x:Name="TipOut" Visibility="Collapsed" IsHitTestVisible="False"
                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="47"
                               FontSize="{StaticResource Size.Text.Assistant.Body}" FontWeight="Medium" LineHeight="23.2"
                               Foreground="{DynamicResource Brush.TextPrimary}" />
                    <TextBlock x:Name="TipText" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="47"
                               FontSize="{StaticResource Size.Text.Assistant.Body}" FontWeight="Medium" LineHeight="23.2"
                               Foreground="{DynamicResource Brush.TextPrimary}"
                               AutomationProperties.LiveSetting="Polite">
                        <TextBlock.RenderTransform><TranslateTransform x:Name="TipOffset" /></TextBlock.RenderTransform>
                    </TextBlock>
                </Grid>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="Progress" VerticalAlignment="Center" Margin="0,0,4,0"
                           FontSize="{StaticResource Size.Text.Meta}"
                           Foreground="{DynamicResource Brush.TextMuted}"
                           AutomationProperties.Name="Pořadí tipu" />
                <Button x:Name="NextButton" Style="{StaticResource Button.Quiet}"
                        Height="{StaticResource Size.Control.Primary}" MinWidth="{StaticResource Size.Control.Primary}"
                        Padding="12,0" VerticalAlignment="Center"
                        FontSize="{StaticResource Size.Text.Body}"
                        Command="{Binding NextCommand, ElementName=Root}"
                        ToolTip="Ukázat další tip"
                        AutomationProperties.Name="Další tip">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Další tip" VerticalAlignment="Center" />
                        <components:IconGlyph IconData="{StaticResource Glyph.ChevronRight}" Margin="8,0,0,0"
                                              Width="{StaticResource Size.Icon.Md}" Height="{StaticResource Size.Icon.Md}"
                                              VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
