<UserControl x:Class="Lasero.App.Components.PageHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root" Focusable="False">
    <!--
        The one screen header: title (Size.Text.Title, Bold), a one-line subtitle that says in plain Czech what the screen is
        for, and at most one primary action on the right (Actions). Leading is for the one screen that has an identity
        image (Home: Kamil). The header never scrolls: PageScaffold keeps it above the scrolling content.
        Title and actions share the vertical centre of the header; the subtitle wraps instead of being cut.
    -->
    <Grid MinHeight="{StaticResource Layout.PageHeaderMinHeight}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <ContentPresenter x:Name="LeadingHost" Content="{Binding Leading, ElementName=Root}" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="{Binding Title, ElementName=Root}" Style="{StaticResource PageTitle}" TextWrapping="Wrap"
                       AutomationProperties.HeadingLevel="Level1" />
            <TextBlock x:Name="SubtitleText" Text="{Binding Subtitle, ElementName=Root}" Style="{StaticResource PageSubtitle}"
                       TextWrapping="Wrap" MaxWidth="{StaticResource Layout.ReadingMaxWidth}" HorizontalAlignment="Left" />
        </StackPanel>
        <ContentPresenter x:Name="ActionsHost" Grid.Column="2" Content="{Binding Actions, ElementName=Root}" VerticalAlignment="Center" />
    </Grid>
</UserControl>
