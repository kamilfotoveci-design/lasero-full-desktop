<UserControl x:Class="Lasero.App.Tour.TipChip"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:components="clr-namespace:Lasero.App.Components"
             Visibility="Collapsed" Focusable="False">
    <!--
        One dismissible "Tip" chip, shown by GuidanceService for a real event (first import, first
        selection, first connect...). It lives over the workspace, never over the canvas centre, and does
        not take keyboard focus: the operator keeps drawing while it is visible, and it goes away by
        itself after a while or at once with the close button.
    -->
    <Border x:Name="Chip" MaxWidth="520"
            Background="{DynamicResource Brush.Panel}"
            BorderBrush="{DynamicResource Brush.PanelBorder}" BorderThickness="1"
            CornerRadius="{StaticResource Radius.Md}" Padding="16,8,8,8"
            UseLayoutRounding="True" SnapsToDevicePixels="True"
            Effect="{StaticResource Shadow.Tooltip}">
        <Border.RenderTransform><TranslateTransform x:Name="ChipOffset" /></Border.RenderTransform>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                <Ellipse Width="6" Height="6" Fill="{StaticResource Brush.Brand}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock Text="TIP" FontSize="{StaticResource Size.Text.Section}" FontWeight="SemiBold"
                           Foreground="{StaticResource Brush.TextSecondary}" />
            </StackPanel>
            <TextBlock x:Name="TipText" Grid.Column="1" VerticalAlignment="Center" TextWrapping="Wrap"
                       FontSize="{StaticResource Size.Text.Section}" LineHeight="22"
                       Foreground="{DynamicResource Brush.TextPrimary}"
                       AutomationProperties.LiveSetting="Polite" />
            <Button Grid.Column="2" Style="{StaticResource Button.Quiet}" Margin="8,0,0,0" Padding="8"
                    VerticalAlignment="Center"
                    Click="OnDismissClick" ToolTip="Skrýt tip"
                    AutomationProperties.Name="Skrýt tip">
                <components:IconGlyph IconData="{StaticResource Glyph.Close}"
                                      Width="{StaticResource Size.Icon.Chrome}" Height="{StaticResource Size.Icon.Chrome}" />
            </Button>
        </Grid>
    </Border>
</UserControl>
