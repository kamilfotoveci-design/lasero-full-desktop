<UserControl x:Class="Lasero.App.Tour.TourOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:components="clr-namespace:Lasero.App.Components"
             x:Name="Host"
             Focusable="True" IsTabStop="False"
             HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
             Visibility="Collapsed"
             KeyboardNavigation.TabNavigation="Cycle"
             KeyboardNavigation.ControlTabNavigation="Cycle"
             AutomationProperties.Name="Prohlídka aplikace">
    <!--
        The first-run welcome and the coach-mark tour, one in-window surface declared once in
        MainWindow.xaml (the same pattern DeviceWizardOverlay and KamilAssistantHost use).

        Everything here is presentation. The overlay covers the whole window and swallows pointer and
        keyboard input, so nothing underneath, Spustit and Rámovat included, can be activated while the
        tour is open; the steps only point at real controls, they never press them. The wording lives in
        TourSteps, the geometry in TourLayout, the progress rules in TourSession.
    -->
    <Grid x:Name="Root">

        <!-- ============ COACH MARKS ============ -->
        <Grid x:Name="CoachLayer" Visibility="Collapsed">
            <!-- Transparent catch-all: the cut-out must block the pointer too. -->
            <Rectangle Fill="Transparent" />
            <Path x:Name="Dim" Fill="{StaticResource Brush.Scrim}" IsHitTestVisible="False" />
            <Path x:Name="SpotRing" Stroke="{StaticResource Brush.Accent}" StrokeThickness="2" IsHitTestVisible="False" />
            <Border x:Name="SpotHalo" HorizontalAlignment="Left" VerticalAlignment="Top" Opacity="0" IsHitTestVisible="False"
                    BorderBrush="{StaticResource Brush.Accent}" BorderThickness="2"
                    CornerRadius="{StaticResource Radius.Lg}" RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform><ScaleTransform x:Name="HaloScale" ScaleX="1" ScaleY="1" /></Border.RenderTransform>
            </Border>

            <Canvas x:Name="CardCanvas">
                <Border x:Name="Card" Width="440"
                        Background="{StaticResource Brush.Panel}"
                        BorderBrush="{StaticResource Brush.PanelBorder}" BorderThickness="1"
                        CornerRadius="{StaticResource Radius.Lg}" Padding="24,20,24,20"
                        Effect="{StaticResource Shadow.Dropdown}"
                        AutomationProperties.LiveSetting="Polite">
                    <Border.RenderTransform><TranslateTransform x:Name="CardOffset" /></Border.RenderTransform>
                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="36" Height="36" CornerRadius="{StaticResource Radius.Pill}" Background="{StaticResource Brush.SelectedSurface}">
                                <components:IconGlyph x:Name="StepIcon" IconData="{StaticResource Glyph.Info}"
                                                      Width="{StaticResource Size.Icon.Lg}" Height="{StaticResource Size.Icon.Lg}"
                                                      Foreground="{StaticResource Brush.TextPrimary}" />
                            </Border>
                            <TextBlock x:Name="CounterText" Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"
                                       FontSize="{StaticResource Size.Text.Section}" FontWeight="SemiBold"
                                       Foreground="{StaticResource Brush.TextSecondary}" />
                            <StackPanel x:Name="DotsHost" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" />
                        </Grid>

                        <TextBlock x:Name="TitleText" TextWrapping="Wrap"
                                   FontFamily="{StaticResource Font.Display}" FontSize="{StaticResource Size.Text.Title}"
                                   FontWeight="SemiBold" LineHeight="30" Margin="0,0,0,10" />
                        <TextBlock x:Name="BodyText" TextWrapping="Wrap"
                                   FontSize="{StaticResource Size.Text.Section}" LineHeight="24"
                                   Foreground="{StaticResource Brush.TextSecondary}" />

                        <StackPanel x:Name="PointsHost" Margin="0,14,0,0" Visibility="Collapsed" />

                        <Border x:Name="SafetyBox" Margin="0,16,0,0" Padding="12,10" Visibility="Collapsed"
                                Background="{StaticResource Brush.WarningMuted}"
                                BorderBrush="{StaticResource Brush.Warning}" BorderThickness="1"
                                CornerRadius="{StaticResource Radius.Md}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <components:IconGlyph IconData="{StaticResource Glyph.Warning}"
                                                      Width="{StaticResource Size.Icon.Lg}" Height="{StaticResource Size.Icon.Lg}"
                                                      Foreground="{StaticResource Brush.Warning}" VerticalAlignment="Top" Margin="0,2,10,0" />
                                <TextBlock x:Name="SafetyText" Grid.Column="1" TextWrapping="Wrap"
                                           FontSize="{StaticResource Size.Text.Section}" LineHeight="24" FontWeight="Medium"
                                           Foreground="{StaticResource Brush.TextPrimary}" />
                            </Grid>
                        </Border>

                        <Grid Margin="0,22,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="SkipButton" Style="{StaticResource Button.Ghost}" HorizontalAlignment="Left"
                                    Height="{StaticResource Size.Control.Large}" Padding="12,0"
                                    FontSize="{StaticResource Size.Text.Section}"
                                    Content="Přeskočit" Click="OnSkipClick"
                                    ToolTip="Ukončit prohlídku · Esc"
                                    AutomationProperties.Name="Přeskočit prohlídku" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button x:Name="BackButton" Style="{StaticResource Button.LargeSecondary}" Margin="0,0,10,0"
                                        FontSize="{StaticResource Size.Text.Section}"
                                        Content="Zpět" Click="OnBackClick"
                                        ToolTip="Předchozí krok · šipka vlevo"
                                        AutomationProperties.Name="Zpět" />
                                <Button x:Name="ReplayButton" Style="{StaticResource Button.LargeSecondary}" Margin="0,0,10,0"
                                        FontSize="{StaticResource Size.Text.Section}"
                                        Content="Přehrát znovu" Click="OnReplayClick" Visibility="Collapsed"
                                        AutomationProperties.Name="Přehrát prohlídku znovu" />
                                <Button x:Name="NextButton" Style="{StaticResource Button.Large}"
                                        FontSize="{StaticResource Size.Text.Section}"
                                        Click="OnNextClick" MinWidth="110"
                                        AutomationProperties.Name="Další">
                                    <TextBlock x:Name="NextLabel" Text="Další" Foreground="{StaticResource Brush.OnPrimaryAction}" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- The pointer on the card edge that faces the spotlight. Positioned in code. -->
                <Path x:Name="Caret" Data="M0,11 L10,0 L20,11" Width="20" Height="11"
                      Fill="{StaticResource Brush.Panel}" Stroke="{StaticResource Brush.PanelBorder}" StrokeThickness="1"
                      IsHitTestVisible="False" Visibility="Collapsed">
                    <Path.RenderTransform><TranslateTransform x:Name="CaretOffsetTransform" /></Path.RenderTransform>
                </Path>
            </Canvas>
        </Grid>

        <!-- ============ WELCOME ============ -->
        <Grid x:Name="WelcomeLayer" Visibility="Collapsed">
            <Border x:Name="WelcomeScrim" Background="{StaticResource Brush.Scrim}" />
            <Border x:Name="WelcomeCard" Width="560" Padding="32"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{StaticResource Brush.Panel}"
                    BorderBrush="{StaticResource Brush.PanelBorder}" BorderThickness="1"
                    CornerRadius="{StaticResource Radius.Lg}"
                    Effect="{StaticResource Shadow.Modal}"
                    RenderTransformOrigin="0.5,0.5"
                    AutomationProperties.Name="Úvod do Lasero">
                <Border.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="WelcomeScale" ScaleX="1" ScaleY="1" />
                        <TranslateTransform x:Name="WelcomeOffset" />
                    </TransformGroup>
                </Border.RenderTransform>
                <StackPanel>
                    <!-- The stage: the supplied wordmark is the only logo, revealed by a laser pass, then
                         framed by four corner marks (the same motif as Rámovat) and underlined by an etched line. -->
                    <Border Height="176" Background="{StaticResource Brush.Background}"
                            BorderBrush="{StaticResource Brush.PanelBorder}" BorderThickness="1"
                            CornerRadius="{StaticResource Radius.Lg}">
                        <Grid>
                            <Path x:Name="BracketTl" Data="M0,18 L0,0 L18,0" Stroke="{StaticResource Brush.Accent}" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" StrokeDashArray="20 20"
                                  HorizontalAlignment="Left" VerticalAlignment="Top" Margin="16,16,0,0" Width="18" Height="18" />
                            <Path x:Name="BracketTr" Data="M0,0 L18,0 L18,18" Stroke="{StaticResource Brush.Accent}" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" StrokeDashArray="20 20"
                                  HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,16,16,0" Width="18" Height="18" />
                            <Path x:Name="BracketBl" Data="M0,0 L0,18 L18,18" Stroke="{StaticResource Brush.Accent}" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" StrokeDashArray="20 20"
                                  HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="16,0,0,16" Width="18" Height="18" />
                            <Path x:Name="BracketBr" Data="M18,0 L18,18 L0,18" Stroke="{StaticResource Brush.Accent}" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" StrokeDashArray="20 20"
                                  HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,16,16" Width="18" Height="18" />

                            <Grid Width="300" Height="93" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,14">
                                <Image x:Name="WordmarkImage" Source="{StaticResource Image.BrandWordmark}" Stretch="Uniform"
                                       AutomationProperties.Name="Lasero" />
                                <Canvas>
                                    <Rectangle x:Name="Beam" Width="2" Height="93" Fill="{StaticResource Brush.Accent}" Opacity="0" />
                                    <Ellipse x:Name="DotPulse" Width="18" Height="18" Canvas.Left="265" Canvas.Top="76" Opacity="0"
                                             Stroke="{StaticResource Brush.Accent}" StrokeThickness="2" RenderTransformOrigin="0.5,0.5">
                                        <Ellipse.RenderTransform><ScaleTransform x:Name="DotPulseScale" ScaleX="1" ScaleY="1" /></Ellipse.RenderTransform>
                                    </Ellipse>
                                </Canvas>
                            </Grid>
                            <Rectangle x:Name="EtchLine" Height="2" Width="0" Fill="{StaticResource Brush.Accent}"
                                       HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,34" RadiusX="1" RadiusY="1" />
                        </Grid>
                    </Border>

                    <TextBlock x:Name="WelcomeTitle" Margin="0,26,0,0" HorizontalAlignment="Center"
                               FontFamily="{StaticResource Font.Display}" FontSize="{StaticResource Size.Text.Title}" FontWeight="Bold">
                        <Run Text="Od nápadu k laseru" /><Run Text="." Foreground="{StaticResource Brush.Brand}" />
                    </TextBlock>
                    <TextBlock Text="Návrh, kontrola polohy a bezpečné spuštění krok za krokem."
                               Margin="0,10,0,0" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center"
                               FontSize="{StaticResource Size.Text.Section}" LineHeight="24" FontWeight="Medium" />
                    <TextBlock Text="Prohlídka trvá asi dvě minuty a nic přitom nezmění ani nespustí."
                               Margin="0,8,0,0" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center"
                               FontSize="{StaticResource Size.Text.Section}" LineHeight="24"
                               Foreground="{StaticResource Brush.TextSecondary}" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,28,0,0">
                        <Button x:Name="StartButton" Style="{StaticResource Button.Large}" IsDefault="True" Margin="0,0,12,0"
                                FontSize="{StaticResource Size.Text.Section}" Click="OnStartTourClick"
                                AutomationProperties.Name="Začít prohlídku">
                            <TextBlock Text="Začít prohlídku" Foreground="{StaticResource Brush.OnPrimaryAction}" />
                        </Button>
                        <Button x:Name="SkipWelcomeButton" Style="{StaticResource Button.LargeSecondary}"
                                FontSize="{StaticResource Size.Text.Section}" Content="Přeskočit" Click="OnSkipWelcomeClick"
                                ToolTip="Zavřít úvod · Esc"
                                AutomationProperties.Name="Přeskočit úvod" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
