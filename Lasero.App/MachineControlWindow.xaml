<Window x:Class="Lasero.App.MachineControlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:components="clr-namespace:Lasero.App.Components"
        xmlns:views="clr-namespace:Lasero.App.Views"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Ovládání stroje"
        Width="420" MinWidth="380" MaxWidth="560"
        Height="720" MinHeight="480"
        WindowStyle="None" ResizeMode="CanResize" ShowInTaskbar="False"
        Background="{StaticResource Brush.Background}"
        Foreground="{StaticResource Brush.TextPrimary}"
        WindowStartupLocation="Manual">
    <!--
        The jog controls as a panel beside the canvas rather than a screen you have to leave the
        design for. It hosts MachinePanelView unchanged — the same jog pad, homing, unlock, origin
        and positioning-beam controls, bound to the same view model — so every safety gate and every
        CanExecute behaves exactly as it does on the Device screen.

        Non-modal on purpose: nudging an axis while watching the artwork is the whole reason for it.
    -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0" />
    </shell:WindowChrome.WindowChrome>

    <Border Background="{StaticResource Brush.Background}"
            BorderBrush="{StaticResource Brush.PanelBorderStrong}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Background="{StaticResource Brush.TitleBar}"
                    BorderBrush="{StaticResource Brush.PanelBorder}" BorderThickness="0,0,0,1"
                    Padding="14,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <components:IconGlyph IconData="{StaticResource Glyph.Device}"
                                          Width="{StaticResource Size.Icon.Md}" Height="{StaticResource Size.Icon.Md}"
                                          Foreground="{StaticResource Brush.TextSecondary}"
                                          VerticalAlignment="Center" Margin="0,0,9,0" />
                    <TextBlock Grid.Column="1" Text="Ovládání stroje" VerticalAlignment="Center"
                               FontFamily="{StaticResource Font.Display}"
                               FontSize="{StaticResource Size.Text.Section}" FontWeight="SemiBold" />
                    <Button Grid.Column="2" Style="{StaticResource Button.Chrome}" Click="OnCloseClick"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            AutomationProperties.Name="Zavřít ovládání stroje">
                        <components:IconGlyph IconData="{StaticResource Glyph.Close}"
                                              Width="{StaticResource Size.Icon.Chrome}" Height="{StaticResource Size.Icon.Chrome}" />
                    </Button>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Padding="14,12,14,16">
                <views:MachinePanelView />
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
