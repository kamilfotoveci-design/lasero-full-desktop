<Window x:Class="Lasero.App.KeyboardShortcutsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Klávesové zkratky"
        Width="760" Height="620" MinWidth="680" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Brush.Background}">
    <Window.Resources>
        <Style x:Key="ShortcutKey" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Brush.Field}" />
            <Setter Property="BorderBrush" Value="{StaticResource Brush.PanelBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource Radius.Sm}" />
            <Setter Property="Padding" Value="7,3" />
            <Setter Property="MinWidth" Value="88" />
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
        <Style x:Key="ShortcutRow" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
    </Window.Resources>

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,22">
            <TextBlock Text="Klávesové zkratky" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Text="Rychlé ovládání návrhu bez přerušení práce na plátně."
                       Style="{StaticResource Text.Muted}" Margin="0,6,0,0" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="28" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Pohyb po plátně" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,14" />

                    <Grid Style="{StaticResource ShortcutRow}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Posun plátna" VerticalAlignment="Center"/><Border Grid.Column="1" Style="{StaticResource ShortcutKey}"><TextBlock Text="Kolečko + tažení" HorizontalAlignment="Center"/></Border></Grid>
                    <Grid Style="{StaticResource ShortcutRow}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Alternativní posun" VerticalAlignment="Center"/><Border Grid.Column="1" Style="{StaticResource ShortcutKey}"><TextBlock Text="Mezerník + tažení" HorizontalAlignment="Center"/></Border></Grid>
                    <Grid Style="{StaticResource ShortcutRow}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Svislý posun" VerticalAlignment="Center"/><Border Grid.Column="1" Style="{StaticResource ShortcutKey}"><TextBlock Text="Kolečko" HorizontalAlignment="Center"/></Border></Grid>
                    <Grid Style="{StaticResource ShortcutRow}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Vodorovný posun" VerticalAlignment="Center"/><Border Grid.Column="1" Style="{StaticResource ShortcutKey}"><TextBlock Text="Shift + kolečko" HorizontalAlignment="Center"/></Border></Grid>
                    <Grid Style="{StaticResource ShortcutRow}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Přiblížení ke kurzoru" VerticalAlignment="Center"/><Border Grid.Column="1" Style="{StaticResource ShortcutKey}"><TextBlock Text="Ctrl + kolečko" HorizontalAlignment="Center"/></Border></Grid>
                    <Grid Style="{StaticResource ShortcutRow}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Přizpůsobit oknu" VerticalAlignment="Center"/><Border Grid.Column="1" Style="{StaticResource ShortcutKey}"><TextBlock Text="F / Ctrl + 0" HorizontalAlignment="Center"/></Border></Grid>
                    <Grid Style="{StaticResource ShortcutRow}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Přiblížit / oddálit" VerticalAlignment="Center"/><Border Grid.Column="1" Style="{StaticResource ShortcutKey}"><TextBlock Text="Ctrl + + / −" HorizontalAlignment="Center"/></Border></Grid>

                    <TextBlock Text="Výběr a poloha" FontSize="16" FontWeight="SemiBold" Margin="0,20,0,14" />
                    <Grid Style="{StaticResource ShortcutRow}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Přidat k výběru" VerticalAlignment="Center"/><Border Grid.Column="1" Style="{StaticResource ShortcutKey}"><TextBlock Text="Shift + kliknutí" HorizontalAlignment="Center"/></Border></Grid>
                    <Grid Style="{StaticResource ShortcutRow}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Posunout o 0,5 mm" VerticalAlignment="Center"/><Border Grid.Column="1" Style="{StaticResource ShortcutKey}"><TextBlock Text="Šipky" HorizontalAlignment="Center"/></Border></Grid>
                    <Grid Style="{StaticResource ShortcutRow}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Posunout o 5 mm" VerticalAlignment="Center"/><Border Grid.Column="1" Style="{StaticResource ShortcutKey}"><TextBlock Text="Shift + šipky" HorizontalAlignment="Center"/></Border></Grid>
                    <Grid Style="{StaticResource ShortcutRow}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Zrušit akci nebo výběr" VerticalAlignment="Center"/><Border Grid.Column="1" Style="{StaticResource ShortcutKey}"><TextBlock Text="Esc" HorizontalAlignment="Center"/></Border></Grid>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Úpravy objektů" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,14" />
                    <Grid Style="{StaticResource ShortcutRow}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Vybrat vše" VerticalAlignment="Center"/><Border Grid.Column="1" Style="{StaticResource ShortcutKey}"><TextBlock Text="Ctrl + A" HorizontalAlignment="Center"/></Border></Grid>
                    <Grid Style="{StaticResource ShortcutRow}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Kopírovat / vyjmout / vložit" TextWrapping="Wrap" VerticalAlignment="Center"/><Border Grid.Column="1" Style="{StaticResource ShortcutKey}"><TextBlock Text="Ctrl + C / X / V" HorizontalAlignment="Center"/></Border></Grid>
                    <Grid Style="{StaticResource ShortcutRow}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Duplikovat" VerticalAlignment="Center"/><Border Grid.Column="1" Style="{StaticResource ShortcutKey}"><TextBlock Text="Ctrl + D" HorizontalAlignment="Center"/></Border></Grid>
                    <Grid Style="{StaticResource ShortcutRow}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Odstranit" VerticalAlignment="Center"/><Border Grid.Column="1" Style="{StaticResource ShortcutKey}"><TextBlock Text="Delete" HorizontalAlignment="Center"/></Border></Grid>
                    <Grid Style="{StaticResource ShortcutRow}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Zpět" VerticalAlignment="Center"/><Border Grid.Column="1" Style="{StaticResource ShortcutKey}"><TextBlock Text="Ctrl + Z" HorizontalAlignment="Center"/></Border></Grid>
                    <Grid Style="{StaticResource ShortcutRow}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Znovu" VerticalAlignment="Center"/><Border Grid.Column="1" Style="{StaticResource ShortcutKey}"><TextBlock Text="Ctrl + Y / Ctrl + Shift + Z" HorizontalAlignment="Center"/></Border></Grid>

                    <TextBlock Text="Nástroje návrhu" FontSize="16" FontWeight="SemiBold" Margin="0,20,0,14" />
                    <Grid Style="{StaticResource ShortcutRow}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Výběr / posun plátna" VerticalAlignment="Center"/><Border Grid.Column="1" Style="{StaticResource ShortcutKey}"><TextBlock Text="V / H" HorizontalAlignment="Center"/></Border></Grid>
                    <Grid Style="{StaticResource ShortcutRow}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Obdélník / elipsa" VerticalAlignment="Center"/><Border Grid.Column="1" Style="{StaticResource ShortcutKey}"><TextBlock Text="R / E" HorizontalAlignment="Center"/></Border></Grid>
                    <Grid Style="{StaticResource ShortcutRow}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Čára / text" VerticalAlignment="Center"/><Border Grid.Column="1" Style="{StaticResource ShortcutKey}"><TextBlock Text="L / T" HorizontalAlignment="Center"/></Border></Grid>
                    <Grid Style="{StaticResource ShortcutRow}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Trasovat vybranou bitmapu" VerticalAlignment="Center"/><Border Grid.Column="1" Style="{StaticResource ShortcutKey}"><TextBlock Text="Alt + T" HorizontalAlignment="Center"/></Border></Grid>

                    <TextBlock Text="Projekt" FontSize="16" FontWeight="SemiBold" Margin="0,20,0,14" />
                    <Grid Style="{StaticResource ShortcutRow}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Nový projekt" VerticalAlignment="Center"/><Border Grid.Column="1" Style="{StaticResource ShortcutKey}"><TextBlock Text="Ctrl + N" HorizontalAlignment="Center"/></Border></Grid>
                    <Grid Style="{StaticResource ShortcutRow}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Otevřít projekt" VerticalAlignment="Center"/><Border Grid.Column="1" Style="{StaticResource ShortcutKey}"><TextBlock Text="Ctrl + O" HorizontalAlignment="Center"/></Border></Grid>
                    <Grid Style="{StaticResource ShortcutRow}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Uložit projekt" VerticalAlignment="Center"/><Border Grid.Column="1" Style="{StaticResource ShortcutKey}"><TextBlock Text="Ctrl + S" HorizontalAlignment="Center"/></Border></Grid>
                    <Grid Style="{StaticResource ShortcutRow}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Přehled zkratek" VerticalAlignment="Center"/><Border Grid.Column="1" Style="{StaticResource ShortcutKey}"><TextBlock Text="F1" HorizontalAlignment="Center"/></Border></Grid>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <Button Grid.Row="2" Content="Zavřít" HorizontalAlignment="Right" Margin="0,22,0,0"
                MinWidth="96" IsDefault="True" IsCancel="True" Click="OnCloseClick" />
    </Grid>
</Window>
