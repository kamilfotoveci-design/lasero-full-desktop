<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:components="clr-namespace:Lasero.App.Components"
                    xmlns:jobs="clr-namespace:Lasero.Core.Jobs;assembly=Lasero.Core">
    <!-- Nav labels use TextPrimary, not TextSecondary — this is primary wayfinding text, not de-emphasised
         caption text. Reserve the muted tone for genuinely secondary content; a nav item that's merely
         "not currently selected" should not read as if it were disabled. -->
    <Style x:Key="NavButton" TargetType="Button">
        <Setter Property="Height" Value="36" />
        <Setter Property="Margin" Value="0,1,0,1" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="FontSize" Value="{StaticResource Size.Text.Body}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="NavBackground" Background="{TemplateBinding Background}" CornerRadius="{StaticResource Radius.Md}" Padding="{TemplateBinding Padding}" />
                        <!-- Dedicated overlays keep hover/press feedback local to this instance and let
                             the active surface remain selected while the pointer passes over it. -->
                        <Border x:Name="NavHover" Background="{StaticResource Brush.HoverWash}" CornerRadius="{StaticResource Radius.Md}" Opacity="0" />
                        <Border x:Name="NavPress" Background="{StaticResource Brush.HoverWash}" CornerRadius="{StaticResource Radius.Md}" Opacity="0" />
                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Stretch"
                                          Margin="{TemplateBinding Padding}"
                                          Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                          ContentStringFormat="{TemplateBinding ContentStringFormat}" />
                        <!--
                            Active-screen marker. The selected item is told by a tinted surface,
                            accent text, a heavier weight and the icon it already carries. The leading
                            bar this used to draw was a fourth cue on the same row, and it is the one
                            the design system does not have.
                        -->
                        <Border x:Name="ActiveBar" Width="0" HorizontalAlignment="Left" Margin="0"
                                Background="Transparent" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="NavHover" Storyboard.TargetProperty="Opacity" To="0.06"
                                                         Duration="{StaticResource Motion.Fast}" EasingFunction="{StaticResource Ease.Out}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="NavHover" Storyboard.TargetProperty="Opacity" To="0"
                                                         Duration="{StaticResource Motion.Fast}" EasingFunction="{StaticResource Ease.Out}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="NavPress" Property="Opacity" Value="0.08" />
                        </Trigger>
                        <!-- The per-screen NavButton.* styles cannot reach a template element from a
                             Style trigger, so they flag the active item through Tag and the template
                             turns that into the marker bar. -->
                        <Trigger Property="Tag" Value="Active">
                            <Setter TargetName="ActiveBar" Property="Background" Value="{DynamicResource Brush.Accent}" />
                        </Trigger>
                        <Trigger Property="components:FocusVisual.IsVisible" Value="True">
                            <Setter TargetName="NavBackground" Property="BorderBrush" Value="{DynamicResource Brush.FocusRing}" />
                            <Setter TargetName="NavBackground" Property="BorderThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.TextDisabled}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="InspectorSection" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.Panel}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.PanelBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Lg}" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>
    <!-- A 1px hairline separating adjacent zones in a horizontal bar (bottom job strip, selection
         toolbar) — shared so every bar uses the same divider instead of relying on Margin gaps alone. -->
    <Style x:Key="BarDivider" TargetType="Border">
        <Setter Property="Width" Value="1" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Margin" Value="9,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource Brush.PanelBorder}" />
    </Style>

    <Style x:Key="PanelTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Display}" />
        <Setter Property="FontSize" Value="{StaticResource Size.Text.Section}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,10" />
    </Style>
    <Style x:Key="PrimaryAction" TargetType="Button" BasedOn="{StaticResource Button.Primary}">
        <Setter Property="Effect" Value="{x:Null}" />
    </Style>

    <!--
        Job controls are shared by the persistent bottom strip and the Designer inspector. Their
        visibility is presentation-only: the commands remain the sole source of CanExecute, so
        moving a button cannot weaken machine readiness or JobPreflight.

        Keep JobDangerButton before JobActiveStopButton. StaticResource lookup is declaration-order
        sensitive in WPF, and a forward reference crashes the app while loading this dictionary.
    -->
    <Style x:Key="JobPrimaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryAction}" />

    <Style x:Key="JobIdleActionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding GCode.JobState}" Value="{x:Static jobs:JobRunState.Preparing}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
            <DataTrigger Binding="{Binding GCode.JobState}" Value="{x:Static jobs:JobRunState.Framing}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
            <DataTrigger Binding="{Binding GCode.JobState}" Value="{x:Static jobs:JobRunState.Running}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
            <DataTrigger Binding="{Binding GCode.JobState}" Value="{x:Static jobs:JobRunState.Paused}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="JobRunningActionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding GCode.JobState}" Value="{x:Static jobs:JobRunState.Running}"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="JobPausedActionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding GCode.JobState}" Value="{x:Static jobs:JobRunState.Paused}"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="JobDangerButton" TargetType="Button" BasedOn="{StaticResource Button.DangerSolid}" />

    <Style x:Key="JobStartActionButton" TargetType="Button" BasedOn="{StaticResource JobDangerButton}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding GCode.JobState}" Value="{x:Static jobs:JobRunState.Preparing}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
            <DataTrigger Binding="{Binding GCode.JobState}" Value="{x:Static jobs:JobRunState.Framing}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
            <DataTrigger Binding="{Binding GCode.JobState}" Value="{x:Static jobs:JobRunState.Running}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
            <DataTrigger Binding="{Binding GCode.JobState}" Value="{x:Static jobs:JobRunState.Paused}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="JobActiveStopButton" TargetType="Button" BasedOn="{StaticResource JobDangerButton}">
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding GCode.JobState}" Value="{x:Static jobs:JobRunState.Preparing}"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
            <DataTrigger Binding="{Binding GCode.JobState}" Value="{x:Static jobs:JobRunState.Framing}"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
            <DataTrigger Binding="{Binding GCode.JobState}" Value="{x:Static jobs:JobRunState.Running}"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
            <DataTrigger Binding="{Binding GCode.JobState}" Value="{x:Static jobs:JobRunState.Paused}"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Compatibility alias for older views; new UI should use PrimaryAction. -->
    <Style x:Key="PrimaryBlue" TargetType="Button" BasedOn="{StaticResource PrimaryAction}" />

    <!-- Flat, bordered, no shadow — same philosophy as LaseroTheme.xaml's editor "Panel" style, so
         dashboard surfaces and editor chrome read as one consistent visual language rather than two. -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.Panel}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.PanelBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Lg}" />
        <Setter Property="Padding" Value="20" />
    </Style>

    <Style x:Key="MetricCard" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="Padding" Value="18,16" />
        <Setter Property="MinHeight" Value="102" />
    </Style>

    <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Display}" />
        <Setter Property="FontSize" Value="{StaticResource Size.Text.Title}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LineHeight" Value="28" />
    </Style>

    <Style x:Key="PageSubtitle" TargetType="TextBlock" BasedOn="{StaticResource Text.Muted}">
        <Setter Property="FontSize" Value="{StaticResource Size.Text.Body}" />
        <Setter Property="Margin" Value="0,4,0,0" />
    </Style>

    <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource Text.Muted}">
        <Setter Property="FontSize" Value="{StaticResource Size.Text.Meta}" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <Style x:Key="Button.Regular" TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
        <Setter Property="Height" Value="{StaticResource Size.Control.Base}" />
        <Setter Property="MinHeight" Value="{StaticResource Size.Control.Base}" />
    </Style>

    <!--
        A card's secondary "Otevřít vše" affordance. Chromeless and accent-coloured so it reads as
        the quiet way out of a section rather than competing with the card's own primary button —
        still a real Button, so it keeps keyboard focus and the accessible name a link would lose.
    -->

    <Style x:Key="Button.Link" TargetType="Button" BasedOn="{StaticResource Button.Ghost}">
        <Setter Property="Foreground" Value="{StaticResource Brush.AccentText}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Height" Value="{StaticResource Size.Control.Compact}" />
        <Setter Property="MinHeight" Value="{StaticResource Size.Control.Compact}" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <!-- Button.Link's ToggleButton counterpart. A WPF Style's TargetType must match the element it's
         applied to exactly (Button and ToggleButton are siblings under ButtonBase, not one another's
         subtype), so a disclosure toggle bound through IsChecked cannot reuse Button.Link directly —
         this repeats its look with a self-contained template instead of Button's default chrome. -->
    <Style x:Key="ToggleButton.Link" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{StaticResource Brush.AccentText}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Height" Value="{StaticResource Size.Control.Compact}" />
        <Setter Property="MinHeight" Value="{StaticResource Size.Control.Compact}" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Surface" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                            CornerRadius="{StaticResource Radius.Sm}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource Brush.PanelRaised}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource Brush.PanelBorder}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource Brush.SelectedSurface}" />
                        </Trigger>
                        <Trigger Property="components:FocusVisual.IsVisible" Value="True">
                            <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource Brush.FocusRing}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="{StaticResource Opacity.Disabled}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Button.Large" TargetType="Button" BasedOn="{StaticResource Button.Primary}">
        <Setter Property="Height" Value="{StaticResource Size.Control.Large}" />
        <Setter Property="MinHeight" Value="{StaticResource Size.Control.Large}" />
        <Setter Property="Padding" Value="18,0" />
    </Style>
    <!--
        The quieter half of a hero's button row: same height as Button.Large so the row lines up, but
        a panel surface and normal text. It is based on Button.Secondary, not Button.Large: Button.Primary
        carries hover and press Background triggers that outrank any Background set here, which turned
        this button graphite with dark text under the pointer.
    -->
    <Style x:Key="Button.LargeSecondary" TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
        <Setter Property="Height" Value="{StaticResource Size.Control.Large}" />
        <Setter Property="MinHeight" Value="{StaticResource Size.Control.Large}" />
        <Setter Property="Padding" Value="18,0" />
    </Style>

    <Style x:Key="ThumbnailCard" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="Padding" Value="0" />
    </Style>

    <!-- ===================== Numeric field with an integrated unit ===================== -->
    <!--
        "205.05 mm" reads as one control instead of an input plus a detached grey "mm" floating beside
        it. The shell owns the surface, border and focus ring; the TextBox inside is chromeless so the
        two never draw competing outlines. Focus is tracked with IsKeyboardFocusWithin because the
        element that actually takes focus is the inner input, not the shell.
    -->
    <Style x:Key="UnitField.Shell" TargetType="Border">
        <!-- Same surface and outline as TextBox and ComboBox (Brush.Field over Brush.PanelBorder). It used to be white over the
             strong outline, so a numeric field sat next to a grey text field and a grey select in the same inspector. -->
        <Setter Property="Background" Value="{DynamicResource Brush.Field}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.PanelBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Md}" />
        <Setter Property="Height" Value="{StaticResource Size.Control.Base}" />
        <Setter Property="Padding" Value="10,0" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.TextSecondary}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.FocusRing}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="{StaticResource Opacity.Disabled}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="UnitField.Input" TargetType="TextBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Numeric}" />
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
        <Setter Property="FontSize" Value="{StaticResource Size.Text.Body}" />
        <Setter Property="TextAlignment" Value="Right" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="CaretBrush" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Brush.SelectedSurface}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="UnitField.Suffix" TargetType="TextBlock" BasedOn="{StaticResource Text.Muted}">
        <Setter Property="Margin" Value="5,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>

    <!-- Row label inside the inspector's transform grid. -->
    <Style x:Key="TransformRowLabel" TargetType="TextBlock" BasedOn="{StaticResource Text.Muted}">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="{StaticResource Size.Text.Meta}" />
    </Style>

    <!--
        Status strip item. The strip used to be a run of TextBlocks with literal "  ·  " separators
        between them, so every item had to arrange its own spacing and nothing lined up. An item is
        a compact row with its own hit area: icon, label, and a tabular value where it has one.
    -->
    <Style x:Key="StatusItem" TargetType="Border">
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Sm}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>


    <!-- ===================== Inspector section rhythm ===================== -->
    <!--
        Sections are separated by space and a single hairline, not by nesting another bordered card
        inside the panel that already has a border. Card-in-panel was the main reason the inspector
        read as busy.
    -->
    <Style x:Key="InspectorSectionTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Display}" />
        <Setter Property="FontSize" Value="{StaticResource Size.Text.Body}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="Margin" Value="0,0,0,2" />
    </Style>

    <!--
        An editable heading. Reads as a section title at rest and only takes on field chrome when the
        pointer is over it or it has focus, so a renameable name does not need a permanent input box
        repeating what the list above already says.
    -->
    <Style x:Key="InlineTitleInput" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Display}" />
        <Setter Property="FontSize" Value="{StaticResource Size.Text.Section}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="6,0" />
        <Setter Property="Margin" Value="-6,0,0,0" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Field}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.PanelBorder}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Field}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.FocusRing}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="InspectorRule" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{DynamicResource Brush.PanelBorder}" />
        <Setter Property="Margin" Value="0,18,0,18" />
    </Style>

    <!--
        Palette swatch. The outer button is 28px for a comfortable pointer target while the colour
        chip itself stays 18px, and the active swatch gets a ring instead of leaving twelve identical
        squares with no indication of which one is in play. Hover changes the ring's colour rather
        than its thickness, so the chip does not shift by a pixel when the pointer crosses it.

        Shared rather than window-local since the layer palette moved out of the status strip and
        into the operation inspector, where the colour actually belongs.
    -->
    <Style x:Key="QuickLayerButton" TargetType="Button">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Margin" Value="1,0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Ring" CornerRadius="{StaticResource Radius.Sm}" BorderBrush="Transparent" BorderThickness="2" />
                        <Border x:Name="LayerColor" Width="18" Height="18" CornerRadius="{StaticResource Radius.Sm}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource Brush.PanelBorderStrong}" BorderThickness="1"
                                HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource Brush.PanelBorderStrong}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="LayerColor" Property="Opacity" Value="0.68" />
                        </Trigger>
                        <!-- Tag carries the "is this the selected layer's colour" MultiBinding. -->
                        <Trigger Property="Tag" Value="True">
                            <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                        </Trigger>
                        <Trigger Property="components:FocusVisual.IsVisible" Value="True">
                            <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource Brush.FocusRing}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="{StaticResource Opacity.Disabled}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Inspector section header: an uppercase micro-label with generous space above it. The Designer
        inspector uses these instead of stacking each group inside its own card — a panel that is
        itself a column of cards has two competing edges everywhere and reads as clutter.
    -->
    <!-- Same type scale as PanelTitle (16px/SemiBold/primary ink) — a prior audit found this style at
         a quarter the visual weight (12px/uppercase/secondary-ink), the clearest single signal that
         Home and the Designer inspector read as different products. VerticalAlignment stays local
         since, unlike PanelTitle, this header shares a row with reorder buttons at some call sites. -->
    <Style x:Key="InspectorGroupHeader" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Size.Text.Section}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="InspectorGroupDivider" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{DynamicResource Brush.PanelBorder}" />
    </Style>

    <!-- ==================================================================
         Kamil — the floating assistant.

         A floating surface is allowed slightly softer geometry than the editor chrome it sits over,
         because it has to read as a separate object rather than another docked panel. That is the
         only licence it takes: the colours, type, icons and control heights are the product's.
         ================================================================== -->

    <!-- Send. Square-ish and accent-filled, sized to sit inside the composer's 4px padding without
         making the composer taller than a standard control. -->
    <Style x:Key="Kamil.SendButton" TargetType="Button" BasedOn="{StaticResource Button.Primary}">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
    </Style>

    <!-- Header actions: new chat, minimize, close. Ghost until hovered, so the header stays quiet. -->
    <Style x:Key="Kamil.HeaderButton" TargetType="Button" BasedOn="{StaticResource Button.Ghost}">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="2,0,0,0" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
    </Style>

    <!-- A read-only context fact: screen, material, machine. Not a button — nothing happens when you
         press it, so it must not look pressable. -->
    <Style x:Key="Kamil.ContextChip" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.PanelRaised}" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Sm}" />
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- A follow-up or starter prompt. This one *is* pressable, so it carries a border — hover/press
         feedback comes from Button.Ghost's own inherited neutral wash, same as every other button in
         the app, rather than a per-kind accent color. -->
    <Style x:Key="Kamil.PromptChip" TargetType="Button" BasedOn="{StaticResource Button.Ghost}">
        <Setter Property="Background" Value="{DynamicResource Brush.Panel}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.PanelBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
