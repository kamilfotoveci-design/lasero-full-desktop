<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:components="clr-namespace:Lasero.App.Components"
                    xmlns:jobs="clr-namespace:Lasero.Core.Jobs;assembly=Lasero.Core"
                    xmlns:vm="clr-namespace:Lasero.App.ViewModels">
    <!-- Nav labels use TextPrimary, not TextSecondary — this is primary wayfinding text, not de-emphasised
         caption text. Reserve the muted tone for genuinely secondary content; a nav item that's merely
         "not currently selected" should not read as if it were disabled. -->
    <Style x:Key="NavButton" TargetType="Button">
        <Setter Property="Height" Value="44" />
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="FontSize" Value="{StaticResource Size.Text.Body}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="NavBackground" Background="{TemplateBinding Background}" CornerRadius="{StaticResource Radius.Md}" Padding="{TemplateBinding Padding}" />
                        <!-- Dedicated overlays keep hover/press feedback local to this instance and let
                             the active surface remain selected while the pointer passes over it. -->
                        <Border x:Name="NavHover" Background="{StaticResource Brush.HoverWash}" CornerRadius="{StaticResource Radius.Md}" Opacity="0" />
                        <Border x:Name="NavPress" Background="{StaticResource Brush.HoverWash}" CornerRadius="{StaticResource Radius.Md}" Opacity="0" />
                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Stretch"
                                          Margin="{TemplateBinding Padding}"
                                          Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                          ContentStringFormat="{TemplateBinding ContentStringFormat}" />
                        <!--
                            Active-screen marker. The selected item is a neutral wash, graphite text, a
                            heavier weight and a 2px graphite indicator on the leading edge.
                        -->
                        <Border x:Name="ActiveBar" Width="2" HorizontalAlignment="Left" Margin="0,8"
                                Background="Transparent" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="NavHover" Storyboard.TargetProperty="Opacity" To="0.05"
                                                         Duration="{StaticResource Motion.Fast}" EasingFunction="{StaticResource Ease.Out}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="NavHover" Storyboard.TargetProperty="Opacity" To="0"
                                                         Duration="{StaticResource Motion.Fast}" EasingFunction="{StaticResource Ease.Out}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="NavPress" Property="Opacity" Value="0.08" />
                        </Trigger>
                        <!-- The per-screen NavButton.* styles cannot reach a template element from a
                             Style trigger, so they flag the active item through Tag and the template
                             turns that into the marker bar. -->
                        <Trigger Property="Tag" Value="Active">
                            <Setter TargetName="ActiveBar" Property="Background" Value="{DynamicResource Brush.SelectedIndicator}" />
                        </Trigger>
                        <Trigger Property="components:FocusVisual.IsVisible" Value="True">
                            <Setter TargetName="NavBackground" Property="BorderBrush" Value="{DynamicResource Brush.FocusRing}" />
                            <Setter TargetName="NavBackground" Property="BorderThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.TextDisabled}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="InspectorSection" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.Panel}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.PanelBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Lg}" />
        <Setter Property="Padding" Value="{StaticResource Layout.CardPadding}" />
        <Setter Property="Margin" Value="0,0,0,16" />
    </Style>
    <!-- A 1px hairline separating adjacent zones in a horizontal bar (bottom job strip, selection
         toolbar) — shared so every bar uses the same divider instead of relying on Margin gaps alone. -->
    <Style x:Key="BarDivider" TargetType="Border">
        <Setter Property="Width" Value="1" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Margin" Value="8,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource Brush.PanelBorder}" />
    </Style>

    <!-- A screen section heading (Home: "Pokračovat v práci"). Larger than a card title so the page has
         three clear levels: page title, section, card. -->
    <Style x:Key="SectionHeading" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Display}" />
        <Setter Property="FontSize" Value="{StaticResource Size.Text.Heading}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="Margin" Value="0,16,0,16" />
    </Style>
    <Style x:Key="PanelTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Display}" />
        <Setter Property="FontSize" Value="{StaticResource Size.Text.Section}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>
    <Style x:Key="PrimaryAction" TargetType="Button" BasedOn="{StaticResource Button.Primary}">
        <Setter Property="Effect" Value="{x:Null}" />
    </Style>

    <!--
        Job controls are shared by the persistent bottom strip and the Designer inspector. Their
        visibility is presentation-only: the commands remain the sole source of CanExecute, so
        moving a button cannot weaken machine readiness or JobPreflight.

        Keep JobDangerButton before JobActiveStopButton. StaticResource lookup is declaration-order
        sensitive in WPF, and a forward reference crashes the app while loading this dictionary.
    -->
    <Style x:Key="JobPrimaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryAction}" />

    <!-- Rámovat and Spustit start something, so they exist on Návrh only (ScreenChrome.ShowLaunchControls).
         Pozastavit, Pokračovat and Zastavit below deliberately carry no screen trigger: a running job
         must be stoppable from every screen. -->
    <Style x:Key="JobIdleActionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding CurrentScreen}" Value="{x:Static vm:AppScreen.Home}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
            <DataTrigger Binding="{Binding CurrentScreen}" Value="{x:Static vm:AppScreen.Device}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
            <DataTrigger Binding="{Binding CurrentScreen}" Value="{x:Static vm:AppScreen.Chat}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
            <DataTrigger Binding="{Binding GCode.JobState}" Value="{x:Static jobs:JobRunState.Preparing}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
            <DataTrigger Binding="{Binding GCode.JobState}" Value="{x:Static jobs:JobRunState.Framing}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
            <DataTrigger Binding="{Binding GCode.JobState}" Value="{x:Static jobs:JobRunState.Running}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
            <DataTrigger Binding="{Binding GCode.JobState}" Value="{x:Static jobs:JobRunState.Paused}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="JobRunningActionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding GCode.JobState}" Value="{x:Static jobs:JobRunState.Running}"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="JobPausedActionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding GCode.JobState}" Value="{x:Static jobs:JobRunState.Paused}"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="JobDangerButton" TargetType="Button" BasedOn="{StaticResource Button.DangerSolid}" />

    <Style x:Key="JobStartActionButton" TargetType="Button" BasedOn="{StaticResource JobDangerButton}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding CurrentScreen}" Value="{x:Static vm:AppScreen.Home}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
            <DataTrigger Binding="{Binding CurrentScreen}" Value="{x:Static vm:AppScreen.Device}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
            <DataTrigger Binding="{Binding CurrentScreen}" Value="{x:Static vm:AppScreen.Chat}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
            <DataTrigger Binding="{Binding GCode.JobState}" Value="{x:Static jobs:JobRunState.Preparing}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
            <DataTrigger Binding="{Binding GCode.JobState}" Value="{x:Static jobs:JobRunState.Framing}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
            <DataTrigger Binding="{Binding GCode.JobState}" Value="{x:Static jobs:JobRunState.Running}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
            <DataTrigger Binding="{Binding GCode.JobState}" Value="{x:Static jobs:JobRunState.Paused}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="JobActiveStopButton" TargetType="Button" BasedOn="{StaticResource JobDangerButton}">
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding GCode.JobState}" Value="{x:Static jobs:JobRunState.Preparing}"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
            <DataTrigger Binding="{Binding GCode.JobState}" Value="{x:Static jobs:JobRunState.Framing}"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
            <DataTrigger Binding="{Binding GCode.JobState}" Value="{x:Static jobs:JobRunState.Running}"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
            <DataTrigger Binding="{Binding GCode.JobState}" Value="{x:Static jobs:JobRunState.Paused}"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Compatibility alias for older views; new UI should use PrimaryAction. -->
    <Style x:Key="PrimaryBlue" TargetType="Button" BasedOn="{StaticResource PrimaryAction}" />

    <!-- Cards sit on the canvas with the soft card shadow (ElevatedBorder draws it, see LaseroTheme.xaml "Depth"); the hairline stays so
         dashboard surfaces and editor chrome read as one consistent visual language rather than two. -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.Panel}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.PanelBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Lg}" />
        <Setter Property="Padding" Value="{StaticResource Layout.CardPadding}" />
    </Style>


    <!-- A card in a dense place (a narrow column, a dialog section): 20 instead of 24. Same radius and hairline. -->
    <Style x:Key="Card.Compact" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="Padding" Value="{StaticResource Layout.CardPaddingCompact}" />
    </Style>

    <!-- The empty state: ONE muted line of plain Czech that says what will appear and when. Never a box, an icon or a
         button (see the redundant entry points rules). The gap below it is the container's, not the line's. -->
    <Style x:Key="Text.EmptyLine" TargetType="TextBlock" BasedOn="{StaticResource Text.Muted}">
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0" />
    </Style>

    <!-- A quiet "what to do next" line, one per screen at most, under the content it refers to. Not a tip: it has no
         close button, no counter and no icon, and it is present only while the next step is unambiguous. -->
    <Style x:Key="Text.NextStep" TargetType="TextBlock" BasedOn="{StaticResource Text.Muted}">
        <Setter Property="FontSize" Value="{StaticResource Size.Text.Meta}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0" />
    </Style>
    <!-- An empty state: lighter than the primary actions. No fill, no shadow, a firmer hairline. -->
    <Style x:Key="Card.Empty" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.PanelBorderStrong}" />
    </Style>

    <Style x:Key="MetricCard" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="Padding" Value="20,16" />
        <Setter Property="MinHeight" Value="102" />
    </Style>

    <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Display}" />
        <Setter Property="FontSize" Value="{StaticResource Size.Text.Title}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="LineHeight" Value="38" />
    </Style>

    <Style x:Key="PageSubtitle" TargetType="TextBlock" BasedOn="{StaticResource Text.Muted}">
        <Setter Property="FontSize" Value="{StaticResource Size.Text.Body}" />
        <Setter Property="Margin" Value="0,4,0,0" />
    </Style>

    <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource Text.Muted}">
        <Setter Property="FontSize" Value="{StaticResource Size.Text.Meta}" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <Style x:Key="Button.Regular" TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
        <Setter Property="Height" Value="{StaticResource Size.Control.Base}" />
        <Setter Property="MinHeight" Value="{StaticResource Size.Control.Base}" />
    </Style>

    <!--
        A card's secondary "Otevřít vše" affordance. Chromeless and accent-coloured so it reads as
        the quiet way out of a section rather than competing with the card's own primary button —
        still a real Button, so it keeps keyboard focus and the accessible name a link would lose.
    -->

    <!--
        A quiet text action: tint text at rest, a deeper tint on hover (no underline), no fill, no outline. The ring
        appears for keyboard focus only (FocusVisual.IsVisible), never after a click, and the stock dotted
        FocusVisualStyle is switched off so nothing is drawn at rest. Used by the tips ("Další tip", the
        chip's close button).
    -->
    <Style x:Key="Button.Quiet" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Brush.TintText}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Ring" Background="Transparent" BorderBrush="Transparent" BorderThickness="2"
                            CornerRadius="{StaticResource Radius.Sm}" Padding="{TemplateBinding Padding}"
                            UseLayoutRounding="True" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Brush.TintText.Hover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Brush.Tint.Pressed}" />
                        </Trigger>
                        <Trigger Property="components:FocusVisual.IsVisible" Value="True">
                            <Setter TargetName="Ring" Property="BorderBrush" Value="{StaticResource Brush.FocusRing}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="{StaticResource Opacity.Disabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Button.Link" TargetType="Button" BasedOn="{StaticResource Button.Ghost}">
        <Setter Property="Foreground" Value="{StaticResource Brush.TintText}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Height" Value="{StaticResource Size.Control.Compact}" />
        <Setter Property="MinHeight" Value="{StaticResource Size.Control.Compact}" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Style.Triggers>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsEnabled" Value="True" />
                    <Condition Property="IsMouseOver" Value="True" />
                </MultiTrigger.Conditions>
                <Setter Property="Foreground" Value="{StaticResource Brush.TintText.Hover}" />
            </MultiTrigger>
        </Style.Triggers>
    </Style>

    <!-- Button.Link's ToggleButton counterpart. A WPF Style's TargetType must match the element it's
         applied to exactly (Button and ToggleButton are siblings under ButtonBase, not one another's
         subtype), so a disclosure toggle bound through IsChecked cannot reuse Button.Link directly —
         this repeats its look with a self-contained template instead of Button's default chrome. -->
    <Style x:Key="ToggleButton.Link" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{StaticResource Brush.TintText}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Height" Value="{StaticResource Size.Control.Compact}" />
        <Setter Property="MinHeight" Value="{StaticResource Size.Control.Compact}" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Surface" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                            CornerRadius="{StaticResource Radius.Sm}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource Brush.PanelRaised}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource Brush.PanelBorder}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource Brush.SelectedSurface}" />
                        </Trigger>
                        <Trigger Property="components:FocusVisual.IsVisible" Value="True">
                            <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource Brush.FocusRing}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="{StaticResource Opacity.Disabled}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Button.Large" TargetType="Button" BasedOn="{StaticResource Button.Primary}">
        <Setter Property="Height" Value="{StaticResource Size.Control.Large}" />
        <Setter Property="MinHeight" Value="{StaticResource Size.Control.Large}" />
        <Setter Property="Padding" Value="20,0" />
    </Style>
    <!--
        The quieter half of a hero's button row: same height as Button.Large so the row lines up, but
        a panel surface and normal text. It is based on Button.Secondary, not Button.Large: Button.Primary
        carries hover and press Background triggers that outrank any Background set here, which turned
        this button graphite with dark text under the pointer.
    -->
    <Style x:Key="Button.LargeSecondary" TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
        <Setter Property="Height" Value="{StaticResource Size.Control.Large}" />
        <Setter Property="MinHeight" Value="{StaticResource Size.Control.Large}" />
        <Setter Property="Padding" Value="20,0" />
    </Style>

    <Style x:Key="ThumbnailCard" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="Padding" Value="0" />
    </Style>

    <!-- A card that opens something: on hover it lifts 1px (ProjectCard) and its shadow deepens. -->
    <Style x:Key="ThumbnailCard.Clickable" TargetType="components:ElevatedBorder" BasedOn="{StaticResource ThumbnailCard}">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Elevation" Value="Raised" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===================== Numeric field with an integrated unit ===================== -->
    <!--
        "205.05 mm" reads as one control instead of an input plus a detached grey "mm" floating beside
        it. The shell owns the surface, border and focus ring; the TextBox inside is chromeless so the
        two never draw competing outlines. Focus is tracked with IsKeyboardFocusWithin because the
        element that actually takes focus is the inner input, not the shell.
    -->
    <Style x:Key="UnitField.Shell" TargetType="Border">
        <!-- Same surface and outline as TextBox and ComboBox (Brush.Field over Brush.PanelBorder). It used to be white over the
             strong outline, so a numeric field sat next to a grey text field and a grey select in the same inspector. -->
        <Setter Property="Background" Value="{DynamicResource Brush.Field}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.PanelBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Md}" />
        <Setter Property="Height" Value="{StaticResource Size.Control.Base}" />
        <Setter Property="Padding" Value="12,0" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.TextSecondary}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.FocusRing}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="{StaticResource Opacity.Disabled}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="UnitField.Input" TargetType="TextBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Numeric}" />
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
        <Setter Property="FontSize" Value="{StaticResource Size.Text.Body}" />
        <Setter Property="TextAlignment" Value="Right" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="CaretBrush" Value="{DynamicResource Brush.Tint}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Brush.TextSelection}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="UnitField.Suffix" TargetType="TextBlock" BasedOn="{StaticResource Text.Muted}">
        <Setter Property="Margin" Value="4,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>

    <!-- Row label inside the inspector's transform grid. -->
    <Style x:Key="TransformRowLabel" TargetType="TextBlock" BasedOn="{StaticResource Text.Muted}">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="{StaticResource Size.Text.Meta}" />
    </Style>

    <!--
        Status strip item. The strip used to be a run of TextBlocks with literal "  ·  " separators
        between them, so every item had to arrange its own spacing and nothing lined up. An item is
        a compact row with its own hit area: icon, label, and a tabular value where it has one.
    -->
    <Style x:Key="StatusItem" TargetType="Border">
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Sm}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>


    <!-- ===================== Inspector section rhythm ===================== -->
    <!--
        Sections are separated by space and a single hairline, not by nesting another bordered card
        inside the panel that already has a border. Card-in-panel was the main reason the inspector
        read as busy.
    -->
    <Style x:Key="InspectorSectionTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Display}" />
        <Setter Property="FontSize" Value="{StaticResource Size.Text.Body}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <!--
        An editable heading. Reads as a section title at rest and only takes on field chrome when the
        pointer is over it or it has focus, so a renameable name does not need a permanent input box
        repeating what the list above already says.
    -->
    <Style x:Key="InlineTitleInput" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Display}" />
        <Setter Property="FontSize" Value="{StaticResource Size.Text.Section}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="Margin" Value="-6,0,0,0" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Field}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.PanelBorder}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Field}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.FocusRing}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="InspectorRule" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{DynamicResource Brush.PanelBorder}" />
        <Setter Property="Margin" Value="0,20,0,20" />
    </Style>

    <!--
        Palette swatch. The outer button is 28px for a comfortable pointer target while the colour
        chip itself stays 18px, and the active swatch gets a ring instead of leaving twelve identical
        squares with no indication of which one is in play. Hover changes the ring's colour rather
        than its thickness, so the chip does not shift by a pixel when the pointer crosses it.

        Shared rather than window-local since the layer palette moved out of the status strip and
        into the operation inspector, where the colour actually belongs.
    -->
    <Style x:Key="QuickLayerButton" TargetType="Button">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Margin" Value="0,0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Ring" CornerRadius="{StaticResource Radius.Sm}" BorderBrush="Transparent" BorderThickness="2" />
                        <Border x:Name="LayerColor" Width="18" Height="18" CornerRadius="{StaticResource Radius.Sm}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource Brush.PanelBorderStrong}" BorderThickness="1"
                                HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource Brush.PanelBorderStrong}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="LayerColor" Property="Opacity" Value="0.68" />
                        </Trigger>
                        <!-- Tag carries the "is this the selected layer's colour" MultiBinding. -->
                        <Trigger Property="Tag" Value="True">
                            <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                        </Trigger>
                        <Trigger Property="components:FocusVisual.IsVisible" Value="True">
                            <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource Brush.FocusRing}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="{StaticResource Opacity.Disabled}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Inspector section header: an uppercase micro-label with generous space above it. The Designer
        inspector uses these instead of stacking each group inside its own card — a panel that is
        itself a column of cards has two competing edges everywhere and reads as clutter.
    -->
    <!-- Same type scale as PanelTitle (16px/SemiBold/primary ink) — a prior audit found this style at
         a quarter the visual weight (12px/uppercase/secondary-ink), the clearest single signal that
         Home and the Designer inspector read as different products. VerticalAlignment stays local
         since, unlike PanelTitle, this header shares a row with reorder buttons at some call sites. -->
    <Style x:Key="InspectorGroupHeader" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Display}" />
        <Setter Property="FontSize" Value="{StaticResource Size.Text.Section}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="InspectorGroupDivider" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{DynamicResource Brush.PanelBorder}" />
    </Style>

    <!-- ==================================================================
         Kamil — the floating assistant.

         A floating surface is allowed slightly softer geometry than the editor chrome it sits over,
         because it has to read as a separate object rather than another docked panel. That is the
         only licence it takes: the colours, type, icons and control heights are the product's.
         ================================================================== -->

    <!-- Send. Square-ish and accent-filled, sized to sit inside the composer's 4px padding without
         making the composer taller than a standard control. -->
    <Style x:Key="Kamil.SendButton" TargetType="Button" BasedOn="{StaticResource Button.Primary}">
        <Setter Property="Width" Value="{StaticResource Size.Control.Assistant.Send}" />
        <Setter Property="Height" Value="{StaticResource Size.Control.Assistant.Send}" />
        <Setter Property="MinHeight" Value="{StaticResource Size.Control.Assistant.Send}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
    </Style>

    <!-- Header actions: new chat, minimize, close. Ghost until hovered, so the header stays quiet. -->
    <Style x:Key="Kamil.HeaderButton" TargetType="Button" BasedOn="{StaticResource Button.Ghost}">
        <Setter Property="Width" Value="{StaticResource Size.Control.Assistant.Chip}" />
        <Setter Property="Height" Value="{StaticResource Size.Control.Assistant.Chip}" />
        <Setter Property="MinHeight" Value="{StaticResource Size.Control.Assistant.Chip}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="4,0,0,0" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
    </Style>


    <!-- KAMIL message text: the reading size (15 on a 22 line, about 1.47), with breathing room between
         lines. Paragraph gaps come from KamilMessageBody, not from this style. -->
    <Style x:Key="Kamil.MessageText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="FontSize" Value="{StaticResource Size.Text.Assistant.Body}" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
        <Setter Property="LineHeight" Value="{StaticResource Size.Text.Assistant.LineHeight}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Secondary KAMIL text (subtitle, hints). Secondary ink, not the fainter muted ink, so it keeps
         WCAG AA contrast at 14px. -->
    <Style x:Key="Kamil.MetaText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
        <Setter Property="FontSize" Value="{StaticResource Size.Text.Assistant.Meta}" />
    </Style>

    <!-- What Kamil can see (screen, material, machine) as one quiet line of text. Not a chip and not a
         band: nothing happens when it is pressed, so it carries no surface at all. -->
    <Style x:Key="Kamil.ContextLine" TargetType="TextBlock" BasedOn="{StaticResource Kamil.MetaText}">
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

    <!-- A follow-up or starter prompt. This one *is* pressable, so it carries a border — hover/press
         feedback comes from Button.Ghost's own inherited neutral wash, same as every other button in
         the app, rather than a per-kind accent color. -->
    <Style x:Key="Kamil.PromptChip" TargetType="Button" BasedOn="{StaticResource Button.Ghost}">
        <Setter Property="Background" Value="{DynamicResource Brush.Panel}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.PanelBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
        <Setter Property="FontSize" Value="{StaticResource Size.Text.Assistant.Meta}" />
        <Setter Property="Height" Value="{StaticResource Size.Control.Assistant.Chip}" />
        <Setter Property="MinHeight" Value="{StaticResource Size.Control.Assistant.Chip}" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Margin" Value="0,0,4,4" />
    </Style>

    <!-- ===================== Settings window: tabs, grouped rows, switch, typed number ===================== -->

    <!--
        A settings page: tabs in a strip with a hairline under it, a 2px tint indicator under the selected one (DESIGN.md
        "selected navigation and tab indicator"). Selection, keyboard navigation and content hosting stay the stock
        TabControl's; only the chrome is replaced. The tab text keeps one weight so selecting a tab never changes its width.
    -->
    <Style x:Key="Tab.Strip" TargetType="TabControl">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid KeyboardNavigation.TabNavigation="Local">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border BorderBrush="{DynamicResource Brush.PanelBorder}" BorderThickness="0,0,0,1" Padding="32,0,32,0">
                            <TabPanel IsItemsHost="True" Background="Transparent" />
                        </Border>
                        <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Row="1" ContentSource="SelectedContent" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Tab.Item" TargetType="TabItem">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
        <Setter Property="FontSize" Value="{StaticResource Size.Text.Body}" />
        <Setter Property="MinHeight" Value="{StaticResource Size.Control.Primary}" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Grid Background="Transparent">
                        <Border x:Name="FocusRing" Margin="4" CornerRadius="{StaticResource Radius.Sm}"
                                BorderBrush="{DynamicResource Brush.FocusRing}" BorderThickness="0" />
                        <ContentPresenter x:Name="HeaderHost" ContentSource="Header" Margin="{TemplateBinding Padding}"
                                          TextElement.Foreground="{DynamicResource Brush.TextSecondary}"
                                          TextElement.FontWeight="Medium"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                        <Border x:Name="Indicator" Height="2" VerticalAlignment="Bottom" Margin="16,0"
                                Background="{DynamicResource Brush.SelectedIndicator}" Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="HeaderHost" Property="TextElement.Foreground" Value="{DynamicResource Brush.TextPrimary}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="HeaderHost" Property="TextElement.Foreground" Value="{DynamicResource Brush.TextPrimary}" />
                            <Setter TargetName="Indicator" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="components:FocusVisual.IsVisible" Value="True">
                            <Setter TargetName="FocusRing" Property="BorderThickness" Value="2" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The small heading above a group of settings rows. Sentence case, one step quieter than the rows it names. -->
    <Style x:Key="SettingGroupTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Display}" />
        <Setter Property="FontSize" Value="{StaticResource Size.Text.Meta}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
        <Setter Property="Margin" Value="4,0,0,8" />
        <Setter Property="AutomationProperties.HeadingLevel" Value="Level2" />
    </Style>

    <!--
        On / off for a setting that changes a behaviour of the whole editor. This is the one place a switch is right:
        the checkbox style documents why object and import properties are squares. Checked is the solid tint (the
        one "on" colour), the thumb is white, and the track keeps a hairline when off so it reads on a white card.
        The label is the SettingRow beside it, so the switch itself carries no content and needs an accessible name.
    -->
    <Style x:Key="Toggle.Switch" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Width="36" Height="20" Background="Transparent">
                        <Border x:Name="FocusRing" Margin="-4" CornerRadius="{StaticResource Radius.Xs}"
                                BorderBrush="{DynamicResource Brush.FocusRing}" BorderThickness="0" />
                        <Border x:Name="Track" CornerRadius="{StaticResource Radius.Xs}"
                                Background="{DynamicResource Brush.ToggleTrackOff}"
                                BorderBrush="{DynamicResource Brush.ToggleTrackOffBorder}" BorderThickness="1" />
                        <Border x:Name="Thumb" Width="12" Height="12" Margin="4,0" HorizontalAlignment="Left"
                                CornerRadius="{StaticResource Radius.Xs}" Background="{DynamicResource Brush.OnAccent}">
                            <Border.RenderTransform><TranslateTransform x:Name="ThumbShift" /></Border.RenderTransform>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- Plain Setters carry the state (a switch already on when it loads must render on);
                             the storyboards only add the slide, as the checkbox style above does. -->
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource Brush.TextPrimary}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Brush.TextPrimary}" />
                            <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ThumbShift" Storyboard.TargetProperty="X" From="-16" To="0"
                                                         Duration="{StaticResource Motion.Toggle}" EasingFunction="{StaticResource Ease.Out}" FillBehavior="Stop" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ThumbShift" Storyboard.TargetProperty="X" From="16" To="0"
                                                         Duration="{StaticResource Motion.Toggle}" EasingFunction="{StaticResource Ease.Out}" FillBehavior="Stop" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsChecked" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource Brush.TextPrimary}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Brush.TextPrimary}" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsChecked" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Brush.TextSecondary}" />
                        </MultiTrigger>
                        <Trigger Property="components:FocusVisual.IsVisible" Value="True">
                            <Setter TargetName="FocusRing" Property="BorderThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="{StaticResource Opacity.Disabled}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        A typed number in a settings row: compact, right aligned, tabular figures, field surface from the stock TextBox.
        Commits on Enter or blur and reverts on Esc through the app-wide field behaviour (docs/interaction-rules.md 1.12).
        An invalid value turns the outline to the error colour; the reason is in the dialog footer. The stock red adorner
        is switched off so the outline is the only signal and nothing is drawn outside the field.
    -->
    <Style x:Key="SettingNumberInput" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="Width" Value="96" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Numeric}" />
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
        <Setter Property="FontSize" Value="{StaticResource Size.Text.Body}" />
        <Setter Property="TextAlignment" Value="Right" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="Validation.ErrorTemplate" Value="{x:Null}" />
        <Style.Triggers>
            <Trigger Property="Validation.HasError" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Danger}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="{StaticResource Opacity.Disabled}" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
