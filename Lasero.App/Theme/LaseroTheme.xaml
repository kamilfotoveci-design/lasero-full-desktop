<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:system="clr-namespace:System;assembly=System.Runtime"
                    xmlns:conv="clr-namespace:Lasero.App.Converters"
                    xmlns:components="clr-namespace:Lasero.App.Components">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Icons.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--
        Radius system. Four values, each with a job, so equivalent controls share a geometry instead
        of each screen inventing its own. Before this the app used 2, 3, 4, 5, 6, 7, 8, 9, 10 and 12
        more or less interchangeably, and icon buttons rendered as full circles while the text button
        beside them was 6 and the input beside that was 8.

        Xs  chips and swatches under ~18px, where 6 would read as a circle
        Sm  icon buttons, segments, list rows, small inner surfaces
        Md  buttons, inputs, selects, menu items — anything you type in or press
        Lg  panels, cards, dialogs, popups

        Genuinely circular things (numbered step badges, the toggle track) keep their own radius:
        those are circles by intent, not rounded rectangles that drifted.
    -->
    <CornerRadius x:Key="Radius.Xs">4</CornerRadius>
    <CornerRadius x:Key="Radius.Sm">6</CornerRadius>
    <CornerRadius x:Key="Radius.Md">8</CornerRadius>
    <CornerRadius x:Key="Radius.Lg">12</CornerRadius>
    <!--
        Pill means fully round, and it is the token for circles too: WPF clamps a radius to half the
        smaller side, so 999 on a 34x34 badge is a circle and on a 38x22 track is a pill. Hardcoding
        half the box (17, 11, 14) works only until someone resizes the box, and expressing a circle
        as Radius.Md works only until Md changes.

        Composite radii — a footer rounded on two corners, a chat bubble with one square corner —
        stay literal. XAML has no arithmetic, so a composite token would restate its scalar anyway.
    -->
    <CornerRadius x:Key="Radius.Pill">999</CornerRadius>

    <!--
        Graphite + warm white + laser red. Migrated 2026-09 from the previous neutral-graphite +
        cobalt-blue palette (see git history / DESIGN.md for the superseded table).

        Two roles that used to share one colour are now deliberately different colours:
        Brush.PrimaryAction (graphite, #181818) is ordinary buttons — Nový projekt, Připojit
        zařízení, Potvrdit. Brush.Accent (laser red, #E4513D) is the interaction/selection signal —
        canvas selection, keyboard focus, the active tool, active navigation. Painting both the same
        colour would make every button read as "selected," and painting every button red would burn
        out the one colour meant to mean "this is the thing you are on." This reverses an earlier,
        now-wrong simplification: Brush.PrimaryAction/PrimaryActionHover/OnPrimaryAction were removed
        in 2026-08 as duplicate names for Accent at *identical* values — that reasoning no longer
        holds now that the two roles carry genuinely different colours.

        Budget: roughly 75% neutral surfaces and text, 15-20% graphite, 2-5% laser red. Red is a
        controlled technical/brand accent, not a second UI background colour — no red cards, no red
        panels, no red gradients.
    -->

    <!-- Primary action: ordinary buttons. Graphite, not the interaction colour. -->
    <SolidColorBrush x:Key="Brush.PrimaryAction" Color="#181818" po:Freeze="False" />
    <SolidColorBrush x:Key="Brush.PrimaryActionHover" Color="#2E2E2E" po:Freeze="False" />
    <SolidColorBrush x:Key="Brush.PrimaryActionPressed" Color="#0F0F0F" po:Freeze="False" />
    <SolidColorBrush x:Key="Brush.OnPrimaryAction" Color="#FFFFFF" po:Freeze="False" />

    <!-- Interaction: selection, focus, the active tool, active navigation. Laser red — small,
         controlled, and never the fill of an ordinary button. -->
    <SolidColorBrush x:Key="Brush.Accent" Color="#E4513D" po:Freeze="False" />
    <SolidColorBrush x:Key="Brush.AccentHover" Color="#CC402E" po:Freeze="False" />
    <!-- Foreground/fill for anything drawn on top of the accent — including the scene canvas's
         resize and rotate handles (red outline, white core). SceneCanvas resolved this key with
         FindResource and it was never defined, so building the selection adorner threw
         ResourceReferenceKeyNotFoundException and took the whole app down via the global handler. -->
    <SolidColorBrush x:Key="Brush.OnAccent" Color="#FFFFFF" po:Freeze="False" />
    <!--
        Accent text. Same red as the fill on this light theme, but it is its own token because the
        two roles diverge the moment the chrome goes dark. Anything that *writes* in the accent
        colour binds here; fills, borders, focus rings and canvas selection bind to Brush.Accent.
    -->
    <SolidColorBrush x:Key="Brush.AccentText" Color="#E4513D" po:Freeze="False" />
    <!-- A very small warm-red tint, not a saturated fill — "selected" should read as a quiet tint
         plus a red border, the same relationship the old cobalt selection had to its own fill. -->
    <SolidColorBrush x:Key="Brush.SelectedSurface" Color="#FCECEA" po:Freeze="False" />
    <SolidColorBrush x:Key="Brush.SelectedBorder" Color="#F3C2B9" po:Freeze="False" />
    <SolidColorBrush x:Key="Brush.FocusRing" Color="#E4513D" po:Freeze="False" />

    <!-- Brand. The wordmark's red dot, and now also Brush.Accent's value — the brand identity pair
         is graphite (Brush.PrimaryAction) plus this red, per the 2026-09 brand direction. -->
    <SolidColorBrush x:Key="Brush.Brand" Color="#E4513D" po:Freeze="False" />

    <!-- Surfaces. Warm neutrals derived from #F7F6F3, not the previous cooler #F7F7F5 family. -->
    <SolidColorBrush x:Key="Brush.Background" Color="#F7F6F3" po:Freeze="False" />
    <SolidColorBrush x:Key="Brush.TitleBar" Color="#FFFFFF" po:Freeze="False" />
    <SolidColorBrush x:Key="Brush.Sidebar" Color="#FFFFFF" po:Freeze="False" />
    <SolidColorBrush x:Key="Brush.Panel" Color="#FFFFFF" po:Freeze="False" />
    <SolidColorBrush x:Key="Brush.PanelRaised" Color="#F1EFEA" po:Freeze="False" />
    <SolidColorBrush x:Key="Brush.Field" Color="#F1EFEA" po:Freeze="False" />
    <SolidColorBrush x:Key="Brush.PanelBorder" Color="#E6E3DC" po:Freeze="False" />
    <SolidColorBrush x:Key="Brush.PanelBorderStrong" Color="#D3CFC5" po:Freeze="False" />

    <!--
        Canvas. Its own tokens rather than the panel ones, because the bed does not follow the chrome:
        it stays white whatever the theme does, since the operator judges burn contrast against real
        material. The surround is the neutral field colour, so the bed reads as a sheet on a table.

        Grid no longer echoes the interaction colour (the old minor/major grid were both cobalt-tinted
        to match Brush.Accent). A red grid would compete with red-toned artwork and read as alarm
        colour on a calm technical surface, so both steps are warm neutral gray instead — major only
        slightly stronger than minor, never accent-coloured.
    -->
    <SolidColorBrush x:Key="Brush.Canvas.Surround" Color="#F1EFEA" po:Freeze="False" />
    <SolidColorBrush x:Key="Brush.Canvas.WorkArea" Color="#FFFFFF" po:Freeze="False" />
    <SolidColorBrush x:Key="Brush.Canvas.WorkAreaBorder" Color="#E6E3DC" po:Freeze="False" />
    <SolidColorBrush x:Key="Brush.Canvas.GridMinor" Color="#288A857C" po:Freeze="False" />
    <SolidColorBrush x:Key="Brush.Canvas.GridMajor" Color="#3D8A857C" po:Freeze="False" />

    <!-- Text. TextPrimary now matches the brand graphite exactly. -->
    <SolidColorBrush x:Key="Brush.TextPrimary" Color="#181818" po:Freeze="False" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="#5C5A54" po:Freeze="False" />
    <SolidColorBrush x:Key="Brush.TextMuted" Color="#8B887F" po:Freeze="False" />

    <!-- Disabled -->
    <SolidColorBrush x:Key="Brush.DisabledSurface" Color="#F0EEE8" po:Freeze="False" />
    <SolidColorBrush x:Key="Brush.TextDisabled" Color="#A6A29A" po:Freeze="False" />

    <!-- Semantic. Used for state, never for decoration. Unchanged by the 2026-09 palette migration
         on purpose: Brush.Danger must stay visually distinct from Brush.Accent/Brush.Brand now that
         the brand accent is also a red, so machine error/danger states are never mistaken for a
         brand moment. Brush.Info no longer borrows the interaction colour's value (it used to equal
         Brush.Accent by coincidence, back when Accent was cobalt) — information does not need its
         own hue, so it is graphite-neutral instead of either accent red or a third colour. -->
    <SolidColorBrush x:Key="Brush.Success" Color="#15803D" po:Freeze="False" />
    <SolidColorBrush x:Key="Brush.SuccessMuted" Color="#F0FDF4" po:Freeze="False" />
    <SolidColorBrush x:Key="Brush.Warning" Color="#D97706" po:Freeze="False" />
    <SolidColorBrush x:Key="Brush.WarningMuted" Color="#FFFBEB" po:Freeze="False" />
    <SolidColorBrush x:Key="Brush.Danger" Color="#DC2626" po:Freeze="False" />
    <SolidColorBrush x:Key="Brush.DangerMuted" Color="#FEF2F2" po:Freeze="False" />
    <SolidColorBrush x:Key="Brush.DangerBorder" Color="#FECACA" po:Freeze="False" />
    <SolidColorBrush x:Key="Brush.Info" Color="#4A473F" po:Freeze="False" />
    <SolidColorBrush x:Key="Brush.InfoMuted" Color="#F1EFEA" po:Freeze="False" />
    <SolidColorBrush x:Key="Brush.InfoBorder" Color="#E6E3DC" po:Freeze="False" />

    <!-- Component-level neutrals -->
    <!--
        Hover and press are one mechanic, not two: an ink wash over whatever the control already is,
        at 6% for hover and 14% for press (see the Button template). That is why there is no
        Brush.AccentPressed or Brush.DangerPressed — a per-kind pressed colour would be a second
        mechanic for the same state, and it would have to be re-derived for every new button kind.
        The wash works on a red fill, a graphite fill, a white surface and a transparent ghost alike
        — though on Brush.PrimaryAction's near-black fill the dark wash is necessarily subtle; the
        0.96 press-scale transform carries most of the felt feedback there. See Button.Primary below.
    -->
    <SolidColorBrush x:Key="Brush.HoverWash" Color="#181818" po:Freeze="False" />
    <SolidColorBrush x:Key="Brush.ToggleTrackOff" Color="#E6E3DC" po:Freeze="False" />
    <SolidColorBrush x:Key="Brush.ToggleTrackOffBorder" Color="#D3CFC5" po:Freeze="False" />
    <SolidColorBrush x:Key="Brush.ScrollThumb" Color="#D3CFC5" po:Freeze="False" />
    <SolidColorBrush x:Key="Brush.ScrollThumbHover" Color="#A6A29A" po:Freeze="False" />

    <!--
        Elevation ladder. Docked panels get a border, never a shadow — the canvas stays the focus.
        A single Shadow.Panel at opacity 0.32 / blur 34 used to serve all four jobs below, which made
        a dropdown as heavy as a modal and put a 34px blur under the canvas sheet.

        Sheet is paper on a desk, not a floating surface. Tooltip barely lifts. Dropdown is light.
        Modal is the only real one.
    -->
    <DropShadowEffect x:Key="Shadow.Sheet" Color="#181818" Opacity="0.10" BlurRadius="6" ShadowDepth="1" Direction="270" />
    <DropShadowEffect x:Key="Shadow.Tooltip" Color="#181818" Opacity="0.14" BlurRadius="12" ShadowDepth="2" Direction="270" />
    <DropShadowEffect x:Key="Shadow.Dropdown" Color="#181818" Opacity="0.16" BlurRadius="18" ShadowDepth="4" Direction="270" />
    <DropShadowEffect x:Key="Shadow.Modal" Color="#181818" Opacity="0.22" BlurRadius="48" ShadowDepth="14" Direction="270" />

    <!-- Motion language: responsive at the pointer, slightly slower for spatial change. Spring is
         deliberately high-damping: it is used only for the final 1-3% settle, never for travel or
         decorative bounce. This keeps the workbench tactile without making precision controls move. -->
    <Duration x:Key="Motion.VeryFast">0:0:0.09</Duration>
    <Duration x:Key="Motion.Fast">0:0:0.11</Duration>
    <Duration x:Key="Motion.Base">0:0:0.17</Duration>
    <Duration x:Key="Motion.Spatial">0:0:0.26</Duration>
    <!-- Dialogs and the largest sheet-style overlays only - not ordinary hover/press motion. -->
    <Duration x:Key="Motion.Panel">0:0:0.34</Duration>
    <!-- AutoReverse makes the complete breathe cycle 3.2 s. Use only for real activity. -->
    <Duration x:Key="Motion.Breathe">0:0:1.6</Duration>
    <CubicEase x:Key="Ease.Out" EasingMode="EaseOut" />
    <SineEase x:Key="Ease.Breathe" EasingMode="EaseInOut" />
    <BackEase x:Key="Ease.Spring" EasingMode="EaseOut" Amplitude="0.12" />

    <!-- 4pt spacing scale (4/8/12/16/20/24/32) — enforced as literal multiples throughout instead of ad hoc margins. -->

    <!-- Control heights. Three sizes only: Compact for dense toolbars and inline editors, Base for
         ordinary buttons/inputs, Large for a screen's primary action. Before these existed the app
         used 32/34/36/38/40/42/44 more or less interchangeably, which is why nothing lined up. -->
    <!--
        Type sizes. These exist because every view was picking its own literal FontSize: 12 for most
        body text, then 15/17/21/22/24/26/27 scattered across headings. Four steps cover the whole
        product, and nothing renders below Meta.
    -->
    <!-- Specimen size. The font preview is there to be judged as a shape, not read as body copy. -->
    <system:Double x:Key="Size.Text.Preview">30</system:Double>
    <system:Double x:Key="Size.Text.Title">24</system:Double>
    <system:Double x:Key="Size.Text.Section">16</system:Double>
    <system:Double x:Key="Size.Text.Body">13</system:Double>
    <system:Double x:Key="Size.Text.Meta">12</system:Double>

    <!--
        Icon sizes. Five steps, each with a job. Before these existed the app rendered icons at 10,
        12, 13, 14, 15, 16, 17, 18, 21, 22, 24, 25, 28 and 30 across 112 sites, and Glyph.Close alone
        appeared at four different sizes in the same dismiss role.

        Chrome  window buttons and dismiss glyphs — the one place below Sm, by platform convention
        Sm      inside compact controls and the status bar
        Md      toolbars and the navigation rail
        Lg      window and panel header identity, machine state
        Xl      empty-state and onboarding art
    -->
    <system:Double x:Key="Size.Icon.Chrome">12</system:Double>
    <system:Double x:Key="Size.Icon.Sm">16</system:Double>
    <system:Double x:Key="Size.Icon.Md">18</system:Double>
    <system:Double x:Key="Size.Icon.Lg">20</system:Double>
    <system:Double x:Key="Size.Icon.Xl">24</system:Double>
    <!-- Between Xl and Hero: a glyph that anchors a card or a status disc without becoming the
         full-height empty-state illustration Hero is meant for. -->
    <system:Double x:Key="Size.Icon.Xxl">48</system:Double>
    <!-- Hero-sized: only for a section illustration, never for a control. -->
    <system:Double x:Key="Size.Icon.Hero">72</system:Double>
    <!-- The exported SVG assets in docs/design/icons-custom all carry stroke-width 1.75. The renderer
         said 1.8, so the shipped icons and the design assets were never quite the same weight. -->
    <system:Double x:Key="Size.Icon.Stroke">1.75</system:Double>

    <system:Double x:Key="Size.Control.Compact">32</system:Double>
    <system:Double x:Key="Size.Control.Base">36</system:Double>
    <system:Double x:Key="Size.Control.Primary">38</system:Double>
    <system:Double x:Key="Size.Control.Large">44</system:Double>

    <!--
        Editor chrome geometry. The button is exactly tall enough for an 18px glyph over a caption at
        Size.Text.Meta — 4 + 18 + 5 + 16 + 4 — and no taller. It used to run to 54, which the active
        tool's tint then had to fill: with the captions collapsed that left a tall blue box around a
        small icon. At this height the collapsed button is a square instead.
    -->
    <system:Double x:Key="Size.Toolbar.ButtonMinWidth">48</system:Double>
    <system:Double x:Key="Size.Toolbar.ButtonHeight">48</system:Double>
    <system:Double x:Key="Size.Toolbar.Height">64</system:Double>

    <!--
        Segoe UI Variable is the native Windows UI face. Keeping the shell on the system variable
        family preserves ClearType/DPI hinting and avoids the heavy, uneven appearance of the
        imported display face at small WPF sizes. Neue Montreal remains available as a design asset,
        but is not forced onto every control until its WPF rasterization is separately validated.
    -->
    <FontFamily x:Key="Font.Ui">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="Font.Display">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="Font.Numeric">Segoe UI Variable Text, Segoe UI</FontFamily>
    <!-- Genuinely fixed-pitch content only: the GRBL console and raw G-code, where column position
         carries meaning. Not for ordinary numeric fields. -->
    <FontFamily x:Key="Font.Mono">Cascadia Mono,Consolas,Courier New</FontFamily>
    <!-- The dark-ink wordmark, for the light sidebar. LaseroWordmarkLight.png is the same mark cut
         for a dark chrome and stays in the project; this key is the single place to switch. -->
    <BitmapImage x:Key="Image.BrandWordmark" UriSource="/Lasero.App;component/Assets/LaseroWordmark.png" CacheOption="OnLoad" />
    <!-- Original 1254px transparent artwork supplied by the user. Decode once at 256px: enough for
         the 72-DIP presentation avatar at 200% DPI while avoiding a full 6MB decode per instance. -->
    <BitmapImage x:Key="Image.LaseroAvatarSource"
                 UriSource="/Lasero.App;component/Assets/LaseroAvatar.png"
                 DecodePixelWidth="256" CacheOption="OnLoad" />
    <!-- Compatibility alias: MainWindow and ChatView at this commit still paint the avatar through
         this key. Remove it together with the LaseroAvatar migration of those two views. -->
    <BitmapImage x:Key="Image.KamilAvatar" UriSource="/Lasero.App;component/Assets/LaseroAvatar.png"
                 DecodePixelWidth="256" CacheOption="OnLoad" />

    <!-- ===================== Base ===================== -->

    <!--
        This style matches Window itself, not the app's windows: WPF resolves an implicit style by the
        element's exact type, and every window here is a derived class (MainWindow, MaterialsWindow,
        …), so none of them ever picked it up. The light theme hid that, because the WPF default
        foreground is black and black was within a shade of TextPrimary. On the dark palette the same
        default turned every inherited heading and icon invisible. Each window root therefore sets
        Background and Foreground itself; the setters below only document the intended defaults.
    -->
    <Style TargetType="Window">
        <Setter Property="Background" Value="{StaticResource Brush.Background}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
        <Setter Property="FontSize" Value="{StaticResource Size.Text.Body}" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
        <Setter Property="TextOptions.TextHintingMode" Value="Fixed" />
    </Style>

    <!--
        There is deliberately no implicit TextBlock style here.

        It used to set Foreground to TextPrimary, and that one Setter broke every control that paints
        its content on a coloured surface. WPF resolves implicit styles for elements built inside a
        template against Application.Resources only, and a style Setter beats an inherited value - so
        the TextBlock a ContentPresenter builds for Content="Přidat text" took near-black from here
        instead of the white the primary button's own Foreground was handing down. Dark text on a
        cobalt button; black text on the dark tooltip surface. Anything that passed an explicit
        TextBlock or an IconLabel was fine, which is why it looked random.

        The default text colour comes from the Window style above instead. Control.Foreground is an
        inherited property, so it reaches every TextBlock in the window, and a control that sets its own
        Foreground correctly overrides it for its own content. Popups live in their own visual trees and
        do not inherit from the window: ComboBox, ComboBoxItem, MenuItem and ToolTip each set Foreground
        in their own styles, which is what covers them.
    -->

    <Style x:Key="Text.Muted" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
        <Setter Property="FontSize" Value="{StaticResource Size.Text.Body}" />
    </Style>

    <!-- Barely-there text for things like a layer's ordinal, where the value should be available
         but must not compete with the name beside it. -->
    <Style x:Key="Text.Faint" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
        <Setter Property="FontSize" Value="{StaticResource Size.Text.Meta}" />
    </Style>

    <Style x:Key="Text.Heading" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Display}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <!-- Was 11px, then 12px: a section heading that renders smaller than the body text under it
             reads as a caption, not a heading, and flattens the panel hierarchy. Body is 13, so 12
             was still losing that contest. -->
        <Setter Property="FontSize" Value="{StaticResource Size.Text.Body}" />
        <Setter Property="Margin" Value="0,0,0,10" />
    </Style>

    <!-- Tabular figures: every digit takes the same advance width, so coordinates, speeds and
         dimensions stay in vertical columns as the values change. This is what the monospace font
         was really being used for, without making the panel look like a terminal. -->
    <Style x:Key="Text.Numeric" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Numeric}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    </Style>

    <!-- ===================== Panels ===================== -->

    <!--
        Only ONE element in the whole app carries a drop shadow — the workspace/scene canvas (see
        WorkspaceCanvas.xaml) — that's the one deliberate focal point. Every other surface, editor
        chrome and dashboard cards alike, is flat/bordered: shadow-on-every-card is the single most
        reliable "generic template" tell. Dashboard cards (SharedUiStyles.xaml's Card/MetricCard/
        ThumbnailCard) converge on this same flat philosophy rather than carrying their own shadow.
    -->
    <Style x:Key="Badge" TargetType="Border">
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Sm}" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="Background" Value="{StaticResource Brush.PanelRaised}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.PanelBorder}" />
    </Style>

    <!-- ===================== Buttons ===================== -->

    <!--
        Every button is a 3-layer stack (base fill → hover wash → content) so
        hover/press feedback is a pure OPACITY fade on an always-instance-local
        overlay Border, never a Color animation on the (possibly StaticResource-
        shared) Background brush — animating a shared brush's Color would leak
        across every button using that resource at once.
    -->
    <Style TargetType="Button">
        <Setter Property="Background" Value="{StaticResource Brush.PanelRaised}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.PanelBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="MinHeight" Value="{StaticResource Size.Control.Base}" />
        <Setter Property="FontSize" Value="{StaticResource Size.Text.Body}" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <!-- The template below draws its own FocusRing border on IsKeyboardFocused; without nulling
             the default FocusVisualStyle, WPF layers its own dashed-rectangle adorner on top of it. -->
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="PressScale" />
                        </Grid.RenderTransform>
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource Radius.Md}" />
                        <Border x:Name="Hover"
                                Background="{StaticResource Brush.HoverWash}"
                                Opacity="0"
                                CornerRadius="{StaticResource Radius.Md}" />
                        <!--
                            Press has its own layer rather than sharing Hover's opacity. When the two
                            shared one, a click that opened a window left the wash at its pressed value
                            forever: the pointer leaves without WPF raising the hover exit, so nothing
                            ever animated it back and the button stayed a solid grey box. Two layers,
                            two independent triggers, no state either one can strand.
                        -->
                        <Border x:Name="Press"
                                Background="{StaticResource Brush.HoverWash}"
                                Opacity="0"
                                CornerRadius="{StaticResource Radius.Md}" />
                        <Border x:Name="FocusRing"
                                BorderBrush="{StaticResource Brush.FocusRing}"
                                BorderThickness="0"
                                CornerRadius="{StaticResource Radius.Md}" />
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Margin="{TemplateBinding Padding}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0.06" Duration="{StaticResource Motion.Fast}" EasingFunction="{StaticResource Ease.Out}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource Motion.Fast}" EasingFunction="{StaticResource Ease.Out}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="Opacity" To="0.08" Duration="{StaticResource Motion.VeryFast}" />
                                        <DoubleAnimation Storyboard.TargetName="PressScale" Storyboard.TargetProperty="ScaleX" To="0.975" Duration="{StaticResource Motion.VeryFast}" EasingFunction="{StaticResource Ease.Out}" />
                                        <DoubleAnimation Storyboard.TargetName="PressScale" Storyboard.TargetProperty="ScaleY" To="0.975" Duration="{StaticResource Motion.VeryFast}" EasingFunction="{StaticResource Ease.Out}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource Motion.Fast}" EasingFunction="{StaticResource Ease.Out}" />
                                        <DoubleAnimation Storyboard.TargetName="PressScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="{StaticResource Motion.Base}" EasingFunction="{StaticResource Ease.Spring}" />
                                        <DoubleAnimation Storyboard.TargetName="PressScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="{StaticResource Motion.Base}" EasingFunction="{StaticResource Ease.Spring}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusRing" Property="BorderThickness" Value="2" />
                        </Trigger>
                        <!--
                            Disabled is a described state, not a faded one. Opacity 0.35 made a
                            control look half-rendered — the operator reads that as "broken", not as
                            "not available yet". A flat disabled surface with disabled text keeps the
                            shape legible, and the pointer stops promising it can be pressed.
                        -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource Brush.DisabledSurface}" />
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource Brush.PanelBorder}" />
                            <Setter Property="Foreground" Value="{StaticResource Brush.TextDisabled}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                        <!-- Declared after the trigger above so it wins: a ghost button has no
                             surface to keep legible, and drawing one only when the command is
                             unavailable makes the dead controls the loudest in the row. -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsEnabled" Value="False" />
                                <Condition Property="components:ButtonChrome.SuppressDisabledSurface" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Bg" Property="Background" Value="Transparent" />
                            <Setter TargetName="Bg" Property="BorderBrush" Value="Transparent" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Flat, no glow — the file-level comment on the "Panel" style above already commits this app to
         exactly one shadow (the canvas). A permanent red glow under every primary button contradicted
         that rule and read as generic AI-glow styling rather than restrained Windows 11 chrome. -->
    <!-- Primary is graphite, not the red interaction colour — see the palette comment at the top of
         this file. Its near-black fill makes the shared dark hover/press wash too subtle to read on
         its own, so this style also swaps the Button's own Background/BorderBrush on IsMouseOver/
         IsPressed (a plain Style.Trigger property setter, not TargetName — Style triggers cannot
         address a named template part, only ControlTemplate triggers can) — the base template's "Bg"
         Border reads both via TemplateBinding, so this needs no template of its own. -->
    <Style x:Key="Button.Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource Brush.PrimaryAction}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.PrimaryAction}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.OnPrimaryAction}" />
        <Setter Property="MinHeight" Value="{StaticResource Size.Control.Primary}" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Display}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Brush.PrimaryActionHover}" />
                <Setter Property="BorderBrush" Value="{StaticResource Brush.PrimaryActionHover}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource Brush.PrimaryActionPressed}" />
                <Setter Property="BorderBrush" Value="{StaticResource Brush.PrimaryActionPressed}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Secondary is the default action on a neutral surface: quiet fill, explicit edge, medium
         label. Outline carries the same geometry for contexts where the surrounding surface already
         supplies enough contrast. Both remain native Buttons, so command and CanExecute semantics are
         identical to the implicit style. -->
    <Style x:Key="Button.Secondary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource Brush.Panel}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.PanelBorderStrong}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
        <Setter Property="FontWeight" Value="Medium" />
    </Style>

    <Style x:Key="Button.Outline" TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.PanelBorderStrong}" />
    </Style>

    <!-- Icon buttons are square at the shared Base height so they line up with text buttons and
         inputs on the same row. Call sites used to override this to 32/36/40 individually. -->
    <Style x:Key="Button.Icon" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Width" Value="{StaticResource Size.Control.Compact}" />
        <Setter Property="Height" Value="{StaticResource Size.Control.Compact}" />
        <Setter Property="Padding" Value="7" />
        <Setter Property="Margin" Value="0,0,6,0" />
    </Style>

    <!-- Ghost: no fill, no border until hover. For dense clusters where a full bordered button per
         action would turn the row into a grid of boxes. -->
    <Style x:Key="Button.Ghost" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="components:ButtonChrome.SuppressDisabledSurface" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <Style x:Key="Button.GhostIcon" TargetType="Button" BasedOn="{StaticResource Button.Icon}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <!-- Tool is the shared 36px square for editor rails and compact contextual toolbars. Icon is
         intentionally 32px for inline/title-bar actions; Tool gives the canvas chrome a little more
         hit area without turning it into a stack of cards. -->
    <Style x:Key="Button.Tool" TargetType="Button" BasedOn="{StaticResource Button.Ghost}">
        <Setter Property="Width" Value="{StaticResource Size.Control.Base}" />
        <Setter Property="Height" Value="{StaticResource Size.Control.Base}" />
        <Setter Property="MinHeight" Value="{StaticResource Size.Control.Base}" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="Margin" Value="0,1" />
    </Style>

    <!--
        Per-row state icon (layer output / layer visibility). Compact and chromeless so a list of
        rows does not turn into a grid of controls: the state is carried by the glyph itself
        (bolt vs struck-through bolt, eye vs struck-through eye) plus colour, never colour alone.
    -->
    <Style x:Key="Toggle.LayerState" TargetType="ToggleButton">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Surface" Background="Transparent" CornerRadius="{StaticResource Radius.Sm}" BorderBrush="Transparent" BorderThickness="1">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{StaticResource Brush.PanelBorder}" />
                            <Setter Property="Foreground" Value="{StaticResource Brush.AccentText}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource Brush.FocusRing}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Square icon toggle. Same footprint as Button.Icon so it lines up in a row of icon buttons,
         with an on-state in the one interaction colour rather than a second switch idiom. -->
    <Style x:Key="Toggle.Icon" TargetType="ToggleButton">
        <Setter Property="Width" Value="{StaticResource Size.Control.Base}" />
        <Setter Property="Height" Value="{StaticResource Size.Control.Base}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Surface" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="{StaticResource Radius.Sm}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{StaticResource Brush.PanelRaised}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{StaticResource Brush.SelectedSurface}" />
                            <Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource Brush.SelectedBorder}" />
                            <Setter Property="Foreground" Value="{StaticResource Brush.AccentText}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource Brush.FocusRing}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Button.Jog" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Width" Value="52" />
        <Setter Property="Height" Value="52" />
        <Setter Property="Padding" Value="14" />
        <Setter Property="Margin" Value="3" />
    </Style>

    <Style x:Key="Button.JogCenter" TargetType="Button" BasedOn="{StaticResource Button.Jog}">
        <Setter Property="Background" Value="{StaticResource Brush.SelectedSurface}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
    </Style>

    <!--
        Destructive/abort controls. The border used to be #4D2323 — a near-black maroon carried over
        from a dark theme, which on warm paper just read as a dirty grey outline and made Stop look
        like any other secondary button. A tinted surface plus a red border makes an abort control
        distinguishable at a glance without shouting; the solid variant below is for the one case
        where stopping the machine is the primary action on screen.
    -->
    <Style x:Key="Button.Danger" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Foreground" Value="{StaticResource Brush.Danger}" />
        <Setter Property="Background" Value="{StaticResource Brush.DangerMuted}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.DangerBorder}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="Button.DangerSolid" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Foreground" Value="{StaticResource Brush.OnAccent}" />
        <Setter Property="Background" Value="{StaticResource Brush.Danger}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Danger}" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Display}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- Title bar chrome buttons: flat until hover. The hover fill used to be #22242C — a dark-theme
         value that painted a near-black block behind a grey glyph on this white title bar, hiding the
         icon exactly when the pointer was on it. -->
    <!--
        The rail's edge handle. It straddles the rail's right border at mid-height, which is where a
        panel that resizes itself is expected to offer the grip - the same place the splitter on the
        other side of the workspace lives. The hamburger this replaces sat at the head of the rail and
        had the wrong shape for the job: three stacked lines is the icon for "here is a menu", not for
        "this edge moves", and at the top of the rail it read as a sixth navigation item.

        The chevron points the way the edge will travel and rotates 180° rather than swapping between
        two glyphs, so the same mark turns round instead of one mark being replaced by another. 220ms
        CubicEase EaseInOut, matching the rail it belongs to: this is on-screen movement, and the handle
        and the panel have to look like one gesture.

        Pill, not Radius.Sm: it is a circular grip sitting on a line, and Radius.Pill is the token for
        anything genuinely round.
    -->
    <!--
        A ring that appears for keyboard focus and not for a mouse click. WPF applies FocusVisualStyle
        only when focus arrived from the keyboard, which is the behaviour CSS spells :focus-visible and
        the reason to use it instead of an IsKeyboardFocused trigger: that trigger cannot tell a Tab from
        a click, so a control clicked with the mouse kept a cobalt ring until focus moved elsewhere.

        Drawn outside the control rather than replacing its border, so nothing about the control's own
        geometry shifts when it takes focus.
    -->
    <Style x:Key="FocusRing.Pill">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border BorderBrush="{DynamicResource Brush.FocusRing}" BorderThickness="2"
                            CornerRadius="{StaticResource Radius.Pill}" Margin="-3" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Button.RailHandle" TargetType="Button">
        <Setter Property="Width" Value="22" />
        <Setter Property="Height" Value="22" />
        <Setter Property="Background" Value="{DynamicResource Brush.Panel}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.PanelBorderStrong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing.Pill}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource Radius.Pill}"
                                SnapsToDevicePixels="True" />
                        <Path x:Name="Chevron" Data="{DynamicResource Glyph.ChevronLeft}"
                              Stroke="{TemplateBinding Foreground}"
                              StrokeThickness="{StaticResource Size.Icon.Stroke}"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Stretch="Uniform" Width="8" Height="8"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              RenderTransformOrigin="0.5,0.5">
                            <Path.RenderTransform>
                                <RotateTransform Angle="0" />
                            </Path.RenderTransform>
                        </Path>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Brush.PanelRaised}" />
                            <Setter TargetName="Chevron" Property="Stroke" Value="{DynamicResource Brush.TextPrimary}" />
                        </Trigger>
                        <!-- No IsKeyboardFocused trigger here: FocusVisualStyle above already draws the
                             ring, and only for keyboard focus. The trigger version stayed lit after an
                             ordinary mouse click, which read as the handle being switched on. -->

                        <!-- Collapsed: the edge will travel right, so the chevron turns to face right.
                             Expanded is the resting state, so only one direction is scripted. -->
                        <DataTrigger Binding="{Binding IsNavCollapsed}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Chevron" Duration="0:0:0.22"
                                                         Storyboard.TargetProperty="RenderTransform.Angle" To="180">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Chevron" Duration="0:0:0.22"
                                                         Storyboard.TargetProperty="RenderTransform.Angle" To="0">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The click TARGET stays the full 46x32 caption-height rectangle (Fitts's law — a title-bar
         button is easiest to hit flush against the screen edge), but the visual hover/focus fill is
         inset with a rounded corner rather than painting that whole rectangle edge-to-edge. A
         full-bleed square hover fill read as a harsh, cropped-looking block jammed into the window's
         corner, out of step with the rounded language (Radius.Sm/Md/Lg/Pill) used everywhere else. -->
    <Style x:Key="Button.Chrome" TargetType="Button">
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Arrow" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}" Margin="4" CornerRadius="{StaticResource Radius.Sm}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource Brush.PanelRaised}" />
                            <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource Brush.PanelRaised}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Close follows the Windows convention: red fill, white glyph. It was inheriting the blue
         selection accent, which is the colour this app uses for "selected", not "will close". -->
    <Style x:Key="Button.ChromeClose" TargetType="Button" BasedOn="{StaticResource Button.Chrome}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}" Margin="4" CornerRadius="{StaticResource Radius.Sm}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource Brush.Danger}" />
                            <Setter Property="Foreground" Value="{StaticResource Brush.OnAccent}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource Brush.DangerMuted}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- ===================== Checkbox ===================== -->
    <!--
        A real checkbox: a small square that takes a tick.

        This was a sliding iOS-style switch. A switch suits a setting that turns a behaviour on and off
        for the whole app, but almost nothing here is that: these are properties of the selected object
        or of the import in front of you. A 40x22 pill next to a 32px numeric field reads as a piece of
        hardware bolted onto the row, and half a dozen of them turn a panel into a switchboard.
        LightBurn, Illustrator and CorelDRAW all use a square in the same places.

        One accent colour, and state is never carried by colour alone: checked is a filled square with
        a tick in it, so the shape says as much as the fill does.
    -->
    <Style TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="FontSize" Value="{StaticResource Size.Text.Body}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <!-- Transparent root with MinHeight so the label and the space around it are part
                         of the click target, not just the 18px box. -->
                    <StackPanel Orientation="Horizontal" Background="Transparent"
                                MinHeight="{StaticResource Size.Control.Compact}" VerticalAlignment="Center">
                        <Border x:Name="Box" Width="18" Height="18"
                                CornerRadius="{StaticResource Radius.Xs}"
                                Background="{DynamicResource Brush.Panel}"
                                BorderBrush="{DynamicResource Brush.PanelBorderStrong}"
                                BorderThickness="1"
                                VerticalAlignment="Center">
                            <Path x:Name="Tick"
                                  Data="{StaticResource Glyph.Check}"
                                  Stroke="{DynamicResource Brush.OnAccent}"
                                  StrokeThickness="2.6"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Stretch="Uniform" Margin="3.5"
                                  Opacity="0" />
                        </Border>
                        <ContentPresenter x:Name="Label" Margin="8,0,0,0"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Left" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <!-- Plain Setters, not an animation. The switch style above documents why: a
                             control that was already checked when its template was applied rendered in
                             the off colours forever when the checked look existed only in
                             Trigger.EnterActions. -->
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource Brush.Accent}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                            <Setter TargetName="Tick" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Brush.TextSecondary}" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsChecked" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource Brush.AccentHover}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Brush.AccentHover}" />
                        </MultiTrigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Brush.FocusRing}" />
                            <Setter TargetName="Box" Property="BorderThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- ===================== Segmented control (2-choice RadioButton pair) ===================== -->

    <!--
        Segmented choice. The selected segment used to be a pale grey fill on a pale grey track,
        which on the layer's processing mode meant the difference between "cut" and "engrave" — two
        completely different machine behaviours — was told by about one shade of grey.

        Selected now says so four ways: white surface, accent border, accent text and a heavier
        weight. Hover is a neutral wash and deliberately shares nothing with it, so hovering an
        unselected segment can never be mistaken for having chosen it.
    -->
    <Style x:Key="Segment" TargetType="RadioButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="FontSize" Value="{StaticResource Size.Text.Body}" />
        <Setter Property="Height" Value="30" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bg" CornerRadius="{StaticResource Radius.Sm}" Background="Transparent"
                            BorderBrush="Transparent" BorderThickness="1"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource Brush.PanelBorder}" />
                            <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
                        </Trigger>
                        <!--
                            Declared after hover so a hovered selected segment still reads as selected.

                            Selected is the tinted surface with blue text, not a solid cobalt block.
                            A segment strip is a choice among peers, not a call to action: filling it
                            solid put several large saturated rectangles on screen at once — the
                            inspector tab, the machine sub-tab, a mode switch — each competing with
                            Start, which is the one control that has earned that weight. It also made
                            the labels sitting next to those blocks hard to read against them.

                            This is also now the same "selected" language as the active tool and the
                            selected layer row, so one visual idea means selected everywhere.
                        -->
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource Brush.SelectedSurface}" />
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource Brush.SelectedBorder}" />
                            <Setter Property="Foreground" Value="{StaticResource Brush.AccentText}" />
                            <Setter Property="FontWeight" Value="Medium" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource Brush.FocusRing}" />
                            <Setter TargetName="Bg" Property="BorderThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource Brush.TextDisabled}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- For segment strips of three or four options in a narrow panel, where the default 12px side
         padding is what pushes the labels into a clip. -->
    <Style x:Key="Segment.Compact" TargetType="RadioButton" BasedOn="{StaticResource Segment}">
        <Setter Property="Padding" Value="4,5" />
    </Style>

    <Style x:Key="SegmentedTrack" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Brush.Field}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.PanelBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Md}" />
        <Setter Property="Padding" Value="2" />
    </Style>

    <!-- ===================== Inputs ===================== -->

    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource Brush.Field}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.PanelBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="MinHeight" Value="{StaticResource Size.Control.Base}" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="CaretBrush" Value="{StaticResource Brush.Accent}" />
        <Setter Property="SelectionBrush" Value="{StaticResource Brush.SelectedSurface}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource Radius.Md}">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="PasswordBox">
        <Setter Property="Background" Value="{StaticResource Brush.Field}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.PanelBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="MinHeight" Value="{StaticResource Size.Control.Base}" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="CaretBrush" Value="{StaticResource Brush.Accent}" />
        <Setter Property="SelectionBrush" Value="{StaticResource Brush.SelectedSurface}" />
        <Setter Property="PasswordChar" Value="●" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource Radius.Md}">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Background" Value="{StaticResource Brush.Field}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.PanelBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="MinHeight" Value="{StaticResource Size.Control.Base}" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="Toggle"
                                      Background="{TemplateBinding Background}"
                                      BorderBrush="{TemplateBinding BorderBrush}"
                                      BorderThickness="{TemplateBinding BorderThickness}"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                      ClickMode="Press">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <!-- The chevron used to carry RotateTransform Angle="180", so a
                                         closed dropdown pointed UP — the universal "already open"
                                         signal. It now points down at rest and flips only while the
                                         popup is actually open. -->
                                    <Border x:Name="FieldBg" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource Radius.Md}">
                                        <Grid Margin="{TemplateBinding Padding}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="16" />
                                            </Grid.ColumnDefinitions>
                                            <Path x:Name="Chevron" Grid.Column="1" Data="{StaticResource Glyph.ChevronDown}" Stroke="{StaticResource Brush.TextSecondary}" StrokeThickness="1.6" StrokeLineJoin="Round" Stretch="Uniform" Width="10" Height="10" RenderTransformOrigin="0.5,0.5" />
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="FieldBg" Property="BorderBrush" Value="{StaticResource Brush.TextSecondary}" />
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="FieldBg" Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                                            <Setter TargetName="Chevron" Property="RenderTransform">
                                                <Setter.Value>
                                                    <RotateTransform Angle="180" />
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                          Margin="{TemplateBinding Padding}" HorizontalAlignment="Left" VerticalAlignment="Center" />
                        <Popup x:Name="Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                            <Border Background="{StaticResource Brush.Panel}" BorderBrush="{StaticResource Brush.PanelBorder}" BorderThickness="1" CornerRadius="{StaticResource Radius.Lg}" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="240" Effect="{StaticResource Shadow.Dropdown}">
                                <ScrollViewer Margin="4">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Toggle" Property="BorderBrush" Value="{StaticResource Brush.FocusRing}" />
                            <Setter TargetName="Toggle" Property="BorderThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                            <Setter TargetName="ContentSite" Property="TextElement.Foreground" Value="{StaticResource Brush.TextSecondary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        A select that opens something richer than a list of strings. The inspector's Materiál row has
        to offer two groups (the catalogue for the connected machine, and the operator's own saved
        recipes) with speed and power quoted on every entry, which a ComboBox of items cannot show
        without becoming a second control. This keeps the field chrome and the chevron so it reads as
        a select in a column of selects, and leaves what it opens to the caller.
    -->
    <Style x:Key="Field.Select" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource Brush.Panel}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.PanelBorderStrong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Height" Value="{StaticResource Size.Control.Base}" />
        <Setter Property="MinHeight" Value="{StaticResource Size.Control.Base}" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="FontSize" Value="{StaticResource Size.Text.Body}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource Radius.Md}">
                        <Grid Margin="{TemplateBinding Padding}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left" />
                            <Path Grid.Column="1" Data="{DynamicResource Glyph.ChevronDown}"
                                  Stroke="{DynamicResource Brush.TextSecondary}" StrokeThickness="1.6"
                                  StrokeLineJoin="Round" Stretch="Uniform" Width="10" Height="10"
                                  HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource Brush.TextSecondary}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource Brush.FocusRing}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bg" Background="Transparent" CornerRadius="{StaticResource Radius.Sm}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- IsHighlighted is the item the pointer or arrow key is over, not the answer.
                             It used to wear the cobalt selection tint, so hovering a dropdown looked
                             exactly like having picked something. Hover is a neutral wash. -->
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource Brush.Field}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource Brush.SelectedSurface}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Menu bar ===================== -->
    <!-- WPF's default Menu/MenuItem chrome is the classic Win32 blue-highlight look, which would
         clash with every other flat, custom-templated control in this theme — this mirrors the same
         hover-wash/no-3D-border language as the Button style above. Only top-level headers with a flat
         submenu of leaf items are needed anywhere in this app, so a single Placement="Bottom" popup is
         enough — there's no cascading sub-submenu case to handle. -->
    <Style TargetType="Menu">
        <Setter Property="Background" Value="{DynamicResource Brush.Panel}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="FontSize" Value="{StaticResource Size.Text.Body}" />
    </Style>

    <Style TargetType="Separator">
        <Setter Property="Background" Value="{DynamicResource Brush.PanelBorder}" />
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="4,4" />
    </Style>

    <!--
        The ContextMenu container itself. MenuItem and its submenus were styled, but the top-level
        menu was still stock WPF chrome: square corners, a flat grey hairline, no shadow, and the
        classic left gutter reserved for icons and check marks that nothing in this app puts there.
        So the zoom presets and the material recipe menu opened as a Windows-95 box hanging off a
        panel with 12px corners.

        HasDropShadow stays True on purpose: it is what makes the underlying Popup allow
        transparency, without which a rounded corner has nothing to be rounded against. The system
        shadow it would otherwise draw lives in the template being replaced here, so only
        Shadow.Dropdown survives — the same shadow the ComboBox popup and the submenu popup use.
    -->
    <Style TargetType="ContextMenu">
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="FontSize" Value="{StaticResource Size.Text.Body}" />
        <Setter Property="HasDropShadow" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{DynamicResource Brush.Panel}"
                            BorderBrush="{DynamicResource Brush.PanelBorder}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource Radius.Lg}"
                            Padding="4"
                            MinWidth="180"
                            Effect="{StaticResource Shadow.Dropdown}">
                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="MinHeight" Value="{StaticResource Size.Control.Compact}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Grid>
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="{StaticResource Radius.Sm}">
                            <ContentPresenter x:Name="HeaderHost" ContentSource="Header" RecognizesAccessKey="True"
                                              Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                        </Border>
                        <Popup x:Name="Popup" Placement="Bottom" IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                               AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                            <Border Background="{DynamicResource Brush.Panel}" BorderBrush="{DynamicResource Brush.PanelBorder}" BorderThickness="1" CornerRadius="{StaticResource Radius.Lg}" Padding="4" Effect="{StaticResource Shadow.Dropdown}" MinWidth="180">
                                <StackPanel IsItemsHost="True" />
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Brush.Field}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Progress ===================== -->

    <!--
        A light tooltip, not a dark one.

        It used to be near-white text on a near-black surface, and it rendered as a solid black block
        with no readable text in almost every case. The reason is a WPF rule rather than a typo: this
        theme sets Foreground on an implicit TextBlock style, and WPF resolves implicit styles for
        elements built inside a template against Application.Resources only - a style declared in the
        template's own resources is never consulted. So the TextBlock a ContentPresenter builds for a
        plain string tooltip always took the app-wide near-black foreground, and TextElement.Foreground
        on the template lost, because inheritance loses to a style Setter.

        Fighting that needs either a content template per content type or a colour the app-wide style
        already agrees with. The second is simpler and it is also the right answer for this palette,
        which is 90% neutral and light throughout: a dark tooltip was the only dark surface in the
        product. Text stays TextPrimary, exactly what the implicit style sets, so there is nothing left
        to lose an inheritance race.

        Tooltips whose content is an explicit TextBlock were readable before and stay readable: an
        explicit Style suppresses the implicit one, so those inherited the intended colour. That is why
        the failure looked intermittent rather than total.
    -->
    <Style TargetType="ToolTip">
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
        <Setter Property="Background" Value="{StaticResource Brush.Panel}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.PanelBorderStrong}" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="HasDropShadow" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource Radius.Sm}"
                            Padding="{TemplateBinding Padding}"
                            TextElement.Foreground="{TemplateBinding Foreground}">
                        <Border.Resources>
                            <!--
                                A DataTemplate for string content, so a long tooltip wraps instead of
                                running off the screen. Unlike an implicit Style, an implicit
                                DataTemplate IS resolved through the normal resource lookup from the
                                ContentPresenter's own position in the tree, so declaring it here works.
                                Tooltips whose content is a UIElement are untouched by it.
                            -->
                            <DataTemplate DataType="{x:Type system:String}">
                                <TextBlock Text="{Binding}" TextWrapping="Wrap" MaxWidth="340"
                                           Foreground="{DynamicResource Brush.TextPrimary}" />
                            </DataTemplate>
                        </Border.Resources>
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ProgressBar">
        <Setter Property="Background" Value="{StaticResource Brush.Field}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.AccentText}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Height" Value="6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid x:Name="Root" ClipToBounds="True">
                        <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="{StaticResource Radius.Xs}" />
                        <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}"
                                CornerRadius="{StaticResource Radius.Xs}" HorizontalAlignment="Left" />
                        <!-- Indeterminate was unstyled, so a "working…" bar rendered as an empty track
                             and read as a stalled 0%. A full-width bar breathing between two opacities
                             says "running, duration unknown" without claiming a percentage.
                             Deliberately no position animation: a Storyboard inside a template trigger
                             has to be freezable, so it cannot read the bar's actual width. -->
                        <Border x:Name="Pulse" Background="{TemplateBinding Foreground}" CornerRadius="{StaticResource Radius.Xs}" Opacity="0" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsIndeterminate" Value="True">
                            <Setter TargetName="PART_Indicator" Property="Opacity" Value="0" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="PulseLoop">
                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                        <DoubleAnimation Storyboard.TargetName="Pulse" Storyboard.TargetProperty="Opacity"
                                                         From="0.42" To="0.88" Duration="{StaticResource Motion.Breathe}"
                                                         EasingFunction="{StaticResource Ease.Breathe}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="PulseLoop" />
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Lists ===================== -->

    <Style TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!-- The default template had no hover and no selected state at all, so selection in any list
         using this style was invisible. -->
    <Style TargetType="ListBoxItem">
        <Setter Property="Padding" Value="6,4" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="RowBg" Background="Transparent" CornerRadius="{StaticResource Radius.Sm}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="RowBg" Property="Background" Value="{StaticResource Brush.Field}" />
                            <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="RowBg" Property="Background" Value="{StaticResource Brush.SelectedSurface}" />
                            <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="RowBg" Property="BorderBrush" Value="{StaticResource Brush.FocusRing}" />
                            <Setter TargetName="RowBg" Property="BorderThickness" Value="2" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Slim, quiet scrollbars for the light workbench.

        The previous version set Width only and hardcoded IsDirectionReversed="True" for every
        orientation. IsDirectionReversed is correct for a vertical bar and inverted for a horizontal
        one, so horizontal scrollbars scrolled backwards; and with no Height setter a horizontal bar
        collapsed to a 2px sliver. Vertical and horizontal now get their own template.
    -->
    <Style x:Key="ScrollBarThumb" TargetType="Thumb">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="ThumbFill" Background="{StaticResource Brush.ScrollThumb}" CornerRadius="{StaticResource Radius.Xs}" Margin="2" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ThumbFill" Property="Background" Value="{StaticResource Brush.ScrollThumbHover}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="ThumbFill" Property="Background" Value="{StaticResource Brush.TextSecondary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        A hairline scrollbar for a strip that overflows, where the app's 10px track is more furniture
        than the thing it scrolls. Keyed, not implicit, and that is the whole point: a ScrollBar is
        created inside the ScrollViewer's ControlTemplate, and WPF resolves implicit styles for
        template-created elements only in Application.Resources — so an implicit override placed in a
        ScrollViewer's own Resources is silently ignored. It has to be handed over by key.
    -->
    <Style x:Key="ScrollBarThumb.Slim" TargetType="Thumb" BasedOn="{StaticResource ScrollBarThumb}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <!-- Xs, not Pill. WPF clamps a Border's corner radius per axis, so a pill radius
                         on something 3px tall and hundreds wide is drawn as a lens rather than a
                         rounded bar — it read as a stray bubble under the toolbar. -->
                    <Border x:Name="ThumbFill" Background="{StaticResource Brush.ScrollThumb}"
                            CornerRadius="{StaticResource Radius.Xs}" Margin="1" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ThumbFill" Property="Background" Value="{StaticResource Brush.ScrollThumbHover}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="ThumbFill" Property="Background" Value="{StaticResource Brush.TextSecondary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ScrollBar.Slim" TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Height" Value="5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="{TemplateBinding Background}">
                        <Track x:Name="PART_Track" IsDirectionReversed="False">
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ScrollBarThumb.Slim}" />
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        6px, not the previous 10px: at 10px this read as a leftover OS scrollbar against the rest of
        the app's thin-stroke, low-chrome language, especially wherever a panel scrolls by default
        (the Designer inspector, any dialog body) rather than as an occasional overflow affordance.

        The MinWidth/MinHeight="0" setters are load-bearing, not decoration: WPF's ScrollBar has a
        built-in default MinWidth/MinHeight (from SystemParameters' scrollbar metrics, ~15-17px on a
        typical display) that a Style's Width/Height Setter does NOT override on its own — Width only
        sets the element's preferred size, MinWidth still floors the final rendered size underneath
        it. Every previous value here (this app's old 10px, and briefly a 6px attempt) was silently
        clamped back up to that native floor; only the Thumb's own inset ever actually got thinner,
        which is what made the bug so easy to miss in a casual screenshot. Confirmed with a
        pixel-level readback of the rendered window (GetPixel across the thumb), not just a visual
        check — don't downgrade this back to eyeballing a screenshot if it regresses.

        SelectionPropertiesBar and KamilAssistantHost used to also carry a
        `<Style TargetType="ScrollBar">` in their own ScrollViewer.Resources expecting the keyed
        ScrollBar.Slim template to win locally — that's a different, unrelated dead pattern (an
        implicit style placed in a ScrollViewer's own Resources does not reach the ScrollBar its
        default template generates), and was removed from both files. This one definition is what
        every scrollbar in the app now actually renders with.
    -->
    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="6" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="{TemplateBinding Background}">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ScrollBarThumb.Slim}" />
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="Height" Value="6" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="{TemplateBinding Background}">
                                <Track x:Name="PART_Track" IsDirectionReversed="False">
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource ScrollBarThumb.Slim}" />
                                    </Track.Thumb>
                                </Track>
