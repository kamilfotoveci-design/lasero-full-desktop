<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:system="clr-namespace:System;assembly=System.Runtime"
                    xmlns:conv="clr-namespace:Lasero.App.Converters"
                    xmlns:components="clr-namespace:Lasero.App.Components">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Icons.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--
        Radius system. Four values, each with a job, so equivalent controls share a geometry instead
        of each screen inventing its own. Before this the app used 2, 3, 4, 5, 6, 7, 8, 9, 10 and 12
        more or less interchangeably, and icon buttons rendered as full circles while the text button
        beside them was 6 and the input beside that was 8.

        Xs  chips and swatches under ~18px, where 6 would read as a circle
        Sm  icon buttons, segments, list rows, small inner surfaces
        Md  buttons, inputs, selects, menu items — anything you type in or press
        Lg  panels, cards, dialogs, popups

        Genuinely circular things (numbered step badges, the toggle track) keep their own radius:
        those are circles by intent, not rounded rectangles that drifted.
    -->
    <CornerRadius x:Key="Radius.Xs">4</CornerRadius>
    <CornerRadius x:Key="Radius.Sm">6</CornerRadius>
    <CornerRadius x:Key="Radius.Md">8</CornerRadius>
    <CornerRadius x:Key="Radius.Lg">12</CornerRadius>
    <!-- Soft feature cards (the Home tip of the day): one step above Lg, never for controls. -->
    <CornerRadius x:Key="Radius.Xl">16</CornerRadius>
    <!--
        Pill means fully round, and it is the token for circles too: WPF clamps a radius to half the
        smaller side, so 999 on a 34x34 badge is a circle and on a 38x22 track is a pill. Hardcoding
        half the box (17, 11, 14) works only until someone resizes the box, and expressing a circle
        as Radius.Md works only until Md changes.

        Composite radii — a footer rounded on two corners, a chat bubble with one square corner —
        stay literal. XAML has no arithmetic, so a composite token would restate its scalar anyway.
    -->
    <CornerRadius x:Key="Radius.Pill">999</CornerRadius>

    <!--
        Neutral-first palette (2026-10). Superseded the graphite + warm-white + laser-red palette of
        2026-09, whose red interaction colour, pink "selected" tint and beige surfaces read as a
        faded, generic skin rather than a modern Apple-like one.

        Rules, in the order they matter:
          1. Surfaces are pure white (Brush.Surface/Panel). The app background and the canvas
             surround are one cool neutral gray (Brush.Canvas/Background #F5F5F7). No warm beige.
          2. Text is graphite #1D1D1F, secondary #6E6E73, muted #747478. Muted is a deliberate step
             darker than Apple's #8E8E93, which is only 3.3:1 on white and fails body text; #8E8E93
             survives as Brush.TextDisabled, where 3:1 is the bar.
          3. THE TINT (2026-10 owner decision: the neutral palette was "soulless"). One confident
             red, #E5302B, marks everything that is ON: checked and toggled controls, slider fill,
             the focus ring, the selected tool pill, the selected-navigation and tab indicators, text
             links and quiet text buttons, running progress, the caret and the text selection. It is
             always SOLID. Primary buttons stay graphite; destructive buttons are solid red but are
             confirmed in a dialog. Brush.Accent* are legacy aliases of the tint.
          4. Red as a SIGNAL is unchanged: the brand dot, laser/beam markers and selection handles on
             the canvas, error/danger, the live-job indicator and tiny badge dots. Red is the tint:
             solid, only on active / selected / interactive-ON, never as a wash or a large surface
             (no red panels, banners or backgrounds). The allow-lists are enforced in PaletteTests.
          5. Hover/pressed/selected rows are neutral ink washes. There is no tinted wash anywhere:
             Brush.*Muted exist only as aliases of one neutral gray, and banners are gray surface +
             hairline + a small coloured icon.
          5b. Colour also IDENTIFIES, Apple-Settings style: IconTile, a 28px rounded square with a
             white line icon on a muted solid fill (Brush.Tile.*). Never a state, never on rail or
             toolbar icons, at most four tile colours on a screen.
          5c. Depth in three layers: canvas #F5F5F7, white cards with the two-layer card shadow
             (Elevation.Card.*, drawn by ElevatedBorder), popovers and dialogs one level higher.
          6. Semantic text colours are chosen so they pass 4.5:1 on white (Success #1F7F37,
             Warning #B25E09, Danger #D92B27). The brighter #E5302B / #248A3D reds and greens live
             in Brush.Signal and the dots, where only 3:1 is required.

        Budget: ~88% neutral, ~6% graphite, ~4% tint and signal red, a few tiles.
    -->

    <!-- Primary action: ordinary buttons. Graphite fill, white text. -->
    <SolidColorBrush x:Key="Brush.PrimaryAction" Color="#1D1D1F" po:Freeze="False" />
    <SolidColorBrush x:Key="Brush.PrimaryActionHover" Color="#3A3A3C" po:Freeze="False" />
    <SolidColorBrush x:Key="Brush.PrimaryActionPressed" Color="#0B0B0C" po:Freeze="False" />
    <SolidColorBrush x:Key="Brush.OnPrimaryAction" Color="#FFFFFF" po:Freeze="False" />

    <!--
         THE TINT. One confident colour for everything that is on: toggles and checkboxes when
         checked, slider fill, the focus ring, the selected tool, the selected navigation indicator,
         text links, running progress, the caret and the text selection. It is always SOLID - never a
         pastel, a wash or a large surface. Fills use #E5302B; text uses the slightly deeper
         #D32925 (5.1:1 on white, 4.6:1 on the gray canvas; #E5302B is 4.38 and 4.03 and fails AA for body text).
         Primary buttons stay graphite; destructive buttons are the same solid red but are
         confirmed in a dialog, so the tint never has to say "danger" on its own. -->
    <SolidColorBrush x:Key="Brush.Tint" Color="#E5302B" po:Freeze="False" />
    <SolidColorBrush x:Key="Brush.Tint.Hover" Color="#CF2A26" po:Freeze="False" />
    <SolidColorBrush x:Key="Brush.Tint.Pressed" Color="#B9231F" po:Freeze="False" />
    <SolidColorBrush x:Key="Brush.OnTint" Color="#FFFFFF" po:Freeze="False" />
    <SolidColorBrush x:Key="Brush.TintText" Color="#D32925" po:Freeze="False" />
    <SolidColorBrush x:Key="Brush.TintText.Hover" Color="#B9231F" po:Freeze="False" />

    <!-- Legacy interaction names, kept as aliases of the tint so views do not need editing. New code
         uses Brush.Tint*. -->
    <SolidColorBrush x:Key="Brush.Accent" Color="#E5302B" po:Freeze="False" />
    <SolidColorBrush x:Key="Brush.AccentHover" Color="#CF2A26" po:Freeze="False" />
    <!-- Foreground for anything drawn on top of Brush.Accent or Brush.Signal fills, including the
         scene canvas resize and rotate handles (red outline, white core). SceneCanvas resolves this
         key with FindResource, so it must exist or building the selection adorner throws. -->
    <SolidColorBrush x:Key="Brush.OnAccent" Color="#FFFFFF" po:Freeze="False" />
    <SolidColorBrush x:Key="Brush.AccentText" Color="#D32925" po:Freeze="False" />

    <!-- The active tool: a solid tint pill with a white icon. -->
    <SolidColorBrush x:Key="Brush.ActiveTool" Color="#E5302B" po:Freeze="False" />
    <SolidColorBrush x:Key="Brush.OnActiveTool" Color="#FFFFFF" po:Freeze="False" />

    <!-- Selected rows, tabs and segments: a very light neutral wash (6%) plus a hairline. Never a tint.
         SelectedSurface is the original name; Selected is the semantic one. Same value. -->
    <SolidColorBrush x:Key="Brush.Selected" Color="#0F1D1D1F" po:Freeze="False" />
    <SolidColorBrush x:Key="Brush.SelectedSurface" Color="#0F1D1D1F" po:Freeze="False" />
    <SolidColorBrush x:Key="Brush.SelectedBorder" Color="#D2D2D7" po:Freeze="False" />
    <!-- The 2px indicator on a selected row or active navigation item. -->
    <SolidColorBrush x:Key="Brush.SelectedIndicator" Color="#E5302B" po:Freeze="False" />
    <!-- Keyboard focus: tint, 2px, with a white gap on filled controls (Brush.FocusGap). -->
    <SolidColorBrush x:Key="Brush.FocusRing" Color="#E5302B" po:Freeze="False" />
    <SolidColorBrush x:Key="Brush.FocusGap" Color="#FFFFFF" po:Freeze="False" />
    <!-- Text selection inside a field: the tint at 30%, so selected graphite text stays at 4.5:1+ on it. -->
    <SolidColorBrush x:Key="Brush.TextSelection" Color="#4DE5302B" po:Freeze="False" />

    <!-- LASERO signal red. The only saturated colour in the chrome. -->
    <SolidColorBrush x:Key="Brush.Signal" Color="#E5302B" po:Freeze="False" />
    <SolidColorBrush x:Key="Brush.SignalHover" Color="#CF2A26" po:Freeze="False" />
    <SolidColorBrush x:Key="Brush.SignalPressed" Color="#B9231F" po:Freeze="False" />
    <!-- Brand. The wordmark's red dot. -->
    <SolidColorBrush x:Key="Brush.Brand" Color="#E5302B" po:Freeze="False" />

    <!--
        Identification tiles (IconTile). Muted, saturated, flat: each reaches at least 3:1 against the
        white icon drawn on it (PaletteTests computes it). They identify a thing and are never a state:
        the tint (red) alone marks on, selected and active. Brown, Steel and Gray exist for material
        categories (leather, metal marking, paper).
    -->
    <SolidColorBrush x:Key="Brush.Tile.Graphite" Color="#48484A" po:Freeze="False" />
    <SolidColorBrush x:Key="Brush.Tile.Red" Color="#D9534F" po:Freeze="False" />
    <SolidColorBrush x:Key="Brush.Tile.Orange" Color="#C46A24" po:Freeze="False" />
    <SolidColorBrush x:Key="Brush.Tile.Amber" Color="#B7791F" po:Freeze="False" />
    <SolidColorBrush x:Key="Brush.Tile.Green" Color="#2F8F4E" po:Freeze="False" />
    <SolidColorBrush x:Key="Brush.Tile.Teal" Color="#2A8C86" po:Freeze="False" />
    <SolidColorBrush x:Key="Brush.Tile.Blue" Color="#4F7CAC" po:Freeze="False" />
    <SolidColorBrush x:Key="Brush.Tile.Indigo" Color="#5856B8" po:Freeze="False" />
    <SolidColorBrush x:Key="Brush.Tile.Brown" Color="#8B5E3C" po:Freeze="False" />
    <SolidColorBrush x:Key="Brush.Tile.Steel" Color="#6B7F8F" po:Freeze="False" />
    <SolidColorBrush x:Key="Brush.Tile.Gray" Color="#8E8E93" po:Freeze="False" />

    <!-- Surfaces. White cards and panels on a cool neutral gray canvas. -->
    <SolidColorBrush x:Key="Brush.Surface" Color="#FFFFFF" po:Freeze="False" />
    <SolidColorBrush x:Key="Brush.Canvas" Color="#F5F5F7" po:Freeze="False" />
    <SolidColorBrush x:Key="Brush.Background" Color="#F5F5F7" po:Freeze="False" />
    <SolidColorBrush x:Key="Brush.TitleBar" Color="#FFFFFF" po:Freeze="False" />
    <SolidColorBrush x:Key="Brush.Sidebar" Color="#FFFFFF" po:Freeze="False" />
    <SolidColorBrush x:Key="Brush.Panel" Color="#FFFFFF" po:Freeze="False" />
    <SolidColorBrush x:Key="Brush.PanelRaised" Color="#F2F2F4" po:Freeze="False" />
    <SolidColorBrush x:Key="Brush.Field" Color="#F2F2F4" po:Freeze="False" />
    <!-- Hairline: ink at 8%. Strong is the opaque #D2D2D7 for field outlines and resize grips. -->
    <SolidColorBrush x:Key="Brush.PanelBorder" Color="#0F1D1D1F" po:Freeze="False" />
    <SolidColorBrush x:Key="Brush.PanelBorderStrong" Color="#D2D2D7" po:Freeze="False" />

    <!--
        Canvas. Its own tokens rather than the panel ones, because the bed does not follow the chrome:
        it stays white whatever the theme does, since the operator judges burn contrast against real
        material. The surround is the neutral canvas gray, so the bed reads as a sheet on a desk.
        The grid is neutral ink at two strengths, never the signal colour.
    -->
    <SolidColorBrush x:Key="Brush.Canvas.Surround" Color="#F5F5F7" po:Freeze="False" />
    <SolidColorBrush x:Key="Brush.Canvas.WorkArea" Color="#FFFFFF" po:Freeze="False" />
    <SolidColorBrush x:Key="Brush.Canvas.WorkAreaBorder" Color="#D2D2D7" po:Freeze="False" />
    <SolidColorBrush x:Key="Brush.Canvas.GridMinor" Color="#141D1D1F" po:Freeze="False" />
    <SolidColorBrush x:Key="Brush.Canvas.GridMajor" Color="#261D1D1F" po:Freeze="False" />

    <!-- Text -->
    <SolidColorBrush x:Key="Brush.TextPrimary" Color="#1D1D1F" po:Freeze="False" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="#6E6E73" po:Freeze="False" />
    <SolidColorBrush x:Key="Brush.TextMuted" Color="#6E6E73" po:Freeze="False" />

    <!-- Disabled -->
    <SolidColorBrush x:Key="Brush.DisabledSurface" Color="#EDEDF0" po:Freeze="False" />
    <SolidColorBrush x:Key="Brush.TextDisabled" Color="#8E8E93" po:Freeze="False" />

    <!--
        Semantic. State, never decoration, and never a pastel: the *Muted keys are kept so no view
        needs editing, but they are all one neutral gray now. A banner is a gray surface, a hairline
        and a small coloured icon; the colour is in the icon and the text, not the background.
        Brush.Danger is also the destructive-button fill and the error text, so it is the slightly
        deeper #D92B27 (4.86:1 on white) rather than the brand #E5302B (4.38:1).
    -->
    <SolidColorBrush x:Key="Brush.Success" Color="#1F7F37" po:Freeze="False" />
    <SolidColorBrush x:Key="Brush.SuccessMuted" Color="#F5F5F7" po:Freeze="False" />
    <SolidColorBrush x:Key="Brush.Warning" Color="#B25E09" po:Freeze="False" />
    <SolidColorBrush x:Key="Brush.WarningMuted" Color="#F5F5F7" po:Freeze="False" />
    <SolidColorBrush x:Key="Brush.Danger" Color="#D92B27" po:Freeze="False" />
    <SolidColorBrush x:Key="Brush.DangerMuted" Color="#F5F5F7" po:Freeze="False" />
    <SolidColorBrush x:Key="Brush.DangerBorder" Color="#D2D2D7" po:Freeze="False" />
    <SolidColorBrush x:Key="Brush.Info" Color="#6E6E73" po:Freeze="False" />
    <SolidColorBrush x:Key="Brush.InfoMuted" Color="#F5F5F7" po:Freeze="False" />
    <SolidColorBrush x:Key="Brush.InfoBorder" Color="#D2D2D7" po:Freeze="False" />

    <!-- Component-level neutrals -->
    <!--
        Hover and press are one mechanic, not two: an ink wash over whatever the control already is,
        at 5% for hover and 8% for press (see the Button template). That is why there is no
        Brush.AccentPressed or Brush.DangerPressed — a per-kind pressed colour would be a second
        mechanic for the same state. The wash is neutral graphite ink and never tinted.

        Brush.Hover / Brush.Pressed are the same two strengths baked into alpha brushes, for rows and
        menu items that paint a background directly instead of stacking a wash layer.
    -->
    <SolidColorBrush x:Key="Brush.HoverWash" Color="#1D1D1F" po:Freeze="False" />
    <!-- Dimming behind a guided-tour spotlight and the device wizard sheet. Neutral graphite ink, not
         black and never a tint, so the cut-out target reads as lit rather than the rest as switched
         off. -->
    <SolidColorBrush x:Key="Brush.Scrim" Color="#8F1D1D1F" po:Freeze="False" />
    <SolidColorBrush x:Key="Brush.Hover" Color="#0D1D1D1F" po:Freeze="False" />
    <SolidColorBrush x:Key="Brush.Pressed" Color="#141D1D1F" po:Freeze="False" />
    <SolidColorBrush x:Key="Brush.ToggleTrackOff" Color="#E3E3E8" po:Freeze="False" />
    <SolidColorBrush x:Key="Brush.ToggleTrackOffBorder" Color="#D2D2D7" po:Freeze="False" />
    <SolidColorBrush x:Key="Brush.ScrollThumb" Color="#C7C7CC" po:Freeze="False" />
    <SolidColorBrush x:Key="Brush.ScrollThumbHover" Color="#8E8E93" po:Freeze="False" />

    <!--
        Elevation ladder. Docked panels get a border, never a shadow — the canvas stays the focus.
        Soft, neutral and low-opacity; never a coloured glow.

        Sheet is paper on a desk, not a floating surface. Tooltip barely lifts. Dropdown is
        0 8px 24px at 8%. Modal is the only real one.
    -->
    <DropShadowEffect x:Key="Shadow.Sheet" Color="#1D1D1F" Opacity="0.06" BlurRadius="4" ShadowDepth="1" Direction="270" />
    <DropShadowEffect x:Key="Shadow.Tooltip" Color="#1D1D1F" Opacity="0.08" BlurRadius="8" ShadowDepth="2" Direction="270" />
    <DropShadowEffect x:Key="Shadow.Dropdown" Color="#1D1D1F" Opacity="0.12" BlurRadius="32" ShadowDepth="12" Direction="270" />
    <DropShadowEffect x:Key="Shadow.Modal" Color="#1D1D1F" Opacity="0.14" BlurRadius="48" ShadowDepth="16" Direction="270" />

    <!--
        Three layers of depth. 1: the canvas and app background (#F5F5F7). 2: cards and panels, white,
        lifted by the two-layer card shadow below (0 1px 2px + 0 8px 24px at 6%, neutral ink). 3:
        popovers, menus and dialogs, one level higher (Shadow.Dropdown 0 12px 32px at 12%, Shadow.Modal).
        Cards draw their shadow in ElevatedBorder rather than through DropShadowEffect (no offscreen
        surface, ClearType text stays crisp); these numbers are what it reads.
    -->
    <system:Double x:Key="Elevation.Card.Contact.OffsetY">1</system:Double>
    <system:Double x:Key="Elevation.Card.Contact.Blur">2</system:Double>
    <system:Double x:Key="Elevation.Card.Contact.Opacity">0.06</system:Double>
    <system:Double x:Key="Elevation.Card.Ambient.OffsetY">8</system:Double>
    <system:Double x:Key="Elevation.Card.Ambient.Blur">24</system:Double>
    <system:Double x:Key="Elevation.Card.Ambient.Opacity">0.06</system:Double>

    <!-- Motion language: responsive at the pointer, slightly slower for spatial change. Spring is
         deliberately high-damping: it is used only for the final 1-3% settle, never for travel or
         decorative bounce. This keeps the workbench tactile without making precision controls move. -->
    <Duration x:Key="Motion.VeryFast">0:0:0.09</Duration>
    <Duration x:Key="Motion.Fast">0:0:0.11</Duration>
    <Duration x:Key="Motion.Base">0:0:0.17</Duration>
    <Duration x:Key="Motion.Spatial">0:0:0.26</Duration>
    <!-- Interaction feedback (2026-10). Hover wash fades over Hover, a press scales to 0.97 over Press and
         springs back over Release with a slight overshoot (Ease.Release), a check or tab indicator
         animates over Toggle, a popup opens over Popup and a dialog over Dialog. All are zeroed together
         by UiAccessibility when Windows animations are off. Only Opacity and RenderTransform animate. -->
    <Duration x:Key="Motion.Hover">0:0:0.12</Duration>
    <Duration x:Key="Motion.Press">0:0:0.09</Duration>
    <Duration x:Key="Motion.Release">0:0:0.20</Duration>
    <Duration x:Key="Motion.Toggle">0:0:0.15</Duration>
    <Duration x:Key="Motion.Popup">0:0:0.12</Duration>
    <Duration x:Key="Motion.Dialog">0:0:0.16</Duration>
    <!-- Dialogs and the largest sheet-style overlays only - not ordinary hover/press motion. -->
    <Duration x:Key="Motion.Panel">0:0:0.34</Duration>
    <!-- AutoReverse makes the complete breathe cycle 3.2 s. Use only for real activity. -->
    <Duration x:Key="Motion.Breathe">0:0:1.6</Duration>
    <CubicEase x:Key="Ease.Out" EasingMode="EaseOut" />
    <BackEase x:Key="Ease.Release" EasingMode="EaseOut" Amplitude="0.35" />
    <!-- One dimming level for disabled glyph-only and composite controls (filled buttons use the flat
         disabled surface instead). Two values, 0.4 and 0.45, had crept in side by side. -->
    <system:Double x:Key="Opacity.Disabled">0.45</system:Double>
    <SineEase x:Key="Ease.Breathe" EasingMode="EaseInOut" />

    <!-- 4pt spacing scale (4/8/12/16/20/24/32) — enforced as literal multiples throughout instead of ad hoc margins. -->

    <!-- Control heights. Three sizes only: Compact for dense toolbars and inline editors, Base for
         ordinary buttons/inputs, Large for a screen's primary action. Before these existed the app
         used 32/34/36/38/40/42/44 more or less interchangeably, which is why nothing lined up. -->
    <!--
        Type sizes. These exist because every view was picking its own literal FontSize: 12 for most
        body text, then 15/17/21/22/24/26/27 scattered across headings. Four steps cover the whole
        product, and nothing renders below Meta.
    -->
    <!-- Specimen size. The font preview is there to be judged as a shape, not read as body copy. -->
    <system:Double x:Key="Size.Text.Preview">30</system:Double>
    <!-- 2026-10 raise (owner: "the letters are terribly small"). One scale, one place:
         Title    page title, Bold
         Heading  section headings on a screen, SemiBold
         Section  card and panel titles, SemiBold
         Body     default text, controls and buttons
         Meta     secondary and help text, field labels (never below this for reading text)
         Caption  status strip, tooltips, rulers and badges - the one step below Meta -->
    <system:Double x:Key="Size.Text.Title">30</system:Double>
    <system:Double x:Key="Size.Text.Heading">21</system:Double>
    <system:Double x:Key="Size.Text.Section">17</system:Double>
    <system:Double x:Key="Size.Text.Body">15</system:Double>
    <system:Double x:Key="Size.Text.Meta">14</system:Double>
    <system:Double x:Key="Size.Text.Caption">13</system:Double>
    <!-- Explanatory empty-state sentences: larger than body so a first-time owner reads them without effort. -->
    <system:Double x:Key="Size.Text.Explain">15</system:Double>

    <!--
        KAMIL reading sizes. The assistant is read, not scanned, and its reader may be a first-time
        owner or a grandparent, so it does not use the dense editor scale above. Body is 16 with a
        1.45 line height (16 x 1.45 = 23.2), meta 14, and the smallest interactive target is 36.
        Nothing on the panel goes below Assistant.Meta.
    -->
    <system:Double x:Key="Size.Text.Assistant.Body">16</system:Double>
    <system:Double x:Key="Size.Text.Assistant.LineHeight">23</system:Double>
    <system:Double x:Key="Size.Text.Assistant.Meta">14</system:Double>
    <system:Double x:Key="Size.Control.Assistant.Chip">36</system:Double>
    <system:Double x:Key="Size.Control.Assistant.Send">40</system:Double>

    <!--
        Icon sizes. Five steps, each with a job. Before these existed the app rendered icons at 10,
        12, 13, 14, 15, 16, 17, 18, 21, 22, 24, 25, 28 and 30 across 112 sites, and Glyph.Close alone
        appeared at four different sizes in the same dismiss role.

        Chrome  window buttons and dismiss glyphs — the one place below Sm, by platform convention
        Sm      inside compact controls and the status bar
        Md      toolbars and the navigation rail
        Lg      window and panel header identity, machine state
        Xl      empty-state and onboarding art
    -->
    <system:Double x:Key="Size.Icon.Chrome">12</system:Double>
    <system:Double x:Key="Size.Icon.Sm">16</system:Double>
    <system:Double x:Key="Size.Icon.Md">18</system:Double>
    <system:Double x:Key="Size.Icon.Lg">20</system:Double>
    <system:Double x:Key="Size.Icon.Xl">24</system:Double>
    <!-- Between Xl and Hero: a glyph that anchors a card or a status disc without becoming the
         full-height empty-state illustration Hero is meant for. -->
    <system:Double x:Key="Size.Icon.Xxl">48</system:Double>
    <!-- Hero-sized: only for a section illustration, never for a control. -->
    <system:Double x:Key="Size.Icon.Hero">72</system:Double>
    <!-- The exported SVG assets in docs/design/icons-custom all carry stroke-width 1.75. The renderer
         said 1.8, so the shipped icons and the design assets were never quite the same weight. -->
    <system:Double x:Key="Size.Icon.Stroke">1.75</system:Double>

    <system:Double x:Key="Size.Control.Compact">36</system:Double>
    <system:Double x:Key="Size.Control.Base">40</system:Double>
    <system:Double x:Key="Size.Control.Primary">44</system:Double>
    <system:Double x:Key="Size.Control.Large">48</system:Double>
    <!-- Rail tool buttons, list rows and other repeated hit targets: 44, the touch minimum. -->
    <system:Double x:Key="Size.Control.Rail">44</system:Double>
    <system:Double x:Key="Size.Control.Row">40</system:Double>

    <!--
        Editor chrome geometry. The button is exactly tall enough for an 18px glyph over a caption at
        Size.Text.Meta — 4 + 18 + 5 + 16 + 4 — and no taller. It used to run to 54, which the active
        tool's tint then had to fill: with the captions collapsed that left a tall blue box around a
        small icon. At this height the collapsed button is a square instead.
    -->
    <system:Double x:Key="Size.Toolbar.ButtonMinWidth">48</system:Double>
    <system:Double x:Key="Size.Toolbar.ButtonHeight">48</system:Double>
    <system:Double x:Key="Size.Toolbar.Height">64</system:Double>

    <!--
        ===================== Layout system (2026-10) =====================
        One grid: 8 px, 4 px for tight pairs (icon and label, label and value). Every Margin and Padding in markup is a
        multiple of 4 (LayoutGridTests enforces it); the values below are the named ones to reach for first.

        Page         32 around a screen's content, 24 when the content column is narrower than 720 (PageScaffold switches).
        Section gap  32 between page sections, 16 between cards in a row or column, 8 between sibling controls.
        Card         padding 24 (20 compact), radius Radius.Lg (12). A card inside a card is Radius.Md (8) with no shadow.
        Controls     Compact 36, Base 40 (default), Primary 44; icon tiles 28, 32 where one leads a row.
        Panels       the right panel (inspector, Home device rail, Zařízení jog column) is 360 wide everywhere,
                     the left navigation 184, the Designer tool rail 64.
        Content      a screen's column is capped at 1120 and left-anchored; running text at 720.
    -->
    <Thickness x:Key="Layout.PagePadding">32</Thickness>
    <Thickness x:Key="Layout.PagePaddingCompact">24</Thickness>
    <Thickness x:Key="Layout.CardPadding">24</Thickness>
    <Thickness x:Key="Layout.CardPaddingCompact">20</Thickness>
    <Thickness x:Key="Layout.DialogPadding">24</Thickness>
    <Thickness x:Key="Layout.InspectorPadding">24,20</Thickness>
    <system:Double x:Key="Layout.SectionGap">32</system:Double>
    <system:Double x:Key="Layout.CardGap">16</system:Double>
    <system:Double x:Key="Layout.ControlGap">8</system:Double>
    <system:Double x:Key="Layout.ContentMaxWidth">1120</system:Double>
    <system:Double x:Key="Layout.ReadingMaxWidth">720</system:Double>
    <system:Double x:Key="Layout.NavWidth">184</system:Double>
    <system:Double x:Key="Layout.PanelWidth">360</system:Double>
    <GridLength x:Key="Layout.PanelColumn">360</GridLength>
    <system:Double x:Key="Layout.DialogWidth">440</system:Double>
    <system:Double x:Key="Layout.DialogFooterHeight">72</system:Double>
    <system:Double x:Key="Layout.PageHeaderMinHeight">64</system:Double>

    <!--
        Segoe UI Variable is the native Windows UI face. Keeping the shell on the system variable
        family preserves ClearType/DPI hinting and avoids the heavy, uneven appearance of the
        imported display face at small WPF sizes. Neue Montreal remains available as a design asset,
        but is not forced onto every control until its WPF rasterization is separately validated.
    -->
    <!-- Inter, bundled as Resources (SIL OFL, Assets/Fonts/Inter-LICENSE.txt): Regular, Medium, SemiBold and
         Bold static files, so every weight is a real face rather than a synthesised bold. It is not a
         Windows font, so a bare family name would silently fall back to Segoe: always go through these keys. -->
    <FontFamily x:Key="Font.Ui">pack://application:,,,/Lasero.App;component/Assets/Fonts/#Inter, Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="Font.Display">pack://application:,,,/Lasero.App;component/Assets/Fonts/#Inter, Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="Font.Numeric">pack://application:,,,/Lasero.App;component/Assets/Fonts/#Inter, Segoe UI Variable Text, Segoe UI</FontFamily>
    <!-- Genuinely fixed-pitch content only: the GRBL console and raw G-code, where column position
         carries meaning. Not for ordinary numeric fields. -->
    <FontFamily x:Key="Font.Mono">Cascadia Mono,Consolas,Courier New</FontFamily>
    <!-- The dark-ink wordmark, for the light sidebar. LaseroWordmarkLight.png is the same mark cut
         for a dark chrome and stays in the project; this key is the single place to switch. -->
    <BitmapImage x:Key="Image.BrandWordmark" UriSource="/Lasero.App;component/Assets/LaseroWordmark.png" CacheOption="OnLoad" />
    <!-- Original 1254px transparent artwork supplied by the user. Decode once at 256px: enough for
         the 72-DIP presentation avatar at 200% DPI while avoiding a full 6MB decode per instance. -->
    <BitmapImage x:Key="Image.LaseroAvatarSource"
                 UriSource="/Lasero.App;component/Assets/LaseroAvatar.png"
                 DecodePixelWidth="256" CacheOption="OnLoad" />

    <!-- ===================== Base ===================== -->

    <!--
        This style matches Window itself, not the app's windows: WPF resolves an implicit style by the
        element's exact type, and every window here is a derived class (MainWindow, MaterialsWindow,
        …), so none of them ever picked it up. The light theme hid that, because the WPF default
        foreground is black and black was within a shade of TextPrimary. On the dark palette the same
        default turned every inherited heading and icon invisible. Each window root therefore sets
        Background and Foreground itself; the setters below only document the intended defaults.
    -->
    <Style TargetType="Window">
        <Setter Property="Background" Value="{StaticResource Brush.Background}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
        <Setter Property="FontSize" Value="{StaticResource Size.Text.Body}" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
        <Setter Property="TextOptions.TextHintingMode" Value="Fixed" />
    </Style>

    <!--
        Bitmaps are always drawn smaller or larger than their pixel size on a 125/150/175 percent
        monitor, and WPF's default scaling mode is bilinear: a 660 px wordmark shown at 116 px keeps
        every other source row and comes out stair-stepped and soft. HighQuality is the Fant resampler,
        which averages the source pixels each device pixel covers. An image that wants hard pixels
        (a raster preview at high zoom) sets NearestNeighbor locally, which beats this style.
    -->
    <Style TargetType="Image">
        <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality" />
    </Style>

    <!--
        There is deliberately no implicit TextBlock style here.

        It used to set Foreground to TextPrimary, and that one Setter broke every control that paints
        its content on a coloured surface. WPF resolves implicit styles for elements built inside a
        template against Application.Resources only, and a style Setter beats an inherited value - so
        the TextBlock a ContentPresenter builds for Content="Přidat text" took near-black from here
        instead of the white the primary button's own Foreground was handing down. Dark text on a
        cobalt button; black text on the dark tooltip surface. Anything that passed an explicit
        TextBlock or an IconLabel was fine, which is why it looked random.

        The default text colour comes from the Window style above instead. Control.Foreground is an
        inherited property, so it reaches every TextBlock in the window, and a control that sets its own
        Foreground correctly overrides it for its own content. Popups live in their own visual trees and
        do not inherit from the window: ComboBox, ComboBoxItem, MenuItem and ToolTip each set Foreground
        in their own styles, which is what covers them.
    -->

    <Style x:Key="Text.Muted" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
        <Setter Property="FontSize" Value="{StaticResource Size.Text.Body}" />
    </Style>

    <!-- Barely-there text for things like a layer's ordinal, where the value should be available
         but must not compete with the name beside it. -->
    <Style x:Key="Text.Faint" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
        <Setter Property="FontSize" Value="{StaticResource Size.Text.Meta}" />
    </Style>

    <Style x:Key="Text.Heading" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Display}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <!-- Was 11px, then 12px: a section heading that renders smaller than the body text under it
             reads as a caption, not a heading, and flattens the panel hierarchy. Body is 13, so 12
             was still losing that contest. -->
        <Setter Property="FontSize" Value="{StaticResource Size.Text.Body}" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <!-- Tabular figures: every digit takes the same advance width, so coordinates, speeds and
         dimensions stay in vertical columns as the values change. This is what the monospace font
         was really being used for, without making the panel look like a terminal. -->
    <Style x:Key="Text.Numeric" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Numeric}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    </Style>

    <!-- ===================== Panels ===================== -->

    <!--
        Depth (2026-10). Docked chrome (title bar, rails, the inspector) is white with a hairline, no
        shadow. Cards and dialog groups (Card, MetricCard, ThumbnailCard, InspectorSection) lift off
        the #F5F5F7 canvas through ElevatedBorder: a soft neutral two-layer shadow drawn in OnRender
        rather than a DropShadowEffect, so ClearType text inside stays crisp and nothing is rasterised
        offscreen. The design canvas itself never carries an effect beyond the one thin sheet shadow
        on the paper (Shadow.Sheet, WorkspaceCanvas.xaml). Popovers, menus and dialogs use the
        Shadow.Dropdown / Shadow.Modal effects, one level higher.
    -->
    <Style x:Key="Badge" TargetType="Border">
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Sm}" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="Background" Value="{StaticResource Brush.PanelRaised}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.PanelBorder}" />
    </Style>

    <!-- A Badge that sits in a row with buttons (header actions, toolbars). A plain Badge is text plus 6px of
         padding, about 32px tall, so beside a 36px button it looked like a smaller sibling. This one takes
         the button height and centres its content; put VerticalAlignment=Center on the child. -->
    <Style x:Key="Badge.Aligned" TargetType="Border" BasedOn="{StaticResource Badge}">
        <Setter Property="MinHeight" Value="{StaticResource Size.Control.Base}" />
        <Setter Property="Padding" Value="12,0" />
    </Style>

    <!-- ===================== Buttons ===================== -->

    <!--
        Every button is a 3-layer stack (base fill → hover wash → content) so
        hover/press feedback is a pure OPACITY fade on an always-instance-local
        overlay Border, never a Color animation on the (possibly StaticResource-
        shared) Background brush — animating a shared brush's Color would leak
        across every button using that resource at once.
    -->
    <Style TargetType="Button">
        <Setter Property="Background" Value="{StaticResource Brush.PanelRaised}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.PanelBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="MinHeight" Value="{StaticResource Size.Control.Base}" />
        <Setter Property="FontSize" Value="{StaticResource Size.Text.Body}" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <!-- The template below draws its own FocusRing border on IsKeyboardFocused; without nulling
             the default FocusVisualStyle, WPF layers its own dashed-rectangle adorner on top of it. -->
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="PressScale" />
                        </Grid.RenderTransform>
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource Radius.Md}" />
                        <Border x:Name="Hover"
                                Background="{StaticResource Brush.HoverWash}"
                                Opacity="0"
                                CornerRadius="{StaticResource Radius.Md}" />
                        <!--
                            Press has its own layer rather than sharing Hover's opacity. When the two
                            shared one, a click that opened a window left the wash at its pressed value
                            forever: the pointer leaves without WPF raising the hover exit, so nothing
                            ever animated it back and the button stayed a solid grey box. Two layers,
                            two independent triggers, no state either one can strand.
                        -->
                        <Border x:Name="Press"
                                Background="{StaticResource Brush.HoverWash}"
                                Opacity="0"
                                CornerRadius="{StaticResource Radius.Md}" />
                        <!-- Graphite 2px ring with a 1px white gap just inside it, so the ring stays
                             visible on a graphite-filled primary button as well as on a white one. -->
                        <Border x:Name="FocusRing"
                                BorderBrush="{StaticResource Brush.FocusRing}"
                                BorderThickness="0"
                                CornerRadius="{StaticResource Radius.Md}" />
                        <Border x:Name="FocusGap"
                                BorderBrush="{StaticResource Brush.FocusGap}"
                                BorderThickness="0"
                                Margin="4"
                                CornerRadius="{StaticResource Radius.Sm}" />
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Margin="{TemplateBinding Padding}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0.05" Duration="{StaticResource Motion.Hover}" EasingFunction="{StaticResource Ease.Out}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource Motion.Hover}" EasingFunction="{StaticResource Ease.Out}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="Opacity" To="0.08" Duration="{StaticResource Motion.VeryFast}" />
                                        <DoubleAnimation Storyboard.TargetName="PressScale" Storyboard.TargetProperty="ScaleX" To="0.97" Duration="{StaticResource Motion.Press}" EasingFunction="{StaticResource Ease.Out}" />
                                        <DoubleAnimation Storyboard.TargetName="PressScale" Storyboard.TargetProperty="ScaleY" To="0.97" Duration="{StaticResource Motion.Press}" EasingFunction="{StaticResource Ease.Out}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource Motion.Hover}" EasingFunction="{StaticResource Ease.Out}" />
                                        <DoubleAnimation Storyboard.TargetName="PressScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="{StaticResource Motion.Release}" EasingFunction="{StaticResource Ease.Release}" />
                                        <DoubleAnimation Storyboard.TargetName="PressScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="{StaticResource Motion.Release}" EasingFunction="{StaticResource Ease.Release}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="components:FocusVisual.IsVisible" Value="True">
                            <Setter TargetName="FocusRing" Property="BorderThickness" Value="2" />
                            <Setter TargetName="FocusGap" Property="BorderThickness" Value="1" />
                        </Trigger>
                        <!--
                            Disabled is a described state, not a faded one. Opacity 0.35 made a
                            control look half-rendered — the operator reads that as "broken", not as
                            "not available yet". A flat disabled surface with disabled text keeps the
                            shape legible, and the pointer stops promising it can be pressed.
                        -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource Brush.DisabledSurface}" />
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource Brush.PanelBorder}" />
                            <Setter Property="Foreground" Value="{StaticResource Brush.TextDisabled}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                        <!-- Declared after the trigger above so it wins: a ghost button has no
                             surface to keep legible, and drawing one only when the command is
                             unavailable makes the dead controls the loudest in the row. -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsEnabled" Value="False" />
                                <Condition Property="components:ButtonChrome.SuppressDisabledSurface" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Bg" Property="Background" Value="Transparent" />
                            <Setter TargetName="Bg" Property="BorderBrush" Value="Transparent" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Flat, no glow — the file-level comment on the "Panel" style above already commits this app to
         exactly one shadow (the canvas). A permanent red glow under every primary button contradicted
         that rule and read as generic AI-glow styling rather than restrained Windows 11 chrome. -->
    <!-- Primary is graphite, not the red interaction colour — see the palette comment at the top of
         this file. Its near-black fill makes the shared dark hover/press wash too subtle to read on
         its own, so this style also swaps the Button's own Background/BorderBrush on IsMouseOver/
         IsPressed (a plain Style.Trigger property setter, not TargetName — Style triggers cannot
         address a named template part, only ControlTemplate triggers can) — the base template's "Bg"
         Border reads both via TemplateBinding, so this needs no template of its own. -->
    <Style x:Key="Button.Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource Brush.PrimaryAction}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.PrimaryAction}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.OnPrimaryAction}" />
        <Setter Property="MinHeight" Value="{StaticResource Size.Control.Primary}" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Display}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Style.Triggers>
            <!-- Enabled only. A Style trigger outranks the template's disabled trigger, so an
                 unguarded hover here painted a disabled primary button graphite. -->
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsEnabled" Value="True" />
                    <Condition Property="IsMouseOver" Value="True" />
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{StaticResource Brush.PrimaryActionHover}" />
                <Setter Property="BorderBrush" Value="{StaticResource Brush.PrimaryActionHover}" />
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsEnabled" Value="True" />
                    <Condition Property="IsPressed" Value="True" />
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{StaticResource Brush.PrimaryActionPressed}" />
                <Setter Property="BorderBrush" Value="{StaticResource Brush.PrimaryActionPressed}" />
            </MultiTrigger>
        </Style.Triggers>
    </Style>

    <!-- Secondary is the default action on a neutral surface: quiet fill, explicit edge, medium
         label. Outline carries the same geometry for contexts where the surrounding surface already
         supplies enough contrast. Both remain native Buttons, so command and CanExecute semantics are
         identical to the implicit style. -->
    <Style x:Key="Button.Secondary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource Brush.Panel}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.PanelBorderStrong}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
        <Setter Property="FontWeight" Value="Medium" />
    </Style>

    <Style x:Key="Button.Outline" TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.PanelBorderStrong}" />
    </Style>

    <!-- Icon buttons are square at the shared Base height so they line up with text buttons and
         inputs on the same row. Call sites used to override this to 32/36/40 individually. -->
    <Style x:Key="Button.Icon" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Width" Value="{StaticResource Size.Control.Compact}" />
        <Setter Property="Height" Value="{StaticResource Size.Control.Compact}" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="Margin" Value="0,0,8,0" />
    </Style>

    <!-- Ghost: no fill, no border until hover. For dense clusters where a full bordered button per
         action would turn the row into a grid of boxes. -->
    <Style x:Key="Button.Ghost" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="components:ButtonChrome.SuppressDisabledSurface" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <Style x:Key="Button.GhostIcon" TargetType="Button" BasedOn="{StaticResource Button.Icon}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <!-- Tool is the shared 36px square for editor rails and compact contextual toolbars. Icon is
         intentionally 32px for inline/title-bar actions; Tool gives the canvas chrome a little more
         hit area without turning it into a stack of cards. -->
    <Style x:Key="Button.Tool" TargetType="Button" BasedOn="{StaticResource Button.Ghost}">
        <Setter Property="Width" Value="{StaticResource Size.Control.Rail}" />
        <Setter Property="Height" Value="{StaticResource Size.Control.Rail}" />
        <Setter Property="MinHeight" Value="{StaticResource Size.Control.Rail}" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="Margin" Value="0,0" />
    </Style>

    <!--
        Per-row state icon (layer output / layer visibility). Compact and chromeless so a list of
        rows does not turn into a grid of controls: the state is carried by the glyph itself
        (bolt vs struck-through bolt, eye vs struck-through eye) plus colour, never colour alone.
    -->
    <Style x:Key="Toggle.LayerState" TargetType="ToggleButton">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid>
                        <Border x:Name="Surface" Background="Transparent" CornerRadius="{StaticResource Radius.Sm}" BorderBrush="Transparent" BorderThickness="1" />
                        <!-- The same two wash layers the Button template uses, so a toggle answers the
                             pointer exactly like a button does: hover 5 percent, press 8, no border change. -->
                        <Border x:Name="Hover" Background="{StaticResource Brush.HoverWash}" Opacity="0" IsHitTestVisible="False" CornerRadius="{StaticResource Radius.Sm}" />
                        <Border x:Name="Press" Background="{StaticResource Brush.HoverWash}" Opacity="0" IsHitTestVisible="False" CornerRadius="{StaticResource Radius.Sm}" />
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0.05" Duration="{StaticResource Motion.Hover}" EasingFunction="{StaticResource Ease.Out}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource Motion.Hover}" EasingFunction="{StaticResource Ease.Out}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Press" Property="Opacity" Value="0.08" />
                        </Trigger>
                        <Trigger Property="components:FocusVisual.IsVisible" Value="True">
                            <Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource Brush.FocusRing}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="{StaticResource Opacity.Disabled}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Square icon toggle. Same footprint as Button.Icon so it lines up in a row of icon buttons,
         with an on-state in the one interaction colour rather than a second switch idiom. -->
    <Style x:Key="Toggle.Icon" TargetType="ToggleButton">
        <Setter Property="Width" Value="{StaticResource Size.Control.Base}" />
        <Setter Property="Height" Value="{StaticResource Size.Control.Base}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid>
                        <Border x:Name="Surface" Background="Transparent" CornerRadius="{StaticResource Radius.Sm}" BorderBrush="Transparent" BorderThickness="1" />
                        <!-- The same two wash layers the Button template uses, so a toggle answers the
                             pointer exactly like a button does: hover 5 percent, press 8, no border change. -->
                        <Border x:Name="Hover" Background="{StaticResource Brush.HoverWash}" Opacity="0" IsHitTestVisible="False" CornerRadius="{StaticResource Radius.Sm}" />
                        <Border x:Name="Press" Background="{StaticResource Brush.HoverWash}" Opacity="0" IsHitTestVisible="False" CornerRadius="{StaticResource Radius.Sm}" />
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0.05" Duration="{StaticResource Motion.Hover}" EasingFunction="{StaticResource Ease.Out}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource Motion.Hover}" EasingFunction="{StaticResource Ease.Out}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Press" Property="Opacity" Value="0.08" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{StaticResource Brush.ActiveTool}" />
                            <Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource Brush.ActiveTool}" />
                            <Setter Property="Foreground" Value="{StaticResource Brush.OnActiveTool}" />
                        </Trigger>
                        <Trigger Property="components:FocusVisual.IsVisible" Value="True">
                            <Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource Brush.FocusRing}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="{StaticResource Opacity.Disabled}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Button.Jog" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Width" Value="52" />
        <Setter Property="Height" Value="52" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="Margin" Value="4" />
    </Style>

    <Style x:Key="Button.JogCenter" TargetType="Button" BasedOn="{StaticResource Button.Jog}">
        <Setter Property="Background" Value="{StaticResource Brush.SelectedSurface}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
    </Style>

    <!--
        Destructive/abort controls. The border used to be #4D2323 — a near-black maroon carried over
        from a dark theme, which on warm paper just read as a dirty grey outline and made Stop look
        like any other secondary button. A tinted surface plus a red border makes an abort control
        distinguishable at a glance without shouting; the solid variant below is for the one case
        where stopping the machine is the primary action on screen.
    -->
    <Style x:Key="Button.Danger" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Foreground" Value="{StaticResource Brush.Danger}" />
        <Setter Property="Background" Value="{StaticResource Brush.Panel}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.PanelBorderStrong}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="Button.DangerSolid" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Foreground" Value="{StaticResource Brush.OnAccent}" />
        <Setter Property="Background" Value="{StaticResource Brush.Danger}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Danger}" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Display}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- Title bar chrome buttons: flat until hover. The hover fill used to be #22242C — a dark-theme
         value that painted a near-black block behind a grey glyph on this white title bar, hiding the
         icon exactly when the pointer was on it. -->
    <!--
        The rail's edge handle. It straddles the rail's right border at mid-height, which is where a
        panel that resizes itself is expected to offer the grip - the same place the splitter on the
        other side of the workspace lives. The hamburger this replaces sat at the head of the rail and
        had the wrong shape for the job: three stacked lines is the icon for "here is a menu", not for
        "this edge moves", and at the top of the rail it read as a sixth navigation item.

        The chevron points the way the edge will travel and rotates 180° rather than swapping between
        two glyphs, so the same mark turns round instead of one mark being replaced by another. 220ms
        CubicEase EaseInOut, matching the rail it belongs to: this is on-screen movement, and the handle
        and the panel have to look like one gesture.

        Pill, not Radius.Sm: it is a circular grip sitting on a line, and Radius.Pill is the token for
        anything genuinely round.
    -->
    <!--
        A ring that appears for keyboard focus and not for a mouse click. WPF applies FocusVisualStyle
        only when focus arrived from the keyboard, which is the behaviour CSS spells :focus-visible and
        the reason to use it instead of an IsKeyboardFocused trigger: that trigger cannot tell a Tab from
        a click, so a control clicked with the mouse kept a cobalt ring until focus moved elsewhere.

        Drawn outside the control rather than replacing its border, so nothing about the control's own
        geometry shifts when it takes focus.
    -->
    <Style x:Key="FocusRing.Pill">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border BorderBrush="{DynamicResource Brush.FocusRing}" BorderThickness="2"
                            CornerRadius="{StaticResource Radius.Pill}" Margin="-3" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The click TARGET stays the full 46x32 caption-height rectangle (Fitts's law — a title-bar
         button is easiest to hit flush against the screen edge), but the visual hover/focus fill is
         inset with a rounded corner rather than painting that whole rectangle edge-to-edge. A
         full-bleed square hover fill read as a harsh, cropped-looking block jammed into the window's
         corner, out of step with the rounded language (Radius.Sm/Md/Lg/Pill) used everywhere else. -->
    <Style x:Key="Button.Chrome" TargetType="Button">
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Arrow" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}" Margin="0" CornerRadius="0">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource Brush.PanelRaised}" />
                            <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource Brush.PanelBorder}" />
                        </Trigger>
                        <Trigger Property="components:FocusVisual.IsVisible" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource Brush.PanelRaised}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource Brush.TextDisabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Close follows the Windows convention: red fill, white glyph. It was inheriting the blue
         selection accent, which is the colour this app uses for "selected", not "will close". -->
    <Style x:Key="Button.ChromeClose" TargetType="Button" BasedOn="{StaticResource Button.Chrome}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}" Margin="0" CornerRadius="0">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource Brush.Signal}" />
                            <Setter Property="Foreground" Value="{StaticResource Brush.OnAccent}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource Brush.SignalPressed}" />
                            <Setter Property="Foreground" Value="{StaticResource Brush.OnAccent}" />
                        </Trigger>
                        <Trigger Property="components:FocusVisual.IsVisible" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource Brush.DangerMuted}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource Brush.TextDisabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- ===================== Checkbox ===================== -->
    <!--
        A real checkbox: a small square that takes a tick.

        This was a sliding iOS-style switch. A switch suits a setting that turns a behaviour on and off
        for the whole app, but almost nothing here is that: these are properties of the selected object
        or of the import in front of you. A 40x22 pill next to a 32px numeric field reads as a piece of
        hardware bolted onto the row, and half a dozen of them turn a panel into a switchboard.
        LightBurn, Illustrator and CorelDRAW all use a square in the same places.

        One accent colour, and state is never carried by colour alone: checked is a filled square with
        a tick in it, so the shape says as much as the fill does.
    -->
    <Style TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="FontSize" Value="{StaticResource Size.Text.Body}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <!-- Transparent root with MinHeight so the label and the space around it are part
                         of the click target, not just the 18px box. -->
                    <StackPanel Orientation="Horizontal" Background="Transparent"
                                MinHeight="{StaticResource Size.Control.Compact}" VerticalAlignment="Center">
                        <Grid VerticalAlignment="Center">
                            <!-- Focus ring: 2px tint with a 1px gap outside the box, so it stays visible
                                 on a checked (solid tint) box as well as an empty one. -->
                            <Border x:Name="FocusRing" Margin="-3" CornerRadius="{StaticResource Radius.Sm}"
                                    BorderBrush="{DynamicResource Brush.FocusRing}" BorderThickness="0" />
                            <Border x:Name="Box" Width="18" Height="18"
                                CornerRadius="{StaticResource Radius.Xs}"
                                Background="{DynamicResource Brush.Panel}"
                                BorderBrush="{DynamicResource Brush.PanelBorderStrong}"
                                BorderThickness="1"
                                VerticalAlignment="Center">
                                <Path x:Name="Tick"
                                  Data="{StaticResource Glyph.Check}"
                                  Stroke="{DynamicResource Brush.OnAccent}"
                                  StrokeThickness="2.6"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Stretch="Uniform" Margin="4"
                                  Opacity="0" RenderTransformOrigin="0.5,0.5">
                                    <Path.RenderTransform><ScaleTransform x:Name="CheckScale" /></Path.RenderTransform>
                                </Path>
                            </Border>
                        </Grid>
                        <ContentPresenter x:Name="Label" Margin="8,0,0,0"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Left" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <!-- Plain Setters, not an animation. The switch style above documents why: a
                             control that was already checked when its template was applied rendered in
                             the off colours forever when the checked look existed only in
                             Trigger.EnterActions. -->
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource Brush.Accent}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                            <Setter TargetName="Tick" Property="Opacity" Value="1" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Tick" Storyboard.TargetProperty="Opacity" From="0" To="1"
                                                         Duration="{StaticResource Motion.Toggle}" EasingFunction="{StaticResource Ease.Out}" />
                                        <DoubleAnimation Storyboard.TargetName="CheckScale" Storyboard.TargetProperty="ScaleX" From="0.6" To="1"
                                                         Duration="{StaticResource Motion.Toggle}" EasingFunction="{StaticResource Ease.Release}" />
                                        <DoubleAnimation Storyboard.TargetName="CheckScale" Storyboard.TargetProperty="ScaleY" From="0.6" To="1"
                                                         Duration="{StaticResource Motion.Toggle}" EasingFunction="{StaticResource Ease.Release}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Tick" Storyboard.TargetProperty="Opacity" From="1" To="0"
                                                         Duration="{StaticResource Motion.Toggle}" EasingFunction="{StaticResource Ease.Out}" FillBehavior="Stop" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Brush.TextSecondary}" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsChecked" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource Brush.AccentHover}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Brush.AccentHover}" />
                        </MultiTrigger>
                        <Trigger Property="components:FocusVisual.IsVisible" Value="True">
                            <Setter TargetName="FocusRing" Property="BorderThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="{StaticResource Opacity.Disabled}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- ===================== Segmented control (2-choice RadioButton pair) ===================== -->

    <!--
        Segmented choice. The selected segment used to be a pale grey fill on a pale grey track,
        which on the layer's processing mode meant the difference between "cut" and "engrave" — two
        completely different machine behaviours — was told by about one shade of grey.

        Selected now says so four ways: white surface, accent border, accent text and a heavier
        weight. Hover is a neutral wash and deliberately shares nothing with it, so hovering an
        unselected segment can never be mistaken for having chosen it.
    -->
    <Style x:Key="Segment" TargetType="RadioButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="FontSize" Value="{StaticResource Size.Text.Body}" />
        <Setter Property="Height" Value="30" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bg" CornerRadius="{StaticResource Radius.Sm}" Background="Transparent"
                            BorderBrush="Transparent" BorderThickness="1"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource Brush.Hover}" />
                            <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource Brush.Pressed}" />
                        </Trigger>
                        <!--
                            Declared after hover so a hovered selected segment still reads as selected.

                            Selected is the tinted surface with blue text, not a solid cobalt block.
                            A segment strip is a choice among peers, not a call to action: filling it
                            solid put several large saturated rectangles on screen at once — the
                            inspector tab, the machine sub-tab, a mode switch — each competing with
                            Start, which is the one control that has earned that weight. It also made
                            the labels sitting next to those blocks hard to read against them.

                            This is also now the same "selected" language as the active tool and the
                            selected layer row, so one visual idea means selected everywhere.
                        -->
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource Brush.Surface}" />
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource Brush.SelectedBorder}" />
                            <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
                            <Setter Property="FontWeight" Value="Medium" />
                        </Trigger>
                        <Trigger Property="components:FocusVisual.IsVisible" Value="True">
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource Brush.FocusRing}" />
                            <Setter TargetName="Bg" Property="BorderThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource Brush.TextDisabled}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- For segment strips of three or four options in a narrow panel, where the default 12px side
         padding is what pushes the labels into a clip. -->
    <Style x:Key="Segment.Compact" TargetType="RadioButton" BasedOn="{StaticResource Segment}">
        <Setter Property="Padding" Value="4,4" />
    </Style>

    <Style x:Key="SegmentedTrack" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Brush.Field}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.PanelBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Md}" />
        <Setter Property="Padding" Value="4" />
    </Style>

    <!-- A popup, menu or dropdown surface opens with a 120 ms fade and a 4px slide up. Opacity and a
         RenderTransform only: nothing here changes layout. Applied by key to the three popup surfaces. -->
    <Style x:Key="PopupOpen" TargetType="Border">
        <Setter Property="Opacity" Value="0" />
        <Setter Property="RenderTransform">
            <Setter.Value>
                <TranslateTransform Y="4" />
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1"
                                         Duration="{StaticResource Motion.Popup}" EasingFunction="{StaticResource Ease.Out}" />
                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="4" To="0"
                                         Duration="{StaticResource Motion.Popup}" EasingFunction="{StaticResource Ease.Out}" />
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Style.Triggers>
    </Style>


    <!-- ===================== Inputs ===================== -->

    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource Brush.Field}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.PanelBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="MinHeight" Value="{StaticResource Size.Control.Base}" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="CaretBrush" Value="{StaticResource Brush.Tint}" />
        <Setter Property="SelectionBrush" Value="{StaticResource Brush.TextSelection}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource Radius.Md}">
                        <!-- No Padding here or on the host: TextBoxBase applies the control's own Padding to the content host itself,
                             so also passing it on doubled the inset (text sat 20px in, against 10px in a ComboBox). -->
                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource Brush.DisabledSurface}" />
                            <Setter Property="Foreground" Value="{StaticResource Brush.TextDisabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="PasswordBox">
        <Setter Property="Background" Value="{StaticResource Brush.Field}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.PanelBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="MinHeight" Value="{StaticResource Size.Control.Base}" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="CaretBrush" Value="{StaticResource Brush.Tint}" />
        <Setter Property="SelectionBrush" Value="{StaticResource Brush.TextSelection}" />
        <Setter Property="PasswordChar" Value="●" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource Radius.Md}">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource Brush.DisabledSurface}" />
                            <Setter Property="Foreground" Value="{StaticResource Brush.TextDisabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Background" Value="{StaticResource Brush.Field}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.PanelBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="MinHeight" Value="{StaticResource Size.Control.Base}" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="Toggle" Style="{x:Null}"
                                      Background="{TemplateBinding Background}"
                                      BorderBrush="{TemplateBinding BorderBrush}"
                                      BorderThickness="{TemplateBinding BorderThickness}"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                      ClickMode="Press">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <!-- The chevron used to carry RotateTransform Angle="180", so a
                                         closed dropdown pointed UP — the universal "already open"
                                         signal. It now points down at rest and flips only while the
                                         popup is actually open. -->
                                    <Border x:Name="FieldBg" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource Radius.Md}">
                                        <Grid Margin="{TemplateBinding Padding}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="16" />
                                            </Grid.ColumnDefinitions>
                                            <Path x:Name="Chevron" Grid.Column="1" Data="{StaticResource Glyph.ChevronDown}" Stroke="{StaticResource Brush.TextSecondary}" StrokeThickness="1.6" StrokeLineJoin="Round" Stretch="Uniform" Width="10" Height="10" RenderTransformOrigin="0.5,0.5" />
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="FieldBg" Property="BorderBrush" Value="{StaticResource Brush.TextMuted}" />
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="FieldBg" Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                                            <Setter TargetName="Chevron" Property="RenderTransform">
                                                <Setter.Value>
                                                    <RotateTransform Angle="180" />
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <!-- ContentTemplateSelector must be bound to ItemTemplateSelector (the stock template does): when a
                             ComboBox has a DisplayMemberPath, WPF stores it as an internal ItemTemplateSelector, and
                             without this binding the closed box printed the raw record
                             (JoinTypeOption { Value = Round, ... }) while the popup rows were fine. -->
                        <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                          ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                          Margin="{TemplateBinding Padding}" HorizontalAlignment="Left" VerticalAlignment="Center" />
                        <Popup x:Name="Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                            <Border Style="{StaticResource PopupOpen}" Background="{StaticResource Brush.Panel}" BorderBrush="{StaticResource Brush.PanelBorder}" BorderThickness="1" CornerRadius="{StaticResource Radius.Lg}" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="240" Effect="{StaticResource Shadow.Dropdown}">
                                <ScrollViewer Margin="4">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Toggle" Property="BorderBrush" Value="{StaticResource Brush.FocusRing}" />
                            <Setter TargetName="Toggle" Property="BorderThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="{StaticResource Opacity.Disabled}" />
                            <Setter TargetName="ContentSite" Property="TextElement.Foreground" Value="{StaticResource Brush.TextSecondary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        A select that opens something richer than a list of strings. The inspector's Materiál row has
        to offer two groups (the catalogue for the connected machine, and the operator's own saved
        recipes) with speed and power quoted on every entry, which a ComboBox of items cannot show
        without becoming a second control. This keeps the field chrome and the chevron so it reads as
        a select in a column of selects, and leaves what it opens to the caller.
    -->
    <Style x:Key="Field.Select" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource Brush.Field}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.PanelBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Height" Value="{StaticResource Size.Control.Base}" />
        <Setter Property="MinHeight" Value="{StaticResource Size.Control.Base}" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="FontSize" Value="{StaticResource Size.Text.Body}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource Radius.Md}">
                        <Grid Margin="{TemplateBinding Padding}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left" />
                            <Path Grid.Column="1" Data="{DynamicResource Glyph.ChevronDown}"
                                  Stroke="{DynamicResource Brush.TextSecondary}" StrokeThickness="1.6"
                                  StrokeLineJoin="Round" Stretch="Uniform" Width="10" Height="10"
                                  HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource Brush.TextMuted}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Brush.PanelRaised}" />
                        </Trigger>
                        <Trigger Property="components:FocusVisual.IsVisible" Value="True">
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource Brush.FocusRing}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="{StaticResource Opacity.Disabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="Padding" Value="8,8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bg" Background="Transparent" CornerRadius="{StaticResource Radius.Sm}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- IsHighlighted is the item the pointer or arrow key is over, not the answer.
                             It used to wear the cobalt selection tint, so hovering a dropdown looked
                             exactly like having picked something. Hover is a neutral wash. -->
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource Brush.Hover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource Brush.SelectedSurface}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Menu bar ===================== -->
    <!-- WPF's default Menu/MenuItem chrome is the classic Win32 blue-highlight look, which would
         clash with every other flat, custom-templated control in this theme — this mirrors the same
         hover-wash/no-3D-border language as the Button style above. Only top-level headers with a flat
         submenu of leaf items are needed anywhere in this app, so a single Placement="Bottom" popup is
         enough — there's no cascading sub-submenu case to handle. -->
    <Style TargetType="Menu">
        <Setter Property="Background" Value="{DynamicResource Brush.Panel}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="FontSize" Value="{StaticResource Size.Text.Body}" />
    </Style>

    <Style TargetType="Separator">
        <Setter Property="Background" Value="{DynamicResource Brush.PanelBorder}" />
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="4,4" />
    </Style>

    <!--
        The ContextMenu container itself. MenuItem and its submenus were styled, but the top-level
        menu was still stock WPF chrome: square corners, a flat grey hairline, no shadow, and the
        classic left gutter reserved for icons and check marks that nothing in this app puts there.
        So the zoom presets and the material recipe menu opened as a Windows-95 box hanging off a
        panel with 12px corners.

        HasDropShadow stays True on purpose: it is what makes the underlying Popup allow
        transparency, without which a rounded corner has nothing to be rounded against. The system
        shadow it would otherwise draw lives in the template being replaced here, so only
        Shadow.Dropdown survives — the same shadow the ComboBox popup and the submenu popup use.
    -->
    <Style TargetType="ContextMenu">
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="FontSize" Value="{StaticResource Size.Text.Body}" />
        <Setter Property="HasDropShadow" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Style="{StaticResource PopupOpen}" Background="{DynamicResource Brush.Panel}"
                            BorderBrush="{DynamicResource Brush.PanelBorder}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource Radius.Lg}"
                            Padding="4"
                            MinWidth="180"
                            Effect="{StaticResource Shadow.Dropdown}">
                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="MinHeight" Value="{StaticResource Size.Control.Compact}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Grid>
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="{StaticResource Radius.Sm}">
                            <ContentPresenter x:Name="HeaderHost" ContentSource="Header" RecognizesAccessKey="True"
                                              Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                        </Border>
                        <Popup x:Name="Popup" Placement="Bottom" IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                               AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                            <Border Style="{StaticResource PopupOpen}" Background="{DynamicResource Brush.Panel}" BorderBrush="{DynamicResource Brush.PanelBorder}" BorderThickness="1" CornerRadius="{StaticResource Radius.Lg}" Padding="4" Effect="{StaticResource Shadow.Dropdown}" MinWidth="180">
                                <StackPanel IsItemsHost="True" />
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Brush.Hover}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="{StaticResource Opacity.Disabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Progress ===================== -->

    <!--
        A light tooltip, not a dark one.

        It used to be near-white text on a near-black surface, and it rendered as a solid black block
        with no readable text in almost every case. The reason is a WPF rule rather than a typo: this
        theme sets Foreground on an implicit TextBlock style, and WPF resolves implicit styles for
        elements built inside a template against Application.Resources only - a style declared in the
        template's own resources is never consulted. So the TextBlock a ContentPresenter builds for a
        plain string tooltip always took the app-wide near-black foreground, and TextElement.Foreground
        on the template lost, because inheritance loses to a style Setter.

        Fighting that needs either a content template per content type or a colour the app-wide style
        already agrees with. The second is simpler and it is also the right answer for this palette,
        which is 90% neutral and light throughout: a dark tooltip was the only dark surface in the
        product. Text stays TextPrimary, exactly what the implicit style sets, so there is nothing left
        to lose an inheritance race.

        Tooltips whose content is an explicit TextBlock were readable before and stay readable: an
        explicit Style suppresses the implicit one, so those inherited the intended colour. That is why
        the failure looked intermittent rather than total.
    -->
    <Style TargetType="ToolTip">
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
        <Setter Property="Background" Value="{StaticResource Brush.Panel}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.PanelBorderStrong}" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="FontSize" Value="{StaticResource Size.Text.Meta}" />
        <Setter Property="HasDropShadow" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource Radius.Sm}"
                            Padding="{TemplateBinding Padding}"
                            TextElement.Foreground="{TemplateBinding Foreground}">
                        <Border.Resources>
                            <!--
                                A DataTemplate for string content, so a long tooltip wraps instead of
                                running off the screen. Unlike an implicit Style, an implicit
                                DataTemplate IS resolved through the normal resource lookup from the
                                ContentPresenter's own position in the tree, so declaring it here works.
                                Tooltips whose content is a UIElement are untouched by it.
                            -->
                            <DataTemplate DataType="{x:Type system:String}">
                                <TextBlock Text="{Binding}" TextWrapping="Wrap" MaxWidth="340"
                                           Foreground="{DynamicResource Brush.TextPrimary}" />
                            </DataTemplate>
                        </Border.Resources>
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ProgressBar">
        <Setter Property="Background" Value="{StaticResource Brush.Field}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Tint}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Height" Value="6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid x:Name="Root" ClipToBounds="True">
                        <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="{StaticResource Radius.Xs}" />
                        <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}"
                                CornerRadius="{StaticResource Radius.Xs}" HorizontalAlignment="Left" />
                        <!-- Indeterminate was unstyled, so a "working…" bar rendered as an empty track
                             and read as a stalled 0%. A full-width bar breathing between two opacities
                             says "running, duration unknown" without claiming a percentage.
                             Deliberately no position animation: a Storyboard inside a template trigger
                             has to be freezable, so it cannot read the bar's actual width. -->
                        <Border x:Name="Pulse" Background="{TemplateBinding Foreground}" CornerRadius="{StaticResource Radius.Xs}" Opacity="0" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsIndeterminate" Value="True">
                            <Setter TargetName="PART_Indicator" Property="Opacity" Value="0" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="PulseLoop">
                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                        <DoubleAnimation Storyboard.TargetName="Pulse" Storyboard.TargetProperty="Opacity"
                                                         From="0.42" To="0.88" Duration="{StaticResource Motion.Breathe}"
                                                         EasingFunction="{StaticResource Ease.Breathe}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="PulseLoop" />
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Slider ===================== -->
    <!--
        A 4px groove, a solid tint fill that ends under the thumb, and a white thumb with a tint rim.
        The stock WPF slider draws Aero chrome that belongs to no part of this product. The Track's
        page buttons are restyled because the implicit RepeatButton style (MinHeight 32) would
        otherwise make them 32px tall inside an 18px slider.
    -->
    <Style x:Key="Slider.Segment" TargetType="RepeatButton">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style TargetType="Slider">
        <Setter Property="Focusable" Value="True" />
        <Setter Property="IsMoveToPointEnabled" Value="True" />
        <Setter Property="Height" Value="18" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Background="Transparent">
                        <Border Height="4" VerticalAlignment="Center" CornerRadius="{StaticResource Radius.Xs}"
                                Background="{DynamicResource Brush.ToggleTrackOff}" />
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource Slider.Segment}" Command="Slider.DecreaseLarge">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Grid Background="Transparent">
                                                <!-- Runs on under the thumb (drawn last, opaque) so the fill ends at
                                                     the thumb centre at every value, including the minimum. -->
                                                <Border Height="4" VerticalAlignment="Center" Margin="0,0,-9,0"
                                                        CornerRadius="{StaticResource Radius.Xs}"
                                                        Background="{DynamicResource Brush.Tint}" />
                                            </Grid>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource Slider.Segment}" Command="Slider.IncreaseLarge">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="Transparent" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb x:Name="Grip" Width="16" Height="16" Focusable="False" OverridesDefaultStyle="True">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Grid Background="Transparent">
                                                <Ellipse Fill="{DynamicResource Brush.Panel}"
                                                         Stroke="{DynamicResource Brush.Tint}" StrokeThickness="2" />
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Width" Value="17" />
                                                    <Setter Property="Height" Value="17" />
                                                </Trigger>
                                                <Trigger Property="IsMouseCaptured" Value="True">
                                                    <Setter Property="Width" Value="18" />
                                                    <Setter Property="Height" Value="18" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="{StaticResource Opacity.Disabled}" />
                        </Trigger>
                        <Trigger Property="components:FocusVisual.IsVisible" Value="True">
                            <Setter TargetName="Grip" Property="Width" Value="18" />
                            <Setter TargetName="Grip" Property="Height" Value="18" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Lists ===================== -->

    <Style TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!-- The default template had no hover and no selected state at all, so selection in any list
         using this style was invisible. -->
    <Style TargetType="ListBoxItem">
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid>
                        <Border x:Name="RowBg" Background="Transparent" CornerRadius="{StaticResource Radius.Sm}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <Border x:Name="Indicator" Width="2" HorizontalAlignment="Left" Margin="0,8"
                                Background="{StaticResource Brush.SelectedIndicator}" Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="RowBg" Property="Background" Value="{StaticResource Brush.Hover}" />
                            <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="RowBg" Property="Background" Value="{StaticResource Brush.Selected}" />
                            <Setter TargetName="Indicator" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
                        </Trigger>
                        <Trigger Property="components:FocusVisual.IsVisible" Value="True">
                            <Setter TargetName="RowBg" Property="BorderBrush" Value="{StaticResource Brush.FocusRing}" />
                            <Setter TargetName="RowBg" Property="BorderThickness" Value="2" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Slim, quiet scrollbars for the light workbench.

        The previous version set Width only and hardcoded IsDirectionReversed="True" for every
        orientation. IsDirectionReversed is correct for a vertical bar and inverted for a horizontal
        one, so horizontal scrollbars scrolled backwards; and with no Height setter a horizontal bar
        collapsed to a 2px sliver. Vertical and horizontal now get their own template.
    -->
    <Style x:Key="ScrollBarThumb" TargetType="Thumb">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="ThumbFill" Background="{StaticResource Brush.ScrollThumb}" CornerRadius="{StaticResource Radius.Xs}" Margin="4" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ThumbFill" Property="Background" Value="{StaticResource Brush.ScrollThumbHover}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="ThumbFill" Property="Background" Value="{StaticResource Brush.TextSecondary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        A hairline scrollbar for a strip that overflows, where the app's 10px track is more furniture
        than the thing it scrolls. Keyed, not implicit, and that is the whole point: a ScrollBar is
        created inside the ScrollViewer's ControlTemplate, and WPF resolves implicit styles for
        template-created elements only in Application.Resources — so an implicit override placed in a
        ScrollViewer's own Resources is silently ignored. It has to be handed over by key.
    -->
    <Style x:Key="ScrollBarThumb.Slim" TargetType="Thumb" BasedOn="{StaticResource ScrollBarThumb}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <!-- Xs, not Pill. WPF clamps a Border's corner radius per axis, so a pill radius
                         on something 3px tall and hundreds wide is drawn as a lens rather than a
                         rounded bar — it read as a stray bubble under the toolbar. -->
                    <Border x:Name="ThumbFill" Background="{StaticResource Brush.ScrollThumb}"
                            CornerRadius="{StaticResource Radius.Xs}" Margin="0" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ThumbFill" Property="Background" Value="{StaticResource Brush.ScrollThumbHover}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="ThumbFill" Property="Background" Value="{StaticResource Brush.TextSecondary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ScrollBar.Slim" TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Height" Value="5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="{TemplateBinding Background}">
                        <Track x:Name="PART_Track" IsDirectionReversed="False">
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ScrollBarThumb.Slim}" />
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        6px, not the previous 10px: at 10px this read as a leftover OS scrollbar against the rest of
        the app's thin-stroke, low-chrome language, especially wherever a panel scrolls by default
        (the Designer inspector, any dialog body) rather than as an occasional overflow affordance.

        The MinWidth/MinHeight="0" setters are load-bearing, not decoration: WPF's ScrollBar has a
        built-in default MinWidth/MinHeight (from SystemParameters' scrollbar metrics, ~15-17px on a
        typical display) that a Style's Width/Height Setter does NOT override on its own — Width only
        sets the element's preferred size, MinWidth still floors the final rendered size underneath
        it. Every previous value here (this app's old 10px, and briefly a 6px attempt) was silently
        clamped back up to that native floor; only the Thumb's own inset ever actually got thinner,
        which is what made the bug so easy to miss in a casual screenshot. Confirmed with a
        pixel-level readback of the rendered window (GetPixel across the thumb), not just a visual
        check — don't downgrade this back to eyeballing a screenshot if it regresses.

        SelectionPropertiesBar and KamilAssistantHost used to also carry a
        `<Style TargetType="ScrollBar">` in their own ScrollViewer.Resources expecting the keyed
        ScrollBar.Slim template to win locally — that's a different, unrelated dead pattern (an
        implicit style placed in a ScrollViewer's own Resources does not reach the ScrollBar its
        default template generates), and was removed from both files. This one definition is what
        every scrollbar in the app now actually renders with.
    -->
    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="6" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="{TemplateBinding Background}">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ScrollBarThumb.Slim}" />
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="Height" Value="6" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="{TemplateBinding Background}">
                                <Track x:Name="PART_Track" IsDirectionReversed="False">
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource ScrollBarThumb.Slim}" />
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>


    <!-- ===================== Implicit fallbacks for controls with no bespoke style =====================
         A ToggleButton, RadioButton, RepeatButton or Expander that carries no Style used to render the
         stock Windows chrome: a blue hover, a grey bevel, a circled arrow. These give them the
         same wash mechanic as Button. Styles that name themselves (Toggle.Icon, Segment, ...) are
         unaffected, an explicit Style always replaces the implicit one. Plain Setters, no animation,
         so there is no state that can be left behind. -->
    <Style TargetType="ToggleButton" BasedOn="{StaticResource Toggle.Icon}" />
    <Style TargetType="RadioButton" BasedOn="{StaticResource Segment}" />
    <Style TargetType="RepeatButton">
        <Setter Property="Background" Value="{StaticResource Brush.PanelRaised}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.PanelBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="MinHeight" Value="{StaticResource Size.Control.Compact}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Grid>
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource Radius.Md}" />
                        <Border x:Name="Hover" Background="{StaticResource Brush.HoverWash}" Opacity="0" CornerRadius="{StaticResource Radius.Md}" />
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Hover" Property="Opacity" Value="0.05" /></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Hover" Property="Opacity" Value="0.08" /></Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource Brush.DisabledSurface}" />
                            <Setter Property="Foreground" Value="{StaticResource Brush.TextDisabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="Expander">
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <DockPanel>
                        <ToggleButton x:Name="HeaderToggle" Style="{x:Null}" DockPanel.Dock="Top" Cursor="Hand" Focusable="True"
                                      IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Grid Background="Transparent" MinHeight="{StaticResource Size.Control.Compact}">
                                        <Border x:Name="Hover" Background="{StaticResource Brush.HoverWash}" Opacity="0" CornerRadius="{StaticResource Radius.Sm}" />
                                        <StackPanel Orientation="Horizontal" Margin="4,0">
                                            <Path x:Name="Chevron" Data="{StaticResource Glyph.ChevronDown}" Stroke="{StaticResource Brush.TextSecondary}"
                                                  StrokeThickness="1.6" StrokeLineJoin="Round" Stretch="Uniform" Width="10" Height="10"
                                                  VerticalAlignment="Center" Margin="0,0,8,0" RenderTransformOrigin="0.5,0.5">
                                                <Path.RenderTransform><RotateTransform Angle="-90" /></Path.RenderTransform>
                                            </Path>
                                            <ContentPresenter ContentSource="Content" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Chevron" Property="RenderTransform"><Setter.Value><RotateTransform Angle="0" /></Setter.Value></Setter>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Hover" Property="Opacity" Value="0.05" /></Trigger>
                                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Hover" Property="Opacity" Value="0.08" /></Trigger>
                                        <Trigger Property="components:FocusVisual.IsVisible" Value="True">
                                            <Setter TargetName="Hover" Property="Opacity" Value="0.08" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                            <ContentPresenter ContentSource="Header" />
                        </ToggleButton>
                        <ContentPresenter x:Name="Body" Visibility="Collapsed" Margin="{TemplateBinding Padding}" />
                    </DockPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True"><Setter TargetName="Body" Property="Visibility" Value="Visible" /></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="{StaticResource Opacity.Disabled}" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
