<UserControl x:Class="Lasero.App.Controls.SceneCanvas"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:components="clr-namespace:Lasero.App.Components"
             Focusable="True" FocusVisualStyle="{x:Null}"
             KeyDown="OnCanvasKeyDown"
             KeyUp="OnCanvasKeyUp"
             ContextMenuOpening="OnCanvasContextMenuOpening"
             Loaded="OnSceneCanvasLoaded"
             Unloaded="OnSceneCanvasUnloaded"
             LostKeyboardFocus="OnCanvasLostKeyboardFocus">
    <UserControl.Resources>
        <!--
            Context-menu row. The app-wide MenuItem style only draws the header, which is right for the
            flat zoom and recipe menus but drops everything a command menu needs: the icon column, the
            shortcut on the right, the check mark and a submenu that opens beside its row. Applied
            explicitly by SceneCanvas.ContextMenus.cs, so no other menu in the app changes.
        -->
        <Style x:Key="CanvasMenuItem" TargetType="MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
            <Setter Property="MinHeight" Value="{StaticResource Size.Control.Compact}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Grid SnapsToDevicePixels="True">
                            <Border x:Name="Bg" Background="Transparent" CornerRadius="{StaticResource Radius.Sm}" />
                            <Grid Margin="4,0,8,0" MinHeight="{TemplateBinding MinHeight}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="16" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter x:Name="IconHost" Grid.Column="0" ContentSource="Icon"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Path x:Name="CheckMark" Grid.Column="0" Data="{StaticResource Glyph.Check}"
                                      Stroke="{DynamicResource Brush.Accent}" StrokeThickness="2"
                                      Width="12" Height="12" Stretch="Uniform"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                                <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="False"
                                                  Margin="4,0,16,0" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}"
                                           Foreground="{DynamicResource Brush.TextMuted}"
                                           FontSize="{StaticResource Size.Text.Meta}"
                                           VerticalAlignment="Center" Margin="0,0,4,0" />
                                <Path x:Name="Arrow" Grid.Column="3" Data="{StaticResource Glyph.ChevronRight}"
                                      Stroke="{DynamicResource Brush.TextMuted}" StrokeThickness="1.5"
                                      Width="10" Height="10" Stretch="Uniform"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                            </Grid>
                            <Popup x:Name="SubPopup" Placement="Right" HorizontalOffset="-2" VerticalOffset="-5"
                                   IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                <Border Background="{DynamicResource Brush.Panel}"
                                        BorderBrush="{DynamicResource Brush.PanelBorder}" BorderThickness="1"
                                        CornerRadius="{StaticResource Radius.Lg}" Padding="4"
                                        Effect="{StaticResource Shadow.Dropdown}" MinWidth="180">
                                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Role" Value="SubmenuHeader">
                                <Setter TargetName="Arrow" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Brush.Field}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!--
        No card. The canvas used to sit inside a rounded, bordered, drop-shadowed sheet, which framed
        the drawing area as one panel among several; in the editor it is the subject, so it runs to
        the edges of its column and the rail and inspector borders do the separating. Nothing about
        the coordinate maths, hit testing, rulers or bed rendering changed — only this wrapper.
    -->
    <Border>
        <Border Background="{StaticResource Brush.Canvas.Surround}" ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="20" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="26" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Corner tile, and the two ruler strips — same fixed size as the classic
                     Excel/LightBurn ruler convention: rulers stay a constant screen size while
                     only their tick positions pan/zoom with the canvas. -->
                <Border Grid.Row="0" Grid.Column="0" Background="{StaticResource Brush.Panel}" BorderBrush="{StaticResource Brush.PanelBorder}" BorderThickness="0,0,1,1" />
                <Canvas x:Name="TopRuler" Grid.Row="0" Grid.Column="1" Background="{StaticResource Brush.Panel}" ClipToBounds="True" />
                <Canvas x:Name="LeftRuler" Grid.Row="1" Grid.Column="0" Background="{StaticResource Brush.Panel}" ClipToBounds="True" />

                <Canvas x:Name="DrawCanvas" Grid.Row="1" Grid.Column="1" Background="Transparent" ClipToBounds="True"
                        SizeChanged="OnSizeChanged"
                        PreviewMouseLeftButtonDown="OnDrawCanvasPreviewMouseLeftButtonDown"
                        PreviewMouseLeftButtonUp="OnDrawCanvasPreviewMouseLeftButtonUp"
                        PreviewMouseDown="OnDrawCanvasMouseDown"
                        PreviewMouseUp="OnDrawCanvasMouseUp"
                        LostMouseCapture="OnDrawCanvasLostMouseCapture"
                        PreviewMouseWheel="OnDrawCanvasMouseWheel"
                        MouseLeftButtonDown="OnDrawCanvasMouseLeftButtonDown"
                        MouseLeftButtonUp="OnDrawCanvasMouseLeftButtonUp"
                        MouseRightButtonDown="OnCanvasBackgroundRightButtonDown"
                        MouseMove="OnDrawCanvasMouseMove">
                </Canvas>
            </Grid>
        </Border>
    </Border>
</UserControl>
