<Window x:Class="Lasero.App.DeviceWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:components="clr-namespace:Lasero.App.Components"
        xmlns:conv="clr-namespace:Lasero.App.Converters"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        x:Name="WizardDialog"
        Title="Průvodce zařízením" Width="720" Height="620"
        MinWidth="720" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Brush.Background}" Foreground="{StaticResource Brush.TextPrimary}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
        <conv:NotNullToVisibilityConverter x:Key="NotNullToVisibility" />

        <Style x:Key="WizardStepRow" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>

        <Style x:Key="FoundMachineCard" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="CardBorder" Padding="14,12"
                                Background="{StaticResource Brush.Panel}"
                                BorderBrush="{StaticResource Brush.PanelBorder}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource Radius.Md}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="{StaticResource Brush.PanelBorderStrong}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                                <Setter TargetName="CardBorder" Property="Background" Value="{StaticResource Brush.SelectedSurface}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="72" />
        </Grid.RowDefinitions>

        <Border Background="{StaticResource Brush.Panel}"
                BorderBrush="{StaticResource Brush.PanelBorder}" BorderThickness="0,0,0,1"
                Padding="26,20">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <components:IconGlyph IconData="{StaticResource Glyph.Device}"
                                          Width="{StaticResource Size.Icon.Lg}" Height="{StaticResource Size.Icon.Lg}"
                                          Margin="0,1,10,0" Foreground="{StaticResource Brush.AccentText}" />
                    <TextBlock Text="Průvodce zařízením" Style="{StaticResource PageTitle}" />
                </StackPanel>
                <TextBlock Text="Najdeme vaši gravírku, načteme rozměry pracovní plochy a uložíme je jako výchozí."
                           Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="30,5,0,0" />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="26,20">
            <Grid>
                <!-- 1. Před hledáním -->
                <StackPanel Visibility="{Binding IsIntro, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="Než začneme" Style="{StaticResource PanelTitle}" />
                    <TextBlock Text="Zkontrolujte tři věci. Pak stačí kliknout na Vyhledat zařízení."
                               Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,0,0,18" />

                    <Grid Style="{StaticResource WizardStepRow}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="34" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Width="26" Height="26" CornerRadius="{StaticResource Radius.Pill}" Background="{StaticResource Brush.SelectedSurface}" VerticalAlignment="Top">
                            <TextBlock Text="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource Brush.AccentText}" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <TextBlock Text="Gravírka je zapnutá a připojená USB kabelem" FontWeight="SemiBold" />
                            <TextBlock Text="Datový kabel, ne jen nabíjecí. Pokud je stroj vypnutý, počítač ho neuvidí."
                                       Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,3,0,0" />
                        </StackPanel>
                    </Grid>

                    <Grid Style="{StaticResource WizardStepRow}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="34" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Width="26" Height="26" CornerRadius="{StaticResource Radius.Pill}" Background="{StaticResource Brush.Field}" VerticalAlignment="Top">
                            <TextBlock Text="2" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <TextBlock Text="Žádný jiný program stroj nedrží" FontWeight="SemiBold" />
                            <TextBlock Text="LightBurn, LaserGRBL nebo sériový monitor si port obsadí a Lasero se pak nepřipojí. Zavřete je."
                                       Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,3,0,0" />
                        </StackPanel>
                    </Grid>

                    <Grid Style="{StaticResource WizardStepRow}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="34" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Width="26" Height="26" CornerRadius="{StaticResource Radius.Pill}" Background="{StaticResource Brush.Field}" VerticalAlignment="Top">
                            <TextBlock Text="3" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <TextBlock Text="Laser zůstane vypnutý" FontWeight="SemiBold" />
                            <TextBlock Text="Hledání se stroje jen zeptá na jeho nastavení. Nepohne osami a nic nezapne."
                                       Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,3,0,0" />
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <!-- 2. Hledání -->
                <StackPanel Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <components:IconGlyph IconData="{StaticResource Glyph.Search}"
                                          Width="{StaticResource Size.Icon.Xl}" Height="{StaticResource Size.Icon.Xl}"
                                          HorizontalAlignment="Center" Foreground="{StaticResource Brush.AccentText}" />
                    <TextBlock Text="Hledám zařízení" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,0" />
                    <TextBlock Text="{Binding ScanStatus}" Style="{StaticResource Text.Muted}"
                               HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                               MaxWidth="420" Margin="0,6,0,0" />
                    <ProgressBar IsIndeterminate="True" Height="4" Width="320" Margin="0,18,0,0" />
                </StackPanel>

                <!-- 3a. Nalezeno -->
                <StackPanel Visibility="{Binding FoundSomething, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="Nalezená zařízení" Style="{StaticResource PanelTitle}" />
                    <TextBlock Text="Vyberte to, které chcete používat. Simulátor slouží ke zkoušení bez stroje."
                               Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,0,0,16" />

                    <ListBox ItemsSource="{Binding FoundMachines}" SelectedItem="{Binding SelectedMachine}"
                             Background="Transparent" BorderThickness="0" Padding="0"
                             ItemContainerStyle="{StaticResource FoundMachineCard}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             HorizontalContentAlignment="Stretch">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid automation:AutomationProperties.Name="{Binding DisplayName}">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <components:IconGlyph IconData="{StaticResource Glyph.Device}"
                                                              Width="{StaticResource Size.Icon.Md}" Height="{StaticResource Size.Icon.Md}"
                                                              Margin="0,2,12,0" VerticalAlignment="Top" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Style="{StaticResource Text.Muted}" Margin="0,3,0,0">
                                                <Run Text="{Binding PortName, Mode=OneWay}" /><Run Text="  ·  " />
                                                <Run Text="{Binding BaudRate, Mode=OneWay}" /><Run Text=" Bd" />
                                            </TextBlock>
                                            <TextBlock Style="{StaticResource Text.Muted}" Margin="0,3,0,0"
                                                       Visibility="{Binding ReportsWorkArea, Converter={StaticResource BoolToVisibility}}">
                                                <Run Text="Pracovní plocha " /><Run Text="{Binding Profile.MaxTravelXmm, Mode=OneWay, StringFormat={}{0:0.#}}" /><Run Text=" × " /><Run Text="{Binding Profile.MaxTravelYmm, Mode=OneWay, StringFormat={}{0:0.#}}" /><Run Text=" mm" />
                                            </TextBlock>
                                            <StackPanel Orientation="Horizontal" Margin="0,7,0,0"
                                                        Visibility="{Binding IsSimulator, Converter={StaticResource BoolToVisibility}}">
                                                <Border Style="{StaticResource Badge}">
                                                    <TextBlock Text="Bez hardwaru" FontWeight="SemiBold" />
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>

                <!-- 3b. Nenalezeno -->
                <StackPanel Visibility="{Binding FoundNothing, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="Žádné zařízení se nenašlo" Style="{StaticResource PanelTitle}" />
                    <TextBlock Text="Projděte prosím tyto tři nejčastější příčiny a spusťte hledání znovu."
                               Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,0,0,16" />

                    <Border Style="{StaticResource InspectorSection}" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Chybí ovladač USB převodníku" FontWeight="SemiBold" />
                            <TextBlock Text="Většina gravírek používá čip CH340 nebo CP2102. Bez ovladače se port ve Windows vůbec neobjeví — poznáte to ve Správci zařízení podle neznámého zařízení."
                                       Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource InspectorSection}" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Port drží jiný program" FontWeight="SemiBold" />
                            <TextBlock Text="Zavřete LightBurn, LaserGRBL a jakýkoli sériový monitor. Port smí být otevřený jen v jednom programu."
                                       Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource InspectorSection}">
                        <StackPanel>
                            <TextBlock Text="Kabel přenáší jen napájení" FontWeight="SemiBold" />
                            <TextBlock Text="Nabíjecí USB kabely nemají datové vodiče. Vyzkoušejte jiný kabel a jiný port na počítači."
                                       Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 4. Nastavení -->
                <StackPanel Visibility="{Binding IsSetup, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="Nastavení stroje" Style="{StaticResource PanelTitle}" />
                    <TextBlock Text="{Binding SetupMessage}" Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,0,0,16"
                               Visibility="{Binding SetupMessage, Converter={StaticResource NotNullToVisibility}}" />

                    <TextBlock Text="Název zařízení" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding MachineName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,16"
                             automation:AutomationProperties.Name="Název zařízení" />

                    <TextBlock Text="Pracovní plocha" Style="{StaticResource FieldLabel}" />
                    <TextBlock Text="Načteno z nastavení GRBL ($130 a $131). Pokud rozměry nesedí, přepište je — platí to, co je tady."
                               Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,0,0,8" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Border Style="{StaticResource UnitField.Shell}" Width="126" Height="{StaticResource Size.Control.Base}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="mm" Style="{StaticResource UnitField.Suffix}" />
                                <TextBox Style="{StaticResource UnitField.Input}" LostFocus="OnWorkAreaEdited"
                                         automation:AutomationProperties.Name="Šířka pracovní plochy v milimetrech"
                                         Text="{Binding Connection.WorkAreaWidthMm, StringFormat=0.##, UpdateSourceTrigger=LostFocus}" />
                            </DockPanel>
                        </Border>
                        <TextBlock Text="×" Style="{StaticResource Text.Muted}" Margin="10,0" VerticalAlignment="Center" />
                        <Border Style="{StaticResource UnitField.Shell}" Width="126" Height="{StaticResource Size.Control.Base}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="mm" Style="{StaticResource UnitField.Suffix}" />
                                <TextBox Style="{StaticResource UnitField.Input}" LostFocus="OnWorkAreaEdited"
                                         automation:AutomationProperties.Name="Výška pracovní plochy v milimetrech"
                                         Text="{Binding Connection.WorkAreaHeightMm, StringFormat=0.##, UpdateSourceTrigger=LostFocus}" />
                            </DockPanel>
                        </Border>
                    </StackPanel>

                    <Border Style="{StaticResource InspectorSection}" BorderBrush="{StaticResource Brush.Warning}"
                            Visibility="{Binding LaserModeNeedsAttention, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <components:IconGlyph IconData="{StaticResource Glyph.Warning}"
                                                      Width="{StaticResource Size.Icon.Sm}" Height="{StaticResource Size.Icon.Sm}"
                                                      Foreground="{StaticResource Brush.Warning}" Margin="0,0,8,0" />
                                <TextBlock Text="Laserový režim není zapnutý" FontWeight="SemiBold" />
                            </StackPanel>
                            <TextBlock Text="GRBL parametr $32 řídí, zda laser zhasne při zastavení. Bez něj stroj v rozích zpomalí, ale paprsek hoří dál a propálí materiál. Zápis změní nastavení přímo ve stroji."
                                       Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,0,0,10" />
                            <Button HorizontalAlignment="Left" Command="{Binding EnableLaserModeCommand}">
                                <components:IconLabel IconData="{StaticResource Glyph.Zap}" Text="Zapnout laserový režim ($32=1)" />
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 5. Hotovo -->
                <StackPanel Visibility="{Binding IsDone, Converter={StaticResource BoolToVisibility}}"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <components:IconGlyph IconData="{StaticResource Glyph.Check}"
                                          Width="{StaticResource Size.Icon.Xl}" Height="{StaticResource Size.Icon.Xl}"
                                          HorizontalAlignment="Center" Foreground="{StaticResource Brush.Success}" />
                    <TextBlock Text="Zařízení je nastavené" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,0" />
                    <TextBlock Style="{StaticResource Text.Muted}" HorizontalAlignment="Center" TextAlignment="Center"
                               TextWrapping="Wrap" MaxWidth="420" Margin="0,6,0,0">
                        <Run Text="{Binding MachineName, Mode=OneWay}" /><Run Text=" · " />
                        <Run Text="{Binding Connection.WorkAreaWidthMm, Mode=OneWay, StringFormat={}{0:0.#}}" /><Run Text=" × " />
                        <Run Text="{Binding Connection.WorkAreaHeightMm, Mode=OneWay, StringFormat={}{0:0.#}}" /><Run Text=" mm" />
                    </TextBlock>
                    <TextBlock Text="Před ostrou úlohou vždy ověřte umístění rámováním."
                               Style="{StaticResource Text.Muted}" HorizontalAlignment="Center" Margin="0,10,0,0" />
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <Border Grid.Row="2" Background="{StaticResource Brush.Panel}"
                BorderBrush="{StaticResource Brush.PanelBorder}" BorderThickness="0,1,0,0" Padding="26,0">
            <Grid>
                <Button HorizontalAlignment="Left" VerticalAlignment="Center" Command="{Binding BackCommand}"
                        Visibility="{Binding IsResults, Converter={StaticResource BoolToVisibility}}"
                        Content="Zpět" />
                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
                    <Button Content="Zrušit" Click="OnCloseClick" Margin="0,0,10,0"
                            Visibility="{Binding IsDone, Converter={StaticResource InverseBoolToVisibility}}" />

                    <Button Style="{StaticResource PrimaryBlue}" Command="{Binding ScanCommand}"
                            Visibility="{Binding IsIntro, Converter={StaticResource BoolToVisibility}}">
                        <components:IconLabel IconData="{StaticResource Glyph.Search}" Text="Vyhledat zařízení" Foreground="White" />
                    </Button>

                    <Button Content="Zastavit hledání" Command="{Binding CancelScanCommand}"
                            Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}" />

                    <Button Style="{StaticResource PrimaryBlue}" Command="{Binding UseSelectedMachineCommand}"
                            Visibility="{Binding FoundSomething, Converter={StaticResource BoolToVisibility}}">
                        <components:IconLabel IconData="{StaticResource Glyph.Connect}" Text="Použít vybrané" Foreground="White" />
                    </Button>

                    <Button Style="{StaticResource PrimaryBlue}" Command="{Binding ScanCommand}"
                            Visibility="{Binding FoundNothing, Converter={StaticResource BoolToVisibility}}">
                        <components:IconLabel IconData="{StaticResource Glyph.Refresh}" Text="Hledat znovu" Foreground="White" />
                    </Button>

                    <Button Style="{StaticResource PrimaryBlue}" Command="{Binding FinishCommand}"
                            Visibility="{Binding IsSetup, Converter={StaticResource BoolToVisibility}}">
                        <components:IconLabel IconData="{StaticResource Glyph.Check}" Text="Uložit a dokončit" Foreground="White" />
                    </Button>

                    <Button Style="{StaticResource PrimaryBlue}" Click="OnCloseClick"
                            Visibility="{Binding IsDone, Converter={StaticResource BoolToVisibility}}">
                        <components:IconLabel IconData="{StaticResource Glyph.Check}" Text="Zavřít" Foreground="White" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
