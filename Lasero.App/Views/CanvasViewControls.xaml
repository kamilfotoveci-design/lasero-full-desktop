<UserControl x:Class="Lasero.App.Views.CanvasViewControls"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Lasero.App.Converters"
             xmlns:components="clr-namespace:Lasero.App.Components"
             xmlns:vm="clr-namespace:Lasero.App.ViewModels"
             x:Name="Root">
    <!--
        The always-available view cluster, floating at the lower right of the canvas. Undo and redo
        live here rather than in the contextual bar above because they must be reachable when nothing
        is selected — which is exactly when the contextual bar is not on screen.

        Zoom talks to the canvas element directly (TargetCanvas), not through a view model: the scale
        belongs to the view, and SceneCanvas already owns it and reports the result through
        ZoomPercent after clamping.
    -->
    <UserControl.Resources>
        <conv:EnumToBooleanConverter x:Key="EnumToBoolean" />

        <Style x:Key="ClusterButton" TargetType="Button" BasedOn="{StaticResource Button.Tool}">
            <Setter Property="Width" Value="{StaticResource Size.Control.Compact}" />
            <Setter Property="Height" Value="{StaticResource Size.Control.Compact}" />
            <Setter Property="MinHeight" Value="{StaticResource Size.Control.Compact}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0" />
        </Style>

        <Style x:Key="ClusterToggle" TargetType="ToggleButton" BasedOn="{StaticResource Toggle.Icon}">
            <Setter Property="Width" Value="{StaticResource Size.Control.Compact}" />
            <Setter Property="Height" Value="{StaticResource Size.Control.Compact}" />
            <Setter Property="Margin" Value="0,0" />
        </Style>

        <Style x:Key="ClusterDivider" TargetType="Border">
            <Setter Property="Width" Value="1" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Margin" Value="8,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource Brush.PanelBorder}" />
        </Style>

        <Style x:Key="ClusterGlyph" TargetType="components:IconGlyph">
            <Setter Property="Width" Value="{StaticResource Size.Icon.Sm}" />
            <Setter Property="Height" Value="{StaticResource Size.Icon.Sm}" />
        </Style>
    </UserControl.Resources>

    <Border Background="{DynamicResource Brush.Panel}"
            BorderBrush="{DynamicResource Brush.PanelBorder}" BorderThickness="1"
            CornerRadius="{StaticResource Radius.Md}" Padding="4,4"
            Effect="{StaticResource Shadow.Sheet}">
        <StackPanel Orientation="Horizontal">
            <Button Style="{StaticResource ClusterButton}" Command="{Binding Scene.UndoCommand}"
                    ToolTipService.ShowOnDisabled="True" ToolTip="Vrátí poslední změnu v návrhu (Ctrl+Z)" AutomationProperties.Name="Zpět">
                <components:IconGlyph Style="{StaticResource ClusterGlyph}" IconData="{StaticResource Glyph.Undo}" />
            </Button>
            <Button Style="{StaticResource ClusterButton}" Command="{Binding Scene.RedoCommand}"
                    ToolTipService.ShowOnDisabled="True" ToolTip="Provede znovu naposledy vrácenou změnu (Ctrl+Y)" AutomationProperties.Name="Znovu">
                <components:IconGlyph Style="{StaticResource ClusterGlyph}" IconData="{StaticResource Glyph.Redo}" />
            </Button>

            <Border Style="{StaticResource ClusterDivider}" />

            <!--
                Centre the bed, at the current zoom. Panning itself is not a button here: it is the
                middle mouse button, space+drag and H, all of which work without leaving the tool you
                are in — and a pan *mode* was one more state to get stuck in for something already
                reachable three ways. What was actually missing was a way back to the work area after
                panning off it, which is this.
            -->
            <Button Style="{StaticResource ClusterButton}" Click="OnCenterClick"
                    ToolTip="Vrátí pohled na střed pracovní plochy, přiblížení se nezmění"
                    AutomationProperties.Name="Vycentrovat pracovní plochu">
                <components:IconGlyph Style="{StaticResource ClusterGlyph}" IconData="{StaticResource Glyph.Origin}" />
            </Button>

            <Border Style="{StaticResource ClusterDivider}" />

            <Button Style="{StaticResource ClusterButton}" Click="OnZoomOutClick"
                    ToolTip="Oddálí pohled na plátno" AutomationProperties.Name="Oddálit">
                <components:IconGlyph Style="{StaticResource ClusterGlyph}" IconData="{StaticResource Glyph.ZoomOut}" />
            </Button>

            <!-- The readout is also the picker, so the fixed presets and "Přizpůsobit oknu" stay one
                 click away without a second control on the strip. -->
            <Button x:Name="ZoomPicker" Style="{StaticResource Button.Ghost}"
                    Height="{StaticResource Size.Control.Compact}" MinHeight="{StaticResource Size.Control.Compact}" Padding="8,0" MinWidth="58"
                    Click="OnZoomPickerClick"
                    ToolTip="Přiblížení plátna. Kliknutím zvolíte přednastavenou hodnotu" AutomationProperties.Name="Měřítko plátna">
                <Button.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="25 %" Tag="25" Click="OnZoomPresetClick" />
                        <MenuItem Header="50 %" Tag="50" Click="OnZoomPresetClick" />
                        <MenuItem Header="75 %" Tag="75" Click="OnZoomPresetClick" />
                        <MenuItem Header="100 %" Tag="100" Click="OnZoomPresetClick" />
                        <MenuItem Header="200 %" Tag="200" Click="OnZoomPresetClick" />
                        <Separator />
                        <MenuItem Header="Přizpůsobit oknu  (F)" Click="OnFitToViewClick" />
                    </ContextMenu>
                </Button.ContextMenu>
                <TextBlock Text="{Binding TargetCanvas.ZoomPercent, ElementName=Root, StringFormat={}{0} %}"
                           FontFamily="{StaticResource Font.Numeric}"
                           Typography.NumeralAlignment="Tabular"
                           FontSize="{StaticResource Size.Text.Meta}" FontWeight="Medium"
                           VerticalAlignment="Center" HorizontalAlignment="Center" />
            </Button>

            <Button Style="{StaticResource ClusterButton}" Click="OnZoomInClick"
                    ToolTip="Přiblíží pohled na plátno" AutomationProperties.Name="Přiblížit">
                <components:IconGlyph Style="{StaticResource ClusterGlyph}" IconData="{StaticResource Glyph.ZoomIn}" />
            </Button>
            <Button Style="{StaticResource ClusterButton}" Click="OnFitToViewClick"
                    ToolTip="Zobrazí celou pracovní plochu v okně (F)" AutomationProperties.Name="Přizpůsobit oknu">
                <components:IconGlyph Style="{StaticResource ClusterGlyph}" IconData="{StaticResource Glyph.Fit}" />
            </Button>
        </StackPanel>
    </Border>
</UserControl>
