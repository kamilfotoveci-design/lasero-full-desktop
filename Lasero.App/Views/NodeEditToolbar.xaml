<UserControl x:Class="Lasero.App.Views.NodeEditToolbar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Lasero.App.Converters"
             xmlns:components="clr-namespace:Lasero.App.Components"
             x:Name="Root">
    <!--
        Node Edit mode's own contextual bar — the compact toolbar the original Designer refinement
        brief asked for, so Corner/Smooth and delete/close-path stop being right-click-only. Floats in
        the same slot SelectionPropertiesBar uses (MainWindow.xaml swaps the two by IsNodeEditActive,
        never both at once): editing individual nodes and editing the whole object's X/Y/W/H are
        different concerns, so showing both together would just be noise.

        TargetCanvas mirrors CanvasViewControls' own precedent: node-edit selection state is
        transient view state SceneCanvas owns directly (IsNodeEditActive/SelectedNodeCount/
        SelectedNodeType/IsSelectedSubpathClosed, all read-only DPs — see the "Bindable view state"
        section in SceneCanvas.VectorPathTool.cs), not scene data, so it has no SceneViewModel
        equivalent to bind against instead.
    -->
    <UserControl.Resources>
        <conv:EnumToBooleanConverter x:Key="EnumToBoolean" />
        <conv:NotNullConverter x:Key="NotNull" />
        <conv:PositiveCountConverter x:Key="PositiveCount" />
        <conv:SingleCountConverter x:Key="SingleCount" />

        <Style x:Key="ToolbarGlyph" TargetType="components:IconGlyph">
            <Setter Property="Width" Value="{StaticResource Size.Icon.Sm}" />
            <Setter Property="Height" Value="{StaticResource Size.Icon.Sm}" />
        </Style>

        <Style x:Key="ToolbarDivider" TargetType="Border">
            <Setter Property="Width" Value="1" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Margin" Value="9,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource Brush.PanelBorder}" />
        </Style>
    </UserControl.Resources>

    <Border Background="{DynamicResource Brush.Panel}"
            BorderBrush="{DynamicResource Brush.PanelBorder}" BorderThickness="1"
            CornerRadius="{StaticResource Radius.Md}" Padding="12,7"
            Effect="{StaticResource Shadow.Sheet}">
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="Úprava uzlů" Style="{StaticResource Text.Muted}"
                       FontSize="{StaticResource Size.Text.Meta}" FontWeight="Medium"
                       VerticalAlignment="Center" Margin="0,0,10,0" />

            <Border Style="{StaticResource SegmentedTrack}"
                    IsEnabled="{Binding TargetCanvas.SelectedNodeCount, ElementName=Root, Converter={StaticResource PositiveCount}}">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Style="{StaticResource Segment.Compact}" GroupName="NodeEditTypeSegments"
                                 Content="Roh" ToolTip="Ostrý roh — obě raménka se nastavují nezávisle"
                                 AutomationProperties.Name="Ostrý roh"
                                 IsChecked="{Binding TargetCanvas.SelectedNodeType, ElementName=Root, Mode=OneWay, Converter={StaticResource EnumToBoolean}, ConverterParameter=Corner}"
                                 Click="OnCornerClick" />
                    <RadioButton Style="{StaticResource Segment.Compact}" GroupName="NodeEditTypeSegments"
                                 Content="Hladký" ToolTip="Hladký uzel — raménka zůstávají v jedné ose"
                                 AutomationProperties.Name="Hladký uzel"
                                 IsChecked="{Binding TargetCanvas.SelectedNodeType, ElementName=Root, Mode=OneWay, Converter={StaticResource EnumToBoolean}, ConverterParameter=Smooth}"
                                 Click="OnSmoothClick" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource ToolbarDivider}" />

            <!-- Button.GhostIcon is a fixed Size.Control.Compact square (icon-only) — wrong shape for
                 a text label, so this uses the auto-sizing Button.Ghost instead, same as every other
                 text-content ghost button in this codebase (e.g. "Odstranit operaci" a few views up
                 the inspector). -->
            <Button Style="{StaticResource Button.Ghost}" Padding="10,0" Height="{StaticResource Size.Control.Compact}"
                    Click="OnToggleClosedClick"
                    IsEnabled="{Binding TargetCanvas.IsSelectedSubpathClosed, ElementName=Root, Converter={StaticResource NotNull}}"
                    ToolTip="Otevřít nebo uzavřít vybranou dráhu" AutomationProperties.Name="Otevřít nebo uzavřít dráhu">
                <!-- No dedicated open/closed-path icon exists in this app's icon set (or in the
                     Phosphor subset already adopted — see Icons.xaml), and inventing one purely for
                     this one button risked looking like a mismatched one-off. A label that swaps with
                     the state, matching how "Vyřadit vrstvu z úlohy"/"Zařadit vrstvu do úlohy" already
                     flips its own MenuItem header elsewhere in this codebase. -->
                <TextBlock VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="Uzavřít dráhu" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding TargetCanvas.IsSelectedSubpathClosed, ElementName=Root}" Value="True">
                                    <Setter Property="Text" Value="Otevřít dráhu" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Button>

            <Border Style="{StaticResource ToolbarDivider}" />

            <!-- LIGHTBURN_VECTOR_PARITY.md §22 — only meaningful for exactly one node (the break
                 location), unlike the delete/convert-type buttons which apply to a whole selection. -->
            <Button Style="{StaticResource Button.Ghost}" Padding="10,0" Height="{StaticResource Size.Control.Compact}"
                    Click="OnBreakAtNodeClick"
                    IsEnabled="{Binding TargetCanvas.SelectedNodeCount, ElementName=Root, Converter={StaticResource SingleCount}}"
                    ToolTip="Rozdělit dráhu v tomto uzlu" AutomationProperties.Name="Rozdělit dráhu v uzlu">
                <TextBlock Text="Rozdělit v uzlu" VerticalAlignment="Center" />
            </Button>

            <Border Style="{StaticResource ToolbarDivider}" />

            <Button Style="{StaticResource Button.GhostIcon}" Click="OnDeleteNodesClick"
                    Foreground="{DynamicResource Brush.Danger}"
                    IsEnabled="{Binding TargetCanvas.SelectedNodeCount, ElementName=Root, Converter={StaticResource PositiveCount}}"
                    ToolTip="Odstranit vybrané uzly (Delete)" AutomationProperties.Name="Odstranit vybrané uzly">
                <components:IconGlyph IconData="{StaticResource Glyph.Fill.Delete}" IsFilled="True" GridSize="256"
                                      Style="{StaticResource ToolbarGlyph}" />
            </Button>
        </StackPanel>
    </Border>
</UserControl>
