<UserControl x:Class="Lasero.App.Views.NodeEditToolbar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System.Windows.Controls;assembly=PresentationFramework"
             xmlns:conv="clr-namespace:Lasero.App.Converters"
             xmlns:components="clr-namespace:Lasero.App.Components"
             x:Name="Root">
    <!--
        Node Edit mode's own contextual bar — a LightBurn-style compact toolbar so every common node/
        segment/path operation is discoverable and usable with the mouse alone; keyboard shortcuts
        (Shift+L/C/M, Delete, Escape) remain accelerators only, never the only way to reach an action —
        see docs/reference/NODE_EDIT_PARITY_AUDIT_2026-09-16.md's UX-pass addendum. Floats in the same
        slot SelectionPropertiesBar uses (MainWindow.xaml swaps the two by IsNodeEditActive, never both
        at once): editing individual nodes and editing the whole object's X/Y/W/H are different
        concerns, so showing both together would just be noise.

        Structure mirrors the LightBurn/Inkscape node-tool convention of "a small ALWAYS-visible core
        (selection utilities, node type, delete) plus CONTEXTUAL groups that only appear once their
        target exists" rather than one static row of mostly-disabled buttons:
          [ Select all | Clear ] · [ Roh | Hladký ] [ Souměrně ] [ Auto ] · [ Delete ]
          + when the selection's subpath is unambiguous: [ Otevřít/Zavřít ] [ Obrátit směr ] [ Rozdělit v uzlu ]
          + when one open end (or two) is selected: [ Spojit ] [ Úsečkou ] [ Prodloužit ]
          + when a segment is clicked (selected) or hovered: [ Na křivku/přímku ] [ Vložit uzel ] [ Oříznout ] [ Odstranit segment ]

        Shortcuts (node edit only, all documented in the tooltips): Ctrl+A all nodes, Shift+S smooth,
        Shift+Y symmetric, Shift+A auto-smooth, Shift+B break, Shift+J join, Shift+E extend, Shift+T
        trim, Shift+L/C line/curve, Shift+M midpoint, Delete / Ctrl+Delete (without curve refit).

        TargetCanvas mirrors CanvasViewControls' own precedent: node-edit selection state is
        transient view state SceneCanvas owns directly (IsNodeEditActive/SelectedNodeCount/
        SelectedNodeType/IsSelectedSubpathClosed/CanToggleSelectedSubpathClosed/IsActiveSegmentStraight/
        IsSelectedNodeOpenEndpoint/IsJoinContext/CanJoinSelectedNodes, all read-only DPs — see the
        "Bindable view state" section in SceneCanvas.VectorPathTool.cs), not scene data, so it has no
        SceneViewModel equivalent to bind against instead.
    -->
    <UserControl.Resources>
        <conv:EnumToBooleanConverter x:Key="EnumToBoolean" />
        <conv:NotNullConverter x:Key="NotNull" />
        <conv:NotNullToVisibilityConverter x:Key="NotNullToVisibility" />
        <conv:PositiveCountConverter x:Key="PositiveCount" />
        <conv:SingleCountConverter x:Key="SingleCount" />
        <sys:BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style x:Key="ToolbarGlyph" TargetType="components:IconGlyph">
            <Setter Property="Width" Value="{StaticResource Size.Icon.Sm}" />
            <Setter Property="Height" Value="{StaticResource Size.Icon.Sm}" />
        </Style>

        <Style x:Key="ToolbarDivider" TargetType="Border">
            <Setter Property="Width" Value="1" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Margin" Value="8,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource Brush.PanelBorder}" />
        </Style>

        <!-- Every rich tooltip below is a two- or three-line StackPanel built from this style, so
             every action stays explainable without the shortcut: title, then a short plain-language
             description, then (only when one exists) the shortcut as a small muted hint — never the
             only place the shortcut is documented, and never required reading to use the button. -->
        <Style x:Key="Tooltip.Title" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Medium" />
        </Style>
        <Style x:Key="Tooltip.Description" TargetType="TextBlock" BasedOn="{StaticResource Text.Muted}">
            <Setter Property="FontSize" Value="{StaticResource Size.Text.Meta}" />
            <Setter Property="MaxWidth" Value="220" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
        <Style x:Key="Tooltip.Shortcut" TargetType="TextBlock" BasedOn="{StaticResource Text.Faint}">
            <Setter Property="FontSize" Value="{StaticResource Size.Text.Meta}" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
    </UserControl.Resources>

    <Border Background="{DynamicResource Brush.Panel}"
            BorderBrush="{DynamicResource Brush.PanelBorder}" BorderThickness="1"
            CornerRadius="{StaticResource Radius.Md}" Padding="12,8"
            Effect="{StaticResource Shadow.Sheet}">
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="Úprava uzlů" Style="{StaticResource Text.Muted}"
                       FontSize="{StaticResource Size.Text.Meta}" FontWeight="Medium"
                       VerticalAlignment="Center" Margin="0,0,12,0" />

            <!-- Always-visible core: selection utilities -->
            <Button Style="{StaticResource Button.Ghost}" Padding="8,0" Height="{StaticResource Size.Control.Compact}"
                    Click="OnSelectAllNodesClick" AutomationProperties.Name="Vybrat všechny uzly">
                <Button.ToolTip>
                    <ToolTip>
                        <StackPanel>
                            <TextBlock Text="Vybrat vše" Style="{StaticResource Tooltip.Title}" />
                            <TextBlock Text="Vybere všechny uzly aktuální dráhy." Style="{StaticResource Tooltip.Description}" />
                            <TextBlock Text="Ctrl+A" Style="{StaticResource Tooltip.Shortcut}" />
                        </StackPanel>
                    </ToolTip>
                </Button.ToolTip>
                <TextBlock Text="Vše" VerticalAlignment="Center" />
            </Button>
            <Button Style="{StaticResource Button.Ghost}" Padding="8,0" Height="{StaticResource Size.Control.Compact}"
                    Click="OnClearNodeSelectionClick"
                    IsEnabled="{Binding TargetCanvas.SelectedNodeCount, ElementName=Root, Converter={StaticResource PositiveCount}}"
                    AutomationProperties.Name="Zrušit výběr uzlů">
                <Button.ToolTip>
                    <ToolTip>
                        <StackPanel>
                            <TextBlock Text="Zrušit výběr" Style="{StaticResource Tooltip.Title}" />
                            <TextBlock Text="Zruší výběr uzlů, aniž by opustil úpravu uzlů." Style="{StaticResource Tooltip.Description}" />
                        </StackPanel>
                    </ToolTip>
                </Button.ToolTip>
                <TextBlock Text="Zrušit" VerticalAlignment="Center" />
            </Button>

            <Border Style="{StaticResource ToolbarDivider}" />

            <!-- Always-visible core: node type (enabled only with a node selection, per the segmented
                 track's own IsEnabled binding below). -->
            <Border Style="{StaticResource SegmentedTrack}"
                    IsEnabled="{Binding TargetCanvas.SelectedNodeCount, ElementName=Root, Converter={StaticResource PositiveCount}}">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Style="{StaticResource Segment.Compact}" GroupName="NodeEditTypeSegments"
                                 Content="Roh"
                                 AutomationProperties.Name="Ostrý roh"
                                 IsChecked="{Binding TargetCanvas.SelectedNodeType, ElementName=Root, Mode=OneWay, Converter={StaticResource EnumToBoolean}, ConverterParameter=Corner}"
                                 Click="OnCornerClick">
                        <RadioButton.ToolTip>
                            <ToolTip>
                                <StackPanel>
                                    <TextBlock Text="Ostrý roh" Style="{StaticResource Tooltip.Title}" />
                                    <TextBlock Text="Obě raménka vybraného uzlu se nastavují nezávisle." Style="{StaticResource Tooltip.Description}" />
                                </StackPanel>
                            </ToolTip>
                        </RadioButton.ToolTip>
                    </RadioButton>
                    <RadioButton Style="{StaticResource Segment.Compact}" GroupName="NodeEditTypeSegments"
                                 Content="Hladký"
                                 AutomationProperties.Name="Hladký uzel"
                                 IsChecked="{Binding TargetCanvas.SelectedNodeType, ElementName=Root, Mode=OneWay, Converter={StaticResource EnumToBoolean}, ConverterParameter=Smooth}"
                                 Click="OnSmoothClick">
                        <RadioButton.ToolTip>
                            <ToolTip>
                                <StackPanel>
                                    <TextBlock Text="Hladký uzel" Style="{StaticResource Tooltip.Title}" />
                                    <TextBlock Text="Raménka vybraného uzlu zůstávají v jedné ose (tečná křivka). Uzel bez ramének je dostane podle sousedů, rovná úsečka u uzlu zůstane rovná." Style="{StaticResource Tooltip.Description}" />
                                    <TextBlock Text="Shift+S" Style="{StaticResource Tooltip.Shortcut}" />
                                </StackPanel>
                            </ToolTip>
                        </RadioButton.ToolTip>
                    </RadioButton>
                </StackPanel>
            </Border>

            <Button Style="{StaticResource Button.Ghost}" Padding="8,0" Height="{StaticResource Size.Control.Compact}" Margin="4,0,0,0"
                    Click="OnSymmetricClick"
                    IsEnabled="{Binding TargetCanvas.SelectedNodeCount, ElementName=Root, Converter={StaticResource PositiveCount}}"
                    AutomationProperties.Name="Souměrný uzel">
                <Button.ToolTip>
                    <ToolTip>
                        <StackPanel>
                            <TextBlock Text="Souměrný uzel" Style="{StaticResource Tooltip.Title}" />
                            <TextBlock Text="Raménka v jedné ose a stejně dlouhá." Style="{StaticResource Tooltip.Description}" />
                            <TextBlock Text="Shift+Y" Style="{StaticResource Tooltip.Shortcut}" />
                        </StackPanel>
                    </ToolTip>
                </Button.ToolTip>
                <TextBlock Text="Souměrně" VerticalAlignment="Center" />
            </Button>
            <Button Style="{StaticResource Button.Ghost}" Padding="8,0" Height="{StaticResource Size.Control.Compact}"
                    Click="OnAutoSmoothClick"
                    IsEnabled="{Binding TargetCanvas.SelectedNodeCount, ElementName=Root, Converter={StaticResource PositiveCount}}"
                    AutomationProperties.Name="Automaticky vyhladit uzel">
                <Button.ToolTip>
                    <ToolTip>
                        <StackPanel>
                            <TextBlock Text="Automaticky vyhladit" Style="{StaticResource Tooltip.Title}" />
                            <TextBlock Text="Raménka se dopočítají podle sousedních uzlů (směr od předchozího k dalšímu, třetina délky úseku)." Style="{StaticResource Tooltip.Description}" />
                            <TextBlock Text="Shift+A" Style="{StaticResource Tooltip.Shortcut}" />
                        </StackPanel>
                    </ToolTip>
                </Button.ToolTip>
                <TextBlock Text="Auto" VerticalAlignment="Center" />
            </Button>

            <Border Style="{StaticResource ToolbarDivider}" />

            <Button Style="{StaticResource Button.GhostIcon}" Click="OnDeleteNodesClick"
                    Foreground="{DynamicResource Brush.Danger}"
                    IsEnabled="{Binding TargetCanvas.SelectedNodeCount, ElementName=Root, Converter={StaticResource PositiveCount}}"
                    AutomationProperties.Name="Odstranit vybrané uzly">
                <Button.ToolTip>
                    <ToolTip>
                        <StackPanel>
                            <TextBlock Text="Odstranit uzly" Style="{StaticResource Tooltip.Title}" />
                            <TextBlock Text="Odstraní vybrané uzly a sousední úseky přizpůsobí původní křivce. Ctrl+Delete je odstraní bez přizpůsobení." Style="{StaticResource Tooltip.Description}" />
                            <TextBlock Text="Delete · Ctrl+Delete" Style="{StaticResource Tooltip.Shortcut}" />
                        </StackPanel>
                    </ToolTip>
                </Button.ToolTip>
                <components:IconGlyph IconData="{StaticResource Glyph.NodeRemove}"
                                      Style="{StaticResource ToolbarGlyph}" />
            </Button>

            <!-- Contextual: single node selected AND its subpath is unambiguous (ResolveContextSubpathIndex
                 — see IsSelectedSubpathClosed's own doc comment). Open/close, reverse and break-at-node all
                 act on "the" subpath in play, so they share one visibility condition. -->
            <Border Style="{StaticResource ToolbarDivider}"
                    Visibility="{Binding TargetCanvas.IsSelectedSubpathClosed, ElementName=Root, Converter={StaticResource NotNullToVisibility}}" />
            <StackPanel Orientation="Horizontal"
                        Visibility="{Binding TargetCanvas.IsSelectedSubpathClosed, ElementName=Root, Converter={StaticResource NotNullToVisibility}}">
                <Button Style="{StaticResource Button.Ghost}" Padding="12,0" Height="{StaticResource Size.Control.Compact}"
                        Click="OnToggleClosedClick"
                        IsEnabled="{Binding TargetCanvas.CanToggleSelectedSubpathClosed, ElementName=Root}"
                        ToolTipService.ShowOnDisabled="True"
                        AutomationProperties.Name="Otevřít nebo uzavřít dráhu">
                    <!-- No dedicated open/closed-path icon exists in this app's icon set, and inventing
                         one purely for this one button risked looking like a mismatched one-off. A
                         label that swaps with the state, matching how "Vyřadit vrstvu z úlohy"/"Zařadit
                         vrstvu do úlohy" already flips its own MenuItem header elsewhere. -->
                    <Button.ToolTip>
                        <ToolTip>
                            <StackPanel>
                                <TextBlock>
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Tooltip.Title}">
                                            <Setter Property="Text" Value="Uzavřít dráhu" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding TargetCanvas.IsSelectedSubpathClosed, ElementName=Root}" Value="True">
                                                    <Setter Property="Text" Value="Otevřít dráhu" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock>
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Tooltip.Description}">
                                            <Setter Property="Text" Value="Spojí první a poslední uzel dráhy." />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding TargetCanvas.CanToggleSelectedSubpathClosed, ElementName=Root}" Value="False">
                                                    <Setter Property="Text" Value="Uzavřít lze jen dráhu nejméně se třemi různými uzly. Dvojitá čára by se vypálila dvakrát." />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding TargetCanvas.IsSelectedSubpathClosed, ElementName=Root}" Value="True">
                                                    <Setter Property="Text" Value="Zruší uzavírací úsek mezi prvním a posledním uzlem." />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </ToolTip>
                    </Button.ToolTip>
                    <TextBlock VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="Uzavřít dráhu" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TargetCanvas.IsSelectedSubpathClosed, ElementName=Root}" Value="True">
                                        <Setter Property="Text" Value="Otevřít dráhu" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Button>

                <Button Style="{StaticResource Button.Ghost}" Padding="12,0" Height="{StaticResource Size.Control.Compact}"
                        Click="OnReversePathClick" AutomationProperties.Name="Obrátit směr dráhy">
                    <Button.ToolTip>
                        <ToolTip>
                            <StackPanel>
                                <TextBlock Text="Obrátit směr" Style="{StaticResource Tooltip.Title}" />
                                <TextBlock Text="Prohodí počáteční a koncový uzel dráhy — tvar zůstává stejný." Style="{StaticResource Tooltip.Description}" />
                            </StackPanel>
                        </ToolTip>
                    </Button.ToolTip>
                    <TextBlock Text="Obrátit směr" VerticalAlignment="Center" />
                </Button>

                <!-- LIGHTBURN_VECTOR_PARITY.md §22 — only meaningful at an internal node, not an
                     endpoint (nothing to break there); OnBreakAtNodeClick/BreakSelectedNode already
                     no-op safely for an endpoint, so this stays visible rather than flickering. -->
                <Button Style="{StaticResource Button.Ghost}" Padding="12,0" Height="{StaticResource Size.Control.Compact}"
                        Click="OnBreakAtNodeClick" AutomationProperties.Name="Rozdělit dráhu v uzlu">
                    <Button.ToolTip>
                        <ToolTip>
                            <StackPanel>
                                <TextBlock Text="Rozdělit v uzlu" Style="{StaticResource Tooltip.Title}" />
                                <TextBlock Text="Rozdělí dráhu na dva konce v tomto uzlu (u uzavřené dráhy ji otevře)." Style="{StaticResource Tooltip.Description}" />
                                <TextBlock Text="Shift+B" Style="{StaticResource Tooltip.Shortcut}" />
                            </StackPanel>
                        </ToolTip>
                    </Button.ToolTip>
                    <TextBlock Text="Rozdělit v uzlu" VerticalAlignment="Center" />
                </Button>
            </StackPanel>

            <!-- Contextual: one open end, or two open ends of this path, selected. Join merges ends
                 that touch and bridges ends apart with a straight segment; Úsečkou always bridges.
                 Visible (not collapsed) even when nothing can be joined right now, so the tooltip
                 can explain why the buttons are disabled instead of the action seeming not to exist. -->
            <Border Style="{StaticResource ToolbarDivider}"
                    Visibility="{Binding TargetCanvas.IsJoinContext, ElementName=Root, Converter={StaticResource BoolToVisibility}}" />
            <StackPanel Orientation="Horizontal"
                        Visibility="{Binding TargetCanvas.IsJoinContext, ElementName=Root, Converter={StaticResource BoolToVisibility}}">
                <Button Style="{StaticResource Button.Ghost}" Padding="12,0" Height="{StaticResource Size.Control.Compact}"
                        Click="OnJoinClick"
                        IsEnabled="{Binding TargetCanvas.CanJoinSelectedNodes, ElementName=Root}"
                        ToolTipService.ShowOnDisabled="True"
                        AutomationProperties.Name="Spojit uzly">
                    <Button.ToolTip>
                        <ToolTip>
                            <StackPanel>
                                <TextBlock Text="Spojit" Style="{StaticResource Tooltip.Title}" />
                                <TextBlock>
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Tooltip.Description}">
                                            <Setter Property="Text" Value="Spojí vybrané konce, nebo tento konec s nejbližším otevřeným koncem jiné dráhy. Konce, které se dotýkají, se sloučí do jednoho uzlu, vzdálené spojí úsečka. Nic se neposune." />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding TargetCanvas.CanJoinSelectedNodes, ElementName=Root}" Value="False">
                                                    <Setter Property="Text" Value="Žádný jiný otevřený konec není poblíž. Lze vybrat dva konce této dráhy, přesunout dráhy blíž k sobě, nebo tento uzel přetáhnout na cílový konec." />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="Shift+J" Style="{StaticResource Tooltip.Shortcut}" />
                            </StackPanel>
                        </ToolTip>
                    </Button.ToolTip>
                    <StackPanel Orientation="Horizontal">
                        <components:IconGlyph IconData="{StaticResource Glyph.PathJoin}"
                                              Style="{StaticResource ToolbarGlyph}" Margin="0,0,4,0" />
                        <TextBlock Text="Spojit" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource Button.Ghost}" Padding="12,0" Height="{StaticResource Size.Control.Compact}"
                        Click="OnJoinWithSegmentClick"
                        IsEnabled="{Binding TargetCanvas.CanJoinSelectedNodes, ElementName=Root}"
                        AutomationProperties.Name="Spojit úsečkou">
                    <Button.ToolTip>
                        <ToolTip>
                            <StackPanel>
                                <TextBlock Text="Spojit úsečkou" Style="{StaticResource Tooltip.Title}" />
                                <TextBlock Text="Oba konce zůstanou na místě a spojí je rovná úsečka." Style="{StaticResource Tooltip.Description}" />
                            </StackPanel>
                        </ToolTip>
                    </Button.ToolTip>
                    <TextBlock Text="Úsečkou" VerticalAlignment="Center" />
                </Button>
                <Button Style="{StaticResource Button.Ghost}" Padding="12,0" Height="{StaticResource Size.Control.Compact}"
                        Click="OnExtendClick"
                        Visibility="{Binding TargetCanvas.IsSelectedNodeOpenEndpoint, ElementName=Root, Converter={StaticResource BoolToVisibility}}"
                        AutomationProperties.Name="Prodloužit k průsečíku">
                    <Button.ToolTip>
                        <ToolTip>
                            <StackPanel>
                                <TextBlock Text="Prodloužit" Style="{StaticResource Tooltip.Title}" />
                                <TextBlock Text="Prodlouží otevřený konec ve směru dráhy až k nejbližší křivce, kterou protne." Style="{StaticResource Tooltip.Description}" />
                                <TextBlock Text="Shift+E" Style="{StaticResource Tooltip.Shortcut}" />
                            </StackPanel>
                        </ToolTip>
                    </Button.ToolTip>
                    <TextBlock Text="Prodloužit" VerticalAlignment="Center" />
                </Button>
            </StackPanel>

            <!-- Contextual: segment-scoped commands (Priority 1 exposure — see
                 NODE_EDIT_PARITY_AUDIT_2026-09-16.md). They target the ACTIVE segment: the one the
                 operator clicked (it stays selected while the pointer travels here), else the one
                 hovered, so they share one visibility condition. -->
            <Border Style="{StaticResource ToolbarDivider}"
                    Visibility="{Binding TargetCanvas.IsActiveSegmentStraight, ElementName=Root, Converter={StaticResource NotNullToVisibility}}" />
            <StackPanel Orientation="Horizontal"
                        Visibility="{Binding TargetCanvas.IsActiveSegmentStraight, ElementName=Root, Converter={StaticResource NotNullToVisibility}}">
                <Button Style="{StaticResource Button.Ghost}" Padding="12,0" Height="{StaticResource Size.Control.Compact}"
                        Click="OnConvertSegmentClick" AutomationProperties.Name="Převést segment na křivku nebo přímku">
                    <Button.ToolTip>
                        <ToolTip>
                            <StackPanel>
                                <TextBlock>
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Tooltip.Title}">
                                            <Setter Property="Text" Value="Na křivku" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding TargetCanvas.IsActiveSegmentStraight, ElementName=Root}" Value="False">
                                                    <Setter Property="Text" Value="Na přímku" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock>
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Tooltip.Description}">
                                            <Setter Property="Text" Value="Převede vybranou úsečku na Bézierovu křivku." />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding TargetCanvas.IsActiveSegmentStraight, ElementName=Root}" Value="False">
                                                    <Setter Property="Text" Value="Odstraní raménka a vybraný segment narovná. Hladký uzel, u kterého se tím zlomí tečna, se stane ostrým rohem." />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock>
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Tooltip.Shortcut}">
                                            <Setter Property="Text" Value="Shift+C" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding TargetCanvas.IsActiveSegmentStraight, ElementName=Root}" Value="False">
                                                    <Setter Property="Text" Value="Shift+L" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </ToolTip>
                    </Button.ToolTip>
                    <TextBlock VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="Na křivku" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TargetCanvas.IsActiveSegmentStraight, ElementName=Root}" Value="False">
                                        <Setter Property="Text" Value="Na přímku" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Button>

                <Button Style="{StaticResource Button.Ghost}" Padding="12,0" Height="{StaticResource Size.Control.Compact}"
                        Click="OnInsertMidpointClick" AutomationProperties.Name="Vložit uzel do poloviny segmentu">
                    <Button.ToolTip>
                        <ToolTip>
                            <StackPanel>
                                <TextBlock Text="Vložit uzel" Style="{StaticResource Tooltip.Title}" />
                                <TextBlock Text="Vloží nový uzel přesně do poloviny vybraného segmentu." Style="{StaticResource Tooltip.Description}" />
                                <TextBlock Text="Shift+M — nebo dvojklik na dráhu kdekoli jinde" Style="{StaticResource Tooltip.Shortcut}" />
                            </StackPanel>
                        </ToolTip>
                    </Button.ToolTip>
                    <TextBlock Text="Vložit uzel" VerticalAlignment="Center" />
                </Button>

                <Button Style="{StaticResource Button.Ghost}" Padding="12,0" Height="{StaticResource Size.Control.Compact}"
                        Click="OnTrimSegmentClick" AutomationProperties.Name="Oříznout segment k průsečíkům">
                    <Button.ToolTip>
                        <ToolTip>
                            <StackPanel>
                                <TextBlock Text="Oříznout" Style="{StaticResource Tooltip.Title}" />
                                <TextBlock Text="Odstraní jen tu část vybraného segmentu, která leží mezi nejbližšími průsečíky s jinými křivkami (nebo jeho uzly). Zbytek křivky se nezmění." Style="{StaticResource Tooltip.Description}" />
                                <TextBlock Text="Shift+T" Style="{StaticResource Tooltip.Shortcut}" />
                            </StackPanel>
                        </ToolTip>
                    </Button.ToolTip>
                    <TextBlock Text="Oříznout" VerticalAlignment="Center" />
                </Button>

                <Button Style="{StaticResource Button.GhostIcon}" Click="OnDeleteSegmentClick"
                        Foreground="{DynamicResource Brush.Danger}"
                        AutomationProperties.Name="Odstranit segment">
                    <Button.ToolTip>
                        <ToolTip>
                            <StackPanel>
                                <TextBlock Text="Odstranit segment" Style="{StaticResource Tooltip.Title}" />
                                <TextBlock Text="Odstraní vybraný segment a otevře nebo rozdělí dráhu." Style="{StaticResource Tooltip.Description}" />
                                <TextBlock Text="Delete (bez výběru uzlu)" Style="{StaticResource Tooltip.Shortcut}" />
                            </StackPanel>
                        </ToolTip>
                    </Button.ToolTip>
                    <components:IconGlyph IconData="{StaticResource Glyph.NodeRemove}"
                                          Style="{StaticResource ToolbarGlyph}" />
                </Button>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
