<UserControl x:Class="Lasero.App.Views.SelectionPropertiesBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             xmlns:conv="clr-namespace:Lasero.App.Converters"
             xmlns:components="clr-namespace:Lasero.App.Components">
    <!--
        The selection's contextual toolbar, floating over the top of the canvas.

        It replaces the old full-width two-line bar. That version carried every command that could
        apply to a selection, which is what made it two lines tall and the editor feel crowded: it
        cost ~78px of permanent chrome to show controls most of which were used rarely.

        What stays visible is what gets touched constantly — position, size, rotation — plus the two
        arrange menus. Everything else moved into the "…" overflow, and all of it is also still on the
        canvas context menu, which has always carried the same commands. Nothing was removed.

        The bar only exists while something is selected, so it costs nothing the rest of the time.
    -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:NotNullToVisibilityConverter x:Key="NotNullToVisibility" />
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
        <conv:DisabledReasonOrFallbackConverter x:Key="DisabledReasonOrFallback" />

        <Style x:Key="BarLabel" TargetType="TextBlock" BasedOn="{StaticResource Text.Muted}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="{StaticResource Size.Text.Meta}" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>

        <!-- Designer visual-refinement pass: transparent at rest rather than the shared
             UnitField.Shell's permanent border — a floating toolbar of five compact fields read as
             busier with all of them boxed than the bordered chrome was worth. UnitField.Shell's own
             inherited hover/focus triggers still reveal the border as an editing affordance. Scoped
             here rather than on the shared style itself, which other screens still use as-is. -->
        <Style x:Key="BarField" TargetType="Border" BasedOn="{StaticResource UnitField.Shell}">
            <Setter Property="Width" Value="100" />
            <Setter Property="Height" Value="{StaticResource Size.Control.Compact}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>

        <!-- BarDivider moved to Theme/SharedUiStyles.xaml (merged app-wide) so MainWindow's bottom
             bar can reuse the same hairline instead of relying only on Margin gaps between zones. -->

        <Style x:Key="BarGlyph" TargetType="components:IconGlyph">
            <Setter Property="Width" Value="{StaticResource Size.Icon.Sm}" />
            <Setter Property="Height" Value="{StaticResource Size.Icon.Sm}" />
        </Style>

        <!-- A menu entry shaped like the ghost icon buttons beside it, so the strip reads as one row
             of controls rather than buttons with a MenuItem wedged between them. -->
        <Style x:Key="BarMenuItem" TargetType="MenuItem">
            <Setter Property="Height" Value="{StaticResource Size.Control.Compact}" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Grid>
                            <Border x:Name="Surface" Background="Transparent"
                                    BorderBrush="Transparent" BorderThickness="1"
                                    CornerRadius="{StaticResource Radius.Sm}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter ContentSource="Header"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False"
                                   IsOpen="{TemplateBinding IsSubmenuOpen}" Placement="Bottom"
                                   PopupAnimation="Fade">
                                <Border Background="{DynamicResource Brush.Panel}"
                                        BorderBrush="{DynamicResource Brush.PanelBorder}" BorderThickness="1"
                                        CornerRadius="{StaticResource Radius.Md}" Padding="4"
                                        Effect="{StaticResource Shadow.Dropdown}">
                                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource Brush.PanelRaised}" />
                                <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
                            </Trigger>
                            <Trigger Property="IsSubmenuOpen" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource Brush.SelectedSurface}" />
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource Brush.SelectedBorder}" />
                                <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
                            </Trigger>
                            <Trigger Property="components:FocusVisual.IsVisible" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource Brush.FocusRing}" />
                                <Setter TargetName="Surface" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="{DynamicResource Brush.Panel}"
            BorderBrush="{DynamicResource Brush.PanelBorder}" BorderThickness="1"
            CornerRadius="{StaticResource Radius.Md}" Padding="12,8"
            Effect="{StaticResource Shadow.Sheet}"
            Visibility="{Binding Scene.HasSelection, Converter={StaticResource BoolToVisibility}}">
        <!-- A safety net, not a normal state: at the window's 1080px minimum with text selected the
             row genuinely cannot fit, and scrolling it beats clipping a field in half. -->
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                      Focusable="False">
            <StackPanel Orientation="Horizontal">

                <!-- ============ Poloha ============ -->
                <StackPanel Orientation="Horizontal"
                            IsEnabled="{Binding Scene.CanEditSelectedPosition}"
                    Visibility="{Binding Scene.HasSelection, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="X" Style="{StaticResource BarLabel}" />
                    <Border Style="{StaticResource BarField}" ToolTip="Poloha středu výběru na ose X">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="mm" Style="{StaticResource UnitField.Suffix}" />
                            <TextBox Style="{StaticResource UnitField.Input}"
                                     automation:AutomationProperties.Name="Poloha na ose X v milimetrech"
                                     Text="{Binding Scene.SelectedX, StringFormat=0.##, UpdateSourceTrigger=LostFocus}" />
                        </DockPanel>
                    </Border>
                    <TextBlock Text="Y" Style="{StaticResource BarLabel}" Margin="12,0,4,0" />
                    <Border Style="{StaticResource BarField}" ToolTip="Poloha středu výběru na ose Y">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="mm" Style="{StaticResource UnitField.Suffix}" />
                            <TextBox Style="{StaticResource UnitField.Input}"
                                     automation:AutomationProperties.Name="Poloha na ose Y v milimetrech"
                                     Text="{Binding Scene.SelectedY, StringFormat=0.##, UpdateSourceTrigger=LostFocus}" />
                        </DockPanel>
                    </Border>
                </StackPanel>

                <Border Style="{StaticResource BarDivider}"
                        Visibility="{Binding Scene.HasSelection, Converter={StaticResource BoolToVisibility}}" />

                <!-- ============ Rozměr ============ -->
                <!-- The aspect lock sits between width and height because it ties the two together;
                     its position says so without needing a caption. -->
                <StackPanel Orientation="Horizontal"
                            IsEnabled="{Binding Scene.CanTransformSelectedObject}"
                    Visibility="{Binding Scene.HasSelection, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="Š" Style="{StaticResource BarLabel}" ToolTip="Šířka" />
                    <Border Style="{StaticResource BarField}" ToolTip="Výsledná šířka výběru">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="mm" Style="{StaticResource UnitField.Suffix}" />
                            <TextBox Style="{StaticResource UnitField.Input}"
                                     automation:AutomationProperties.Name="Šířka v milimetrech"
                                     Text="{Binding Scene.SelectedWidth, StringFormat=0.##, UpdateSourceTrigger=LostFocus}" />
                        </DockPanel>
                    </Border>
                    <ToggleButton Style="{StaticResource Toggle.Icon}" Margin="8,0"
                                  IsChecked="{Binding Scene.LockAspectRatio}"
                                  ToolTip="Zachovat poměr stran při změně šířky nebo výšky"
                                  AutomationProperties.Name="Zachovat poměr stran">
                        <!-- Designer visual-refinement pass: one chain glyph, not a padlock that
                             swaps open/closed — Toggle.Icon's own checked-state surface (accent tint,
                             border, foreground) already carries the on/off state, per this control's
                             existing IsChecked binding, ToolTip and AutomationProperties.Name, all of
                             which are unchanged. -->
                        <components:IconGlyph Style="{StaticResource BarGlyph}"
                                              IconData="{StaticResource Glyph.Link}" />
                    </ToggleButton>
                    <TextBlock Text="V" Style="{StaticResource BarLabel}" ToolTip="Výška" />
                    <Border Style="{StaticResource BarField}" ToolTip="Výsledná výška výběru">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="mm" Style="{StaticResource UnitField.Suffix}" />
                            <TextBox Style="{StaticResource UnitField.Input}"
                                     automation:AutomationProperties.Name="Výška v milimetrech"
                                     Text="{Binding Scene.SelectedHeight, StringFormat=0.##, UpdateSourceTrigger=LostFocus}" />
                        </DockPanel>
                    </Border>
                </StackPanel>

                <Border Style="{StaticResource BarDivider}"
                        Visibility="{Binding Scene.Selected, Converter={StaticResource NotNullToVisibility}}" />

                <!-- ============ Otočení ============ -->
                <!-- Editable, unlike the mockup's read-only degree button: a laser job is placed to a
                     number, and typing 45 is the whole point of having the field. -->
                <StackPanel Orientation="Horizontal"
                            IsEnabled="{Binding Scene.CanRotateSelectedObject}"
                            Visibility="{Binding Scene.Selected, Converter={StaticResource NotNullToVisibility}}">
                    <components:IconGlyph Style="{StaticResource BarGlyph}" IconData="{StaticResource Glyph.RotateRight}"
                                          Foreground="{DynamicResource Brush.TextSecondary}"
                                          VerticalAlignment="Center" Margin="0,0,8,0" ToolTip="Otočení" />
                    <Border Style="{StaticResource BarField}" Width="74" ToolTip="Otočení objektu ve stupních">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="°" Style="{StaticResource UnitField.Suffix}" />
                            <TextBox Style="{StaticResource UnitField.Input}"
                                     automation:AutomationProperties.Name="Otočení ve stupních"
                                     Text="{Binding Scene.SelectedRotation, StringFormat=0.#, UpdateSourceTrigger=LostFocus}" />
                        </DockPanel>
                    </Border>
                </StackPanel>

                <!-- ============ Node Edit entry ============ -->
                <!-- The primary, discoverable way to start editing a path's nodes — a single click,
                     always visible whenever the selection is one node-editable object. Double-
                     clicking the shape's own stroke on the canvas still works too (existing gesture,
                     kept as a shortcut for users who already know it), but is no longer the only
                     entry point: aiming a double-click at a thin curved stroke is not something a new
                     user should have to discover or a returning one should have to re-aim every time. -->
                <Border Style="{StaticResource BarDivider}"
                        Visibility="{Binding Scene.Selected.IsVectorPath, Converter={StaticResource BoolToVisibility}}" />
                <Button Style="{StaticResource Button.Ghost}" Padding="12,0" Height="{StaticResource Size.Control.Compact}"
                        Click="OnEnterNodeEditClick"
                        Visibility="{Binding Scene.Selected.IsVectorPath, Converter={StaticResource BoolToVisibility}}"
                        ToolTip="Upraví jednotlivé uzly a raménka této dráhy."
                        AutomationProperties.Name="Upravit uzly">
                    <StackPanel Orientation="Horizontal">
                        <components:IconGlyph Style="{StaticResource BarGlyph}" IconData="{StaticResource Glyph.Vector}"
                                              Foreground="{DynamicResource Brush.TextSecondary}"
                                              VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="Upravit uzly" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- ============ Text ============ -->
                <Border Style="{StaticResource BarDivider}"
                        Visibility="{Binding Scene.IsTextSelected, Converter={StaticResource BoolToVisibility}}" />

                <StackPanel Orientation="Horizontal"
                            IsEnabled="{Binding Scene.CanEditSelectedText}"
                            Visibility="{Binding Scene.IsTextSelected, Converter={StaticResource BoolToVisibility}}">
                    <TextBox Width="118" Height="{StaticResource Size.Control.Compact}" MaxLength="200"
                             VerticalContentAlignment="Center" Padding="12,0" Margin="0,0,8,0"
                             automation:AutomationProperties.Name="Znění textu" ToolTip="Znění textu"
                             Text="{Binding Scene.SelectedTextValue, UpdateSourceTrigger=LostFocus}" />
                    <!-- Each family renders in itself, so the list is browsable by eye. -->
                    <ComboBox Width="112" Height="{StaticResource Size.Control.Compact}" Margin="0,0,8,0"
                              ItemsSource="{Binding Scene.FontFamilies}"
                              SelectedItem="{Binding Scene.SelectedTextFontFamily}"
                              MaxDropDownHeight="320"
                              automation:AutomationProperties.Name="Písmo"
                              ToolTip="Písmo, kterým je text vysázený">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontFamily="{Binding}" FontSize="{StaticResource Size.Text.Section}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Border Style="{StaticResource BarField}" Width="78" Margin="0,0,8,0"
                            ToolTip="Výška písma v milimetrech, před vlastním zvětšením objektu">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="mm" Style="{StaticResource UnitField.Suffix}" />
                            <TextBox Style="{StaticResource UnitField.Input}"
                                     automation:AutomationProperties.Name="Výška písma v milimetrech"
                                     Text="{Binding Scene.SelectedTextHeight, StringFormat=0.##, UpdateSourceTrigger=LostFocus}" />
                        </DockPanel>
                    </Border>
                    <ToggleButton Style="{StaticResource Toggle.Icon}"
                                  IsChecked="{Binding Scene.SelectedTextBold}"
                                  ToolTip="Tučné" AutomationProperties.Name="Tučné písmo">
                        <TextBlock Text="B" FontWeight="SemiBold" FontSize="{StaticResource Size.Text.Section}" />
                    </ToggleButton>
                    <ToggleButton Style="{StaticResource Toggle.Icon}" Margin="4,0,0,0"
                                  IsChecked="{Binding Scene.SelectedTextItalic}"
                                  ToolTip="Kurzíva" AutomationProperties.Name="Kurzíva">
                        <TextBlock Text="I" FontStyle="Italic" FontSize="{StaticResource Size.Text.Section}" FontFamily="Georgia, Times New Roman" />
                    </ToggleButton>
                </StackPanel>

                <!-- ============ Uspořádání ============ -->
                <!-- Collapsed while text is selected: the Text cluster above already pushes this row
                     past the width a text selection has to fit in, and both Align and Flip/Rotate are
                     duplicated into the overflow menu below, so nothing here becomes unreachable. -->
                <Border Style="{StaticResource BarDivider}"
                        Visibility="{Binding Scene.IsTextSelected, Converter={StaticResource InverseBoolToVisibility}}" />

                <Menu Background="Transparent" VerticalAlignment="Center" Padding="0"
                      Visibility="{Binding Scene.IsTextSelected, Converter={StaticResource InverseBoolToVisibility}}">
                    <MenuItem Style="{StaticResource BarMenuItem}"
                              IsEnabled="{Binding Scene.HasMultipleSelection}"
                              ToolTipService.ShowOnDisabled="True"
                              ToolTip="{Binding Scene.AlignDisabledReason, Converter={StaticResource DisabledReasonOrFallback}, ConverterParameter='Zarovná vybrané objekty k sobě'}"
                              AutomationProperties.Name="Zarovnat">
                        <MenuItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <components:IconGlyph Style="{StaticResource BarGlyph}" IconData="{StaticResource Glyph.AlignCenterHorizontal}" />
                                <components:IconGlyph Width="{StaticResource Size.Icon.Chrome}" Height="{StaticResource Size.Icon.Chrome}" Margin="4,0,0,0"
                                                      IconData="{StaticResource Glyph.ChevronDown}" />
                            </StackPanel>
                        </MenuItem.Header>
                        <MenuItem Header="Vlevo" Command="{Binding Scene.AlignLeftCommand}">
                            <MenuItem.Icon><components:IconGlyph IconData="{StaticResource Glyph.AlignLeft}" Width="{StaticResource Size.Icon.Sm}" Height="{StaticResource Size.Icon.Sm}" /></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Na střed vodorovně" Command="{Binding Scene.AlignCenterHorizontalCommand}">
                            <MenuItem.Icon><components:IconGlyph IconData="{StaticResource Glyph.AlignCenterHorizontal}" Width="{StaticResource Size.Icon.Sm}" Height="{StaticResource Size.Icon.Sm}" /></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Vpravo" Command="{Binding Scene.AlignRightCommand}">
                            <MenuItem.Icon><components:IconGlyph IconData="{StaticResource Glyph.AlignRight}" Width="{StaticResource Size.Icon.Sm}" Height="{StaticResource Size.Icon.Sm}" /></MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="Nahoru" Command="{Binding Scene.AlignTopCommand}">
                            <MenuItem.Icon><components:IconGlyph IconData="{StaticResource Glyph.AlignTop}" Width="{StaticResource Size.Icon.Sm}" Height="{StaticResource Size.Icon.Sm}" /></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Na střed svisle" Command="{Binding Scene.AlignMiddleCommand}">
                            <MenuItem.Icon><components:IconGlyph IconData="{StaticResource Glyph.AlignMiddle}" Width="{StaticResource Size.Icon.Sm}" Height="{StaticResource Size.Icon.Sm}" /></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Dolů" Command="{Binding Scene.AlignBottomCommand}">
                            <MenuItem.Icon><components:IconGlyph IconData="{StaticResource Glyph.AlignBottom}" Width="{StaticResource Size.Icon.Sm}" Height="{StaticResource Size.Icon.Sm}" /></MenuItem.Icon>
                        </MenuItem>
                    </MenuItem>
                </Menu>

                <Menu Background="Transparent" VerticalAlignment="Center" Padding="0" Margin="4,0,0,0"
                      Visibility="{Binding Scene.IsTextSelected, Converter={StaticResource InverseBoolToVisibility}}">
                    <MenuItem Style="{StaticResource BarMenuItem}"
                              ToolTip="Zrcadlit nebo otočit vybrané objekty"
                              AutomationProperties.Name="Zrcadlit nebo otočit">
                        <MenuItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <components:IconGlyph Style="{StaticResource BarGlyph}" IconData="{StaticResource Glyph.FlipHorizontal}" />
                                <components:IconGlyph Width="{StaticResource Size.Icon.Chrome}" Height="{StaticResource Size.Icon.Chrome}" Margin="4,0,0,0"
                                                      IconData="{StaticResource Glyph.ChevronDown}" />
                            </StackPanel>
                        </MenuItem.Header>
                        <MenuItem Header="Zrcadlit vodorovně" Command="{Binding Scene.FlipHorizontalCommand}">
                            <MenuItem.Icon><components:IconGlyph IconData="{StaticResource Glyph.FlipHorizontal}" Width="{StaticResource Size.Icon.Sm}" Height="{StaticResource Size.Icon.Sm}" /></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Zrcadlit svisle" Command="{Binding Scene.FlipVerticalCommand}">
                            <MenuItem.Icon><components:IconGlyph IconData="{StaticResource Glyph.FlipVertical}" Width="{StaticResource Size.Icon.Sm}" Height="{StaticResource Size.Icon.Sm}" /></MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="Otočit o 90° vlevo" Command="{Binding Scene.RotateLeftCommand}">
                            <MenuItem.Icon><components:IconGlyph IconData="{StaticResource Glyph.RotateLeft}" Width="{StaticResource Size.Icon.Sm}" Height="{StaticResource Size.Icon.Sm}" /></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Otočit o 90° vpravo" Command="{Binding Scene.RotateRightCommand}">
                            <MenuItem.Icon><components:IconGlyph IconData="{StaticResource Glyph.RotateRight}" Width="{StaticResource Size.Icon.Sm}" Height="{StaticResource Size.Icon.Sm}" /></MenuItem.Icon>
                        </MenuItem>
                    </MenuItem>
                </Menu>

                <!-- ============ Přetečení ============ -->
                <!-- Everything that used to sit on the old bar as its own visible control. All of it
                     is also on the canvas context menu; this is the pointer-reachable copy for people
                     who are already up here editing values. -->
                <Menu Background="Transparent" VerticalAlignment="Center" Padding="0" Margin="4,0,0,0">
                    <MenuItem Style="{StaticResource BarMenuItem}"
                              ToolTip="Další úpravy výběru"
                              AutomationProperties.Name="Další úpravy výběru">
                        <MenuItem.Header>
                            <components:IconGlyph Style="{StaticResource BarGlyph}" IconData="{StaticResource Glyph.More}" />
                        </MenuItem.Header>

                        <MenuItem Header="Seskupit výběr" InputGestureText="Ctrl+G"
                                  Command="{Binding Scene.GroupSelectionCommand}"
                                  Visibility="{Binding Scene.CanGroupSelection, Converter={StaticResource BoolToVisibility}}" />
                        <!-- Always visible while the bar itself is (it only shows with a selection at
                             all) — shown disabled with a specific reason via ToolTip when unavailable,
                             instead of disappearing outright. Fixes the "Sjednotit nefunguh" bug class:
                             see SceneViewModel.UniteSelectionDisabledReason / HANDOFF.md 2026-09-14. -->
                        <MenuItem Header="Sjednotit tvary" InputGestureText="Ctrl+Shift+U"
                                  Command="{Binding Scene.UniteSelectionCommand}"
                                  ToolTip="{Binding Scene.UniteSelectionDisabledReason}" />
                        <MenuItem Header="Odečíst tvary"
                                  Command="{Binding Scene.SubtractSelectionCommand}"
                                  ToolTip="{Binding Scene.UniteSelectionDisabledReason, Converter={StaticResource DisabledReasonOrFallback}, ConverterParameter='Tvary vpředu odečtou plochu od tvaru vzadu'}" />
                        <MenuItem Header="Průnik tvarů"
                                  Command="{Binding Scene.IntersectSelectionCommand}"
                                  ToolTip="{Binding Scene.UniteSelectionDisabledReason, Converter={StaticResource DisabledReasonOrFallback}, ConverterParameter='Zůstane jen plocha, kde se všechny tvary překrývají'}" />
                        <MenuItem Header="Vyloučit tvary"
                                  Command="{Binding Scene.ExcludeSelectionCommand}"
                                  ToolTip="{Binding Scene.UniteSelectionDisabledReason, Converter={StaticResource DisabledReasonOrFallback}, ConverterParameter='Zůstane plocha pokrytá právě jedním tvarem'}" />
                        <MenuItem Header="Offset křivky…" InputGestureText="Ctrl+Shift+O"
                                  Command="{Binding Scene.OffsetSelectionCommand}"
                                  ToolTip="{Binding Scene.OffsetSelectionDisabledReason, Converter={StaticResource DisabledReasonOrFallback}, ConverterParameter='Zvětší nebo zmenší vybrané tvary o zadanou vzdálenost'}" />
                        <MenuItem Header="Rozdělit skupinu" InputGestureText="Ctrl+Shift+G"
                                  Command="{Binding Scene.UngroupSelectionCommand}"
                                  Visibility="{Binding Scene.CanUngroupSelection, Converter={StaticResource BoolToVisibility}}" />
                        <MenuItem Header="Trasovat bitmapu" InputGestureText="Alt+T"
                                  Command="{Binding Scene.TraceSelectedRasterCommand}"
                                  Visibility="{Binding Scene.CanTraceSelectedRaster, Converter={StaticResource BoolToVisibility}}" />
                        <MenuItem Header="Odstranit pozadí"
                                  Command="{Binding Scene.RemoveSelectedBackgroundCommand}"
                                  Visibility="{Binding Scene.CanRemoveSelectedBackground, Converter={StaticResource BoolToVisibility}}" />
                        <MenuItem Header="Obnovit pozadí"
                                  Command="{Binding Scene.RestoreSelectedBackgroundCommand}"
                                  Visibility="{Binding Scene.CanRestoreSelectedBackground, Converter={StaticResource BoolToVisibility}}" />

                        <!-- Align/Flip/Rotate normally have their own visible menus in the row above;
                             those two collapse while text is selected (see the Uspořádání comment),
                             so their only reachable copy at that point is here. -->
                        <MenuItem Header="Zarovnat vlevo" Command="{Binding Scene.AlignLeftCommand}"
                                  IsEnabled="{Binding Scene.HasMultipleSelection}"
                                  Visibility="{Binding Scene.IsTextSelected, Converter={StaticResource BoolToVisibility}}">
                            <MenuItem.Icon><components:IconGlyph IconData="{StaticResource Glyph.AlignLeft}" Width="{StaticResource Size.Icon.Sm}" Height="{StaticResource Size.Icon.Sm}" /></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Zarovnat na střed vodorovně" Command="{Binding Scene.AlignCenterHorizontalCommand}"
                                  IsEnabled="{Binding Scene.HasMultipleSelection}"
                                  Visibility="{Binding Scene.IsTextSelected, Converter={StaticResource BoolToVisibility}}">
                            <MenuItem.Icon><components:IconGlyph IconData="{StaticResource Glyph.AlignCenterHorizontal}" Width="{StaticResource Size.Icon.Sm}" Height="{StaticResource Size.Icon.Sm}" /></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Zarovnat vpravo" Command="{Binding Scene.AlignRightCommand}"
                                  IsEnabled="{Binding Scene.HasMultipleSelection}"
                                  Visibility="{Binding Scene.IsTextSelected, Converter={StaticResource BoolToVisibility}}">
                            <MenuItem.Icon><components:IconGlyph IconData="{StaticResource Glyph.AlignRight}" Width="{StaticResource Size.Icon.Sm}" Height="{StaticResource Size.Icon.Sm}" /></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Zarovnat nahoru" Command="{Binding Scene.AlignTopCommand}"
                                  IsEnabled="{Binding Scene.HasMultipleSelection}"
                                  Visibility="{Binding Scene.IsTextSelected, Converter={StaticResource BoolToVisibility}}">
                            <MenuItem.Icon><components:IconGlyph IconData="{StaticResource Glyph.AlignTop}" Width="{StaticResource Size.Icon.Sm}" Height="{StaticResource Size.Icon.Sm}" /></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Zarovnat na střed svisle" Command="{Binding Scene.AlignMiddleCommand}"
                                  IsEnabled="{Binding Scene.HasMultipleSelection}"
                                  Visibility="{Binding Scene.IsTextSelected, Converter={StaticResource BoolToVisibility}}">
                            <MenuItem.Icon><components:IconGlyph IconData="{StaticResource Glyph.AlignMiddle}" Width="{StaticResource Size.Icon.Sm}" Height="{StaticResource Size.Icon.Sm}" /></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Zarovnat dolů" Command="{Binding Scene.AlignBottomCommand}"
                                  IsEnabled="{Binding Scene.HasMultipleSelection}"
                                  Visibility="{Binding Scene.IsTextSelected, Converter={StaticResource BoolToVisibility}}">
                            <MenuItem.Icon><components:IconGlyph IconData="{StaticResource Glyph.AlignBottom}" Width="{StaticResource Size.Icon.Sm}" Height="{StaticResource Size.Icon.Sm}" /></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Zrcadlit vodorovně" Command="{Binding Scene.FlipHorizontalCommand}"
                                  Visibility="{Binding Scene.IsTextSelected, Converter={StaticResource BoolToVisibility}}">
                            <MenuItem.Icon><components:IconGlyph IconData="{StaticResource Glyph.FlipHorizontal}" Width="{StaticResource Size.Icon.Sm}" Height="{StaticResource Size.Icon.Sm}" /></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Zrcadlit svisle" Command="{Binding Scene.FlipVerticalCommand}"
                                  Visibility="{Binding Scene.IsTextSelected, Converter={StaticResource BoolToVisibility}}">
                            <MenuItem.Icon><components:IconGlyph IconData="{StaticResource Glyph.FlipVertical}" Width="{StaticResource Size.Icon.Sm}" Height="{StaticResource Size.Icon.Sm}" /></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Otočit o 90° vlevo" Command="{Binding Scene.RotateLeftCommand}"
                                  Visibility="{Binding Scene.IsTextSelected, Converter={StaticResource BoolToVisibility}}">
                            <MenuItem.Icon><components:IconGlyph IconData="{StaticResource Glyph.RotateLeft}" Width="{StaticResource Size.Icon.Sm}" Height="{StaticResource Size.Icon.Sm}" /></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Otočit o 90° vpravo" Command="{Binding Scene.RotateRightCommand}"
                                  Visibility="{Binding Scene.IsTextSelected, Converter={StaticResource BoolToVisibility}}">
                            <MenuItem.Icon><components:IconGlyph IconData="{StaticResource Glyph.RotateRight}" Width="{StaticResource Size.Icon.Sm}" Height="{StaticResource Size.Icon.Sm}" /></MenuItem.Icon>
                        </MenuItem>
                        <Separator Visibility="{Binding Scene.IsTextSelected, Converter={StaticResource BoolToVisibility}}" />

                        <MenuItem Header="Duplikovat" InputGestureText="Ctrl+D" Command="{Binding Scene.DuplicateCommand}" />
                        <MenuItem Command="{Binding Scene.ToggleLockCommand}">
                            <MenuItem.Style>
                                <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                    <Setter Property="Header" Value="Zamknout výběr" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Scene.IsSelectedLocked}" Value="True">
                                            <Setter Property="Header" Value="Odemknout výběr" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </MenuItem.Style>
                        </MenuItem>
                        <MenuItem Header="Odstranit" InputGestureText="Delete" Command="{Binding Scene.DeleteCommand}" />

                        <Separator />
                        <MenuItem Header="Přenést dopředu" Command="{Binding Scene.BringToFrontCommand}">
                            <MenuItem.Icon><components:IconGlyph IconData="{StaticResource Glyph.BringFront}" Width="{StaticResource Size.Icon.Sm}" Height="{StaticResource Size.Icon.Sm}" /></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Přenést dozadu" Command="{Binding Scene.SendToBackCommand}">
                            <MenuItem.Icon><components:IconGlyph IconData="{StaticResource Glyph.SendBack}" Width="{StaticResource Size.Icon.Sm}" Height="{StaticResource Size.Icon.Sm}" /></MenuItem.Icon>
                        </MenuItem>

                        <Separator />
                        <MenuItem Header="Velká písmena" IsCheckable="True"
                                  IsChecked="{Binding Scene.SelectedTextUppercase}"
                                  Visibility="{Binding Scene.IsTextSelected, Converter={StaticResource BoolToVisibility}}" />
                        <MenuItem Header="Svařeno" IsCheckable="True"
                                  IsChecked="{Binding Scene.SelectedTextWeld}"
                                  Visibility="{Binding Scene.IsTextSelected, Converter={StaticResource BoolToVisibility}}" />
                        <MenuItem Header="Zrušit zkreslení textu" Command="{Binding Scene.ResetSelectedTextDistortionCommand}"
                                  Visibility="{Binding Scene.IsSelectedTextDistorted, Converter={StaticResource BoolToVisibility}}" />

                        <Separator />
                        <MenuItem Header="Zobrazit na plátně" IsCheckable="True" IsChecked="{Binding Scene.Selected.IsVisible}" />
                        <MenuItem Header="Zahrnout do úlohy" IsCheckable="True" IsChecked="{Binding Scene.Selected.IncludeInOutput}" />
                    </MenuItem>
                </Menu>
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
