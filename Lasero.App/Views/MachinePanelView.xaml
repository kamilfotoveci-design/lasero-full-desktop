<UserControl x:Class="Lasero.App.Views.MachinePanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Lasero.App.Converters"
             xmlns:components="clr-namespace:Lasero.App.Components"
             Loaded="OnLoaded"
             Unloaded="OnUnloaded">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
        <conv:NotNullToVisibilityConverter x:Key="NotNullToVisibility" />
        <conv:BooleanToConnectionBrushConverter x:Key="ConnectedToBrush" />
        <conv:MachineModeToLabelConverter x:Key="ModeToLabel" />
        <conv:MachineModeToBrushConverter x:Key="ModeToBrush" />
        <conv:MachineAlertKindToBrushConverter x:Key="AlertKindToBrush" />
        <conv:EnumToBooleanConverter x:Key="EnumToBool" />
        <conv:JobRunStateToLabelConverter x:Key="JobStateToLabel" />

        <Style x:Key="MachineFieldLabel" TargetType="TextBlock" BasedOn="{StaticResource Text.Muted}">
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="FontSize" Value="{StaticResource Size.Text.Meta}" />
        </Style>
        <Style x:Key="TelemetryValue" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Font.Numeric}" />
            <Setter Property="FontSize" Value="{StaticResource Size.Text.Body}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
        <Style x:Key="JogPadButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="46" />
            <Setter Property="MinHeight" Value="46" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="Padding" Value="10" />
        </Style>
        <Style x:Key="JogHomeButton" TargetType="Button" BasedOn="{StaticResource JogPadButton}">
            <Setter Property="Background" Value="{StaticResource Brush.SelectedSurface}" />
            <Setter Property="BorderBrush" Value="{StaticResource Brush.SelectedBorder}" />
            <Setter Property="Foreground" Value="{StaticResource Brush.AccentText}" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource Brush.Field}"
                BorderBrush="{Binding MachineStatus.ActiveAlert.Kind, Converter={StaticResource AlertKindToBrush}}"
                BorderThickness="1" CornerRadius="{StaticResource Radius.Lg}" Padding="10" Margin="0,0,0,8"
                Visibility="{Binding MachineStatus.HasActiveAlert, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <TextBlock Text="{Binding MachineStatus.ActiveAlert.Message}" TextWrapping="Wrap"
                           Foreground="{Binding MachineStatus.ActiveAlert.Kind, Converter={StaticResource AlertKindToBrush}}"
                           Margin="0,0,28,0" />
                <Button HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource Button.Icon}"
                        Width="24" Height="24" Padding="5" Command="{Binding MachineStatus.DismissAlertCommand}"
                        ToolTip="Zavřít upozornění">
                    <components:IconGlyph IconData="{StaticResource Glyph.Close}" Width="{StaticResource Size.Icon.Chrome}" Height="{StaticResource Size.Icon.Chrome}" />
                </Button>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="{StaticResource Brush.Field}"
                BorderBrush="{StaticResource Brush.PanelBorder}" BorderThickness="1"
                CornerRadius="{StaticResource Radius.Lg}" Padding="10" Margin="0,0,0,8">
            <StackPanel>
                <Grid Margin="0,0,0,7">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="7" Height="7" Fill="{Binding Connection.IsConnected, Converter={StaticResource ConnectedToBrush}}" Margin="0,0,7,0" />
                        <TextBlock Text="{Binding Connection.StatusText}" FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                    Visibility="{Binding Connection.IsConnected, Converter={StaticResource BoolToVisibility}}">
                            <Ellipse Width="7" Height="7" Fill="{Binding MachineStatus.Mode, Converter={StaticResource ModeToBrush}}" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding MachineStatus.Mode, Converter={StaticResource ModeToLabel}}" Style="{StaticResource Text.Muted}" />
                        </StackPanel>
                        <Button Style="{StaticResource Button.Secondary}" Height="36" MinHeight="36" Padding="12,0" Command="{Binding Connection.SmartConnectCommand}"
                                Visibility="{Binding Connection.IsConnected, Converter={StaticResource InverseBoolToVisibility}}"
                                ToolTip="Automaticky vyhledat a připojit laser">
                            <components:IconLabel IconData="{StaticResource Glyph.Connect}" Text="Připojit automaticky" IconSize="{StaticResource Size.Icon.Sm}" TextMargin="5,0,0,0" />
                        </Button>
                    </StackPanel>
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="X mm" Style="{StaticResource Text.Muted}" /><TextBlock Text="{Binding MachineStatus.WorkXDisplay}" Style="{StaticResource TelemetryValue}" /></StackPanel>
                    <StackPanel Grid.Column="1"><TextBlock Text="Y mm" Style="{StaticResource Text.Muted}" /><TextBlock Text="{Binding MachineStatus.WorkYDisplay}" Style="{StaticResource TelemetryValue}" /></StackPanel>
                    <StackPanel Grid.Column="2"><TextBlock Text="Z mm" Style="{StaticResource Text.Muted}" /><TextBlock Text="{Binding MachineStatus.WorkZDisplay}" Style="{StaticResource TelemetryValue}" /></StackPanel>
                    <StackPanel Grid.Column="3"><TextBlock Text="F" Style="{StaticResource Text.Muted}" /><TextBlock Text="{Binding MachineStatus.FeedRateDisplay}" Style="{StaticResource TelemetryValue}" /></StackPanel>
                    <StackPanel Grid.Column="4"><TextBlock Text="S" Style="{StaticResource Text.Muted}" /><TextBlock Text="{Binding MachineStatus.SpindleSpeedDisplay}" Style="{StaticResource TelemetryValue}" /></StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Text-only. Four icon+label pairs in a 336px panel left roughly 50px per segment, so every
             tab label was clipped mid-word; the icons were not carrying meaning a one-word tab needs
             anyway. Tooltips still spell out what each tab holds. -->
        <Border Grid.Row="2" Style="{StaticResource SegmentedTrack}" Padding="3" Margin="0,0,0,2">
            <UniformGrid Columns="3">
                <RadioButton x:Name="ConnectionPanelTab" IsChecked="True" Content="Připojení" Style="{StaticResource Segment.Compact}" GroupName="MachinePanelTab" ToolTip="Připojení a pracovní plocha" />
                <RadioButton x:Name="JogPanelTab" Content="Pohyb" Style="{StaticResource Segment.Compact}" GroupName="MachinePanelTab" ToolTip="Ruční posun os" />
                <RadioButton x:Name="ConsolePanelTab" Content="Konzola" Style="{StaticResource Segment.Compact}" GroupName="MachinePanelTab" ToolTip="Pokročilá konzola GRBL" />
            </UniformGrid>
        </Border>

        <Grid Grid.Row="3">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Visibility="{Binding IsChecked, ElementName=ConnectionPanelTab, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Margin="0,10,0,8">
                    <TextBlock Text="Zařízení" Style="{StaticResource PanelTitle}" Margin="0,0,0,9" />
                    <StackPanel Visibility="{Binding Connection.IsConnected, Converter={StaticResource InverseBoolToVisibility}}">
                        <!-- Port and baud rate stack instead of sharing a row. Side by side in a 336px
                             inspector the port name had about 150px, which truncates every real device
                             string ("SIMULÁTOR — Virtuální laser", "USB-SERIAL CH340 (COM3)"). The port
                             is the field the operator actually reads, so it gets the full width; the
                             refresh button sits beside it rather than floating on top of it. -->
                        <TextBlock Text="Ruční připojení přes COM" Style="{StaticResource MachineFieldLabel}" />
                        <TextBlock Text="Pokud automatické hledání laser nenajde, vyberte jeho COM port." Style="{StaticResource Text.Muted}"
                                   TextWrapping="Wrap" Margin="0,0,0,10" />
                        <TextBlock Text="Sériový port" Style="{StaticResource MachineFieldLabel}" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource Button.Icon}" Margin="8,0,0,0"
                                    Command="{Binding Connection.RefreshPortsCommand}" ToolTip="Znovu vyhledat porty"
                                    AutomationProperties.Name="Znovu vyhledat porty">
                                <components:IconGlyph IconData="{StaticResource Glyph.Refresh}" Width="{StaticResource Size.Icon.Sm}" Height="{StaticResource Size.Icon.Sm}" />
                            </Button>
                            <ComboBox ItemsSource="{Binding Connection.AvailablePorts}" SelectedItem="{Binding Connection.SelectedPort}"
                                      ToolTip="{Binding Connection.SelectedPort}" />
                        </DockPanel>
                        <Border Background="{StaticResource Brush.InfoMuted}" BorderBrush="{StaticResource Brush.InfoBorder}" BorderThickness="1" CornerRadius="{StaticResource Radius.Lg}"
                                Padding="9" Margin="0,8,0,0"
                                Visibility="{Binding Connection.IsVirtualMachineSelected, Converter={StaticResource BoolToVisibility}}">
                            <!-- DockPanel, not a horizontal StackPanel: a StackPanel measures its
                                 children with infinite width, so TextWrapping never engaged and the
                                 sentence was simply cut off at the panel edge. -->
                            <DockPanel>
                                <components:IconGlyph DockPanel.Dock="Left" IconData="{StaticResource Glyph.Info}" Width="{StaticResource Size.Icon.Sm}" Height="{StaticResource Size.Icon.Sm}"
                                                      Foreground="{StaticResource Brush.Info}" Margin="0,1,8,0" VerticalAlignment="Top" />
                                <TextBlock Text="Bezpečný simulátor — neotevře fyzický port ani laser."
                                           Style="{StaticResource Text.Muted}" TextWrapping="Wrap" />
                            </DockPanel>
                        </Border>
                        <Button Style="{StaticResource Button.Primary}" Command="{Binding Connection.ConnectCommand}"
                                Margin="0,8,0,0" Padding="14,8">
                            <components:IconLabel IconData="{StaticResource Glyph.Connect}" Text="Připojit přes COM" Foreground="White" />
                        </Button>
                    </StackPanel>

                    <StackPanel Visibility="{Binding Connection.IsConnected, Converter={StaticResource BoolToVisibility}}">
                        <Border Background="{StaticResource Brush.Field}" BorderBrush="{StaticResource Brush.PanelBorder}"
                                BorderThickness="1" CornerRadius="{StaticResource Radius.Lg}" Padding="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Pracovní plocha" Style="{StaticResource PanelTitle}" Margin="0" />
                                <TextBlock Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource Text.Numeric}">
                                    <Run Text="{Binding Connection.WorkAreaWidthMm, Mode=OneWay, StringFormat={}{0:0.#}}" />
                                    <Run Text=" × " />
                                    <Run Text="{Binding Connection.WorkAreaHeightMm, Mode=OneWay, StringFormat={}{0:0.#}}" />
                                    <Run Text=" mm" />
                                </TextBlock>
                            </Grid>
                        </Border>

                        <Border Background="{StaticResource Brush.Field}" BorderBrush="{StaticResource Brush.PanelBorder}"
                                BorderThickness="1" CornerRadius="{StaticResource Radius.Lg}" Padding="10" Margin="0,8,0,0">
                            <StackPanel>
                                <TextBlock Text="Polohovací paprsek" Style="{StaticResource PanelTitle}" Margin="0,0,0,8" />
                                <Grid Margin="0,0,0,7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="88" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Výkon" Style="{StaticResource MachineFieldLabel}" VerticalAlignment="Center" Margin="0" />
                                    <TextBox Grid.Column="1"
                                             Text="{Binding Jog.PositioningLaserPowerPercent, UpdateSourceTrigger=PropertyChanged, StringFormat=0.#}"
                                             HorizontalContentAlignment="Right"
                                             ToolTip="Povolený rozsah pro polohování je 0,1 až 5 %." />
                                    <TextBlock Grid.Column="2" Text="%" Style="{StaticResource Text.Muted}" Margin="7,0,0,0" VerticalAlignment="Center" />
                                </Grid>
                                <TextBlock Text="Doporučeno 1 %. Paprsek svítí pouze po dobu držení tlačítka."
                                           Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,0,0,8" />
                                <Button x:Name="PositioningLaserButton"
                                        Style="{StaticResource Button.Danger}"
                                        IsEnabled="{Binding Jog.CanUsePositioningLaser}"
                                        PreviewMouseLeftButtonDown="OnPositioningLaserPressed"
                                        PreviewMouseLeftButtonUp="OnPositioningLaserReleased"
                                        LostMouseCapture="OnPositioningLaserLostCapture"
                                        PreviewKeyDown="OnPositioningLaserKeyDown"
                                        PreviewKeyUp="OnPositioningLaserKeyUp"
                                        ToolTipService.ShowOnDisabled="True"
                                        ToolTip="Vyžaduje připojený nečinný GRBL laser s potvrzeným režimem $32=1.">
                                    <components:IconLabel IconData="{StaticResource Glyph.Zap}" Text="Podržet pro paprsek" />
                                </Button>
                                <TextBlock Text="{Binding Jog.LastActionMessage}" Style="{StaticResource Text.Muted}"
                                           TextWrapping="Wrap" Margin="0,7,0,0"
                                           Visibility="{Binding Jog.LastActionMessage, Converter={StaticResource NotNullToVisibility}}" />
                            </StackPanel>
                        </Border>

                        <Button Style="{StaticResource Button.Outline}" Command="{Binding Connection.DisconnectCommand}" Margin="0,9,0,0">
                            <components:IconLabel IconData="{StaticResource Glyph.Disconnect}" Text="Odpojit zařízení" />
                        </Button>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Visibility="{Binding IsChecked, ElementName=JogPanelTab, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Margin="0,10,0,8" IsEnabled="{Binding Connection.IsConnected}">
                    <Grid Margin="0,0,0,9">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="Ruční posun" Style="{StaticResource PanelTitle}" Margin="0" />
                        <TextBlock Grid.Column="1" Text="XY / Z" Style="{StaticResource Text.Muted}" />
                    </Grid>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="XY krok (mm)" Style="{StaticResource MachineFieldLabel}" /><ComboBox ItemsSource="{Binding Jog.StepSizePresets}" SelectedItem="{Binding Jog.StepSizeMm}" /></StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock Text="XY rychlost (mm/min)" Style="{StaticResource MachineFieldLabel}" /><TextBox Text="{Binding Jog.JogFeedRate, UpdateSourceTrigger=PropertyChanged, StringFormat=0}" /></StackPanel>
                    </Grid>
                    <Grid HorizontalAlignment="Center" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="50" /><ColumnDefinition Width="50" /><ColumnDefinition Width="50" /><ColumnDefinition Width="14" /><ColumnDefinition Width="50" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="50" /><RowDefinition Height="50" /><RowDefinition Height="50" /></Grid.RowDefinitions>
                        <Button Grid.Row="0" Grid.Column="0" Style="{StaticResource JogPadButton}" Command="{Binding Jog.JogXNegYPosCommand}" ToolTip="Posunout hlavu vlevo nahoru"><components:IconGlyph IconData="{StaticResource Glyph.ArrowUpLeft}" Width="{StaticResource Size.Icon.Sm}" Height="{StaticResource Size.Icon.Sm}" /></Button>
                        <Button Grid.Row="0" Grid.Column="1" Style="{StaticResource JogPadButton}" Command="{Binding Jog.JogYPosCommand}" ToolTip="Posunout hlavu nahoru (osa Y plus)"><components:IconGlyph IconData="{StaticResource Glyph.ArrowUp}" Width="{StaticResource Size.Icon.Sm}" Height="{StaticResource Size.Icon.Sm}" /></Button>
                        <Button Grid.Row="0" Grid.Column="2" Style="{StaticResource JogPadButton}" Command="{Binding Jog.JogXPosYPosCommand}" ToolTip="Posunout hlavu vpravo nahoru"><components:IconGlyph IconData="{StaticResource Glyph.ArrowUpRight}" Width="{StaticResource Size.Icon.Sm}" Height="{StaticResource Size.Icon.Sm}" /></Button>
                        <Button Grid.Row="1" Grid.Column="0" Style="{StaticResource JogPadButton}" Command="{Binding Jog.JogXNegCommand}" ToolTip="Posunout hlavu vlevo (osa X minus)"><components:IconGlyph IconData="{StaticResource Glyph.ArrowLeft}" Width="{StaticResource Size.Icon.Sm}" Height="{StaticResource Size.Icon.Sm}" /></Button>
                        <Button Grid.Row="1" Grid.Column="1" Style="{StaticResource JogHomeButton}" Command="{Binding Jog.HomeCommand}" ToolTip="Hlava se přesune do výchozí polohy. Uvolněte pracovní prostor"><components:IconGlyph IconData="{StaticResource Glyph.MachineHome}" Width="{StaticResource Size.Icon.Sm}" Height="{StaticResource Size.Icon.Sm}" /></Button>
                        <Button Grid.Row="1" Grid.Column="2" Style="{StaticResource JogPadButton}" Command="{Binding Jog.JogXPosCommand}" ToolTip="Posunout hlavu vpravo (osa X plus)"><components:IconGlyph IconData="{StaticResource Glyph.ArrowRight}" Width="{StaticResource Size.Icon.Sm}" Height="{StaticResource Size.Icon.Sm}" /></Button>
                        <Button Grid.Row="2" Grid.Column="0" Style="{StaticResource JogPadButton}" Command="{Binding Jog.JogXNegYNegCommand}" ToolTip="Posunout hlavu vlevo dolů"><components:IconGlyph IconData="{StaticResource Glyph.ArrowDownLeft}" Width="{StaticResource Size.Icon.Sm}" Height="{StaticResource Size.Icon.Sm}" /></Button>
                        <Button Grid.Row="2" Grid.Column="1" Style="{StaticResource JogPadButton}" Command="{Binding Jog.JogYNegCommand}" ToolTip="Posunout hlavu dolů (osa Y minus)"><components:IconGlyph IconData="{StaticResource Glyph.ArrowDown}" Width="{StaticResource Size.Icon.Sm}" Height="{StaticResource Size.Icon.Sm}" /></Button>
                        <Button Grid.Row="2" Grid.Column="2" Style="{StaticResource JogPadButton}" Command="{Binding Jog.JogXPosYNegCommand}" ToolTip="Posunout hlavu vpravo dolů"><components:IconGlyph IconData="{StaticResource Glyph.ArrowDownRight}" Width="{StaticResource Size.Icon.Sm}" Height="{StaticResource Size.Icon.Sm}" /></Button>
                        <TextBlock Grid.Row="0" Grid.Column="4" Text="Z" Style="{StaticResource Text.Muted}" HorizontalAlignment="Center" VerticalAlignment="Bottom" />
                        <Button Grid.Row="1" Grid.Column="4" Style="{StaticResource JogPadButton}" Command="{Binding Jog.JogZPosCommand}" ToolTip="Zvednout osu Z, vzdálí se od materiálu"><components:IconGlyph IconData="{StaticResource Glyph.ArrowUp}" Width="{StaticResource Size.Icon.Sm}" Height="{StaticResource Size.Icon.Sm}" /></Button>
                        <Button Grid.Row="2" Grid.Column="4" Style="{StaticResource JogPadButton}" Command="{Binding Jog.JogZNegCommand}" ToolTip="Spustit osu Z, přiblíží se k materiálu"><components:IconGlyph IconData="{StaticResource Glyph.ArrowDown}" Width="{StaticResource Size.Icon.Sm}" Height="{StaticResource Size.Icon.Sm}" /></Button>
                    </Grid>
                    <Grid Margin="0,0,0,9">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="Z krok (mm)" Style="{StaticResource MachineFieldLabel}" /><ComboBox ItemsSource="{Binding Jog.StepSizePresets}" SelectedItem="{Binding Jog.ZStepSizeMm}" /></StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock Text="Z rychlost (mm/min)" Style="{StaticResource MachineFieldLabel}" /><TextBox Text="{Binding Jog.ZJogFeedRate, UpdateSourceTrigger=PropertyChanged, StringFormat=0}" /></StackPanel>
                    </Grid>
                    <Grid Margin="0,0,0,7">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="7" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Button Style="{StaticResource Button.Secondary}" Command="{Binding Jog.SetOriginHereCommand}"><components:IconLabel IconData="{StaticResource Glyph.Origin}" Text="Nula zde" /></Button>
                        <Button Grid.Column="2" Style="{StaticResource Button.Secondary}" Command="{Binding Jog.GoToWorkZeroCommand}"><components:IconLabel IconData="{StaticResource Glyph.Origin}" Text="Na nulu XY" /></Button>
                    </Grid>
                    <Button Style="{StaticResource Button.Secondary}" Command="{Binding Jog.UnlockCommand}" Margin="0,0,0,7"><components:IconLabel IconData="{StaticResource Glyph.Unlock}" Text="Odemknout zařízení ($X)" /></Button>
                    <Button Style="{StaticResource Button.Danger}" Command="{Binding Jog.CancelJogCommand}"><components:IconLabel IconData="{StaticResource Glyph.Stop}" Text="Zastavit ruční pohyb" /></Button>
                    <Expander Header="Pokročilé ovládání" Margin="0,8,0,0">
                        <Button Style="{StaticResource Button.Danger}" Command="{Binding Jog.SoftResetCommand}" Margin="0,8,0,0"
                                ToolTip="Resetuje řídicí jednotku. Použijte pouze při chybě nebo nereagujícím stroji.">
                            <components:IconLabel IconData="{StaticResource Glyph.Refresh}" Text="Resetovat řídicí jednotku" />
                        </Button>
                    </Expander>
                    <Border Background="{StaticResource Brush.InfoMuted}" BorderBrush="{StaticResource Brush.InfoBorder}"
                            BorderThickness="1" CornerRadius="{StaticResource Radius.Md}" Padding="12" Margin="0,10,0,0">
                        <!-- DockPanel, not a horizontal StackPanel: a StackPanel measures its children with
                             infinite width, so TextWrapping never engages and the sentence is cut off at
                             the panel edge. -->
<DockPanel>
                            <components:IconGlyph DockPanel.Dock="Left" VerticalAlignment="Top" IconData="{StaticResource Glyph.Info}" Width="{StaticResource Size.Icon.Md}" Height="{StaticResource Size.Icon.Md}" Margin="0,1,9,0" Foreground="{StaticResource Brush.Info}" />
                            <TextBlock Text="Pro přesné polohování použijte menší krok. Návrat na pracovní nulu provede tlačítko Na nulu XY."
                                       Style="{StaticResource Text.Muted}" TextWrapping="Wrap" />
                        </DockPanel>
                    </Border>
                    <TextBlock Text="{Binding Jog.LastActionMessage}" Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,7,0,0" />
                </StackPanel>
            </ScrollViewer>

            <Grid Visibility="{Binding IsChecked, ElementName=ConsolePanelTab, Converter={StaticResource BoolToVisibility}}" Margin="0,10,0,8">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="Konzola GRBL" Style="{StaticResource PanelTitle}" Margin="0" /><TextBlock Grid.Column="1" Text="Pokročilé" Style="{StaticResource Text.Muted}" /></Grid>
                <Border Grid.Row="1" Background="{StaticResource Brush.Field}" BorderBrush="{StaticResource Brush.PanelBorder}" BorderThickness="1" CornerRadius="{StaticResource Radius.Lg}">
                    <ScrollViewer x:Name="ConsoleScroll" VerticalScrollBarVisibility="Auto" Padding="8">
                        <ItemsControl ItemsSource="{Binding Console.Lines}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" FontFamily="{StaticResource Font.Mono}" FontSize="{StaticResource Size.Text.Meta}" TextWrapping="Wrap" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                    </ScrollViewer>
                </Border>
                <Grid Grid.Row="2" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBox FontFamily="{StaticResource Font.Mono}" Text="{Binding Console.CommandInput, UpdateSourceTrigger=PropertyChanged}" KeyDown="OnConsoleInputKeyDown" />
                    <Button Grid.Column="1" Style="{StaticResource Button.Secondary}" Command="{Binding Console.SendCommand}" Margin="8,0,0,0"><components:IconLabel IconData="{StaticResource Glyph.Send}" Text="Odeslat" /></Button>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
