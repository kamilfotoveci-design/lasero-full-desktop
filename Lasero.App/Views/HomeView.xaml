<UserControl x:Class="Lasero.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Lasero.App.Converters"
             xmlns:components="clr-namespace:Lasero.App.Components"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1316" d:DesignHeight="860">

    <!--
        Home is the shared screen frame (PageScaffold: header band, one scrolling column) beside the shared 360 px
        right panel. Every value comes from live state: recent projects from RecentProjectsStore, materials and the last
        job from JobHistoryStore, the panel from ConnectionViewModel and MachineStatusViewModel. Where the mockup showed a
        fact Lasero does not record, the control is omitted rather than filled with a plausible-looking value.

        Order of the eye: greeting and subtitle, the one dominant action (Nový projekt), the tip, then the work.
        Sections are 32 apart (Layout.SectionGap), cards and shelf items 16.
    -->

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
        <conv:NotNullToVisibilityConverter x:Key="NotNullToVisibility" />
        <conv:MachineDisplayStateToLabelConverter x:Key="MachineStateLabel" />
        <conv:MachineDisplayStateToStatePillKindConverter x:Key="MachineStatePillKind" />
    </UserControl.Resources>

    <Grid Background="{DynamicResource Brush.Surface}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="520" />
            <ColumnDefinition Width="{StaticResource Layout.PanelColumn}" />
        </Grid.ColumnDefinitions>

        <!-- ================= CONTENT COLUMN ================= -->
        <components:PageScaffold Grid.Column="0">
            <components:PageScaffold.Header>
                <Grid x:Name="KamilWelcome" Loaded="OnKamilWelcomeLoaded" RenderTransformOrigin="0.5,0.5">
                    <components:PageHeader Title="Dobrý den, jsem Kamil" NextStep="{Binding ScreenNextStep}"
                                           Subtitle="Nový projekt je první krok. Provedu návrhem, přípravou materiálu i kontrolou před gravírováním.">
                        <components:PageHeader.Leading>
                            <components:LaseroAvatar Size="72" AutomationProperties.Name="Kamil, průvodce aplikací" />
                        </components:PageHeader.Leading>
                        <components:PageHeader.Actions>
                            <Button Style="{StaticResource Button.Quiet}" Command="{Binding ReplayTourCommand}" FontSize="{StaticResource Size.Text.Body}"
                                    ToolTip="Krátká prohlídka aplikace krok za krokem"
                                    AutomationProperties.Name="Prohlídka aplikace">
                                <components:IconLabel IconData="{StaticResource Glyph.Help}" Text="Prohlídka aplikace"
                                                      IconSize="{StaticResource Size.Icon.Md}" TextMargin="8,0,0,0" />
                            </Button>
                        </components:PageHeader.Actions>
                    </components:PageHeader>
                </Grid>
            </components:PageScaffold.Header>

            <components:PageScaffold.Body>
                <StackPanel>

                    <!-- Primary actions. Exactly one dominant action: Nový projekt. Importovat and Otevřít projekt are
                         clearly secondary, the tip of the day is a quiet card below. They wrap rather than clip. -->
                    <WrapPanel Margin="0,0,-8,8" AutomationProperties.AutomationId="HomeActions">
                        <Button Style="{StaticResource Button.Large}" Command="{Binding NewProjectCommand}" Margin="0,0,8,8"
                                Padding="24,0" FontSize="{StaticResource Size.Text.Section}"
                                ToolTip="Založit prázdný projekt · Ctrl+N" AutomationProperties.Name="Nový projekt">
                            <components:IconLabel IconData="{StaticResource Glyph.New}" Text="Nový projekt"
                                                  Foreground="White" IconSize="{StaticResource Size.Icon.Xl}" TextMargin="8,0,0,0" />
                        </Button>
                        <!-- Deliberately generic: LoadFileCommand accepts SVG, bitmaps and G-code. Lasero
                             has no DXF importer, so the label must not promise one. -->
                        <Button Style="{StaticResource Button.Secondary}" Command="{Binding ImportFromHomeCommand}" Margin="0,0,8,8"
                                Height="{StaticResource Size.Control.Primary}" Padding="16,0" VerticalAlignment="Center"
                                ToolTip="Načíst SVG, obrázek nebo G-code a otevřít je v návrhu" AutomationProperties.Name="Importovat">
                            <components:IconLabel IconData="{StaticResource Glyph.Import}" Text="Importovat"
                                                  IconSize="{StaticResource Size.Icon.Md}" TextMargin="8,0,0,0" />
                        </Button>
                        <Button Style="{StaticResource Button.Secondary}" Command="{Binding OpenProjectCommand}" Margin="0,0,8,8"
                                Height="{StaticResource Size.Control.Primary}" Padding="16,0" VerticalAlignment="Center"
                                ToolTip="Otevřít uložený projekt · Ctrl+O" AutomationProperties.Name="Otevřít projekt">
                            <components:IconLabel IconData="{StaticResource Glyph.Open}" Text="Otevřít projekt"
                                                  IconSize="{StaticResource Size.Icon.Md}" TextMargin="8,0,0,0" />
                        </Button>
                    </WrapPanel>

                    <!-- Tip dne: a quiet card between the actions and the work. A different surface from the
                         contextual TipChip over the workspace (that one reacts to an event; this one rotates daily). -->
                    <components:TipOfDayCard Tip="{Binding Home.TipOfDay}" NextCommand="{Binding Home.NextTipCommand}"
                                             Position="{Binding Home.TipPosition}" Count="{Binding Home.TipCount}"
                                             Margin="0,0,0,32"
                                             AutomationProperties.AutomationId="HomeTipOfDay"
                                             AutomationProperties.Name="Tip dne" />

                    <!-- Pokračovat v práci. The newest project gets the full-width feature; older entries stay in a
                         horizontally scrolling shelf so none are hidden. -->
                    <StackPanel Margin="0,0,0,32"
                                Visibility="{Binding Home.HasRecentProjects, Converter={StaticResource BoolToVisibility}}">
                        <components:SectionHeader Title="Pokračovat v práci" Level="Page" />
                        <components:ProjectThumbCard DataContext="{Binding Home.FeaturedProject}" Height="220" Margin="0,0,0,16"
                            OpenCommand="{Binding DataContext.Home.OpenRecentProjectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            RemoveCommand="{Binding DataContext.Home.RemoveRecentProjectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            Visibility="{Binding DataContext.Home.FeaturedProject, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource NotNullToVisibility}}" />
                        <ItemsControl ItemsSource="{Binding Home.OtherRecentProjectRows}" Margin="0,0,-16,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <components:ProjectThumbCard
                                        Width="260" Margin="0,0,16,8"
                                        OpenCommand="{Binding DataContext.Home.OpenRecentProjectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        RemoveCommand="{Binding DataContext.Home.RemoveRecentProjectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Materials: a horizontal shelf; each usage row stays factual and compact. -->
                    <StackPanel Margin="0,0,0,32">
                        <components:SectionHeader Title="Naposledy použité materiály" Level="Page">
                            <components:SectionHeader.Action>
                                <Button Style="{StaticResource Button.Link}" Click="OnMaterialsClick"
                                        Content="Vše →"
                                        ToolTip="Otevřít knihovnu materiálů a přednastavení" />
                            </components:SectionHeader.Action>
                        </components:SectionHeader>
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                      Visibility="{Binding Home.HasRecentMaterials, Converter={StaticResource BoolToVisibility}}">
                            <ItemsControl ItemsSource="{Binding Home.RecentMaterialRows}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="220" Margin="0,0,12,0" Padding="16" Background="{DynamicResource Brush.PanelRaised}"
                                                CornerRadius="{StaticResource Radius.Md}" components:RoundedClip.ToParentBorder="True">
                                            <components:MaterialUsageRow />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <TextBlock Style="{StaticResource Text.EmptyLine}" Text="Po dokončení úlohy se tady zobrazí použité materiály."
                                   Visibility="{Binding Home.HasRecentMaterials, Converter={StaticResource InverseBoolToVisibility}}" />
                    </StackPanel>

                    <!-- Poslední úloha -->
                    <StackPanel>
                        <components:SectionHeader Title="Poslední úloha" Level="Page" />
                        <components:ElevatedBorder Style="{StaticResource Card}" Padding="16" MinHeight="152"
                                Visibility="{Binding Home.HasLastJob, Converter={StaticResource BoolToVisibility}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel VerticalAlignment="Top" Margin="0,0,12,0">
                                    <StackPanel Orientation="Horizontal">
                                        <components:IconGlyph IconData="{StaticResource Glyph.Check}"
                                                              Width="{StaticResource Size.Icon.Lg}" Height="{StaticResource Size.Icon.Lg}"
                                                              Foreground="{DynamicResource Brush.Success}"
                                                              VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBlock Text="{Binding Home.LastJobName}" FontWeight="Medium"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Home.LastJobName}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding Home.LastJobResultLabel}" Style="{StaticResource Text.Muted}"
                                               Margin="0,8,0,0" />
                                    <TextBlock Text="{Binding Home.LastJobMaterialLabel}" Style="{StaticResource Text.Muted}"
                                               Margin="0,4,0,0" TextTrimming="CharacterEllipsis"
                                               Visibility="{Binding Home.LastJobMaterialLabel, Converter={StaticResource NotNullToVisibility}}" />
                                    <TextBlock Text="{Binding Home.LastJobCompletedLabel}" Style="{StaticResource Text.Muted}"
                                               Margin="0,4,0,0" />
                                </StackPanel>

                                <Border Grid.Column="1" Width="64" Height="64" VerticalAlignment="Top"
                                        CornerRadius="{StaticResource Radius.Sm}"
                                        Background="{DynamicResource Brush.PanelRaised}">
                                    <components:IconGlyph IconData="{StaticResource Glyph.History}"
                                                          Width="{StaticResource Size.Icon.Xl}" Height="{StaticResource Size.Icon.Xl}"
                                                          Foreground="{DynamicResource Brush.TextMuted}" />
                                </Border>
                            </Grid>
                        </components:ElevatedBorder>
                        <TextBlock Style="{StaticResource Text.EmptyLine}" Text="Dokončené úlohy se zobrazí tady."
                                   Visibility="{Binding Home.HasLastJob, Converter={StaticResource InverseBoolToVisibility}}" />
                    </StackPanel>
                </StackPanel>
            </components:PageScaffold.Body>
        </components:PageScaffold>

        <!-- ================= DEVICE PANEL (the shared 360 px right panel) ================= -->
        <Border Grid.Column="1" Background="{DynamicResource Brush.Panel}"
                BorderBrush="{DynamicResource Brush.PanelBorder}" BorderThickness="1,0,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Padding="24,16,24,4"
                        BorderBrush="{DynamicResource Brush.PanelBorder}" BorderThickness="0,0,0,1">
                    <components:SectionHeader Title="Zařízení" Level="Card" />
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="24">

                        <!-- Identity and state. The pill reads MachineStatus.DisplayState, so it can
                             only say "Připraveno" when the controller has actually answered Idle. -->
                        <Grid Margin="0,0,0,24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <components:IconTile IconData="{StaticResource Glyph.Device}" Tone="Graphite" Size="32"
                                                 VerticalAlignment="Center" Margin="0,0,12,0" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Home.DeviceName}" FontSize="{StaticResource Size.Text.Body}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Home.DeviceName}" />
                                <components:StatusBadge Margin="0,4,0,0" HorizontalAlignment="Left"
                                                        StatusText="{Binding Home.MachineStatus.DisplayState, Converter={StaticResource MachineStateLabel}}"
                                                        Kind="{Binding Home.MachineStatus.DisplayState, Converter={StaticResource MachineStatePillKind}}" />
                            </StackPanel>
                        </Grid>

                        <!-- Facts: label muted on the left, value on the right, hairline between rows. -->
                        <StackPanel Margin="0,0,0,24"
                                    Visibility="{Binding Home.Connection.IsConnected, Converter={StaticResource BoolToVisibility}}">
                            <components:FormRow Label="Pracovní plocha" ShowRule="True">
                                <components:FormRow.Value>
                                    <TextBlock FontFamily="{StaticResource Font.Numeric}" Typography.NumeralAlignment="Tabular">
                                        <Run Text="{Binding Settings.Machine.WorkAreaWidthMm, Mode=OneWay, StringFormat={}{0:0.#}}" />
                                        <Run Text="×" />
                                        <Run Text="{Binding Settings.Machine.WorkAreaHeightMm, Mode=OneWay, StringFormat={}{0:0.#}}" />
                                        <Run Text="mm" />
                                    </TextBlock>
                                </components:FormRow.Value>
                            </components:FormRow>
                            <components:FormRow Label="Připojení" ShowRule="True">
                                <components:FormRow.Value>
                                    <TextBlock Text="{Binding Home.ConnectionSummaryLabel}" ToolTip="{Binding Home.DeviceConnectionLabel}" />
                                </components:FormRow.Value>
                            </components:FormRow>
                            <components:FormRow Label="Firmware">
                                <components:FormRow.Value>
                                    <TextBlock Text="{Binding Home.FirmwareLabel}" FontFamily="{StaticResource Font.Numeric}" />
                                </components:FormRow.Value>
                            </components:FormRow>
                        </StackPanel>

                        <!-- The one action Home's machine card needs: connect. Homing, framing, jogging and
                             the positioning beam are machine and job controls; they live on Zařízení and
                             Návrh (docs/screen-controls-matrix.md). -->
                        <Button Style="{StaticResource Button.Secondary}" HorizontalAlignment="Stretch"
                                Command="{Binding OpenDeviceWizardCommand}"
                                Visibility="{Binding Home.Connection.IsConnected, Converter={StaticResource InverseBoolToVisibility}}"
                                ToolTip="Najít a připojit gravírku">
                            <components:IconLabel IconData="{StaticResource Glyph.Connect}" Text="Připojit zařízení"
                                                  IconSize="{StaticResource Size.Icon.Lg}" TextMargin="8,0,0,0" />
                        </Button>

                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
