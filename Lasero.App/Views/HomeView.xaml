<UserControl x:Class="Lasero.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Lasero.App.Converters"
             xmlns:components="clr-namespace:Lasero.App.Components"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1316" d:DesignHeight="860">

    <!--
        Home follows the approved Stitch layout: a scrolling content column at 24px padding beside a
        fixed 300px device rail. Every value on this screen comes from live state — recent projects
        from RecentProjectsStore, materials and the last job from JobHistoryStore, the rail from
        ConnectionViewModel/MachineStatusViewModel. Where the mockup shows a fact Lasero does not
        record (project dimensions, the material a project uses, the file behind a history entry) the
        control is omitted rather than filled with a plausible-looking value.
    -->

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
        <conv:NotNullToVisibilityConverter x:Key="NotNullToVisibility" />
        <conv:MachineDisplayStateToLabelConverter x:Key="MachineStateLabel" />
        <conv:MachineDisplayStateToStatePillKindConverter x:Key="MachineStatePillKind" />

        <!-- 16/24 semibold, matching the mockup's section-header and headline-home steps onto the
             product's existing type scale. -->
        <Style x:Key="SectionHeading" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Font.Display}" />
            <Setter Property="FontSize" Value="{StaticResource Size.Text.Section}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- The rail's stat tiles: a metadata caption over a compact value. -->
        <Style x:Key="RailTile" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.PanelRaised}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.PanelBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource Radius.Sm}" />
            <Setter Property="Padding" Value="10" />
        </Style>
        <!-- Half-width tiles leave roughly 90px for a caption, so the glyph runs at chrome size and
             the label takes whatever is left rather than being cut off by a fixed-width sibling. -->
        <Style x:Key="RailTileIcon" TargetType="components:IconGlyph">
            <Setter Property="Width" Value="{StaticResource Size.Icon.Chrome}" />
            <Setter Property="Height" Value="{StaticResource Size.Icon.Chrome}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
            <Setter Property="Margin" Value="0,2,5,0" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="DockPanel.Dock" Value="Left" />
        </Style>
        <!-- Wraps rather than trims: "Pracovní plocha" does not fit one line in a half-width tile,
             and the mockup sets it on two lines rather than clipping it. -->
        <Style x:Key="RailTileCaption" TargetType="TextBlock" BasedOn="{StaticResource Text.Muted}">
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="RailTileValue" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Margin" Value="0,5,0,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <!-- Stacked icon-over-label, for the pair of machine actions at the foot of the rail. -->
        <Style x:Key="RailStackedAction" TargetType="Button" BasedOn="{StaticResource Button.Regular}">
            <Setter Property="Height" Value="56" />
            <Setter Property="MinHeight" Value="56" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="FontSize" Value="{StaticResource Size.Text.Meta}" />
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource Brush.Background}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="520" />
            <ColumnDefinition Width="300" />
        </Grid.ColumnDefinitions>

        <!-- ================= CONTENT COLUMN ================= -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <!--
                Capped and left-aligned. The Stitch column is about 1010px wide and its cards are
                roughly 340×220; letting the column run to the full width of a 1920 or 2560 window
                stretched the same three cards to 480 and turned the thumbnail well into a letterbox.

                A MaxWidth on the panel itself would not do it — a stretched element with a MaxWidth
                centres, and a left-aligned StackPanel shrinks to its widest child instead of growing
                to the cap. A single star column carrying the MaxWidth gives a bounded, left-anchored
                column at every window size.
            -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MaxWidth="1180" />
                </Grid.ColumnDefinitions>
            <StackPanel Margin="24">

                <!-- Primary actions -->
                <TextBlock Text="Začněte novým návrhem" Style="{StaticResource PageTitle}" Margin="0,0,0,24" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,32">
                    <Button Style="{StaticResource Button.Large}" Command="{Binding NewProjectCommand}" Margin="0,0,16,0"
                            ToolTip="Založit prázdný projekt · Ctrl+N" AutomationProperties.Name="Nový projekt">
                        <components:IconLabel IconData="{StaticResource Glyph.New}" Text="Nový projekt"
                                              Foreground="White" IconSize="{StaticResource Size.Icon.Lg}" TextMargin="9,0,0,0" />
                    </Button>
                    <!-- Deliberately generic: LoadFileCommand accepts SVG, bitmaps and G-code. Lasero
                         has no DXF importer, so the label must not promise one. -->
                    <Button Style="{StaticResource Button.LargeSecondary}" Command="{Binding GCode.LoadFileCommand}" Margin="0,0,16,0"
                            ToolTip="Načíst SVG, obrázek nebo G-code do návrhu" AutomationProperties.Name="Importovat">
                        <components:IconLabel IconData="{StaticResource Glyph.Import}" Text="Importovat"
                                              IconSize="{StaticResource Size.Icon.Lg}" TextMargin="9,0,0,0" />
                    </Button>
                    <Button Style="{StaticResource Button.LargeSecondary}" Command="{Binding OpenProjectCommand}"
                            ToolTip="Otevřít uložený projekt · Ctrl+O" AutomationProperties.Name="Otevřít projekt">
                        <components:IconLabel IconData="{StaticResource Glyph.Open}" Text="Otevřít projekt"
                                              IconSize="{StaticResource Size.Icon.Lg}" TextMargin="9,0,0,0" />
                    </Button>
                </StackPanel>

                <!-- Pokračovat v práci -->
                <TextBlock Text="Pokračovat v práci" Style="{StaticResource SectionHeading}"
                           HorizontalAlignment="Left" Margin="0,0,0,16" />

                <Border Style="{StaticResource Card}" Padding="24,22"
                        Visibility="{Binding Home.HasRecentProjects, Converter={StaticResource InverseBoolToVisibility}}"
                        Margin="0,0,0,32">
                    <components:EmptyState IconPrimaryData="{StaticResource Glyph.Project}"
                                           Title="Zatím tu nic není"
                                           Description="Projekty, které uložíte nebo otevřete, se objeví tady."
                                           CtaText="Založit nový projekt"
                                           CtaCommand="{Binding NewProjectCommand}" />
                </Border>

                <!-- Three per row, matching the mockup's lg:grid-cols-3. The recent list holds at most
                     twelve entries, so it wraps rather than hiding anything behind a link to a
                     project browser the application does not have. -->
                <!-- The 24px gutter lives on the cards, so the trailing column's and bottom row's
                     gutters are pulled back off the container rather than padding the section. -->
                <ItemsControl ItemsSource="{Binding Home.RecentProjectRows}" Margin="0,0,-24,8"
                              Visibility="{Binding Home.HasRecentProjects, Converter={StaticResource BoolToVisibility}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="3" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <components:ProjectThumbCard
                                Margin="0,0,24,24"
                                OpenCommand="{Binding DataContext.Home.OpenRecentProjectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                RemoveCommand="{Binding DataContext.Home.RemoveRecentProjectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Materiály + poslední úloha, side by side -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="32" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Naposledy použité materiály" Style="{StaticResource SectionHeading}" />
                            <Button Grid.Column="1" Style="{StaticResource Button.Link}" Click="OnMaterialsClick"
                                    Content="Knihovna materiálů →"
                                    ToolTip="Otevřít knihovnu materiálů a přednastavení" />
                        </Grid>

                        <Border Style="{StaticResource ThumbnailCard}"
                                Visibility="{Binding Home.HasRecentMaterials, Converter={StaticResource BoolToVisibility}}">
                            <ItemsControl ItemsSource="{Binding Home.RecentMaterialRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!-- Hairline between rows, none above the first: the card's own
                                             border already closes the top edge. -->
                                        <Border BorderBrush="{DynamicResource Brush.PanelBorder}" BorderThickness="0,1,0,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource PreviousData}}" Value="{x:Null}">
                                                            <Setter Property="BorderThickness" Value="0" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <components:MaterialUsageRow />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>

                        <Border Style="{StaticResource Card}" Padding="24,22"
                                Visibility="{Binding Home.HasRecentMaterials, Converter={StaticResource InverseBoolToVisibility}}">
                            <components:EmptyState IconPrimaryData="{StaticResource Glyph.Materials}"
                                                   Title="Zatím žádné použité materiály"
                                                   Description="Jakmile dokončíte úlohu s vyplněným materiálem, objeví se tady." />
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Poslední úloha" Style="{StaticResource SectionHeading}"
                                   HorizontalAlignment="Left" Margin="0,0,0,16" />

                        <Border Style="{StaticResource Card}" Padding="16" MinHeight="154"
                                Visibility="{Binding Home.HasLastJob, Converter={StaticResource BoolToVisibility}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel VerticalAlignment="Top" Margin="0,0,12,0">
                                    <StackPanel Orientation="Horizontal">
                                        <components:IconGlyph IconData="{StaticResource Glyph.Check}"
                                                              Width="{StaticResource Size.Icon.Lg}" Height="{StaticResource Size.Icon.Lg}"
                                                              Foreground="{DynamicResource Brush.Success}"
                                                              VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBlock Text="{Binding Home.LastJobName}" FontWeight="Medium"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Home.LastJobName}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding Home.LastJobResultLabel}" Style="{StaticResource Text.Muted}"
                                               Margin="0,8,0,0" />
                                    <TextBlock Text="{Binding Home.LastJobMaterialLabel}" Style="{StaticResource Text.Muted}"
                                               Margin="0,3,0,0" TextTrimming="CharacterEllipsis"
                                               Visibility="{Binding Home.LastJobMaterialLabel, Converter={StaticResource NotNullToVisibility}}" />
                                    <TextBlock Text="{Binding Home.LastJobCompletedLabel}" Style="{StaticResource Text.Muted}"
                                               Margin="0,3,0,0" />
                                </StackPanel>

                                <Border Grid.Column="1" Width="64" Height="64" VerticalAlignment="Top"
                                        CornerRadius="{StaticResource Radius.Sm}"
                                        Background="{DynamicResource Brush.PanelRaised}"
                                        BorderBrush="{DynamicResource Brush.PanelBorder}" BorderThickness="1">
                                    <components:IconGlyph IconData="{StaticResource Glyph.History}"
                                                          Width="{StaticResource Size.Icon.Xl}" Height="{StaticResource Size.Icon.Xl}"
                                                          Foreground="{DynamicResource Brush.TextMuted}" />
                                </Border>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource Card}" Padding="24,22" MinHeight="154"
                                Visibility="{Binding Home.HasLastJob, Converter={StaticResource InverseBoolToVisibility}}">
                            <components:EmptyState IconPrimaryData="{StaticResource Glyph.History}"
                                                   Title="Zatím žádná dokončená úloha"
                                                   Description="Po dokončení gravírování se tady zobrazí její výsledek a doba běhu." />
                        </Border>
                    </StackPanel>
                </Grid>
            </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- ================= DEVICE RAIL ================= -->
        <Border Grid.Column="1" Background="{DynamicResource Brush.Panel}"
                BorderBrush="{DynamicResource Brush.PanelBorder}" BorderThickness="1,0,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Padding="16,14"
                        BorderBrush="{DynamicResource Brush.PanelBorder}" BorderThickness="0,0,0,1">
                    <TextBlock Text="Zařízení" Style="{StaticResource SectionHeading}" />
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="16">

                        <!-- Identity and state. The pill reads MachineStatus.DisplayState, so it can
                             only say "Připraveno" when the controller has actually answered Idle. -->
                        <Border Background="{DynamicResource Brush.PanelRaised}"
                                BorderBrush="{DynamicResource Brush.PanelBorder}" BorderThickness="1"
                                CornerRadius="{StaticResource Radius.Lg}" Padding="16,20" Margin="0,0,0,24">
                            <StackPanel HorizontalAlignment="Center">
                                <!-- Third step of the rail's tonal ladder: white rail, PanelRaised card,
                                     and the disc a shade darker again. PanelBorder is the only
                                     neutral at that value in the palette, so it doubles as the fill
                                     here rather than a one-off grey being invented for one disc. -->
                                <Border Width="96" Height="96" CornerRadius="{StaticResource Radius.Pill}"
                                        Background="{DynamicResource Brush.PanelBorder}" Margin="0,0,0,12">
                                    <components:IconGlyph IconData="{StaticResource Glyph.Device}"
                                                          Width="{StaticResource Size.Icon.Xxl}" Height="{StaticResource Size.Icon.Xxl}"
                                                          Foreground="{DynamicResource Brush.Accent}" />
                                </Border>
                                <TextBlock Text="{Binding Home.DeviceName}" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                                <components:StatusBadge Margin="0,10,0,0" HorizontalAlignment="Center"
                                                        StatusText="{Binding Home.MachineStatus.DisplayState, Converter={StaticResource MachineStateLabel}}"
                                                        Kind="{Binding Home.MachineStatus.DisplayState, Converter={StaticResource MachineStatePillKind}}" />
                            </StackPanel>
                        </Border>

                        <!-- Facts -->
                        <Grid Margin="0,0,0,24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="12" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border Style="{StaticResource RailTile}">
                                <StackPanel>
                                    <DockPanel>
                                        <components:IconGlyph IconData="{StaticResource Glyph.Frame}" Style="{StaticResource RailTileIcon}" />
                                        <TextBlock Text="Pracovní plocha" Style="{StaticResource RailTileCaption}" />
                                    </DockPanel>
                                    <TextBlock Style="{StaticResource RailTileValue}" FontFamily="{StaticResource Font.Numeric}"
                                               Typography.NumeralAlignment="Tabular">
                                        <Run Text="{Binding Settings.Machine.WorkAreaWidthMm, Mode=OneWay, StringFormat={}{0:0.#}}" />
                                        <Run Text="×" />
                                        <Run Text="{Binding Settings.Machine.WorkAreaHeightMm, Mode=OneWay, StringFormat={}{0:0.#}}" />
                                        <Run Text="mm" />
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Style="{StaticResource RailTile}">
                                <StackPanel>
                                    <DockPanel>
                                        <components:IconGlyph IconData="{StaticResource Glyph.Link}" Style="{StaticResource RailTileIcon}" />
                                        <TextBlock Text="Připojení" Style="{StaticResource RailTileCaption}" />
                                    </DockPanel>
                                    <TextBlock Text="{Binding Home.ConnectionSummaryLabel}" Style="{StaticResource RailTileValue}"
                                               ToolTip="{Binding Home.DeviceConnectionLabel}" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="2" Grid.ColumnSpan="3" Style="{StaticResource RailTile}">
                                <StackPanel>
                                    <DockPanel>
                                        <components:IconGlyph IconData="{StaticResource Glyph.Terminal}" Style="{StaticResource RailTileIcon}" />
                                        <TextBlock Text="Firmware" Style="{StaticResource RailTileCaption}" />
                                    </DockPanel>
                                    <TextBlock Text="{Binding Home.FirmwareLabel}" Style="{StaticResource RailTileValue}"
                                               FontFamily="{StaticResource Font.Numeric}" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Actions. Only commands that already exist and already carry their own
                             preflight: navigation to the machine workspace, GRBL homing and framing.
                             The positioning beam is not here — it is a press-and-hold safety control
                             and lives on the Device screen where its power setting is. -->
                        <Button Style="{StaticResource PrimaryBlue}" HorizontalAlignment="Stretch" Margin="0,0,0,10"
                                Command="{Binding OpenDeviceWizardCommand}"
                                Visibility="{Binding Home.Connection.IsConnected, Converter={StaticResource InverseBoolToVisibility}}"
                                ToolTip="Najít a připojit gravírku">
                            <components:IconLabel IconData="{StaticResource Glyph.Connect}" Text="Připojit zařízení"
                                                  Foreground="White" IconSize="{StaticResource Size.Icon.Sm}" TextMargin="8,0,0,0" />
                        </Button>

                        <Button Style="{StaticResource Button.Regular}" HorizontalAlignment="Stretch" Margin="0,0,0,10"
                                Command="{Binding ShowDeviceCommand}"
                                ToolTip="Připojení, poloha a ruční ovládání gravírky">
                            <components:IconLabel IconData="{StaticResource Glyph.Device}" Text="Ovládání stroje"
                                                  IconSize="{StaticResource Size.Icon.Sm}" TextMargin="8,0,0,0" />
                        </Button>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Button Style="{StaticResource RailStackedAction}" Command="{Binding Jog.HomeCommand}"
                                    ToolTipService.ShowOnDisabled="True"
                                    ToolTip="Hlava se přesune do výchozí polohy (příkaz $H). Uvolněte pracovní prostor. Vyžaduje připojenou gravírku v klidu"
                                    automation:AutomationProperties.Name="Najet do výchozí polohy">
                                <components:IconLabel IconData="{StaticResource Glyph.MachineHome}" Text="Výchozí poloha" Stacked="True"
                                                      IconSize="{StaticResource Size.Icon.Md}" />
                            </Button>

                            <Button Grid.Column="2" Style="{StaticResource RailStackedAction}"
                                    Command="{Binding GCode.RunFramingCommand}"
                                    ToolTipService.ShowOnDisabled="True"
                                    ToolTip="{Binding GCode.FrameActionTooltip}"
                                    automation:AutomationProperties.Name="Rámovat">
                                <components:IconLabel IconData="{StaticResource Glyph.Frame}" Text="Rámovat" Stacked="True"
                                                      IconSize="{StaticResource Size.Icon.Md}" />
                            </Button>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
