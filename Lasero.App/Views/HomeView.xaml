<UserControl x:Class="Lasero.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Lasero.App.Converters"
             xmlns:components="clr-namespace:Lasero.App.Components"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="800">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
        <conv:NotNullToVisibilityConverter x:Key="NotNullToVisibility" />
        <conv:UtcToLocalConverter x:Key="UtcToLocal" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="20,16,20,28" MaxWidth="1280" HorizontalAlignment="Stretch">
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Domů" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="Začněte nový projekt nebo pokračujte tam, kde jste skončili."
                               Style="{StaticResource PageSubtitle}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                            Visibility="{Binding Home.HasRecentProjects, Converter={StaticResource BoolToVisibility}}">
                    <Button Style="{StaticResource Button.Large}" Command="{Binding NewProjectCommand}" Margin="0,0,10,0">
                        <components:IconLabel IconData="{StaticResource Glyph.New}" Text="Nový projekt" Foreground="White" />
                    </Button>
                    <Button Style="{StaticResource Button.Regular}" Command="{Binding OpenProjectCommand}">
                        <components:IconLabel IconData="{StaticResource Glyph.Open}" Text="Otevřít projekt" />
                    </Button>
                </StackPanel>
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.1*" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="1*" MinWidth="300" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <!-- First-run users see one clear route instead of empty dashboards and zero metrics. -->
                    <Border Style="{StaticResource Card}" Padding="28"
                            Visibility="{Binding Home.HasRecentProjects, Converter={StaticResource InverseBoolToVisibility}}">
                        <StackPanel MaxWidth="720" HorizontalAlignment="Left">
                            <Border Width="48" Height="48" CornerRadius="{StaticResource Radius.Lg}"
                                    Background="{StaticResource Brush.SelectedSurface}" HorizontalAlignment="Left">
                                <components:IconGlyph IconData="{StaticResource Glyph.Design}" Width="{StaticResource Size.Icon.Lg}" Height="{StaticResource Size.Icon.Lg}"
                                                      Foreground="{StaticResource Brush.Accent}" />
                            </Border>
                            <TextBlock Text="Vytvořte první projekt" FontFamily="{StaticResource Font.Display}"
                                       FontSize="{StaticResource Size.Text.Title}" FontWeight="SemiBold" Margin="0,18,0,8" />
                            <TextBlock Text="Nemusíte nastavovat všechno najednou. Připravte návrh, vyberte materiál a před spuštěním zkontrolujte jeho umístění."
                                       Foreground="{StaticResource Brush.TextSecondary}" FontSize="{StaticResource Size.Text.Body}"
                                       TextWrapping="Wrap" MaxWidth="650" />

                            <StackPanel Orientation="Horizontal" Margin="0,20,0,24">
                                <Button Style="{StaticResource Button.Large}" Command="{Binding NewProjectCommand}" Margin="0,0,10,0">
                                    <components:IconLabel IconData="{StaticResource Glyph.New}" Text="Začít nový projekt" Foreground="White" />
                                </Button>
                                <Button Style="{StaticResource Button.Regular}" Command="{Binding OpenProjectCommand}">
                                    <components:IconLabel IconData="{StaticResource Glyph.Open}" Text="Otevřít existující" />
                                </Button>
                            </StackPanel>

                            <Border Height="1" Background="{StaticResource Brush.PanelBorder}" Margin="0,0,0,18" />
                            <TextBlock Text="Jak probíhá první gravírování" FontSize="{StaticResource Size.Text.Section}" FontWeight="SemiBold" Margin="0,0,0,12" />

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="34" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <Border Width="28" Height="28" CornerRadius="{StaticResource Radius.Pill}" Background="{StaticResource Brush.SelectedSurface}">
                                    <TextBlock Text="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource Brush.Accent}" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="10,0,16,0">
                                    <TextBlock Text="Vytvořte nebo importujte návrh" FontWeight="SemiBold" />
                                    <TextBlock Text="Text, tvar, SVG nebo obrázek." Style="{StaticResource Text.Muted}" Margin="0,3,0,0" />
                                </StackPanel>
                                <Button Grid.Column="2" Command="{Binding ShowDesignerCommand}" Padding="12,0">
                                    <TextBlock Text="Otevřít návrh" />
                                </Button>
                            </Grid>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="34" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <Border Width="28" Height="28" CornerRadius="{StaticResource Radius.Pill}" Background="{StaticResource Brush.Field}">
                                    <TextBlock Text="2" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="10,0,16,0">
                                    <TextBlock Text="Vyberte materiál a parametry" FontWeight="SemiBold" />
                                    <TextBlock Text="Použijte bezpečné doporučené hodnoty." Style="{StaticResource Text.Muted}" Margin="0,3,0,0" />
                                </StackPanel>
                                <Button Grid.Column="2" Click="OnMaterialsClick" Padding="12,0">
                                    <TextBlock Text="Vybrat materiál" />
                                </Button>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="34" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <Border Width="28" Height="28" CornerRadius="{StaticResource Radius.Pill}" Background="{StaticResource Brush.Field}">
                                    <TextBlock Text="3" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="10,0,16,0">
                                    <TextBlock Text="Připojte stroj a zkontrolujte umístění" FontWeight="SemiBold" />
                                    <TextBlock Text="Rámování ověří, kam se úloha vypálí." Style="{StaticResource Text.Muted}" Margin="0,3,0,0" />
                                </StackPanel>
                                <Button Grid.Column="2" Command="{Binding ShowDeviceCommand}" Padding="12,0">
                                    <TextBlock Text="Připojit stroj" />
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}"
                            Visibility="{Binding Home.HasRecentProjects, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <components:IconGlyph IconData="{StaticResource Glyph.Project}" Width="{StaticResource Size.Icon.Md}" Height="{StaticResource Size.Icon.Md}" Margin="0,0,9,0" />
                                    <TextBlock Text="Nedávné projekty" Style="{StaticResource PanelTitle}" Margin="0" />
                                </StackPanel>
                                <Button Grid.Column="1" Command="{Binding ShowDesignerCommand}" Content="Otevřít návrh" />
                            </Grid>
                            <ItemsControl ItemsSource="{Binding Home.RecentProjects}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <components:ProjectCard Width="176" Margin="0,0,12,12"
                                            OpenCommand="{Binding DataContext.Home.OpenRecentProjectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            RemoveCommand="{Binding DataContext.Home.RemoveRecentProjectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,16,0,0"
                            Visibility="{Binding Home.HasTodayJobs, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <components:IconGlyph IconData="{StaticResource Glyph.Check}" Width="{StaticResource Size.Icon.Md}" Height="{StaticResource Size.Icon.Md}" Margin="0,0,9,0" />
                                <TextBlock Text="Dnešní dokončené úlohy" Style="{StaticResource PanelTitle}" Margin="0" />
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding Home.TodayJobs}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <components:IconGlyph IconData="{StaticResource Glyph.Check}" Width="{StaticResource Size.Icon.Sm}" Height="{StaticResource Size.Icon.Sm}" Foreground="{StaticResource Brush.Success}" />
                                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding MaterialName}" Style="{StaticResource Text.Muted}" Visibility="{Binding MaterialName, Converter={StaticResource NotNullToVisibility}}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding CompletedUtc, Converter={StaticResource UtcToLocal}, StringFormat='HH:mm'}" Style="{StaticResource Text.Muted}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <components:DeviceCard Margin="0,0,0,16"
                        IsConnected="{Binding Home.Connection.IsConnected}"
                        StatusText="{Binding Home.Connection.StatusText}"
                        FirmwareBanner="{Binding Home.Connection.FirmwareBanner}"
                        WorkAreaWidthMm="{Binding Settings.Machine.WorkAreaWidthMm}"
                        WorkAreaHeightMm="{Binding Settings.Machine.WorkAreaHeightMm}"
                        OpenDesignerCommand="{Binding ShowDeviceCommand}" />

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <components:IconGlyph IconData="{StaticResource Glyph.Materials}" Width="{StaticResource Size.Icon.Md}" Height="{StaticResource Size.Icon.Md}" Margin="0,0,9,0" Foreground="{StaticResource Brush.Accent}" />
                                <TextBlock Text="Materiál" Style="{StaticResource PanelTitle}" Margin="0" />
                            </StackPanel>
                            <TextBlock Text="Doporučené parametry vám pomohou začít bezpečně. Před ostrou úlohou je vždy ověřte na odřezku."
                                       Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,0,0,14" />
                            <Button Click="OnMaterialsClick">
                                <components:IconLabel IconData="{StaticResource Glyph.Materials}" Text="Otevřít vzorník materiálů" />
                            </Button>

                            <ItemsControl ItemsSource="{Binding Home.RecentMaterials}" Margin="0,14,0,0"
                                          Visibility="{Binding Home.HasMaterials, Converter={StaticResource BoolToVisibility}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,10">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                            <TextBlock Style="{StaticResource Text.Muted}">
                                                <Run Text="{Binding UsageCount}" /><Run Text="× použito" />
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
