<UserControl x:Class="Lasero.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Lasero.App.Converters"
             xmlns:components="clr-namespace:Lasero.App.Components"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="860">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
        <conv:NotNullToVisibilityConverter x:Key="NotNullToVisibility" />
        <conv:UtcToLocalConverter x:Key="UtcToLocal" />
        <conv:ThumbnailPathToImageSourceConverter x:Key="ThumbnailToImage" />
        <conv:MachineDisplayStateToLabelConverter x:Key="MachineStateLabel" />
        <conv:MachineDisplayStateToBrushConverter x:Key="MachineStateBrush" />

        <Style x:Key="SectionHeading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource Size.Text.Section}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <!-- The mockup's step strip needs the three cards to share width exactly; a UniformGrid
             would also stretch the arrows between them, so the arrows sit in their own columns. -->
        <Style x:Key="StepArrow" TargetType="components:IconGlyph">
            <Setter Property="Width" Value="{StaticResource Size.Icon.Sm}" />
            <Setter Property="Height" Value="{StaticResource Size.Icon.Sm}" />
            <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="6,0" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="20,16,20,20" MaxWidth="1320" HorizontalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- HERO -->
            <!-- A panel surface, not a tinted one. On the dark theme the selected-surface token is a
                 deep blue, and a hero-sized block of it is exactly the large flat bright surface the
                 palette is meant to avoid; the accent belongs on the CTA inside it. -->
            <Border Grid.Row="0" CornerRadius="{StaticResource Radius.Lg}" Margin="0,0,0,22"
                    Background="{StaticResource Brush.Panel}"
                    BorderBrush="{StaticResource Brush.PanelBorder}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="380" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Margin="28,26,20,26" VerticalAlignment="Center">
                        <TextBlock Text="Vytvořte první projekt" Style="{StaticResource PageTitle}" />
                        <!-- Stretch plus MaxWidth centres a TextBlock in WPF, which put this paragraph
                             in the middle of the hero instead of under the heading. -->
                        <TextBlock Text="Začněte naplno. Navrhněte, nastavte materiál a pošlete svůj první návrh do laseru."
                                   Style="{StaticResource Text.Muted}" TextWrapping="Wrap" MaxWidth="440"
                                   HorizontalAlignment="Left" Margin="0,7,0,0" />

                        <StackPanel Orientation="Horizontal" Margin="0,20,0,0" HorizontalAlignment="Left">
                            <Button Style="{StaticResource Button.Large}" Command="{Binding NewProjectCommand}" Margin="0,0,10,0">
                                <components:IconLabel IconData="{StaticResource Glyph.New}" Text="Začít nový projekt" Foreground="White" />
                            </Button>
                            <Button Style="{StaticResource Button.LargeSecondary}" Command="{Binding OpenProjectCommand}" Margin="0,0,10,0">
                                <components:IconLabel IconData="{StaticResource Glyph.Open}" Text="Otevřít projekt" />
                            </Button>
                            <Button Style="{StaticResource Button.LargeSecondary}" Command="{Binding GCode.LoadFileCommand}"
                                    Padding="14,0">
                                <StackPanel Orientation="Horizontal">
                                    <components:IconGlyph IconData="{StaticResource Glyph.Import}"
                                                          Width="{StaticResource Size.Icon.Md}" Height="{StaticResource Size.Icon.Md}"
                                                          VerticalAlignment="Center" Margin="0,0,9,0" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Importovat" FontWeight="Medium" />
                                        <TextBlock Text="SVG / PNG / DXF" Style="{StaticResource Text.Muted}" />
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>

                    <!-- Stands in for the mockup's engraving photo. Drawn from the app's own icon set
                         so nothing here is a borrowed product shot; swap in an image when one exists. -->
                    <Border Grid.Column="1" Width="300" Margin="0,14,14,14"
                            CornerRadius="{StaticResource Radius.Md}"
                            Background="{StaticResource Brush.Canvas.Surround}"
                            BorderBrush="{StaticResource Brush.PanelBorder}" BorderThickness="1">
                        <Grid>
                            <components:IconGlyph IconData="{StaticResource Glyph.Device}" Width="{StaticResource Size.Icon.Hero}" Height="{StaticResource Size.Icon.Hero}"
                                                 Foreground="{StaticResource Brush.SelectedBorder}"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <TextBlock Text="Náhled gravírování" Style="{StaticResource Text.Muted}"
                                       HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,14" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- JAK ZAČÍT + STAV ZAŘÍZENÍ -->
            <Grid Grid.Row="1" Margin="0,0,0,22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="440" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="308" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Jak začít" Style="{StaticResource SectionHeading}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <components:StepCard StepNumber="1" Title="Navrhněte svůj design"
                                             Description="Vytvořte nebo importujte návrh v editoru."
                                             IconData="{StaticResource Glyph.Design}" />
                        <components:IconGlyph Grid.Column="1" Style="{StaticResource StepArrow}"
                                              IconData="{StaticResource Glyph.ArrowRight}" />
                        <components:StepCard Grid.Column="2" StepNumber="2" Title="Zvolte materiál"
                                             Description="Vyberte materiál a upravte parametry laseru."
                                             IconData="{StaticResource Glyph.Materials}" />
                        <components:IconGlyph Grid.Column="3" Style="{StaticResource StepArrow}"
                                              IconData="{StaticResource Glyph.ArrowRight}" />
                        <components:StepCard Grid.Column="4" StepNumber="3" Title="Rámování a kontrola"
                                             Description="Zkontrolujte rámování a náhled práce."
                                             IconData="{StaticResource Glyph.Frame}" />
                    </Grid>
                </StackPanel>

                <components:DeviceStatusCard Grid.Column="2" VerticalAlignment="Top"
                    IsConnected="{Binding Home.Connection.IsConnected}"
                    MachineName="{Binding Home.DeviceName}"
                    ConnectionLabel="{Binding Home.DeviceConnectionLabel}"
                    StatusLabel="{Binding Home.ConnectionBadgeLabel}"
                    FirmwareLabel="{Binding Home.FirmwareLabel}"
                    StateLabel="{Binding Home.MachineStatus.DisplayState, Converter={StaticResource MachineStateLabel}}"
                    StateBrush="{Binding Home.MachineStatus.DisplayState, Converter={StaticResource MachineStateBrush}}"
                    WorkAreaWidthMm="{Binding Settings.Machine.WorkAreaWidthMm}"
                    WorkAreaHeightMm="{Binding Settings.Machine.WorkAreaHeightMm}"
                    ConnectDeviceCommand="{Binding OpenDeviceWizardCommand}"
                    OpenMachineControlCommand="{Binding ShowDeviceCommand}" />
            </Grid>

            <!-- BEZPEČNOSTNÍ KONTROLA + NEDÁVNÉ PROJEKTY -->
            <Grid Grid.Row="2" Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" MinWidth="300" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="1.35*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}" VerticalAlignment="Top">
                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <components:IconGlyph IconData="{StaticResource Glyph.Warning}"
                                                      Width="{StaticResource Size.Icon.Md}" Height="{StaticResource Size.Icon.Md}"
                                                      Margin="0,0,8,0" />
                                <TextBlock Text="Bezpečnostní kontrola" Style="{StaticResource PanelTitle}" Margin="0" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding Home.Safety.Summary}" Style="{StaticResource Text.Muted}"
                                       VerticalAlignment="Center" />
                        </Grid>

                        <ItemsControl ItemsSource="{Binding Home.Safety.Items}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="26" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>

                                        <!-- The machine row is reported, the rest are ticked by hand. Two
                                             different controls, because a checkbox the operator cannot
                                             change would be a lie about who decided. -->
                                        <components:IconGlyph VerticalAlignment="Top" Margin="0,2,0,0"
                                                              Width="{StaticResource Size.Icon.Sm}" Height="{StaticResource Size.Icon.Sm}"
                                                              Visibility="{Binding IsManual, Converter={StaticResource InverseBoolToVisibility}}">
                                            <components:IconGlyph.Style>
                                                <Style TargetType="components:IconGlyph">
                                                    <Setter Property="IconData" Value="{StaticResource Glyph.Clock}" />
                                                    <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSatisfied}" Value="True">
                                                            <Setter Property="IconData" Value="{StaticResource Glyph.Check}" />
                                                            <Setter Property="Foreground" Value="{StaticResource Brush.Success}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </components:IconGlyph.Style>
                                        </components:IconGlyph>
                                        <CheckBox IsChecked="{Binding IsSatisfied}" VerticalAlignment="Top" Margin="0,1,0,0"
                                                  automation:AutomationProperties.Name="{Binding Title}"
                                                  Visibility="{Binding IsManual, Converter={StaticResource BoolToVisibility}}" />

                                        <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                            <TextBlock Text="{Binding Title}" FontWeight="Medium" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Muted}"
                                                       TextWrapping="Wrap" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button Command="{Binding ShowDeviceCommand}" HorizontalAlignment="Stretch" Margin="0,2,0,0"
                                Content="Zobrazit všechny kontroly" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <components:IconGlyph IconData="{StaticResource Glyph.Project}"
                                                      Width="{StaticResource Size.Icon.Md}" Height="{StaticResource Size.Icon.Md}"
                                                      Margin="0,0,8,0" />
                                <TextBlock Text="Nedávné projekty" Style="{StaticResource PanelTitle}" Margin="0" />
                            </StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource Button.Link}"
                                    Command="{Binding OpenProjectCommand}" Content="Otevřít vše" />
                        </Grid>

                        <StackPanel Visibility="{Binding Home.HasRecentProjects, Converter={StaticResource InverseBoolToVisibility}}"
                                    Margin="0,10,0,14">
                            <TextBlock Text="Zatím tu nic není" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock Text="Projekty, které uložíte, se objeví tady."
                                       Style="{StaticResource Text.Muted}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding Home.RecentProjectRows}"
                                      Visibility="{Binding Home.HasRecentProjects, Converter={StaticResource BoolToVisibility}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource Brush.PanelRaised}" CornerRadius="{StaticResource Radius.Md}"
                                            Padding="10" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Border Width="42" Height="42" CornerRadius="{StaticResource Radius.Sm}"
                                                    Background="{StaticResource Brush.Panel}"
                                                    BorderBrush="{StaticResource Brush.PanelBorder}" BorderThickness="1">
                                                <Grid>
                                                    <components:IconGlyph IconData="{StaticResource Glyph.Project}"
                                                                          Width="{StaticResource Size.Icon.Md}" Height="{StaticResource Size.Icon.Md}"
                                                                          Foreground="{StaticResource Brush.TextMuted}" />
                                                    <Image Source="{Binding ThumbnailPath, Converter={StaticResource ThumbnailToImage}}"
                                                           Stretch="UniformToFill"
                                                           Visibility="{Binding HasThumbnail, Converter={StaticResource BoolToVisibility}}" />
                                                </Grid>
                                            </Border>

                                            <StackPanel Grid.Column="1" Margin="12,0,10,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding ModifiedText}" Style="{StaticResource Text.Muted}"
                                                           Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>

                                            <TextBlock Grid.Column="2" Text="{Binding SizeText}" Style="{StaticResource Text.Muted}"
                                                       VerticalAlignment="Center" Margin="0,0,8,0" />

                                            <Button Grid.Column="3" Style="{StaticResource Button.Icon}" VerticalAlignment="Center"
                                                    Click="OnRecentProjectMenuClick"
                                                    Tag="{Binding DataContext.Home, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    automation:AutomationProperties.Name="Možnosti projektu">
                                                <Button.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="Otevřít projekt"
                                                                  Command="{Binding PlacementTarget.Tag.OpenRecentProjectCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  CommandParameter="{Binding Entry}" />
                                                        <MenuItem Header="Odebrat ze seznamu"
                                                                  Command="{Binding PlacementTarget.Tag.RemoveRecentProjectCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  CommandParameter="{Binding Entry}" />
                                                    </ContextMenu>
                                                </Button.ContextMenu>
                                                <components:IconGlyph IconData="{StaticResource Glyph.More}"
                                                                      Width="{StaticResource Size.Icon.Sm}" Height="{StaticResource Size.Icon.Sm}" />
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- TIP -->
            <Border Grid.Row="3" Background="{StaticResource Brush.Panel}"
                    BorderBrush="{StaticResource Brush.PanelBorder}" BorderThickness="1"
                    CornerRadius="{StaticResource Radius.Md}" Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <components:IconGlyph IconData="{StaticResource Glyph.Info}"
                                          Width="{StaticResource Size.Icon.Sm}" Height="{StaticResource Size.Icon.Sm}"
                                          Foreground="{StaticResource Brush.TextMuted}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock Grid.Column="1" VerticalAlignment="Center" TextWrapping="Wrap">
                        <Run Text="Tip:" FontWeight="SemiBold" />
                        <Run Text=" Použijte rámování pro přesné umístění návrhu na materiál." />
                    </TextBlock>
                    <Button Grid.Column="2" Style="{StaticResource Button.Link}" Click="OnHelpClick"
                            Content="Zobrazit nápovědu" />
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
