<UserControl x:Class="Lasero.App.Views.DeviceSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:components="clr-namespace:Lasero.App.Components"
             xmlns:conv="clr-namespace:Lasero.App.Converters"
             xmlns:jobs="clr-namespace:Lasero.Core.Jobs;assembly=Lasero.Core"
             xmlns:materials="clr-namespace:Lasero.Core.Materials;assembly=Lasero.Core"
             FontFamily="{StaticResource Font.Ui}" FontSize="{StaticResource Size.Text.Body}"
             Foreground="{StaticResource Brush.TextPrimary}">
    <UserControl.Resources>
        <conv:EnumEqualsVisibilityConverter x:Key="EnumEqualsVisibility" />

        <!--
            The pages of the Zařízení screen that are not the live machine: four of them, each a stack of titled
            groups, every setting one row with the label on the left and a compact value on the right. The tab strip
            is the screen's own (DeviceView) and this control shows the page it selects (Tab). All four pages edit
            one draft, which Uložit writes back and Zrušit throws away. Layout follows the device dialog people
            migrating from LightBurn already know; only the visual language is Lasero's.
        -->

        <!-- One setting: label (and an optional hint) left, compact value right. Spacing between rows is the
             row's own padding, so a group reads as a list without a divider between every pair. -->
        <Style TargetType="components:DeviceSettingsRow">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="MinHeight" Value="48" />
            <Setter Property="Padding" Value="0,8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="components:DeviceSettingsRow">
                        <Grid x:Name="Root" Margin="{TemplateBinding Padding}" >
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                <TextBlock Text="{TemplateBinding Header}" TextWrapping="Wrap" />
                                <TextBlock x:Name="HintText" Text="{TemplateBinding Hint}" TextWrapping="Wrap" Margin="0,4,0,0"
                                           Foreground="{StaticResource Brush.TextSecondary}" FontSize="{StaticResource Size.Text.Meta}" />
                            </StackPanel>
                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Hint" Value="{x:Null}">
                                <Setter TargetName="HintText" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="{StaticResource Opacity.Disabled}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsCard" TargetType="components:ElevatedBorder" BasedOn="{StaticResource InspectorSection}">
            <Setter Property="Padding" Value="24,12" />
        </Style>

        <Style x:Key="SettingsCardTitle" TargetType="TextBlock" BasedOn="{StaticResource Text.Heading}">
            <Setter Property="Margin" Value="0,4,0,4" />
        </Style>

        <Style x:Key="SettingsPageNote" TargetType="TextBlock" BasedOn="{StaticResource Text.Muted}">
            <Setter Property="FontSize" Value="{StaticResource Size.Text.Meta}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <Style x:Key="SettingsValueText" TargetType="TextBlock" BasedOn="{StaticResource Text.Numeric}">
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="MaxWidth" Value="320" />
        </Style>

        <Style x:Key="SettingsCombo" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Width" Value="192" />
            <Setter Property="MinHeight" Value="{StaticResource Size.Control.Compact}" />
            <Setter Property="Height" Value="{StaticResource Size.Control.Compact}" />
        </Style>

        <!-- The on/off control. These are device-wide behaviours (the machine either has air assist or it
             does not), which is the case a switch is for; per-object flags elsewhere stay checkboxes.
             ON is the one solid tint, state is also carried by the knob position. Plain setters rather than
             an animation so a switch that is already on when the window opens renders on. -->
        <Style x:Key="SettingsSwitch" TargetType="ToggleButton">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Background="Transparent" SnapsToDevicePixels="True">
                            <Border x:Name="FocusRing" Margin="-3" CornerRadius="{StaticResource Radius.Xs}"
                                    BorderBrush="{StaticResource Brush.FocusRing}" BorderThickness="0" />
                            <Border x:Name="Track" CornerRadius="{StaticResource Radius.Xs}"
                                    Background="{StaticResource Brush.ToggleTrackOff}"
                                    BorderBrush="{StaticResource Brush.ToggleTrackOffBorder}" BorderThickness="1" />
                            <Border x:Name="Knob" Width="12" Height="12" CornerRadius="2" HorizontalAlignment="Left" Margin="3,0,0,0"
                                    Background="{StaticResource Brush.OnAccent}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource Brush.TextSecondary}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource Brush.TextPrimary}" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource Brush.TextPrimary}" />
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Knob" Property="Margin" Value="0,0,3,0" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="IsChecked" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource Brush.TextPrimary}" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource Brush.TextPrimary}" />
                            </MultiTrigger>
                            <Trigger Property="components:FocusVisual.IsVisible" Value="True">
                                <Setter TargetName="FocusRing" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- The draft, the view model and the controller readout are this control's own, so the pages keep the bindings
         they had as a window; the control's inherited DataContext (the shell) is left alone for the host. -->
    <Grid x:Name="PageRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <!-- ===================== Rozměry / Jednotky ===================== -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                Visibility="{Binding Tab, Converter={StaticResource EnumEqualsVisibility}, ConverterParameter=Dimensions}">
                <StackPanel Margin="0,0,0,16" HorizontalAlignment="Left" MaxWidth="{StaticResource Layout.ReadingMaxWidth}">
                    <components:ElevatedBorder Style="{StaticResource SettingsCard}">
                        <StackPanel>
                            <TextBlock Text="Pracovní plocha" Style="{StaticResource SettingsCardTitle}" />
                            <components:DeviceSettingsRow Header="Šířka">
                                <components:NumericField Value="{Binding Draft.WorkAreaWidthMm, Mode=TwoWay}" Unit="mm" />
                            </components:DeviceSettingsRow>
                            <components:DeviceSettingsRow Header="Výška"
                                                    Hint="Po připojení se plocha načte z parametrů $130 a $131. Úloha mimo plochu se nespustí.">
                                <components:NumericField Value="{Binding Draft.WorkAreaHeightMm, Mode=TwoWay}" Unit="mm" />
                            </components:DeviceSettingsRow>
                        </StackPanel>
                    </components:ElevatedBorder>

                    <components:ElevatedBorder Style="{StaticResource SettingsCard}">
                        <StackPanel>
                            <TextBlock Text="Jednotky" Style="{StaticResource SettingsCardTitle}" />
                            <components:DeviceSettingsRow Header="Délka a souřadnice"
                                                    Hint="G-code se generuje v milimetrech (G21).">
                                <TextBlock Text="mm" Style="{StaticResource SettingsValueText}" />
                            </components:DeviceSettingsRow>
                            <components:DeviceSettingsRow Header="Rychlost"
                                                    Hint="Rychlost vrstev a ručního pohybu.">
                                <TextBlock Text="mm/min" Style="{StaticResource SettingsValueText}" />
                            </components:DeviceSettingsRow>
                        </StackPanel>
                    </components:ElevatedBorder>

                    <components:ElevatedBorder Style="{StaticResource SettingsCard}">
                        <StackPanel>
                            <TextBlock Text="Osa Z" Style="{StaticResource SettingsCardTitle}" />
                            <components:DeviceSettingsRow Header="Ovládání osy Z"
                                                    Hint="Zpřístupní ruční pohyb osy Z v ovládání stroje.">
                                <ToggleButton Style="{StaticResource SettingsSwitch}" IsChecked="{Binding Draft.EnableZAxis}" />
                            </components:DeviceSettingsRow>
                            <components:DeviceSettingsRow Header="Obrátit směr osy Z"
                                                    IsEnabled="{Binding Draft.EnableZAxis}">
                                <ToggleButton Style="{StaticResource SettingsSwitch}" IsChecked="{Binding Draft.InvertZAxis}" />
                            </components:DeviceSettingsRow>
                            <components:DeviceSettingsRow Header="Krok osy Z" IsEnabled="{Binding Draft.EnableZAxis}">
                                <components:NumericField Value="{Binding Draft.ZJogStepMm, Mode=TwoWay}" Unit="mm" />
                            </components:DeviceSettingsRow>
                            <components:DeviceSettingsRow Header="Rychlost osy Z" IsEnabled="{Binding Draft.EnableZAxis}">
                                <components:NumericField Value="{Binding Draft.ZJogFeedRateMmPerMinute, Mode=TwoWay}" Unit="mm/min" />
                            </components:DeviceSettingsRow>
                        </StackPanel>
                    </components:ElevatedBorder>
                </StackPanel>
            </ScrollViewer>

            <!-- ===================== Základní nastavení ===================== -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                Visibility="{Binding Tab, Converter={StaticResource EnumEqualsVisibility}, ConverterParameter=Basic}">
                <StackPanel Margin="0,0,0,16" HorizontalAlignment="Left" MaxWidth="{StaticResource Layout.ReadingMaxWidth}">
                    <components:ElevatedBorder Style="{StaticResource SettingsCard}">
                        <StackPanel>
                            <TextBlock Text="Laser" Style="{StaticResource SettingsCardTitle}" />
                            <components:DeviceSettingsRow Header="Technologie">
                                <ComboBox Style="{StaticResource SettingsCombo}"
                                          SelectedValue="{Binding Draft.LaserTechnology}" SelectedValuePath="Tag">
                                    <ComboBoxItem Content="Diodový laser" Tag="{x:Static materials:LaserTechnology.Diode}" />
                                    <ComboBoxItem Content="Infračervený laser" Tag="{x:Static materials:LaserTechnology.Infrared}" />
                                    <ComboBoxItem Content="CO₂ laser" Tag="{x:Static materials:LaserTechnology.Co2}" />
                                </ComboBox>
                            </components:DeviceSettingsRow>
                            <components:DeviceSettingsRow Header="Optický výkon"
                                                    Hint="Profil filtruje doporučené parametry ve vzorníku materiálů.">
                                <ComboBox Style="{StaticResource SettingsCombo}"
                                          ItemsSource="{Binding ViewModel.Materials.PowerClasses}"
                                          SelectedItem="{Binding Draft.LaserPowerWatts}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate><TextBlock Text="{Binding StringFormat={}{0} W}" /></DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </components:DeviceSettingsRow>
                            <components:DeviceSettingsRow Header="Maximální hodnota S"
                                                    Hint="Hodnota $30 z řadiče. Výkon v procentech se přepočítá na tento rozsah.">
                                <TextBlock Text="{Binding Readout.MaxSpindle}" Style="{StaticResource SettingsValueText}" />
                            </components:DeviceSettingsRow>
                            <components:DeviceSettingsRow Header="Laserový režim"
                                                    Hint="Hodnota $32 z řadiče. Bez zapnutého režimu se úloha nespustí.">
                                <TextBlock Text="{Binding Readout.LaserMode}" Style="{StaticResource SettingsValueText}" />
                            </components:DeviceSettingsRow>
                        </StackPanel>
                    </components:ElevatedBorder>

                    <components:ElevatedBorder Style="{StaticResource SettingsCard}">
                        <StackPanel>
                            <TextBlock Text="Rámování" Style="{StaticResource SettingsCardTitle}" />
                            <components:DeviceSettingsRow Header="Laser při rámování"
                                                    Hint="Výkon viditelné stopy. Hodnota 0 ponechá laser vypnutý, nejvýše 10 %.">
                                <components:NumericField Value="{Binding Draft.FramingPowerPercent, Mode=TwoWay}" Unit="%" />
                            </components:DeviceSettingsRow>
                            <components:DeviceSettingsRow Header="Vyžadovat rámování před spuštěním"
                                                    Hint="Spuštění zůstane nedostupné, dokud se umístění neověří.">
                                <ToggleButton Style="{StaticResource SettingsSwitch}" IsChecked="{Binding Draft.RequireFramingBeforeStart}" />
                            </components:DeviceSettingsRow>
                        </StackPanel>
                    </components:ElevatedBorder>

                    <components:ElevatedBorder Style="{StaticResource SettingsCard}">
                        <StackPanel>
                            <TextBlock Text="Během úlohy a po ní" Style="{StaticResource SettingsCardTitle}" />
                            <components:DeviceSettingsRow Header="Air assist"
                                                    Hint="M8 nebo M7 se odešle před úlohou, po ní se vypne (M9). M7 vyžaduje firmware s povolenou mlhou.">
                                <ComboBox Style="{StaticResource SettingsCombo}"
                                          SelectedValue="{Binding Draft.AirAssist}" SelectedValuePath="Tag">
                                    <ComboBoxItem Content="Vypnuto" Tag="{x:Static jobs:AirAssistMode.Off}" />
                                    <ComboBoxItem Content="M8 (výchozí v GRBL)" Tag="{x:Static jobs:AirAssistMode.M8}" />
                                    <ComboBoxItem Content="M7 (mlha)" Tag="{x:Static jobs:AirAssistMode.M7}" />
                                </ComboBox>
                            </components:DeviceSettingsRow>
                            <components:DeviceSettingsRow Header="Vrátit hlavu na výchozí pozici"
                                                    Hint="Po poslední dráze přejede vypnutý laser do bodu 0,0, při spuštění od aktuální polohy do výchozího bodu úlohy.">
                                <ToggleButton Style="{StaticResource SettingsSwitch}" IsChecked="{Binding Draft.ReturnToStartAfterJob}" />
                            </components:DeviceSettingsRow>
                        </StackPanel>
                    </components:ElevatedBorder>
                </StackPanel>
            </ScrollViewer>

            <!-- ===================== G-code ===================== -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                Visibility="{Binding Tab, Converter={StaticResource EnumEqualsVisibility}, ConverterParameter=GCode}">
                <StackPanel Margin="0,0,0,16" HorizontalAlignment="Left" MaxWidth="{StaticResource Layout.ReadingMaxWidth}">
                    <components:ElevatedBorder Style="{StaticResource SettingsCard}">
                        <StackPanel>
                            <TextBlock Text="Generovaný výstup" Style="{StaticResource SettingsCardTitle}" />
                            <components:DeviceSettingsRow Header="Jednotky">
                                <TextBlock Text="G21 (milimetry)" Style="{StaticResource SettingsValueText}" />
                            </components:DeviceSettingsRow>
                            <components:DeviceSettingsRow Header="Souřadnice">
                                <TextBlock Text="G90 (absolutní)" Style="{StaticResource SettingsValueText}" />
                            </components:DeviceSettingsRow>
                            <components:DeviceSettingsRow Header="Laser"
                                                    Hint="Dynamický výkon, laserový režim GRBL ($32=1) je podmínkou spuštění.">
                                <TextBlock Text="M4 S…" Style="{StaticResource SettingsValueText}" />
                            </components:DeviceSettingsRow>
                            <components:DeviceSettingsRow Header="Vypnutí laseru"
                                                    Hint="M5 po každé dráze a na konci úlohy, pohyb bez řezání vždy s vypnutým laserem.">
                                <TextBlock Text="M5" Style="{StaticResource SettingsValueText}" />
                            </components:DeviceSettingsRow>
                        </StackPanel>
                    </components:ElevatedBorder>

                    <components:ElevatedBorder Style="{StaticResource SettingsCard}">
                        <StackPanel>
                            <TextBlock Text="Začátek úlohy" Style="{StaticResource SettingsCardTitle}" />
                            <TextBlock Text="Řádky, kterými každá odeslaná úloha začíná. Air assist se mění v Základním nastavení."
                                       Style="{StaticResource SettingsPageNote}" />
                            <Border Background="{StaticResource Brush.Field}" CornerRadius="{StaticResource Radius.Md}"
                                    Padding="12,8" Margin="0,0,0,8">
                                <TextBlock Text="{Binding Draft.StartLinesPreview}" FontFamily="{StaticResource Font.Mono}"
                                           AutomationProperties.Name="Začátek úlohy" />
                            </Border>
                        </StackPanel>
                    </components:ElevatedBorder>

                    <components:ElevatedBorder Style="{StaticResource SettingsCard}">
                        <StackPanel>
                            <TextBlock Text="Konec úlohy" Style="{StaticResource SettingsCardTitle}" />
                            <TextBlock Text="Řádky, kterými každá odeslaná úloha končí. Návrat hlavy se mění v Základním nastavení, při spuštění od aktuální polohy se cílem stane výchozí bod úlohy."
                                       Style="{StaticResource SettingsPageNote}" />
                            <Border Background="{StaticResource Brush.Field}" CornerRadius="{StaticResource Radius.Md}"
                                    Padding="12,8" Margin="0,0,0,8">
                                <TextBlock Text="{Binding Draft.EndLinesPreview}" FontFamily="{StaticResource Font.Mono}"
                                           AutomationProperties.Name="Konec úlohy" />
                            </Border>
                        </StackPanel>
                    </components:ElevatedBorder>
                </StackPanel>
            </ScrollViewer>

            <!-- ===================== Další nastavení ===================== -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                Visibility="{Binding Tab, Converter={StaticResource EnumEqualsVisibility}, ConverterParameter=More}">
                <StackPanel Margin="0,0,0,16" HorizontalAlignment="Left" MaxWidth="{StaticResource Layout.ReadingMaxWidth}">
                    <components:ElevatedBorder Style="{StaticResource SettingsCard}">
                        <StackPanel>
                            <TextBlock Text="Ruční pohyb os X a Y" Style="{StaticResource SettingsCardTitle}" />
                            <components:DeviceSettingsRow Header="Krok">
                                <components:NumericField Value="{Binding Draft.JogStepMm, Mode=TwoWay}" Unit="mm" />
                            </components:DeviceSettingsRow>
                            <components:DeviceSettingsRow Header="Rychlost">
                                <components:NumericField Value="{Binding Draft.JogFeedRateMmPerMinute, Mode=TwoWay}" Unit="mm/min" />
                            </components:DeviceSettingsRow>
                        </StackPanel>
                    </components:ElevatedBorder>

                    <components:ElevatedBorder Style="{StaticResource SettingsCard}">
                        <StackPanel>
                            <TextBlock Text="Bezpečnost a chování" Style="{StaticResource SettingsCardTitle}" />
                            <components:DeviceSettingsRow Header="Potvrzovat softwarový reset stroje"
                                                    Hint="Reset zastaví probíhající pohyb a vyprázdní frontu příkazů.">
                                <ToggleButton Style="{StaticResource SettingsSwitch}" IsChecked="{Binding Draft.ConfirmSoftReset}" />
                            </components:DeviceSettingsRow>
                            <components:DeviceSettingsRow Header="Po připojení otevřít obrazovku zařízení">
                                <ToggleButton Style="{StaticResource SettingsSwitch}" IsChecked="{Binding Draft.ShowMachineStatusAfterConnect}" />
                            </components:DeviceSettingsRow>
                        </StackPanel>
                    </components:ElevatedBorder>

                    <components:ElevatedBorder Style="{StaticResource SettingsCard}">
                        <StackPanel>
                            <TextBlock Text="Zjištěné zařízení" Style="{StaticResource SettingsCardTitle}" />
                            <components:DeviceSettingsRow Header="Stav">
                                <TextBlock Text="{Binding ViewModel.Connection.StatusText}" Style="{StaticResource SettingsValueText}" />
                            </components:DeviceSettingsRow>
                            <components:DeviceSettingsRow Header="Profil">
                                <TextBlock Text="{Binding ViewModel.Connection.ActiveMachineName}" Style="{StaticResource SettingsValueText}" />
                            </components:DeviceSettingsRow>
                            <components:DeviceSettingsRow Header="Firmware">
                                <TextBlock Text="{Binding ViewModel.Connection.FirmwareBanner, TargetNullValue='Zjistí se po připojení'}" Style="{StaticResource SettingsValueText}" />
                            </components:DeviceSettingsRow>
                            <components:DeviceSettingsRow Header="Zdvih os X × Y" Hint="Hodnoty $130 a $131 z řadiče.">
                                <TextBlock Text="{Binding Readout.Travel}" Style="{StaticResource SettingsValueText}" />
                            </components:DeviceSettingsRow>
                        </StackPanel>
                    </components:ElevatedBorder>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Sticky: the pages scroll above it, Uložit and Zrušit never leave the bottom of the screen. -->
        <Border Grid.Row="1" Padding="0,12,0,0"
                Background="{DynamicResource Brush.Surface}"
                BorderBrush="{StaticResource Brush.PanelBorder}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock x:Name="SettingsErrorText" Foreground="{StaticResource Brush.Danger}" TextWrapping="Wrap"
                               AutomationProperties.LiveSetting="Polite" />
                    <TextBlock x:Name="SavedText" Text="Uloženo" Foreground="{StaticResource Brush.Success}" Visibility="Collapsed"
                               AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource Button.Outline}" Content="Zrušit" MinWidth="96" Height="{StaticResource Size.Control.Base}"
                            Margin="0,0,8,0" Click="OnCancelClick" ToolTip="Vrátit všechny změny na uložené hodnoty" />
                    <Button Style="{StaticResource Button.Primary}" MinWidth="112" Height="{StaticResource Size.Control.Base}" Click="OnSaveClick">
                        <components:IconLabel IconData="{StaticResource Glyph.Save}" Text="Uložit" Foreground="White" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
