<UserControl x:Class="Lasero.App.Views.ChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Lasero.App.ViewModels"
             xmlns:conv="clr-namespace:Lasero.App.Converters"
             xmlns:components="clr-namespace:Lasero.App.Components"
             Loaded="OnLoaded" Unloaded="OnUnloaded">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
        <conv:NotNullToVisibilityConverter x:Key="NullToVisibility" />

        <Style x:Key="ChatBubble" TargetType="Border">
            <Setter Property="Grid.Column" Value="1" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,56,20" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsUser}" Value="True">
                    <Setter Property="Grid.Column" Value="2" />
                    <Setter Property="HorizontalAlignment" Value="Right" />
                    <Setter Property="Background" Value="{DynamicResource Brush.SelectedSurface}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.SelectedBorder}" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="CornerRadius" Value="12,12,4,12" />
                    <Setter Property="Padding" Value="12,8" />
                    <Setter Property="Margin" Value="56,0,0,16" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <components:PageScaffold BodyScrolls="False">
        <components:PageScaffold.Header>
            <components:PageHeader Title="Chat"
                                   Subtitle="Dotazy na materiály, parametry a řešení problémů. Kamil zná vybraný materiál i připojený stroj." />
        </components:PageScaffold.Header>
        <components:PageScaffold.Body>
    <Border Style="{StaticResource Card}" Padding="0" components:RoundedClip.ToParentBorder="True">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Background="{DynamicResource Brush.Sidebar}" BorderBrush="{DynamicResource Brush.PanelBorder}"
                BorderThickness="0,0,1,0" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <components:SectionHeader Title="Historie" Level="Card">
                    <components:SectionHeader.Action>
                        <Button Width="32" Height="32"
                                Style="{StaticResource Button.Icon}" Command="{Binding Chat.NewChatCommand}"
                                ToolTip="Nová konverzace" AutomationProperties.Name="Nová konverzace">
                            <components:IconGlyph IconData="{StaticResource Glyph.New}" Width="{StaticResource Size.Icon.Sm}" Height="{StaticResource Size.Icon.Sm}" />
                        </Button>
                    </components:SectionHeader.Action>
                </components:SectionHeader>

                <Border Grid.Row="1" Height="1" Background="{DynamicResource Brush.PanelBorder}" Margin="0,0,0,8" />

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid>
                    <TextBlock Style="{StaticResource Text.EmptyLine}" Text="Zatím bez historie. Nová konverzace se uloží automaticky."
                               Visibility="{Binding Chat.HasSessions, Converter={StaticResource InverseBoolToVisibility}}" />
                    <ItemsControl ItemsSource="{Binding Chat.Sessions}"
                                  Visibility="{Binding Chat.HasSessions, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ChatSessionItem}">
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button Style="{StaticResource NavButton}" Padding="12,8" Margin="0"
                                            Command="{Binding DataContext.Chat.OpenChatCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" ToolTip="{Binding Title}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontWeight="Medium" />
                                            <TextBlock Text="{Binding UpdatedLabel}" Style="{StaticResource Text.Muted}" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Column="1" Width="32" Height="32" Padding="8" Margin="4,0,0,0"
                                            VerticalAlignment="Center" Style="{StaticResource Button.Icon}"
                                            Command="{Binding DataContext.Chat.DeleteChatCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" ToolTip="Odstranit konverzaci"
                                            AutomationProperties.Name="Odstranit konverzaci">
                                        <components:IconGlyph IconData="{StaticResource Glyph.Delete}" Width="{StaticResource Size.Icon.Sm}" Height="{StaticResource Size.Icon.Sm}" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </Grid>
                </ScrollViewer>

                <Border Grid.Row="3" Background="{DynamicResource Brush.Field}" CornerRadius="{StaticResource Radius.Md}" Padding="12" Margin="0,12,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Ellipse Width="7" Height="7" VerticalAlignment="Top" Margin="0,4,8,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{DynamicResource Brush.Success}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Chat.IsOffline}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource Brush.Warning}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Grid.Column="1" Text="{Binding Chat.AvailabilityText}" TextWrapping="Wrap" Style="{StaticResource Text.Muted}" />
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Column="1" Background="{DynamicResource Brush.Panel}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="64" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border BorderBrush="{DynamicResource Brush.PanelBorder}" BorderThickness="0,0,0,1" Padding="24,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <components:LaseroAvatar Size="40" Margin="0,0,12,0" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Kamil" FontSize="{StaticResource Size.Text.Section}" FontWeight="SemiBold" />
                            <TextBlock Text="Asistent pro materiály, parametry a řešení problémů" Style="{StaticResource Text.Muted}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="440" MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Grid}}"
                                Visibility="{Binding Chat.HasMessages, Converter={StaticResource InverseBoolToVisibility}}">
                        <components:LaseroAvatar Size="48" HorizontalAlignment="Center" />
                        <TextBlock Text="Co chcete na tomto návrhu upravit" FontSize="{StaticResource Size.Text.Section}" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,4" />
                        <TextBlock Text="Kamil poradí s materiálem, parametry i bezpečným testem."
                                   TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource Brush.TextSecondary}" LineHeight="20" />
                        <ItemsControl ItemsSource="{Binding Chat.SuggestedQuestions}" Margin="0,20,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding}" Margin="0,0,0,8" Padding="12,8" HorizontalContentAlignment="Left"
                                            Command="{Binding DataContext.Chat.UseSuggestionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <ScrollViewer x:Name="MessageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  ScrollChanged="OnMessageScrollChanged"
                                  Padding="24,20" Visibility="{Binding Chat.HasMessages, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl ItemsSource="{Binding Chat.Messages}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ChatMessageItem}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <components:LaseroAvatar Size="30" Margin="0,4,12,0" VerticalAlignment="Top"
                                                                  Visibility="{Binding IsUser, Converter={StaticResource InverseBoolToVisibility}}" />
                                        <Border Style="{StaticResource ChatBubble}" MaxWidth="720">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                    <TextBlock Text="{Binding Author}" FontWeight="SemiBold" FontSize="{StaticResource Size.Text.Meta}" />
                                                    <TextBlock Text="  ·  " Foreground="{DynamicResource Brush.PanelBorder}" />
                                                    <TextBlock Text="{Binding TimeLabel}" Style="{StaticResource Text.Muted}" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding DisplayText}" TextWrapping="Wrap" LineHeight="20" />
                                                <Button Style="{StaticResource Button.Link}" HorizontalAlignment="Left" Padding="0" Margin="0,8,0,0"
                                                        Visibility="{Binding IsUser, Converter={StaticResource InverseBoolToVisibility}}"
                                                        Tag="{Binding DisplayText}" Click="OnCopyMessage" ToolTip="Kopírovat odpověď"
                                                        AutomationProperties.Name="Kopírovat odpověď">
                                                    <StackPanel Orientation="Horizontal">
                                                        <components:IconGlyph IconData="{StaticResource Glyph.Copy}" Width="{StaticResource Size.Icon.Sm}" Height="{StaticResource Size.Icon.Sm}" Margin="0,0,4,0" />
                                                        <TextBlock Text="Kopírovat" />
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Button x:Name="ScrollToBottomButton" Width="32" Height="32" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                            Margin="0,0,36,20" Padding="8" Visibility="Collapsed" Style="{StaticResource Button.Icon}"
                            Click="OnScrollToBottom" ToolTip="Přejít na nejnovější zprávu" AutomationProperties.Name="Přejít na nejnovější zprávu">
                        <components:IconGlyph IconData="{StaticResource Glyph.ChevronDown}" Width="{StaticResource Size.Icon.Sm}" Height="{StaticResource Size.Icon.Sm}" />
                    </Button>

                    <Expander Grid.Row="1" Margin="24,0,24,16" Padding="12,8" IsExpanded="False"
                              Background="{StaticResource Brush.Field}"
                              Visibility="{Binding Chat.IsBusy, Converter={StaticResource BoolToVisibility}}">
                        <Expander.Header>
                            <StackPanel Orientation="Horizontal">
                                <components:LaseroAvatar Size="28" Margin="0,0,12,0" VerticalAlignment="Center" />
                                <TextBlock Text="Pracuji…" Style="{StaticResource Text.Muted}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Expander.Header>
                        <TextBlock Text="Kamil zpracovává požadavek. Zobrazuji jen uživatelsky relevantní stav, ne interní uvažování."
                                   TextWrapping="Wrap" Style="{StaticResource Text.Muted}" Margin="0,4,0,4" />
                    </Expander>
                </Grid>

                <Border Grid.Row="2" BorderBrush="{DynamicResource Brush.PanelBorder}" BorderThickness="0,1,0,0" Padding="24,16">
                    <StackPanel>
                        <Border Visibility="{Binding Chat.StatusMessage, Converter={StaticResource NullToVisibility}}"
                                Background="{DynamicResource Brush.PanelRaised}" BorderBrush="{DynamicResource Brush.PanelBorderStrong}"
                                BorderThickness="1" CornerRadius="{StaticResource Radius.Md}" Padding="12,8" Margin="0,0,0,12">
                            <TextBlock Text="{Binding Chat.StatusMessage}" TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextPrimary}" />
                        </Border>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="ChatInput" Text="{Binding Chat.Input, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True" TextWrapping="Wrap" MinHeight="44" MaxHeight="120"
                                     MaxLength="4000"
                                     Padding="12,12" VerticalContentAlignment="Center" KeyDown="OnInputKeyDown"
                                     ToolTip="Enter odešle, Shift+Enter vloží nový řádek"
                                     AutomationProperties.Name="Zpráva pro Lasero Chat" />
                            <Button Grid.Column="1" Width="44" Height="44" Margin="12,0,0,0" Padding="12"
                                    Style="{StaticResource Button.Primary}"
                                    Command="{Binding Chat.SendCommand}"
                                    ToolTip="Odeslat zprávu" AutomationProperties.Name="Odeslat zprávu">
                                <components:IconGlyph IconData="{StaticResource Glyph.Send}" Foreground="White" Width="{StaticResource Size.Icon.Md}" Height="{StaticResource Size.Icon.Md}" />
                            </Button>
                        </Grid>
                        <TextBlock Text="Enter odešle · Shift+Enter nový řádek" Style="{StaticResource Text.Muted}" Margin="4,8,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
    </Border>
        </components:PageScaffold.Body>
    </components:PageScaffold>
</UserControl>
