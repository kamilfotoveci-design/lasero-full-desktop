<UserControl x:Class="Lasero.App.Views.ChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Lasero.App.ViewModels"
             xmlns:input="clr-namespace:Lasero.App.Input"
             xmlns:conv="clr-namespace:Lasero.App.Converters"
             xmlns:components="clr-namespace:Lasero.App.Components"
             xmlns:kamil="clr-namespace:Lasero.App.Views.Kamil"
             Loaded="OnLoaded" Unloaded="OnUnloaded">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
        <conv:NotNullToVisibilityConverter x:Key="NullToVisibility" />

    </UserControl.Resources>

    <components:PageScaffold BodyScrolls="False">
        <components:PageScaffold.Header>
            <components:PageHeader Title="Chat"
                                   Subtitle="Dotazy na materiály, parametry a řešení problémů. Kamil zná vybraný materiál i připojený stroj." />
        </components:PageScaffold.Header>
        <components:PageScaffold.Body>
    <Border Style="{StaticResource Card}" Padding="0" components:RoundedClip.ToParentBorder="True">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Background="{DynamicResource Brush.Sidebar}" BorderBrush="{DynamicResource Brush.PanelBorder}"
                BorderThickness="0,0,1,0" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <components:SectionHeader Title="Historie" Level="Card">
                    <components:SectionHeader.Action>
                        <Button Width="32" Height="32"
                                Style="{StaticResource Button.Icon}" Command="{Binding Chat.NewChatCommand}"
                                ToolTip="Nová konverzace" AutomationProperties.Name="Nová konverzace">
                            <components:IconGlyph IconData="{StaticResource Glyph.New}" Width="{StaticResource Size.Icon.Sm}" Height="{StaticResource Size.Icon.Sm}" />
                        </Button>
                    </components:SectionHeader.Action>
                </components:SectionHeader>

                <Border Grid.Row="1" Height="1" Background="{DynamicResource Brush.PanelBorder}" Margin="0,0,0,8" />

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid>
                    <TextBlock Style="{StaticResource Text.EmptyLine}" Text="Zatím bez historie. Nová konverzace se uloží automaticky."
                               Visibility="{Binding Chat.HasSessions, Converter={StaticResource InverseBoolToVisibility}}" />
                    <ItemsControl ItemsSource="{Binding Chat.Sessions}"
                                  Visibility="{Binding Chat.HasSessions, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ChatSessionItem}">
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button Style="{StaticResource NavButton}" Padding="12,8" Margin="0"
                                            Command="{Binding DataContext.Chat.OpenChatCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" ToolTip="{Binding Title}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontWeight="Medium" />
                                            <TextBlock Text="{Binding UpdatedLabel}" Style="{StaticResource Text.Muted}" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Column="1" Width="32" Height="32" Padding="8" Margin="4,0,0,0"
                                            VerticalAlignment="Center" Style="{StaticResource Button.Icon}"
                                            Command="{Binding DataContext.Chat.DeleteChatCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" ToolTip="Odstranit konverzaci"
                                            AutomationProperties.Name="Odstranit konverzaci">
                                        <components:IconGlyph IconData="{StaticResource Glyph.Delete}" Width="{StaticResource Size.Icon.Sm}" Height="{StaticResource Size.Icon.Sm}" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </Grid>
                </ScrollViewer>

                <Border Grid.Row="3" Background="{DynamicResource Brush.Field}" CornerRadius="{StaticResource Radius.Md}" Padding="12" Margin="0,12,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Ellipse Width="7" Height="7" VerticalAlignment="Top" Margin="0,4,8,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{DynamicResource Brush.Success}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Chat.IsOffline}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource Brush.Warning}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Grid.Column="1" Text="{Binding Chat.AvailabilityText}" TextWrapping="Wrap" Style="{StaticResource Text.Muted}" />
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Column="1" Background="{DynamicResource Brush.Panel}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border BorderBrush="{DynamicResource Brush.PanelBorder}" BorderThickness="0,0,0,1" Padding="24,12">
                    <StackPanel Orientation="Horizontal">
                        <components:LaseroAvatar Size="32" Margin="0,0,12,0" VerticalAlignment="Center" />
                        <TextBlock Text="Kamil" VerticalAlignment="Center" FontWeight="SemiBold"
                                   FontSize="{StaticResource Size.Text.Section}" />
                    </StackPanel>
                </Border>

                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Empty state: who Kamil is and three ways to start. -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False"
                                  Visibility="{Binding Chat.HasMessages, Converter={StaticResource InverseBoolToVisibility}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="440" Margin="0,16" MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Grid}}">
                        <components:LaseroAvatar Size="48" HorizontalAlignment="Center" />
                        <TextBlock Text="Co je na tomto návrhu potřeba upravit" FontSize="{StaticResource Size.Text.Section}" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,4" />
                        <TextBlock Text="Kamil poradí s materiálem, parametry i bezpečným testem."
                                   Style="{StaticResource Kamil.MessageText}" TextAlignment="Center"
                                   Foreground="{DynamicResource Brush.TextSecondary}" />
                        <ItemsControl ItemsSource="{Binding Chat.SuggestedQuestions}" Margin="0,24,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding}" Margin="0,0,0,8" Padding="12,8" HorizontalContentAlignment="Left"
                                            Command="{Binding DataContext.Chat.UseSuggestionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    </ScrollViewer>

                    <!-- The conversation, at a reading measure and centred in the page. Right: the
                         operator's words in a raised bubble. Left: Kamil, plain text and a static portrait. -->
                    <ScrollViewer x:Name="MessageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  ScrollChanged="OnMessageScrollChanged"
                                  Padding="24,24,24,8" Visibility="{Binding Chat.HasMessages, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl ItemsSource="{Binding Chat.Messages}" MaxWidth="{StaticResource Size.Chat.Measure}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ChatMessageItem}">
                                    <Grid x:Name="MessageRow" Background="Transparent" Margin="0,0,0,24" ToolTip="{Binding TimeLabel}" input:MessageEntrance.IsEnabled="True">
                                        <Border HorizontalAlignment="Right" Margin="56,0,0,0" Padding="16,8"
                                                Background="{DynamicResource Brush.PanelRaised}"
                                                CornerRadius="{StaticResource Radius.Lg}"
                                                Visibility="{Binding IsUser, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="{Binding DisplayText}" Style="{StaticResource Kamil.MessageText}" />
                                        </Border>

                                        <Grid Margin="0,0,56,0"
                                              Visibility="{Binding IsUser, Converter={StaticResource InverseBoolToVisibility}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <components:LaseroAvatar Size="28" Margin="0,0,12,0" VerticalAlignment="Top" />
                                            <StackPanel Grid.Column="1">
                                                <kamil:KamilMessageBody Text="{Binding DisplayText}" />
                                                <Button Style="{StaticResource Button.Link}" HorizontalAlignment="Left"
                                                        Margin="0,4,0,0" Padding="0,0,8,0"
                                                        MinHeight="{StaticResource Size.Control.Assistant.Chip}"
                                                        Content="{Binding ToggleLabel}" Command="{Binding ToggleExpandedCommand}"
                                                        Visibility="{Binding HasMore, Converter={StaticResource BoolToVisibility}}" />
                                                <!-- Message actions belong to the row, not to the page: they appear while the
                                                     pointer is over the message or keyboard focus is inside them. -->
                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Setter Property="Opacity" Value="0" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsMouseOver, ElementName=MessageRow}" Value="True">
                                                                    <Setter Property="Opacity" Value="1" />
                                                                </DataTrigger>
                                                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                                    <Setter Property="Opacity" Value="1" />
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>
                                                    <Button Style="{StaticResource Button.Link}" HorizontalAlignment="Left" Padding="0,0,8,0"
                                                            MinHeight="{StaticResource Size.Control.Assistant.Chip}"
                                                            Tag="{Binding Text}" Click="OnCopyMessage" ToolTip="Kopírovat celou odpověď"
                                                            AutomationProperties.Name="Kopírovat celou odpověď">
                                                        <StackPanel Orientation="Horizontal">
                                                            <components:IconGlyph IconData="{StaticResource Glyph.Copy}" Width="{StaticResource Size.Icon.Sm}" Height="{StaticResource Size.Icon.Sm}" Margin="0,0,4,0" />
                                                            <TextBlock Text="Kopírovat" />
                                                        </StackPanel>
                                                    </Button>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Button x:Name="ScrollToBottomButton" Width="32" Height="32" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                            Margin="0,0,36,8" Padding="8" Visibility="Collapsed" Style="{StaticResource Button.Icon}"
                            Click="OnScrollToBottom" ToolTip="Přejít na nejnovější zprávu" AutomationProperties.Name="Přejít na nejnovější zprávu">
                        <components:IconGlyph IconData="{StaticResource Glyph.ChevronDown}" Width="{StaticResource Size.Icon.Sm}" Height="{StaticResource Size.Icon.Sm}" />
                    </Button>

                    <!-- Progress, and nothing more: the request cannot report how far along it is. -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="24,0,24,8"
                                HorizontalAlignment="Center" MaxWidth="{StaticResource Size.Chat.Measure}"
                                Visibility="{Binding Chat.IsBusy, Converter={StaticResource BoolToVisibility}}">
                        <components:LaseroAvatar Size="28" Margin="0,0,12,0" VerticalAlignment="Center" />
                        <TextBlock Text="Kamil odpovídá…" Style="{StaticResource Kamil.MetaText}" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <Border Grid.Row="2" Padding="24,8,24,16">
                    <StackPanel MaxWidth="{StaticResource Size.Chat.Measure}">
                        <!-- Failures stay beside the composer, where the operator is looking. -->
                        <Border Visibility="{Binding Chat.StatusMessage, Converter={StaticResource NullToVisibility}}"
                                Background="{DynamicResource Brush.WarningMuted}"
                                CornerRadius="{StaticResource Radius.Sm}" Padding="12,8" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <components:IconGlyph IconData="{StaticResource Glyph.Warning}"
                                                      Width="{StaticResource Size.Icon.Sm}" Height="{StaticResource Size.Icon.Sm}"
                                                      Foreground="{DynamicResource Brush.Warning}"
                                                      VerticalAlignment="Top" Margin="0,4,8,0" />
                                <TextBlock Grid.Column="1" Text="{Binding Chat.StatusMessage}" TextWrapping="Wrap"
                                           Foreground="{DynamicResource Brush.TextPrimary}" />
                            </Grid>
                        </Border>
                        <kamil:KamilComposer x:Name="ChatComposer" Placeholder="Zpráva pro Kamila…" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
    </Border>
        </components:PageScaffold.Body>
    </components:PageScaffold>
</UserControl>
