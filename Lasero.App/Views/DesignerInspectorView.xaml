<UserControl x:Class="Lasero.App.Views.DesignerInspectorView"
             x:Name="InspectorRoot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             xmlns:conv="clr-namespace:Lasero.App.Converters"
             xmlns:components="clr-namespace:Lasero.App.Components"
             xmlns:views="clr-namespace:Lasero.App.Views"
             xmlns:layers="clr-namespace:Lasero.Core.Layers;assembly=Lasero.Core"
             MinWidth="360">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:EnumToBooleanConverter x:Key="EnumToBool" />
        <conv:NotNullToVisibilityConverter x:Key="NotNullToVisibility" />
        <conv:RgbColorToBrushConverter x:Key="RgbColorToBrush" />
        <conv:IndexToLayerNumberConverter x:Key="IndexToLayerNumber" />
        <Style x:Key="InspectorField" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Height" Value="38" />
            <Setter Property="MinWidth" Value="56" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="InspectorLabel" TargetType="TextBlock" BasedOn="{StaticResource Text.Muted}">
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style x:Key="InspectorModeSegment" TargetType="RadioButton" BasedOn="{StaticResource Segment}">
            <Setter Property="Height" Value="36" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

    </UserControl.Resources>

    <Border Background="{StaticResource Brush.Panel}"
            BorderBrush="{StaticResource Brush.PanelBorder}"
            BorderThickness="1,0,0,0"
            CornerRadius="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Padding="16,14" BorderBrush="{StaticResource Brush.PanelBorder}" BorderThickness="0,0,0,1">
                <Border Style="{StaticResource SegmentedTrack}" Padding="3">
                    <UniformGrid Columns="2">
                        <RadioButton x:Name="LayersTabRadio"
                                     IsChecked="True"
                                     Style="{StaticResource InspectorModeSegment}"
                                     GroupName="InspectorTab">
                            <components:IconLabel IconData="{StaticResource Glyph.Materials}" Text="Vrstvy" IconSize="16" TextMargin="7,0,0,0" />
                        </RadioButton>
                        <RadioButton x:Name="MachineTabRadio"
                                     Style="{StaticResource InspectorModeSegment}"
                                     GroupName="InspectorTab">
                            <components:IconLabel IconData="{StaticResource Glyph.Device}" Text="Stroj" IconSize="16" TextMargin="7,0,0,0" />
                        </RadioButton>
                    </UniformGrid>
                </Border>
            </Border>

            <Grid Grid.Row="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Visibility="{Binding IsChecked, ElementName=LayersTabRadio, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Margin="16">
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <!-- WPF Grid does not clip children, so this subtitle used to render at its
                                 full desired width straight underneath the button in the next column and
                                 got painted over mid-word. Wrapping keeps the whole sentence readable at
                                 any panel width. -->
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="Vrstvy zpracování" Style="{StaticResource PanelTitle}" Margin="0,0,0,3" />
                                <TextBlock Text="Každá barva má vlastní způsob a sílu laseru." Style="{StaticResource Text.Muted}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Grid.Column="1" Command="{Binding Scene.AddLayerCommand}" VerticalAlignment="Top" Padding="13,0"
                                    ToolTip="Přidat novou prázdnou vrstvu">
                                <components:IconLabel IconData="{StaticResource Glyph.New}" Text="Nová vrstva" IconSize="14" />
                            </Button>
                        </Grid>

                        <Grid Margin="6,0,8,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30" />
                                <ColumnDefinition Width="7" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="46" />
                                <ColumnDefinition Width="46" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="#" Style="{StaticResource Text.Muted}" HorizontalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="Vrstva a nastavení" Style="{StaticResource Text.Muted}" Margin="10,0,0,0" />
                            <TextBlock Grid.Column="3" Text="Výstup" Style="{StaticResource Text.Muted}" HorizontalAlignment="Center" />
                            <TextBlock Grid.Column="4" Text="Vidět" Style="{StaticResource Text.Muted}" HorizontalAlignment="Center" />
                        </Grid>

                        <ListBox x:Name="LayersList"
                                 ItemsSource="{Binding GCode.Layers}"
                                 SelectedItem="{Binding Scene.SelectedLayer, Mode=TwoWay}"
                                 AlternationCount="1000"
                                 MaxHeight="320"
                                 BorderBrush="{StaticResource Brush.PanelBorder}"
                                 BorderThickness="1"
                                 Background="{StaticResource Brush.Field}"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="BorderBrush" Value="{StaticResource Brush.PanelBorder}" />
                                    <Setter Property="BorderThickness" Value="0,0,0,1" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="LayerRow"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="LayerRow" Property="Background" Value="{StaticResource Brush.WarmAccentMuted}" />
                                                    </Trigger>
                                                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                        <Setter TargetName="LayerRow" Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid MinHeight="50">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="30" />
                                            <ColumnDefinition Width="7" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="46" />
                                            <ColumnDefinition Width="46" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ListBoxItem}, Converter={StaticResource IndexToLayerNumber}}"
                                                   VerticalAlignment="Center" HorizontalAlignment="Center" FontFamily="{StaticResource Font.Mono}"
                                                   FontSize="11" Foreground="{StaticResource Brush.TextSecondary}" />
                                        <Border Grid.Column="1" Background="{Binding Color, Converter={StaticResource RgbColorToBrush}}" />
                                        <StackPanel Grid.Column="2" Margin="10,7" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="14" Height="14" CornerRadius="3"
                                                        Background="{Binding Color, Converter={StaticResource RgbColorToBrush}}"
                                                        BorderBrush="{StaticResource Brush.PanelBorder}" BorderThickness="1" Margin="0,0,7,0" />
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding ProcessingSummary}" Style="{StaticResource Text.Muted}"
                                                       FontSize="12" Margin="21,3,0,0" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <CheckBox Grid.Column="3" IsChecked="{Binding IsEnabled}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  ToolTip="Zapnout nebo vypnout zpracování této vrstvy" automation:AutomationProperties.Name="Zpracovat vrstvu" />
                                        <CheckBox Grid.Column="4" IsChecked="{Binding IsVisible}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  ToolTip="Zobrazit nebo skrýt vrstvu na plátně" automation:AutomationProperties.Name="Zobrazit vrstvu" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                            <Button Command="{Binding Scene.MoveSelectedLayerUpCommand}" Height="36" Padding="11,0" Margin="0,0,6,0"
                                    ToolTip="Posunout vrstvu výše ve výrobním pořadí"
                                    automation:AutomationProperties.Name="Posunout vrstvu nahoru">
                                <components:IconLabel IconData="{StaticResource Glyph.ArrowUp}" Text="Výše" IconSize="13" />
                            </Button>
                            <Button Command="{Binding Scene.MoveSelectedLayerDownCommand}" Height="36" Padding="11,0"
                                    ToolTip="Posunout vrstvu níže ve výrobním pořadí"
                                    automation:AutomationProperties.Name="Posunout vrstvu dolů">
                                <components:IconLabel IconData="{StaticResource Glyph.ArrowDown}" Text="Níže" IconSize="13" />
                            </Button>
                        </StackPanel>

                        <Border Background="{StaticResource Brush.Field}"
                                BorderBrush="{StaticResource Brush.PanelBorder}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16"
                                Margin="0,14,0,0"
                                Visibility="{Binding DataContext.Scene.SelectedLayer, ElementName=InspectorRoot, Converter={StaticResource NotNullToVisibility}}"
                                DataContext="{Binding DataContext.Scene.SelectedLayer, ElementName=InspectorRoot}">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="34" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Border Width="28" Height="28" CornerRadius="6"
                                            Background="{Binding Color, Converter={StaticResource RgbColorToBrush}}"
                                            BorderBrush="{StaticResource Brush.PanelBorder}" BorderThickness="1" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" FontWeight="SemiBold" Height="36"
                                                 ToolTip="Upravit název vrstvy" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="Způsob zpracování"
                                           Style="{StaticResource InspectorLabel}"
                                           Margin="0,10,0,5" />
                                <Border Style="{StaticResource SegmentedTrack}"
                                        IsEnabled="{Binding IsEnabled}">
                                    <UniformGrid Columns="3">
                                        <RadioButton Content="Čára"
                                                     GroupName="LayerProcessingMode"
                                                     Style="{StaticResource Segment}"
                                                     IsChecked="{Binding Mode, Converter={StaticResource EnumToBool}, ConverterParameter=Cut, Mode=TwoWay}"
                                                     ToolTip="Laser sleduje obrys vektoru. Vhodné pro řezání a liniové gravírování."
                                                     automation:AutomationProperties.Name="Zpracovat vrstvu jako čáru" />
                                        <RadioButton Content="Výplň"
                                                     GroupName="LayerProcessingMode"
                                                     Style="{StaticResource Segment}"
                                                     IsChecked="{Binding Mode, Converter={StaticResource EnumToBool}, ConverterParameter=Fill, Mode=TwoWay}"
                                                     ToolTip="Laser vyplní vnitřní plochu vektoru řádky. Vhodné pro plné gravírování."
                                                     automation:AutomationProperties.Name="Zpracovat vrstvu jako výplň" />
                                        <RadioButton Content="Výplň + čára"
                                                     GroupName="LayerProcessingMode"
                                                     Style="{StaticResource Segment}"
                                                     IsChecked="{Binding Mode, Converter={StaticResource EnumToBool}, ConverterParameter=FillAndCut, Mode=TwoWay}"
                                                     ToolTip="Laser nejdřív vyplní plochu a potom projede její obrys."
                                                     automation:AutomationProperties.Name="Zpracovat vrstvu jako výplň a obrys" />
                                    </UniformGrid>
                                </Border>
                                <TextBlock Margin="0,6,0,10"
                                           TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Muted}">
                                            <Setter Property="Text" Value="Laser pojede po obrysu vektoru." />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Mode}" Value="{x:Static layers:LayerMode.Fill}">
                                                    <Setter Property="Text" Value="Laser vyplní uzavřenou plochu řádky." />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Mode}" Value="{x:Static layers:LayerMode.FillAndCut}">
                                                    <Setter Property="Text" Value="Laser nejdřív vyplní plochu a potom projede její obrys." />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <Grid IsEnabled="{Binding IsEnabled}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="72" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Rychlost (mm/min)" Style="{StaticResource InspectorLabel}" />
                                        <TextBox Style="{StaticResource InspectorField}" Text="{Binding Speed, StringFormat=0}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Výkon (%)" Style="{StaticResource InspectorLabel}" />
                                        <TextBox Style="{StaticResource InspectorField}" Text="{Binding Power, StringFormat=0}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="Průchody" Style="{StaticResource InspectorLabel}" />
                                        <TextBox Style="{StaticResource InspectorField}" Text="{Binding Passes, StringFormat=0}" />
                                    </StackPanel>
                                </Grid>

                                <StackPanel Margin="0,10,0,0" IsEnabled="{Binding IsEnabled}">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Mode}" Value="{x:Static layers:LayerMode.Fill}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Mode}" Value="{x:Static layers:LayerMode.FillAndCut}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <Button HorizontalAlignment="Stretch"
                                            Padding="14,0"
                                            Height="38"
                                            Tag="{Binding}"
                                            Click="OnApplyMaterialClick"
                                            ToolTip="Vybrat ověřené parametry materiálu">
                                        <components:IconLabel IconData="{StaticResource Glyph.Materials}"
                                                              Text="Doporučené parametry"
                                                              IconSize="15" />
                                    </Button>
                                    <Expander Header="Pokročilé nastavení výplně" Margin="0,8,0,0">
                                        <StackPanel Margin="0,8,0,0">
                                            <TextBlock Text="Rozestup řádků (mm)" Style="{StaticResource InspectorLabel}" />
                                            <TextBox Style="{StaticResource InspectorField}"
                                                     Text="{Binding FillLineIntervalMm, UpdateSourceTrigger=LostFocus, StringFormat=0.###}"
                                                     ToolTip="Menší rozestup znamená jemnější gravírování a delší čas." />
                                            <TextBlock Text="Menší hodnota vytvoří jemnější výplň, ale prodlouží dobu gravírování."
                                                       Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,6,0,0" />
                                        </StackPanel>
                                    </Expander>
                                </StackPanel>

                                <Border Height="1" Background="{StaticResource Brush.PanelBorder}" Margin="0,12,0,10" />
                                <Button Command="{Binding DataContext.Scene.DeleteSelectedLayerCommand, ElementName=InspectorRoot}"
                                        Foreground="{StaticResource Brush.Danger}" HorizontalAlignment="Left"
                                        ToolTip="Odstranit lze pouze vrstvu, kterou nepoužívá žádný objekt">
                                    <components:IconLabel IconData="{StaticResource Glyph.Delete}" Text="Odstranit prázdnou vrstvu" IconSize="14" />
                                </Button>
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource Brush.Field}"
                                BorderBrush="{StaticResource Brush.PanelBorder}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="18"
                                Margin="0,2,0,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ElementName=LayersList, Path=HasItems}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel HorizontalAlignment="Center" MaxWidth="230">
                                <components:IconGlyph IconData="{StaticResource Glyph.Materials}" Width="24" Height="24" HorizontalAlignment="Center" Foreground="{DynamicResource Brush.TextSecondary}" />
                                <TextBlock Text="Projekt zatím nemá vrstvy"
                                           FontWeight="SemiBold"
                                           TextAlignment="Center"
                                           Margin="0,10,0,5" />
                                <TextBlock Text="Importujte obrázek nebo SVG. Vrstva se vytvoří automaticky."
                                           Style="{StaticResource Text.Muted}"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap" Margin="0,0,0,12" />
                                <Button Command="{Binding GCode.LoadFileCommand}" Height="38" Padding="14,0">
                                    <components:IconLabel IconData="{StaticResource Glyph.Import}" Text="Importovat grafiku" IconSize="15" />
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <views:MachinePanelView Margin="12,10,12,8"
                                        Visibility="{Binding IsChecked, ElementName=MachineTabRadio, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
