<UserControl x:Class="Lasero.App.Views.DesignerInspectorView"
             x:Name="InspectorRoot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             xmlns:conv="clr-namespace:Lasero.App.Converters"
             xmlns:components="clr-namespace:Lasero.App.Components"
             xmlns:views="clr-namespace:Lasero.App.Views"
             xmlns:layers="clr-namespace:Lasero.Core.Layers;assembly=Lasero.Core"
             MinWidth="320">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
        <conv:EnumToBooleanConverter x:Key="EnumToBool" />
        <conv:NotNullToVisibilityConverter x:Key="NotNullToVisibility" />
        <conv:RgbColorToBrushConverter x:Key="RgbColorToBrush" />
        <conv:IndexToLayerNumberConverter x:Key="IndexToLayerNumber" />
        <Style x:Key="InspectorField" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Height" Value="38" />
            <Setter Property="MinWidth" Value="56" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="InspectorLabel" TargetType="TextBlock" BasedOn="{StaticResource Text.Muted}">
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style x:Key="InspectorModeSegment" TargetType="RadioButton" BasedOn="{StaticResource Segment}">
            <Setter Property="Height" Value="36" />
            <Setter Property="FontSize" Value="{StaticResource Size.Text.Body}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

    </UserControl.Resources>

    <Border Background="{StaticResource Brush.Panel}"
            BorderBrush="{StaticResource Brush.PanelBorder}"
            BorderThickness="0"
            CornerRadius="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--
                The selection's own properties: position, size, rotation and the actions that apply to
                it. They used to sit in the toolbar above the canvas, on the same row as the tools. The
                row needed roughly 1500px of the 1082px the canvas column has at a 1600px window, so it
                wrapped onto a second line at every window size. Illustrator, Figma and LightBurn all
                put these in the side panel, and 336px holds two columns of fields comfortably.

                It sits above the Vrstvy / Stroj switch on purpose: what is selected has to stay
                readable and editable no matter which of the two tabs is open.
            -->
            <Border Grid.Row="0" Padding="18,14" BorderBrush="{StaticResource Brush.PanelBorder}" BorderThickness="0,0,0,1"
                    Visibility="{Binding Scene.HasSelection, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="Objekt" Style="{StaticResource InspectorSectionTitle}" />
                    <TextBlock Text="{Binding Scene.SelectionSummary}" Style="{StaticResource Text.Muted}"
                               TextWrapping="Wrap" Margin="0,0,0,12"
                               ToolTip="{Binding Scene.SelectionSummary}" />

                    <!--
                        One grid for all three rows, so the fields line up in two columns whatever label
                        sits in front of them. The aspect lock owns the narrow middle column: it ties
                        width to height, and sitting between them says so without a caption. That column
                        stays reserved on the other rows rather than letting X and Y grow wider than
                        width and height.
                    -->
                    <Grid Visibility="{Binding Scene.Selected, Converter={StaticResource NotNullToVisibility}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- DockPanel, not a horizontal StackPanel: a StackPanel measures its children
                             at infinite width, so the field would take its natural width and ignore the
                             column it is supposed to fill. -->
                        <DockPanel Grid.Row="0" Grid.Column="0" IsEnabled="{Binding Scene.CanEditSelectedPosition}">
                            <TextBlock DockPanel.Dock="Left" Text="X" Style="{StaticResource TransformRowLabel}"
                                       Width="16" Margin="0,0,6,0" />
                            <Border Style="{StaticResource UnitField.Shell}" Height="{StaticResource Size.Control.Compact}"
                                    ToolTip="Poloha středu objektu na ose X">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="mm" Style="{StaticResource UnitField.Suffix}" />
                                    <TextBox Style="{StaticResource UnitField.Input}" KeyDown="OnTransformFieldKeyDown"
                                             automation:AutomationProperties.Name="Poloha na ose X v milimetrech"
                                             Text="{Binding Scene.SelectedX, StringFormat=0.##, UpdateSourceTrigger=LostFocus}" />
                                </DockPanel>
                            </Border>
                        </DockPanel>
                        <DockPanel Grid.Row="0" Grid.Column="2" IsEnabled="{Binding Scene.CanEditSelectedPosition}">
                            <TextBlock DockPanel.Dock="Left" Text="Y" Style="{StaticResource TransformRowLabel}"
                                       Width="16" Margin="0,0,6,0" />
                            <Border Style="{StaticResource UnitField.Shell}" Height="{StaticResource Size.Control.Compact}"
                                    ToolTip="Poloha středu objektu na ose Y">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="mm" Style="{StaticResource UnitField.Suffix}" />
                                    <TextBox Style="{StaticResource UnitField.Input}" KeyDown="OnTransformFieldKeyDown"
                                             automation:AutomationProperties.Name="Poloha na ose Y v milimetrech"
                                             Text="{Binding Scene.SelectedY, StringFormat=0.##, UpdateSourceTrigger=LostFocus}" />
                                </DockPanel>
                            </Border>
                        </DockPanel>

                        <DockPanel Grid.Row="2" Grid.Column="0" IsEnabled="{Binding Scene.CanTransformSelectedObject}">
                            <TextBlock DockPanel.Dock="Left" Text="Š" Style="{StaticResource TransformRowLabel}"
                                       Width="16" Margin="0,0,6,0" ToolTip="Šířka" />
                            <Border Style="{StaticResource UnitField.Shell}" Height="{StaticResource Size.Control.Compact}"
                                    ToolTip="Výsledná šířka objektu">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="mm" Style="{StaticResource UnitField.Suffix}" />
                                    <TextBox Style="{StaticResource UnitField.Input}" KeyDown="OnTransformFieldKeyDown"
                                             automation:AutomationProperties.Name="Šířka v milimetrech"
                                             Text="{Binding Scene.SelectedWidth, StringFormat=0.##, UpdateSourceTrigger=LostFocus}" />
                                </DockPanel>
                            </Border>
                        </DockPanel>
                        <ToggleButton Grid.Row="2" Grid.Column="1" Style="{StaticResource Toggle.Icon}"
                                      IsChecked="{Binding Scene.LockAspectRatio}"
                                      IsEnabled="{Binding Scene.CanTransformSelectedObject}"
                                      Margin="4,0"
                                      ToolTip="Zachovat poměr stran při změně šířky nebo výšky"
                                      AutomationProperties.Name="Zachovat poměr stran">
                            <components:IconGlyph IconData="{StaticResource Glyph.Link}" Width="{StaticResource Size.Icon.Sm}" Height="{StaticResource Size.Icon.Sm}" />
                        </ToggleButton>
                        <DockPanel Grid.Row="2" Grid.Column="2" IsEnabled="{Binding Scene.CanTransformSelectedObject}">
                            <TextBlock DockPanel.Dock="Left" Text="V" Style="{StaticResource TransformRowLabel}"
                                       Width="16" Margin="0,0,6,0" ToolTip="Výška" />
                            <Border Style="{StaticResource UnitField.Shell}" Height="{StaticResource Size.Control.Compact}"
                                    ToolTip="Výsledná výška objektu">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="mm" Style="{StaticResource UnitField.Suffix}" />
                                    <TextBox Style="{StaticResource UnitField.Input}" KeyDown="OnTransformFieldKeyDown"
                                             automation:AutomationProperties.Name="Výška v milimetrech"
                                             Text="{Binding Scene.SelectedHeight, StringFormat=0.##, UpdateSourceTrigger=LostFocus}" />
                                </DockPanel>
                            </Border>
                        </DockPanel>

                        <DockPanel Grid.Row="4" Grid.Column="0" IsEnabled="{Binding Scene.CanRotateSelectedObject}">
                            <components:IconGlyph DockPanel.Dock="Left" IconData="{StaticResource Glyph.RotateRight}"
                                                  Width="{StaticResource Size.Icon.Sm}" Height="{StaticResource Size.Icon.Sm}"
                                                  Foreground="{StaticResource Brush.TextSecondary}"
                                                  VerticalAlignment="Center" Margin="0,0,6,0" ToolTip="Otočení" />
                            <Border Style="{StaticResource UnitField.Shell}" Height="{StaticResource Size.Control.Compact}"
                                    ToolTip="Otočení objektu ve stupních">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="°" Style="{StaticResource UnitField.Suffix}" />
                                    <TextBox Style="{StaticResource UnitField.Input}" KeyDown="OnTransformFieldKeyDown"
                                             automation:AutomationProperties.Name="Otočení ve stupních"
                                             Text="{Binding Scene.SelectedRotation, StringFormat=0.#, UpdateSourceTrigger=LostFocus}" />
                                </DockPanel>
                            </Border>
                        </DockPanel>
                    </Grid>

                    <!-- Object actions. Icon-only with tooltips and accessible names. Group, unite,
                         ungroup and trace appear only when they apply, so the run is four buttons most
                         of the time; a WrapPanel lets it fold onto a second line instead of clipping
                         when all of them are available at once. -->
                    <WrapPanel Margin="-6,10,0,0">
                        <Button Style="{StaticResource Button.GhostIcon}" Command="{Binding Scene.GroupSelectionCommand}"
                                Visibility="{Binding Scene.CanGroupSelection, Converter={StaticResource BoolToVisibility}}"
                                ToolTip="Seskupit výběr · Ctrl+G" AutomationProperties.Name="Seskupit výběr">
                            <components:IconGlyph IconData="{StaticResource Glyph.Group}" Width="{StaticResource Size.Icon.Sm}" Height="{StaticResource Size.Icon.Sm}" />
                        </Button>
                        <Button Style="{StaticResource Button.GhostIcon}" Command="{Binding Scene.UniteSelectionCommand}"
                                Visibility="{Binding Scene.CanUniteSelection, Converter={StaticResource BoolToVisibility}}"
                                ToolTip="Sjednotit uzavřené vektory do jednoho tvaru · Ctrl+Shift+U" AutomationProperties.Name="Sjednotit tvary">
                            <components:IconGlyph IconData="{StaticResource Glyph.Union}" Width="{StaticResource Size.Icon.Sm}" Height="{StaticResource Size.Icon.Sm}" />
                        </Button>
                        <Button Style="{StaticResource Button.GhostIcon}" Command="{Binding Scene.UngroupSelectionCommand}"
                                Visibility="{Binding Scene.CanUngroupSelection, Converter={StaticResource BoolToVisibility}}"
                                ToolTip="Rozdělit skupinu nebo text na části · Ctrl+Shift+G" AutomationProperties.Name="Rozdělit skupinu">
                            <components:IconGlyph IconData="{StaticResource Glyph.Ungroup}" Width="{StaticResource Size.Icon.Sm}" Height="{StaticResource Size.Icon.Sm}" />
                        </Button>
                        <Button Style="{StaticResource Button.GhostIcon}" Command="{Binding Scene.TraceSelectedRasterCommand}"
                                Visibility="{Binding Scene.CanTraceSelectedRaster, Converter={StaticResource BoolToVisibility}}"
                                ToolTip="Převést bitmapu na vektorové obrysy · Alt+T" AutomationProperties.Name="Trasovat bitmapu">
                            <components:IconGlyph IconData="{StaticResource Glyph.Vector}" Width="{StaticResource Size.Icon.Sm}" Height="{StaticResource Size.Icon.Sm}" />
                        </Button>

                        <Button Style="{StaticResource Button.GhostIcon}" Command="{Binding Scene.ToggleLockCommand}"
                                AutomationProperties.Name="Zamknout nebo odemknout výběr">
                            <Button.ToolTip>
                                <ToolTip>
                                    <TextBlock>
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Zamknout výběr proti úpravám" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Scene.IsSelectedLocked}" Value="True">
                                                        <Setter Property="Text" Value="Odemknout výběr" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </ToolTip>
                            </Button.ToolTip>
                            <components:IconGlyph Width="{StaticResource Size.Icon.Sm}" Height="{StaticResource Size.Icon.Sm}">
                                <components:IconGlyph.Style>
                                    <Style TargetType="components:IconGlyph">
                                        <Setter Property="IconData" Value="{StaticResource Glyph.Unlock}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Scene.IsSelectedLocked}" Value="True">
                                                <Setter Property="IconData" Value="{StaticResource Glyph.Lock}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </components:IconGlyph.Style>
                            </components:IconGlyph>
                        </Button>
                        <Button Style="{StaticResource Button.GhostIcon}" Command="{Binding Scene.DuplicateCommand}"
                                ToolTip="Duplikovat výběr · Ctrl+D" AutomationProperties.Name="Duplikovat výběr">
                            <components:IconGlyph IconData="{StaticResource Glyph.Duplicate}" Width="{StaticResource Size.Icon.Sm}" Height="{StaticResource Size.Icon.Sm}" />
                        </Button>
                        <Button Style="{StaticResource Button.GhostIcon}" Command="{Binding Scene.DeleteCommand}"
                                Foreground="{StaticResource Brush.Danger}"
                                ToolTip="Odstranit výběr · Delete" AutomationProperties.Name="Odstranit výběr">
                            <components:IconGlyph IconData="{StaticResource Glyph.Delete}" Width="{StaticResource Size.Icon.Sm}" Height="{StaticResource Size.Icon.Sm}" />
                        </Button>

                        <!-- Overflow. It used to be bare text with no border, background or chevron, so
                             nothing signalled that it could be clicked. -->
                        <Menu Background="Transparent" VerticalAlignment="Center">
                            <MenuItem Padding="10,9" ToolTip="Další úpravy: otočení, zrcadlení, pořadí a zarovnání"
                                      AutomationProperties.Name="Další úpravy">
                                <MenuItem.Header>
                                    <components:IconGlyph IconData="{StaticResource Glyph.More}" Width="{StaticResource Size.Icon.Sm}" Height="{StaticResource Size.Icon.Sm}" />
                                </MenuItem.Header>
                                <MenuItem Header="Otočit o 90° vlevo" Command="{Binding Scene.RotateLeftCommand}" />
                                <MenuItem Header="Otočit o 90° vpravo" Command="{Binding Scene.RotateRightCommand}" />
                                <MenuItem Header="Zrcadlit vodorovně" Command="{Binding Scene.FlipHorizontalCommand}" />
                                <MenuItem Header="Zrcadlit svisle" Command="{Binding Scene.FlipVerticalCommand}" />
                                <Separator />
                                <MenuItem Header="Přenést dopředu" Command="{Binding Scene.BringToFrontCommand}" />
                                <MenuItem Header="Přenést dozadu" Command="{Binding Scene.SendToBackCommand}" />
                                <MenuItem Header="Zarovnat" Visibility="{Binding Scene.HasMultipleSelection, Converter={StaticResource BoolToVisibility}}">
                                    <MenuItem Header="Vlevo" Command="{Binding Scene.AlignLeftCommand}" />
                                    <MenuItem Header="Na střed vodorovně" Command="{Binding Scene.AlignCenterHorizontalCommand}" />
                                    <MenuItem Header="Vpravo" Command="{Binding Scene.AlignRightCommand}" />
                                    <Separator />
                                    <MenuItem Header="Nahoru" Command="{Binding Scene.AlignTopCommand}" />
                                    <MenuItem Header="Na střed svisle" Command="{Binding Scene.AlignMiddleCommand}" />
                                    <MenuItem Header="Dolů" Command="{Binding Scene.AlignBottomCommand}" />
                                </MenuItem>
                                <Separator />
                                <MenuItem Header="Zobrazit na plátně" IsCheckable="True" IsChecked="{Binding Scene.Selected.IsVisible}" />
                                <MenuItem Header="Zahrnout do úlohy" IsCheckable="True" IsChecked="{Binding Scene.Selected.IncludeInOutput}" />
                            </MenuItem>
                        </Menu>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Padding="16,14" BorderBrush="{StaticResource Brush.PanelBorder}" BorderThickness="0,0,0,1">
                <Border Style="{StaticResource SegmentedTrack}" Padding="3">
                    <UniformGrid Columns="2">
                        <RadioButton x:Name="LayersTabRadio"
                                     IsChecked="True"
                                     Style="{StaticResource InspectorModeSegment}"
                                     GroupName="InspectorTab">
                            <components:IconLabel IconData="{StaticResource Glyph.Materials}" Text="Vrstvy" IconSize="{StaticResource Size.Icon.Sm}" TextMargin="7,0,0,0" />
                        </RadioButton>
                        <RadioButton x:Name="MachineTabRadio"
                                     Style="{StaticResource InspectorModeSegment}"
                                     GroupName="InspectorTab">
                            <components:IconLabel IconData="{StaticResource Glyph.Device}" Text="Stroj" IconSize="{StaticResource Size.Icon.Sm}" TextMargin="7,0,0,0" />
                        </RadioButton>
                    </UniformGrid>
                </Border>
            </Border>

            <Grid Grid.Row="2">
                <!--
                    One vertical column, not a stack of boxes. This tab used to nest
                    panel > bordered list > bordered settings card > bordered segmented track >
                    bordered fields > bordered empty state, so six containers were competing to
                    group things that spacing and a single hairline already group. Sections are now
                    separated by whitespace and one rule; the only remaining borders belong to
                    controls the user can actually type into or press.
                -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Visibility="{Binding IsChecked, ElementName=LayersTabRadio, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Margin="18,16,18,20">

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="Vrstvy" Style="{StaticResource InspectorSectionTitle}" />
                                <TextBlock Text="Každá vrstva má vlastní nastavení laseru."
                                           Style="{StaticResource Text.Muted}" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource Button.Ghost}"
                                    Command="{Binding Scene.AddLayerCommand}" VerticalAlignment="Top" Padding="10,0"
                                    ToolTip="Přidat novou prázdnou vrstvu">
                                <components:IconLabel IconData="{StaticResource Glyph.New}" Text="Nová vrstva" IconSize="{StaticResource Size.Icon.Sm}" />
                            </Button>
                        </Grid>

                        <!--
                            The column headers (#, Vrstva a nastavení, Výstup, Vidět) are gone: the row
                            says what each element is on its own, and the two state icons carry
                            tooltips and accessible names. Four header labels for a two-icon row was
                            density without information.
                        -->
                        <ListBox x:Name="LayersList"
                                 ItemsSource="{Binding GCode.Layers}"
                                 SelectedItem="{Binding Scene.SelectedLayer, Mode=TwoWay}"
                                 MaxHeight="300"
                                 Margin="0,0,0,4"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="LayerRow"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="Transparent"
                                                        BorderThickness="1"
                                                        CornerRadius="{StaticResource Radius.Md}"
                                                        Margin="0,1">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="LayerRow" Property="Background" Value="{StaticResource Brush.PanelRaised}" />
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="LayerRow" Property="Background" Value="{StaticResource Brush.SelectedSurface}" />
                                                        <Setter TargetName="LayerRow" Property="BorderBrush" Value="{StaticResource Brush.SelectedBorder}" />
                                                    </Trigger>
                                                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                        <Setter TargetName="LayerRow" Property="BorderBrush" Value="{StaticResource Brush.FocusRing}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid MinHeight="48" Margin="4,0,8,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border Width="18" Height="18" CornerRadius="{StaticResource Radius.Sm}" VerticalAlignment="Center" Margin="0,0,10,0"
                                                Background="{Binding Color, Converter={StaticResource RgbColorToBrush}}"
                                                BorderBrush="{StaticResource Brush.PanelBorderStrong}" BorderThickness="1"
                                                ToolTip="Barva vrstvy" />

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding ProcessingSummary}" Style="{StaticResource Text.Muted}"
                                                       FontSize="{StaticResource Size.Text.Meta}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>

                                        <!--
                                            Two full-size switches per row was more control than a
                                            per-row on/off needs, and they made every row look like a
                                            settings screen. Icon toggles say the same thing in a
                                            third of the width and keep the name the loudest thing
                                            in the row.
                                        -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <ToggleButton Style="{StaticResource Toggle.LayerState}" IsChecked="{Binding IsEnabled}"
                                                          automation:AutomationProperties.Name="Zpracovat vrstvu">
                                                <ToggleButton.ToolTip>
                                                    <ToolTip>
                                                        <TextBlock>
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Text" Value="Vrstva se nevyrábí. Kliknutím ji zařadíte do úlohy." />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsEnabled}" Value="True">
                                                                            <Setter Property="Text" Value="Vrstva se vyrábí. Kliknutím ji z úlohy vyřadíte." />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </ToolTip>
                                                </ToggleButton.ToolTip>
                                                <components:IconGlyph Width="{StaticResource Size.Icon.Sm}" Height="{StaticResource Size.Icon.Sm}">
                                                    <components:IconGlyph.Style>
                                                        <Style TargetType="components:IconGlyph">
                                                            <Setter Property="IconData" Value="{StaticResource Glyph.ZapOff}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsEnabled}" Value="True">
                                                                    <Setter Property="IconData" Value="{StaticResource Glyph.Zap}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </components:IconGlyph.Style>
                                                </components:IconGlyph>
                                            </ToggleButton>
                                            <ToggleButton Style="{StaticResource Toggle.LayerState}" IsChecked="{Binding IsVisible}"
                                                          automation:AutomationProperties.Name="Zobrazit vrstvu na plátně">
                                                <ToggleButton.ToolTip>
                                                    <ToolTip>
                                                        <TextBlock>
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Text" Value="Vrstva je skrytá. Kliknutím ji zobrazíte." />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsVisible}" Value="True">
                                                                            <Setter Property="Text" Value="Vrstva je vidět. Kliknutím ji skryjete." />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </ToolTip>
                                                </ToggleButton.ToolTip>
                                                <components:IconGlyph Width="{StaticResource Size.Icon.Sm}" Height="{StaticResource Size.Icon.Sm}">
                                                    <components:IconGlyph.Style>
                                                        <Style TargetType="components:IconGlyph">
                                                            <Setter Property="IconData" Value="{StaticResource Glyph.EyeOff}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsVisible}" Value="True">
                                                                    <Setter Property="IconData" Value="{StaticResource Glyph.Eye}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </components:IconGlyph.Style>
                                                </components:IconGlyph>
                                            </ToggleButton>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Reordering is secondary: it moves to ghost icon buttons that appear only
                             once there is more than one layer to reorder. It used to be two permanent
                             full-size labelled buttons sitting above an empty list. -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,2,0,0"
                                    Visibility="{Binding Scene.CanReorderLayers, Converter={StaticResource BoolToVisibility}}">
                            <Button Style="{StaticResource Button.GhostIcon}" Command="{Binding Scene.MoveSelectedLayerUpCommand}"
                                    ToolTip="Posunout vrstvu výše ve výrobním pořadí"
                                    automation:AutomationProperties.Name="Posunout vrstvu nahoru">
                                <components:IconGlyph IconData="{StaticResource Glyph.ArrowUp}" Width="{StaticResource Size.Icon.Sm}" Height="{StaticResource Size.Icon.Sm}" />
                            </Button>
                            <Button Style="{StaticResource Button.GhostIcon}" Margin="0" Command="{Binding Scene.MoveSelectedLayerDownCommand}"
                                    ToolTip="Posunout vrstvu níže ve výrobním pořadí"
                                    automation:AutomationProperties.Name="Posunout vrstvu dolů">
                                <components:IconGlyph IconData="{StaticResource Glyph.ArrowDown}" Width="{StaticResource Size.Icon.Sm}" Height="{StaticResource Size.Icon.Sm}" />
                            </Button>
                        </StackPanel>

                        <!-- Layer settings. Shown only when a layer is selected — progressive
                             disclosure rather than every possible section at once. -->
                        <StackPanel Visibility="{Binding DataContext.Scene.SelectedLayer, ElementName=InspectorRoot, Converter={StaticResource NotNullToVisibility}}"
                                    DataContext="{Binding DataContext.Scene.SelectedLayer, ElementName=InspectorRoot}">

                            <Border Style="{StaticResource InspectorRule}" />

                            <!--
                                The name is the heading of this section, not a second copy of the row
                                above it. It used to be a swatch plus a bordered field directly under
                                a list row showing the same swatch and the same name — with one layer
                                in the project that read as the row simply being drawn twice.

                                It stays editable: a chromeless TextBox that takes a field's border
                                only on hover or focus, so it looks like a title until you go to
                                change it.
                            -->
                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource InlineTitleInput}"
                                     Margin="0,0,0,16"
                                     ToolTip="Přejmenovat vrstvu"
                                     automation:AutomationProperties.Name="Název vrstvy" />

                            <Border Padding="12,10"
                                    Margin="0,0,0,16"
                                    CornerRadius="{StaticResource Radius.Md}"
                                    Background="{StaticResource Brush.PanelRaised}"
                                    BorderBrush="{StaticResource Brush.PanelBorder}"
                                    BorderThickness="1"
                                    Visibility="{Binding DataContext.Scene.IsSelectedLayerRaster, ElementName=InspectorRoot, Converter={StaticResource BoolToVisibility}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <components:IconGlyph IconData="{StaticResource Glyph.Image}" Width="{StaticResource Size.Icon.Md}" Height="{StaticResource Size.Icon.Md}"
                                                          VerticalAlignment="Center" Foreground="{StaticResource Brush.TextSecondary}" />
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                        <TextBlock Text="Obrázek" FontWeight="SemiBold" />
                                        <TextBlock Text="Černobílé gravírování · Stucki"
                                                   Style="{StaticResource Text.Muted}" FontSize="{StaticResource Size.Text.Meta}" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <TextBlock Text="Zpracování" Style="{StaticResource InspectorSectionTitle}" Margin="0,0,0,8"
                                       Visibility="{Binding DataContext.Scene.IsSelectedLayerRaster, ElementName=InspectorRoot, Converter={StaticResource InverseBoolToVisibility}}" />
                            <Border Style="{StaticResource SegmentedTrack}" IsEnabled="{Binding IsEnabled}"
                                    Visibility="{Binding DataContext.Scene.IsSelectedLayerRaster, ElementName=InspectorRoot, Converter={StaticResource InverseBoolToVisibility}}">
                                <UniformGrid Columns="3">
                                    <RadioButton Content="Čára"
                                                 GroupName="LayerProcessingMode"
                                                 Style="{StaticResource Segment}"
                                                 IsChecked="{Binding Mode, Converter={StaticResource EnumToBool}, ConverterParameter=Cut, Mode=TwoWay}"
                                                 ToolTip="Laser sleduje obrys vektoru. Vhodné pro řezání a liniové gravírování."
                                                 automation:AutomationProperties.Name="Zpracovat vrstvu jako čáru" />
                                    <RadioButton Content="Výplň"
                                                 GroupName="LayerProcessingMode"
                                                 Style="{StaticResource Segment}"
                                                 IsChecked="{Binding Mode, Converter={StaticResource EnumToBool}, ConverterParameter=Fill, Mode=TwoWay}"
                                                 ToolTip="Laser vyplní vnitřní plochu vektoru řádky. Vhodné pro plné gravírování."
                                                 automation:AutomationProperties.Name="Zpracovat vrstvu jako výplň" />
                                    <RadioButton Content="Výplň + čára"
                                                 GroupName="LayerProcessingMode"
                                                 Style="{StaticResource Segment}"
                                                 IsChecked="{Binding Mode, Converter={StaticResource EnumToBool}, ConverterParameter=FillAndCut, Mode=TwoWay}"
                                                 ToolTip="Laser nejdřív vyplní plochu a potom projede její obrys."
                                                 automation:AutomationProperties.Name="Zpracovat vrstvu jako výplň a obrys" />
                                </UniformGrid>
                            </Border>
                            <TextBlock Margin="0,8,0,18" TextWrapping="Wrap"
                                       Visibility="{Binding DataContext.Scene.IsSelectedLayerRaster, ElementName=InspectorRoot, Converter={StaticResource InverseBoolToVisibility}}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Muted}">
                                        <Setter Property="Text" Value="Laser pojede po obrysu vektoru." />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Mode}" Value="{x:Static layers:LayerMode.Fill}">
                                                <Setter Property="Text" Value="Laser vyplní uzavřenou plochu řádky." />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Mode}" Value="{x:Static layers:LayerMode.FillAndCut}">
                                                <Setter Property="Text" Value="Laser nejdřív vyplní plochu a potom projede její obrys." />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <TextBlock Text="Nastavení" Style="{StaticResource InspectorSectionTitle}" Margin="0,0,0,8" />
                            <!-- Label left, value right, one row each: the three numbers that decide the
                                 result are scannable as a column instead of three stacked label+field
                                 pairs squeezed side by side. Units live inside the field. -->
                            <Grid IsEnabled="{Binding IsEnabled}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="132" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="8" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="8" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Text="Rychlost" Style="{StaticResource TransformRowLabel}" />
                                <Border Grid.Column="1" Style="{StaticResource UnitField.Shell}" ToolTip="Rychlost posuvu laseru">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="mm/min" Style="{StaticResource UnitField.Suffix}" />
                                        <TextBox Style="{StaticResource UnitField.Input}" Text="{Binding Speed, StringFormat=0}"
                                                 automation:AutomationProperties.Name="Rychlost v milimetrech za minutu" />
                                    </DockPanel>
                                </Border>

                                <TextBlock Grid.Row="2" Text="Výkon" Style="{StaticResource TransformRowLabel}" />
                                <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource UnitField.Shell}" ToolTip="Výkon laseru v procentech">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="%" Style="{StaticResource UnitField.Suffix}" />
                                        <TextBox Style="{StaticResource UnitField.Input}" Text="{Binding Power, StringFormat=0}"
                                                 automation:AutomationProperties.Name="Výkon v procentech" />
                                    </DockPanel>
                                </Border>

                                <TextBlock Grid.Row="4" Text="Průchody" Style="{StaticResource TransformRowLabel}" />
                                <Border Grid.Row="4" Grid.Column="1" Style="{StaticResource UnitField.Shell}" ToolTip="Kolikrát laser projede stejnou dráhu">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="×" Style="{StaticResource UnitField.Suffix}" />
                                        <TextBox Style="{StaticResource UnitField.Input}" Text="{Binding Passes, StringFormat=0}"
                                                 automation:AutomationProperties.Name="Počet průchodů" />
                                    </DockPanel>
                                </Border>
                            </Grid>

                            <StackPanel Margin="0,16,0,0" IsEnabled="{Binding IsEnabled}">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Mode}" Value="{x:Static layers:LayerMode.Fill}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Mode}" Value="{x:Static layers:LayerMode.FillAndCut}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Button HorizontalAlignment="Stretch"
                                        Padding="14,0"
                                        Tag="{Binding}"
                                        Click="OnApplyMaterialClick"
                                        ToolTip="Vybrat ověřené parametry materiálu">
                                    <components:IconLabel IconData="{StaticResource Glyph.Materials}"
                                                          Text="Doporučené parametry"
                                                          IconSize="{StaticResource Size.Icon.Sm}" />
                                </Button>
                                <Expander Margin="0,10,0,0">
                                    <Expander.Header>
                                        <TextBlock>
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="Pokročilé nastavení výplně" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DataContext.Scene.IsSelectedLayerRaster, ElementName=InspectorRoot}" Value="True">
                                                            <Setter Property="Text" Value="Nastavení obrázku" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Expander.Header>
                                    <StackPanel Margin="0,10,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="132" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Rozestup řádků" Style="{StaticResource TransformRowLabel}" />
                                            <Border Grid.Column="1" Style="{StaticResource UnitField.Shell}"
                                                    ToolTip="Menší rozestup znamená jemnější gravírování a delší čas.">
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Right" Text="mm" Style="{StaticResource UnitField.Suffix}" />
                                                    <TextBox Style="{StaticResource UnitField.Input}"
                                                             Text="{Binding FillLineIntervalMm, UpdateSourceTrigger=LostFocus, StringFormat=0.###}"
                                                             automation:AutomationProperties.Name="Rozestup řádků v milimetrech" />
                                                </DockPanel>
                                            </Border>
                                        </Grid>
                                        <TextBlock TextWrapping="Wrap" Margin="0,8,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Muted}">
                                                    <Setter Property="Text" Value="Menší hodnota vytvoří jemnější výplň, ale prodlouží dobu gravírování." />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DataContext.Scene.IsSelectedLayerRaster, ElementName=InspectorRoot}" Value="True">
                                                            <Setter Property="Text" Value="Určuje vzdálenost gravírovaných řádků. Obraz je při importu převeden do černobílého rastru metodou Stucki." />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Expander>
                            </StackPanel>

                            <Button Style="{StaticResource Button.Ghost}" Margin="0,18,0,0" HorizontalAlignment="Left" Padding="10,0"
                                    Command="{Binding DataContext.Scene.DeleteSelectedLayerCommand, ElementName=InspectorRoot}"
                                    Foreground="{StaticResource Brush.Danger}"
                                    ToolTipService.ShowOnDisabled="True"
                                    ToolTip="Odstranit lze pouze vrstvu, kterou nepoužívá žádný objekt">
                                <components:IconLabel IconData="{StaticResource Glyph.Delete}" Text="Odstranit vrstvu" IconSize="{StaticResource Size.Icon.Sm}" />
                            </Button>
                        </StackPanel>

                        <!-- Empty state. No card: it sits on the panel surface like every other
                             section here. -->
                        <StackPanel HorizontalAlignment="Center" MaxWidth="240" Margin="0,28,0,0">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ElementName=LayersList, Path=HasItems}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <components:IconGlyph IconData="{StaticResource Glyph.Materials}" Width="{StaticResource Size.Icon.Xl}" Height="{StaticResource Size.Icon.Xl}" HorizontalAlignment="Center" Foreground="{DynamicResource Brush.TextMuted}" />
                            <TextBlock Text="Zatím žádné vrstvy"
                                       FontWeight="SemiBold"
                                       TextAlignment="Center"
                                       Margin="0,12,0,4" />
                            <TextBlock Text="Nakreslete tvar nebo importujte grafiku. Vrstva se vytvoří automaticky."
                                       Style="{StaticResource Text.Muted}"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap" Margin="0,0,0,14" />
                            <Button Command="{Binding GCode.LoadFileCommand}" Padding="14,0" HorizontalAlignment="Center">
                                <components:IconLabel IconData="{StaticResource Glyph.Import}" Text="Importovat grafiku" IconSize="{StaticResource Size.Icon.Sm}" />
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <views:MachinePanelView Margin="12,10,12,8"
                                        Visibility="{Binding IsChecked, ElementName=MachineTabRadio, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
