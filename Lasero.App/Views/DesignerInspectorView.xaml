<UserControl x:Class="Lasero.App.Views.DesignerInspectorView"
             x:Name="InspectorRoot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             xmlns:conv="clr-namespace:Lasero.App.Converters"
             xmlns:components="clr-namespace:Lasero.App.Components"
             xmlns:layers="clr-namespace:Lasero.Core.Layers;assembly=Lasero.Core"
             MinWidth="320">
    <!--
        The Designer inspector, in three sections down one flat column:

            ZAŘÍZENÍ   — a compact, read-only summary of the real machine state
            OPERACE    — the operation stack, in execution order
            NASTAVENÍ  — the selected operation's process settings

        Flat on purpose. The previous version nested a card inside a tab inside a panel, so almost
        every control sat behind three edges. Here the panel is the only surface; groups are told
        apart by an uppercase header, whitespace and a hairline.

        Nothing was dropped. The machine tab became a summary plus a link to the Device screen, which
        is where the full MachinePanelView lives; the layer context menu keeps every command it had.
    -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
        <conv:EnumToBooleanConverter x:Key="EnumToBool" />
        <conv:NotNullToVisibilityConverter x:Key="NotNullToVisibility" />
        <conv:RgbColorToBrushConverter x:Key="RgbColorToBrush" />
        <conv:IndexToLayerNumberConverter x:Key="IndexToLayerNumber" />
        <conv:RgbColorToNameConverter x:Key="RgbColorToName" />
        <conv:RgbColorMatchesConverter x:Key="RgbColorMatches" />
        <conv:MachineDisplayStateToLabelConverter x:Key="MachineStateLabel" />
        <conv:MachineDisplayStateToStatePillKindConverter x:Key="MachineStatePillKind" />

        <Style x:Key="RowLabel" TargetType="TextBlock" BasedOn="{StaticResource Text.Muted}">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!--
            The Interval row is unavailable unless the laser actually fills something. Off by default
            and switched on by the three cases that use a line spacing: Výplň, Výplň + čára, and a
            raster layer. Label and field go down together, so the row reads as unavailable instead of
            offering a live label above a dead input.
        -->
        <Style x:Key="FillOnlyRow" TargetType="Grid">
            <Setter Property="IsEnabled" Value="False" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Mode}" Value="{x:Static layers:LayerMode.Fill}">
                    <Setter Property="IsEnabled" Value="True" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Mode}" Value="{x:Static layers:LayerMode.FillAndCut}">
                    <Setter Property="IsEnabled" Value="True" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsRaster}" Value="True">
                    <Setter Property="IsEnabled" Value="True" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Border Background="{DynamicResource Brush.Panel}"
            BorderBrush="{DynamicResource Brush.PanelBorder}" BorderThickness="1,0,0,0">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>

                <!-- ==================== ZAŘÍZENÍ ==================== -->
                <!--
                    A summary, not a control panel. Every value reads through to live connection and
                    controller state, so a disconnected app names no machine and claims no readiness;
                    the full manual controls stay on the Device screen, one click away.
                -->
                <StackPanel Margin="16,14,16,14">
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <components:IconGlyph IconData="{StaticResource Glyph.Device}"
                                              Width="{StaticResource Size.Icon.Md}" Height="{StaticResource Size.Icon.Md}"
                                              Foreground="{DynamicResource Brush.TextSecondary}"
                                              VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Grid.Column="1" FontWeight="SemiBold" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="Žádné zařízení" />
                                    <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Connection.IsConnected}" Value="True">
                                            <Setter Property="Text" Value="{Binding Connection.ActiveMachineName}" />
                                            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <Border Background="{DynamicResource Brush.PanelRaised}"
                            CornerRadius="{StaticResource Radius.Sm}" Padding="10,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <components:StatusBadge HorizontalAlignment="Left"
                                                    StatusText="{Binding MachineStatus.DisplayState, Converter={StaticResource MachineStateLabel}}"
                                                    Kind="{Binding MachineStatus.DisplayState, Converter={StaticResource MachineStatePillKind}}" />
                            <TextBlock Grid.Column="1" Style="{StaticResource RowLabel}"
                                       Text="{Binding Connection.SelectedPort}"
                                       Visibility="{Binding Connection.IsConnected, Converter={StaticResource BoolToVisibility}}" />
                        </Grid>
                    </Border>

                    <Button Style="{StaticResource Button.Link}" HorizontalAlignment="Left"
                            Margin="0,8,0,0" Padding="0"
                            Click="OnMachineControlClick"
                            ToolTip="Otevřít ruční ovládání gravírky vedle plátna"
                            Content="Ovládání stroje →" />
                </StackPanel>

                <Border Style="{StaticResource InspectorGroupDivider}" />

                <!-- ==================== OBRÁZEK ==================== -->
                <!--
                    Shown only when exactly one bitmap (raster) object is selected — never for SVG
                    paths, text, shapes or groups. Background removal is provided through Lasero's
                    authenticated Gemini service; consent is requested before the source image is sent.
                -->
                <StackPanel Margin="16,14,16,14"
                            Visibility="{Binding Scene.IsSelectedRaster, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="Obrázek" Style="{StaticResource InspectorGroupHeader}" Margin="0,0,0,10" />

                    <Button Style="{StaticResource Button.Outline}" HorizontalAlignment="Stretch" Height="36"
                            Command="{Binding Scene.RemoveSelectedBackgroundCommand}"
                            Visibility="{Binding Scene.CanRemoveSelectedBackground, Converter={StaticResource BoolToVisibility}}"
                            Content="Odstranit pozadí"
                            ToolTip="Obrázek se odešle online službě Lasero (Gemini). Změnu lze vrátit pomocí Ctrl+Z." />

                    <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Style="{StaticResource RowLabel}"
                               Text="Obrázek se odešle online službě Lasero (Gemini)."
                               Visibility="{Binding Scene.CanRemoveSelectedBackground, Converter={StaticResource BoolToVisibility}}" />

                    <Button Style="{StaticResource Button.Outline}" HorizontalAlignment="Stretch" Height="36"
                            Command="{Binding Scene.RestoreSelectedBackgroundCommand}"
                            Visibility="{Binding Scene.CanRestoreSelectedBackground, Converter={StaticResource BoolToVisibility}}"
                            Content="Obnovit pozadí" />

                    <!-- Inline loading indicator, contextual to the "Odstranit pozadí" button just
                         above it rather than a generic full-panel spinner. It fades in over Motion.Fast
                         instead of the instant Visibility snap it used to have; disappearing stays
                         instant (Opacity is reset in ExitActions with a zero-length animation, ready for
                         the next fade-in), which reads as fine because the layer underneath it always
                         swaps to a concrete Success/Error state at that moment - nothing is ever left
                         blank mid-transition. -->
                    <Border x:Name="BackgroundRemovalSpinner" Margin="0,8,0,0" Background="{DynamicResource Brush.PanelRaised}"
                            CornerRadius="{StaticResource Radius.Sm}" Opacity="0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Scene.IsRemovingBackground}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                     To="1" Duration="{StaticResource Motion.Fast}"
                                                                     EasingFunction="{StaticResource Ease.Out}" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                        <DataTrigger.ExitActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <ProgressBar Width="72" Height="4" Minimum="0" Maximum="1"
                                         Value="{Binding Scene.BackgroundRemovalProgress}"
                                         IsIndeterminate="{Binding Scene.BackgroundRemovalIsIndeterminate}"
                                         Margin="0,0,10,0" />
                            <TextBlock Text="{Binding Scene.BackgroundRemovalStatus}" VerticalAlignment="Center" Style="{StaticResource RowLabel}" />
                            <Button Margin="10,0,0,0" Padding="8,2" MinHeight="24" Style="{StaticResource Button.Ghost}"
                                    Command="{Binding Scene.CancelBackgroundRemovalCommand}"
                                    Content="Zrušit" ToolTip="Zrušit odstranění pozadí" />
                        </StackPanel>
                    </Border>

                    <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Danger}"
                               Text="{Binding Scene.BackgroundRemovalError}"
                               Visibility="{Binding Scene.BackgroundRemovalError, Converter={StaticResource NotNullToVisibility}}" />
                </StackPanel>

                <Border Style="{StaticResource InspectorGroupDivider}"
                        Visibility="{Binding Scene.IsSelectedRaster, Converter={StaticResource BoolToVisibility}}" />

                <!-- ==================== OPERACE ==================== -->
                <!--
                    The operation stack, top to bottom in the order the machine will run it. This is
                    the part of Lasero that a single-process panel cannot express, so it stays whole:
                    per-operation enable, visibility, ordering, colour, duplicate and delete are all
                    still here or on the row's context menu.
                -->
                <StackPanel Margin="16,14,16,14">
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="OPERACE" Style="{StaticResource InspectorGroupHeader}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                    Visibility="{Binding Scene.CanReorderLayers, Converter={StaticResource BoolToVisibility}}">
                            <Button Style="{StaticResource Button.GhostIcon}" Command="{Binding Scene.MoveSelectedLayerUpCommand}"
                                    ToolTip="Posunout operaci dřív v pořadí"
                                    automation:AutomationProperties.Name="Posunout operaci nahoru">
                                <components:IconGlyph IconData="{StaticResource Glyph.ArrowUp}" Width="{StaticResource Size.Icon.Sm}" Height="{StaticResource Size.Icon.Sm}" />
                            </Button>
                            <Button Style="{StaticResource Button.GhostIcon}" Margin="0" Command="{Binding Scene.MoveSelectedLayerDownCommand}"
                                    ToolTip="Posunout operaci později v pořadí"
                                    automation:AutomationProperties.Name="Posunout operaci dolů">
                                <components:IconGlyph IconData="{StaticResource Glyph.ArrowDown}" Width="{StaticResource Size.Icon.Sm}" Height="{StaticResource Size.Icon.Sm}" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Pořadí shora dolů je pořadí, ve kterém stroj operace provede."
                               Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,0,0,8"
                               Visibility="{Binding Scene.CanReorderLayers, Converter={StaticResource BoolToVisibility}}" />

                    <ListBox x:Name="LayersList"
                             ItemsSource="{Binding GCode.Layers}"
                             SelectedItem="{Binding Scene.SelectedLayer, Mode=TwoWay}"
                             MaxHeight="264"
                             BorderThickness="0"
                             Background="Transparent"
                             AlternationCount="999"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             PreviewMouseRightButtonDown="OnLayerRowRightButtonDown"
                             automation:AutomationProperties.Name="Seznam operací">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="LayerRow"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="Transparent"
                                                    BorderThickness="1"
                                                    CornerRadius="{StaticResource Radius.Sm}"
                                                    Margin="0,1">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="LayerRow" Property="Background" Value="{DynamicResource Brush.PanelRaised}" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="LayerRow" Property="Background" Value="{DynamicResource Brush.SelectedSurface}" />
                                                    <Setter TargetName="LayerRow" Property="BorderBrush" Value="{DynamicResource Brush.SelectedBorder}" />
                                                </Trigger>
                                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                    <Setter TargetName="LayerRow" Property="BorderBrush" Value="{DynamicResource Brush.FocusRing}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid MinHeight="44" Margin="6,0,6,0" Background="Transparent"
                                      Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListBox}}">
                                    <!--
                                        The menu's DataContext is the row's own layer, so every item
                                        names one layer and no item has to guess which. Headers flip
                                        with state rather than reading "Vyřadit" on a layer that is
                                        already out of the job.
                                    -->
                                    <Grid.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Command="{Binding PlacementTarget.Tag.Scene.ToggleLayerOutputCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding}">
                                                <MenuItem.Style>
                                                    <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                                        <Setter Property="Header" Value="Zařadit vrstvu do úlohy" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsEnabled}" Value="True">
                                                                <Setter Property="Header" Value="Vyřadit vrstvu z úlohy" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </MenuItem.Style>
                                            </MenuItem>
                                            <MenuItem Header="Vyřadit všechny vrstvy kromě této"
                                                      Command="{Binding PlacementTarget.Tag.Scene.IsolateLayerOutputCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding}" />
                                            <Separator />
                                            <MenuItem Command="{Binding PlacementTarget.Tag.Scene.ToggleLayerVisibilityCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding}">
                                                <MenuItem.Style>
                                                    <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                                        <Setter Property="Header" Value="Zobrazit vrstvu na plátně" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsVisible}" Value="True">
                                                                <Setter Property="Header" Value="Skrýt vrstvu na plátně" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </MenuItem.Style>
                                            </MenuItem>
                                            <MenuItem Header="Skrýt všechny vrstvy kromě této"
                                                      Command="{Binding PlacementTarget.Tag.Scene.IsolateLayerVisibilityCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding}" />
                                            <Separator />
                                            <MenuItem Header="Vybrat všechny tvary v této vrstvě"
                                                      Command="{Binding PlacementTarget.Tag.Scene.SelectObjectsInLayerCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding}" />
                                            <MenuItem Header="Přiřadit výběr do této vrstvy"
                                                      Command="{Binding PlacementTarget.Tag.Scene.AssignSelectionToLayerCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding}" />
                                            <Separator />
                                            <MenuItem Header="Duplikovat vrstvu"
                                                      Command="{Binding PlacementTarget.Tag.Scene.DuplicateSelectedLayerCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            <MenuItem Header="Odstranit vrstvu"
                                                      ToolTip="Vrstvu nelze odstranit, dokud ji používá nějaký tvar. Nejdřív tvary přiřaďte do jiné vrstvy."
                                                      ToolTipService.ShowOnDisabled="True"
                                                      Command="{Binding PlacementTarget.Tag.Scene.DeleteSelectedLayerCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        </ContextMenu>
                                    </Grid.ContextMenu>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Execution position. The stack's order is the machine's order,
                                         and a number states that far more plainly than position alone. -->
                                    <TextBlock Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0"
                                               Style="{StaticResource Text.Muted}"
                                               FontFamily="{StaticResource Font.Numeric}"
                                               Text="{Binding Path=(ItemsControl.AlternationIndex),
                                                              RelativeSource={RelativeSource AncestorType=ListBoxItem},
                                                              Converter={StaticResource IndexToLayerNumber}}" />

                                    <Border Grid.Column="1" Width="16" Height="16" CornerRadius="{StaticResource Radius.Xs}"
                                            VerticalAlignment="Center" Margin="0,0,10,0"
                                            Background="{Binding Color, Converter={StaticResource RgbColorToBrush}}"
                                            BorderBrush="{DynamicResource Brush.PanelBorderStrong}" BorderThickness="1"
                                            ToolTip="Barva operace. Objekty stejné barvy se zpracují stejným nastavením" />

                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding ProcessingSummary}" Style="{StaticResource Text.Muted}"
                                                   Margin="0,1,0,0" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                        <ToggleButton Style="{StaticResource Toggle.LayerState}" IsChecked="{Binding IsEnabled}"
                                                      automation:AutomationProperties.Name="Zpracovat vrstvu">
                                            <ToggleButton.ToolTip>
                                                <ToolTip>
                                                    <TextBlock>
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="Vrstva se nevyrábí. Kliknutím ji zařadíte do úlohy." />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsEnabled}" Value="True">
                                                                        <Setter Property="Text" Value="Vrstva se vyrábí. Kliknutím ji z úlohy vyřadíte." />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </ToolTip>
                                            </ToggleButton.ToolTip>
                                            <components:IconGlyph Width="{StaticResource Size.Icon.Sm}" Height="{StaticResource Size.Icon.Sm}">
                                                <components:IconGlyph.Style>
                                                    <Style TargetType="components:IconGlyph">
                                                        <Setter Property="IconData" Value="{StaticResource Glyph.ZapOff}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsEnabled}" Value="True">
                                                                <Setter Property="IconData" Value="{StaticResource Glyph.Zap}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </components:IconGlyph.Style>
                                            </components:IconGlyph>
                                        </ToggleButton>
                                        <ToggleButton Style="{StaticResource Toggle.LayerState}" IsChecked="{Binding IsVisible}"
                                                      automation:AutomationProperties.Name="Zobrazit vrstvu na plátně">
                                            <ToggleButton.ToolTip>
                                                <ToolTip>
                                                    <TextBlock>
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="Vrstva je skrytá. Kliknutím ji zobrazíte." />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsVisible}" Value="True">
                                                                        <Setter Property="Text" Value="Vrstva je vidět. Kliknutím ji skryjete." />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </ToolTip>
                                            </ToggleButton.ToolTip>
                                            <components:IconGlyph Width="{StaticResource Size.Icon.Sm}" Height="{StaticResource Size.Icon.Sm}">
                                                <components:IconGlyph.Style>
                                                    <Style TargetType="components:IconGlyph">
                                                        <Setter Property="IconData" Value="{StaticResource Glyph.EyeOff}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsVisible}" Value="True">
                                                                <Setter Property="IconData" Value="{StaticResource Glyph.Eye}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </components:IconGlyph.Style>
                                            </components:IconGlyph>
                                        </ToggleButton>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- No operations yet: say why there are none and offer the one action that makes
                         one appear. -->
                    <StackPanel Margin="0,6,0,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ElementName=LayersList, Path=HasItems}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="Zatím žádné operace" FontWeight="Medium" />
                        <TextBlock Text="Operace určuje, jak laser objekty zpracuje: výkon, rychlost a počet průchodů. Vytvoří se sama, jakmile do návrhu přidáte tvar, text nebo obrázek."
                                   Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,3,0,0" />
                        <Button Style="{StaticResource Button.Regular}" Command="{Binding GCode.LoadFileCommand}"
                                HorizontalAlignment="Left" Margin="0,12,0,0" Padding="12,0">
                            <components:IconLabel IconData="{StaticResource Glyph.Import}" Text="Importovat grafiku"
                                                  IconSize="{StaticResource Size.Icon.Sm}" TextMargin="7,0,0,0" />
                        </Button>
                    </StackPanel>
                </StackPanel>

                <!-- ==================== NASTAVENÍ VYBRANÉ OPERACE ==================== -->
                <Border Style="{StaticResource InspectorGroupDivider}"
                        Visibility="{Binding Scene.SelectedLayer, Converter={StaticResource NotNullToVisibility}}" />

                <!-- Both bindings go through InspectorRoot: an element that sets its own DataContext
                     evaluates its other bindings against the new one, so a plain {Binding Scene…}
                     here would be looked up on the layer and silently never resolve. -->
                <StackPanel Margin="16,14,16,20"
                            Visibility="{Binding DataContext.Scene.SelectedLayer, ElementName=InspectorRoot, Converter={StaticResource NotNullToVisibility}}"
                            DataContext="{Binding DataContext.Scene.SelectedLayer, ElementName=InspectorRoot}">

                    <TextBlock Text="NASTAVENÍ OPERACE" Style="{StaticResource InspectorGroupHeader}" Margin="0,0,0,12" />

                    <!-- The name is the first thing about an operation, so it is editable in place
                         rather than behind the context menu. -->
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                             Height="{StaticResource Size.Control.Compact}" Padding="10,0"
                             VerticalContentAlignment="Center" MaxLength="60" Margin="0,0,0,14"
                             ToolTip="Název operace" automation:AutomationProperties.Name="Název operace" />

                    <!-- Everything below is what the machine will actually do, so it goes down with
                         the operation when the operation is excluded from the job. -->
                    <StackPanel IsEnabled="{Binding IsEnabled}">

                        <!--
                            Materiál. The label is what the numbers below it came from, so it reads
                            "Vlastní nastavení" the moment any of them is typed over — see
                            LayerSettings.ForgetMaterial. "Změnit" opens the same grouped recipe menu
                            as before: catalogue plus saved presets. This row is deliberately the one
                            place a richer material picker would later slot into.
                        -->
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Materiál" Style="{StaticResource RowLabel}" />
                            <Button Grid.Column="1" Style="{StaticResource Button.Link}" Padding="0"
                                    Tag="{Binding}" Click="OnApplyMaterialClick"
                                    Content="Změnit →"
                                    ToolTip="Nabídne ověřený výkon a rychlost pro zvolený materiál, poté je lze dál upravit"
                                    automation:AutomationProperties.Name="Změnit materiál a doporučené parametry" />
                        </Grid>
                        <Button Style="{StaticResource Field.Select}" HorizontalAlignment="Stretch" Margin="0,0,0,16"
                                HorizontalContentAlignment="Left"
                                Content="{Binding MaterialDisplayLabel}"
                                Tag="{Binding}" Click="OnApplyMaterialClick"
                                ToolTip="Nabídne ověřený výkon a rychlost pro zvolený materiál, poté je lze dál upravit"
                                automation:AutomationProperties.Name="Materiál a doporučené parametry" />

                        <!-- Režim -->
                        <StackPanel Margin="0,0,0,16"
                                    Visibility="{Binding DataContext.Scene.IsSelectedLayerRaster, ElementName=InspectorRoot, Converter={StaticResource InverseBoolToVisibility}}">
                            <TextBlock Text="Režim zpracování" Style="{StaticResource RowLabel}" Margin="0,0,0,6" />
                            <Border Style="{StaticResource SegmentedTrack}">
                                <UniformGrid Columns="3">
                                    <RadioButton Style="{StaticResource Segment.Compact}" GroupName="LayerModeSegments"
                                                 Content="Čára" ToolTip="Laser projede jen po obrysu tvaru, vhodné pro řezání nebo obrys"
                                                 automation:AutomationProperties.Name="Režim čára"
                                                 IsChecked="{Binding Mode, Converter={StaticResource EnumToBool}, ConverterParameter=Cut, Mode=TwoWay}" />
                                    <RadioButton Style="{StaticResource Segment.Compact}" GroupName="LayerModeSegments"
                                                 Content="Výplň" ToolTip="Laser vyplní celou plochu tvaru řádky, vhodné pro gravírování ploch"
                                                 automation:AutomationProperties.Name="Režim výplň"
                                                 IsChecked="{Binding Mode, Converter={StaticResource EnumToBool}, ConverterParameter=Fill, Mode=TwoWay}" />
                                    <RadioButton Style="{StaticResource Segment.Compact}" GroupName="LayerModeSegments"
                                                 Content="Obojí" ToolTip="Laser nejdřív vyplní plochu a potom projede obrys"
                                                 automation:AutomationProperties.Name="Režim výplň a čára"
                                                 IsChecked="{Binding Mode, Converter={StaticResource EnumToBool}, ConverterParameter=FillAndCut, Mode=TwoWay}" />
                                </UniformGrid>
                            </Border>
                        </StackPanel>

                        <!-- A raster layer has no mode to choose: the image is engraved line by line
                             and nothing else is available. -->
                        <Border Background="{DynamicResource Brush.PanelRaised}" CornerRadius="{StaticResource Radius.Sm}"
                                Padding="10,8" Margin="0,0,0,16"
                                Visibility="{Binding DataContext.Scene.IsSelectedLayerRaster, ElementName=InspectorRoot, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <TextBlock Text="Obrázek · řádkové gravírování" FontWeight="Medium" />
                                <TextBlock Text="Převedeno do černobílého rastru metodou Stucki."
                                           Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Parametry. Slider for reach, field for precision — the field is the value
                             a production job is set by, so it is never the slider alone. -->
                        <components:ParameterSlider Label="Výkon" Unit="%" Margin="0,0,0,16"
                                                    ToolTip="Jak silně laser pálí. Vyšší výkon vypálí hlouběji a tmavěji, u řezání prořízne materiál. Začněte nízkou hodnotou a ověřte ji na odřezku"
                                                    Minimum="0" Maximum="100"
                                                    TickFrequency="1" SmallChange="1" LargeChange="5"
                                                    FieldWidth="88"
                                                    Value="{Binding Power, Mode=TwoWay}" />

                        <components:ParameterSlider Label="Rychlost" Unit="mm/min" Margin="0,0,0,16"
                                                    ToolTip="Jak rychle se hlava pohybuje. Pomalejší pohyb předá materiálu víc energie, takže pálí hlouběji, rychlejší je světlejší a kratší"
                                                    Minimum="10" Maximum="12000"
                                                    TickFrequency="10" SmallChange="10" LargeChange="100"
                                                    FieldWidth="112"
                                                    Value="{Binding Speed, Mode=TwoWay}" />

                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Počet průchodů" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Style="{StaticResource Button.GhostIcon}" Tag="{Binding}" Click="OnPassesDecrementClick"
                                        ToolTip="O jeden průchod méně" automation:AutomationProperties.Name="Ubrat průchod">
                                    <TextBlock Text="−" FontSize="{StaticResource Size.Text.Section}" />
                                </Button>
                                <Border Style="{StaticResource UnitField.Shell}" Width="64"
                                        Height="{StaticResource Size.Control.Compact}"
                                        ToolTip="Kolikrát laser projede stejnou dráhu. Další průchod prohloubí řez nebo gravuru, ale prodlouží čas">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="×" Style="{StaticResource UnitField.Suffix}" />
                                        <TextBox Style="{StaticResource UnitField.Input}" Text="{Binding Passes, StringFormat=0}"
                                                 automation:AutomationProperties.Name="Počet průchodů" />
                                    </DockPanel>
                                </Border>
                                <Button Style="{StaticResource Button.GhostIcon}" Tag="{Binding}" Click="OnPassesIncrementClick"
                                        ToolTip="O jeden průchod víc" automation:AutomationProperties.Name="Přidat průchod">
                                    <TextBlock Text="+" FontSize="{StaticResource Size.Text.Section}" />
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- Interval means nothing to a layer the laser only traces, so the whole
                             row goes down together — an editable field that changes nothing is worse
                             than a visibly unavailable one. It is a permanent row rather than a
                             disclosure: on a fill or a raster it is a primary number, not an
                             occasional one, and hiding it behind a toggle cost a click every time.
                             -->
                        <Grid Style="{StaticResource FillOnlyRow}" Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Interval řádků" VerticalAlignment="Center" />
                            <Border Grid.Column="1" Style="{StaticResource UnitField.Shell}" Width="112"
                                    Height="{StaticResource Size.Control.Compact}"
                                    ToolTip="Rozestup gravírovaných řádků. Menší hodnota znamená jemnější výplň a delší čas.">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="mm" Style="{StaticResource UnitField.Suffix}" />
                                    <TextBox Style="{StaticResource UnitField.Input}"
                                             Text="{Binding FillLineIntervalMm, UpdateSourceTrigger=LostFocus, StringFormat=0.###}"
                                             automation:AutomationProperties.Name="Rozestup řádků v milimetrech" />
                                </DockPanel>
                            </Border>
                        </Grid>

                        <TextBlock Margin="0,14,0,0" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Muted}">
                                    <Setter Property="Text" Value="Laser pojede po obrysu vektoru. Interval se použije až u výplně." />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Mode}" Value="{x:Static layers:LayerMode.Fill}">
                                            <Setter Property="Text" Value="Laser vyplní uzavřenou plochu řádky s daným intervalem." />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Mode}" Value="{x:Static layers:LayerMode.FillAndCut}">
                                            <Setter Property="Text" Value="Laser nejdřív vyplní plochu řádky a potom projede její obrys." />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsRaster}" Value="True">
                                            <Setter Property="Text" Value="Obraz je při importu převeden do černobílého rastru metodou Stucki. Interval určuje vzdálenost gravírovaných řádků." />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>

                    <Button Style="{StaticResource Button.Ghost}" Margin="0,16,0,0" HorizontalAlignment="Left" Padding="0"
                            Command="{Binding DataContext.Scene.DeleteSelectedLayerCommand, ElementName=InspectorRoot}"
                            Foreground="{DynamicResource Brush.Danger}"
                            ToolTipService.ShowOnDisabled="True"
                            ToolTip="{Binding DataContext.Scene.SelectedLayerUsageLabel, ElementName=InspectorRoot}"
                            automation:AutomationProperties.Name="Odstranit operaci">
                        <components:IconLabel IconData="{StaticResource Glyph.Delete}" Text="Odstranit operaci"
                                              IconSize="{StaticResource Size.Icon.Sm}" TextMargin="7,0,0,0" />
                    </Button>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
