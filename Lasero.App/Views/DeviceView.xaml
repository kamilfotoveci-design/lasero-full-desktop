<UserControl x:Class="Lasero.App.Views.DeviceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Lasero.App.Converters"
             xmlns:components="clr-namespace:Lasero.App.Components"
             Loaded="OnLoaded"
             Unloaded="OnUnloaded">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:NotNullToVisibilityConverter x:Key="NotNullToVisibility" />
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
        <conv:MachineModeToLabelConverter x:Key="ModeToLabel" />
        <conv:MachineModeToBrushConverter x:Key="ModeToBrush" />
        <conv:MachineAlertKindToBrushConverter x:Key="AlertKindToBrush" />
        <conv:BooleanToConnectionBrushConverter x:Key="ConnectedToBrush" />
        <conv:EnumToBooleanConverter x:Key="EnumToBool" />
        <conv:JobRunStateToLabelConverter x:Key="JobStateToLabel" />

        <Style x:Key="JogPadButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="54" />
            <Setter Property="Height" Value="54" />
            <Setter Property="MinHeight" Value="54" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="Padding" Value="12" />
        </Style>
        <Style x:Key="JogHomeButton" TargetType="Button" BasedOn="{StaticResource JogPadButton}">
            <Setter Property="Background" Value="{StaticResource Brush.SelectedSurface}" />
            <Setter Property="BorderBrush" Value="{StaticResource Brush.SelectedBorder}" />
            <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
        </Style>
    </UserControl.Resources>

    <components:PageScaffold>
        <components:PageScaffold.Header>
            <components:PageHeader Title="Zařízení" NextStep="{Binding ScreenNextStep}" Subtitle="Připojení, poloha a ruční ovládání gravírky na jednom místě.">
                <components:PageHeader.Actions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Style="{StaticResource Badge.Aligned}" VerticalAlignment="Center" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="8" Height="8" Fill="{Binding Connection.IsConnected, Converter={StaticResource ConnectedToBrush}}" Margin="0,0,8,0" />
                                <TextBlock Text="{Binding Connection.StatusText}" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                        <Button Click="OnDeviceSettingsClick" Height="{StaticResource Size.Control.Base}"
                                ToolTip="Rozměry, pohyb os, připojení a bezpečnost">
                            <components:IconLabel IconData="{StaticResource Glyph.Settings}" Text="Nastavení zařízení" />
                        </Button>
                    </StackPanel>
                </components:PageHeader.Actions>
            </components:PageHeader>
        </components:PageScaffold.Header>
        <components:PageScaffold.Body>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="{StaticResource Layout.PanelColumn}" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <components:ElevatedBorder Style="{StaticResource Card}" Margin="0,0,0,16"
                            Visibility="{Binding Connection.IsConnected, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <components:SectionHeader Level="Card" Title="Stav stroje" />

                            <Border Background="{DynamicResource Brush.Field}"
                                    BorderBrush="{Binding MachineStatus.ActiveAlert.Kind, Converter={StaticResource AlertKindToBrush}}"
                                    BorderThickness="1,1,1,3" CornerRadius="{StaticResource Radius.Md}" Padding="12" Margin="0,0,0,12"
                                    Visibility="{Binding MachineStatus.HasActiveAlert, Converter={StaticResource BoolToVisibility}}">
                                <Grid>
                                    <TextBlock Text="{Binding MachineStatus.ActiveAlert.Message}" TextWrapping="Wrap"
                                               Foreground="{Binding MachineStatus.ActiveAlert.Kind, Converter={StaticResource AlertKindToBrush}}" Margin="0,0,32,0" />
                                    <Button HorizontalAlignment="Right" VerticalAlignment="Top"
                                            Style="{StaticResource Button.Icon}" Width="24" Height="24" Padding="0"
                                            Command="{Binding MachineStatus.DismissAlertCommand}"
                                            ToolTip="Zavřít upozornění" AutomationProperties.Name="Zavřít upozornění">
                                        <components:IconGlyph IconData="{StaticResource Glyph.Close}" Width="{StaticResource Size.Icon.Chrome}" Height="{StaticResource Size.Icon.Chrome}" />
                                    </Button>
                                </Grid>
                            </Border>

                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Režim" Style="{StaticResource Text.Muted}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <Ellipse Width="9" Height="9" Fill="{Binding MachineStatus.Mode, Converter={StaticResource ModeToBrush}}" Margin="0,0,8,0" />
                                        <TextBlock Text="{Binding MachineStatus.Mode, Converter={StaticResource ModeToLabel}}" FontWeight="SemiBold" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Posuv" Style="{StaticResource Text.Muted}" />
                                    <TextBlock FontFamily="{StaticResource Font.Numeric}" FontWeight="SemiBold" Margin="0,4,0,0">
                                        <Run Text="{Binding MachineStatus.FeedRate, StringFormat={}{0:0}, Mode=OneWay}" /><Run Text=" mm/min" />
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Výkon" Style="{StaticResource Text.Muted}" />
                                    <TextBlock FontFamily="{StaticResource Font.Numeric}" FontWeight="SemiBold" Margin="0,4,0,0">
                                        <Run Text="{Binding MachineStatus.SpindleSpeed, StringFormat={}{0:0}, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Background="{DynamicResource Brush.Field}" BorderBrush="{DynamicResource Brush.PanelBorder}" BorderThickness="1" CornerRadius="{StaticResource Radius.Md}" Padding="12">
                                    <StackPanel>
                                        <TextBlock Text="Poloha stroje" Style="{StaticResource Text.Muted}" />
                                        <TextBlock FontFamily="{StaticResource Font.Numeric}" Margin="0,8,0,0">
                                            <Run Text="X " /><Run Text="{Binding MachineStatus.MachineX, StringFormat={}{0:0.000}, Mode=OneWay}" />
                                            <Run Text="   Y " /><Run Text="{Binding MachineStatus.MachineY, StringFormat={}{0:0.000}, Mode=OneWay}" />
                                            <Run Text="   Z " /><Run Text="{Binding MachineStatus.MachineZ, StringFormat={}{0:0.000}, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Background="{DynamicResource Brush.Field}" BorderBrush="{DynamicResource Brush.PanelBorder}" BorderThickness="1" CornerRadius="{StaticResource Radius.Md}" Padding="12">
                                    <StackPanel>
                                        <TextBlock Text="Pracovní poloha" Style="{StaticResource Text.Muted}" />
                                        <TextBlock FontFamily="{StaticResource Font.Numeric}" Margin="0,8,0,0">
                                            <Run Text="X " /><Run Text="{Binding MachineStatus.WorkX, StringFormat={}{0:0.000}, Mode=OneWay}" />
                                            <Run Text="   Y " /><Run Text="{Binding MachineStatus.WorkY, StringFormat={}{0:0.000}, Mode=OneWay}" />
                                            <Run Text="   Z " /><Run Text="{Binding MachineStatus.WorkZ, StringFormat={}{0:0.000}, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <TextBlock Text="{Binding MachineStatus.TriggeredPins, StringFormat=Piny: {0}}" FontFamily="{StaticResource Font.Numeric}"
                                       Foreground="{DynamicResource Brush.Danger}" Margin="0,12,0,0"
                                       Visibility="{Binding MachineStatus.TriggeredPins, Converter={StaticResource NotNullToVisibility}}" />
                        </StackPanel>
                    </components:ElevatedBorder>

                    <!--
                        The guided path first, the manual controls under it. The card states what the
                        connection is doing in one sentence and offers the one action that moves it
                        along; port and baud stay below for the operator who already knows which port
                        their machine is on. Nothing was removed to make room for it.
                    -->
                    <components:ProcessStatusCard Margin="0,0,0,16"
                        Status="{Binding DeviceSetup.Status}"
                        Title="{Binding DeviceSetup.Title}"
                        Description="{Binding DeviceSetup.Description}"
                        ShowsProgress="{Binding DeviceSetup.ShowsProgress}"
                        Progress="{Binding DeviceSetup.Progress}"
                        PrimaryLabel="{Binding DeviceSetup.PrimaryLabel}"
                        PrimaryCommand="{Binding DeviceSetup.PrimaryCommand}"
                        SecondaryLabel="{Binding DeviceSetup.SecondaryLabel}"
                        SecondaryCommand="{Binding DeviceSetup.SecondaryCommand}">
                        <components:ProcessStatusCard.Meta>
                            <ItemsControl ItemsSource="{Binding DeviceSetup.Details}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Label}" Style="{StaticResource Text.Muted}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Value}" FontWeight="Medium"
                                                       TextTrimming="CharacterEllipsis" MaxWidth="220" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </components:ProcessStatusCard.Meta>
                    </components:ProcessStatusCard>

                    <components:ElevatedBorder Style="{StaticResource Card}" Margin="0,0,0,16">
                        <StackPanel>
                            <components:SectionHeader Level="Card" Title="Ruční připojení" />
                            <TextBlock Text="Přenos probíhá přes zvolený port COM. Číslo portu je v části Porty ve Správci zařízení Windows; obvyklá rychlost přenosu je 115200 Bd."
                                       Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,0,0,12" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Sériový port" Style="{StaticResource Text.Muted}" />
                                    <!-- The refresh button used to overlay the right end of the combo and hid its chevron. It now has its own
                                         column, at the combo's height. -->
                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ComboBox ItemsSource="{Binding Connection.PortOptions}" SelectedItem="{Binding Connection.SelectedPortOption}" DisplayMemberPath="Display"
                                                  IsEnabled="{Binding Connection.IsConnected, Converter={StaticResource InverseBoolConverter}}" />
                                        <Button Grid.Column="1" Width="{StaticResource Size.Control.Base}" Height="{StaticResource Size.Control.Base}" Margin="8,0,0,0" Style="{StaticResource Button.Icon}"
                                                Command="{Binding Connection.RefreshPortsCommand}" ToolTip="Obnovit porty"
                                                AutomationProperties.Name="Obnovit porty">
                                            <components:IconGlyph IconData="{StaticResource Glyph.Refresh}" Width="{StaticResource Size.Icon.Sm}" Height="{StaticResource Size.Icon.Sm}" />
                                        </Button>
                                    </Grid>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Přenosová rychlost" Style="{StaticResource Text.Muted}" />
                                    <ComboBox ItemsSource="{Binding Connection.CommonBaudRates}" SelectedItem="{Binding Connection.BaudRate}"
                                              IsEnabled="{Binding Connection.IsConnected, Converter={StaticResource InverseBoolConverter}}" Margin="0,4,0,0" />
                                </StackPanel>
                            </Grid>
                            <Border Background="{StaticResource Brush.InfoMuted}" BorderBrush="{StaticResource Brush.InfoBorder}" BorderThickness="1" CornerRadius="{StaticResource Radius.Md}"
                                    Padding="12" Margin="0,12,0,0"
                                    Visibility="{Binding Connection.IsVirtualMachineSelected, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel Orientation="Horizontal">
                                    <components:IconGlyph IconData="{StaticResource Glyph.Info}" Width="{StaticResource Size.Icon.Md}" Height="{StaticResource Size.Icon.Md}"
                                                          Foreground="{StaticResource Brush.TextPrimary}" Margin="0,0,8,0" />
                                    <StackPanel>
                                        <TextBlock Text="Virtuální laser" FontWeight="SemiBold" />
                                        <TextBlock Text="Bezpečný testovací režim. Aplikace neotevře žádný fyzický port a laser se nemůže zapnout."
                                                   Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource Brush.Field}"
                                    BorderBrush="{DynamicResource Brush.PanelBorder}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource Radius.Md}"
                                    Padding="12"
                                    Margin="0,12,0,0"
                                    Visibility="{Binding Connection.HasAvailablePorts, Converter={StaticResource InverseBoolToVisibility}}">
                                <!-- DockPanel, not a horizontal StackPanel: a StackPanel measures its children with
                             infinite width, so TextWrapping never engages and the sentence is cut off at
                             the panel edge. -->
<DockPanel>
                                    <components:IconGlyph DockPanel.Dock="Left" VerticalAlignment="Top" IconData="{StaticResource Glyph.Info}" Width="{StaticResource Size.Icon.Md}" Height="{StaticResource Size.Icon.Md}" Margin="0,0,8,0" Foreground="{DynamicResource Brush.TextSecondary}" />
                                    <TextBlock Text="Nebyl nalezen žádný sériový port. Gravírka se po připojení datovým kabelem USB zobrazí jako port COM. Dostupné porty lze znovu vyhledat tlačítkem Obnovit porty."
                                               Style="{StaticResource Text.Muted}" TextWrapping="Wrap" />
                                </DockPanel>
                            </Border>
                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                <Button Style="{StaticResource Button.Secondary}"
                                        Command="{Binding Connection.ConnectSelectedCommand}" Margin="0,0,8,0"
                                        Visibility="{Binding Connection.IsConnected, Converter={StaticResource InverseBoolToVisibility}}">
                                    <Grid>
                                        <components:IconLabel IconData="{StaticResource Glyph.Connect}" Text="{Binding Connection.ConnectButtonText}"
                                                              Visibility="{Binding Connection.IsConnecting, Converter={StaticResource InverseBoolToVisibility}}" />
                                        <TextBlock Text="Připojování…" FontWeight="SemiBold"
                                                   Visibility="{Binding Connection.IsConnecting, Converter={StaticResource BoolToVisibility}}" />
                                    </Grid>
                                </Button>
                            </StackPanel>
                            <TextBlock Text="{Binding Connection.DetectedMachineText}" Style="{StaticResource Text.Muted}" Margin="0,12,0,0"
                                       AutomationProperties.Name="Zjištěné zařízení" />
                            <TextBlock Text="{Binding Connection.FirmwareBanner}" Style="{StaticResource Text.Muted}" FontFamily="{StaticResource Font.Numeric}"
                                       TextWrapping="Wrap" Margin="0,12,0,0"
                                       Visibility="{Binding Connection.FirmwareBanner, Converter={StaticResource NotNullToVisibility}}" />
                            <TextBlock Text="{Binding Connection.IdentificationMessage}" Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Visibility="{Binding Connection.IdentificationMessage, Converter={StaticResource NotNullToVisibility}}" />
                        </StackPanel>
                    </components:ElevatedBorder>

                    <components:ElevatedBorder Style="{StaticResource Card}">
                        <StackPanel>
                            <components:SectionHeader Level="Card" Title="Pracovní plocha" />
                            <TextBlock Text="Rozměry se po připojení načtou přímo z nastavení GRBL ($130 a $131)."
                                       Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,0,0,12" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{StaticResource Font.Numeric}" FontSize="{StaticResource Size.Text.Section}" FontWeight="SemiBold">
                                    <Run Text="{Binding Connection.WorkAreaWidthMm, StringFormat={}{0:0.#}, Mode=OneWay}" />
                                    <Run Text=" × " />
                                    <Run Text="{Binding Connection.WorkAreaHeightMm, StringFormat={}{0:0.#}, Mode=OneWay}" />
                                    <Run Text=" mm" />
                                </TextBlock>
                            </StackPanel>
                            <!-- Same reason as the job panel: the material is recorded when a recipe is
                                 applied, not typed here. An empty box under the work area read as an
                                 unfinished setting the operator was expected to fill in. -->
                        </StackPanel>
                    </components:ElevatedBorder>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <components:ElevatedBorder Style="{StaticResource Card}" Margin="0,0,0,16">
                        <StackPanel>
                            <components:SectionHeader Level="Card" Title="Ruční posun stroje" />
                            <TextBlock Style="{StaticResource Text.EmptyLine}" Text="Po připojení se zpřístupní ruční posun os."
                               Visibility="{Binding Connection.IsConnected, Converter={StaticResource InverseBoolToVisibility}}" />
                            <StackPanel Visibility="{Binding Connection.IsConnected, Converter={StaticResource BoolToVisibility}}">
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Vzdálenost XY (mm)" Style="{StaticResource Text.Muted}" />
                                    <ComboBox ItemsSource="{Binding Jog.StepSizePresets}" SelectedItem="{Binding Jog.StepSizeMm}" Margin="0,4,0,0" ToolTip="Vzdálenost jednoho posunu os X a Y v milimetrech" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Rychlost XY (mm/min)" Style="{StaticResource Text.Muted}" />
                                    <TextBox Text="{Binding Jog.JogFeedRate, UpdateSourceTrigger=PropertyChanged, StringFormat=0}" Margin="0,4,0,0" ToolTip="Rychlost ručního posunu os X a Y v mm/min" />
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="18" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <Grid HorizontalAlignment="Center">
                                    <Grid.RowDefinitions><RowDefinition Height="60" /><RowDefinition Height="60" /><RowDefinition Height="60" /></Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="60" /><ColumnDefinition Width="60" /><ColumnDefinition Width="60" /></Grid.ColumnDefinitions>

                                    <Button Grid.Row="0" Grid.Column="0" Style="{StaticResource JogPadButton}" Command="{Binding Jog.JogXNegYPosCommand}" ToolTip="Posunout vlevo nahoru" AutomationProperties.Name="Posunout vlevo nahoru"><components:IconGlyph IconData="{StaticResource Glyph.ArrowUpLeft}" Width="{StaticResource Size.Icon.Md}" Height="{StaticResource Size.Icon.Md}" /></Button>
                                    <Button Grid.Row="0" Grid.Column="1" Style="{StaticResource JogPadButton}" Command="{Binding Jog.JogYPosCommand}" ToolTip="Posunout hlavu nahoru (osa Y plus)" AutomationProperties.Name="Posunout nahoru"><components:IconGlyph IconData="{StaticResource Glyph.ArrowUp}" Width="{StaticResource Size.Icon.Md}" Height="{StaticResource Size.Icon.Md}" /></Button>
                                    <Button Grid.Row="0" Grid.Column="2" Style="{StaticResource JogPadButton}" Command="{Binding Jog.JogXPosYPosCommand}" ToolTip="Posunout vpravo nahoru" AutomationProperties.Name="Posunout vpravo nahoru"><components:IconGlyph IconData="{StaticResource Glyph.ArrowUpRight}" Width="{StaticResource Size.Icon.Md}" Height="{StaticResource Size.Icon.Md}" /></Button>
                                    <Button Grid.Row="1" Grid.Column="0" Style="{StaticResource JogPadButton}" Command="{Binding Jog.JogXNegCommand}" ToolTip="Posunout hlavu vlevo (osa X minus)" AutomationProperties.Name="Posunout vlevo"><components:IconGlyph IconData="{StaticResource Glyph.ArrowLeft}" Width="{StaticResource Size.Icon.Md}" Height="{StaticResource Size.Icon.Md}" /></Button>
                                    <Button Grid.Row="1" Grid.Column="1" Style="{StaticResource JogHomeButton}" Command="{Binding Jog.HomeCommand}" ToolTip="Hlava se přesune do výchozí polohy. Uvolněte pracovní prostor" AutomationProperties.Name="Najet do výchozí polohy"><components:IconGlyph IconData="{StaticResource Glyph.MachineHome}" Width="{StaticResource Size.Icon.Md}" Height="{StaticResource Size.Icon.Md}" /></Button>
                                    <Button Grid.Row="1" Grid.Column="2" Style="{StaticResource JogPadButton}" Command="{Binding Jog.JogXPosCommand}" ToolTip="Posunout hlavu vpravo (osa X plus)" AutomationProperties.Name="Posunout vpravo"><components:IconGlyph IconData="{StaticResource Glyph.ArrowRight}" Width="{StaticResource Size.Icon.Md}" Height="{StaticResource Size.Icon.Md}" /></Button>
                                    <Button Grid.Row="2" Grid.Column="0" Style="{StaticResource JogPadButton}" Command="{Binding Jog.JogXNegYNegCommand}" ToolTip="Posunout vlevo dolů" AutomationProperties.Name="Posunout vlevo dolů"><components:IconGlyph IconData="{StaticResource Glyph.ArrowDownLeft}" Width="{StaticResource Size.Icon.Md}" Height="{StaticResource Size.Icon.Md}" /></Button>
                                    <Button Grid.Row="2" Grid.Column="1" Style="{StaticResource JogPadButton}" Command="{Binding Jog.JogYNegCommand}" ToolTip="Posunout hlavu dolů (osa Y minus)" AutomationProperties.Name="Posunout dolů"><components:IconGlyph IconData="{StaticResource Glyph.ArrowDown}" Width="{StaticResource Size.Icon.Md}" Height="{StaticResource Size.Icon.Md}" /></Button>
                                    <Button Grid.Row="2" Grid.Column="2" Style="{StaticResource JogPadButton}" Command="{Binding Jog.JogXPosYNegCommand}" ToolTip="Posunout vpravo dolů" AutomationProperties.Name="Posunout vpravo dolů"><components:IconGlyph IconData="{StaticResource Glyph.ArrowDownRight}" Width="{StaticResource Size.Icon.Md}" Height="{StaticResource Size.Icon.Md}" /></Button>
                                </Grid>

                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock Text="OSA Z" Style="{StaticResource Text.Heading}" HorizontalAlignment="Center" Margin="0,0,0,4" />
                                    <Button Style="{StaticResource JogPadButton}" Command="{Binding Jog.JogZPosCommand}" ToolTip="Zvednout osu Z, vzdálí se od materiálu" AutomationProperties.Name="Zvednout osu Z"><components:IconGlyph IconData="{StaticResource Glyph.ArrowUp}" Width="{StaticResource Size.Icon.Md}" Height="{StaticResource Size.Icon.Md}" /></Button>
                                    <Button Style="{StaticResource JogPadButton}" Command="{Binding Jog.JogZNegCommand}" ToolTip="Spustit osu Z, přiblíží se k materiálu" AutomationProperties.Name="Spustit osu Z"><components:IconGlyph IconData="{StaticResource Glyph.ArrowDown}" Width="{StaticResource Size.Icon.Md}" Height="{StaticResource Size.Icon.Md}" /></Button>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Vzdálenost Z (mm)" Style="{StaticResource Text.Muted}" />
                                    <ComboBox ItemsSource="{Binding Jog.StepSizePresets}" SelectedItem="{Binding Jog.ZStepSizeMm}" Margin="0,4,0,0" ToolTip="Vzdálenost jednoho posunu osy Z v milimetrech" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Rychlost Z (mm/min)" Style="{StaticResource Text.Muted}" />
                                    <TextBox Text="{Binding Jog.ZJogFeedRate, UpdateSourceTrigger=PropertyChanged, StringFormat=0}" Margin="0,4,0,0" ToolTip="Rychlost ručního posunu osy Z v mm/min" />
                                </StackPanel>
                            </Grid>

                            <Button Command="{Binding Jog.CancelJogCommand}" Style="{StaticResource Button.Danger}" Margin="0,0,0,8" ToolTip="Okamžitě zrušit právě probíhající ruční posun">
                                <components:IconLabel IconData="{StaticResource Glyph.Stop}" Text="Zastavit ruční pohyb" />
                            </Button>

                            <!-- One column: at 312 px a pair of these labels ("Odemknout ($X)", "Nastavit nulu zde") is cut off, and a
                                 cut-off machine command is worse than a taller list. -->
                            <StackPanel>
                                <Button Command="{Binding Jog.HomeCommand}" Margin="0,0,0,8"><components:IconLabel IconData="{StaticResource Glyph.MachineHome}" Text="Najet domů" /></Button>
                                <Button Style="{StaticResource Button.Secondary}" Command="{Binding Jog.UnlockCommand}" Margin="0,0,0,8"><components:IconLabel IconData="{StaticResource Glyph.Unlock}" Text="Odemknout ($X)" /></Button>
                                <Button Style="{StaticResource Button.Secondary}" Command="{Binding Jog.SetOriginHereCommand}" Margin="0,0,0,8"><components:IconLabel IconData="{StaticResource Glyph.Origin}" Text="Nastavit nulu zde" /></Button>
                                <Button Style="{StaticResource Button.Secondary}" Command="{Binding Jog.GoToWorkZeroCommand}"><components:IconLabel IconData="{StaticResource Glyph.Origin}" Text="Přejít na nulu XY" /></Button>
                            </StackPanel>
                            <Expander Header="Pokročilé ovládání" Margin="0,12,0,0">
                                <Button Style="{StaticResource Button.Danger}" Command="{Binding Jog.SoftResetCommand}" Margin="0,8,0,0"
                                        ToolTip="Resetuje řídicí jednotku stroje. Použijte pouze při chybě nebo nereagujícím zařízení.">
                                    <components:IconLabel IconData="{StaticResource Glyph.Refresh}" Text="Resetovat řídicí jednotku" />
                                </Button>
                            </Expander>
                            <TextBlock Text="{Binding Jog.LastActionMessage}" Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,12,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </components:ElevatedBorder>

                    <components:ElevatedBorder Style="{StaticResource Card}" Margin="0,0,0,16"
                            Visibility="{Binding Connection.IsConnected, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Příprava gravírování" Style="{StaticResource PanelTitle}" Margin="0" />
                                    <TextBlock Text="Před spuštěním zkontrolujte umístění návrhu na materiálu." Style="{StaticResource Text.Muted}" Margin="0,4,0,0" />
                                </StackPanel>
                                <Border Grid.Column="1" Style="{StaticResource Badge}" Padding="8,4" VerticalAlignment="Top">
                                    <TextBlock Text="{Binding GCode.JobState, Converter={StaticResource JobStateToLabel}}" FontWeight="SemiBold" />
                                </Border>
                            </Grid>

                            <Border Background="{StaticResource Brush.Field}" BorderBrush="{StaticResource Brush.PanelBorder}" BorderThickness="1" CornerRadius="{StaticResource Radius.Md}" Padding="12">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Návrh k výrobě" Style="{StaticResource Text.Muted}" />
                                        <TextBlock Text="{Binding GCode.FileLabel}" FontWeight="SemiBold" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding GCode.FileLabel}" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <ProgressBar Value="{Binding GCode.ProgressPercent}" Height="4" Margin="0,12,0,0" />
                            <TextBlock Margin="0,8,0,0" Style="{StaticResource Text.Muted}">
                                <Run Text="Řádek " /><Run Text="{Binding GCode.CurrentLine}" /><Run Text=" z " /><Run Text="{Binding GCode.TotalLines}" />
                            </TextBlock>

                            <Border Height="1" Background="{StaticResource Brush.PanelBorder}" Margin="0,16" />
                            <TextBlock Text="Kontrola umístění" FontWeight="SemiBold" Margin="0,0,0,8" />
                            <Border Style="{StaticResource SegmentedTrack}" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <RadioButton Content="Obrys návrhu" Style="{StaticResource Segment}" HorizontalContentAlignment="Stretch"
                                                 IsChecked="{Binding GCode.FramingMode, Mode=TwoWay, Converter={StaticResource EnumToBool}, ConverterParameter=FullOutline}" />
                                    <RadioButton Grid.Column="1" Content="Pouze rohy" Style="{StaticResource Segment}" HorizontalContentAlignment="Stretch"
                                                 IsChecked="{Binding GCode.FramingMode, Mode=TwoWay, Converter={StaticResource EnumToBool}, ConverterParameter=CornersOnly}" />
                                </Grid>
                            </Border>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Rychlost rámování (mm/min)" Style="{StaticResource Text.Muted}" />
                                    <TextBox Text="{Binding GCode.FramingFeedRate, UpdateSourceTrigger=PropertyChanged, StringFormat=0}" Margin="0,4,0,0" />
                                </StackPanel>
                                <Border Grid.Column="2" Background="{StaticResource Brush.SuccessMuted}" BorderBrush="{StaticResource Brush.InfoBorder}" BorderThickness="1" CornerRadius="{StaticResource Radius.Md}" Padding="12" VerticalAlignment="Bottom">
                                    <StackPanel Orientation="Horizontal">
                                        <components:IconGlyph IconData="{StaticResource Glyph.Check}" Width="{StaticResource Size.Icon.Sm}" Height="{StaticResource Size.Icon.Sm}" Foreground="{StaticResource Brush.Success}" Margin="0,0,8,0" />
                                        <TextBlock Text="Laser zůstane vypnutý" Foreground="{StaticResource Brush.Success}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <Button Style="{StaticResource Button.Outline}" Command="{Binding GCode.RunFramingCommand}" Margin="0,0,0,12" ToolTip="Projet obrys úlohy a ověřit její umístění">
                                <components:IconLabel IconData="{StaticResource Glyph.Frame}" Text="Zkontrolovat oblast" />
                            </Button>

                            <Border Background="{StaticResource Brush.InfoMuted}" BorderBrush="{StaticResource Brush.InfoBorder}" BorderThickness="1" CornerRadius="{StaticResource Radius.Md}" Padding="12" Margin="0,0,0,12">
                                <!-- DockPanel, not a horizontal StackPanel: a StackPanel measures its children with
                             infinite width, so TextWrapping never engages and the sentence is cut off at
                             the panel edge. -->
<DockPanel>
                                    <components:IconGlyph DockPanel.Dock="Left" VerticalAlignment="Top" IconData="{StaticResource Glyph.Origin}" Width="{StaticResource Size.Icon.Sm}" Height="{StaticResource Size.Icon.Sm}" Foreground="{StaticResource Brush.Info}" Margin="0,0,8,0" />
                                    <TextBlock Text="Začátek úlohy je nastaven na pracovní nulu stroje." Foreground="{StaticResource Brush.Info}" TextWrapping="Wrap" />
                                </DockPanel>
                            </Border>

                            <TextBlock Text="{Binding GCode.PreflightMessage}" Foreground="{StaticResource Brush.Danger}" TextWrapping="Wrap" Margin="0,0,0,12"
                                       Visibility="{Binding GCode.PreflightMessage, Converter={StaticResource NotNullToVisibility}}" />
                            <TextBlock Text="{Binding GCode.LastMessage}" Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,0,0,12"
                                       Visibility="{Binding GCode.LastMessage, Converter={StaticResource NotNullToVisibility}}" />

                            <TextBlock Text="Spuštění, pozastavení a zastavení úlohy najdete vždy ve spodní liště."
                                       Style="{StaticResource Text.Muted}" TextWrapping="Wrap" />
                        </StackPanel>
                    </components:ElevatedBorder>

                    <components:ElevatedBorder Style="{StaticResource Card}"
                            Visibility="{Binding Connection.IsConnected, Converter={StaticResource BoolToVisibility}}">
                        <Expander IsExpanded="False">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal">
                                    <components:IconGlyph IconData="{StaticResource Glyph.Terminal}" Width="{StaticResource Size.Icon.Md}" Height="{StaticResource Size.Icon.Md}" Margin="0,0,8,0" />
                                    <TextBlock Text="Pokročilé: konzola GRBL" FontWeight="SemiBold" FontSize="{StaticResource Size.Text.Body}" />
                                </StackPanel>
                            </Expander.Header>
                        <Grid Height="240" Margin="0,16,0,0">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <TextBlock Text="Přímé příkazy používejte pouze tehdy, pokud znáte GRBL."
                                       Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,0,0,8" />
                            <Border Grid.Row="1" Background="{DynamicResource Brush.Field}" BorderBrush="{DynamicResource Brush.PanelBorder}" BorderThickness="1" CornerRadius="{StaticResource Radius.Md}">
                                <ScrollViewer x:Name="ConsoleScroll" VerticalScrollBarVisibility="Auto" Padding="12">
                                    <ItemsControl ItemsSource="{Binding Console.Lines}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" FontFamily="{StaticResource Font.Mono}" FontSize="{StaticResource Size.Text.Meta}" TextWrapping="Wrap" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>
                            <Grid Grid.Row="2" Margin="0,8,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBox FontFamily="{StaticResource Font.Mono}" Text="{Binding Console.CommandInput, UpdateSourceTrigger=PropertyChanged}"
                                         KeyDown="OnConsoleInputKeyDown" ToolTip="Příkaz GRBL" />
                                <Button Grid.Column="1" Command="{Binding Console.SendCommand}" Margin="8,0,0,0" Padding="16,0">
                                    <components:IconLabel IconData="{StaticResource Glyph.Send}" Text="Odeslat" />
                                </Button>
                            </Grid>
                        </Grid>
                        </Expander>
                    </components:ElevatedBorder>
                </StackPanel>
            </Grid>
        </components:PageScaffold.Body>
    </components:PageScaffold>
</UserControl>
