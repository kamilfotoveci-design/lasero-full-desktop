<UserControl x:Class="Lasero.App.Views.DeviceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Lasero.App.Converters"
             xmlns:components="clr-namespace:Lasero.App.Components"
             Loaded="OnLoaded"
             Unloaded="OnUnloaded">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:NotNullToVisibilityConverter x:Key="NotNullToVisibility" />
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
        <conv:MachineModeToLabelConverter x:Key="ModeToLabel" />
        <conv:MachineModeToBrushConverter x:Key="ModeToBrush" />
        <conv:MachineAlertKindToBrushConverter x:Key="AlertKindToBrush" />
        <conv:BooleanToConnectionBrushConverter x:Key="ConnectedToBrush" />
        <conv:EnumToBooleanConverter x:Key="EnumToBool" />
        <conv:JobRunStateToLabelConverter x:Key="JobStateToLabel" />

        <Style x:Key="JogPadButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="54" />
            <Setter Property="Height" Value="54" />
            <Setter Property="MinHeight" Value="54" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="Padding" Value="12" />
        </Style>
        <Style x:Key="JogHomeButton" TargetType="Button" BasedOn="{StaticResource JogPadButton}">
            <Setter Property="Background" Value="{StaticResource Brush.WarmAccentMuted}" />
            <Setter Property="BorderBrush" Value="{StaticResource Brush.WarmAccentBorder}" />
            <Setter Property="Foreground" Value="{StaticResource Brush.WarmAccent}" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
        <StackPanel Margin="0,0,0,24">
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Zařízení" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="Připojení, poloha a ruční ovládání gravírky na jednom místě."
                               Style="{StaticResource PageSubtitle}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Style="{StaticResource Badge}" VerticalAlignment="Center" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="{Binding Connection.IsConnected, Converter={StaticResource ConnectedToBrush}}" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding Connection.StatusText}" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                    <Button Click="OnDeviceSettingsClick"
                            ToolTip="Rozměry, pohyb os, připojení a bezpečnost">
                        <components:IconLabel IconData="{StaticResource Glyph.Settings}" Text="Nastavení zařízení" />
                    </Button>
                </StackPanel>
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <Border Style="{StaticResource Card}" Margin="0,0,0,16"
                            Visibility="{Binding Connection.IsConnected, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="Stav stroje" Style="{StaticResource PanelTitle}" FontSize="16" />

                            <Border Background="{DynamicResource Brush.Field}"
                                    BorderBrush="{Binding MachineStatus.ActiveAlert.Kind, Converter={StaticResource AlertKindToBrush}}"
                                    BorderThickness="1,1,1,3" CornerRadius="8" Padding="12" Margin="0,0,0,12"
                                    Visibility="{Binding MachineStatus.HasActiveAlert, Converter={StaticResource BoolToVisibility}}">
                                <Grid>
                                    <TextBlock Text="{Binding MachineStatus.ActiveAlert.Message}" TextWrapping="Wrap"
                                               Foreground="{Binding MachineStatus.ActiveAlert.Kind, Converter={StaticResource AlertKindToBrush}}" Margin="0,0,30,0" />
                                    <Button HorizontalAlignment="Right" VerticalAlignment="Top"
                                            Style="{StaticResource Button.Icon}" Width="24" Height="24" Padding="0"
                                            Command="{Binding MachineStatus.DismissAlertCommand}"
                                            ToolTip="Zavřít upozornění" AutomationProperties.Name="Zavřít upozornění">
                                        <components:IconGlyph IconData="{StaticResource Glyph.Close}" Width="13" Height="13" />
                                    </Button>
                                </Grid>
                            </Border>

                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Režim" Style="{StaticResource Text.Muted}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <Ellipse Width="9" Height="9" Fill="{Binding MachineStatus.Mode, Converter={StaticResource ModeToBrush}}" Margin="0,0,7,0" />
                                        <TextBlock Text="{Binding MachineStatus.Mode, Converter={StaticResource ModeToLabel}}" FontWeight="SemiBold" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Posuv" Style="{StaticResource Text.Muted}" />
                                    <TextBlock FontFamily="{StaticResource Font.Mono}" FontWeight="SemiBold" Margin="0,5,0,0">
                                        <Run Text="{Binding MachineStatus.FeedRate, StringFormat={}{0:0}, Mode=OneWay}" /><Run Text=" mm/min" />
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Výkon" Style="{StaticResource Text.Muted}" />
                                    <TextBlock FontFamily="{StaticResource Font.Mono}" FontWeight="SemiBold" Margin="0,5,0,0">
                                        <Run Text="{Binding MachineStatus.SpindleSpeed, StringFormat={}{0:0}, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Background="{DynamicResource Brush.Field}" BorderBrush="{DynamicResource Brush.PanelBorder}" BorderThickness="1" CornerRadius="8" Padding="12">
                                    <StackPanel>
                                        <TextBlock Text="Poloha stroje" Style="{StaticResource Text.Muted}" />
                                        <TextBlock FontFamily="{StaticResource Font.Mono}" Margin="0,7,0,0">
                                            <Run Text="X " /><Run Text="{Binding MachineStatus.MachineX, StringFormat={}{0:0.000}, Mode=OneWay}" />
                                            <Run Text="   Y " /><Run Text="{Binding MachineStatus.MachineY, StringFormat={}{0:0.000}, Mode=OneWay}" />
                                            <Run Text="   Z " /><Run Text="{Binding MachineStatus.MachineZ, StringFormat={}{0:0.000}, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Background="{DynamicResource Brush.Field}" BorderBrush="{DynamicResource Brush.PanelBorder}" BorderThickness="1" CornerRadius="8" Padding="12">
                                    <StackPanel>
                                        <TextBlock Text="Pracovní poloha" Style="{StaticResource Text.Muted}" />
                                        <TextBlock FontFamily="{StaticResource Font.Mono}" Margin="0,7,0,0">
                                            <Run Text="X " /><Run Text="{Binding MachineStatus.WorkX, StringFormat={}{0:0.000}, Mode=OneWay}" />
                                            <Run Text="   Y " /><Run Text="{Binding MachineStatus.WorkY, StringFormat={}{0:0.000}, Mode=OneWay}" />
                                            <Run Text="   Z " /><Run Text="{Binding MachineStatus.WorkZ, StringFormat={}{0:0.000}, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <TextBlock Text="{Binding MachineStatus.TriggeredPins, StringFormat=Piny: {0}}" FontFamily="{StaticResource Font.Mono}"
                                       Foreground="{DynamicResource Brush.Danger}" Margin="0,12,0,0"
                                       Visibility="{Binding MachineStatus.TriggeredPins, Converter={StaticResource NotNullToVisibility}}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <components:IconGlyph IconData="{StaticResource Glyph.Connect}" Width="18" Height="18" Margin="0,0,8,0" />
                                <TextBlock Text="Připojení zařízení" Style="{StaticResource PanelTitle}" FontSize="16" Margin="0" />
                            </StackPanel>
                            <TextBlock Text="Vyberte nalezený port. Po připojení Lasero automaticky načte typ zařízení a rozměry pracovní plochy."
                                       Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,0,0,12" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Sériový port" Style="{StaticResource Text.Muted}" />
                                    <Grid Margin="0,5,0,0">
                                        <ComboBox ItemsSource="{Binding Connection.AvailablePorts}" SelectedItem="{Binding Connection.SelectedPort}"
                                                  IsEnabled="{Binding Connection.IsConnected, Converter={StaticResource InverseBoolConverter}}" />
                                        <Button Width="32" Height="32" HorizontalAlignment="Right" Style="{StaticResource Button.Icon}"
                                                Command="{Binding Connection.RefreshPortsCommand}" ToolTip="Obnovit porty"
                                                AutomationProperties.Name="Obnovit porty">
                                            <components:IconGlyph IconData="{StaticResource Glyph.Refresh}" Width="16" Height="16" />
                                        </Button>
                                    </Grid>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Přenosová rychlost" Style="{StaticResource Text.Muted}" />
                                    <ComboBox ItemsSource="{Binding Connection.CommonBaudRates}" SelectedItem="{Binding Connection.BaudRate}"
                                              IsEnabled="{Binding Connection.IsConnected, Converter={StaticResource InverseBoolConverter}}" Margin="0,5,0,0" />
                                </StackPanel>
                            </Grid>
                            <Border Background="{StaticResource Brush.InfoMuted}" BorderBrush="{StaticResource Brush.InfoBorder}" BorderThickness="1" CornerRadius="8"
                                    Padding="12" Margin="0,12,0,0"
                                    Visibility="{Binding Connection.IsVirtualMachineSelected, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel Orientation="Horizontal">
                                    <components:IconGlyph IconData="{StaticResource Glyph.Info}" Width="17" Height="17"
                                                          Foreground="{StaticResource Brush.Accent}" Margin="0,1,9,0" />
                                    <StackPanel>
                                        <TextBlock Text="Virtuální laser" FontWeight="SemiBold" />
                                        <TextBlock Text="Bezpečný testovací režim. Aplikace neotevře žádný fyzický port a laser se nemůže zapnout."
                                                   Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,3,0,0" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource Brush.Field}"
                                    BorderBrush="{DynamicResource Brush.PanelBorder}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="12"
                                    Margin="0,12,0,0"
                                    Visibility="{Binding Connection.HasAvailablePorts, Converter={StaticResource InverseBoolToVisibility}}">
                                <StackPanel Orientation="Horizontal">
                                    <components:IconGlyph IconData="{StaticResource Glyph.Info}" Width="17" Height="17" Margin="0,0,9,0" Foreground="{DynamicResource Brush.TextSecondary}" />
                                    <TextBlock Text="Nebyl nalezen žádný sériový port. Připojte gravírku přes USB a zvolte Obnovit porty."
                                               Style="{StaticResource Text.Muted}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <Button Style="{StaticResource Button.Primary}"
                                        Command="{Binding Connection.ConnectCommand}" Margin="0,0,8,0"
                                        Visibility="{Binding Connection.IsConnected, Converter={StaticResource InverseBoolToVisibility}}">
                                    <Grid>
                                        <components:IconLabel IconData="{StaticResource Glyph.Connect}" Text="Připojit zařízení" Foreground="White"
                                                              Visibility="{Binding Connection.IsConnecting, Converter={StaticResource InverseBoolToVisibility}}" />
                                        <TextBlock Text="Připojuji…" Foreground="White" FontWeight="SemiBold"
                                                   Visibility="{Binding Connection.IsConnecting, Converter={StaticResource BoolToVisibility}}" />
                                    </Grid>
                                </Button>
                                <Button Command="{Binding Connection.DisconnectCommand}"
                                        Visibility="{Binding Connection.IsConnected, Converter={StaticResource BoolToVisibility}}">
                                    <components:IconLabel IconData="{StaticResource Glyph.Disconnect}" Text="Odpojit" />
                                </Button>
                            </StackPanel>
                            <TextBlock Text="{Binding Connection.FirmwareBanner}" Style="{StaticResource Text.Muted}" FontFamily="{StaticResource Font.Mono}"
                                       TextWrapping="Wrap" Margin="0,12,0,0"
                                       Visibility="{Binding Connection.FirmwareBanner, Converter={StaticResource NotNullToVisibility}}" />
                            <TextBlock Text="{Binding Connection.IdentificationMessage}" Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,5,0,0"
                                       Visibility="{Binding Connection.IdentificationMessage, Converter={StaticResource NotNullToVisibility}}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Pracovní plocha" Style="{StaticResource PanelTitle}" FontSize="16" />
                            <TextBlock Text="Rozměry se po připojení načtou přímo z nastavení GRBL ($130 a $131)."
                                       Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,0,0,12" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{StaticResource Font.Mono}" FontSize="18" FontWeight="SemiBold">
                                    <Run Text="{Binding Connection.WorkAreaWidthMm, StringFormat={}{0:0.#}, Mode=OneWay}" />
                                    <Run Text=" × " />
                                    <Run Text="{Binding Connection.WorkAreaHeightMm, StringFormat={}{0:0.#}, Mode=OneWay}" />
                                    <Run Text=" mm" />
                                </TextBlock>
                            </StackPanel>
                            <Border Height="1" Background="{DynamicResource Brush.PanelBorder}" Margin="0,16,0,14" />
                            <TextBlock Text="Materiál obrobku" Style="{StaticResource Text.Muted}" />
                            <TextBox Text="{Binding MaterialName, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,0"
                                     ToolTip="Například překližka 3 mm. Materiál se uloží do historie úlohy." />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Ruční posun stroje" Style="{StaticResource PanelTitle}" FontSize="16" />
                            <Border Background="{StaticResource Brush.Field}" BorderBrush="{StaticResource Brush.PanelBorder}"
                                    BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,4"
                                    Visibility="{Binding Connection.IsConnected, Converter={StaticResource InverseBoolToVisibility}}">
                                <StackPanel Orientation="Horizontal">
                                    <components:IconGlyph IconData="{StaticResource Glyph.Connect}" Width="18" Height="18" Margin="0,1,10,0" />
                                    <StackPanel>
                                        <TextBlock Text="Nejprve připojte zařízení" FontWeight="SemiBold" />
                                        <TextBlock Text="Po připojení se zpřístupní bezpečný ruční posun os."
                                                   Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,3,0,0" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <StackPanel Visibility="{Binding Connection.IsConnected, Converter={StaticResource BoolToVisibility}}">
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Vzdálenost XY (mm)" Style="{StaticResource Text.Muted}" />
                                    <ComboBox ItemsSource="{Binding Jog.StepSizePresets}" SelectedItem="{Binding Jog.StepSizeMm}" Margin="0,5,0,0" ToolTip="Vzdálenost jednoho posunu os X a Y v milimetrech" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Rychlost XY (mm/min)" Style="{StaticResource Text.Muted}" />
                                    <TextBox Text="{Binding Jog.JogFeedRate, UpdateSourceTrigger=PropertyChanged, StringFormat=0}" Margin="0,5,0,0" ToolTip="Rychlost ručního posunu os X a Y v mm/min" />
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="18" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <Grid HorizontalAlignment="Center">
                                    <Grid.RowDefinitions><RowDefinition Height="60" /><RowDefinition Height="60" /><RowDefinition Height="60" /></Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="60" /><ColumnDefinition Width="60" /><ColumnDefinition Width="60" /></Grid.ColumnDefinitions>

                                    <Button Grid.Row="0" Grid.Column="0" Style="{StaticResource JogPadButton}" Command="{Binding Jog.JogXNegYPosCommand}" ToolTip="Posunout vlevo nahoru" AutomationProperties.Name="Posunout vlevo nahoru"><components:IconGlyph IconData="{StaticResource Glyph.ArrowUpLeft}" Width="18" Height="18" /></Button>
                                    <Button Grid.Row="0" Grid.Column="1" Style="{StaticResource JogPadButton}" Command="{Binding Jog.JogYPosCommand}" ToolTip="Posunout nahoru, osa Y plus" AutomationProperties.Name="Posunout nahoru"><components:IconGlyph IconData="{StaticResource Glyph.ArrowUp}" Width="18" Height="18" /></Button>
                                    <Button Grid.Row="0" Grid.Column="2" Style="{StaticResource JogPadButton}" Command="{Binding Jog.JogXPosYPosCommand}" ToolTip="Posunout vpravo nahoru" AutomationProperties.Name="Posunout vpravo nahoru"><components:IconGlyph IconData="{StaticResource Glyph.ArrowUpRight}" Width="18" Height="18" /></Button>
                                    <Button Grid.Row="1" Grid.Column="0" Style="{StaticResource JogPadButton}" Command="{Binding Jog.JogXNegCommand}" ToolTip="Posunout vlevo, osa X minus" AutomationProperties.Name="Posunout vlevo"><components:IconGlyph IconData="{StaticResource Glyph.ArrowLeft}" Width="18" Height="18" /></Button>
                                    <Button Grid.Row="1" Grid.Column="1" Style="{StaticResource JogHomeButton}" Command="{Binding Jog.HomeCommand}" ToolTip="Najet do výchozí polohy stroje" AutomationProperties.Name="Najet do výchozí polohy"><components:IconGlyph IconData="{StaticResource Glyph.MachineHome}" Width="18" Height="18" /></Button>
                                    <Button Grid.Row="1" Grid.Column="2" Style="{StaticResource JogPadButton}" Command="{Binding Jog.JogXPosCommand}" ToolTip="Posunout vpravo, osa X plus" AutomationProperties.Name="Posunout vpravo"><components:IconGlyph IconData="{StaticResource Glyph.ArrowRight}" Width="18" Height="18" /></Button>
                                    <Button Grid.Row="2" Grid.Column="0" Style="{StaticResource JogPadButton}" Command="{Binding Jog.JogXNegYNegCommand}" ToolTip="Posunout vlevo dolů" AutomationProperties.Name="Posunout vlevo dolů"><components:IconGlyph IconData="{StaticResource Glyph.ArrowDownLeft}" Width="18" Height="18" /></Button>
                                    <Button Grid.Row="2" Grid.Column="1" Style="{StaticResource JogPadButton}" Command="{Binding Jog.JogYNegCommand}" ToolTip="Posunout dolů, osa Y minus" AutomationProperties.Name="Posunout dolů"><components:IconGlyph IconData="{StaticResource Glyph.ArrowDown}" Width="18" Height="18" /></Button>
                                    <Button Grid.Row="2" Grid.Column="2" Style="{StaticResource JogPadButton}" Command="{Binding Jog.JogXPosYNegCommand}" ToolTip="Posunout vpravo dolů" AutomationProperties.Name="Posunout vpravo dolů"><components:IconGlyph IconData="{StaticResource Glyph.ArrowDownRight}" Width="18" Height="18" /></Button>
                                </Grid>

                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock Text="OSA Z" Style="{StaticResource Text.Heading}" HorizontalAlignment="Center" Margin="0,0,0,5" />
                                    <Button Style="{StaticResource JogPadButton}" Command="{Binding Jog.JogZPosCommand}" ToolTip="Zvednout osu Z" AutomationProperties.Name="Zvednout osu Z"><components:IconGlyph IconData="{StaticResource Glyph.ArrowUp}" Width="18" Height="18" /></Button>
                                    <Button Style="{StaticResource JogPadButton}" Command="{Binding Jog.JogZNegCommand}" ToolTip="Spustit osu Z" AutomationProperties.Name="Spustit osu Z"><components:IconGlyph IconData="{StaticResource Glyph.ArrowDown}" Width="18" Height="18" /></Button>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Vzdálenost Z (mm)" Style="{StaticResource Text.Muted}" />
                                    <ComboBox ItemsSource="{Binding Jog.StepSizePresets}" SelectedItem="{Binding Jog.ZStepSizeMm}" Margin="0,5,0,0" ToolTip="Vzdálenost jednoho posunu osy Z v milimetrech" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Rychlost Z (mm/min)" Style="{StaticResource Text.Muted}" />
                                    <TextBox Text="{Binding Jog.ZJogFeedRate, UpdateSourceTrigger=PropertyChanged, StringFormat=0}" Margin="0,5,0,0" ToolTip="Rychlost ručního posunu osy Z v mm/min" />
                                </StackPanel>
                            </Grid>

                            <Button Command="{Binding Jog.CancelJogCommand}" Style="{StaticResource Button.Danger}" Margin="0,0,0,8" ToolTip="Okamžitě zrušit právě probíhající ruční posun">
                                <components:IconLabel IconData="{StaticResource Glyph.Stop}" Text="Zastavit ruční pohyb" />
                            </Button>

                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Button Command="{Binding Jog.HomeCommand}"><components:IconLabel IconData="{StaticResource Glyph.MachineHome}" Text="Najet domů" /></Button>
                                <Button Grid.Column="2" Command="{Binding Jog.UnlockCommand}"><components:IconLabel IconData="{StaticResource Glyph.Unlock}" Text="Odemknout ($X)" /></Button>
                            </Grid>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Button Command="{Binding Jog.SetOriginHereCommand}"><components:IconLabel IconData="{StaticResource Glyph.Origin}" Text="Nastavit nulu zde" /></Button>
                                <Button Grid.Column="2" Command="{Binding Jog.GoToWorkZeroCommand}"><components:IconLabel IconData="{StaticResource Glyph.Origin}" Text="Přejít na nulu XY" /></Button>
                            </Grid>
                            <Expander Header="Pokročilé ovládání" Margin="0,10,0,0">
                                <Button Style="{StaticResource Button.Danger}" Command="{Binding Jog.SoftResetCommand}" Margin="0,8,0,0"
                                        ToolTip="Resetuje řídicí jednotku stroje. Použijte pouze při chybě nebo nereagujícím zařízení.">
                                    <components:IconLabel IconData="{StaticResource Glyph.Refresh}" Text="Resetovat řídicí jednotku" />
                                </Button>
                            </Expander>
                            <TextBlock Text="{Binding Jog.LastActionMessage}" Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,12,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,16"
                            Visibility="{Binding Connection.IsConnected, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Příprava gravírování" Style="{StaticResource PanelTitle}" FontSize="16" Margin="0" />
                                    <TextBlock Text="Vyberte návrh a před spuštěním zkontrolujte jeho umístění." Style="{StaticResource Text.Muted}" Margin="0,4,0,0" />
                                </StackPanel>
                                <Border Grid.Column="1" Style="{StaticResource Badge}" Padding="9,4" VerticalAlignment="Top">
                                    <TextBlock Text="{Binding GCode.JobState, Converter={StaticResource JobStateToLabel}}" FontWeight="SemiBold" />
                                </Border>
                            </Grid>

                            <Border Background="{StaticResource Brush.Field}" BorderBrush="{StaticResource Brush.PanelBorder}" BorderThickness="1" CornerRadius="8" Padding="12">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Návrh k výrobě" Style="{StaticResource Text.Muted}" />
                                        <TextBlock Text="{Binding GCode.FileLabel}" FontWeight="SemiBold" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding GCode.FileLabel}" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Command="{Binding GCode.LoadFileCommand}" Margin="12,0,0,0" Padding="12,0" ToolTip="Načíst SVG, obrázek nebo G-code">
                                        <components:IconLabel IconData="{StaticResource Glyph.Open}" Text="Vybrat návrh" />
                                    </Button>
                                </Grid>
                            </Border>

                            <ProgressBar Value="{Binding GCode.ProgressPercent}" Height="4" Margin="0,12,0,0" />
                            <TextBlock Margin="0,6,0,0" Style="{StaticResource Text.Muted}">
                                <Run Text="Řádek " /><Run Text="{Binding GCode.CurrentLine}" /><Run Text=" z " /><Run Text="{Binding GCode.TotalLines}" />
                            </TextBlock>

                            <Border Height="1" Background="{StaticResource Brush.PanelBorder}" Margin="0,14" />
                            <TextBlock Text="Kontrola umístění" FontWeight="SemiBold" Margin="0,0,0,8" />
                            <Border Style="{StaticResource SegmentedTrack}" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <RadioButton Content="Obrys návrhu" Style="{StaticResource Segment}" HorizontalContentAlignment="Stretch"
                                                 IsChecked="{Binding GCode.FramingMode, Mode=TwoWay, Converter={StaticResource EnumToBool}, ConverterParameter=FullOutline}" />
                                    <RadioButton Grid.Column="1" Content="Pouze rohy" Style="{StaticResource Segment}" HorizontalContentAlignment="Stretch"
                                                 IsChecked="{Binding GCode.FramingMode, Mode=TwoWay, Converter={StaticResource EnumToBool}, ConverterParameter=CornersOnly}" />
                                </Grid>
                            </Border>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Rychlost rámování (mm/min)" Style="{StaticResource Text.Muted}" />
                                    <TextBox Text="{Binding GCode.FramingFeedRate, UpdateSourceTrigger=PropertyChanged, StringFormat=0}" Margin="0,5,0,0" />
                                </StackPanel>
                                <Border Grid.Column="2" Background="{StaticResource Brush.SuccessMuted}" CornerRadius="8" Padding="10" VerticalAlignment="Bottom">
                                    <StackPanel Orientation="Horizontal">
                                        <components:IconGlyph IconData="{StaticResource Glyph.Check}" Width="15" Height="15" Foreground="{StaticResource Brush.Success}" Margin="0,0,7,0" />
                                        <TextBlock Text="Laser zůstane vypnutý" Foreground="{StaticResource Brush.Success}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <Button Command="{Binding GCode.RunFramingCommand}" Margin="0,0,0,12" ToolTip="Projet obrys úlohy a ověřit její umístění">
                                <components:IconLabel IconData="{StaticResource Glyph.Frame}" Text="Zkontrolovat oblast" />
                            </Button>

                            <Border Background="{StaticResource Brush.AccentMuted}" CornerRadius="8" Padding="10" Margin="0,0,0,12">
                                <StackPanel Orientation="Horizontal">
                                    <components:IconGlyph IconData="{StaticResource Glyph.Origin}" Width="16" Height="16" Foreground="{StaticResource Brush.Info}" Margin="0,0,8,0" />
                                    <TextBlock Text="Začátek úlohy je nastaven na pracovní nulu stroje." Foreground="{StaticResource Brush.Info}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <TextBlock Text="{Binding GCode.PreflightMessage}" Foreground="{StaticResource Brush.Danger}" TextWrapping="Wrap" Margin="0,0,0,10"
                                       Visibility="{Binding GCode.PreflightMessage, Converter={StaticResource NotNullToVisibility}}" />
                            <TextBlock Text="{Binding GCode.LastMessage}" Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,0,0,10"
                                       Visibility="{Binding GCode.LastMessage, Converter={StaticResource NotNullToVisibility}}" />

                            <TextBlock Text="Spuštění, pozastavení a zastavení úlohy najdete vždy ve spodní liště."
                                       Style="{StaticResource Text.Muted}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}"
                            Visibility="{Binding Connection.IsConnected, Converter={StaticResource BoolToVisibility}}">
                        <Expander IsExpanded="False">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal">
                                    <components:IconGlyph IconData="{StaticResource Glyph.Terminal}" Width="18" Height="18" Margin="0,0,8,0" />
                                    <TextBlock Text="Pokročilé: konzola GRBL" FontWeight="SemiBold" FontSize="14" />
                                </StackPanel>
                            </Expander.Header>
                        <Grid Height="240" Margin="0,14,0,0">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <TextBlock Text="Přímé příkazy používejte pouze tehdy, pokud znáte GRBL."
                                       Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,0,0,8" />
                            <Border Grid.Row="1" Background="{DynamicResource Brush.Field}" BorderBrush="{DynamicResource Brush.PanelBorder}" BorderThickness="1" CornerRadius="8">
                                <ScrollViewer x:Name="ConsoleScroll" VerticalScrollBarVisibility="Auto" Padding="10">
                                    <ItemsControl ItemsSource="{Binding Console.Lines}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" FontFamily="{StaticResource Font.Mono}" FontSize="11" TextWrapping="Wrap" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>
                            <Grid Grid.Row="2" Margin="0,8,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBox FontFamily="{StaticResource Font.Mono}" Text="{Binding Console.CommandInput, UpdateSourceTrigger=PropertyChanged}"
                                         KeyDown="OnConsoleInputKeyDown" ToolTip="Příkaz GRBL" />
                                <Button Grid.Column="1" Command="{Binding Console.SendCommand}" Margin="8,0,0,0" Padding="14,0">
                                    <components:IconLabel IconData="{StaticResource Glyph.Send}" Text="Odeslat" />
                                </Button>
                            </Grid>
                        </Grid>
                        </Expander>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
