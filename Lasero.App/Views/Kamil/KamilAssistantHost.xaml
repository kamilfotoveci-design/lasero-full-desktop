<UserControl x:Class="Lasero.App.Views.Kamil.KamilAssistantHost"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             xmlns:components="clr-namespace:Lasero.App.Components"
             xmlns:kamil="clr-namespace:Lasero.App.Views.Kamil"
             xmlns:vm="clr-namespace:Lasero.App.ViewModels"
             x:Name="Host"
             IsHitTestVisible="True"
             HorizontalAlignment="Right" VerticalAlignment="Bottom">
    <!--
        The assistant, as one surface in three shapes.

        Lives once, at the top of MainWindow's layout, above whichever screen is showing. That is what
        lets the operator move between Návrh, Materiály and Zařízení without the conversation being
        torn down and rebuilt — the host is never unloaded, so there is no state to restore.

        Anchored bottom-right of the workspace and inset clear of the machine strip: Rámovat, Spustit,
        Pauza and Zastavit are never underneath it, at any window size (see KamilAssistantHost.xaml.cs,
        which clamps the panel's height to the room actually available).
    -->
    <UserControl.Resources>
        <Style x:Key="MessageText" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="LineHeight" Value="19" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        </Style>
    </UserControl.Resources>

    <Grid x:Name="Root">
        <!--
            The surface. Width and Height are animated between the three states; the transform is
            what carries the lift and the settle, so the expensive part of each transition stays on
            the composition thread.

            RenderTransformOrigin is the bottom-right corner — the pill's own position — so Expanded
            contracting back to Minimized visibly collapses toward where the pill will be.
        -->
        <Border x:Name="Surface"
                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Background="{DynamicResource Brush.Panel}"
                BorderBrush="{DynamicResource Brush.PanelBorder}" BorderThickness="1"
                CornerRadius="{StaticResource Radius.Lg}"
                Effect="{StaticResource Shadow.Dropdown}"
                RenderTransformOrigin="1,1"
                Width="176" Height="48">
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="SurfaceScale" ScaleX="1" ScaleY="1" />
                    <TranslateTransform x:Name="SurfaceOffset" />
                </TransformGroup>
            </Border.RenderTransform>

            <Grid ClipToBounds="True">

                <!-- ==================== MINIMIZED ==================== -->
                <Button x:Name="PillLayer" Style="{StaticResource Button.Ghost}"
                        Command="{Binding OpenQuickAskCommand}"
                        Padding="10,0" HorizontalContentAlignment="Left"
                        ToolTip="Kamil — zeptejte se bez opuštění pracovní plochy"
                        automation:AutomationProperties.Name="Otevřít asistenta Kamil">
                    <Button.RenderTransform>
                        <TranslateTransform x:Name="PillOffset" />
                    </Button.RenderTransform>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Grid VerticalAlignment="Center" Margin="0,0,10,0">
                            <Ellipse Width="28" Height="28">
                                <Ellipse.Fill>
                                    <ImageBrush ImageSource="{StaticResource Image.KamilAvatar}" Stretch="UniformToFill"
                                                AlignmentY="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                                </Ellipse.Fill>
                            </Ellipse>
                        </Grid>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="KAMIL" FontWeight="SemiBold"
                                       FontSize="{StaticResource Size.Text.Meta}" />
                            <TextBlock Text="AI asistent" Style="{StaticResource Text.Muted}" Margin="0,1,0,0" />
                        </StackPanel>

                        <!--
                            Availability, not decoration. Green only when the account is signed in and
                            online, because that is the only state in which a question can actually be
                            answered; otherwise the dot is muted and the tooltip says why.
                        -->
                        <Ellipse Grid.Column="2" Width="7" Height="7" VerticalAlignment="Center" Margin="8,0,2,0"
                                 ToolTip="{Binding Chat.AvailabilityText}">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{DynamicResource Brush.PanelBorderStrong}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Chat.CanUseOnline}" Value="True">
                                            <Setter Property="Fill" Value="{DynamicResource Brush.Success}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                    </Grid>
                </Button>

                <!-- ==================== QUICK ASK ==================== -->
                <Grid x:Name="QuickLayer" Margin="12" Opacity="0" Visibility="Collapsed">
                    <Grid.RenderTransform>
                        <TranslateTransform x:Name="QuickOffset" />
                    </Grid.RenderTransform>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <kamil:KamilContextBar Grid.Row="0" Margin="0,0,0,9" />

                    <kamil:KamilComposer x:Name="QuickComposer" Grid.Row="1"
                                         Placeholder="Napiš dotaz nebo přilož fotku…" />

                    <ItemsControl Grid.Row="2" Margin="0,9,0,0" ItemsSource="{Binding QuickPrompts}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource Kamil.PromptChip}" Content="{Binding}"
                                        Command="{Binding DataContext.UseQuickPromptCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>

                <!-- ==================== EXPANDED ==================== -->
                <Grid x:Name="ExpandedLayer" Opacity="0" Visibility="Collapsed">
                    <Grid.RenderTransform>
                        <TranslateTransform x:Name="ExpandedOffset" />
                    </Grid.RenderTransform>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Border Grid.Row="0" Padding="12,10" BorderBrush="{DynamicResource Brush.PanelBorder}"
                            BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Grid VerticalAlignment="Center" Margin="0,0,10,0">
                                <Ellipse Width="30" Height="30">
                                    <Ellipse.Fill>
                                        <ImageBrush ImageSource="{StaticResource Image.KamilAvatar}" Stretch="UniformToFill"
                                                    AlignmentY="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Ellipse.Fill>
                                </Ellipse>
                                <Ellipse Width="8" Height="8" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                         Stroke="{DynamicResource Brush.Panel}" StrokeThickness="1.5">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{DynamicResource Brush.PanelBorderStrong}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Chat.CanUseOnline}" Value="True">
                                                    <Setter Property="Fill" Value="{DynamicResource Brush.Success}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                            </Grid>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="KAMIL" FontWeight="SemiBold" />
                                <TextBlock Text="AI laserový asistent" Style="{StaticResource Text.Muted}" Margin="0,1,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource Kamil.HeaderButton}"
                                        Command="{Binding Chat.NewChatCommand}"
                                        ToolTip="Nová konverzace"
                                        automation:AutomationProperties.Name="Nová konverzace">
                                    <components:IconGlyph IconData="{StaticResource Glyph.New}"
                                                          Width="{StaticResource Size.Icon.Sm}" Height="{StaticResource Size.Icon.Sm}" />
                                </Button>
                                <Button Style="{StaticResource Kamil.HeaderButton}"
                                        Command="{Binding MinimizeCommand}"
                                        ToolTip="Zmenšit na odznak · Esc"
                                        automation:AutomationProperties.Name="Zmenšit asistenta">
                                    <components:IconGlyph IconData="{StaticResource Glyph.Minimize}"
                                                          Width="{StaticResource Size.Icon.Chrome}" Height="{StaticResource Size.Icon.Chrome}" />
                                </Button>
                                <Button Style="{StaticResource Kamil.HeaderButton}"
                                        Command="{Binding CloseCommand}"
                                        ToolTip="Skrýt asistenta — konverzace zůstane uložená"
                                        automation:AutomationProperties.Name="Skrýt asistenta">
                                    <components:IconGlyph IconData="{StaticResource Glyph.Close}"
                                                          Width="{StaticResource Size.Icon.Chrome}" Height="{StaticResource Size.Icon.Chrome}" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Context -->
                    <Border Grid.Row="1" Padding="12,8" Background="{DynamicResource Brush.Background}"
                            BorderBrush="{DynamicResource Brush.PanelBorder}" BorderThickness="0,0,0,1">
                        <kamil:KamilContextBar />
                    </Border>

                    <!-- Conversation. The only thing on this panel that scrolls. -->
                    <Grid Grid.Row="2">
                        <ScrollViewer x:Name="MessageScroll" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled" Padding="12,10,12,10"
                                      Visibility="{Binding Chat.HasMessages, Converter={StaticResource BoolToVisibilityShared}}">
                            <ScrollViewer.Resources>
                                <Style TargetType="ScrollBar" BasedOn="{StaticResource ScrollBar.Slim}" />
                            </ScrollViewer.Resources>
                            <ItemsControl ItemsSource="{Binding Chat.Messages}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,14">
                                            <!--
                                                The operator's question is a compact tinted block; Kamil's
                                                answer is flat text with a small avatar gutter. Two bubbles
                                                facing each other would halve the usable width of a 420px
                                                panel and make every answer twice as tall.
                                            -->
                                            <Border HorizontalAlignment="Right" MaxWidth="300"
                                                    Background="{DynamicResource Brush.SelectedSurface}"
                                                    CornerRadius="{StaticResource Radius.Md}" Padding="11,8"
                                                    Visibility="{Binding IsUser, Converter={StaticResource BoolToVisibilityShared}}">
                                                <TextBlock Text="{Binding Text}" Style="{StaticResource MessageText}" />
                                            </Border>

                                            <Grid Visibility="{Binding IsUser, Converter={StaticResource InverseBoolToVisibilityShared}}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Ellipse Width="20" Height="20" VerticalAlignment="Top" Margin="0,1,9,0">
                                                    <Ellipse.Fill>
                                                        <ImageBrush ImageSource="{StaticResource Image.KamilAvatar}" Stretch="UniformToFill"
                                                                    AlignmentY="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                                                    </Ellipse.Fill>
                                                </Ellipse>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Text}" Style="{StaticResource MessageText}" />
                                                    <components:ParameterRecommendationCard
                                                        DataContext="{Binding Recommendation}"
                                                        Visibility="{Binding RelativeSource={RelativeSource Self}, Path=DataContext, Converter={StaticResource NotNullToVisibilityShared}}"
                                                        ApplyCommand="{Binding DataContext.ApplyRecommendationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        ApplyTooltip="{Binding DataContext.ApplyRecommendationTooltip, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        AppliedMessage="{Binding DataContext.LastAppliedMessage, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                                </StackPanel>
                                            </Grid>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- Empty state: compact and immediately useful, not a welcome screen. -->
                        <StackPanel VerticalAlignment="Center" Margin="20,0"
                                    Visibility="{Binding Chat.HasMessages, Converter={StaticResource InverseBoolToVisibilityShared}}">
                            <TextBlock Text="S čím ti můžu pomoct?" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="Doporučení vždy ověřte na odřezku, než pustíte ostrou úlohu."
                                       Style="{StaticResource Text.Muted}" TextWrapping="Wrap"
                                       TextAlignment="Center" Margin="0,5,0,0" />
                            <ItemsControl ItemsSource="{Binding QuickPrompts}" Margin="0,14,0,0"
                                          HorizontalAlignment="Center">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel HorizontalAlignment="Center" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource Kamil.PromptChip}" Content="{Binding}"
                                                Command="{Binding DataContext.UseQuickPromptCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Grid>

                    <!-- Composer, pinned to the bottom of the panel. -->
                    <Border Grid.Row="3" Padding="12,10" BorderBrush="{DynamicResource Brush.PanelBorder}"
                            BorderThickness="0,1,0,0">
                        <StackPanel>
                            <!-- Failures are shown inline with the retry the operator needs, rather
                                 than as a toast that disappears before it can be acted on. -->
                            <Border Background="{DynamicResource Brush.WarningMuted}"
                                    CornerRadius="{StaticResource Radius.Sm}" Padding="9,7" Margin="0,0,0,8"
                                    Visibility="{Binding Chat.StatusMessage, Converter={StaticResource NotNullToVisibilityShared}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <components:IconGlyph IconData="{StaticResource Glyph.Warning}"
                                                          Width="{StaticResource Size.Icon.Sm}" Height="{StaticResource Size.Icon.Sm}"
                                                          Foreground="{DynamicResource Brush.Warning}"
                                                          VerticalAlignment="Top" Margin="0,1,8,0" />
                                    <TextBlock Grid.Column="1" Text="{Binding Chat.StatusMessage}" TextWrapping="Wrap"
                                               FontSize="{StaticResource Size.Text.Meta}" />
                                    <Button Grid.Column="2" Style="{StaticResource Button.Link}" Padding="6,0"
                                            Content="Zkusit znovu" Command="{Binding Chat.SendCommand}"
                                            VerticalAlignment="Top" />
                                </Grid>
                            </Border>

                            <kamil:KamilComposer x:Name="ExpandedComposer" Placeholder="Zeptej se Kamila…" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
