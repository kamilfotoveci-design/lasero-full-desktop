<UserControl x:Class="Lasero.App.Views.Kamil.KamilAssistantHost"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             xmlns:components="clr-namespace:Lasero.App.Components"
             xmlns:kamil="clr-namespace:Lasero.App.Views.Kamil"
             xmlns:vm="clr-namespace:Lasero.App.ViewModels"
             xmlns:input="clr-namespace:Lasero.App.Input"
             x:Name="Host"
             IsHitTestVisible="True"
             HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
             PreviewMouseLeftButtonDown="OnDragMouseLeftButtonDown"
             PreviewMouseMove="OnDragMouseMove"
             PreviewMouseLeftButtonUp="OnDragMouseLeftButtonUp">
    <!--
        The assistant, as one surface in three shapes.

        One instance, declared over the Designer canvas only (see MainWindow.xaml) — the operator's
        hands are already there when they need it. It stays loaded rather than being torn down while
        the Designer screen itself is hidden, so the conversation survives a trip to Materiály or
        Zařízení and is exactly as they left it on return.

        Anchored bottom-right of the workspace and inset clear of the machine strip: Rámovat, Spustit,
        Pauza and Zastavit are never underneath it, at any window size (see KamilAssistantHost.xaml.cs,
        which clamps the panel's height to the room actually available).
    -->
    <UserControl.Resources>
        <Style x:Key="MessageText" TargetType="TextBlock" BasedOn="{StaticResource Kamil.MessageText}">
            <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
            <Setter Property="TextOptions.TextHintingMode" Value="Auto" />
        </Style>

        <!-- The 48-DIP anchor remains the only animated Kamil instance on the Designer canvas.
             Message rows retain static portraits so the conversation stays easy to read. -->
        <Style x:Key="Kamil.MinimizedAvatar" TargetType="Button">
            <Setter Property="Width" Value="80" />
            <Setter Property="Height" Value="80" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="{x:Null}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing.Pill}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="AvatarScale" ScaleX="1" ScaleY="1" />
                                </TransformGroup>
                            </Grid.RenderTransform>

                            <kamil:KamilLiveAvatar x:Name="Avatar" Width="80" Height="80"
                                                   BlinkSource="{StaticResource Image.Kamil.Blink}"
                                                   ThinkingSource="{StaticResource Image.Kamil.Thinking}"
                                                   HappySource="{StaticResource Image.Kamil.Happy}"
                                                   ErrorSource="{StaticResource Image.Kamil.Error}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <!-- Hover is a quiet high-damping settle, not a mascot bounce. -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="AvatarScale" Storyboard.TargetProperty="ScaleX"
                                                             To="1.018" Duration="{StaticResource Motion.Base}" EasingFunction="{StaticResource Ease.Out}" />
                                            <DoubleAnimation Storyboard.TargetName="AvatarScale" Storyboard.TargetProperty="ScaleY"
                                                             To="1.018" Duration="{StaticResource Motion.Base}" EasingFunction="{StaticResource Ease.Out}" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="AvatarScale" Storyboard.TargetProperty="ScaleX"
                                                             To="1" Duration="{StaticResource Motion.Fast}" EasingFunction="{StaticResource Ease.Out}" />
                                            <DoubleAnimation Storyboard.TargetName="AvatarScale" Storyboard.TargetProperty="ScaleY"
                                                             To="1" Duration="{StaticResource Motion.Fast}" EasingFunction="{StaticResource Ease.Out}" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <!-- Declared after IsMouseOver so a press while hovering wins: 0.975 is the
                                 more specific, more recent intent. -->
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="AvatarScale" Storyboard.TargetProperty="ScaleX"
                                                             To="0.975" Duration="{StaticResource Motion.VeryFast}" EasingFunction="{StaticResource Ease.Out}" />
                                            <DoubleAnimation Storyboard.TargetName="AvatarScale" Storyboard.TargetProperty="ScaleY"
                                                             To="0.975" Duration="{StaticResource Motion.VeryFast}" EasingFunction="{StaticResource Ease.Out}" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="AvatarScale" Storyboard.TargetProperty="ScaleX"
                                                             To="1.018" Duration="{StaticResource Motion.Base}" EasingFunction="{StaticResource Ease.Out}" />
                                            <DoubleAnimation Storyboard.TargetName="AvatarScale" Storyboard.TargetProperty="ScaleY"
                                                             To="1.018" Duration="{StaticResource Motion.Base}" EasingFunction="{StaticResource Ease.Out}" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="{StaticResource Opacity.Disabled}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Canvas x:Name="Root">
        <!--
            The surface. Width and Height are animated between the three states; the transform is
            what carries the lift and the settle, so the expensive part of each transition stays on
            the composition thread.

            RenderTransformOrigin is the bottom-right corner — the pill's own position — so Expanded
            contracting back to Minimized visibly collapses toward where the pill will be.
        -->
        <Border x:Name="Surface" Canvas.Left="0" Canvas.Top="0"
                CornerRadius="{StaticResource Radius.Lg}"
                RenderTransformOrigin="1,1"
                Width="80" Height="80">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource Brush.Panel}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.PanelBorder}" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="Effect" Value="{StaticResource Shadow.Dropdown}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding State}" Value="Minimized">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderBrush" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Effect" Value="{x:Null}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="SurfaceScale" ScaleX="1" ScaleY="1" />
                    <TranslateTransform x:Name="SurfaceOffset" />
                </TransformGroup>
            </Border.RenderTransform>

            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="ClipToBounds" Value="True" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding State}" Value="Minimized">
                                <Setter Property="ClipToBounds" Value="False" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <!-- ==================== MINIMIZED ==================== -->
                <!-- Avatar only. This element supplies the command and automation identity; the
                     minimized visual itself is defined by Kamil.MinimizedAvatar above. -->
                <Button x:Name="PillLayer" Style="{StaticResource Kamil.MinimizedAvatar}"
                        Command="{Binding OpenQuickAskCommand}"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        automation:AutomationProperties.Name="Otevřít asistenta Kamil">
                    <Button.RenderTransform>
                        <TranslateTransform x:Name="PillOffset" />
                    </Button.RenderTransform>
                </Button>

                <!-- ==================== QUICK ASK ==================== -->
                <Grid x:Name="QuickLayer" Margin="8,8,8,4" Opacity="0" Visibility="Collapsed">
                    <Grid.RenderTransform>
                        <TranslateTransform x:Name="QuickOffset" />
                    </Grid.RenderTransform>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <kamil:KamilContextBar />
                        <Button Grid.Column="1" Style="{StaticResource Kamil.HeaderButton}"
                                Width="28" Height="28" Margin="8,0,0,0"
                                Command="{Binding MinimizeCommand}"
                                ToolTip="Zmenšit na odznak · Esc"
                                automation:AutomationProperties.Name="Zmenšit asistenta">
                            <components:IconGlyph IconData="{StaticResource Glyph.Minimize}"
                                                  Width="{StaticResource Size.Icon.Chrome}" Height="{StaticResource Size.Icon.Chrome}" />
                        </Button>
                    </Grid>

                    <kamil:KamilComposer x:Name="QuickComposer" Grid.Row="1"
                                         Placeholder="Dotaz pro Kamila…" />

                    <StackPanel Grid.Row="2" Margin="0,4,0,0">
                        <ItemsControl ItemsSource="{Binding ActionChips}"
                                      Visibility="{Binding HasActionChips, Converter={StaticResource BoolToVisibilityShared}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource Kamil.PromptChip}" Content="{Binding Label}"
                                            Command="{Binding Command}" ToolTip="{Binding Hint}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    <ItemsControl ItemsSource="{Binding QuickPrompts}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource Kamil.PromptChip}" Content="{Binding}"
                                        Command="{Binding DataContext.UseQuickPromptCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </StackPanel>
                </Grid>

                <!-- ==================== EXPANDED ==================== -->
                <Grid x:Name="ExpandedLayer" Opacity="0" Visibility="Collapsed">
                    <Grid.RenderTransform>
                        <TranslateTransform x:Name="ExpandedOffset" />
                    </Grid.RenderTransform>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Header. A click that lands on the bare header background (not one of its own
                         buttons, which handle their own clicks first) minimizes the assistant — the
                         same action as the header's own Minimize button, just reachable from the whole
                         row instead of only its 28px icon. -->
                    <Border Grid.Row="0" Padding="12,8" BorderBrush="{DynamicResource Brush.PanelBorder}"
                            BorderThickness="0,0,0,1" Background="Transparent" Cursor="Hand"
                            MouseLeftButtonUp="OnHeaderClick">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid VerticalAlignment="Center" Margin="0,0,12,0">
                                <components:LaseroAvatar Size="32" />
                                <Ellipse Width="8" Height="8" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                         Stroke="{DynamicResource Brush.Panel}" StrokeThickness="1.5">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{DynamicResource Brush.PanelBorderStrong}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Chat.CanUseOnline}" Value="True">
                                                    <Setter Property="Fill" Value="{DynamicResource Brush.Success}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                            </Grid>

                            <TextBlock Grid.Column="1" Text="Kamil" VerticalAlignment="Center"
                                       FontWeight="SemiBold" FontSize="{StaticResource Size.Text.Assistant.Body}"
                                       Foreground="{DynamicResource Brush.TextPrimary}" />

                            <!-- What Kamil can see, one quiet line under the name. It collapses itself while
                                 the screen is the only fact, so the header is then a single row. -->
                            <kamil:KamilContextBar Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" />

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Conversation history stays separate from the panel's window controls. -->
                                <Button x:Name="SessionsButton" Style="{StaticResource Kamil.HeaderButton}"
                                        Click="OnSessionsButtonClick"
                                        ToolTip="Dřívější konverzace"
                                        automation:AutomationProperties.Name="Dřívější konverzace">
                                    <components:IconGlyph IconData="{StaticResource Glyph.History}"
                                                          Width="{StaticResource Size.Icon.Sm}" Height="{StaticResource Size.Icon.Sm}" />
                                </Button>
                                <!-- Match the familiar Windows order: minimize, expand, close. These only
                                     change the assistant surface; the shared conversation is preserved. -->
                                <Button Style="{StaticResource Kamil.HeaderButton}"
                                        Command="{Binding MinimizeCommand}"
                                        ToolTip="Zmenšit na odznak · Esc"
                                        automation:AutomationProperties.Name="Zmenšit asistenta">
                                    <components:IconGlyph IconData="{StaticResource Glyph.Minimize}"
                                                          Width="{StaticResource Size.Icon.Chrome}" Height="{StaticResource Size.Icon.Chrome}" />
                                </Button>
                                <Button Style="{StaticResource Kamil.HeaderButton}"
                                        Command="{Binding OpenFullChatCommand}"
                                        ToolTip="Otevřít v plném chatu"
                                        automation:AutomationProperties.Name="Otevřít v plném chatu">
                                    <components:IconGlyph IconData="{StaticResource Glyph.Maximize}"
                                                          Width="{StaticResource Size.Icon.Sm}" Height="{StaticResource Size.Icon.Sm}" />
                                </Button>
                                <Button Style="{StaticResource Kamil.HeaderButton}"
                                        Command="{Binding CloseCommand}"
                                        ToolTip="Zavřít panel asistenta"
                                        automation:AutomationProperties.Name="Zavřít panel asistenta">
                                    <components:IconGlyph IconData="{StaticResource Glyph.Close}"
                                                          Width="{StaticResource Size.Icon.Chrome}" Height="{StaticResource Size.Icon.Chrome}" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Conversation. The only thing on this panel that scrolls, and it takes all the
                         height the header and the composer leave. -->
                    <Grid Grid.Row="1">
                        <ScrollViewer x:Name="MessageScroll" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled" Padding="16,16,16,0"
                                       ScrollChanged="OnMessageScrollChanged"
                                      Visibility="{Binding Chat.HasMessages, Converter={StaticResource BoolToVisibilityShared}}">
                            <ItemsControl ItemsSource="{Binding Chat.Messages}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,16" input:MessageEntrance.IsEnabled="True">
                                            <!--
                                                The operator's question is a compact raised bubble on the right;
                                                Kamil's answer is flat text on the left with a small static
                                                portrait. Two bubbles facing each other would halve the usable
                                                width of the panel and make every answer twice as tall. The
                                                time is the bubble's tooltip, not a line of text on every row.
                                            -->
                                            <Border HorizontalAlignment="Right" MaxWidth="340"
                                                    Background="{DynamicResource Brush.PanelRaised}"
                                                    CornerRadius="{StaticResource Radius.Lg}" Padding="12,8"
                                                    ToolTip="{Binding TimeLabel}"
                                                    Visibility="{Binding IsUser, Converter={StaticResource BoolToVisibilityShared}}">
                                                <TextBlock Text="{Binding DisplayText}" Style="{StaticResource MessageText}" />
                                            </Border>

                                            <Grid Visibility="{Binding IsUser, Converter={StaticResource InverseBoolToVisibilityShared}}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <components:LaseroAvatar Size="28" VerticalAlignment="Top" Margin="0,0,8,0" />
                                                <StackPanel Grid.Column="1" ToolTip="{Binding TimeLabel}">
                                                    <kamil:KamilMessageBody Text="{Binding DisplayText}"
                                                                            TextStyle="{StaticResource MessageText}" />
                                                    <Button Style="{StaticResource Button.Link}" HorizontalAlignment="Left"
                                                            Margin="0,4,0,0" Padding="0,0,8,0" MinHeight="{StaticResource Size.Control.Assistant.Chip}"
                                                            FontSize="{StaticResource Size.Text.Assistant.Meta}"
                                                            Content="{Binding ToggleLabel}"
                                                            Command="{Binding ToggleExpandedCommand}"
                                                            Visibility="{Binding HasMore, Converter={StaticResource BoolToVisibilityShared}}" />
                                                    <components:ParameterRecommendationCard
                                                        DataContext="{Binding Recommendation}"
                                                        Visibility="{Binding RelativeSource={RelativeSource Self}, Path=DataContext, Converter={StaticResource NotNullToVisibilityShared}}"
                                                        ApplyCommand="{Binding DataContext.ApplyRecommendationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        ApplyTooltip="{Binding DataContext.ApplyRecommendationTooltip, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        AppliedMessage="{Binding DataContext.LastAppliedMessage, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                                </StackPanel>
                                            </Grid>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <Button x:Name="LatestMessageButton" Content="Nejnovější"
                                Style="{StaticResource Button.Secondary}" Visibility="Collapsed"
                                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                Margin="0,0,20,8" Padding="8,4" MinHeight="32"
                                Click="OnLatestMessageClick"
                                automation:AutomationProperties.Name="Přejít na nejnovější zprávu" />

                        <!-- Empty state: compact and immediately useful, not a welcome screen. -->
                        <StackPanel VerticalAlignment="Center" Margin="20,0"
                                    Visibility="{Binding Chat.HasMessages, Converter={StaticResource InverseBoolToVisibilityShared}}">
                            <TextBlock Text="Kamil je AI asistent pro návrh a nastavení" FontWeight="SemiBold"
                                       FontSize="{StaticResource Size.Text.Assistant.Body}"
                                       HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
                            <TextBlock Text="Doporučení je vždy potřeba ověřit na odřezku před ostrou úlohou."
                                       Style="{StaticResource Kamil.MetaText}" TextWrapping="Wrap"
                                       TextAlignment="Center" Margin="0,4,0,0" />
                            <ItemsControl ItemsSource="{Binding QuickPrompts}" Margin="0,16,0,0"
                                          HorizontalAlignment="Center">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel HorizontalAlignment="Center" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource Kamil.PromptChip}" Content="{Binding}"
                                                Command="{Binding DataContext.UseQuickPromptCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Grid>

                    <!-- Composer, pinned to the bottom of the panel. -->
                    <Border Grid.Row="2" Padding="12" BorderBrush="{DynamicResource Brush.PanelBorder}"
                            BorderThickness="0,1,0,0">
                        <StackPanel>
                            <!-- Failures are shown inline with the retry the operator needs, rather
                                 than as a toast that disappears before it can be acted on. -->
                            <Border Background="{DynamicResource Brush.WarningMuted}"
                                    BorderBrush="{DynamicResource Brush.PanelBorderStrong}" BorderThickness="1"
                                    CornerRadius="{StaticResource Radius.Sm}" Padding="8,8" Margin="0,0,0,8"
                                    Visibility="{Binding Chat.StatusMessage, Converter={StaticResource NotNullToVisibilityShared}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <components:IconGlyph IconData="{StaticResource Glyph.Warning}"
                                                          Width="{StaticResource Size.Icon.Sm}" Height="{StaticResource Size.Icon.Sm}"
                                                          Foreground="{DynamicResource Brush.Warning}"
                                                          VerticalAlignment="Top" Margin="0,0,8,0" />
                                    <TextBlock Grid.Column="1" Text="{Binding Chat.StatusMessage}" TextWrapping="Wrap"
                                               FontSize="{StaticResource Size.Text.Assistant.Meta}" />
                                    <Button Grid.Column="2" Style="{StaticResource Button.Link}" Padding="8,0"
                                            Content="Zkusit znovu" Command="{Binding Chat.SendCommand}"
                                            VerticalAlignment="Top" />
                                </Grid>
                            </Border>

                            <ItemsControl ItemsSource="{Binding ActionChips}" Margin="0,0,0,4"
                                      Visibility="{Binding HasActionChips, Converter={StaticResource BoolToVisibilityShared}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource Kamil.PromptChip}" Content="{Binding Label}"
                                                Command="{Binding Command}" ToolTip="{Binding Hint}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <kamil:KamilComposer x:Name="ExpandedComposer" Placeholder="Dotaz pro Kamila…" />
                        </StackPanel>
                    </Border>

                    <!-- Native WPF Thumb: resize in DIPs, without scaling the content. -->
                    <Thumb x:Name="ResizeHandle" Grid.RowSpan="3" Width="18" Height="18"
                           HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,4,4"
                           Cursor="SizeNWSE" DragDelta="OnResizeDragDelta"
                           DragCompleted="OnResizeDragCompleted"
                           ToolTip="Změnit velikost chatu"
                           automation:AutomationProperties.Name="Změnit velikost chatu">
                        <Thumb.Template>
                            <ControlTemplate TargetType="Thumb">
                                <Border Background="Transparent">
                                    <components:IconGlyph IconData="{StaticResource Glyph.ResizeHandle}"
                                                          Width="{StaticResource Size.Icon.Chrome}" Height="{StaticResource Size.Icon.Chrome}"
                                                          Foreground="{DynamicResource Brush.PanelBorderStrong}"
                                                          HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                                </Border>
                            </ControlTemplate>
                        </Thumb.Template>
                    </Thumb>
                </Grid>
            </Grid>
        </Border>

        <!-- The avatar is the permanent interactive anchor. It stays visible while QuickAsk or
             Expanded is open, so the panel always reads as a speech bubble attached to Kamil. -->
        <Button x:Name="PersistentAvatarLayer" Style="{StaticResource Kamil.MinimizedAvatar}"
                Command="{Binding ExpandCommand}"
                Width="80" Height="80"
                automation:AutomationProperties.Name="Kamil — otevřít chat" />

        <!-- Conversation switcher: earlier conversations, newest first. Deleting asks in place. -->
        <Popup x:Name="SessionsPopup" PlacementTarget="{Binding ElementName=SessionsButton}"
               Placement="Bottom" HorizontalOffset="-288" VerticalOffset="4"
               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade"
               Closed="OnSessionsPopupClosed">
            <Border Width="320" MaxHeight="360" Margin="8"
                    Background="{DynamicResource Brush.Panel}"
                    BorderBrush="{DynamicResource Brush.PanelBorder}" BorderThickness="1"
                    CornerRadius="{StaticResource Radius.Md}" Effect="{StaticResource Shadow.Dropdown}"
                    automation:AutomationProperties.Name="Dřívější konverzace">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="16,8,8,8">
                        <TextBlock Text="Konverzace" FontWeight="SemiBold" VerticalAlignment="Center"
                                   FontSize="{StaticResource Size.Text.Assistant.Body}" />
                        <Button HorizontalAlignment="Right" Style="{StaticResource Kamil.HeaderButton}"
                                Command="{Binding DataContext.Chat.NewChatCommand, ElementName=Host}"
                                Click="OnNewChatClick" ToolTip="Nová konverzace"
                                automation:AutomationProperties.Name="Nová konverzace">
                            <components:IconGlyph IconData="{StaticResource Glyph.New}"
                                                  Width="{StaticResource Size.Icon.Sm}" Height="{StaticResource Size.Icon.Sm}" />
                        </Button>
                    </Grid>
                    <TextBlock Grid.Row="1" Text="Zatím tu nic není" Margin="16,4,16,16"
                               Style="{StaticResource Kamil.MetaText}"
                               Visibility="{Binding DataContext.Chat.HasSessions, ElementName=Host, Converter={StaticResource InverseBoolToVisibilityShared}}" />
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="8,0,8,8">
                        <ItemsControl ItemsSource="{Binding DataContext.Chat.Sessions, ElementName=Host}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ChatSessionItem}">
                                    <Grid MinHeight="44">
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource Brush.SelectedSurface}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                        <!-- Normal row -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsConfirmingDelete}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>
                                            <Button Style="{StaticResource Button.Ghost}" HorizontalContentAlignment="Stretch"
                                                    MinHeight="44" Padding="8,4"
                                                    Command="{Binding DataContext.Chat.OpenChatCommand, ElementName=Host}"
                                                    CommandParameter="{Binding}"
                                                    Click="OnSessionRowClick">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"
                                                               FontSize="{StaticResource Size.Text.Assistant.Body}"
                                                               Foreground="{DynamicResource Brush.TextPrimary}" />
                                                    <TextBlock Text="{Binding UpdatedLabel}" Style="{StaticResource Kamil.MetaText}" />
                                                </StackPanel>
                                            </Button>
                                            <Button Grid.Column="1" Style="{StaticResource Kamil.HeaderButton}"
                                                    Width="{StaticResource Size.Control.Assistant.Chip}" Height="{StaticResource Size.Control.Assistant.Chip}"
                                                    Margin="4,0,4,0"
                                                    Command="{Binding DataContext.Chat.RequestDeleteChatCommand, ElementName=Host}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="Smazat konverzaci"
                                                    automation:AutomationProperties.Name="Smazat konverzaci">
                                                <components:IconGlyph IconData="{StaticResource Glyph.Delete}"
                                                                      Width="{StaticResource Size.Icon.Sm}" Height="{StaticResource Size.Icon.Sm}" />
                                            </Button>
                                        </Grid>
                                        <!-- Confirmation row -->
                                        <Grid Margin="8,0,4,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsConfirmingDelete}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>
                                            <TextBlock Text="Smazat konverzaci" VerticalAlignment="Center"
                                                       FontSize="{StaticResource Size.Text.Assistant.Meta}"
                                                       Foreground="{DynamicResource Brush.TextPrimary}" />
                                            <Button Grid.Column="1" Style="{StaticResource Button.Danger}" Content="Smazat" Margin="4,0"
                                                    MinHeight="{StaticResource Size.Control.Assistant.Chip}"
                                                    FontSize="{StaticResource Size.Text.Assistant.Meta}"
                                                    Command="{Binding DataContext.Chat.DeleteChatCommand, ElementName=Host}"
                                                    CommandParameter="{Binding}" />
                                            <Button Grid.Column="2" Style="{StaticResource Button.Ghost}" Content="Zrušit"
                                                    MinHeight="{StaticResource Size.Control.Assistant.Chip}"
                                                    FontSize="{StaticResource Size.Text.Assistant.Meta}"
                                                    Command="{Binding DataContext.Chat.CancelDeleteChatCommand, ElementName=Host}" />
                                        </Grid>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Popup>
        <!-- Occasional speech bubble from the head, see KamilAssistantHost.Nudge.cs. -->
        <Border x:Name="NudgeBubble" Visibility="Collapsed" Opacity="0" MaxWidth="260" Padding="16,12" Cursor="Hand"
                Background="{DynamicResource Brush.Panel}" BorderBrush="{DynamicResource Brush.PanelBorderStrong}" BorderThickness="1"
                CornerRadius="{StaticResource Radius.Lg}" RenderTransformOrigin="1,0.5"
                MouseLeftButtonUp="OnNudgeClick">
            <Border.RenderTransform><ScaleTransform x:Name="NudgeScale" /></Border.RenderTransform>
            <TextBlock Text="Pomoc je po ruce. Stačí se zeptat." TextWrapping="Wrap" FontSize="{StaticResource Size.Text.Assistant.Body}"
                       Foreground="{DynamicResource Brush.TextPrimary}" />
        </Border>
        </Canvas>
</UserControl>
