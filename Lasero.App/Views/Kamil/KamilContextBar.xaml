<UserControl x:Class="Lasero.App.Views.Kamil.KamilContextBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:components="clr-namespace:Lasero.App.Components">
    <!--
        What Kamil can see: the screen the operator is on, the material on the selected operation, and
        the connected machine. Each chip appears only when the application actually holds that fact —
        nothing connected means no machine chip, not a placeholder one.

        These are the same values sent with the question, so the row doubles as an honest statement of
        what the answer was based on.
    -->
    <WrapPanel>
        <Border Style="{StaticResource Kamil.ContextChip}">
            <StackPanel Orientation="Horizontal">
                <components:IconGlyph IconData="{StaticResource Glyph.Design}"
                                      Width="{StaticResource Size.Icon.Chrome}" Height="{StaticResource Size.Icon.Chrome}"
                                      Foreground="{DynamicResource Brush.TextMuted}"
                                      VerticalAlignment="Center" Margin="0,0,5,0" />
                <TextBlock Text="{Binding ScreenLabel}" Style="{StaticResource Text.Muted}"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Kamil.ContextChip}"
                Visibility="{Binding HasMaterialContext, Converter={StaticResource BoolToVisibilityShared}}">
            <StackPanel Orientation="Horizontal">
                <components:IconGlyph IconData="{StaticResource Glyph.Materials}"
                                      Width="{StaticResource Size.Icon.Chrome}" Height="{StaticResource Size.Icon.Chrome}"
                                      Foreground="{DynamicResource Brush.TextMuted}"
                                      VerticalAlignment="Center" Margin="0,0,5,0" />
                <TextBlock Text="{Binding MaterialContext}" Style="{StaticResource Text.Muted}"
                           VerticalAlignment="Center" MaxWidth="130" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Kamil.ContextChip}"
                Visibility="{Binding HasMachineContext, Converter={StaticResource BoolToVisibilityShared}}">
            <StackPanel Orientation="Horizontal">
                <components:IconGlyph IconData="{StaticResource Glyph.Device}"
                                      Width="{StaticResource Size.Icon.Chrome}" Height="{StaticResource Size.Icon.Chrome}"
                                      Foreground="{DynamicResource Brush.TextMuted}"
                                      VerticalAlignment="Center" Margin="0,0,5,0" />
                <TextBlock Text="{Binding MachineContext}" Style="{StaticResource Text.Muted}"
                           VerticalAlignment="Center" MaxWidth="130" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Border>
    </WrapPanel>
</UserControl>
