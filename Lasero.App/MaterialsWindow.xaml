<!-- Hallmark · pre-emit critique: P5 H5 E4 S5 R5 V4 · studied-DNA: xTool material workflow + Lasero light workbench -->
<Window x:Class="Lasero.App.MaterialsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:components="clr-namespace:Lasero.App.Components"
        xmlns:conv="clr-namespace:Lasero.App.Converters"
        xmlns:layers="clr-namespace:Lasero.Core.Layers;assembly=Lasero.Core"
        xmlns:materials="clr-namespace:Lasero.Core.Materials;assembly=Lasero.Core"
        x:Name="MaterialsDialog"
        Title="Vzorník materiálů" Width="1180" Height="720" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="True" ResizeMode="CanResize"
        Background="{StaticResource Brush.Background}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
        <conv:NotNullToVisibilityConverter x:Key="NotNullToVisibility" />
        <conv:RgbColorToBrushConverter x:Key="RgbColorToBrush" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="72" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="32,24,32,16">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <components:IconGlyph IconData="{StaticResource Glyph.Materials}" Width="{StaticResource Size.Icon.Xl}" Height="{StaticResource Size.Icon.Xl}" Margin="0,2,12,0" />
                        <TextBlock Text="Vzorník materiálů" Style="{StaticResource PageTitle}" />
                    </StackPanel>
                    <TextBlock Text="Bezpečné výchozí hodnoty jsou dostupné offline. Před ostrou úlohou je vždy ověřte na odřezku."
                               Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="32,5,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="20,0,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Border Style="{StaticResource Badge}" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Fill="{StaticResource Brush.Success}" Margin="0,0,7,0" />
                                <TextBlock Text="Dostupné offline" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                        <Button Command="{Binding SynchronizeCommand}" ToolTip="Synchronizovat osobní recepty s účtem Lasero">
                            <components:IconLabel IconData="{StaticResource Glyph.CloudSync}" Text="Synchronizovat" IconSize="{StaticResource Size.Icon.Sm}" />
                        </Button>
                    </StackPanel>
                    <TextBlock Text="{Binding SyncStatus}" Style="{StaticResource Text.Muted}" HorizontalAlignment="Right" Margin="0,5,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Grid.Row="1" Margin="32,0,32,16">
            <TabItem Header="Doporučené parametry">
                <Grid Margin="0,16,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Style="{StaticResource Card}" Padding="14,10,6,2">
                        <WrapPanel>
                            <StackPanel Width="174" Margin="0,0,8,8">
                                <TextBlock Text="Typ laseru" Style="{StaticResource Text.Muted}" Margin="0,0,0,5" />
                                <ComboBox SelectedValue="{Binding SelectedTechnology}" SelectedValuePath="Tag">
                                    <ComboBoxItem Content="Diodový laser" Tag="{x:Static materials:LaserTechnology.Diode}" />
                                    <ComboBoxItem Content="Infračervený laser" Tag="{x:Static materials:LaserTechnology.Infrared}" />
                                    <ComboBoxItem Content="CO₂ laser" Tag="{x:Static materials:LaserTechnology.Co2}" />
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Width="126" Margin="0,0,8,8">
                                <TextBlock Text="Výkon laseru (W)" Style="{StaticResource Text.Muted}" Margin="0,0,0,5" />
                                <ComboBox ItemsSource="{Binding PowerClasses}" SelectedItem="{Binding SelectedPowerWatts}" />
                            </StackPanel>
                            <StackPanel Width="174" Margin="0,0,8,8">
                                <TextBlock Text="Co chcete udělat" Style="{StaticResource Text.Muted}" Margin="0,0,0,5" />
                                <ComboBox SelectedValue="{Binding SelectedOperation}" SelectedValuePath="Tag">
                                    <ComboBoxItem Content="Gravírování" Tag="{x:Static layers:LayerMode.Fill}" />
                                    <ComboBoxItem Content="Řezání" Tag="{x:Static layers:LayerMode.Cut}" />
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Width="228" Margin="0,0,8,8">
                                <TextBlock Text="Hledat" Style="{StaticResource FieldLabel}" />
                                <Border Style="{StaticResource UnitField.Shell}">
                                    <DockPanel>
                                        <components:IconGlyph DockPanel.Dock="Left"
                                                              IconData="{StaticResource Glyph.Search}"
                                                              Width="{StaticResource Size.Icon.Sm}" Height="{StaticResource Size.Icon.Sm}"
                                                              Foreground="{StaticResource Brush.TextMuted}"
                                                              Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                                 BorderThickness="0" Background="Transparent" Padding="0"
                                                 VerticalContentAlignment="Center"
                                                 ToolTip="Hledat podle materiálu, poznámky nebo upozornění"
                                                 AutomationProperties.Name="Hledat materiál" />
                                    </DockPanel>
                                </Border>
                            </StackPanel>
                        </WrapPanel>
                    </Border>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="290" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource Card}" Padding="10">
                            <DockPanel LastChildFill="True">
                                <TextBlock DockPanel.Dock="Top" Text="Materiály" Style="{StaticResource Text.Muted}" FontSize="{StaticResource Size.Text.Meta}" FontWeight="SemiBold" Margin="6,4,6,10" />
                                <Button DockPanel.Dock="Top" Command="{Binding ShowAllMaterialsCommand}" Margin="0,0,0,6" HorizontalContentAlignment="Left">
                                    <components:IconLabel IconData="{StaticResource Glyph.Materials}" Text="Všechny materiály" IconSize="{StaticResource Size.Icon.Sm}" />
                                </Button>
                                <ListBox ItemsSource="{Binding MaterialDefinitions}" SelectedItem="{Binding SelectedMaterial}"
                                         BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="4,7">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Description}" Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid Margin="6,4,6,8">
                                    <TextBlock Text="Doporučení" Style="{StaticResource Text.Muted}" FontSize="{StaticResource Size.Text.Meta}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding RecommendedRecipes.Count, StringFormat={}{0} receptů}" Style="{StaticResource Text.Muted}" HorizontalAlignment="Right" />
                                </Grid>
                                <Grid Grid.Row="1">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                                Visibility="{Binding HasRecommendedRecipes, Converter={StaticResource InverseBoolToVisibility}}">
                                        <components:IconGlyph IconData="{StaticResource Glyph.Search}" Width="{StaticResource Size.Icon.Xl}" Height="{StaticResource Size.Icon.Xl}" HorizontalAlignment="Center" Foreground="{StaticResource Brush.TextSecondary}" />
                                        <TextBlock Text="Žádné odpovídající recepty" FontWeight="SemiBold" Margin="0,10,0,0" />
                                        <TextBlock Text="Změňte materiál nebo filtry." Style="{StaticResource Text.Muted}" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <ListBox ItemsSource="{Binding RecommendedRecipes}" SelectedItem="{Binding SelectedRecipe}"
                                             Visibility="{Binding HasRecommendedRecipes, Converter={StaticResource BoolToVisibility}}"
                                             BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="5,8">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding MaterialName}" FontWeight="SemiBold" FontSize="{StaticResource Size.Text.Body}" />
                                                        <TextBlock Style="{StaticResource Text.Muted}" Margin="0,3,0,0">
                                                            <Run Text="{Binding SpeedMmPerMinute, Mode=OneWay, StringFormat={}{0:0}}" /><Run Text=" mm/min  ·  " />
                                                            <Run Text="{Binding PowerPercent, Mode=OneWay, StringFormat={}{0:0}}" /><Run Text=" %  ·  " />
                                                            <Run Text="{Binding Passes, Mode=OneWay}" /><Run Text="×" />
                                                        </TextBlock>
                                                    </StackPanel>
                                                    <components:IconGlyph Grid.Column="1" IconData="{StaticResource Glyph.ChevronRight}" Width="{StaticResource Size.Icon.Sm}" Height="{StaticResource Size.Icon.Sm}" VerticalAlignment="Center" Foreground="{StaticResource Brush.TextSecondary}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </Grid>
                        </Border>

                        <Border Grid.Column="4" Style="{StaticResource Card}" Padding="20"
                                Visibility="{Binding HasSelectedRecipe, Converter={StaticResource BoolToVisibility}}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <TextBlock Text="Vybraný recept" Style="{StaticResource Text.Muted}" FontSize="{StaticResource Size.Text.Meta}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding SelectedRecipe.MaterialName}" FontFamily="{StaticResource Font.Display}" FontSize="{StaticResource Size.Text.Title}" FontWeight="SemiBold" Margin="0,8,0,0" />
                                        <TextBlock Style="{StaticResource Text.Muted}" Margin="0,4,0,16">
                                            <Run Text="{Binding SelectedRecipe.TechnologyName, Mode=OneWay}" /><Run Text="  ·  " />
                                            <Run Text="{Binding SelectedRecipe.PowerWatts, Mode=OneWay}" /><Run Text=" W  ·  " />
                                            <Run Text="{Binding SelectedRecipe.OperationName, Mode=OneWay}" />
                                        </TextBlock>

                                        <Border Style="{StaticResource InspectorSection}" Margin="0,0,0,10">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="1" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="1" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Margin="0,0,14,12">
                                                    <TextBlock Text="Rychlost" Style="{StaticResource Text.Muted}" />
                                                    <TextBlock FontSize="{StaticResource Size.Text.Section}" FontWeight="SemiBold" Margin="0,5,0,0"><Run Text="{Binding SelectedRecipe.SpeedMmPerMinute, Mode=OneWay, StringFormat={}{0:0}}" /><Run Text=" mm/min" /></TextBlock>
                                                </StackPanel>
                                                <Border Grid.Column="1" Grid.RowSpan="3" Background="{StaticResource Brush.PanelBorder}" />
                                                <StackPanel Grid.Column="2" Margin="14,0,0,12">
                                                    <TextBlock Text="Výkon" Style="{StaticResource Text.Muted}" />
                                                    <TextBlock FontSize="{StaticResource Size.Text.Section}" FontWeight="SemiBold" Margin="0,5,0,0"><Run Text="{Binding SelectedRecipe.PowerPercent, Mode=OneWay, StringFormat={}{0:0}}" /><Run Text=" %" /></TextBlock>
                                                </StackPanel>
                                                <Border Grid.Row="1" Grid.ColumnSpan="3" Background="{StaticResource Brush.PanelBorder}" />
                                                <StackPanel Grid.Row="2" Margin="0,12,14,0">
                                                    <TextBlock Text="Průchody" Style="{StaticResource Text.Muted}" />
                                                    <TextBlock Text="{Binding SelectedRecipe.Passes}" FontSize="{StaticResource Size.Text.Section}" FontWeight="SemiBold" Margin="0,5,0,0" />
                                                </StackPanel>
                                                <StackPanel Grid.Row="2" Grid.Column="2" Margin="14,12,0,0">
                                                    <TextBlock Text="Rozlišení" Style="{StaticResource Text.Muted}" />
                                                    <TextBlock Text="{Binding SelectedRecipe.Dpi, StringFormat={}{0} DPI, TargetNullValue=—}" FontSize="{StaticResource Size.Text.Section}" FontWeight="SemiBold" Margin="0,5,0,0" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <Border Style="{StaticResource InspectorSection}" Margin="0,0,0,10"
                                                Visibility="{Binding HasSelectedNote, Converter={StaticResource BoolToVisibility}}">
                                            <!-- DockPanel, not a horizontal StackPanel: a StackPanel measures its children with
                             infinite width, so TextWrapping never engages and the sentence is cut off at
                             the panel edge. -->
<DockPanel>
                                                <components:IconGlyph DockPanel.Dock="Left" VerticalAlignment="Top" IconData="{StaticResource Glyph.Info}" Width="{StaticResource Size.Icon.Md}" Height="{StaticResource Size.Icon.Md}" Margin="0,1,10,0" Foreground="{StaticResource Brush.Info}" />
                                                <StackPanel><TextBlock Text="Poznámka k receptu" FontWeight="SemiBold" /><TextBlock Text="{Binding SelectedRecipe.Note}" Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,4,0,0" /></StackPanel>
                                            </DockPanel>
                                        </Border>
                                        <Border Style="{StaticResource InspectorSection}" BorderBrush="{StaticResource Brush.Warning}" Margin="0,0,0,10"
                                                Visibility="{Binding HasSelectedWarning, Converter={StaticResource BoolToVisibility}}">
                                            <StackPanel Orientation="Horizontal">
                                                <components:IconGlyph IconData="{StaticResource Glyph.Warning}" Width="{StaticResource Size.Icon.Md}" Height="{StaticResource Size.Icon.Md}" Margin="0,1,10,0" Foreground="{StaticResource Brush.Warning}" />
                                                <StackPanel><TextBlock Text="Bezpečnostní upozornění" FontWeight="SemiBold" /><TextBlock Text="{Binding SelectedRecipe.Warning}" Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,4,0,0" /></StackPanel>
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource InspectorSection}">
                                            <StackPanel Orientation="Horizontal">
                                                <components:IconGlyph IconData="{StaticResource Glyph.Check}" Width="{StaticResource Size.Icon.Md}" Height="{StaticResource Size.Icon.Md}" Margin="0,1,10,0" Foreground="{StaticResource Brush.Success}" />
                                                <StackPanel><TextBlock Text="Před použitím proveďte test" FontWeight="SemiBold" /><TextBlock Text="Doporučené hodnoty ověřte na odřezku stejného materiálu. Výsledek ovlivňuje fokus, optika i konkrétní šarže." Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,4,0,0" /></StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                                <StackPanel Grid.Row="1" Margin="0,16,0,0">
                                    <TextBlock Text="Kam použít nastavení" FontWeight="SemiBold" Margin="0,0,0,6" />
                                    <ComboBox x:Name="TargetLayerComboBox"
                                              ItemsSource="{Binding ProjectLayers, ElementName=MaterialsDialog}"
                                              ToolTip="Vyberte vrstvu projektu, na kterou se parametry použijí">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Width="10" Height="10" CornerRadius="{StaticResource Radius.Sm}" Background="{Binding Color, Converter={StaticResource RgbColorToBrush}}" Margin="0,0,7,0" />
                                                    <TextBlock Text="{Binding Name}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <TextBlock Text="V projektu zatím není vrstva. Nejprve vytvořte nebo importujte objekt."
                                               Style="{StaticResource Text.Muted}" Margin="0,6,0,0"
                                               Visibility="{Binding HasItems, ElementName=TargetLayerComboBox, Converter={StaticResource InverseBoolToVisibility}}" />
                                    <WrapPanel Margin="0,12,0,0" HorizontalAlignment="Right">
                                        <Button Command="{Binding SaveAsPersonalCommand}" CommandParameter="{Binding SelectedRecipe}" Padding="12,0" Margin="0,0,8,8" ToolTip="Uložit jako vlastní upravitelný recept">
                                            <components:IconLabel IconData="{StaticResource Glyph.Save}" Text="Uložit recept" IconSize="{StaticResource Size.Icon.Sm}" />
                                        </Button>
                                        <Button Style="{StaticResource PrimaryBlue}" Click="OnApplySelectedRecipeClick" Padding="18,0" Margin="0,0,0,8"
                                                IsEnabled="{Binding HasItems, ElementName=TargetLayerComboBox}" ToolTip="Použít parametry na zvolenou vrstvu projektu">
                                            <components:IconLabel IconData="{StaticResource Glyph.Check}" Text="Použít na vybranou vrstvu" IconSize="{StaticResource Size.Icon.Sm}" Foreground="White" />
                                        </Button>
                                    </WrapPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Moje recepty">
                <Grid Margin="0,16,0,0">
                    <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Style="{StaticResource InspectorSection}" Visibility="{Binding HasPresets, Converter={StaticResource InverseBoolToVisibility}}">
                                <StackPanel HorizontalAlignment="Center" Margin="12,22">
                                    <components:IconGlyph IconData="{StaticResource Glyph.Materials}" Width="{StaticResource Size.Icon.Xl}" Height="{StaticResource Size.Icon.Xl}" HorizontalAlignment="Center" Foreground="{StaticResource Brush.TextSecondary}" />
                                    <TextBlock Text="Zatím nemáte vlastní recept" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,0" />
                                    <TextBlock Text="Uložte doporučený recept nebo vytvořte vlastní parametry." Style="{StaticResource Text.Muted}" Margin="0,5,0,0" />
                                </StackPanel>
                            </Border>
                            <ItemsControl ItemsSource="{Binding Presets}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource Brush.Field}" BorderBrush="{StaticResource Brush.PanelBorder}" BorderThickness="1" CornerRadius="{StaticResource Radius.Md}" Padding="10,8" Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" /><ColumnDefinition Width="112" /><ColumnDefinition Width="88" />
                                                    <ColumnDefinition Width="72" /><ColumnDefinition Width="64" /><ColumnDefinition Width="72" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox Text="{Binding Name, UpdateSourceTrigger=LostFocus, ValidatesOnDataErrors=True}" MaxLength="80" Margin="0,0,8,0" />
                                                <ComboBox Grid.Column="1" SelectedValue="{Binding Mode}" SelectedValuePath="Tag" Margin="0,0,6,0">
                                                    <ComboBoxItem Content="Řezání" Tag="{x:Static layers:LayerMode.Cut}" />
                                                    <ComboBoxItem Content="Gravírování" Tag="{x:Static layers:LayerMode.Fill}" />
                                                </ComboBox>
                                                <TextBox Grid.Column="2" Text="{Binding Speed, StringFormat=0, UpdateSourceTrigger=LostFocus, ValidatesOnDataErrors=True}" Margin="0,0,6,0" ToolTip="Rychlost v mm/min" />
                                                <TextBox Grid.Column="3" Text="{Binding Power, StringFormat=0, UpdateSourceTrigger=LostFocus, ValidatesOnDataErrors=True}" Margin="0,0,6,0" ToolTip="Výkon v procentech" />
                                                <TextBox Grid.Column="4" Text="{Binding Passes, StringFormat=0, UpdateSourceTrigger=LostFocus, ValidatesOnDataErrors=True}" Margin="0,0,6,0" ToolTip="Počet průchodů" />
                                                <StackPanel Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <Button ToolTip="Duplikovat recept" Padding="6,2" Margin="0,0,4,0" Command="{Binding DataContext.DuplicateCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                                        <components:IconGlyph IconData="{StaticResource Glyph.Duplicate}" Width="{StaticResource Size.Icon.Sm}" Height="{StaticResource Size.Icon.Sm}" />
                                                    </Button>
                                                    <Button ToolTip="Odstranit recept" Style="{StaticResource Button.Danger}" Padding="6,2" Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                                        <components:IconGlyph IconData="{StaticResource Glyph.Delete}" Width="{StaticResource Size.Icon.Sm}" Height="{StaticResource Size.Icon.Sm}" />
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                    <Button Grid.Row="1" Command="{Binding AddCommand}" HorizontalAlignment="Left" Margin="0,12,0,0">
                        <components:IconLabel IconData="{StaticResource Glyph.New}" Text="Nový vlastní recept" />
                    </Button>
                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" Background="{StaticResource Brush.TitleBar}" BorderBrush="{StaticResource Brush.PanelBorder}" BorderThickness="0,1,0,0" Padding="24,12">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Text="Recepty jsou výchozí doporučení; materiál, fokus a stav optiky mohou výsledek změnit."
                           Style="{StaticResource Text.Muted}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,16,0" />
                <Button Grid.Column="1" Style="{StaticResource PrimaryBlue}" Click="OnCloseClick" HorizontalAlignment="Right" Padding="18,0">
                    <components:IconLabel IconData="{StaticResource Glyph.Check}" Text="Hotovo" Foreground="White" />
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
