<!-- Hallmark · pre-emit critique: P5 H5 E4 S5 R5 V4 · studied-DNA: xTool material workflow + Lasero light workbench -->
<Window x:Class="Lasero.App.MaterialsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:components="clr-namespace:Lasero.App.Components"
        xmlns:conv="clr-namespace:Lasero.App.Converters"
        xmlns:layers="clr-namespace:Lasero.Core.Layers;assembly=Lasero.Core"
        xmlns:materials="clr-namespace:Lasero.Core.Materials;assembly=Lasero.Core"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        x:Name="MaterialsDialog"
        Title="Vzorník materiálů" Width="1180" Height="720" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="True" ResizeMode="CanResize" WindowStyle="None"
        Background="{StaticResource Brush.Background}" Foreground="{StaticResource Brush.TextPrimary}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
        <conv:NotNullToVisibilityConverter x:Key="NotNullToVisibility" />
        <conv:RgbColorToBrushConverter x:Key="RgbColorToBrush" />
        <!-- The stock WPF tabs were the only classic chrome left in this window. Keep the native
             selection model, keyboard navigation and content hosting, but render the two views as
             quiet design-system tabs that work against both theme palettes. -->
        <Style x:Key="MaterialTabs" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid KeyboardNavigation.TabNavigation="Local">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TabPanel Grid.Row="0" IsItemsHost="True" Background="Transparent" />
                            <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Row="1"
                                              ContentSource="SelectedContent" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MaterialTab" TargetType="TabItem">
            <!-- Foreground and weight are set on the header presenter in the template, not here: a TabItem's
                 content is its logical child and inherits both, which turned the whole tab page red and
                 semibold on the selected tab. -->
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
            <Setter Property="FontSize" Value="{StaticResource Size.Text.Body}" />
            <Setter Property="MinHeight" Value="{StaticResource Size.Control.Base}" />
            <Setter Property="Padding" Value="14,0" />
            <!-- No Margin here: TabPanel arranges each tab at its desired size that already includes the margin,
                 then the tab subtracts the margin again, so the pill came out 8px too narrow and clipped its
                 own text and right edge. The gap lives inside the template instead. -->
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Grid>
                        <Border x:Name="TabSurface"
                                Margin="0,0,8,0"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="{StaticResource Radius.Md}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="HeaderHost" ContentSource="Header"
                                              TextElement.Foreground="{DynamicResource Brush.TextSecondary}"
                                              TextElement.FontWeight="Medium"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <!-- The selected tab's 2px graphite indicator. -->
                        <Border x:Name="TabIndicator" Height="2" VerticalAlignment="Bottom" Margin="14,0,22,0"
                                Background="{DynamicResource Brush.SelectedIndicator}" Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabSurface" Property="Background" Value="{DynamicResource Brush.Field}" />
                                <Setter TargetName="TabSurface" Property="BorderBrush" Value="{DynamicResource Brush.PanelBorder}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="HeaderHost" Property="TextElement.Foreground" Value="{DynamicResource Brush.TextPrimary}" />
                                <Setter TargetName="TabIndicator" Property="Visibility" Value="Visible" />
                                <Setter TargetName="TabSurface" Property="Background" Value="{DynamicResource Brush.SelectedSurface}" />
                                <Setter TargetName="TabSurface" Property="BorderBrush" Value="{DynamicResource Brush.SelectedBorder}" />
                            </Trigger>
                            <Trigger Property="components:FocusVisual.IsVisible" Value="True">
                                <Setter TargetName="TabSurface" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="HeaderHost" Property="TextElement.Foreground" Value="{DynamicResource Brush.TextDisabled}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MaterialSwatchCell" TargetType="Button">
            <Setter Property="MinHeight" Value="58" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CellBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource Radius.Md}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CellBorder" Property="BorderBrush" Value="{StaticResource Brush.PanelBorderStrong}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CellBorder" Property="Opacity" Value="0.86" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="{StaticResource Opacity.Disabled}" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource Brush.Background}" BorderBrush="{StaticResource Brush.PanelBorderStrong}" BorderThickness="1">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="44" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <components:WindowTitleBar Title="Vzorník materiálů" IconData="{StaticResource Glyph.Materials}"
                                    CloseButtonName="Zavřít vzorník materiálů" />
    <Grid Grid.Row="1">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="72" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="32,24,32,16">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <components:IconGlyph IconData="{StaticResource Glyph.Materials}" Width="{StaticResource Size.Icon.Lg}" Height="{StaticResource Size.Icon.Lg}" Margin="0,2,12,0" />
                        <TextBlock Text="Vzorník materiálů" Style="{StaticResource PageTitle}" />
                    </StackPanel>
                    <TextBlock Text="Bezpečné výchozí hodnoty jsou dostupné offline. Před ostrou úlohou je vždy ověřte na odřezku."
                               Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="32,5,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="20,0,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Border Style="{StaticResource Badge.Aligned}" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="8" Height="8" Fill="{StaticResource Brush.Success}" Margin="0,0,8,0" />
                                <TextBlock Text="Dostupné offline" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                        <Button Style="{StaticResource Button.Secondary}" Command="{Binding SynchronizeCommand}" ToolTip="Synchronizovat osobní recepty s účtem Lasero">
                            <components:IconLabel IconData="{StaticResource Glyph.CloudSync}" Text="Synchronizovat" IconSize="{StaticResource Size.Icon.Sm}" />
                        </Button>
                    </StackPanel>
                    <TextBlock Text="{Binding SyncStatus}" Style="{StaticResource Text.Muted}" HorizontalAlignment="Right" Margin="0,5,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Grid.Row="1" Margin="32,0,32,16" Style="{StaticResource MaterialTabs}"
                    ItemContainerStyle="{StaticResource MaterialTab}">
            <TabItem Header="Doporučené parametry">
                <Grid Margin="0,16,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <components:ElevatedBorder Style="{StaticResource Card}" Padding="14,10,6,2">
                        <WrapPanel>
                            <StackPanel Width="174" Margin="0,0,8,8">
                                <TextBlock Text="Typ laseru" Style="{StaticResource FieldLabel}" />
                                <ComboBox SelectedValue="{Binding SelectedTechnology}" SelectedValuePath="Tag">
                                    <ComboBoxItem Content="Diodový laser" Tag="{x:Static materials:LaserTechnology.Diode}" />
                                    <ComboBoxItem Content="Infračervený laser" Tag="{x:Static materials:LaserTechnology.Infrared}" />
                                    <ComboBoxItem Content="CO₂ laser" Tag="{x:Static materials:LaserTechnology.Co2}" />
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Width="126" Margin="0,0,8,8">
                                <TextBlock Text="Výkon laseru" Style="{StaticResource FieldLabel}" />
                                <ComboBox ItemsSource="{Binding PowerClasses}" SelectedItem="{Binding SelectedPowerWatts}" />
                            </StackPanel>
                            <StackPanel Width="174" Margin="0,0,8,8">
                                <TextBlock Text="Operace" Style="{StaticResource FieldLabel}" />
                                <ComboBox SelectedValue="{Binding SelectedOperation}" SelectedValuePath="Tag">
                                    <ComboBoxItem Content="Gravírování" Tag="{x:Static layers:LayerMode.Fill}" />
                                    <ComboBoxItem Content="Řezání" Tag="{x:Static layers:LayerMode.Cut}" />
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Width="220" Margin="0,0,8,8">
                                <TextBlock Text="Hledat materiál" Style="{StaticResource FieldLabel}" />
                                <Border Style="{StaticResource UnitField.Shell}">
                                    <DockPanel>
                                        <components:IconGlyph DockPanel.Dock="Left" IconData="{StaticResource Glyph.Search}"
                                                              Width="{StaticResource Size.Icon.Sm}" Height="{StaticResource Size.Icon.Sm}"
                                                              Foreground="{StaticResource Brush.TextMuted}" Margin="0,0,8,0" />
                                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                                 BorderThickness="0" Background="Transparent" Padding="0"
                                                 AutomationProperties.Name="Hledat materiál" />
                                    </DockPanel>
                                </Border>
                            </StackPanel>
                            <StackPanel Width="220" Margin="0,0,8,8">
                                <TextBlock Text="Text náhledu" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding PreviewText, UpdateSourceTrigger=PropertyChanged}"
                                         MaxLength="12" AutomationProperties.Name="Text gravírovaného náhledu" />
                            </StackPanel>
                        </WrapPanel>
                    </components:ElevatedBorder>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="310" />
                        </Grid.ColumnDefinitions>

                        <Grid>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Visibility="{Binding HasSwatchCards, Converter={StaticResource InverseBoolToVisibility}}">
                                <components:IconGlyph IconData="{StaticResource Glyph.Search}"
                                                      Width="{StaticResource Size.Icon.Xl}" Height="{StaticResource Size.Icon.Xl}"
                                                      HorizontalAlignment="Center" Foreground="{StaticResource Brush.TextSecondary}" />
                                <TextBlock Text="Žádný materiál neodpovídá filtrům" FontWeight="SemiBold" Margin="0,10,0,0" />
                                <TextBlock Text="Změňte typ laseru, výkon nebo hledaný výraz." Style="{StaticResource Text.Muted}" Margin="0,4,0,0" />
                            </StackPanel>
                            <ScrollViewer x:Name="SwatchScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                          Visibility="{Binding HasSwatchCards, Converter={StaticResource BoolToVisibility}}">
                                <ItemsControl ItemsSource="{Binding SwatchCards}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel IsItemsHost="True" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <components:ElevatedBorder Width="360" Style="{StaticResource Card}" Padding="0" Margin="0,0,12,12">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <Border Padding="14,12" BorderBrush="{StaticResource Brush.PanelBorder}" BorderThickness="0,0,0,1">
                                                        <DockPanel>
                                                            <components:IconTile DockPanel.Dock="Left" IconData="{StaticResource Glyph.Materials}" Tone="{Binding Tone}" Margin="0,0,12,0" VerticalAlignment="Center" />
                                                            <StackPanel VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Material.Name}" FontWeight="SemiBold" />
                                                                <TextBlock Text="{Binding Material.Description}" Style="{StaticResource Text.Muted}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>
                                                        </DockPanel>
                                                    </Border>
                                                    <Grid Grid.Row="1" Margin="10,12,12,8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="46" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <ItemsControl ItemsSource="{Binding Speeds}" Margin="0,2,4,28">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate><UniformGrid Rows="4" Columns="1" /></ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <TextBlock Text="{Binding StringFormat={}{0:0}}" Style="{StaticResource Text.Muted}"
                                                                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                        <Grid Grid.Column="1">
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                            </Grid.RowDefinitions>
                                                            <ItemsControl ItemsSource="{Binding Cells}">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate><UniformGrid Rows="4" Columns="4" /></ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Button Style="{StaticResource MaterialSwatchCell}"
                                                                                Background="{Binding SurfaceColor}" Foreground="{Binding MarkColor}"
                                                                                Command="{Binding DataContext.SelectSwatchCellCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                CommandParameter="{Binding}"
                                                                                ToolTip="{Binding AccessibleName}"
                                                                                AutomationProperties.Name="{Binding AccessibleName}">
                                                                            <TextBlock Text="{Binding DataContext.PreviewText, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                       FontFamily="{StaticResource Font.Display}"
                                                                                       FontSize="{StaticResource Size.Text.Title}"
                                                                                       FontWeight="SemiBold"
                                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                                       TextTrimming="CharacterEllipsis" />
                                                                        </Button>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                            <ItemsControl Grid.Row="1" ItemsSource="{Binding Powers}" Margin="2,2,2,0">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate><UniformGrid Rows="1" Columns="4" /></ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <TextBlock Text="{Binding StringFormat={}{0}%}" Style="{StaticResource Text.Muted}" HorizontalAlignment="Center" />
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                            <TextBlock Grid.Row="2" Text="Výkon" Style="{StaticResource Text.Muted}" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                                        </Grid>
                                                    </Grid>
                                                    <Border Grid.Row="2" Padding="14,10" Background="{StaticResource Brush.PanelRaised}"
                                                            BorderBrush="{StaticResource Brush.PanelBorder}" BorderThickness="0,1,0,0">
                                                        <Grid>
                                                            <TextBlock Text="Klikněte na požadovaný odstín" Style="{StaticResource Text.Muted}"
                                                                       Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVisibility}}" />
                                                            <StackPanel Orientation="Horizontal" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                                                                <TextBlock Text="{Binding SelectedCell.Speed, StringFormat={}{0:0} mm/min}" FontWeight="SemiBold" />
                                                                <TextBlock Text="  ·  " Style="{StaticResource Text.Muted}" />
                                                                <TextBlock Text="{Binding SelectedCell.Power, StringFormat={}{0} %}" FontWeight="SemiBold" />
                                                                <TextBlock Text="  ·  " Style="{StaticResource Text.Muted}" />
                                                                <TextBlock Text="{Binding SelectedCell.Passes, StringFormat={}{0}×}" FontWeight="SemiBold" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </Grid>
                                            </components:ElevatedBorder>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>

                        <components:ElevatedBorder Grid.Column="2" Style="{StaticResource Card}" Padding="18">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Visibility="{Binding HasSelectedRecipe, Converter={StaticResource InverseBoolToVisibility}}">
                                    <components:IconGlyph IconData="{StaticResource Glyph.Materials}"
                                                          Width="{StaticResource Size.Icon.Xl}" Height="{StaticResource Size.Icon.Xl}"
                                                          HorizontalAlignment="Center" Foreground="{StaticResource Brush.TextSecondary}" />
                                    <TextBlock Text="Vyberte odstín" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,0" />
                                    <TextBlock Text="Klikněte na políčko ve vzorníku. Rychlost a výkon se nastaví automaticky."
                                               Style="{StaticResource Text.Muted}" TextWrapping="Wrap" TextAlignment="Center"
                                               MaxWidth="230" Margin="0,4,0,0" />
                                </StackPanel>
                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              Visibility="{Binding HasSelectedRecipe, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel>
                                        <TextBlock Text="Vybrané nastavení" Style="{StaticResource Text.Muted}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding SelectedRecipe.MaterialName}" FontFamily="{StaticResource Font.Display}"
                                                   FontSize="{StaticResource Size.Text.Title}" FontWeight="SemiBold" Margin="0,7,0,0" />
                                        <TextBlock Margin="0,3,0,16" Style="{StaticResource Text.Muted}">
                                            <Run Text="{Binding SelectedRecipe.TechnologyName, Mode=OneWay}" /><Run Text="  ·  " />
                                            <Run Text="{Binding SelectedRecipe.PowerWatts, Mode=OneWay}" /><Run Text=" W  ·  " />
                                            <Run Text="{Binding SelectedRecipe.OperationName, Mode=OneWay}" />
                                        </TextBlock>
                                        <components:ElevatedBorder Elevation="None" Style="{StaticResource InspectorSection}" Margin="0,0,0,10">
                                            <StackPanel>
                                                <TextBlock Text="Rychlost" Style="{StaticResource Text.Muted}" />
                                                <TextBlock Text="{Binding SelectedRecipe.SpeedMmPerMinute, StringFormat={}{0:0} mm/min}"
                                                           FontFamily="{StaticResource Font.Numeric}" FontSize="{StaticResource Size.Text.Section}" FontWeight="SemiBold" Margin="0,3,0,10" />
                                                <TextBlock Text="Výkon" Style="{StaticResource Text.Muted}" />
                                                <TextBlock Text="{Binding SelectedRecipe.PowerPercent, StringFormat={}{0:0} %}"
                                                           FontFamily="{StaticResource Font.Numeric}" FontSize="{StaticResource Size.Text.Section}" FontWeight="SemiBold" Margin="0,3,0,10" />
                                                <TextBlock Text="Průchody" Style="{StaticResource Text.Muted}" />
                                                <TextBlock Text="{Binding SelectedRecipe.Passes, StringFormat={}{0}×}"
                                                           FontFamily="{StaticResource Font.Numeric}" FontSize="{StaticResource Size.Text.Section}" FontWeight="SemiBold" Margin="0,3,0,0" />
                                            </StackPanel>
                                        </components:ElevatedBorder>
                                        <components:ElevatedBorder Elevation="None" Style="{StaticResource InspectorSection}" BorderBrush="{StaticResource Brush.PanelBorderStrong}"
                                                Visibility="{Binding HasSelectedWarning, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="{Binding SelectedRecipe.Warning}" Style="{StaticResource Text.Muted}" TextWrapping="Wrap" />
                                        </components:ElevatedBorder>
                                    </StackPanel>
                                </ScrollViewer>
                                <StackPanel Grid.Row="1" Margin="0,14,0,0"
                                            Visibility="{Binding HasSelectedRecipe, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="Použít na vrstvu" Style="{StaticResource FieldLabel}" />
                                    <ComboBox x:Name="TargetLayerComboBox" ItemsSource="{Binding ProjectLayers, ElementName=MaterialsDialog}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <Button Style="{StaticResource PrimaryBlue}" Click="OnApplySelectedRecipeClick" Margin="0,10,0,0"
                                            IsEnabled="{Binding HasItems, ElementName=TargetLayerComboBox}">
                                        <components:IconLabel IconData="{StaticResource Glyph.Check}" Text="Použít parametry" Foreground="White" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </components:ElevatedBorder>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Moje recepty">
                <Grid Margin="0,16,0,0">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

                    <!-- One plain sentence so a first-time owner knows what a recipe is and where it is used. -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock x:Name="RecipeHelpText" FontSize="{StaticResource Size.Text.Body}" TextWrapping="Wrap" Foreground="{StaticResource Brush.TextSecondary}"
                                   Text="Recept je uložené nastavení rychlosti, výkonu a počtu průchodů pro jeden materiál. V Návrhu ho použijete přes Použít na operaci." />
                        <TextBlock FontSize="{StaticResource Size.Text.Body}" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{StaticResource Brush.Warning}"
                                   Text="{Binding CutSafetyHint}"
                                   Visibility="{Binding HasCutPreset, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <!-- Empty state: one primary action and an example so the row layout is not a surprise. -->
                            <components:ElevatedBorder Elevation="None" Style="{StaticResource InspectorSection}" Padding="24,20"
                                    Visibility="{Binding HasPresets, Converter={StaticResource InverseBoolToVisibility}}">
                                <StackPanel HorizontalAlignment="Center" MaxWidth="560">
                                    <components:IconGlyph IconData="{StaticResource Glyph.Materials}" Width="{StaticResource Size.Icon.Xl}" Height="{StaticResource Size.Icon.Xl}" HorizontalAlignment="Center" Foreground="{StaticResource Brush.TextSecondary}" />
                                    <TextBlock Text="Zatím nemáte žádný vlastní recept" FontSize="{StaticResource Size.Text.Section}" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,0" />
                                    <TextBlock Text="Přidejte první recept a upravte ho podle svého materiálu. Hodnoty se ukládají samy."
                                               FontSize="{StaticResource Size.Text.Body}" Style="{StaticResource Text.Muted}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,14" />
                                    <Button x:Name="AddFirstRecipeButton" Style="{StaticResource PrimaryBlue}" Command="{Binding AddCommand}"
                                            HorizontalAlignment="Center" Padding="20,0" ToolTip="Vytvořit první vlastní recept"
                                            AutomationProperties.Name="Přidat první recept">
                                        <components:IconLabel IconData="{StaticResource Glyph.New}" Text="Přidat první recept" Foreground="White" />
                                    </Button>
                                    <Border Background="{StaticResource Brush.Field}" BorderBrush="{StaticResource Brush.PanelBorder}" BorderThickness="1"
                                            CornerRadius="{StaticResource Radius.Md}" Padding="14,10" Margin="0,18,0,0" Opacity="0.85">
                                        <StackPanel>
                                            <TextBlock Text="Příklad" FontSize="{StaticResource Size.Text.Body}" FontWeight="SemiBold" Style="{StaticResource Text.Muted}" />
                                            <TextBlock FontSize="{StaticResource Size.Text.Body}" TextWrapping="Wrap" Margin="0,4,0,0"
                                                       Text="Překližka 3 mm  ·  Řezání  ·  300 mm/min  ·  100 %  ·  2 průchody" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </components:ElevatedBorder>

                            <ItemsControl x:Name="RecipeList" ItemsSource="{Binding Presets}" KeyboardNavigation.TabNavigation="Continue">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="RecipeRow" Background="{StaticResource Brush.Field}" BorderBrush="{StaticResource Brush.PanelBorder}" BorderThickness="1"
                                                CornerRadius="{StaticResource Radius.Md}" Padding="14,10,10,6" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                                <!-- Fields wrap onto a second line when the window is narrow instead of clipping. -->
                                                <WrapPanel Grid.Column="0" Orientation="Horizontal">
                                                    <StackPanel Width="280" Margin="0,0,12,8">
                                                        <TextBlock Text="Název materiálu" FontSize="{StaticResource Size.Text.Body}" FontWeight="Medium" Foreground="{StaticResource Brush.TextSecondary}" Margin="0,0,0,4" />
                                                        <TextBox FontSize="{StaticResource Size.Text.Body}" Height="{StaticResource Size.Control.Base}" VerticalContentAlignment="Center" MaxLength="80"
                                                                 Text="{Binding Name, UpdateSourceTrigger=LostFocus, ValidatesOnDataErrors=True}"
                                                                 AutomationProperties.Name="Název materiálu"
                                                                 ToolTip="Jak recept poznáte v seznamu, například Překližka 3 mm" />
                                                    </StackPanel>
                                                    <StackPanel Width="200" Margin="0,0,12,8">
                                                        <TextBlock Text="Režim" FontSize="{StaticResource Size.Text.Body}" FontWeight="Medium" Foreground="{StaticResource Brush.TextSecondary}" Margin="0,0,0,4" />
                                                        <ComboBox FontSize="{StaticResource Size.Text.Body}" Height="{StaticResource Size.Control.Base}" SelectedValue="{Binding Mode}" SelectedValuePath="Tag"
                                                                  AutomationProperties.Name="Režim">
                                                            <ComboBoxItem Content="Gravírování" Tag="{x:Static layers:LayerMode.Fill}" ToolTip="Laser vyplní celou plochu tvaru řádky, vhodné pro logo nebo text." />
                                                            <ComboBoxItem Content="Řezání" Tag="{x:Static layers:LayerMode.Cut}" ToolTip="Laser projede po obrysu tvaru a materiál prořízne." />
                                                            <ComboBoxItem Content="Vyplnění s obrysem" Tag="{x:Static layers:LayerMode.FillAndCut}" ToolTip="Laser nejdřív vyplní plochu a potom projede obrys." />
                                                        </ComboBox>
                                                    </StackPanel>
                                                    <StackPanel Width="140" Margin="0,0,12,8">
                                                        <TextBlock Text="Rychlost (mm/min)" FontSize="{StaticResource Size.Text.Body}" FontWeight="Medium" Foreground="{StaticResource Brush.TextSecondary}" Margin="0,0,0,4" />
                                                        <TextBox FontSize="{StaticResource Size.Text.Body}" Height="{StaticResource Size.Control.Base}" VerticalContentAlignment="Center"
                                                                 Text="{Binding Speed, StringFormat=0, UpdateSourceTrigger=LostFocus, ValidatesOnDataErrors=True}"
                                                                 AutomationProperties.Name="Rychlost v milimetrech za minutu"
                                                                 ToolTip="Jak rychle se laser pohybuje. Pomalu pálí hlouběji, rychle jen lehce. Rozsah 10 až 12000" />
                                                    </StackPanel>
                                                    <StackPanel Width="110" Margin="0,0,12,8">
                                                        <TextBlock Text="Výkon (%)" FontSize="{StaticResource Size.Text.Body}" FontWeight="Medium" Foreground="{StaticResource Brush.TextSecondary}" Margin="0,0,0,4" />
                                                        <TextBox FontSize="{StaticResource Size.Text.Body}" Height="{StaticResource Size.Control.Base}" VerticalContentAlignment="Center"
                                                                 Text="{Binding Power, StringFormat=0, UpdateSourceTrigger=LostFocus, ValidatesOnDataErrors=True}"
                                                                 AutomationProperties.Name="Výkon v procentech"
                                                                 ToolTip="Jak silně laser pálí. Rozsah 0 až 100" />
                                                    </StackPanel>
                                                    <StackPanel Width="140" Margin="0,0,12,8">
                                                        <TextBlock Text="Počet průchodů" FontSize="{StaticResource Size.Text.Body}" FontWeight="Medium" Foreground="{StaticResource Brush.TextSecondary}" Margin="0,0,0,4" />
                                                        <TextBox FontSize="{StaticResource Size.Text.Body}" Height="{StaticResource Size.Control.Base}" VerticalContentAlignment="Center"
                                                                 Text="{Binding Passes, StringFormat=0, UpdateSourceTrigger=LostFocus, ValidatesOnDataErrors=True}"
                                                                 AutomationProperties.Name="Počet průchodů"
                                                                 ToolTip="Kolikrát laser projede stejnou dráhu. Rozsah 1 až 100" />
                                                    </StackPanel>
                                                </WrapPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,21,0,0">
                                                    <Button Style="{StaticResource Button.Tool}" Width="{StaticResource Size.Control.Base}" Height="{StaticResource Size.Control.Base}"
                                                            MinHeight="{StaticResource Size.Control.Base}" Padding="6" Margin="0,0,6,0"
                                                            ToolTip="Duplikovat recept" AutomationProperties.Name="Duplikovat recept"
                                                            Command="{Binding DataContext.DuplicateCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                                        <components:IconGlyph IconData="{StaticResource Glyph.Duplicate}" Width="{StaticResource Size.Icon.Sm}" Height="{StaticResource Size.Icon.Sm}" />
                                                    </Button>
                                                    <Button Style="{StaticResource Button.Danger}" Width="{StaticResource Size.Control.Base}" Height="{StaticResource Size.Control.Base}"
                                                            MinHeight="{StaticResource Size.Control.Base}" Padding="6"
                                                            ToolTip="Smazat recept" AutomationProperties.Name="Smazat recept"
                                                            Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                                        <components:IconGlyph IconData="{StaticResource Glyph.Delete}" Width="{StaticResource Size.Icon.Sm}" Height="{StaticResource Size.Icon.Sm}" />
                                                    </Button>
                                                </StackPanel>
                                                <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,0,0,4">
                                                    <TextBlock Text="{Binding ModeHint}" FontSize="{StaticResource Size.Text.Body}" TextWrapping="Wrap" Foreground="{StaticResource Brush.TextSecondary}" />
                                                    <TextBlock Text="{Binding ValidationMessage}" FontSize="{StaticResource Size.Text.Body}" FontWeight="SemiBold" TextWrapping="Wrap"
                                                               Foreground="{StaticResource Brush.Danger}" Margin="0,4,0,0"
                                                               Visibility="{Binding HasValidationMessage, Converter={StaticResource BoolToVisibility}}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                    <Button Grid.Row="2" Style="{StaticResource Button.Secondary}" Command="{Binding AddCommand}" HorizontalAlignment="Left" Margin="0,12,0,0"
                            ToolTip="Přidat další vlastní recept" Visibility="{Binding HasPresets, Converter={StaticResource BoolToVisibility}}">
                        <components:IconLabel IconData="{StaticResource Glyph.New}" Text="Nový vlastní recept" />
                    </Button>
                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" Background="{StaticResource Brush.TitleBar}" BorderBrush="{StaticResource Brush.PanelBorder}" BorderThickness="0,1,0,0" Padding="24,12">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Text="Recepty jsou výchozí doporučení; materiál, fokus a stav optiky mohou výsledek změnit."
                           Style="{StaticResource Text.Muted}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,16,0" />
                <Button Grid.Column="1" Style="{StaticResource PrimaryBlue}" Click="OnCloseClick" HorizontalAlignment="Right" Padding="18,0">
                    <components:IconLabel IconData="{StaticResource Glyph.Check}" Text="Hotovo" Foreground="White" />
                </Button>
            </Grid>
        </Border>
    </Grid>
    </Grid>
    </Border>
</Window>
