<Window x:Class="Lasero.App.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Lasero.App.Controls"
        xmlns:components="clr-namespace:Lasero.App.Components"
        xmlns:conv="clr-namespace:Lasero.App.Converters"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Náhled úlohy" Width="1120" Height="760" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterOwner" WindowStyle="None" Background="{StaticResource Brush.Background}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
    </Window.Resources>

    <Border BorderBrush="{StaticResource Brush.PanelBorder}" BorderThickness="1" Background="{StaticResource Brush.Background}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Background="{StaticResource Brush.TitleBar}" BorderBrush="{StaticResource Brush.PanelBorder}" BorderThickness="0,0,0,1">
                <Grid Margin="14,0,5,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="LASERO" FontFamily="{StaticResource Font.Display}" FontWeight="SemiBold" />
                        <TextBlock Text="  /  Náhled úlohy  ·  " Foreground="{StaticResource Brush.TextSecondary}" />
                        <TextBlock Text="{Binding GCode.FileLabel}" Foreground="{StaticResource Brush.TextSecondary}" TextTrimming="CharacterEllipsis" MaxWidth="420" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Style="{StaticResource Button.Icon}" Width="36" Height="32" Click="OnMinimizeClick" ToolTip="Minimalizovat">
                            <components:IconGlyph IconData="{StaticResource Glyph.Minimize}" Width="14" Height="14" />
                        </Button>
                        <Button x:Name="MaximizeButton" Style="{StaticResource Button.Icon}" Width="36" Height="32" Click="OnMaximizeClick" ToolTip="Maximalizovat">
                            <components:IconGlyph x:Name="MaximizeGlyph" IconData="{StaticResource Glyph.Maximize}" Width="14" Height="14" />
                        </Button>
                        <Button Style="{StaticResource Button.Icon}" Width="36" Height="32" Click="OnCloseClick" ToolTip="Zavřít náhled">
                            <components:IconGlyph IconData="{StaticResource Glyph.Close}" Width="14" Height="14" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="14,14,14,0">
                <controls:WorkspaceCanvas Document="{Binding GCode.Document}"
                                          MachineX="{Binding MachineStatus.WorkX}" MachineY="{Binding MachineStatus.WorkY}"
                                          SimulationX="{Binding GCode.SimulationPosition.X}" SimulationY="{Binding GCode.SimulationPosition.Y}"
                                          UseSimulationPosition="True"
                                          ProgressPercent="{Binding GCode.SimulationProgressPercent}"
                                          WorkAreaWidthMm="{Binding Connection.WorkAreaWidthMm}"
                                          WorkAreaHeightMm="{Binding Connection.WorkAreaHeightMm}"
                                          JogEnabled="False" />
            </Grid>

            <Border Grid.Row="2" Background="{StaticResource Brush.Panel}" BorderBrush="{StaticResource Brush.PanelBorder}"
                    BorderThickness="0,1,0,0" Padding="18,14">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="Průběh" FontWeight="SemiBold" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding GCode.SimulationTimeLabel}" FontFamily="{StaticResource Font.Mono}" Foreground="{StaticResource Brush.TextSecondary}" />
                    </StackPanel>
                    <Slider Grid.Column="1" Minimum="0" Maximum="100" Margin="0,0,18,0"
                            Value="{Binding GCode.SimulationProgressPercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            ToolTip="Posunout přehrávání na zvolené místo" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Command="{Binding GCode.RestartSimulationCommand}" Height="36" Padding="11,0" Margin="0,0,8,0" ToolTip="Spustit náhled od začátku">
                            <components:IconLabel IconData="{StaticResource Glyph.Refresh}" Text="Od začátku" />
                        </Button>
                        <Button Command="{Binding GCode.PauseResumeSimulationCommand}" Height="36" Padding="12,0" Margin="0,0,12,0">
                            <components:IconLabel>
                                <components:IconLabel.Style>
                                    <Style TargetType="components:IconLabel">
                                        <Setter Property="IconData" Value="{StaticResource Glyph.Pause}" />
                                        <Setter Property="Text" Value="Pozastavit" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding GCode.IsSimulationPlaying}" Value="False">
                                                <Setter Property="IconData" Value="{StaticResource Glyph.Play}" />
                                                <Setter Property="Text" Value="Přehrát" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </components:IconLabel.Style>
                            </components:IconLabel>
                        </Button>
                        <TextBlock Text="Rychlost" Style="{StaticResource Text.Muted}" VerticalAlignment="Center" Margin="0,0,7,0" />
                        <ComboBox Width="76" Height="36" ItemsSource="{Binding GCode.SimulationSpeedPresets}"
                                  SelectedItem="{Binding GCode.SimulationSpeedMultiplier}" ToolTip="Násobek rychlosti přehrávání" />
                        <TextBlock Text="×" VerticalAlignment="Center" Margin="5,0,0,0" Foreground="{StaticResource Brush.TextSecondary}" />
                    </StackPanel>

                    <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Margin="0,10,0,0" Style="{StaticResource Text.Muted}"
                               Text="Modrá trasa je již přehraná. Červená značí práci laseru, přerušovaná šedá rychlý přesun bez gravírování." />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
