<Window x:Class="Lasero.App.DeviceSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:components="clr-namespace:Lasero.App.Components"
        xmlns:conv="clr-namespace:Lasero.App.Converters"
        xmlns:materials="clr-namespace:Lasero.Core.Materials;assembly=Lasero.Core"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Nastavení zařízení"
        Width="900" Height="650"
        MinWidth="780" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize" WindowStyle="None"
        Background="{StaticResource Brush.Background}" Foreground="{StaticResource Brush.TextPrimary}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:InverseBooleanConverter x:Key="InverseBool" />
        <Style x:Key="DeviceSettingsNav" TargetType="RadioButton">
            <Setter Property="Height" Value="40" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Padding" Value="11,0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Surface"
                                Background="Transparent"
                                CornerRadius="{StaticResource Radius.Md}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{StaticResource Brush.Field}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{StaticResource Brush.PanelBorder}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="{StaticResource Opacity.Disabled}" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{StaticResource Brush.SelectedSurface}" />
                                <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="components:FocusVisual.IsVisible" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                                <Setter TargetName="Surface" Property="BorderThickness" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SettingsFieldLabel" TargetType="TextBlock" BasedOn="{StaticResource Text.Muted}">
            <Setter Property="Margin" Value="0,0,0,5" />
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource Brush.Background}" BorderBrush="{StaticResource Brush.PanelBorderStrong}" BorderThickness="1">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="44" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <components:WindowTitleBar Title="Nastavení zařízení" IconData="{StaticResource Glyph.Device}"
                                    CloseButtonName="Zavřít nastavení zařízení" />
    <Grid Grid.Row="1">
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="*" />
            <RowDefinition Height="66" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource Brush.Panel}"
                BorderBrush="{StaticResource Brush.PanelBorder}"
                BorderThickness="0,0,0,1"
                Padding="22,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <components:IconGlyph IconData="{StaticResource Glyph.Device}" Width="{StaticResource Size.Icon.Lg}" Height="{StaticResource Size.Icon.Lg}" Margin="0,1,12,0" />
                    <StackPanel>
                        <TextBlock Text="Nastavení zařízení" FontFamily="{StaticResource Font.Display}" FontSize="{StaticResource Size.Text.Title}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding ViewModel.Connection.ActiveMachineName}" Style="{StaticResource Text.Muted}" Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>
                <Border Grid.Column="1" Style="{StaticResource Badge}" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ViewModel.Connection.StatusText}" FontWeight="SemiBold" />
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="205" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Background="{StaticResource Brush.Panel}"
                    BorderBrush="{StaticResource Brush.PanelBorder}"
                    BorderThickness="0,0,1,0"
                    Padding="14,20">
                <StackPanel>
                    <RadioButton x:Name="WorkspaceTab" IsChecked="True" Style="{StaticResource DeviceSettingsNav}" GroupName="DeviceSettingsTab">
                        <components:IconLabel IconData="{StaticResource Glyph.Origin}" Text="Rozměry a profil" IconSize="{StaticResource Size.Icon.Md}" TextMargin="10,0,0,0" />
                    </RadioButton>
                    <RadioButton x:Name="MotionTab" Style="{StaticResource DeviceSettingsNav}" GroupName="DeviceSettingsTab">
                        <components:IconLabel IconData="{StaticResource Glyph.ArrowRight}" Text="Pohyb os" IconSize="{StaticResource Size.Icon.Md}" TextMargin="10,0,0,0" />
                    </RadioButton>
                    <RadioButton x:Name="ConnectionTab" Style="{StaticResource DeviceSettingsNav}" GroupName="DeviceSettingsTab">
                        <components:IconLabel IconData="{StaticResource Glyph.Connect}" Text="Připojení GRBL" IconSize="{StaticResource Size.Icon.Md}" TextMargin="10,0,0,0" />
                    </RadioButton>
                    <RadioButton x:Name="SafetyTab" Style="{StaticResource DeviceSettingsNav}" GroupName="DeviceSettingsTab">
                        <components:IconLabel IconData="{StaticResource Glyph.Warning}" Text="Bezpečnost" IconSize="{StaticResource Size.Icon.Md}" TextMargin="10,0,0,0" />
                    </RadioButton>
                </StackPanel>
            </Border>

            <Grid Grid.Column="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding IsChecked, ElementName=WorkspaceTab, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Margin="28,24">
                        <TextBlock Text="Rozměry a profil" FontFamily="{StaticResource Font.Display}" FontSize="{StaticResource Size.Text.Section}" FontWeight="SemiBold" />
                        <TextBlock Text="Pracovní plocha se po připojení načte z GRBL parametrů $130 a $131. Hodnoty zde můžete opravit a uložit jako výchozí."
                                   Style="{StaticResource Text.Muted}" TextWrapping="Wrap" MaxWidth="620" HorizontalAlignment="Left" Margin="0,5,0,20" />

                        <components:ElevatedBorder Style="{StaticResource InspectorSection}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <components:IconTile IconData="{StaticResource Glyph.Frame}" Tone="Blue" VerticalAlignment="Center" />
                                    <TextBlock Text="Pracovní plocha" Style="{StaticResource PanelTitle}" Margin="12,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Šířka (mm)" Style="{StaticResource SettingsFieldLabel}" />
                                        <TextBox Text="{Binding Draft.WorkAreaWidthMm, UpdateSourceTrigger=PropertyChanged, StringFormat=0.##}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Výška (mm)" Style="{StaticResource SettingsFieldLabel}" />
                                        <TextBox Text="{Binding Draft.WorkAreaHeightMm, UpdateSourceTrigger=PropertyChanged, StringFormat=0.##}" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="Souřadnice a rozměry v celé aplikaci používají milimetry."
                                           Style="{StaticResource Text.Muted}" Margin="0,10,0,0" />
                            </StackPanel>
                        </components:ElevatedBorder>

                        <components:ElevatedBorder Style="{StaticResource InspectorSection}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <components:IconTile IconData="{StaticResource Glyph.Zap}" Tone="Orange" VerticalAlignment="Center" />
                                    <TextBlock Text="Laserový profil" Style="{StaticResource PanelTitle}" Margin="12,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Technologie" Style="{StaticResource SettingsFieldLabel}" />
                                        <ComboBox SelectedValue="{Binding Draft.LaserTechnology}" SelectedValuePath="Tag">
                                            <ComboBoxItem Content="Diodový laser" Tag="{x:Static materials:LaserTechnology.Diode}" />
                                            <ComboBoxItem Content="Infračervený laser" Tag="{x:Static materials:LaserTechnology.Infrared}" />
                                            <ComboBoxItem Content="CO₂ laser" Tag="{x:Static materials:LaserTechnology.Co2}" />
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Optický výkon" Style="{StaticResource SettingsFieldLabel}" />
                                        <ComboBox ItemsSource="{Binding ViewModel.Materials.PowerClasses}"
                                                  SelectedItem="{Binding Draft.LaserPowerWatts}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate><TextBlock Text="{Binding StringFormat={}{0} W}" /></DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="Profil filtruje doporučené parametry ve vzorníku materiálů."
                                           Style="{StaticResource Text.Muted}" Margin="0,10,0,0" />
                            </StackPanel>
                        </components:ElevatedBorder>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding IsChecked, ElementName=MotionTab, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Margin="28,24">
                        <TextBlock Text="Pohyb os" FontFamily="{StaticResource Font.Display}" FontSize="{StaticResource Size.Text.Section}" FontWeight="SemiBold" />
                        <TextBlock Text="Výchozí vzdálenosti a rychlosti pro ruční ovládání stroje."
                                   Style="{StaticResource Text.Muted}" Margin="0,5,0,20" />

                        <components:ElevatedBorder Style="{StaticResource InspectorSection}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <components:IconTile IconData="{StaticResource Glyph.Origin}" Tone="Graphite" VerticalAlignment="Center" />
                                    <TextBlock Text="Osy X a Y" Style="{StaticResource PanelTitle}" Margin="12,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Vzdálenost kroku (mm)" Style="{StaticResource SettingsFieldLabel}" />
                                        <ComboBox ItemsSource="{Binding ViewModel.Jog.StepSizePresets}" SelectedItem="{Binding Draft.JogStepMm}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Rychlost (mm/min)" Style="{StaticResource SettingsFieldLabel}" />
                                        <TextBox Text="{Binding Draft.JogFeedRateMmPerMinute, UpdateSourceTrigger=PropertyChanged, StringFormat=0}" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </components:ElevatedBorder>

                        <components:ElevatedBorder Style="{StaticResource InspectorSection}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <components:IconTile IconData="{StaticResource Glyph.MachineHome}" Tone="Graphite" VerticalAlignment="Center" />
                                    <TextBlock Text="Osa Z" Style="{StaticResource PanelTitle}" Margin="12,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                                <CheckBox Content="Povolit ruční ovládání osy Z" IsChecked="{Binding Draft.EnableZAxis}" Margin="0,0,0,10" />
                                <CheckBox Content="Obrátit směr osy Z" IsChecked="{Binding Draft.InvertZAxis}" Margin="0,0,0,14"
                                          IsEnabled="{Binding Draft.EnableZAxis}" />
                                <Grid IsEnabled="{Binding Draft.EnableZAxis}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Vzdálenost kroku Z (mm)" Style="{StaticResource SettingsFieldLabel}" />
                                        <ComboBox ItemsSource="{Binding ViewModel.Jog.StepSizePresets}" SelectedItem="{Binding Draft.ZJogStepMm}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Rychlost Z (mm/min)" Style="{StaticResource SettingsFieldLabel}" />
                                        <TextBox Text="{Binding Draft.ZJogFeedRateMmPerMinute, UpdateSourceTrigger=PropertyChanged, StringFormat=0}" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </components:ElevatedBorder>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding IsChecked, ElementName=ConnectionTab, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Margin="28,24">
                        <TextBlock Text="Připojení GRBL" FontFamily="{StaticResource Font.Display}" FontSize="{StaticResource Size.Text.Section}" FontWeight="SemiBold" />
                        <TextBlock Text="Komunikační parametry se použijí při příštím připojení zařízení."
                                   Style="{StaticResource Text.Muted}" Margin="0,5,0,20" />

                        <components:ElevatedBorder Style="{StaticResource InspectorSection}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <components:IconTile IconData="{StaticResource Glyph.Connect}" Tone="Teal" VerticalAlignment="Center" />
                                    <TextBlock Text="Sériové připojení" Style="{StaticResource PanelTitle}" Margin="12,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                                <Grid IsEnabled="{Binding ViewModel.Connection.IsConnected, Converter={StaticResource InverseBool}}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="180" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Sériový port" Style="{StaticResource SettingsFieldLabel}" />
                                        <Grid>
                                            <ComboBox ItemsSource="{Binding ViewModel.Connection.AvailablePorts}" SelectedItem="{Binding Draft.Port}" />
                                            <Button Width="32" Height="32" HorizontalAlignment="Right"
                                                    Style="{StaticResource Button.Icon}"
                                                    Command="{Binding ViewModel.Connection.RefreshPortsCommand}"
                                                    ToolTip="Znovu vyhledat zařízení">
                                                <components:IconGlyph IconData="{StaticResource Glyph.Refresh}" Width="{StaticResource Size.Icon.Sm}" Height="{StaticResource Size.Icon.Sm}" />
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Přenosová rychlost" Style="{StaticResource SettingsFieldLabel}" />
                                        <ComboBox ItemsSource="{Binding ViewModel.Connection.CommonBaudRates}" SelectedItem="{Binding Draft.BaudRate}" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="Připojené zařízení nejdříve odpojte, pokud chcete změnit port nebo rychlost."
                                           Style="{StaticResource Text.Muted}" Margin="0,10,0,0" />
                            </StackPanel>
                        </components:ElevatedBorder>

                        <components:ElevatedBorder Style="{StaticResource InspectorSection}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <components:IconTile IconData="{StaticResource Glyph.Device}" Tone="Blue" VerticalAlignment="Center" />
                                    <TextBlock Text="Zjištěné zařízení" Style="{StaticResource PanelTitle}" Margin="12,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="Stav" Style="{StaticResource Text.Muted}" />
                                    <TextBlock Grid.Column="1" Text="{Binding ViewModel.Connection.StatusText}" />
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="Profil" Style="{StaticResource Text.Muted}" />
                                    <TextBlock Grid.Column="1" Text="{Binding ViewModel.Connection.ActiveMachineName}" />
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="Firmware" Style="{StaticResource Text.Muted}" />
                                    <TextBlock Grid.Column="1" Text="{Binding ViewModel.Connection.FirmwareBanner}" TextWrapping="Wrap" />
                                </Grid>
                            </StackPanel>
                        </components:ElevatedBorder>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding IsChecked, ElementName=SafetyTab, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Margin="28,24">
                        <TextBlock Text="Bezpečnost" FontFamily="{StaticResource Font.Display}" FontSize="{StaticResource Size.Text.Section}" FontWeight="SemiBold" />
                        <TextBlock Text="Kontroly, které pomáhají zabránit nechtěnému pohybu nebo spuštění laseru."
                                   Style="{StaticResource Text.Muted}" Margin="0,5,0,20" />

                        <components:ElevatedBorder Style="{StaticResource InspectorSection}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <components:IconTile IconData="{StaticResource Glyph.Play}" Tone="Orange" VerticalAlignment="Center" />
                                    <TextBlock Text="Před spuštěním" Style="{StaticResource PanelTitle}" Margin="12,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                                <CheckBox Content="Vyžadovat kontrolu oblasti rámováním"
                                          IsChecked="{Binding Draft.RequireFramingBeforeStart}" Margin="0,0,0,12" />
                                <CheckBox Content="Potvrdit softwarový reset stroje"
                                          IsChecked="{Binding Draft.ConfirmSoftReset}" Margin="0,0,0,12" />
                                <CheckBox Content="Po připojení otevřít obrazovku zařízení"
                                          IsChecked="{Binding Draft.ShowMachineStatusAfterConnect}" />
                            </StackPanel>
                        </components:ElevatedBorder>

                        <Border Background="{StaticResource Brush.Field}"
                                BorderBrush="{StaticResource Brush.PanelBorder}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource Radius.Md}"
                                Padding="14">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <components:IconGlyph IconData="{StaticResource Glyph.Info}" Width="{StaticResource Size.Icon.Md}" Height="{StaticResource Size.Icon.Md}" Margin="0,1,10,0" Foreground="{StaticResource Brush.Info}" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Bezpečný výstup G-code" FontWeight="SemiBold" />
                                    <TextBlock Text="LASERO generuje milimetry (G21), absolutní souřadnice (G90) a dynamický výkon laseru (M4). Pokročilé příkazy zůstávají v GRBL konzoli."
                                               Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <Border Grid.Row="2"
                Background="{StaticResource Brush.Panel}"
                BorderBrush="{StaticResource Brush.PanelBorder}"
                BorderThickness="0,1,0,0"
                Padding="22,0">
            <Grid>
                <TextBlock x:Name="SettingsErrorText"
                           Foreground="{StaticResource Brush.Danger}"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,0,220,0" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource Button.Outline}" Content="Zrušit" Width="96" Click="OnCancelClick" Margin="0,0,8,0" />
                    <Button Style="{StaticResource Button.Primary}" Width="112" Click="OnSaveClick">
                        <components:IconLabel IconData="{StaticResource Glyph.Save}" Text="Uložit" Foreground="White" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
    </Grid>
    </Border>
</Window>
